<template data-retro-template="amiga">
  <section
    class="retro-experience-overlay retro-amiga"
    role="dialog"
    aria-modal="true"
    aria-label="Amiga Workbench 1.3"
    data-retro-overlay
    hidden
  >
    <div class="retro-experience__screen retro-amiga__screen">
      <button
        class="retro-experience__skip retro-experience__skip--amiga"
        type="button"
        data-retro-close
        data-retro-skip
        data-label-it="Salta l’esperienza Amiga Workbench"
        data-label-en="Skip the Amiga Workbench experience"
      >
        Salta
      </button>

      <div class="retro-amiga__stage" data-retro-amiga-boot>
        <img
          data-retro-src="/assets/retro-experience/amiga/bootscreen-amiga-1.3.webp"
          alt=""
          width="1920"
          height="1200"
        />
      </div>

      <div class="retro-amiga__stage" data-retro-amiga-desktop hidden>
        <img
          data-retro-src="/assets/retro-experience/amiga/workbench-screen.webp"
          alt=""
          width="1920"
          height="1200"
        />

        <div class="retro-amiga__icons" aria-label="Workbench">
          <button
            class="retro-amiga__disk retro-amiga__disk--ram"
            type="button"
            aria-pressed="false"
            data-retro-amiga-disk
            data-retro-destination="/account/favorites/"
            data-retro-inactive-src="/assets/retro-experience/amiga/workbench-ram-disk-inactive.webp"
            data-retro-active-src="/assets/retro-experience/amiga/workbench-ram-disk-active.webp"
            data-label-it="Apri RAM DISK e vai ai preferiti"
            data-label-en="Open RAM DISK and go to favorites"
          >
            <img
              data-retro-src="/assets/retro-experience/amiga/workbench-ram-disk-inactive.webp"
              alt=""
              width="142"
              height="103"
            />
            <span class="retro-experience-sr-only">RAM DISK</span>
          </button>

          <button
            class="retro-amiga__disk retro-amiga__disk--site"
            type="button"
            aria-pressed="false"
            data-retro-amiga-disk
            data-retro-destination-kind="home"
            data-retro-inactive-src="/assets/retro-experience/amiga/workbench-disk-inactive.webp"
            data-retro-active-src="/assets/retro-experience/amiga/workbench-disk-active.webp"
            data-label-it="Apri il disco Retro-Gamers"
            data-label-en="Open the Retro-Gamers disk"
          >
            <img
              data-retro-src="/assets/retro-experience/amiga/workbench-disk-inactive.webp"
              alt=""
              width="214"
              height="104"
            />
            <span class="retro-experience-sr-only">Retro-Gamers</span>
          </button>
        </div>
      </div>
    </div>
  </section>
</template>
