<template data-retro-template="monkey">
  <section
    class="retro-experience-overlay retro-monkey"
    role="dialog"
    aria-modal="true"
    aria-label="Monkey Island 2"
    data-retro-overlay
    hidden
  >
    <div class="retro-experience__screen retro-monkey__screen">
      <img
        class="retro-monkey__background"
        data-retro-monkey-screen
        data-retro-src-it="/assets/retro-experience/monkey-island/monkey-island-2-screen-difficulty-ita.webp"
        data-retro-src-en="/assets/retro-experience/monkey-island/monkey-island-2-screen-difficulty-eng.webp"
        alt=""
        width="1920"
        height="1200"
      />

      <button
        class="retro-experience__skip retro-experience__skip--monkey"
        type="button"
        data-retro-close
        data-retro-skip
        data-label-it="Salta l’esperienza Monkey Island 2"
        data-label-en="Skip the Monkey Island 2 experience"
      >
        Salta
      </button>

      <button
        class="retro-monkey__choice retro-monkey__choice--simple"
        type="button"
        data-retro-monkey-choice="simple"
        data-retro-destination="/account/favorites/"
        data-label-it="Percorso semplice: apri i preferiti"
        data-label-en="Simple path: open favorites"
      >
        <span
          class="retro-monkey__choice-label"
          data-text-it="Percorso semplice"
          data-text-en="Simple path"
        >Percorso semplice</span>

        <span class="retro-monkey__spit-window" aria-hidden="true">
          <img
            class="retro-monkey__spit"
            data-retro-monkey-spit
            data-retro-src="/assets/retro-experience/monkey-island/spit-monkey-island.webp"
            alt=""
            width="114"
            height="72"
            hidden
          />
        </span>
      </button>

      <button
        class="retro-monkey__choice retro-monkey__choice--all"
        type="button"
        data-retro-monkey-choice="all"
        data-retro-destination-kind="home"
        data-label-it="Voglio tutto: apri Retro-Gamers.it"
        data-label-en="I want it all: open Retro-Gamers.it"
      >
        <span
          class="retro-monkey__choice-label"
          data-text-it="Voglio tutto"
          data-text-en="I want it all"
        >Voglio tutto</span>

        <span class="retro-monkey__spit-window" aria-hidden="true">
          <img
            class="retro-monkey__spit"
            data-retro-monkey-spit
            data-retro-src="/assets/retro-experience/monkey-island/spit-monkey-island.webp"
            alt=""
            width="114"
            height="72"
            hidden
          />
        </span>
      </button>
    </div>
  </section>
</template>
