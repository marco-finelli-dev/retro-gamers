      'Gestisci commenti in moderazione, utenti registrati e strumenti community.',
    moderationComments: 'Moderazione commenti',
    commentReports: 'Segnalazioni commenti',
    userManagement: 'Gestione utenti',
    messageReports: 'Segnalazioni messaggi',
    readerRatings: 'Voti lettori',
    settingsKicker: 'Impostazioni',
    profile: 'Profilo',
    profileHintAdmin:
      'Nome e badge sono già visibili nel tuo profilo pubblico. Modificali qui quando vuoi aggiornarli.',
    profileHintReader:
      'Nome e badge sono già visibili nel tuo profilo pubblico. Puoi scegliere qui il badge da mostrare.',
    displayName: 'Nome visualizzato',
    currentBadge: 'Badge attuale',
    noMainBadge: 'Non hai ancora scelto un badge principale.',
    badgeSummaryHelpSelected: 'Questo è il badge mostrato nel tuo profilo e nei commenti.',
    badgeSummaryHelpEmpty: 'Quando scegli un badge, apparirà nel profilo e nei commenti.',
    editProfile: 'Modifica profilo',
    discoverBadges: 'Scopri tutti i badge',
    displayNameReadonly:
      'Il nome visualizzato viene scelto alla registrazione. Per modificarlo, contatta la redazione.',
    readerBadge: 'Badge lettore',
    noBadgesAvailable: 'Nessun badge disponibile al momento.',
    noBadgesDescription:
      'Quando il catalogo badge sarà disponibile, potrai scegliere quale mostrare nel profilo e nei commenti.',
    chooseBadge: 'Scegli un badge',
    chooseBadgeHelp: 'Scegli quale badge mostrare nel profilo e nei commenti.',
    saveProfile: 'Salva profilo',
    privacyPolicy: 'Privacy Policy',
  },
  en: {
    pageTitle: 'Reader profile | Retro-Gamers.it',
    pageDescription: 'Manage your reader profile, display name and community badge.',
    fallbackName: 'Retro-Gamers user',
    publicProfile: 'Public profile',
    messages: 'Messages',
    memories: 'My memories',
