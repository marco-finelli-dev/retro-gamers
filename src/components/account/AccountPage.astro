const description = ui.pageDescription;
const session = await getUserSessionFromCookies(Astro.cookies);
const isLoggedIn = Boolean(!session.error && session.user && session.profile);
const profile = session.profile;
const user = session.user;
const avatarUrl = profile?.avatar_url || '';
const canEditDisplayName = profile?.role === 'admin';
const authAppMetadata = user?.app_metadata as { provider?: string | null; providers?: string[] | null } | undefined;
const identityProviders = new Set(
  ((user as { identities?: Array<{ provider?: string | null }> } | null)?.identities || [])
    .map((identity) => String(identity?.provider || '').toLowerCase())
    .filter(Boolean)
);
const appMetadataProviders = Array.isArray(authAppMetadata?.providers)
  ? authAppMetadata.providers.map((provider) => String(provider || '').toLowerCase()).filter(Boolean)
  : [];
const primaryAuthProvider = String(authAppMetadata?.provider || '').toLowerCase();
const hasPasswordAuthProvider =
  identityProviders.has('email') ||
  appMetadataProviders.includes('email') ||
  primaryAuthProvider === 'email' ||
  (Boolean(user?.email) && identityProviders.size === 0 && appMetadataProviders.length === 0 && !primaryAuthProvider);
const showPasswordChangeForm = Boolean(isLoggedIn && user?.email && hasPasswordAuthProvider);
const accountDisplayName =
  profile?.display_name || profile?.username || user?.email || ui.fallbackName;
const publicProfileHref = profile?.username ? getPublicUserUrl(profile.username, currentLang) : '';
const loginHref = currentLang === 'en' ? '/en/account/login/' : '/account/login/';
