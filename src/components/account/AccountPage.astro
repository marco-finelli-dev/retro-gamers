    newsletterUnsubscribe: 'Unsubscribe',
    communityKicker: 'Community',
    communityLevel: 'Community level',
    communityLevelDescription:
      'Your level grows with approved comments, review ratings and likes received on comments. Every profile starts with 1 point, with no public rankings.',
    currentLevel: 'Current level',
    nextLevel: 'Next level',
    points: 'points',
    progress: 'Progress',
    progressAria: 'Progress toward',
    maxLevel: 'You have reached the highest level.',
    avatar: 'Avatar',
    avatarLoaded:
      'Current avatar uploaded. You can replace it by uploading a new image.',
    avatarEmpty:
      'Upload an image to make your community profile recognizable.',
    avatarDropReplace: 'Drop the image to replace your avatar',
    avatarDropUpload: 'Drop the image to upload it',
    avatarChooseReplace: 'Choose a new image to replace your avatar',
    avatarChooseUpload: 'Drag your image here or choose a file',
    avatarHelpReplace:
      'JPG, PNG or WebP. Max 2 MB. Your current avatar stays active until you upload the new file.',
    avatarHelpUpload: 'JPG, PNG or WebP. Max 2 MB.',
    avatarReplace: 'Replace avatar',
    avatarUpload: 'Upload avatar',
    avatarRemove: 'Remove avatar',
    publicProfileTitle: 'Public profile',
    publicProfileDescription:
      'Tell the community who you are as a reader, player or retro enthusiast.',
    bioIt: 'Italian bio',
    bioEn: 'English bio',
    bioEnFallback:
      'English bio not set. The English profile will use the Italian bio.',
    editBio: 'Edit bio',
    emptyBioTitle: 'You have not written a public bio yet.',
    emptyBioDescription:
      'Tell the community who you are as a reader, player or retro enthusiast.',
    writeBio: 'Write bio',
    bioItPlaceholder:
      'Example: grew up with Amiga, arcades and worn-out gaming magazines.',
    bioEnPlaceholder: 'Example: raised on Amiga, arcades and worn-out gaming magazines.',
    bioHelp:
      'The English bio is optional. If left empty, the Italian bio will be used on the English profile.',
    saveBio: 'Save bio',
    cancel: 'Cancel',
    editorialTools: 'Editorial tools',
    editorialToolsDescription:
