const ratingsHref = currentLang === 'en' ? '/en/account/ratings/' : '/account/ratings/';
const privacyHref = currentLang === 'en' ? '/en/privacy-policy/' : '/privacy-policy/';
const favoritesHref = currentLang === 'en' ? '/en/account/favorites/' : '/account/favorites/';
const messagesHref = currentLang === 'en' ? '/en/account/messages/' : '/account/messages/';
const memoriesHref = currentLang === 'en' ? '/en/account/memories/' : '/account/memories/';
const badgesHref = currentLang === 'en' ? '/en/badges/' : '/badges/';
const getBadgeLabel = (
  badge: { label_it?: string | null; label_en?: string | null; key?: string | null } | null | undefined
) => {
  if (!badge) return '';
  return currentLang === 'en'
    ? badge.label_en || badge.label_it || badge.key || ''
    : badge.label_it || badge.label_en || badge.key || '';
};
let badges = [] as Awaited<ReturnType<typeof getActiveReaderBadges>>;
let currentBio = '';
let currentBioEn = '';
let newsletterStatus: 'none' | 'pending' | 'active' | 'unsubscribed' = 'none';
let newsletterLanguage: 'it' | 'en' = 'it';
let dashboardRetention: AccountDashboardRetention = {
  unreadSystemMessagesCount: 0,
  unreadPrivateMessagesCount: 0,
  latestApprovedComments: [],
  pendingCommentsCount: 0,
  suggestedArticlesFromInterests: [],
  hasInterests: false,
  latestSystemMessage: null,
};
const isMissingBioColumnError = (error: { code?: string; message?: string; details?: string } | null) => {
  if (!error) return false;

  const message = `${error.message || ''} ${error.details || ''}`.toLowerCase();

  return (
    message.includes('bio') &&
    !message.includes('bio_en') &&
    (
      error.code === '42703' ||
      error.code === 'PGRST204' ||
      message.includes('column') ||
      message.includes('schema cache')
    )
  );
};

const isMissingBioEnColumnError = (error: { code?: string; message?: string; details?: string } | null) => {
  if (!error) return false;

  const message = `${error.message || ''} ${error.details || ''}`.toLowerCase();

  return (
    message.includes('bio_en') &&
    (
      error.code === '42703' ||
      error.code === 'PGRST204' ||
      message.includes('column') ||
      message.includes('schema cache')
    )
  );
};

const getProfileBio = async (userId: string) => {
  const { data: profileBio, error: profileBioError } = await supabaseAdmin
    .from('profiles')
    .select('bio, bio_en')
    .eq('user_id', userId)
    .maybeSingle();

  if (!profileBioError) {
    return {
      bio: profileBio?.bio || '',
      bioEn: profileBio?.bio_en || '',
    };
  }

  if (isMissingBioEnColumnError(profileBioError)) {
    const { data: fallbackProfileBio, error: fallbackProfileBioError } = await supabaseAdmin
      .from('profiles')
      .select('bio')
      .eq('user_id', userId)
      .maybeSingle();

    if (!fallbackProfileBioError) {
      return {
        bio: fallbackProfileBio?.bio || '',
        bioEn: '',
      };
    }
  }

  if (!isMissingBioColumnError(profileBioError) && !isMissingBioEnColumnError(profileBioError)) {
    console.error('Profile bio query failed:', {
      code: profileBioError.code,
      message: profileBioError.message,
      hint: profileBioError.hint,
    });
  }

  return {
    bio: '',
    bioEn: '',
  };
};

let commentActivity = { ...emptyCommunityStats };

