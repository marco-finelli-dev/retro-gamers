  ? profile?.badge_key || ''
  : badges.length === 1
    ? badges[0].key
    : '';
const editableBadge = badges.find((badge) => badge.key === editableBadgeKey) || null;
const editableBadgeLabel = getBadgeLabel(editableBadge);
const accountBadge = profile?.badge_key
  ? badges.find((badge) => badge.key === profile?.badge_key) || null
  : null;
const accountBadgeLabel = getBadgeLabel(accountBadge);
const accountBadgeImageSrc = getReaderBadgeImageSrcForBadge(accountBadge);
const editableBadgeImageSrc = getReaderBadgeImageSrcForBadge(editableBadge);
const editableBadgePreviewImageSrc = editableBadgeImageSrc || getReaderBadgeImageSrcForBadge(badges[0]);
const communityRankDescription = currentLang === 'en'
  ? communityRank.descriptionEn
  : communityRank.descriptionIt;
const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/account/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/account/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/account/' },
];
const clientCopy = currentLang === 'en'
  ? {
