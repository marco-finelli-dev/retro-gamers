      connectionError: 'Connection error. Please try again.',
      removeFailed: 'Removal failed.',
      avatarRemoved: 'Avatar removed.',
      profileUpdateFailed: 'Update failed.',
      profileUpdated: 'Profile updated.',
      bioTooLong: 'The bio cannot exceed 500 characters.',
      bioEnTooLong: 'The English bio cannot exceed 500 characters.',
      bioUpdated: 'Bio updated.',
      passwordMissingFields: 'Fill in all password fields.',
      passwordTooShort: 'The new password must contain at least 8 characters.',
      passwordMismatch: 'The new password confirmation does not match.',
      passwordSame: 'Choose a password different from the current one.',
      passwordUpdated: 'Password updated.',
      passwordUpdateFailed: 'Could not update the password.',
    }
  : {
      lang: 'it',
      notSet: ui.notSet,
      newsletterConsentRequired: 'Per iscriverti devi accettare l’informativa privacy.',
      newsletterUpdateFailed: 'Impossibile aggiornare la newsletter.',
      newsletterConfirmEmail: 'Controlla la tua email per confermare l’iscrizione.',
      newsletterConfirmationResent: 'Email di conferma inviata di nuovo.',
      newsletterResendFailed: 'Non è stato possibile reinviare l’email. Riprova più tardi.',
      newsletterDisabled: 'Newsletter disattivata.',
      fileSelected: 'File selezionato',
      invalidFile: 'File non valido. Usa JPG, PNG o WebP.',
      fileTooLarge: 'Il file è troppo grande. Dimensione massima: 2 MB.',
      uploadFailed: 'Upload non riuscito.',
      avatarUpdated: 'Avatar aggiornato.',
      connectionError: 'Errore di connessione. Riprova.',
      removeFailed: 'Rimozione non riuscita.',
      avatarRemoved: 'Avatar rimosso.',
      profileUpdateFailed: 'Aggiornamento non riuscito.',
      profileUpdated: 'Profilo aggiornato.',
      bioTooLong: 'La bio non può superare 500 caratteri.',
      bioEnTooLong: 'La bio inglese non può superare 500 caratteri.',
      bioUpdated: 'Bio aggiornata.',
      passwordMissingFields: 'Compila tutti i campi password.',
      passwordTooShort: 'La nuova password deve contenere almeno 8 caratteri.',
      passwordMismatch: 'La conferma della nuova password non coincide.',
      passwordSame: 'Scegli una password diversa da quella attuale.',
      passwordUpdated: 'Password aggiornata.',
      passwordUpdateFailed: 'Non è stato possibile aggiornare la password.',
    };

---

<BaseLayout
  title={title}
  description={description}
  lang={currentLang}
  languageSwitch={{ url: accountLanguageSwitchUrl }}
  alternateLanguages={alternateLanguages}
>
  <CommunityLayout class="account-community-page" sidebar={isLoggedIn}>
    <Fragment slot="sidebar">
      {isLoggedIn && (
        <>
          <CommunitySidebarProfile
            name={accountDisplayName}
            username={profile?.username}
            email={user?.email}
            avatarUrl={avatarUrl}
            badge={accountBadgeLabel}
            badgeImageUrl={accountBadgeImageSrc}
            label={ui.accountIdentity}
          >
            <dl slot="details" class="community-detail-list account-sidebar-account-details" id="memories">
              <div>
                <dt>Email</dt>
                <dd>{user?.email}</dd>
              </div>

              <div>
                <dt>{ui.role}</dt>
                <dd>{profile?.role || 'reader'}</dd>
              </div>

              <div>
                <dt>{ui.status}</dt>
                <dd>{profile?.status || 'active'}</dd>
              </div>
            </dl>
          </CommunitySidebarProfile>

          <CommunitySidebarSection title={ui.yourContributions}>
            <div class="community-stat-list">
              <a href={memoriesHref}>
                <strong>{commentActivity.approved}</strong>
                <span>{ui.contributionActionsMemories}</span>
              </a>
              <a href={ratingsHref}>
                <strong>{commentActivity.reviewRatings}</strong>
                <span>{ui.contributionActionsRatings}</span>
              </a>
              <div>
                <strong>{commentActivity.communityPoints}</strong>
                <span>{ui.communityPoints}</span>
              </div>
              <div>
                <strong>{commentActivity.likesReceived}</strong>
                <span>{ui.likesReceived}</span>
              </div>
            </div>
          </CommunitySidebarSection>
        </>
      )}
    </Fragment>

    {isLoggedIn ? (
      <>
        <CommunityHero
          kicker={ui.heroKicker}
          title={ui.heroTitle}
          description={ui.heroDescription}
        >
          <div class="account-hero-actions">
            {publicProfileHref && <a href={publicProfileHref}>{ui.viewPublicProfile}</a>}
            <a href={messagesHref}>{ui.messages}</a>
          </div>
        </CommunityHero>

        <div class="community-content-stack">
            <section class="account-community-rank" aria-labelledby="account-community-rank-title">
              <div>
                <p class="account-kicker">{ui.communityKicker}</p>
                <h2 id="account-community-rank-title">{ui.communityLevel}</h2>
                <p>
                  {ui.communityLevelDescription}
                </p>
              </div>

              <div class="account-community-rank__summary">
                <span>{ui.currentLevel}</span>
                <strong>{communityRank.label}</strong>
                <p>{communityRankDescription}</p>
                <div class="account-community-rank__points">
                  <strong>{commentActivity.communityPoints}</strong>
                  <span>{ui.points}</span>
                </div>
              </div>

              {communityRank.nextRank ? (
                <div class="account-community-rank__progress">
                  <div>
                    <span>{ui.nextLevel}: {communityRank.nextRank.label}</span>
                  </div>
                  <p class="account-community-rank__progress-note">
                    {ui.progress}: {communityRankProgress}%
                  </p>
                  <div
                    class="account-community-rank__bar"
                    aria-label={`${ui.progressAria} ${communityRank.nextRank.label}`}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow={communityRankProgress}
                    role="progressbar"
                  >
                    <span style={`width: ${communityRankProgress}%`}></span>
                  </div>
                </div>
              ) : (
                <p class="account-community-rank__max">
                  {ui.maxLevel}
                </p>
              )}
            </section>

            <section class="account-settings-section account-profile-hub" aria-labelledby="account-settings-title">
              <div class="account-settings-section__heading">
                <p class="account-kicker">{ui.settingsKicker}</p>
                <h2 id="account-settings-title">{ui.profile}</h2>
                <p class="account-settings-section__hint">
                  {ui.profileOverview}
                </p>
              </div>

              <div class="account-profile-overview account-profile-overview--compact" data-account-profile-summary>
                <div class="account-actions">
                  <button type="button" data-account-profile-edit>{ui.editProfile}</button>
                </div>
              </div>

              <div class="account-profile-editor" data-account-profile-editor hidden>
                <div class="account-profile-editor__heading">
                  <div>
                    <p class="account-kicker">{ui.settingsKicker}</p>
                    <h3>{ui.profileEditorTitle}</h3>
                    <p>{ui.profileOverview}</p>
                  </div>
                </div>

                <div class="account-profile-editor__shell">
                  <nav
                    class="account-profile-editor-nav"
                    aria-label={ui.profileEditorTitle}
                    role="tablist"
                  >
                    <button
                      type="button"
                      id="account-settings-tab-identity"
                      data-account-settings-tab="identity"
                      aria-controls="account-profile-identity-panel"
                      aria-selected="true"
                      role="tab"
                    >
                      {ui.identity}
                    </button>
                    <button
                      type="button"
                      id="account-settings-tab-avatar"
                      data-account-settings-tab="avatar"
                      aria-controls="account-avatar-panel"
                      aria-selected="false"
                      role="tab"
                    >
                      {ui.avatar}
                    </button>
                    <button
                      type="button"
                      id="account-settings-tab-bio"
                      data-account-settings-tab="bio"
                      aria-controls="account-public-profile-panel"
                      aria-selected="false"
                      role="tab"
                    >
                      {ui.bioStatus}
                    </button>
                    <button
                      type="button"
                      id="account-settings-tab-newsletter"
                      data-account-settings-tab="newsletter"
                      aria-controls="account-newsletter-panel"
                      aria-selected="false"
                      role="tab"
                    >
                      Newsletter
                    </button>
                    <button
                      type="button"
                      id="account-settings-tab-retro"
                      data-account-settings-tab="retro"
                      aria-controls="account-retro-experience-panel"
                      aria-selected="false"
                      role="tab"
                    >
                      {ui.retroExperienceLabel}
                    </button>
                    <button
                      type="button"
                      id="account-settings-tab-password"
                      data-account-settings-tab="password"
                      aria-controls="account-password-panel"
                      aria-selected="false"
                      role="tab"
                    >
                      {ui.security}
                    </button>
                  </nav>

                  <div class="account-profile-editor__panels">
                    <section
                      class="account-profile-editor-section"
                      id="account-profile-identity-panel"
                      aria-labelledby="account-settings-tab-identity"
                      data-account-settings-panel="identity"
                      role="tabpanel"
                    >
                      <div class="account-profile-editor-section__heading">
                        <h3 id="account-profile-identity-title">{ui.identity}</h3>
                        <p>
                          {canEditDisplayName
                            ? ui.profileHintAdmin
                            : ui.profileHintReader}
                        </p>
                      </div>

                      <form class="account-form" data-account-profile-form>
                        {canEditDisplayName ? (
                          <label>
                            <span>{ui.displayName}</span>
                            <input
                              type="text"
                              name="displayName"
                              required
                              minlength="2"
                              maxlength="40"
                              value={profile?.display_name || profile?.username || ''}
                            />
                          </label>
                        ) : (
                          <div class="account-profile-readonly">
                            <span>{ui.displayName}</span>
                            <p>{profileDisplayName || ui.notSet}</p>
                            <small class="account-field-help">
                              {ui.displayNameReadonly}
                            </small>
                          </div>
                        )}

                        {badges.length === 0 && (
                          <div class="account-badge-empty">
                            <span>{ui.readerBadge}</span>
                            <p>{ui.noBadgesAvailable}</p>
                            <p>{ui.noBadgesDescription}</p>
                            <a class="account-field-link" href={badgesHref}>{ui.discoverBadges}</a>
                          </div>
                        )}

                        {badges.length > 0 && (
                          <label>
                            <span>{ui.readerBadge}</span>
                            <select name="badgeKey" required data-account-badge-select>
                              <option value="">{ui.chooseBadge}</option>
                              {badges.map((badge) => (
                                <option
                                  value={badge.key}
                                  selected={badge.key === editableBadgeKey}
                                  data-badge-label={getBadgeLabel(badge)}
                                  data-badge-image={getReaderBadgeImageSrcForBadge(badge)}
                                >
                                  {getBadgeLabel(badge)}
                                </option>
                              ))}
                            </select>

                            <div
                              class="account-badge-preview"
                              data-account-badge-preview
                              hidden={!editableBadgeLabel}
                            >
                              <img
                                src={editableBadgePreviewImageSrc}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                hidden={!editableBadgeImageSrc}
                                data-account-badge-preview-image
                              />
                              <strong data-account-badge-preview-label>{editableBadgeLabel}</strong>
                            </div>

                            <small class="account-field-help">
                              {ui.chooseBadgeHelp}
                            </small>

                            <a class="account-field-link" href={badgesHref}>{ui.discoverBadges}</a>
                          </label>
                        )}

                        <div class="account-actions">
                          <button type="submit">{ui.saveProfile}</button>
                        </div>
                      </form>

                      <p class="account-message" data-account-message hidden></p>
                    </section>

                    <section
                      class="account-profile-editor-section account-avatar-section"
                      id="account-avatar-panel"
                      aria-labelledby="account-settings-tab-avatar"
                      data-account-settings-panel="avatar"
                      role="tabpanel"
                      hidden
                    >
                      <div class="account-avatar-section__content">
                        <div class="account-profile-editor-section__heading">
                          <h3 id="account-avatar-title">{ui.avatar}</h3>
                          <p>
                            {avatarUrl
                              ? ui.avatarLoaded
                              : ui.avatarEmpty}
                          </p>
                        </div>

                        <form class="account-form account-avatar-form" data-account-avatar-form>
                          <label
                            class="account-avatar-dropzone"
                            data-account-avatar-dropzone
                            data-replace-label={avatarUrl ? ui.avatarDropReplace : ui.avatarDropUpload}
                          >
                            <input
                              class="account-avatar-input"
                              type="file"
                              name="avatar"
                              accept="image/jpeg,image/png,image/webp"
                              data-account-avatar-input
                            />
                            <span class="account-avatar-dropzone__label" data-account-avatar-dropzone-label>
                              {avatarUrl
                                ? ui.avatarChooseReplace
                                : ui.avatarChooseUpload}
                            </span>
                            <span class="account-avatar-dropzone__help">
                              {avatarUrl
                                ? ui.avatarHelpReplace
                                : ui.avatarHelpUpload}
                            </span>
                            <span
                              class="account-avatar-dropzone__filename"
                              data-account-avatar-filename
                              hidden
                            ></span>
                          </label>

                          <p class="account-message" data-account-avatar-message hidden></p>

                          <div class="account-actions">
                            <button type="submit">{avatarUrl ? ui.avatarReplace : ui.avatarUpload}</button>
                            <button
                              type="button"
                              data-account-avatar-remove
                              hidden={!avatarUrl}
                            >
                              {ui.avatarRemove}
                            </button>
                          </div>
                        </form>
                      </div>
                    </section>

                    <section
                      class="account-profile-editor-section account-public-profile"
                      id="account-public-profile-panel"
                      aria-labelledby="account-settings-tab-bio"
                      data-account-settings-panel="bio"
                      role="tabpanel"
                      hidden
                    >
                      <div class="account-public-profile__heading account-profile-editor-section__heading">
                        <h3 id="account-public-profile-title">{ui.publicProfileTitle}</h3>
                        <p>
                          {ui.publicProfileDescription}
                        </p>
                      </div>

                      <form
                        class="account-form account-form--bio"
                        data-account-bio-form
                        data-account-bio-expanded="true"
                      >
                        <label>
                          <span>{ui.bioIt}</span>
                          <textarea
                            name="bio"
                            maxlength="500"
                            rows="5"
                            placeholder={ui.bioItPlaceholder}
                          >{currentBio}</textarea>
                        </label>

                        <small class="account-character-count" data-account-bio-counter>
                          {currentBio.length}/500
                        </small>

                        <label>
                          <span>{ui.bioEn}</span>
                          <textarea
                            name="bioEn"
                            maxlength="500"
                            rows="5"
                            placeholder={ui.bioEnPlaceholder}
                          >{currentBioEn}</textarea>
                        </label>

                        <small class="account-character-count" data-account-bio-en-counter>
                          {currentBioEn.length}/500
                        </small>

                        <p class="account-field-help">
                          {ui.bioHelp}
                        </p>

                        <div class="account-actions">
                          <button type="submit">{ui.saveBio}</button>
                        </div>
                      </form>

                      <p class="account-message" data-account-bio-message hidden></p>
                    </section>

                    <section
                      class="account-profile-editor-section account-newsletter-card"
                      id="account-newsletter-panel"
                      aria-labelledby="account-settings-tab-newsletter"
                      data-account-settings-panel="newsletter"
                      data-account-newsletter
                      data-status={newsletterStatus}
                      role="tabpanel"
                      hidden
                    >
                      <div class="account-newsletter-card__heading account-profile-editor-section__heading">
                        <h3 id="account-newsletter-title">Newsletter</h3>
                        <p>
                          {ui.newsletterDescription}
                        </p>
                      </div>

                      {isNewsletterActive && (
                        <form class="account-form account-newsletter-form" data-account-newsletter-form>
                          <p class="account-newsletter-status">{ui.newsletterActive}</p>

                          <p class="account-newsletter-language-summary">
                            <span>{ui.preferredLanguage}:</span>
                            <strong>{newsletterLanguageLabel}</strong>
                          </p>

                          <p class="account-field-help">
                            {ui.newsletterOperationalNote}
                          </p>

                          <p class="account-message" data-account-newsletter-message hidden></p>

                          <div class="account-actions">
                            <button type="button" data-account-newsletter-unsubscribe>
                              {ui.newsletterUnsubscribe}
                            </button>
                          </div>
                        </form>
                      )}

                      {isNewsletterPending && (
                        <form class="account-form account-newsletter-form" data-account-newsletter-form>
                          <p class="account-newsletter-status">
                            {ui.newsletterPending}
                          </p>

                          <p class="account-newsletter-language-summary">
                            <span>{ui.preferredLanguage}:</span>
                            <strong>{newsletterLanguageLabel}</strong>
                          </p>

                          <p class="account-field-help">
                            {ui.newsletterPendingNote}
                          </p>

                          <p class="account-field-help">
                            {ui.newsletterOperationalNote}
                          </p>

                          <p class="account-message" data-account-newsletter-message hidden></p>

                          <div class="account-actions">
                            <button type="button" data-account-newsletter-resend>
                              {ui.newsletterResendConfirmation}
                            </button>

                            <button type="button" data-account-newsletter-unsubscribe>
                              {ui.newsletterUnsubscribe}
                            </button>
                          </div>
                        </form>
                      )}

                      {isNewsletterSubscribable && (
                        <form class="account-form account-newsletter-form" data-account-newsletter-form>
                          <NewsletterPromo lang={currentLang} variant="account" compact />

                          <p class="account-newsletter-status">
                            {newsletterStatus === 'unsubscribed'
                              ? ui.newsletterUnsubscribed
                              : ui.newsletterNone}
                          </p>

                          <label>
                            <span>{ui.preferredLanguage}</span>
                            <select
                              name="language"
                              data-account-newsletter-language
                            >
                              <option value="it" selected={newsletterLanguage !== 'en'}>Italiano</option>
                              <option value="en" selected={newsletterLanguage === 'en'}>English</option>
                            </select>
                          </label>

                          <label class="account-newsletter-consent" data-account-newsletter-consent>
                            <input type="checkbox" name="consent" />
                            <span>
                              {ui.newsletterConsent}
                              {' '}
                              <a href={privacyHref}>{ui.privacyPolicy}</a>.
                            </span>
                          </label>

                          <p class="account-message" data-account-newsletter-message hidden></p>

                          <div class="account-actions">
                            <button type="button" data-account-newsletter-subscribe>
                              {newsletterStatus === 'unsubscribed' ? ui.newsletterResubscribe : ui.newsletterSubscribe}
                            </button>
                          </div>
                        </form>
                      )}
                    </section>

                    <section
                      class="account-profile-editor-section account-profile-editor-section--retro"
                      id="account-retro-experience-panel"
                      aria-labelledby="account-settings-tab-retro"
                      data-account-settings-panel="retro"
                      role="tabpanel"
                      hidden
                    >
                      <RetroExperienceSettings
                        lang={currentLang}
                        retroExperience={profile?.retro_experience}
                      />
                    </section>

                    <section
                      class="account-profile-editor-section"
                      id="account-password-panel"
                      aria-labelledby="account-settings-tab-password"
                      data-account-settings-panel="password"
                      role="tabpanel"
                      hidden
                    >
                      <div class="account-profile-editor-section__heading">
                        <h3 id="account-security-title">{ui.security}</h3>
                        <p>{ui.securityDescription}</p>
                      </div>

                      {showPasswordChangeForm ? (
                        <form class="account-form" data-account-password-form>
                          <label>
                            <span>{ui.currentPassword}</span>
                            <input
                              type="password"
                              name="currentPassword"
                              autocomplete="current-password"
                              required
                            />
                          </label>

                          <label>
                            <span>{ui.newPassword}</span>
                            <input
                              type="password"
                              name="newPassword"
                              autocomplete="new-password"
                              minlength="8"
                              required
                            />
                          </label>

                          <label>
                            <span>{ui.confirmNewPassword}</span>
                            <input
                              type="password"
                              name="confirmPassword"
                              autocomplete="new-password"
                              minlength="8"
                              required
                            />
                          </label>

                          <small class="account-field-help">{ui.passwordHelp}</small>

                          <div class="account-actions">
                            <button type="submit">{ui.changePassword}</button>
                          </div>
                        </form>
                      ) : (
                        <p class="account-field-help">{ui.passwordSocialOnly}</p>
                      )}

                      <p class="account-message" data-account-password-message hidden></p>
                    </section>
                  </div>
                </div>

                <div class="account-profile-editor__footer">
                  <button type="button" data-account-profile-cancel>{ui.closeSettings}</button>
                </div>
              </div>
            </section>

            <section class="account-interest-articles" aria-labelledby="account-interest-suggestions-title">
              <div class="account-section-heading">
                <p class="account-kicker">{ui.forYou}</p>
                <h2 id="account-interest-suggestions-title">{ui.fromInterests}</h2>
                <p>{ui.fromInterestsDescription}</p>
              </div>

              {dashboardRetention.suggestedArticlesFromInterests.length > 0 ? (
                <div class="account-interest-articles__grid">
                  {dashboardRetention.suggestedArticlesFromInterests.map((article) => (
                    <article class="account-interest-article-card">
                      {article.imageUrl && (
                        <a class="account-interest-article-card__image" href={article.href} aria-label={article.title}>
                          <img
                            src={article.imageUrl}
                            alt={article.imageAlt || article.title}
                            width="640"
                            height="400"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      )}

                      <div class="account-interest-article-card__body">
                        <div class="account-interest-article-card__meta">
                          {article.categoryLabel && <span>{article.categoryLabel}</span>}
                        </div>
                        <h3><a href={article.href}>{article.title}</a></h3>
                        {article.excerpt && <p>{article.excerpt}</p>}
                        <a class="account-interest-article-card__link" href={article.href}>
                          {ui.readArticle}
                        </a>
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <p class="account-interest-articles__empty">
                  {dashboardRetention.hasInterests ? ui.interestsNoArticles : ui.interestsEmpty}
                </p>
              )}

              <div class="account-retention-actions">
                <a href={favoritesHref}>{ui.manageInterests}</a>
              </div>
            </section>
        </div>
      </>
    ) : (
      <>
        <CommunityHero
          kicker={ui.heroKicker}
          title={ui.heroTitle}
          description={ui.guestDescription}
        />

        <section class="community-card">
          <div class="account-actions account-actions--standalone">
            <a href={loginHref}>{ui.login}</a>
            <a href={registerHref}>{ui.register}</a>
          </div>
        </section>
      </>
    )}
  </CommunityLayout>

  <script define:vars={{ clientCopy }}>
    const form = document.querySelector('[data-account-profile-form]');
    const profileMessage = document.querySelector('[data-account-message]');
    const passwordForm = document.querySelector('[data-account-password-form]');
    const passwordMessage = document.querySelector('[data-account-password-message]');
    const profileSummary = document.querySelector('[data-account-profile-summary]');
    const profileEditor = document.querySelector('[data-account-profile-editor]');
    const profileEditButton = document.querySelector('[data-account-profile-edit]');
    const profileCancelButton = document.querySelector('[data-account-profile-cancel]');
    const settingsTabButtons = document.querySelectorAll('[data-account-settings-tab]');
    const settingsPanels = document.querySelectorAll('[data-account-settings-panel]');
    const profileDisplayNameInput = document.querySelector('[data-account-profile-form] input[name="displayName"]');
    const profileBadgeInput = document.querySelector('[data-account-profile-form] [name="badgeKey"]');
    const profileBadgeSelect = document.querySelector('[data-account-badge-select]');
    const badgePreview = document.querySelector('[data-account-badge-preview]');
    const badgePreviewImage = document.querySelector('[data-account-badge-preview-image]');
    const badgePreviewLabel = document.querySelector('[data-account-badge-preview-label]');
    const bioForm = document.querySelector('[data-account-bio-form]');
    const bioMessage = document.querySelector('[data-account-bio-message]');
    const bioTextarea = document.querySelector('[data-account-bio-form] textarea[name="bio"]');
    const bioEnTextarea = document.querySelector('[data-account-bio-form] textarea[name="bioEn"]');
    const bioCounter = document.querySelector('[data-account-bio-counter]');
    const bioEnCounter = document.querySelector('[data-account-bio-en-counter]');
    const bioSummary = document.querySelector('[data-account-bio-summary]');
    const bioEmpty = document.querySelector('[data-account-bio-empty]');
    const bioSummaryIt = document.querySelector('[data-account-bio-summary-it]');
    const bioSummaryEn = document.querySelector('[data-account-bio-summary-en]');
    const bioSummaryEnText = document.querySelector('[data-account-bio-summary-en-text]');
    const bioSummaryEnFallback = document.querySelector('[data-account-bio-en-fallback]');
    const bioEditButtons = document.querySelectorAll('[data-account-bio-edit]');
    const bioCancelButton = document.querySelector('[data-account-bio-cancel]');
    const avatarForm = document.querySelector('[data-account-avatar-form]');
    const avatarInput = document.querySelector('[data-account-avatar-input]');
    const avatarMessage = document.querySelector('[data-account-avatar-message]');
    const avatarRemoveButton = document.querySelector('[data-account-avatar-remove]');
    const avatarDropzone = document.querySelector('[data-account-avatar-dropzone]');
    const avatarDropzoneLabel = document.querySelector('[data-account-avatar-dropzone-label]');
    const avatarFilename = document.querySelector('[data-account-avatar-filename]');
    const newsletterConsent = document.querySelector('[data-account-newsletter-consent]');
    const newsletterLanguage = document.querySelector('[data-account-newsletter-language]');
    const newsletterSubscribeButton = document.querySelector('[data-account-newsletter-subscribe]');
    const newsletterResendButton = document.querySelector('[data-account-newsletter-resend]');
    const newsletterUnsubscribeButton = document.querySelector('[data-account-newsletter-unsubscribe]');
    const newsletterMessage = document.querySelector('[data-account-newsletter-message]');
    const avatarDefaultDropzoneText = avatarDropzoneLabel?.textContent?.trim() || '';
    const avatarReplaceDropzoneText = avatarDropzone?.dataset.replaceLabel || '';
    let selectedAvatarFile = null;
    let savedDisplayName = profileDisplayNameInput?.value || '';
    let savedBadgeKey = profileBadgeInput?.value || '';
    let savedBadgeLabel = badgePreviewLabel?.textContent?.trim() || '';
    let savedBadgeImage = badgePreview?.querySelector('img')?.getAttribute('src') || '';
    let savedBio = bioTextarea?.value || '';
    let savedBioEn = bioEnTextarea?.value || '';
    const bioAlwaysExpanded = bioForm?.dataset.accountBioExpanded === 'true';
    let activeSettingsPanel = 'identity';

    const showMessage = (target, text, type = 'ok') => {
      if (!target) return;
      target.textContent = text;
      target.hidden = false;
      target.dataset.type = type;
    };

    const localizedMessage = (apiMessage, fallback) => {
      if (clientCopy.lang === 'en') return fallback;
      return apiMessage || fallback;
    };

    const localizedApiMessage = (payload, fallback) => {
      if (clientCopy.lang === 'en') return payload?.errorEn || payload?.messageEn || payload?.error || payload?.message || fallback;
      return payload?.error || payload?.message || fallback;
    };

    const setNewsletterLoading = (isLoading) => {
      if (newsletterSubscribeButton) {
        newsletterSubscribeButton.disabled = isLoading;
      }

      if (newsletterUnsubscribeButton) {
        newsletterUnsubscribeButton.disabled = isLoading;
      }

      if (newsletterResendButton) {
        newsletterResendButton.disabled = isLoading;
      }
    };

    const reloadNewsletterState = () => {
      window.setTimeout(() => {
        window.location.reload();
      }, 700);
    };

    const getSelectedBadgeData = () => {
      if (profileBadgeSelect) {
        const selectedOption = profileBadgeSelect.selectedOptions?.[0];
        const key = profileBadgeSelect.value || '';

        if (!key || !selectedOption) {
          return { key: '', label: '', image: '' };
        }

        return {
          key,
          label: selectedOption.dataset.badgeLabel || selectedOption.textContent?.trim() || key,
          image: selectedOption.dataset.badgeImage || '',
        };
      }

      if (profileBadgeInput?.value) {
        return {
          key: profileBadgeInput.value,
          label: profileBadgeInput.dataset.badgeLabel || savedBadgeLabel,
          image: profileBadgeInput.dataset.badgeImage || savedBadgeImage,
        };
      }

      return { key: '', label: '', image: '' };
    };

    const updateBadgePreview = () => {
      const badge = getSelectedBadgeData();

      if (badgePreview) badgePreview.hidden = !badge.label;
      if (badgePreviewLabel) badgePreviewLabel.textContent = badge.label;

      if (badgePreviewImage) {
        if (badge.image) {
          badgePreviewImage.setAttribute('src', badge.image);
          badgePreviewImage.hidden = false;
        } else {
          badgePreviewImage.hidden = true;
        }
      }
    };

    const setProfileEditMode = (isEditing, shouldFocus = false) => {
      if (profileSummary) profileSummary.hidden = isEditing;
      if (profileEditor) profileEditor.hidden = !isEditing;
      if (form) form.hidden = false;

      if (isEditing) {
        if (profileMessage) profileMessage.hidden = true;
        setActiveSettingsPanel('identity', shouldFocus);
        updateBadgePreview();
      }
    };

    const setActiveSettingsPanel = (panelName, shouldFocus = false) => {
      activeSettingsPanel = panelName || 'identity';

      settingsTabButtons.forEach((button) => {
        const isActive = button.dataset.accountSettingsTab === activeSettingsPanel;
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      settingsPanels.forEach((panel) => {
        panel.hidden = panel.dataset.accountSettingsPanel !== activeSettingsPanel;
      });

      if (!shouldFocus) return;

      window.setTimeout(() => {
        const activePanel = document.querySelector(`[data-account-settings-panel="${activeSettingsPanel}"]`);
        const focusTarget = activePanel?.querySelector('input:not([type="file"]), select, textarea, button');
        focusTarget?.focus();
      }, 0);
    };

    settingsTabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActiveSettingsPanel(button.dataset.accountSettingsTab || 'identity', true);
      });
    });

    profileEditButton?.addEventListener('click', () => {
      if (profileDisplayNameInput) profileDisplayNameInput.value = savedDisplayName;
      if (profileBadgeSelect) profileBadgeSelect.value = savedBadgeKey;
      updateBadgePreview();
      setProfileEditMode(true, true);
    });

    profileCancelButton?.addEventListener('click', () => {
      if (profileDisplayNameInput) profileDisplayNameInput.value = savedDisplayName;
      if (profileBadgeSelect) profileBadgeSelect.value = savedBadgeKey;
      if (!profileBadgeSelect && profileBadgeInput) profileBadgeInput.value = savedBadgeKey;
      updateBadgePreview();
      if (profileMessage) profileMessage.hidden = true;
      setProfileEditMode(false);
    });

    profileBadgeSelect?.addEventListener('change', updateBadgePreview);

    newsletterSubscribeButton?.addEventListener('click', async () => {
      const consentInput = newsletterConsent?.querySelector('input[name="consent"]');

      if (!consentInput?.checked) {
        showMessage(newsletterMessage, clientCopy.newsletterConsentRequired, 'error');
        consentInput?.focus();
        return;
      }

      setNewsletterLoading(true);

      try {
        const response = await fetch('/api/account/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'subscribe',
            language: newsletterLanguage?.value === 'en' ? 'en' : 'it',
            consent: true
          })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(newsletterMessage, localizedMessage(result.error, clientCopy.newsletterUpdateFailed), 'error');
          return;
        }

        showMessage(newsletterMessage, localizedMessage(result.message, clientCopy.newsletterConfirmEmail), 'ok');
        reloadNewsletterState();

        if (consentInput) {
          consentInput.checked = false;
        }
      } catch {
        showMessage(newsletterMessage, clientCopy.newsletterUpdateFailed, 'error');
      } finally {
        setNewsletterLoading(false);
      }
    });

    newsletterResendButton?.addEventListener('click', async () => {
      setNewsletterLoading(true);

      try {
        const response = await fetch('/api/account/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'resend_confirmation' })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(newsletterMessage, localizedMessage(result.error, clientCopy.newsletterResendFailed), 'error');
          return;
        }

        showMessage(newsletterMessage, localizedMessage(result.message, clientCopy.newsletterConfirmationResent), 'ok');
      } catch {
        showMessage(newsletterMessage, clientCopy.newsletterResendFailed, 'error');
      } finally {
        setNewsletterLoading(false);
      }
    });

    newsletterUnsubscribeButton?.addEventListener('click', async () => {
      setNewsletterLoading(true);

      try {
        const response = await fetch('/api/account/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'unsubscribe' })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(newsletterMessage, localizedMessage(result.error, clientCopy.newsletterUpdateFailed), 'error');
          return;
        }

        showMessage(newsletterMessage, localizedMessage(result.message, clientCopy.newsletterDisabled), 'ok');
        reloadNewsletterState();
      } catch {
        showMessage(newsletterMessage, clientCopy.newsletterUpdateFailed, 'error');
      } finally {
        setNewsletterLoading(false);
      }
    });

    const updateBioCounter = () => {
      if (!bioTextarea || !bioCounter) return;
      bioCounter.textContent = `${bioTextarea.value.length}/500`;
    };

    const updateBioEnCounter = () => {
      if (!bioEnTextarea || !bioEnCounter) return;
      bioEnCounter.textContent = `${bioEnTextarea.value.length}/500`;
    };

    const updateBioSummary = () => {
      const hasBio = savedBio.trim().length > 0;
      const hasBioEn = savedBioEn.trim().length > 0;

      if (bioSummary) bioSummary.hidden = !hasBio;
      if (bioEmpty) bioEmpty.hidden = hasBio;
      if (bioSummaryIt) bioSummaryIt.textContent = savedBio;
      if (bioSummaryEn) bioSummaryEn.hidden = !hasBioEn;
      if (bioSummaryEnText) bioSummaryEnText.textContent = savedBioEn;
      if (bioSummaryEnFallback) bioSummaryEnFallback.hidden = hasBioEn;
    };

    const setBioEditMode = (isEditing, shouldFocus = false) => {
      if (bioAlwaysExpanded) {
        if (bioForm) bioForm.hidden = false;
        if (bioSummary) bioSummary.hidden = true;
        if (bioEmpty) bioEmpty.hidden = true;
        if (bioMessage && isEditing) bioMessage.hidden = true;
        if (isEditing && shouldFocus) {
          window.setTimeout(() => bioTextarea?.focus(), 0);
        }
        return;
      }

      if (bioForm) bioForm.hidden = !isEditing;

      if (isEditing) {
        if (bioSummary) bioSummary.hidden = true;
        if (bioEmpty) bioEmpty.hidden = true;
        if (bioMessage) bioMessage.hidden = true;
        if (shouldFocus) {
          window.setTimeout(() => bioTextarea?.focus(), 0);
        }
        return;
      }

      updateBioSummary();
    };

    updateBioCounter();
    updateBioEnCounter();
    bioTextarea?.addEventListener('input', updateBioCounter);
    bioEnTextarea?.addEventListener('input', updateBioEnCounter);
    bioEditButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (bioTextarea) bioTextarea.value = savedBio;
        if (bioEnTextarea) bioEnTextarea.value = savedBioEn;
        updateBioCounter();
        updateBioEnCounter();
        setBioEditMode(true, true);
      });
    });
    bioCancelButton?.addEventListener('click', () => {
      if (bioTextarea) bioTextarea.value = savedBio;
      if (bioEnTextarea) bioEnTextarea.value = savedBioEn;
      updateBioCounter();
      updateBioEnCounter();
      if (bioMessage) bioMessage.hidden = true;
      setBioEditMode(false);
    });

    const validAvatarTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);

    const updateAvatarFilename = (file) => {
      if (!avatarFilename) return;

      if (!file) {
        avatarFilename.textContent = '';
        avatarFilename.hidden = true;
        return;
      }

      avatarFilename.textContent = `${clientCopy.fileSelected}: ${file.name}`;
      avatarFilename.hidden = false;
    };

    const handleAvatarFile = (file) => {
      selectedAvatarFile = null;
      updateAvatarFilename(file);

      if (!file) {
        return;
      }

      if (!validAvatarTypes.has(file.type)) {
        showMessage(avatarMessage, clientCopy.invalidFile, 'error');
        return;
      }

      if (file.size > 2 * 1024 * 1024) {
        showMessage(avatarMessage, clientCopy.fileTooLarge, 'error');
        return;
      }

      selectedAvatarFile = file;
      if (avatarMessage) avatarMessage.hidden = true;
    };

    avatarInput?.addEventListener('change', () => {
      handleAvatarFile(avatarInput.files?.[0]);
    });

    if (avatarDropzone && avatarInput) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        avatarDropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          avatarDropzone.dataset.dragActive = 'true';

          if (avatarDropzoneLabel) {
            avatarDropzoneLabel.textContent = avatarReplaceDropzoneText;
          }
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        avatarDropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          delete avatarDropzone.dataset.dragActive;

          if (avatarDropzoneLabel) {
            avatarDropzoneLabel.textContent = avatarDefaultDropzoneText;
          }
        });
      });

      avatarDropzone.addEventListener('drop', (event) => {
        const file = event.dataTransfer?.files?.[0];

        if (!file) {
          return;
        }

        try {
          avatarInput.files = event.dataTransfer.files;
        } catch {
          // Some browsers keep file inputs read-only for dropped files.
        }

        handleAvatarFile(file);
      });
    }

    avatarForm?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const file = selectedAvatarFile || avatarInput?.files?.[0];
      const button = avatarForm.querySelector('button[type="submit"]');

      if (!file || !validAvatarTypes.has(file.type)) {
        showMessage(avatarMessage, clientCopy.invalidFile, 'error');
        return;
      }

      if (file.size > 2 * 1024 * 1024) {
        showMessage(avatarMessage, clientCopy.fileTooLarge, 'error');
        return;
      }

      if (button) button.disabled = true;

      try {
        const payload = new FormData();
        payload.set('avatar', file);

        const response = await fetch('/api/account/avatar/upload', {
          method: 'POST',
          body: payload
        });
        const result = await response.json();

        if (!result.ok) {
          showMessage(avatarMessage, localizedMessage(result.error, clientCopy.uploadFailed), 'error');
          return;
        }

        showMessage(avatarMessage, clientCopy.avatarUpdated, 'ok');
        window.setTimeout(() => window.location.reload(), 450);
      } catch {
        showMessage(avatarMessage, clientCopy.connectionError, 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });

    avatarRemoveButton?.addEventListener('click', async () => {
      avatarRemoveButton.disabled = true;

      try {
        const response = await fetch('/api/account/avatar/remove', {
          method: 'POST'
        });
        const result = await response.json();

        if (!result.ok) {
          showMessage(avatarMessage, localizedMessage(result.error, clientCopy.removeFailed), 'error');
          avatarRemoveButton.disabled = false;
          return;
        }

        showMessage(avatarMessage, clientCopy.avatarRemoved, 'ok');
        window.setTimeout(() => window.location.reload(), 450);
      } catch {
        showMessage(avatarMessage, clientCopy.connectionError, 'error');
        avatarRemoveButton.disabled = false;
      }
    });

    passwordForm?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(passwordForm);
      const currentPassword = String(formData.get('currentPassword') || '');
      const newPassword = String(formData.get('newPassword') || '');
      const confirmPassword = String(formData.get('confirmPassword') || '');
      const button = passwordForm.querySelector('button[type="submit"]');

      if (!currentPassword || !newPassword || !confirmPassword) {
        showMessage(passwordMessage, clientCopy.passwordMissingFields, 'error');
        return;
      }

      if (newPassword.length < 8) {
        showMessage(passwordMessage, clientCopy.passwordTooShort, 'error');
        return;
      }

      if (newPassword !== confirmPassword) {
        showMessage(passwordMessage, clientCopy.passwordMismatch, 'error');
        return;
      }

      if (newPassword === currentPassword) {
        showMessage(passwordMessage, clientCopy.passwordSame, 'error');
        return;
      }

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/account/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            currentPassword,
            newPassword,
            confirmPassword,
          })
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          showMessage(passwordMessage, localizedApiMessage(result, clientCopy.passwordUpdateFailed), 'error');
          return;
        }

        passwordForm.reset();
        showMessage(passwordMessage, localizedApiMessage(result, clientCopy.passwordUpdated), 'ok');
      } catch {
        showMessage(passwordMessage, clientCopy.connectionError, 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const button = form.querySelector('button[type="submit"]');
      const nextBadge = getSelectedBadgeData();
      const payload = {
        ...(formData.has('displayName') ? { displayName: String(formData.get('displayName') || '') } : {}),
        ...(formData.has('badgeKey') ? { badgeKey: String(formData.get('badgeKey') || '') } : {})
      };

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/account/update-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(profileMessage, localizedMessage(result.error, clientCopy.profileUpdateFailed), 'error');
          return;
        }

        showMessage(profileMessage, clientCopy.profileUpdated, 'ok');
        savedDisplayName = result.profile?.display_name || payload.displayName?.trim() || savedDisplayName;
        savedBadgeKey = nextBadge.key;
        savedBadgeLabel = nextBadge.label;
        savedBadgeImage = nextBadge.image;
      } catch {
        showMessage(profileMessage, clientCopy.connectionError, 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });

    bioForm?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(bioForm);
      const button = bioForm.querySelector('button[type="submit"]');
      const bio = String(formData.get('bio') || '');
      const bioEn = String(formData.get('bioEn') || '');

      if (bio.length > 500) {
        showMessage(bioMessage, clientCopy.bioTooLong, 'error');
        return;
      }

      if (bioEn.length > 500) {
        showMessage(bioMessage, clientCopy.bioEnTooLong, 'error');
        return;
      }

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/account/update-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bio, bioEn })
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(bioMessage, localizedMessage(result.error, clientCopy.profileUpdateFailed), 'error');
          return;
        }

        savedBio = typeof result.profile?.bio === 'string' ? result.profile.bio : bio.trim();
        savedBioEn = typeof result.profile?.bio_en === 'string' ? result.profile.bio_en : bioEn.trim();

        if (bioTextarea) bioTextarea.value = savedBio;
        if (bioEnTextarea) bioEnTextarea.value = savedBioEn;
        updateBioCounter();
        updateBioEnCounter();
        setBioEditMode(false);
        showMessage(bioMessage, clientCopy.bioUpdated, 'ok');
      } catch {
        showMessage(bioMessage, clientCopy.connectionError, 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });
  </script>
</BaseLayout>
