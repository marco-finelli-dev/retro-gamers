---
import '../../styles/pages/account.css';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang = 'it' } = Astro.props;
const isEnglish = lang === 'en';

const copy = isEnglish
  ? {
      title: 'Sign in to Retro-Gamers.it',
      description: 'Sign in to your reader profile to comment on Retro-Gamers.it articles.',
      kicker: 'Reader profile',
      heading: 'Sign in',
      intro: 'Sign in with your account to join the discussions below the articles.',
      socialAria: 'Social sign in',
      divider: 'OR',
      email: 'Email',
      password: 'Password',
      submit: 'Sign in',
      switchText: 'Don’t have an account yet?',
      switchLink: 'Create one',
      switchHref: '/en/account/register/',
      resend: 'Did not receive the email? Resend confirmation',
      google: 'Continue with Google',
      apple: 'Continue with Apple',
      facebook: 'Continue with Facebook',
      oauthError: 'Social sign in was not completed. Try again or use email and password.',
    }
  : {
      title: 'Accedi a Retro-Gamers.it',
      description: 'Accedi al tuo profilo lettore per commentare gli articoli di Retro-Gamers.it.',
      kicker: 'Profilo lettore',
      heading: 'Accedi',
      intro: 'Entra con il tuo account per partecipare alle discussioni sotto gli articoli.',
      socialAria: 'Accesso social',
      divider: 'oppure',
      email: 'Email',
      password: 'Password',
      submit: 'Accedi',
      switchText: 'Non hai ancora un account?',
      switchLink: 'Registrati',
      switchHref: '/account/register/',
      resend: 'Non hai ricevuto la mail? Reinvia conferma',
      google: 'Continua con Google',
      apple: 'Continua con Apple',
      facebook: 'Continua con Facebook',
      oauthError: 'Accesso social non completato. Riprova oppure usa email e password.',
    };

const clientCopy = isEnglish
  ? {
      lang: 'en',
      loginFailed: 'Sign in failed. Check your email and password.',
      loginSuccess: 'Signed in. You can return to the article and comment.',
      emailNotConfirmed: 'Account not confirmed. Check your email or request a new confirmation link.',
      connectionError: 'Connection error. Please try again.',
      missingResendEmail: 'Enter your email in the field above, then request a new link.',
      resendFailed: 'The request could not be completed. Please try again later.',
      resendSuccess: 'If the address is valid, you will receive a new confirmation email.',
    }
  : {
      lang: 'it',
      loginFailed: 'Login non riuscito.',
      loginSuccess: 'Login effettuato. Puoi tornare all’articolo e commentare.',
      emailNotConfirmed: 'Account non confermato. Controlla la tua email o richiedi un nuovo link di conferma.',
      connectionError: 'Errore di connessione. Riprova.',
      missingResendEmail: 'Inserisci la tua email nel campo sopra, poi richiedi un nuovo link.',
      resendFailed: 'Richiesta non completata. Riprova più tardi.',
      resendSuccess: 'Se l’indirizzo è valido, riceverai una nuova email di conferma.',
    };

const defaultReturnTo = isEnglish ? '/en/' : '/';
const returnTo = Astro.url.searchParams.get('returnTo') || defaultReturnTo;
const encodedReturnTo = encodeURIComponent(returnTo);
const oauthError = Astro.url.searchParams.get('oauthError');
const oauthErrorMessage = oauthError ? copy.oauthError : '';
const enableAppleLogin = false;
const enableFacebookLogin = false;
const socialProviders = [
  {
    provider: 'google',
    label: copy.google,
    iconLight: '/icons/oauth/google-light.webp',
    iconDark: '/icons/oauth/google-dark.webp',
  },
  ...(enableAppleLogin
    ? [
        {
          provider: 'apple',
          label: copy.apple,
          iconLight: '/icons/oauth/apple-light.webp',
          iconDark: '/icons/oauth/apple-dark.webp',
        },
      ]
    : []),
  ...(enableFacebookLogin
    ? [
        {
          provider: 'facebook',
          label: copy.facebook,
          iconLight: '/icons/oauth/facebook-light.webp',
          iconDark: '/icons/oauth/facebook-dark.webp',
        },
      ]
    : []),
];

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/account/login/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/account/login/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/account/login/' },
];

const languageSwitch = {
  url: isEnglish ? '/account/login/' : '/en/account/login/',
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  languageSwitch={languageSwitch}
  alternateLanguages={alternateLanguages}
>
  <div class="account-page">
    <section class="account-card">
      <p class="account-kicker">{copy.kicker}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>

      <div class:list={['account-social-auth', socialProviders.length === 1 && 'account-social-auth--single']} aria-label={copy.socialAria}>
        {socialProviders.map((provider) => (
          <a
            href={`/api/auth/oauth/start?provider=${provider.provider}&returnTo=${encodedReturnTo}`}
            aria-label={provider.label}
          >
            <span class="account-social-auth__icons" aria-hidden="true">
              <img
                class="account-social-auth__icon account-social-auth__icon--light"
                src={provider.iconLight}
                alt=""
                width="24"
                height="24"
                loading="lazy"
              />
              <img
                class="account-social-auth__icon account-social-auth__icon--dark"
                src={provider.iconDark}
                alt=""
                width="24"
                height="24"
                loading="lazy"
              />
            </span>
            <span>{provider.label}</span>
          </a>
        ))}
      </div>

      {oauthErrorMessage && (
        <p class="account-message" data-type="error">{oauthErrorMessage}</p>
      )}

      <div class="account-divider" aria-hidden="true">
        <span>{copy.divider}</span>
      </div>

      <form
        class="account-form"
        data-login-form
        data-client-lang={clientCopy.lang}
        data-login-failed={clientCopy.loginFailed}
        data-login-success={clientCopy.loginSuccess}
        data-email-not-confirmed={clientCopy.emailNotConfirmed}
        data-connection-error={clientCopy.connectionError}
        data-missing-resend-email={clientCopy.missingResendEmail}
        data-resend-failed={clientCopy.resendFailed}
        data-resend-success={clientCopy.resendSuccess}
      >
        <input type="hidden" name="returnTo" value={returnTo} />

        <label>
          <span>{copy.email}</span>
          <input id="login-email" type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>{copy.password}</span>
          <input id="login-password" type="password" name="password" required autocomplete="current-password" />
        </label>

        <p class="account-message" data-account-message hidden></p>

        <button type="submit">{copy.submit}</button>
      </form>

      <p class="account-switch">
        {copy.switchText}
        <a href={copy.switchHref}>{copy.switchLink}</a>
      </p>

      <p class="account-resend-confirmation">
        <button type="button" data-resend-confirmation>
          {copy.resend}
        </button>
      </p>
    </section>
  </div>

  <script>
    import { trackRgEvent } from '../../lib/analytics/client';

    const form = document.querySelector<HTMLFormElement>('[data-login-form]');
    const message = document.querySelector<HTMLElement>('[data-account-message]');
    const resendButton = document.querySelector<HTMLButtonElement>('[data-resend-confirmation]');
    const clientCopy = {
      lang: form?.dataset.clientLang === 'en' ? 'en' : 'it',
      loginFailed: form?.dataset.loginFailed || 'Sign in failed. Check your email and password.',
      loginSuccess: form?.dataset.loginSuccess || 'Signed in. You can return to the article and comment.',
      emailNotConfirmed: form?.dataset.emailNotConfirmed || 'Account not confirmed. Check your email or request a new confirmation link.',
      connectionError: form?.dataset.connectionError || 'Connection error. Please try again.',
      missingResendEmail: form?.dataset.missingResendEmail || 'Enter your email in the field above, then request a new link.',
      resendFailed: form?.dataset.resendFailed || 'The request could not be completed. Please try again later.',
      resendSuccess: form?.dataset.resendSuccess || 'If the address is valid, you will receive a new confirmation email.',
    };
    let loginRequestInFlight = false;

    const showMessage = (text, type = 'ok') => {
      if (!message) return;
      message.textContent = text;
      message.hidden = false;
      message.dataset.type = type;
    };

    const errorMessage = (result) => {
      if (clientCopy.lang === 'en') {
        return result?.code === 'email_not_confirmed'
          ? clientCopy.emailNotConfirmed
          : clientCopy.loginFailed;
      }

      return result?.error || clientCopy.loginFailed;
    };

    const resultMessage = (result, key, fallback) => {
      if (clientCopy.lang === 'en') {
        return result?.[`${key}En`] || fallback;
      }

      return result?.[key] || fallback;
    };

    const getLoginDestination = (value): 'account' | 'previous_page' | 'home' => {
      const returnTo = String(value || '').trim();

      if (returnTo === '/' || returnTo === '/en/' || returnTo === '/en') {
        return 'home';
      }

      if (/^\/(?:en\/)?account(?:\/|$)/.test(returnTo)) {
        return 'account';
      }

      return 'previous_page';
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (loginRequestInFlight) return;
      loginRequestInFlight = true;

      const formData = new FormData(form);
      const button = form.querySelector('button[type="submit"]');
      let loginAccepted = false;

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: String(formData.get('email') || ''),
            password: String(formData.get('password') || '')
          })
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(errorMessage(result), 'error');
          return;
        }

        loginAccepted = true;
        showMessage(clientCopy.loginSuccess, 'ok');
        trackRgEvent('login_success', {
          language: clientCopy.lang,
          method: 'email',
          destination: getLoginDestination(formData.get('returnTo')),
        });

        setTimeout(() => {
          const returnTo = String(formData.get('returnTo') || '/');
          window.location.href = returnTo.startsWith('/') ? returnTo : '/';
        }, 700);
      } catch {
        showMessage(clientCopy.connectionError, 'error');
      } finally {
        if (!loginAccepted) {
          loginRequestInFlight = false;
          if (button) button.disabled = false;
        }
      }
    });

    resendButton?.addEventListener('click', async () => {
      const emailInput = form?.querySelector('input[name="email"]');
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';

      if (!email) {
        showMessage(clientCopy.missingResendEmail, 'error');
        emailInput?.focus();
        return;
      }

      resendButton.disabled = true;

      try {
        const response = await fetch('/api/auth/resend-confirmation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(resultMessage(result, 'error', clientCopy.resendFailed), 'error');
          return;
        }

        showMessage(resultMessage(result, 'message', clientCopy.resendSuccess), 'ok');
      } catch {
        showMessage(clientCopy.connectionError, 'error');
      } finally {
        resendButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
