---
import '../../styles/pages/account.css';
import '../../styles/pages/account-messages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../../components/community/CommunityHero.astro';
import CommunityLayout from '../../components/community/CommunityLayout.astro';
import UserAvatar from '../../components/account/UserAvatar.astro';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';
import {
  getPrivateConversationThread,
  getPrivateProfileLabel,
  getPrivateProfileUrl,
  isPrivateMessagesUnavailable,
  markPrivateConversationRead,
} from '../../lib/supabase/private-messages';
import { touchUserActivity } from '../../lib/supabase/user-activity';

type AccountLang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: AccountLang };
const currentLang: AccountLang = lang === 'en' ? 'en' : 'it';
const isEn = currentLang === 'en';
const copy = isEn
  ? {
      title: 'Private conversation | Retro-Gamers.it',
      description: 'Private conversation between Retro-Gamers.it readers.',
      unavailableSql:
        'Private messages are not available. Run private-messages.sql in Supabase.',
      unavailableGeneric: 'Conversation is not available. Please try again later.',
      notFound: 'Conversation not found.',
      otherUser: 'Conversation partner',
      avatarOf: (name: string) => `${name} avatar`,
      viewProfile: 'View public profile',
      actionsTitle: 'Conversation actions',
      actionsDescription: 'Manage this conversation without leaving the thread.',
      unblock: 'Unblock user',
      block: 'Block user',
      reportConversation: 'Report conversation',
      kicker: 'Private message',
      heroTitle: 'Private conversation',
      heroDescription: (name: string) =>
        `Conversation with ${name}. Messages remain visible only to participants.`,
      back: 'All conversations',
      blockedByViewer:
        'You have blocked this user. You can unblock them whenever you want.',
      viewerBlocked: 'You cannot send messages to this user.',
      you: 'You',
      wroteMine: 'wrote',
      wroteTheirs: 'wrote',
      datePrefix: 'on',
      timePrefix: 'at',
      report: 'Report',
      empty: 'No messages yet. Write the first message below.',
      reply: 'Reply',
      placeholder: 'Write a private message...',
      openEmoji: 'Open emoji picker',
      chooseEmoji: 'Choose emoji',
      insertEmoji: (emoji: string) => `Insert emoji ${emoji}`,
      send: 'Send message',
      fallbackUnavailable: 'Conversation is not available.',
      guestKicker: 'Private messages',
      guestTitle: 'Sign-in required',
      guestDescription: 'Sign in to read this conversation.',
      login: 'Log in',
      sendFailed: 'Message not sent.',
      connectionError: 'Connection error.',
      reportReason: 'Reason for the report, optional:',
      confirmBlock: 'Block this user?',
      confirmUnblock: 'Unblock this user?',
      actionFailed: 'Action failed.',
      reportFailed: 'Report not sent.',
      reported: 'Reported',
      locale: 'en-US',
    }
  : {
      title: 'Conversazione privata | Retro-Gamers.it',
      description: 'Conversazione privata tra lettori Retro-Gamers.it.',
      unavailableSql:
        'Messaggi privati non disponibili. Esegui lo SQL private-messages.sql in Supabase.',
      unavailableGeneric: 'Conversazione non disponibile. Riprova più tardi.',
      notFound: 'Conversazione non trovata.',
      otherUser: 'Interlocutore',
      avatarOf: (name: string) => `Avatar di ${name}`,
      viewProfile: 'Vedi profilo pubblico',
      actionsTitle: 'Azioni conversazione',
      actionsDescription: 'Gestisci questa conversazione senza uscire dal thread.',
      unblock: 'Sblocca utente',
      block: 'Blocca utente',
      reportConversation: 'Segnala conversazione',
      kicker: 'Messaggio privato',
      heroTitle: 'Conversazione privata',
      heroDescription: (name: string) =>
        `Conversazione con ${name}. I messaggi restano visibili solo ai partecipanti.`,
      back: 'Tutte le conversazioni',
      blockedByViewer:
        'Hai bloccato questo utente. Puoi sbloccarlo quando vuoi.',
      viewerBlocked: 'Non puoi inviare messaggi a questo utente.',
      you: 'Tu',
      wroteMine: 'hai scritto',
      wroteTheirs: 'ha scritto',
      datePrefix: 'il',
      timePrefix: 'alle',
      report: 'Segnala',
      empty: 'Nessun messaggio ancora. Scrivi il primo messaggio qui sotto.',
      reply: 'Rispondi',
      placeholder: 'Scrivi un messaggio privato...',
      openEmoji: 'Apri selettore emoji',
      chooseEmoji: 'Scegli emoji',
      insertEmoji: (emoji: string) => `Inserisci emoji ${emoji}`,
      send: 'Invia messaggio',
      fallbackUnavailable: 'Conversazione non disponibile.',
      guestKicker: 'Messaggi privati',
      guestTitle: 'Accesso richiesto',
      guestDescription: 'Accedi per leggere questa conversazione.',
      login: 'Accedi',
      sendFailed: 'Messaggio non inviato.',
      connectionError: 'Errore di connessione.',
      reportReason: 'Motivo della segnalazione, opzionale:',
      confirmBlock: 'Bloccare questo utente?',
      confirmUnblock: 'Sbloccare questo utente?',
      actionFailed: 'Azione non riuscita.',
      reportFailed: 'Segnalazione non inviata.',
      reported: 'Segnalato',
      locale: 'it-IT',
    };

const conversationId = String(Astro.params.conversationId || '');
const session = await getUserSessionFromCookies(Astro.cookies);
const isLoggedIn = Boolean(!session.error && session.user && session.profile);
const title = copy.title;
const description = copy.description;

let thread = null;
let threadError = '';

if (isLoggedIn && session.user) {
  const [result] = await Promise.all([
    getPrivateConversationThread(conversationId, session.user.id),
    touchUserActivity(session.user.id, 'account-private-thread-load'),
  ]);
  thread = result.thread;

  if (result.error) {
    threadError = isPrivateMessagesUnavailable(result.error)
      ? copy.unavailableSql
      : copy.unavailableGeneric;
  } else if (!thread) {
    threadError = copy.notFound;
  } else {
    const markReadResult = await markPrivateConversationRead(session.user.id, conversationId);

    if (!markReadResult.ok) {
      console.error('Private conversation auto mark-read failed:', markReadResult.error);
    }
  }
}

const otherProfile = thread?.otherProfile;
const otherName = getPrivateProfileLabel(otherProfile);
const otherProfileUrl = getPrivateProfileUrl(otherProfile, currentLang);
const canReply = Boolean(thread && !thread.isBlockedByViewer && !thread.isViewerBlocked);
const dateFormatter = new Intl.DateTimeFormat(copy.locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const timeFormatter = new Intl.DateTimeFormat(copy.locale, {
  hour: '2-digit',
  minute: '2-digit',
});
const emojiOptions = ['😀', '😄', '😂', '😊', '😉', '😍', '😎', '🤔', '😅', '😢', '❤️', '👍', '👎', '🙌', '👏', '🔥', '🎮', '🕹️', '💾', '🐸'];
const privateMessagesHref = isEn ? '/en/account/messages/private/' : '/account/messages/private/';
const loginHref = isEn ? '/en/account/login/' : '/account/login/';
const clientCopy = {
  sendFailed: copy.sendFailed,
  connectionError: copy.connectionError,
  reportReason: copy.reportReason,
  confirmBlock: copy.confirmBlock,
  confirmUnblock: copy.confirmUnblock,
  actionFailed: copy.actionFailed,
  reportFailed: copy.reportFailed,
  reported: copy.reported,
};
---

<BaseLayout
  title={title}
  description={description}
  lang={currentLang}
  languageSwitch={{ url: isEn ? `/account/messages/private/${conversationId}/` : `/en/account/messages/private/${conversationId}/` }}
>
  <CommunityLayout as="div" class="account-messages-page private-thread-page" sidebar={Boolean(isLoggedIn && thread)}>
    <Fragment slot="sidebar">
      {isLoggedIn && thread && (
        <>
          <section class="community-sidebar-card private-thread-profile">
            <UserAvatar
              name={otherName}
              src={otherProfile?.avatar_url}
              size="md"
              label={copy.avatarOf(otherName)}
              class="private-thread-profile__avatar"
            />

            <div>
              <span>{copy.otherUser}</span>
              <strong>{otherName}</strong>
              {otherProfile?.username && <small>@{otherProfile.username}</small>}
              <a class="private-thread-profile__link" href={otherProfileUrl}>{copy.viewProfile}</a>
            </div>
          </section>

          <div
            class="community-sidebar-card private-thread-actions"
            data-private-thread-actions
            data-conversation-id={conversationId}
          >
            <div class="private-thread-actions__header">
              <h2>{copy.actionsTitle}</h2>
              <p>{copy.actionsDescription}</p>
            </div>

            {thread.isBlockedByViewer ? (
              <button type="button" data-private-unblock>{copy.unblock}</button>
            ) : (
              <button type="button" data-private-block>{copy.block}</button>
            )}
            <button type="button" data-private-report-conversation>{copy.reportConversation}</button>
          </div>
        </>
      )}
    </Fragment>

    {isLoggedIn ? (
      <>
        {thread ? (
          <>
            <CommunityHero
              kicker={copy.kicker}
              title={copy.heroTitle}
              description={copy.heroDescription(otherName)}
            />

            <a class="account-back-link" href={privateMessagesHref}>← {copy.back}</a>

            <section class="community-card private-thread-main">
              {thread.isBlockedByViewer && (
                <p class="account-message" data-type="ok">{copy.blockedByViewer}</p>
              )}

              {thread.isViewerBlocked && (
                <p class="account-message" data-type="error">{copy.viewerBlocked}</p>
              )}

              <div class="private-thread" data-private-thread>
                {thread.messages.length > 0 ? (
                  thread.messages.map((message) => {
                    const isMine = message.sender_id === session.user?.id;

                    return (
                      <article
                        class:list={['private-message', isMine ? 'is-mine' : 'is-theirs']}
                        data-message-id={message.id}
                      >
                        <div class="private-message__bubble">
                          <p>{message.body}</p>
                          <footer class="private-message__meta">
                            <span class="private-message__meta-text">
                              <strong>{isMine ? copy.you : otherName}</strong>{' '}
                              {isMine ? copy.wroteMine : copy.wroteTheirs}{' '}
                              <time datetime={message.created_at}>
                                {copy.datePrefix} {dateFormatter.format(new Date(message.created_at))} {copy.timePrefix} {timeFormatter.format(new Date(message.created_at))}
                              </time>
                            </span>

                            {!isMine && (
                              <button type="button" data-private-report-message>
                                {copy.report}
                              </button>
                            )}
                          </footer>
                        </div>
                      </article>
                    );
                  })
                ) : (
                  <p class="account-messages-empty">
                    {copy.empty}
                  </p>
                )}
              </div>

              <form
                class="private-reply-form"
                data-private-reply-form
                data-conversation-id={conversationId}
                hidden={!canReply}
              >
                <label>
                  <span>{copy.reply}</span>
                  <textarea
                    name="body"
                    data-private-reply-body
                    rows="5"
                    maxlength="2000"
                    required
                    placeholder={copy.placeholder}
                  ></textarea>
                </label>

                <p class="account-message" data-private-message-feedback hidden></p>

                <div class="private-reply-form__toolbar">
                  <div class="private-emoji-control" data-private-emoji>
                    <button
                      type="button"
                      class="private-emoji-toggle"
                      aria-label={copy.openEmoji}
                      aria-expanded="false"
                      data-private-emoji-toggle
                    >
                      <span aria-hidden="true">😊</span>
                      Emoji
                    </button>

                    <div class="private-emoji-picker" aria-label={copy.chooseEmoji} data-private-emoji-picker hidden>
                      {emojiOptions.map((emoji) => (
                        <button type="button" data-private-emoji-value={emoji} aria-label={copy.insertEmoji(emoji)}>
                          {emoji}
                        </button>
                      ))}
                    </div>
                  </div>

                  <div class="account-actions">
                    <button type="submit">{copy.send}</button>
                  </div>
                </div>
              </form>
            </section>
          </>
        ) : (
          <section class="community-card">
            <p class="account-message" data-type="error">{threadError || copy.fallbackUnavailable}</p>
          </section>
        )}
      </>
    ) : (
      <>
        <CommunityHero
          kicker={copy.guestKicker}
          title={copy.guestTitle}
          description={copy.guestDescription}
        />

        <section class="community-card">
          <div class="account-actions account-actions--standalone">
            <a href={`${loginHref}?returnTo=${encodeURIComponent(Astro.url.pathname)}`}>{copy.login}</a>
          </div>
        </section>
      </>
    )}
  </CommunityLayout>

  <script define:vars={{ clientCopy }}>
    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const form = document.querySelector('[data-private-reply-form]');
    const feedback = document.querySelector('[data-private-message-feedback]');
    const threadActions = document.querySelector('[data-private-thread-actions]');
    const replyTextarea = document.querySelector('[data-private-reply-body]');
    const emojiRoot = document.querySelector('[data-private-emoji]');
    const emojiToggle = document.querySelector('[data-private-emoji-toggle]');
    const emojiPicker = document.querySelector('[data-private-emoji-picker]');

    const showFeedback = (text, type = 'ok') => {
      if (!feedback) return;
      feedback.textContent = text;
      feedback.dataset.type = type;
      feedback.hidden = !text;
    };

    const setEmojiPickerOpen = (isOpen) => {
      if (!emojiToggle || !emojiPicker) return;
      emojiToggle.setAttribute('aria-expanded', String(isOpen));
      emojiPicker.hidden = !isOpen;
    };

    const insertEmoji = (emoji) => {
      if (!replyTextarea) return;

      replyTextarea.focus();

      if (typeof replyTextarea.setRangeText === 'function') {
        const start = replyTextarea.selectionStart ?? replyTextarea.value.length;
        const end = replyTextarea.selectionEnd ?? replyTextarea.value.length;
        replyTextarea.setRangeText(emoji, start, end, 'end');
      } else {
        replyTextarea.value = `${replyTextarea.value}${emoji}`;
      }

      replyTextarea.dispatchEvent(new Event('input', { bubbles: true }));
    };

    emojiToggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      setEmojiPickerOpen(emojiPicker?.hidden ?? true);
    });

    emojiPicker?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-private-emoji-value]');
      if (!button) return;

      insertEmoji(button.dataset.privateEmojiValue || '');
      setEmojiPickerOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!emojiRoot || emojiRoot.contains(event.target)) return;
      setEmojiPickerOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setEmojiPickerOpen(false);
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector('button[type="submit"]');
      const formData = new FormData(form);
      button.disabled = true;
      showFeedback('');

      try {
        const response = await fetch('/api/account/private-messages/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            conversationId: form.dataset.conversationId,
            body: String(formData.get('body') || ''),
          }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showFeedback(result.error || clientCopy.sendFailed, 'error');
          button.disabled = false;
          return;
        }

        window.location.reload();
      } catch {
        showFeedback(clientCopy.connectionError, 'error');
        button.disabled = false;
      }
    });

    threadActions?.addEventListener('click', async (event) => {
      const blockButton = event.target.closest('[data-private-block]');
      const unblockButton = event.target.closest('[data-private-unblock]');
      const reportButton = event.target.closest('[data-private-report-conversation]');

      if (!blockButton && !unblockButton && !reportButton) return;

      const conversationId = threadActions.dataset.conversationId;
      const endpoint = blockButton
        ? '/api/account/private-messages/block'
        : unblockButton
          ? '/api/account/private-messages/unblock'
          : '/api/account/private-messages/report';
      const reason = reportButton
        ? window.prompt(clientCopy.reportReason) || ''
        : '';

      if ((blockButton || unblockButton) && !window.confirm(blockButton ? clientCopy.confirmBlock : clientCopy.confirmUnblock)) {
        return;
      }

      const button = blockButton || unblockButton || reportButton;
      button.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversationId, reason }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          window.alert(result.error || clientCopy.actionFailed);
          button.disabled = false;
          return;
        }

        window.location.reload();
      } catch {
        window.alert(clientCopy.connectionError);
        button.disabled = false;
      }
    });

    document.querySelector('[data-private-thread]')?.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-private-report-message]');
      if (!button) return;

      const message = button.closest('[data-message-id]');
      const messageId = message?.dataset.messageId;
      const conversationId = form?.dataset.conversationId || threadActions?.dataset.conversationId;
      const reason = window.prompt(clientCopy.reportReason) || '';

      button.disabled = true;

      try {
        const response = await fetch('/api/account/private-messages/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversationId, messageId, reason }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          window.alert(result.error || clientCopy.reportFailed);
          button.disabled = false;
          return;
        }

        button.textContent = clientCopy.reported;
      } catch {
        window.alert(clientCopy.connectionError);
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
