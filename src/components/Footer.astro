---
import '../styles/components/footer.css';
import SupportButton from './common/SupportButton.astro';

const { lang = 'it' } = Astro.props;
const currentYear = new Date().getFullYear();
const copyrightYears = currentYear > 2020 ? `2020–${currentYear}` : '2020';
const isEnglish = lang === 'en';

const ui = isEnglish
  ? {
      homeUrl: '/en/',
      logoLabel: 'Retro Gamers home',
      editorialDescription: 'Retro-Gamers.it tells the stories of the games, platforms and people that shaped video game history, through reviews, features, interviews and gaming culture.',
      supportLead: 'Retro-Gamers.it is an independent project.',
      supportText: 'If you enjoy what we do, you can help us grow.',
      socialsLabel: 'Retro-Gamers social links',
      facebookLabel: 'Retro-Gamers on Facebook',
      instagramLabel: 'Retro-Gamers on Instagram',
      whatsappLabel: 'Retro-Gamers.it WhatsApp channel',
      xLabel: 'Retro-Gamers on X',
      mailLabel: 'Write to Retro-Gamers',
      retroGamers: 'Retro-Gamers',
      legal: 'Legal',
      cookiePreferences: 'Cookie preferences',
      rights: 'Original content protected by copyright.',
      links: {
        about: { label: 'About', href: '/en/about/' },
        collaborations: { label: 'Collaborations', href: '/en/collaborations/' },
        howWeWork: { label: 'How we work', href: '/en/how-we-work/' },
        contact: { label: 'Contact', href: '/en/contact/' },
        copyright: { label: 'Copyright', href: '/en/copyright/' },
        privacy: { label: 'Privacy Policy', href: '/en/privacy-policy/' },
        cookies: { label: 'Cookie Policy', href: '/en/cookie-policy/' }
      }
    }
  : {
      homeUrl: '/',
      logoLabel: 'Retro Gamers home',
      editorialDescription: 'Retro-Gamers.it racconta giochi, piattaforme e persone che hanno fatto la storia del videogioco, tra recensioni, speciali, interviste e cultura videoludica.',
      supportLead: 'Retro-Gamers.it è un progetto indipendente.',
      supportText: 'Se ti piace quello che facciamo, puoi aiutarci a farlo crescere.',
      socialsLabel: 'Social Retro-Gamers',
      facebookLabel: 'Retro-Gamers su Facebook',
      instagramLabel: 'Retro-Gamers su Instagram',
      whatsappLabel: 'Canale WhatsApp di Retro-Gamers.it',
      xLabel: 'Retro-Gamers su X',
      mailLabel: 'Scrivi a Retro-Gamers',
      retroGamers: 'Retro-Gamers',
      legal: 'Note legali',
      cookiePreferences: 'Preferenze cookie',
      rights: 'Contenuti originali protetti dal diritto d’autore.',
      links: {
        about: { label: 'Chi siamo', href: '/chi-siamo/' },
        collaborations: { label: 'Collaborazioni', href: '/collaborazioni/' },
        howWeWork: { label: 'Come lavoriamo', href: '/come-lavoriamo/' },
        contact: { label: 'Contatti', href: '/contatti/' },
        copyright: { label: 'Copyright', href: '/copyright/' },
        privacy: { label: 'Privacy Policy', href: '/privacy-policy/' },
        cookies: { label: 'Cookie Policy', href: '/cookie-policy/' }
      }
    };
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__inner">
      <section class="site-footer__brand" aria-label="Retro-Gamers.it">
        <a href={ui.homeUrl} class="site-footer__logo" aria-label={ui.logoLabel}>
          <img src="/images/brand/retro-gamers-logo-ivory.svg" alt="Retro-Gamers.it" width="223" height="57" />
        </a>
        <p class="site-footer__description">{ui.editorialDescription}</p>
        <div class="site-footer__socials" aria-label={ui.socialsLabel}>
          <a href="https://www.facebook.com/profile.php?id=100063648424822" aria-label={ui.facebookLabel} target="_blank" rel="noopener noreferrer"><span class="site-footer__social-icon site-footer__social-icon--facebook" aria-hidden="true"></span></a>
          <a href="https://www.instagram.com/retro_gamers.it/" aria-label={ui.instagramLabel} target="_blank" rel="noopener noreferrer"><span class="site-footer__social-icon site-footer__social-icon--instagram" aria-hidden="true"></span></a>
          <a href="https://whatsapp.com/channel/0029VbDPq3A7j6g5WNSANq0S" aria-label={ui.whatsappLabel} target="_blank" rel="noopener noreferrer"><span class="site-footer__social-icon site-footer__social-icon--whatsapp" aria-hidden="true"></span></a>
          <a href="https://x.com/RetroGamers13" aria-label={ui.xLabel} target="_blank" rel="noopener noreferrer"><span class="site-footer__social-icon site-footer__social-icon--x" aria-hidden="true"></span></a>
          <a href="mailto:info@retro-gamers.it" aria-label={ui.mailLabel}><span class="site-footer__social-icon site-footer__social-icon--mail" aria-hidden="true"></span></a>
        </div>
      </section>
      <section class="site-footer__support" aria-label={ui.supportLead}>
        <p>{ui.supportLead}</p>
        <p>{ui.supportText}</p>
        <SupportButton lang={lang} variant="footer" />
      </section>
      <div class="site-footer__navigation">
        <nav class="site-footer__nav" aria-label={ui.retroGamers}>
          <h2>{ui.retroGamers}</h2>
          <a href={ui.links.about.href}>{ui.links.about.label}</a>
          <a href={ui.links.collaborations.href}>{ui.links.collaborations.label}</a>
          <a href={ui.links.howWeWork.href}>{ui.links.howWeWork.label}</a>
          <a href={ui.links.contact.href}>{ui.links.contact.label}</a>
        </nav>
        <nav class="site-footer__legal" aria-label={ui.legal}>
          <h2>{ui.legal}</h2>
          <a href={ui.links.copyright.href}>{ui.links.copyright.label}</a>
          <a href={ui.links.privacy.href}>{ui.links.privacy.label}</a>
          <a href={ui.links.cookies.href}>{ui.links.cookies.label}</a>
          <button type="button" class="site-footer__cookie-button" data-open-cookie-preferences>{ui.cookiePreferences}</button>
        </nav>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>© {copyrightYears} Retro-Gamers.it · {ui.rights}</p>
      <p class="site-footer__credit">
        Website by
        <a href="https://www.gcpstudio.it" target="_blank" rel="noopener noreferrer" aria-label="Website by GCP Studio">
          <img src="/images/logo-gcp-white.webp" alt="GCP Studio" width="18" height="28" loading="lazy" />
        </a>
      </p>
    </div>
  </div>
</footer>
