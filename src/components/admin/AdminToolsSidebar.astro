---
import { getEditorialSessionForUserSession } from '../../lib/editorial/session.server';
import { getUserSessionFromCookies, isStaffProfile } from '../../lib/supabase/auth';

type Lang = 'it' | 'en';

interface Props {
  lang?: Lang;
  surveyKey?: string | null;
}

const { lang: propLang, surveyKey } = Astro.props;
const pathname = Astro.url.pathname;
const isEnglish = propLang === 'en' || (!propLang && pathname.startsWith('/en/'));
const lang: Lang = isEnglish ? 'en' : 'it';
const adminBase = lang === 'en' ? '/en/admin' : '/admin';
const editorialBase = lang === 'en' ? '/en/account/editor/articles/' : '/account/editor/articles/';
const cleanSurveyKey = String(surveyKey || '').trim();
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = isStaffProfile(session.profile);
const editorialContext = isStaff
  ? await getEditorialSessionForUserSession(session)
  : null;
const canSeeEditorialTools = Boolean(editorialContext?.isEditorialActive);

const copy = lang === 'en'
  ? {
      kicker: 'Navigation',
      title: 'Administration tools',
      description: 'Secondary access to the existing administration areas.',
      groups: {
        community: 'Community',
        participation: 'Participation',
        communication: 'Communication',
        editorial: 'Editorial',
      },
      links: {
        comments: 'Comment moderation',
        commentReports: 'Comment reports',
        privateReports: 'Message reports',
        users: 'User management',
        ratings: 'Reader ratings',
        surveys: 'Survey results',
        newsletter: 'Newsletter',
        editorialArticles: 'Editorial articles',
      },
    }
  : {
      kicker: 'Navigazione',
      title: 'Strumenti amministrazione',
      description: 'Accesso secondario alle aree amministrative esistenti.',
      groups: {
        community: 'Community',
        participation: 'Partecipazione',
        communication: 'Comunicazione',
        editorial: 'Editoriale',
      },
      links: {
        comments: 'Moderazione commenti',
        commentReports: 'Segnalazioni commenti',
        privateReports: 'Segnalazioni messaggi',
        users: 'Gestione utenti',
        ratings: 'Voti lettori',
        surveys: 'Risultati survey',
        newsletter: 'Newsletter',
        editorialArticles: 'Articoli redazionali',
      },
    };

const normalizePath = (value: string) => {
  const normalized = `/${String(value || '').replace(/^\/+/, '')}`.replace(/\/+$/, '');

  return normalized === '' ? '/' : normalized;
};

const currentPath = normalizePath(pathname);

const isActiveLink = (href: string) => {
  const normalizedHref = normalizePath(href);

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};

const toolSections = [
  {
    title: copy.groups.community,
    links: [
      { href: `${adminBase}/comments/`, label: copy.links.comments },
      { href: `${adminBase}/comment-reports/`, label: copy.links.commentReports },
      { href: `${adminBase}/private-message-reports/`, label: copy.links.privateReports },
      { href: `${adminBase}/users/`, label: copy.links.users },
    ],
  },
  {
    title: copy.groups.participation,
    links: [
      { href: `${adminBase}/ratings/`, label: copy.links.ratings },
      ...(cleanSurveyKey
        ? [{ href: `/admin/surveys/${encodeURIComponent(cleanSurveyKey)}/`, label: copy.links.surveys }]
        : []),
    ],
  },
  {
    title: copy.groups.communication,
    links: [
      { href: `${adminBase}/newsletter/`, label: copy.links.newsletter },
    ],
  },
  ...(canSeeEditorialTools
    ? [
        {
          title: copy.groups.editorial,
          links: [
            { href: editorialBase, label: copy.links.editorialArticles },
          ],
        },
      ]
    : []),
].filter((section) => section.links.length > 0);
---

{isStaff && (
  <section class="community-sidebar-card admin-tools-sidebar" aria-labelledby="admin-tools-sidebar-title">
    <div class="admin-tools-sidebar__heading">
      <p class="community-kicker">{copy.kicker}</p>
      <h2 id="admin-tools-sidebar-title">{copy.title}</h2>
      <span>{copy.description}</span>
    </div>

    <div class="admin-tools-sidebar__groups">
      {toolSections.map((section) => (
        <article class="admin-tools-sidebar__group">
          <h3>{section.title}</h3>
          <div>
            {section.links.map((link) => {
              const isActive = isActiveLink(link.href);

              return (
                <a href={link.href} aria-current={isActive ? 'page' : undefined} data-active={isActive ? 'true' : 'false'}>
                  {link.label}
                </a>
              );
            })}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .admin-tools-sidebar {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .admin-tools-sidebar__heading {
    display: grid;
    gap: 6px;
  }

  .admin-tools-sidebar__heading h2 {
    margin: 0;
    color: var(--rg-section-title-color);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.12;
  }

  .admin-tools-sidebar__heading span {
    margin: 0;
    color: var(--color-text-soft);
    line-height: 1.55;
  }

  .admin-tools-sidebar__group {
    display: grid;
    gap: 9px;
    border-top: 1px solid var(--rg-card-border);
    padding-top: 12px;
  }

  .admin-tools-sidebar__group:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .admin-tools-sidebar__group h3 {
    margin: 0;
    color: var(--rg-eyebrow-color);
    font-size: var(--text-xs);
    font-weight: 950;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .admin-tools-sidebar__group div {
    display: grid;
    gap: 7px;
  }

  .admin-tools-sidebar__group a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    min-height: 34px;
    border: 1px solid var(--rg-cta-border);
    border-radius: 999px;
    padding: 0 12px;
    background: color-mix(in srgb, var(--rg-card-bg) 78%, transparent);
    color: var(--rg-cta-color);
    font-size: 0.85rem;
    font-weight: 900;
    line-height: 1.2;
    text-align: left;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .admin-tools-sidebar__group a:hover,
  .admin-tools-sidebar__group a:focus-visible,
  .admin-tools-sidebar__group a[data-active="true"] {
    border-color: var(--rg-cta-border);
    background: var(--rg-cta-hover-bg);
    color: var(--color-primary);
    outline: none;
  }

  .admin-tools-sidebar__group a[data-active="true"] {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }
</style>
