        reports: 'Reports',
      },
      tools: {
        community: 'Community',
        participation: 'Participation',
        communication: 'Communication',
        editorial: 'Editorial',
        comments: 'Comment moderation',
        commentReports: 'Comment reports',
        privateReports: 'Message reports',
        users: 'User management',
        ratings: 'Reader ratings',
        surveys: 'Survey results',
        newsletter: 'Newsletter',
        editorialArticles: 'Editorial articles',
      },
    }
  : {
      title: 'Dashboard amministrazione | Retro-Gamers.it',
      description: 'Cockpit quotidiano per moderazione, segnalazioni, salute community e strumenti amministrativi.',
      compactKicker: 'Retro-Gamers.it',
      greeting: (name: string) => `Buongiorno ${name}`,
      greetingFallback: 'Buongiorno',
      headerDescription: 'Panoramica rapida di ciò che richiede la tua attenzione.',
      todoKicker: 'Cockpit quotidiano',
      todoTitle: 'Da fare',
      todoDescription: 'Elementi operativi che possono richiedere un intervento dello staff.',
      newsKicker: 'Inbox amministrativa',
      newsTitle: 'Novità',
      newsDescription: 'Eventi del sito che non hai ancora consultato.',
      newsMarkAllRead: 'Segna tutte come lette',
      newsMarkCategoryRead: 'Segna lette',
      newsEmpty: 'Nessuna novità da consultare.',
      recentKicker: 'Ultimi segnali',
      recentTitle: 'Attività recenti',
      recentDescription: 'Un feed compatto dai sistemi che espongono già timestamp affidabili.',
      overviewKicker: 'Stato community',
      overviewTitle: 'Panoramica',
      overviewDescription: 'Metriche informative: contesto utile, non attività urgente.',
      toolsKicker: 'Navigazione',
      toolsTitle: 'Strumenti amministrazione',
      toolsDescription: 'Accesso secondario alle aree amministrative esistenti.',
      optionalDataError: 'Dato non disponibile',
      countError: 'Conteggio non disponibile',
      noActionItems: 'Niente di urgente al momento.',
      noRecentActivity: 'Nessuna attività recente da mostrare.',
      noRecentActivityForCategory: 'Nessuna attività recente in questa categoria.',
      open: 'Apri',
      unavailable: 'Non disponibile',
      defaultArticle: 'Articolo Retro-Gamers.it',
      readerFallback: 'Lettore',
      guestFallback: 'Ospite',
      accessTitle: 'Accesso amministrativo',
      accessDescription: 'Questa pagina è riservata allo staff Retro-Gamers.it.',
      login: 'Accedi',
      todo: {
        pendingComments: {
          title: 'Commenti da moderare',
          description: 'Commenti pubblici in attesa di revisione.',
          cta: 'Modera',
        },
        commentReports: {
          title: 'Segnalazioni commenti aperte',
          description: 'Segnalazioni dei lettori sui commenti pubblici.',
          cta: 'Controlla',
        },
        privateReports: {
          title: 'Segnalazioni messaggi aperte',
          description: 'Segnalazioni dalle conversazioni private.',
          cta: 'Controlla',
        },
        editorialQueue: {
          title: 'Articoli da revisionare',
          description: 'Documenti submitted o approved in attesa di azione editoriale.',
          cta: 'Apri coda revisione',
        },
      },
      news: {
        users: {
          title: 'Nuovi utenti',
          description: 'Account registrati che non hai ancora consultato.',
          cta: 'Apri utenti',
        },
        comments: {
          title: 'Nuovi commenti pubblici',
          description: 'Commenti pubblici arrivati dopo il tuo ultimo controllo.',
          cta: 'Apri commenti',
        },
        surveys: {
          title: 'Nuove risposte survey',
          description: 'Partecipazioni anonime ai sondaggi community.',
          cta: 'Apri survey',
        },
        newsletter: {
          title: 'Nuovi iscritti newsletter',
          description: 'Iscrizioni attive alla newsletter non ancora consultate.',
          cta: 'Apri newsletter',
        },
      },
      overview: {
        users: 'Utenti',
        ratings: 'Voti lettori',
        newsletter: 'Newsletter',
        activeSurveys: 'Survey attive',
        surveyResponses: 'Risposte survey',
        quizzes: 'Quiz pubblicati',
      },
      activity: {
        comment: 'Commento',
        commentReport: 'Segnalazione commento',
        privateReport: 'Segnalazione messaggio',
        newsletter: 'Newsletter',
        surveyResponse: 'Survey',
        editorial: 'Redazione',
        reportOpen: 'Segnalazione aperta',
        subscriber: 'Nuova iscrizione',
        surveyAnswer: 'Risposta anonima al sondaggio',
        articleSubmitted: 'Articolo inviato',
        articleApproved: 'Articolo approvato',
      },
      activityTabs: {
        comments: 'Commenti',
        editorial: 'Redazione',
        newsletter: 'Newsletter',
        surveys: 'Survey',
        reports: 'Segnalazioni',
      },
      tools: {
        community: 'Community',
        participation: 'Partecipazione',
        communication: 'Comunicazione',
        editorial: 'Editoriale',
        comments: 'Moderazione commenti',
        commentReports: 'Segnalazioni commenti',
        privateReports: 'Segnalazioni messaggi',
        users: 'Gestione utenti',
        ratings: 'Voti lettori',
        surveys: 'Risultati survey',
        newsletter: 'Newsletter',
        editorialArticles: 'Articoli redazionali',
      },
    };

const title = copy.title;
const description = copy.description;
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = isStaffProfile(session.profile);
const isAdmin = session.profile?.role === 'admin' && session.profile?.status === 'active';
const editorialContext = isStaff
  ? await getEditorialSessionForUserSession(session)
  : null;
const canSeeEditorialQueue = Boolean(
  editorialContext?.isEditorialActive &&
    editorialContext.permissions.canReadSubmittedArticles
);
const displayName =
  String(session.profile?.display_name || session.profile?.username || '').trim();

const numberFormatter = new Intl.NumberFormat(isEnglish ? 'en-US' : 'it-IT');
const dateFormatter = new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'it-IT', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
});

const isOptionalDataError = (error: unknown) => {
  const apiError = error as { code?: string; message?: string; details?: string; hint?: string } | null;
  const message = `${apiError?.message || ''} ${apiError?.details || ''} ${apiError?.hint || ''}`.toLowerCase();

  return (
    apiError?.code === '42P01' ||
    apiError?.code === '42703' ||
    apiError?.code === 'PGRST204' ||
    apiError?.code === 'PGRST205' ||
    message.includes('does not exist') ||
    message.includes('schema cache')
  );
};

const safeCount = async (callback: () => PromiseLike<{ count: number | null; error: unknown }>): Promise<CountResult> => {
  try {
    const { count, error } = await callback();

    if (error) {
      return {
        value: null,
        error: isOptionalDataError(error) ? copy.optionalDataError : copy.countError,
      };
    }

    return { value: count ?? 0, error: '' };
  } catch {
    return { value: null, error: copy.countError };
  }
};

const safeSanityCount = async (callback: () => PromiseLike<number | null | undefined>): Promise<CountResult> => {
  try {
    const count = await callback();

    return { value: count ?? 0, error: '' };
  } catch {
    return { value: null, error: copy.countError };
  }
};

const formatCount = (count: CountResult) =>
  count.value === null ? '—' : numberFormatter.format(count.value);

const getActivityTime = (activity: RecentActivity) => {
  if (!activity.createdAt) return 0;

  const time = new Date(activity.createdAt).getTime();

  return Number.isFinite(time) ? time : 0;
};

const formatActivityDate = (value: string | null) =>
  value ? dateFormatter.format(new Date(value)) : copy.unavailable;

const truncate = (value = '', maxLength = 120) => {
  const normalized = value.replace(/\s+/g, ' ').trim();

  return normalized.length > maxLength
    ? `${normalized.slice(0, maxLength - 1).trim()}…`
    : normalized;
};

const getCommentAuthor = (comment: RecentComment) =>
  comment.author_type === 'guest'
    ? comment.guest_display_name || copy.guestFallback
    : comment.profiles?.display_name || comment.profiles?.username || copy.readerFallback;

let pendingComments: CountResult = { value: null, error: '' };
let openCommentReports: CountResult = { value: null, error: '' };
let openPrivateReports: CountResult = { value: null, error: '' };
let registeredUsers: CountResult = { value: null, error: '' };
let readerRatings: CountResult = { value: null, error: '' };
let activeNewsletterSubscribers: CountResult = { value: null, error: '' };
let surveyResponses: CountResult = { value: null, error: '' };
let editorialReviewQueue: CountResult = { value: null, error: '' };
let activeSurveys: CountResult = { value: null, error: '' };
let publishedQuizzes: CountResult = { value: null, error: '' };
let activeSurveyDocuments: SurveySummary[] = [];
let adminActivitySummary: AdminActivitySummary | null = null;
const recentActivitiesByCategory: Record<ActivityCategoryKey, RecentActivity[]> = {
  comments: [],
  editorial: [],
  newsletter: [],
  surveys: [],
  reports: [],
};

if (isStaff) {
  if (isAdmin && session.user) {
    adminActivitySummary = await getAdminActivitySummary({
      adminUserId: session.user.id,
      lang,
    });
  }

  [
    pendingComments,
    openCommentReports,
    openPrivateReports,
    registeredUsers,
    readerRatings,
    activeNewsletterSubscribers,
    surveyResponses,
    editorialReviewQueue,
    activeSurveys,
    publishedQuizzes,
  ] = await Promise.all([
    safeCount(() =>
      supabaseAdmin
        .from('comments')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'pending')
        .is('deleted_at', null)
    ),
    safeCount(() =>
      supabaseAdmin
        .from('comment_reports')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'open')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('private_message_reports')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'open')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('profiles')
        .select('id', { count: 'exact', head: true })
    ),
    safeCount(() =>
      supabaseAdmin
        .from('review_ratings')
        .select('id', { count: 'exact', head: true })
    ),
    safeCount(() =>
      supabaseAdmin
        .from('newsletter_subscribers')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'active')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('community_survey_responses')
        .select('id', { count: 'exact', head: true })
    ),
    canSeeEditorialQueue
      ? safeCount(() =>
          supabaseAdmin
            .from('editorial_documents')
            .select('sanity_document_id', { count: 'exact', head: true })
            .in('workflow_status', ['submitted', 'approved'])
        )
      : Promise.resolve({ value: null, error: '' }),
    safeSanityCount(async () => {
      const data = await getPublishedReadClient().fetch<SurveySummary[]>(
        `
          *[
            _type == "communitySurvey" &&
            status == "open" &&
            defined(slug.current) &&
            !(_id in path("drafts.**"))
          ]{
            _id,
            title,
            language,
            surveyKey,
            "slug": slug.current
          }
        `
      );
      const uniqueKeys = new Set(
        (data || [])
          .map((survey) => String(survey.surveyKey || '').trim())
          .filter(Boolean)
      );

      activeSurveyDocuments = data || [];

      return uniqueKeys.size;
    }),
    safeSanityCount(() =>
      getPublishedReadClient().fetch<number>(
        `
          count(*[
            _type == "quiz" &&
            defined(slug.current) &&
            !(_id in path("drafts.**")) &&
            coalesce(isPublished, false) == true
          ])
        `
      )
    ),
  ]);

  const fetchRecentComments = (includeGuestFields: boolean) =>
    supabaseAdmin
      .from('comments')
      .select(`
        id,
        article_title,
        body,
        status,
        created_at,
        ${includeGuestFields ? 'author_type, guest_display_name,' : ''}
        profiles:profile_id (
          username,
          display_name
        )
      `)
      .in('status', ['approved', 'pending'])
      .is('deleted_at', null)
      .order('created_at', { ascending: false })
      .limit(4);

  let recentCommentRows: RecentComment[] = [];
  let recentCommentResult = await fetchRecentComments(true);

  if (isMissingGuestCommentSchemaError(recentCommentResult.error)) {
    recentCommentResult = await fetchRecentComments(false);
  }

  if (!recentCommentResult.error) {
    recentCommentRows = (recentCommentResult.data || []) as RecentComment[];
  }

  recentActivitiesByCategory.comments.push(...recentCommentRows.map((comment) => ({
    label: copy.activity.comment,
    title: comment.article_title || copy.defaultArticle,
    description: `${getCommentAuthor(comment)} · ${truncate(comment.body || '')}`,
    href: `${adminBase}/comments/?status=${comment.status === 'pending' ? 'pending' : 'approved'}`,
    createdAt: comment.created_at || null,
    tone: comment.status === 'pending' ? 'attention' : 'calm',
  } satisfies RecentActivity)));

  const recentLookups = await Promise.all([
    supabaseAdmin
      .from('comment_reports')
      .select('id, status, reason, created_at')
      .eq('status', 'open')
      .order('created_at', { ascending: false })
      .limit(3),
    supabaseAdmin
      .from('private_message_reports')
      .select('id, status, reason, created_at')
      .eq('status', 'open')
      .order('created_at', { ascending: false })
      .limit(3),
    supabaseAdmin
      .from('newsletter_subscribers')
      .select('id, status, language, created_at')
      .order('created_at', { ascending: false })
      .limit(3),
    supabaseAdmin
      .from('community_survey_responses')
      .select('id, survey_key, survey_language, submitted_at')
      .order('submitted_at', { ascending: false })
      .limit(3),
    canSeeEditorialQueue
      ? supabaseAdmin
          .from('editorial_documents')
          .select('sanity_document_id, workflow_status, submitted_at, updated_at')
          .in('workflow_status', ['submitted', 'approved'])
          .order('submitted_at', { ascending: false, nullsFirst: false })
          .order('updated_at', { ascending: false })
          .limit(3)
      : Promise.resolve({ data: [], error: null }),
  ]);

  const [
    commentReportsResult,
    privateReportsResult,
    newsletterResult,
    surveyResponsesResult,
    editorialResult,
  ] = recentLookups;

  if (!commentReportsResult.error) {
    recentActivitiesByCategory.reports.push(...((commentReportsResult.data || []) as SimpleActivityRow[]).map((report) => ({
      label: copy.activity.commentReport,
      title: copy.activity.reportOpen,
      description: truncate(report.reason || copy.todo.commentReports.description),
      href: `${adminBase}/comment-reports/?status=open`,
      createdAt: report.created_at || null,
      tone: report.status === 'open' ? 'attention' : 'calm',
    } satisfies RecentActivity)));
  }

  if (!privateReportsResult.error) {
    recentActivitiesByCategory.reports.push(...((privateReportsResult.data || []) as SimpleActivityRow[]).map((report) => ({
      label: copy.activity.privateReport,
      title: copy.activity.reportOpen,
      description: truncate(report.reason || copy.todo.privateReports.description),
      href: `${adminBase}/private-message-reports/?status=open`,
      createdAt: report.created_at || null,
      tone: report.status === 'open' ? 'attention' : 'calm',
    } satisfies RecentActivity)));
  }

  if (!newsletterResult.error) {
    recentActivitiesByCategory.newsletter.push(...((newsletterResult.data || []) as SimpleActivityRow[]).map((subscriber) => ({
      label: copy.activity.newsletter,
      title: copy.activity.subscriber,
      description: [String(subscriber.status || '').trim(), String(subscriber.language || '').trim().toUpperCase()]
        .filter(Boolean)
        .join(' · '),
      href: `${adminBase}/newsletter/`,
      createdAt: subscriber.created_at || null,
      tone: 'calm',
    } satisfies RecentActivity)));
  }

  if (!surveyResponsesResult.error) {
    recentActivitiesByCategory.surveys.push(...((surveyResponsesResult.data || []) as SimpleActivityRow[]).map((response) => {
      const responseSurveyKey = String(response.survey_key || '').trim();
      const responseSubmittedAt = response.submitted_at || null;

      return {
        label: copy.activity.surveyResponse,
        title: copy.activity.surveyAnswer,
        description: [responseSurveyKey, String(response.survey_language || '').toUpperCase()]
          .filter(Boolean)
          .join(' · '),
        href: responseSurveyKey
          ? `/admin/surveys/${encodeURIComponent(responseSurveyKey)}/`
          : `${adminBase}/`,
        createdAt: responseSubmittedAt,
        tone: 'calm',
      } satisfies RecentActivity;
    }));
  }

  if (!editorialResult.error) {
    recentActivitiesByCategory.editorial.push(...((editorialResult.data || []) as SimpleActivityRow[]).map((article) => ({
      label: copy.activity.editorial,
      title: article.workflow_status === 'approved'
        ? copy.activity.articleApproved
        : copy.activity.articleSubmitted,
      description: article.sanity_document_id || copy.tools.editorialArticles,
      href: editorialBase,
      createdAt: article.submitted_at || article.updated_at || null,
      tone: 'attention',
    } satisfies RecentActivity)));
  }

  Object.values(recentActivitiesByCategory).forEach((activities) => {
    activities.sort((a, b) => getActivityTime(b) - getActivityTime(a));
    activities.splice(7);
  });
}

const toDoItems = [
  {
    title: copy.todo.pendingComments.title,
    description: copy.todo.pendingComments.description,
    value: pendingComments,
    href: `${adminBase}/comments/?status=pending`,
    cta: copy.todo.pendingComments.cta,
  },
  {
    title: copy.todo.commentReports.title,
    description: copy.todo.commentReports.description,
    value: openCommentReports,
    href: `${adminBase}/comment-reports/?status=open`,
    cta: copy.todo.commentReports.cta,
  },
  {
    title: copy.todo.privateReports.title,
    description: copy.todo.privateReports.description,
    value: openPrivateReports,
    href: `${adminBase}/private-message-reports/?status=open`,
    cta: copy.todo.privateReports.cta,
  },
  ...(canSeeEditorialQueue
    ? [
        {
          title: copy.todo.editorialQueue.title,
          description: copy.todo.editorialQueue.description,
          value: editorialReviewQueue,
          href: editorialBase,
          cta: copy.todo.editorialQueue.cta,
        },
      ]
    : []),
];

const overviewItems = [
  { label: copy.overview.users, value: registeredUsers },
  { label: copy.overview.ratings, value: readerRatings },
  { label: copy.overview.newsletter, value: activeNewsletterSubscribers },
  { label: copy.overview.activeSurveys, value: activeSurveys },
  { label: copy.overview.surveyResponses, value: surveyResponses },
  { label: copy.overview.quizzes, value: publishedQuizzes },
];

const adminNewsItems: AdminNewsItem[] = adminActivitySummary
  ? (['users', 'comments', 'surveys', 'newsletter'] as AdminActivityCategory[]).map((category) => ({
      key: category,
      title: copy.news[category].title,
      description: copy.news[category].description,
      href: adminActivitySummary.categories[category].latestHref,
      cta: copy.news[category].cta,
      unreadCount: adminActivitySummary.categories[category].unreadCount,
      latestAt: adminActivitySummary.categories[category].latestAt,
      error: adminActivitySummary.categories[category].error,
    }))
  : [];

const primarySurveyKey = activeSurveyDocuments
  .map((survey) => String(survey.surveyKey || '').trim())
  .find(Boolean);

const activityCategories: ActivityCategory[] = [
  {
    key: 'comments',
    label: copy.activityTabs.comments,
    activities: recentActivitiesByCategory.comments,
  },
  ...(canSeeEditorialQueue
    ? [
        {
          key: 'editorial' as const,
          label: copy.activityTabs.editorial,
          activities: recentActivitiesByCategory.editorial,
        },
      ]
    : []),
  {
    key: 'newsletter',
    label: copy.activityTabs.newsletter,
    activities: recentActivitiesByCategory.newsletter,
  },
  {
    key: 'surveys',
    label: copy.activityTabs.surveys,
    activities: recentActivitiesByCategory.surveys,
  },
  {
    key: 'reports',
    label: copy.activityTabs.reports,
    activities: recentActivitiesByCategory.reports,
  },
];
---

<BaseLayout title={title} description={description} lang={lang}>
  {isStaff ? (
    <CommunityLayout class="admin-dashboard-page">
      <AdminToolsSidebar slot="sidebar" lang={lang} surveyKey={primarySurveyKey} />

        <section class="community-card admin-dashboard-header" aria-labelledby="admin-dashboard-title">
          <p class="community-kicker">{copy.compactKicker}</p>
          <h1 id="admin-dashboard-title">
            {displayName ? copy.greeting(displayName) : copy.greetingFallback}
          </h1>
          <p>{copy.headerDescription}</p>
        </section>

        <section class="community-card admin-dashboard-section admin-dashboard-section--todo" aria-labelledby="admin-dashboard-todo">
          <div class="admin-dashboard-section-heading">
            <div>
              <p>{copy.todoKicker}</p>
              <h2 id="admin-dashboard-todo">{copy.todoTitle}</h2>
              <span>{copy.todoDescription}</span>
            </div>
          </div>

          <div class="admin-dashboard-todo-grid">
            {toDoItems.map((item) => {
              const hasAttention = (item.value.value ?? 0) > 0;

              return (
                <article class="admin-dashboard-todo-card" data-attention={hasAttention ? 'true' : 'false'}>
                  <div>
                    <span>{item.title}</span>
                    <strong>{formatCount(item.value)}</strong>
                    <p>{item.value.error || item.description}</p>
                  </div>
                  <a href={item.href}>{item.cta}</a>
                </article>
              );
            })}
          </div>

          {toDoItems.every((item) => (item.value.value ?? 0) === 0) && (
            <p class="admin-dashboard-empty">{copy.noActionItems}</p>
          )}
        </section>

        {isAdmin && adminActivitySummary && (
          <section class="community-card admin-dashboard-section admin-dashboard-section--news" aria-labelledby="admin-dashboard-news" data-admin-news-section>
            <div class="admin-dashboard-section-heading">
              <div>
                <p>{copy.newsKicker}</p>
                <h2 id="admin-dashboard-news">{copy.newsTitle}</h2>
                <span>{adminActivitySummary.error || copy.newsDescription}</span>
              </div>

              {adminActivitySummary.totalUnread > 0 && (
                <button
                  type="button"
                  class="admin-dashboard-section-action"
                  data-admin-activity-mark-read
                  data-category="all"
                >
                  {copy.newsMarkAllRead}
                </button>
              )}
            </div>

            <div class="admin-dashboard-news-grid">
              {adminNewsItems.map((item) => (
                <article class="admin-dashboard-news-card" data-unread={item.unreadCount > 0 ? 'true' : 'false'}>
                  <div>
                    <span>{item.title}</span>
                    <strong>{numberFormatter.format(item.unreadCount)}</strong>
                    <p>{item.error || item.description}</p>
                    {item.latestAt && (
                      <time datetime={item.latestAt}>{formatActivityDate(item.latestAt)}</time>
                    )}
                  </div>

                  <footer>
                    <a
                      href={item.href}
                      data-admin-activity-open-link
                      data-category={item.key}
                      data-has-unread={item.unreadCount > 0 ? 'true' : 'false'}
                      data-auto-mark-read={item.key === 'surveys' && item.unreadCount > 0 ? 'true' : 'false'}
                    >
                      {item.cta}
                    </a>
                    {item.unreadCount > 0 && (
                      <button
                        type="button"
                        data-admin-activity-mark-read
                        data-category={item.key}
                      >
                        {copy.newsMarkCategoryRead}
                      </button>
                    )}
                  </footer>
                </article>
              ))}
            </div>

            {adminActivitySummary.available && adminActivitySummary.totalUnread === 0 && (
              <p class="admin-dashboard-empty">{copy.newsEmpty}</p>
            )}
          </section>
        )}

        <section class="community-card admin-dashboard-section admin-dashboard-section--recent" aria-labelledby="admin-dashboard-recent" data-admin-activity-section>
          <div class="admin-dashboard-section-heading">
            <div>
              <p>{copy.recentKicker}</p>
              <h2 id="admin-dashboard-recent">{copy.recentTitle}</h2>
              <span>{copy.recentDescription}</span>
            </div>
          </div>

          <div class="admin-dashboard-activity-tabs" role="tablist" aria-label={copy.recentTitle} data-admin-activity-tabs>
            {activityCategories.map((category, index) => (
              <button
                type="button"
                class="admin-dashboard-activity-tab"
                role="tab"
                id={`admin-dashboard-activity-tab-${category.key}`}
                aria-controls={`admin-dashboard-activity-panel-${category.key}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                data-admin-activity-tab={category.key}
                data-active={index === 0 ? 'true' : 'false'}
              >
                {category.label}
              </button>
            ))}
          </div>

          <div class="admin-dashboard-activity-panels">
            {activityCategories.map((category, index) => (
              <div
                class="admin-dashboard-activity-panel"
                id={`admin-dashboard-activity-panel-${category.key}`}
                role="tabpanel"
                aria-labelledby={`admin-dashboard-activity-tab-${category.key}`}
                data-admin-activity-panel={category.key}
                hidden={index !== 0}
              >
                {category.activities.length > 0 ? (
                  <div class="admin-dashboard-activity-list">
                    {category.activities.map((activity) => (
	                      <article class="admin-dashboard-activity" data-tone={activity.tone || 'calm'}>
	                        <div>
	                          <span>{activity.label}</span>
	                          <h3>
                              <span class="admin-dashboard-activity__title">{activity.title}</span>
                            </h3>
	                          <p>{activity.description}</p>
	                        </div>
                        <footer>
                          <time datetime={activity.createdAt || undefined}>
                            {formatActivityDate(activity.createdAt)}
                          </time>
                          <a href={activity.href}>{copy.open}</a>
                        </footer>
                      </article>
                    ))}
                  </div>
                ) : (
                  <p class="admin-dashboard-empty">{copy.noRecentActivityForCategory}</p>
                )}
              </div>
            ))}
          </div>
        </section>

        <section class="community-card admin-dashboard-section admin-dashboard-section--overview" aria-labelledby="admin-dashboard-overview">
          <div class="admin-dashboard-section-heading">
            <div>
              <p>{copy.overviewKicker}</p>
              <h2 id="admin-dashboard-overview">{copy.overviewTitle}</h2>
              <span>{copy.overviewDescription}</span>
            </div>
          </div>

          <div class="admin-dashboard-overview-strip">
            {overviewItems.map((item) => (
              <article class="admin-dashboard-overview-item">
                <span>{item.label}</span>
                <strong>{formatCount(item.value)}</strong>
                {item.value.error && <small>{item.value.error}</small>}
              </article>
            ))}
          </div>
        </section>
    </CommunityLayout>
  ) : (
    <CommunityLayout class="admin-dashboard-page">
        <CommunityHero
          kicker="Retro-Gamers.it"
          title={copy.accessTitle}
          description={copy.accessDescription}
        />

        <section class="community-card">
          <div class="community-staff-links">
            <a class="community-action-link" href={isEnglish ? '/en/account/login/' : '/account/login/'}>{copy.login}</a>
          </div>
        </section>
    </CommunityLayout>
  )}

  <script>
    (() => {
      const section = document.querySelector('[data-admin-news-section]');

      if (!section) return;

      const markActivityRead = async (category) => {
        const response = await fetch('/api/admin/activity/mark-read', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            category,
            lang: document.documentElement.lang === 'en' ? 'en' : 'it',
          }),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || result?.ok !== true) {
          throw new Error('admin_activity_mark_read_failed');
        }

        window.dispatchEvent(new CustomEvent('retro-gamers:refresh-admin-unread'));
      };

      section.addEventListener('click', async (event) => {
        if (!(event.target instanceof Element)) return;

        const link = event.target.closest('[data-admin-activity-open-link]');

        if (link instanceof HTMLAnchorElement) {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            link.dataset.autoMarkRead !== 'true'
          ) {
            return;
          }

          const category = link.dataset.category || '';

          if (!category) return;

          event.preventDefault();

          try {
            await markActivityRead(category);
          } catch {
            // The destination remains reachable even if the read checkpoint cannot be updated.
          }

          window.location.assign(link.href);
          return;
        }

        const button = event.target.closest('[data-admin-activity-mark-read]');

        if (!(button instanceof HTMLButtonElement)) return;

        const category = button.dataset.category || '';

        if (!category) return;

        button.disabled = true;

        try {
          await markActivityRead(category);
          window.location.reload();
        } catch {
          button.disabled = false;
        }
      });
    })();

    document.querySelectorAll('[data-admin-activity-section]').forEach((section) => {
      const tabs = Array.from(section.querySelectorAll('[data-admin-activity-tab]'));
      const panels = Array.from(section.querySelectorAll('[data-admin-activity-panel]'));

      const activateTab = (targetKey, shouldFocus = false) => {
        tabs.forEach((tab) => {
          const isActive = tab.getAttribute('data-admin-activity-tab') === targetKey;

          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('data-active', isActive ? 'true' : 'false');

          if (shouldFocus && isActive) {
            tab.focus();
          }
        });

        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-admin-activity-panel') !== targetKey;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          activateTab(tab.getAttribute('data-admin-activity-tab'));
        });

        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

          event.preventDefault();

          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = (index + direction + tabs.length) % tabs.length;
          const nextKey = tabs[nextIndex]?.getAttribute('data-admin-activity-tab');

          if (nextKey) {
            activateTab(nextKey, true);
          }
        });
      });
    });
  </script>
</BaseLayout>
