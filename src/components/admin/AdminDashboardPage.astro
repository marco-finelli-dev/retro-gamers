---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminToolsSidebar from './AdminToolsSidebar.astro';
import CommunityHero from '../../components/community/CommunityHero.astro';
import CommunityLayout from '../../components/community/CommunityLayout.astro';
import {
  getAdminActivitySummary,
  type AdminActivityCategory,
  type AdminActivitySummary,
} from '../../lib/admin/activity.server';
import { getPublishedReadClient } from '../../lib/sanity';
import { getEditorialSessionForUserSession } from '../../lib/editorial/session.server';
import { getUserSessionFromCookies, isStaffProfile } from '../../lib/supabase/auth';
import { isMissingGuestCommentSchemaError } from '../../lib/supabase/guest-comments';
import { supabaseAdmin } from '../../lib/supabase/server';
import '../../styles/pages/admin-dashboard.css';

type Lang = 'it' | 'en';

interface Props {
  lang?: Lang;
}

type CountResult = {
  value: number | null;
  error: string;
};

type RecentComment = {
  id: string;
  article_title?: string | null;
  body?: string | null;
  status?: string | null;
  created_at?: string | null;
  author_type?: string | null;
  guest_display_name?: string | null;
  profiles?: {
    username?: string | null;
    display_name?: string | null;
  } | null;
};

type SimpleActivityRow = {
  id?: string | null;
  status?: string | null;
  reason?: string | null;
  language?: string | null;
  survey_key?: string | null;
  survey_language?: string | null;
  workflow_status?: string | null;
  sanity_document_id?: string | null;
  created_at?: string | null;
  submitted_at?: string | null;
  updated_at?: string | null;
};

type SurveySummary = {
  _id?: string | null;
  title?: string | null;
  language?: string | null;
  surveyKey?: string | null;
  slug?: string | null;
};

type RecentActivity = {
  label: string;
  title: string;
  description: string;
  href: string;
  createdAt: string | null;
  tone?: 'attention' | 'calm';
};

type ActivityCategoryKey = 'comments' | 'editorial' | 'newsletter' | 'surveys' | 'reports';

type ActivityCategory = {
  key: ActivityCategoryKey;
  label: string;
  activities: RecentActivity[];
};

type AdminNewsItem = {
  key: AdminActivityCategory;
  title: string;
  description: string;
  href: string;
  cta: string;
  unreadCount: number;
  latestAt: string | null;
  error: string;
};

const { lang = 'it' } = Astro.props;
const isEnglish = lang === 'en';
const adminBase = isEnglish ? '/en/admin' : '/admin';
const editorialBase = isEnglish ? '/en/account/editor/articles/' : '/account/editor/articles/';

const copy = isEnglish
  ? {
      title: 'Administration dashboard | Retro-Gamers.it',
      description: 'Daily cockpit for moderation, reports, community health and administration tools.',
      compactKicker: 'Retro-Gamers.it',
      greeting: (name: string) => `Good morning ${name}`,
      greetingFallback: 'Good morning',
      headerDescription: 'A quick overview of what needs your attention.',
      todoKicker: 'Daily cockpit',
      todoTitle: 'To do',
      todoDescription: 'Operational items that may require staff action.',
      newsKicker: 'Administration inbox',
      newsTitle: 'New items',
      newsDescription: 'Site events you have not opened yet.',
      newsMarkAllRead: 'Mark all as read',
      newsMarkCategoryRead: 'Mark read',
      newsEmpty: 'No new items to review.',
      recentKicker: 'Latest signals',
      recentTitle: 'Recent activity',
      recentDescription: 'A compact feed from systems that already expose reliable timestamps.',
      overviewKicker: 'Community health',
      overviewTitle: 'Overview',
