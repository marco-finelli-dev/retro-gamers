          cta: 'Review reports',
        },
        editorialQueue: {
          title: 'Articles to review',
          description: 'Submitted or approved editorial documents waiting for action.',
          cta: 'Open review queue',
        },
      },
      news: {
        users: {
          title: 'New users',
          description: 'Registered accounts you have not opened yet.',
          cta: 'Open users',
        },
        comments: {
          title: 'New public comments',
          description: 'Public comments published or pending since your last check.',
          cta: 'Open comments',
        },
        surveys: {
          title: 'New survey responses',
          description: 'Anonymous community survey participations.',
          cta: 'Open survey',
