          ip_revoke: 'Revoca blocco IP',
        },
        duration: 'Durata',
        durations: {
          '24h': '24 ore',
          '7d': '7 giorni',
          '30d': '30 giorni',
          custom: 'Personalizzata',
          permanent: 'Permanente',
        },
        customExpiry: 'Scadenza personalizzata',
        internalReason: 'Motivazione interna',
        internalReasonPlaceholder: 'Obbligatoria; mai mostrata pubblicamente',
        exceptionalPermanentIp: 'Blocco IP permanente eccezionale (solo admin)',
        applyIdentityAction: 'Applica azione identità',
        identityActionUpdated: 'Moderazione identità aggiornata.',
        loadError: 'Errore caricamento commenti.',
        accessUnavailable: 'Accesso non disponibile',
        commentsFoundOne: '1 commento trovato',
        commentsFoundMany: 'commenti trovati',
        commentsFoundLabel: 'Commenti trovati:',
        pageSummary: 'Pagina {page} di {totalPages}',
        previous: 'Precedente',
        next: 'Successiva',
        connectionError: 'Errore di connessione.',
        actionFailed: 'Azione non riuscita.',
        commentUpdated: 'Commento aggiornato.',
        notePrefix: 'Moderazione da pannello admin',
      },
    };

const title = copy.title;
const description = copy.description;
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = session.profile?.role === 'admin' || session.profile?.role === 'moderator';
const isAdmin = session.profile?.role === 'admin';
const loginHref = isEnglish ? '/en/account/login/' : '/account/login/';

---

<BaseLayout title={title} description={description} lang={lang}>
  <CommunityLayout class="admin-comments-page" sidebar={isStaff}>
    <AdminToolsSidebar slot="sidebar" lang={lang} />
    {isStaff && <AdminDashboardBackLink slot="before" lang={lang} />}

    {isStaff ? (
      <>
        <CommunityHero
          kicker="Retro-Gamers.it"
          title={copy.heroTitle}
          description={copy.heroDescription}
        >
          <span slot="aside" class="community-soft-badge" data-admin-comments-count>{copy.loading}</span>
        </CommunityHero>

        <section
          class="community-card admin-comments-panel"
          data-admin-comments-panel
          data-can-hard-delete={isAdmin ? 'true' : 'false'}
        >
          <form class="admin-comments-filters" data-admin-comments-filters>
            <div class="admin-comments__filter-fields">
              <label class="admin-comments__filter-field admin-comments__filter-field--status">
                <span>{copy.status}</span>
                <select name="status">
                  <option value="all">{copy.filters.all}</option>
                  <option value="pending" selected>{copy.filters.pending}</option>
                  <option value="approved">{copy.filters.approved}</option>
                  <option value="rejected">{copy.filters.rejected}</option>
                  <option value="deleted">{copy.filters.deleted}</option>
                </select>
              </label>

              <label class="admin-comments__filter-field admin-comments__filter-field--language">
                <span>{copy.language}</span>
                <select name="lang">
                  <option value="all" selected>{copy.filters.allLanguages}</option>
                  <option value="it">{copy.filters.italian}</option>
                  <option value="en">{copy.filters.english}</option>
                </select>
              </label>

              <label class="admin-comments__filter-field admin-comments__filter-field--page-size">
                <span>{copy.pageSize}</span>
                <select name="pageSize">
                  <option value="30" selected>30</option>
                  <option value="60">60</option>
                  <option value="100">100</option>
                </select>
              </label>

              <label class="admin-comments__filter-field admin-comments__filter-field--search">
                <span>{copy.search}</span>
                <input
                  type="search"
                  name="q"
                  placeholder={copy.searchPlaceholder}
                  autocomplete="off"
                />
              </label>
            </div>

            <div class="admin-comments-filters__actions admin-comments__filter-actions">
              <button type="submit">{copy.filter}</button>
              <button type="button" data-admin-comments-reset>{copy.reset}</button>
            </div>
          </form>

          <p class="admin-comments-filter-help">
            {copy.filterHelp}
          </p>

          <div class="admin-comments-message" data-admin-comments-message hidden></div>

          <div class="admin-comments-bulk" data-admin-comments-bulk hidden>
            <label class="admin-comments-bulk__select-all">
              <input type="checkbox" data-admin-comments-select-all />
              <span>{copy.client.selectAllPage}</span>
            </label>
            <span class="admin-comments-bulk__count" data-admin-comments-selected-count>
              {copy.client.selectedMany.replace('{count}', '0')}
            </span>
            <div class="admin-comments-bulk__actions">
              <button type="button" data-bulk-action="approve" disabled>{copy.client.approveSelected}</button>
              <button type="button" data-bulk-action="reject" disabled>{copy.client.rejectSelected}</button>
            </div>
          </div>

          <div class="admin-comments-list" data-admin-comments-list>
            <p class="admin-comments-empty">{copy.loadingComments}</p>
          </div>

          <nav class="admin-comments-pagination" data-admin-comments-pagination hidden></nav>
        </section>
      </>
    ) : (
      <>
        <CommunityHero
          kicker="Retro-Gamers.it"
          title={copy.accessTitle}
          description={copy.accessDescription}
        />

        <section class="community-card">
          <div class="community-staff-links">
            <a class="community-action-link" href={loginHref}>{copy.login}</a>
          </div>
        </section>
      </>
    )}
  </CommunityLayout>

  <script define:vars={{ adminCommentsCopy: copy.client }}>
    const listNode = document.querySelector('[data-admin-comments-list]');
    const countNode = document.querySelector('[data-admin-comments-count]');
    const messageNode = document.querySelector('[data-admin-comments-message]');
    const filtersForm = document.querySelector('[data-admin-comments-filters]');
    const paginationNode = document.querySelector('[data-admin-comments-pagination]');
    const bulkNode = document.querySelector('[data-admin-comments-bulk]');
    const selectAllCheckbox = document.querySelector('[data-admin-comments-select-all]');
    const selectedCountNode = document.querySelector('[data-admin-comments-selected-count]');
    const resetButton = document.querySelector('[data-admin-comments-reset]');
    const panelNode = document.querySelector('[data-admin-comments-panel]');
    const canHardDelete = panelNode?.dataset.canHardDelete === 'true';
    const labels = adminCommentsCopy;
    const allowedPageSizes = new Set(['30', '60', '100']);
    const maxBulkSelection = 50;
    let currentPage = 1;
    let bulkInProgress = false;

    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const showMessage = (text, type = 'ok') => {
      if (!messageNode) return;

      messageNode.textContent = text;
      messageNode.dataset.type = type;
      messageNode.hidden = !text;
    };

    const formatDate = (value) => {
      if (!value) return '';

      return new Intl.DateTimeFormat(labels.locale, {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }).format(new Date(value));
    };

    const isWithinLastDay = (value) => {
      if (!value) return false;

      const timestamp = new Date(value).getTime();

      return Number.isFinite(timestamp) && Date.now() - timestamp <= 24 * 60 * 60 * 1000;
    };

    const createExcerpt = (value, maxLength = 280) => {
      const normalized = String(value || '').replace(/\s+/g, ' ').trim();

      if (normalized.length <= maxLength) return normalized;

      return `${normalized.slice(0, maxLength).trimEnd()}…`;
    };

    const statusLabels = labels.statusLabels;
    const emptyMessages = labels.emptyMessages;
    const roleLabels = labels.roleLabels;

    const normalizePage = (value) => {
      const parsed = Number.parseInt(String(value || ''), 10);

      return Number.isFinite(parsed) && parsed > 0 ? parsed : 1;
    };

    const getFilterParams = (page = currentPage) => {
      const params = new URLSearchParams();

      if (!filtersForm) return params;

      const formData = new FormData(filtersForm);
      const status = String(formData.get('status') || 'pending');
      const language = String(formData.get('lang') || formData.get('language') || 'all');
      const pageSize = String(formData.get('pageSize') || '30');
      const q = String(formData.get('q') || '').trim();

      params.set('status', status);
      params.set('lang', language);
      params.set('page', String(normalizePage(page)));
      params.set('pageSize', allowedPageSizes.has(pageSize) ? pageSize : '30');
      if (q) params.set('q', q);

      return params;
    };

    const updateBrowserUrl = (params) => {
      const nextUrl = new URL(window.location.href);
      nextUrl.search = params.toString();
      window.history.replaceState({}, '', nextUrl);
    };

    const initializeFiltersFromUrl = () => {
      if (!filtersForm) return;

      const params = new URLSearchParams(window.location.search);
      const allowedStatuses = new Set(['all', 'pending', 'approved', 'rejected', 'deleted']);
      const allowedLanguages = new Set(['all', 'it', 'en']);
      const pageSizeOptions = new Set(['30', '60', '100']);
      const status = params.get('status');
      const language = params.get('lang') || params.get('language');
      const page = params.get('page');
      const pageSize = params.get('pageSize');
      const q = params.get('q');

      if (status && allowedStatuses.has(status)) {
        const statusField = filtersForm.querySelector('[name="status"]');
        if (statusField instanceof HTMLSelectElement) statusField.value = status;
      }

      if (language && allowedLanguages.has(language)) {
        const languageField = filtersForm.querySelector('[name="lang"]');
        if (languageField instanceof HTMLSelectElement) languageField.value = language;
      }

      if (pageSize && pageSizeOptions.has(pageSize)) {
        const pageSizeField = filtersForm.querySelector('[name="pageSize"]');
        if (pageSizeField instanceof HTMLSelectElement) pageSizeField.value = pageSize;
      }

      if (q) {
        const searchField = filtersForm.querySelector('[name="q"]');
        if (searchField instanceof HTMLInputElement) searchField.value = q;
      }

      currentPage = normalizePage(page || '1');
    };

    const renderComment = (comment) => {
      const profile = comment.profiles || {};
      const isGuest = comment.author_type === 'guest';
      const author = isGuest
        ? comment.guest_display_name || labels.guestBadge
        : profile.display_name || profile.username || labels.userFallback;
      const badge = profile.user_badges?.label_it || profile.user_badges?.label_en || '';
      const articleUrl = comment.article_url || '#';
      const articleLabel = comment.article_title || comment.article_slug || labels.articleFallback;
      const profileUrl = !isGuest && profile.username
        ? labels.locale === 'en-US'
          ? `/en/users/${encodeURIComponent(profile.username)}/`
          : `/utenti/${encodeURIComponent(profile.username)}/`
        : '';
      const status = statusLabels[comment.status] || comment.status || labels.unknownStatus;
      const role = isGuest
        ? labels.guestBadge
        : roleLabels[profile.role] || profile.role || '';
      const parent = comment.parent || null;
      const parentProfile = parent?.profiles || {};
      const parentAuthor = parent?.author_type === 'guest'
        ? parent.guest_display_name || labels.guestBadge
        : parentProfile.display_name || parentProfile.username || labels.originalComment;
      const detailId = `admin-comment-detail-${comment.id}`;
      const moderationReason = comment.moderation_reason || '';
      const guestIdentity = Array.isArray(comment.guest_identity)
        ? comment.guest_identity[0]
        : comment.guest_identity;
      const guestIdentityStatus = labels.guestIdentityStatuses?.[guestIdentity?.status]
        || guestIdentity?.status
        || '';
      const guestApprovedComments = Number(guestIdentity?.approved_comments_count || 0);
      const guestFlags = Array.isArray(comment.abuse_flags)
        ? comment.abuse_flags.map((flag) => String(flag || '').trim()).filter(Boolean)
        : [];
      const guestIdentityDetails = isGuest
        ? `
            <dl class="admin-comment-card__guest-details">
              <div>
                <dt>${escapeHtml(labels.guestIdentity)}</dt>
                <dd>${escapeHtml(comment.guest_identity_ref || '—')}</dd>
              </div>
              <div>
                <dt>${escapeHtml(labels.guestIdentityStatus)}</dt>
                <dd>${escapeHtml(guestIdentityStatus || '—')}</dd>
              </div>
              <div>
                <dt>${escapeHtml(labels.guestApprovedComments)}</dt>
                <dd>${escapeHtml(String(guestApprovedComments))}</dd>
              </div>
              <div>
                <dt>${escapeHtml(labels.guestFlags)}</dt>
                <dd>${guestFlags.length > 0 ? guestFlags.map(escapeHtml).join(', ') : '—'}</dd>
              </div>
            </dl>
          `
        : '';
      const identityModeration = comment.identity_moderation || {};
      const identityCounts = identityModeration.counts || {};
      const activeIdentityBans = Array.isArray(identityModeration.activeBans)
        ? identityModeration.activeBans
        : [];
      const identityAudit = Array.isArray(identityModeration.audit)
        ? identityModeration.audit
        : [];
      const identityActionKeys = isGuest
        ? ['guest_restrict', 'guest_block', 'guest_unblock']
        : ['account_restrict', 'account_ban', 'account_unblock'];

      if (identityModeration.networkSignalAvailable) {
        identityActionKeys.push('ip_block', 'ip_revoke');
      }

      const banList = activeIdentityBans.length > 0
        ? `
            <ul class="admin-comment-card__ban-list">
              ${activeIdentityBans.map((ban) => `
                <li>
                  <strong>${escapeHtml(labels.identityTypes?.[ban.type] || ban.type)}</strong>
                  <span>${escapeHtml(labels.identityStates?.[ban.status] || ban.status)}</span>
                  <span>
                    ${escapeHtml(ban.expiresAt
                      ? `${labels.expires}: ${formatDate(ban.expiresAt)}`
                      : labels.permanent)}
                  </span>
                  ${ban.reason ? `<span>${escapeHtml(ban.reason)}</span>` : ''}
                </li>
              `).join('')}
            </ul>
          `
        : `<p class="admin-comment-card__no-bans">${escapeHtml(labels.noActiveBans)}</p>`;
      const auditList = identityAudit.length > 0
        ? `
            <ol class="admin-comment-card__audit-list">
              ${identityAudit.map((event) => `
                <li>
                  <strong>${escapeHtml(labels.auditEvents?.[event.eventType] || event.eventType)}</strong>
                  <span>${escapeHtml(labels.identityTypes?.[event.type] || event.type)}</span>
                  <span>${escapeHtml(labels.identityStates?.[event.status] || event.status)}</span>
                  <time datetime="${escapeHtml(event.createdAt || '')}">
                    ${escapeHtml(formatDate(event.createdAt))}
                  </time>
                  ${event.expiresAt
                    ? `<span>${escapeHtml(`${labels.expires}: ${formatDate(event.expiresAt)}`)}</span>`
                    : ''}
                  ${event.moderatorRef
                    ? `<span>${escapeHtml(`${labels.moderatorReference}: ${event.moderatorRef}`)}</span>`
                    : ''}
                  ${event.reason ? `<span>${escapeHtml(event.reason)}</span>` : ''}
                </li>
              `).join('')}
            </ol>
          `
        : `<p class="admin-comment-card__no-bans">${escapeHtml(labels.noAuditEvents)}</p>`;
      const identityModerationPanel = `
        <section class="admin-comment-card__identity-moderation">
          <h3>${escapeHtml(labels.identityModeration)}</h3>

          <dl class="admin-comment-card__identity-summary">
            <div>
              <dt>${escapeHtml(labels.identityType)}</dt>
              <dd>${escapeHtml(labels.identityTypes?.[identityModeration.type] || identityModeration.type || '—')}</dd>
            </div>
            <div>
              <dt>${escapeHtml(labels.identityReference)}</dt>
              <dd>${escapeHtml(identityModeration.reference || comment.guest_identity_ref || '—')}</dd>
            </div>
            <div>
              <dt>${escapeHtml(labels.identityState)}</dt>
              <dd>${escapeHtml(labels.identityStates?.[identityModeration.state] || identityModeration.state || '—')}</dd>
            </div>
            <div>
              <dt>${escapeHtml(labels.identityCounts)}</dt>
              <dd>
                ${escapeHtml(String(identityCounts.approved || 0))}
                /
                ${escapeHtml(String(identityCounts.rejected || 0))}
                /
                ${escapeHtml(String(identityCounts.reported || 0))}
              </dd>
            </div>
          </dl>

          ${identityModeration.suspectedBanEvasion
            ? `<p class="admin-comment-card__evasion-flag">${escapeHtml(labels.suspectedBanEvasion)}</p>`
            : ''}

          <div class="admin-comment-card__active-bans">
            <strong>${escapeHtml(labels.activeBans)}</strong>
            ${banList}
          </div>

          <div class="admin-comment-card__audit">
            <strong>${escapeHtml(labels.auditTrail)}</strong>
            ${auditList}
          </div>

          <form class="admin-comment-card__identity-form" data-identity-moderation-form>
            <label>
              <span>${escapeHtml(labels.moderationAction)}</span>
              <select name="action" required>
                ${identityActionKeys.map((actionKey) => `
                  <option value="${escapeHtml(actionKey)}">
                    ${escapeHtml(labels.actionOptions?.[actionKey] || actionKey)}
                  </option>
                `).join('')}
              </select>
            </label>

            <label>
              <span>${escapeHtml(labels.duration)}</span>
              <select name="duration" required>
                ${['24h', '7d', '30d', 'custom', 'permanent'].map((durationKey) => `
                  <option value="${escapeHtml(durationKey)}">
                    ${escapeHtml(labels.durations?.[durationKey] || durationKey)}
                  </option>
                `).join('')}
              </select>
            </label>

            <label>
              <span>${escapeHtml(labels.customExpiry)}</span>
              <input type="datetime-local" name="customExpiresAt" />
            </label>

            <label class="admin-comment-card__identity-reason">
              <span>${escapeHtml(labels.internalReason)}</span>
              <textarea
                name="reason"
                rows="2"
                minlength="3"
                maxlength="1000"
                placeholder="${escapeHtml(labels.internalReasonPlaceholder)}"
                required
              ></textarea>
            </label>

            <label class="admin-comment-card__exceptional-ip">
              <input type="checkbox" name="exceptionalPermanentIp" value="true" />
              <span>${escapeHtml(labels.exceptionalPermanentIp)}</span>
            </label>

            <button type="submit">${escapeHtml(labels.applyIdentityAction)}</button>
          </form>
        </section>
      `;
      const isHidden = Boolean(comment.deleted_at);
      const displayStatus = isHidden ? statusLabels.deleted : status;
      const isRecentPending = comment.status === 'pending' && isWithinLastDay(comment.created_at);
      const reviewBadge = comment.status === 'pending'
        ? `
            <span class="admin-comment-card__review-badge" data-review-state="${isRecentPending ? 'new' : 'review'}">
              ${escapeHtml(isRecentPending ? labels.newBadge : labels.needsReviewBadge)}
            </span>
          `
        : '';
      const actionButtons = isHidden
        ? `
            <button type="button" data-action="approve">${escapeHtml(labels.restoreApprove)}</button>
            <button type="button" data-action="pending">${escapeHtml(labels.restorePending)}</button>
            ${canHardDelete ? `<button type="button" class="admin-comment-card__danger-action" data-action="hard_delete" data-confirm="${escapeHtml(labels.hardDeleteConfirm)}">${escapeHtml(labels.hardDelete)}</button>` : ''}
          `
        : `
            ${comment.status !== 'approved' ? `<button type="button" data-action="approve">${escapeHtml(labels.approve)}</button>` : ''}
            ${comment.status !== 'pending' ? `<button type="button" data-action="pending">${escapeHtml(labels.pending)}</button>` : ''}
            ${comment.status !== 'rejected' ? `<button type="button" data-action="reject">${escapeHtml(labels.reject)}</button>` : ''}
            <button type="button" data-action="soft_delete" data-confirm="${escapeHtml(labels.hideConfirm)}">${escapeHtml(labels.hide)}</button>
            ${canHardDelete ? `<button type="button" class="admin-comment-card__danger-action" data-action="hard_delete" data-confirm="${escapeHtml(labels.hardDeleteConfirm)}">${escapeHtml(labels.hardDelete)}</button>` : ''}
          `;
      const quickModerationActions = !isHidden && comment.status === 'pending'
        ? `
            <div class="admin-comment-card__quick-moderation" aria-label="${escapeHtml(labels.quickActions)}">
              <button type="button" class="admin-comment-card__primary-action" data-action="approve">${escapeHtml(labels.approve)}</button>
              <button type="button" data-action="reject">${escapeHtml(labels.reject)}</button>
            </div>
          `
        : '';
      const selectionControl = !isHidden && comment.status === 'pending'
        ? `
            <label class="admin-comment-card__selection">
              <input
                type="checkbox"
                data-bulk-comment-id="${escapeHtml(comment.id)}"
                aria-label="${escapeHtml(`${labels.select}: ${author}`)}"
              />
              <span>${escapeHtml(labels.select)}</span>
            </label>
          `
        : '';

      return `
        <article
          class="admin-comment-card"
          data-comment-id="${escapeHtml(comment.id)}"
          data-comment-status="${escapeHtml(comment.status || '')}"
          data-comment-author-type="${isGuest ? 'guest' : 'registered'}"
          data-comment-hidden="${isHidden ? 'true' : 'false'}"
        >
          ${selectionControl}

          <header class="admin-comment-card__header">
            <div class="admin-comment-card__summary">
              <p class="admin-comment-card__article">
                <a href="${escapeHtml(articleUrl)}" target="_blank" rel="noreferrer">
                  ${escapeHtml(articleLabel)}
                </a>
              </p>

              <div class="admin-comment-card__title-row">
                <h2>${escapeHtml(author)}</h2>
                ${parent ? `<span class="admin-comment-card__reply-label">${escapeHtml(labels.replyTo)} ${escapeHtml(parentAuthor)}</span>` : ''}
              </div>
            </div>

            <div class="admin-comment-card__quick-actions">
              <a href="${escapeHtml(articleUrl)}" target="_blank" rel="noreferrer">${escapeHtml(labels.openArticle)}</a>
              ${profileUrl ? `<a href="${escapeHtml(profileUrl)}" target="_blank" rel="noreferrer">${escapeHtml(labels.viewProfile)}</a>` : ''}
              <button
                type="button"
                data-admin-comment-toggle
                aria-expanded="false"
                aria-controls="${escapeHtml(detailId)}"
              >
                ${escapeHtml(labels.manage)}
              </button>
            </div>
          </header>

          <p class="admin-comment-card__meta">
            <span class="admin-comment-card__status" data-status="${escapeHtml(isHidden ? 'deleted' : comment.status || '')}">
              ${escapeHtml(displayStatus)}
            </span>
            ${reviewBadge}
            ${role ? `<span>${escapeHtml(role)}</span>` : ''}
            ${badge ? `<span>${escapeHtml(badge)}</span>` : ''}
            ${comment.article_language ? `<span>${escapeHtml(comment.article_language.toUpperCase())}</span>` : ''}
            ${comment.created_at ? `<span>${escapeHtml(formatDate(comment.created_at))}</span>` : ''}
          </p>

          ${moderationReason ? `
            <p class="admin-comment-card__reason-summary">
              <strong>${escapeHtml(labels.reasonPrefix)}</strong>
              <span>${escapeHtml(moderationReason)}</span>
            </p>
          ` : ''}

          <div class="admin-comment-card__preview">
            <span class="admin-comment-card__preview-label">${escapeHtml(labels.commentExcerpt)}</span>
            <p>${escapeHtml(createExcerpt(comment.body))}</p>
          </div>

          ${quickModerationActions}

          <div class="admin-comment-card__details" id="${escapeHtml(detailId)}" data-admin-comment-details hidden>
            ${parent ? `
              <div class="admin-comment-card__parent">
                <strong>${escapeHtml(labels.replyTo)} ${escapeHtml(parentAuthor)}</strong>
                <p>${escapeHtml(parent.body || '').slice(0, 220)}</p>
              </div>
            ` : ''}

            <div class="admin-comment-card__body">
              <strong class="admin-comment-card__body-label">${escapeHtml(labels.fullComment)}</strong>
              ${escapeHtml(comment.body)}
            </div>

            ${moderationReason ? `
              <p class="admin-comment-card__moderation-reason">
                <strong>${escapeHtml(labels.moderationReason)}</strong>
                <span>${escapeHtml(moderationReason)}</span>
              </p>
            ` : ''}

            ${guestIdentityDetails}
            ${identityModerationPanel}

            <div class="admin-comment-card__actions">
              ${actionButtons}
            </div>
          </div>
        </article>
      `;
    };

    const renderPagination = (pagination) => {
      if (!paginationNode) return;

      if (!pagination) {
        paginationNode.hidden = true;
        paginationNode.innerHTML = '';
        return;
      }

      const total = Number(pagination.total || 0);
      const totalPages = Math.max(1, Number(pagination.totalPages || 1));
      const page = Math.min(Math.max(1, Number(pagination.page || 1)), totalPages);
      const hasPrev = Boolean(pagination.hasPrev);
      const hasNext = Boolean(pagination.hasNext);
      const pageSummary = String(labels.pageSummary || '')
        .replace('{page}', String(page))
        .replace('{totalPages}', String(totalPages));

      paginationNode.hidden = false;
      paginationNode.innerHTML = `
        <div class="admin-comments-pagination__summary">
          <strong>${escapeHtml(labels.commentsFoundLabel)} ${escapeHtml(String(total))}</strong>
          <span>${escapeHtml(pageSummary)}</span>
        </div>
        <div class="admin-comments-pagination__actions">
          <button type="button" data-pagination-page="${page - 1}" ${hasPrev ? '' : 'disabled'}>
            ${escapeHtml(labels.previous)}
          </button>
          <button type="button" data-pagination-page="${page + 1}" ${hasNext ? '' : 'disabled'}>
            ${escapeHtml(labels.next)}
          </button>
        </div>
      `;
    };

    const getBulkCheckboxes = () =>
      Array.from(listNode?.querySelectorAll('input[data-bulk-comment-id]') || [])
        .filter((input) => input instanceof HTMLInputElement);

    const getSelectedBulkIds = () =>
      getBulkCheckboxes()
        .filter((input) => input.checked)
        .map((input) => input.dataset.bulkCommentId)
        .filter(Boolean);

    const updateBulkState = () => {
      if (!bulkNode) return;

      const checkboxes = getBulkCheckboxes();
      const selectedIds = getSelectedBulkIds();
      const selectedCount = selectedIds.length;
      const bulkButtons = Array.from(bulkNode.querySelectorAll('button[data-bulk-action]'));

      bulkNode.hidden = checkboxes.length === 0;

      if (selectedCountNode) {
        selectedCountNode.textContent = selectedCount === 1
          ? labels.selectedOne
          : String(labels.selectedMany || '').replace('{count}', String(selectedCount));
      }

      if (selectAllCheckbox instanceof HTMLInputElement) {
        selectAllCheckbox.checked = checkboxes.length > 0 && selectedCount === checkboxes.length;
        selectAllCheckbox.indeterminate = selectedCount > 0 && selectedCount < checkboxes.length;
        selectAllCheckbox.disabled = bulkInProgress || checkboxes.length === 0;
      }

      for (const button of bulkButtons) {
        if (button instanceof HTMLButtonElement) {
          button.disabled = bulkInProgress || selectedCount === 0;
        }
      }
    };

    const loadComments = async ({ page = currentPage, updateHistory = true } = {}) => {
      if (!listNode) return;

      try {
        const params = getFilterParams(page);
        const response = await fetch(`/api/admin/comments/pending?${params.toString()}`);
        const result = await response.json();

        if (!result.ok) {
          listNode.innerHTML = `<p class="admin-comments-empty">${escapeHtml(result.error || labels.loadError)}</p>`;
          if (countNode) countNode.textContent = labels.accessUnavailable;
          renderPagination(null);
          updateBulkState();
          return;
        }

        const comments = result.comments || [];
        const pagination = result.pagination || {
          page,
          pageSize: Number(params.get('pageSize') || 30),
          total: comments.length,
          totalPages: 1,
          hasPrev: false,
          hasNext: false,
        };
        currentPage = Number(pagination.page || page) || 1;
        params.set('page', String(currentPage));
        if (updateHistory) updateBrowserUrl(params);

        if (countNode) {
          const total = Number(pagination.total || comments.length);
          countNode.textContent = total === 1
            ? labels.commentsFoundOne
            : `${total} ${labels.commentsFoundMany}`;
        }

        renderPagination(pagination);

        if (comments.length === 0) {
          const status = String(params.get('status') || 'all');
          listNode.innerHTML = `<p class="admin-comments-empty">${escapeHtml(emptyMessages[status] || emptyMessages.all)}</p>`;
          updateBulkState();
          return;
        }

        listNode.innerHTML = comments.map(renderComment).join('');
        updateBulkState();
      } catch {
        listNode.innerHTML = `<p class="admin-comments-empty">${escapeHtml(labels.connectionError)}</p>`;
        renderPagination(null);
        updateBulkState();
      }
    };

    filtersForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      showMessage('');
      currentPage = 1;
      loadComments({ page: 1 });
    });

    resetButton?.addEventListener('click', () => {
      filtersForm?.reset();
      showMessage('');
      currentPage = 1;
      loadComments({ page: 1 });
    });

    paginationNode?.addEventListener('click', (event) => {
      const button = event.target.closest('button[data-pagination-page]');
      if (!button || button.disabled) return;

      const nextPage = normalizePage(button.dataset.paginationPage);
      showMessage('');
      loadComments({ page: nextPage });
    });

    selectAllCheckbox?.addEventListener('change', () => {
      if (!(selectAllCheckbox instanceof HTMLInputElement)) return;

      for (const checkbox of getBulkCheckboxes()) {
        checkbox.checked = selectAllCheckbox.checked;
      }

      updateBulkState();
    });

    bulkNode?.addEventListener('click', async (event) => {
      const button = event.target.closest('button[data-bulk-action]');
      if (!button || button.disabled) return;

      const action = button.dataset.bulkAction;
      const selectedIds = getSelectedBulkIds();

      if (selectedIds.length === 0) {
        showMessage(labels.noSelection, 'error');
        updateBulkState();
        return;
      }

      if (selectedIds.length > maxBulkSelection) {
        showMessage(labels.maxBulkSelected, 'error');
        updateBulkState();
        return;
      }

      const confirmText = action === 'approve'
        ? labels.approveSelectedConfirm
        : labels.rejectSelectedConfirm;

      if (!window.confirm(confirmText)) {
        return;
      }

      bulkInProgress = true;
      updateBulkState();
      showMessage('');

      try {
        const response = await fetch('/api/admin/comments/bulk-moderate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            ids: selectedIds,
            action
          })
        });
        const result = await response.json();

        if (!result.ok) {
          showMessage(result.error || labels.actionFailed, 'error');
          bulkInProgress = false;
          updateBulkState();
          return;
        }

        showMessage(`${labels.bulkUpdated} ${result.updatedCount || 0}`, 'ok');
        bulkInProgress = false;
        await loadComments();
      } catch {
        showMessage(labels.connectionError, 'error');
        bulkInProgress = false;
        updateBulkState();
      }
    });

    listNode?.addEventListener('change', (event) => {
      if (event.target instanceof HTMLInputElement && event.target.matches('input[data-bulk-comment-id]')) {
        updateBulkState();
      }
    });

    listNode?.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.matches('[data-identity-moderation-form]')) {
        return;
      }

      event.preventDefault();

      const card = form.closest('[data-comment-id]');
      const commentId = card?.dataset.commentId;
      if (!commentId) return;

      const submitButton = form.querySelector('button[type="submit"]');
      const formData = new FormData(form);
      const customExpiryValue = String(formData.get('customExpiresAt') || '').trim();
      const customExpiryTimestamp = customExpiryValue ? Date.parse(customExpiryValue) : NaN;
      const customExpiresAt = Number.isFinite(customExpiryTimestamp)
        ? new Date(customExpiryTimestamp).toISOString()
        : null;

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      showMessage('');

      try {
        const response = await fetch('/api/admin/comments/identity-moderation', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            commentId,
            action: String(formData.get('action') || ''),
            duration: String(formData.get('duration') || '24h'),
            customExpiresAt,
            reason: String(formData.get('reason') || ''),
            exceptionalPermanentIp: formData.get('exceptionalPermanentIp') === 'true'
          })
        });
        const result = await response.json();

        if (!result.ok) {
          showMessage(result.error || labels.actionFailed, 'error');
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
          return;
        }

        showMessage(labels.identityActionUpdated, 'ok');
        await loadComments();
      } catch {
        showMessage(labels.connectionError, 'error');
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
      }
    });

    listNode?.addEventListener('click', async (event) => {
      const toggleButton = event.target.closest('button[data-admin-comment-toggle]');
      if (toggleButton) {
        const card = toggleButton.closest('[data-comment-id]');
        const details = card?.querySelector('[data-admin-comment-details]');

        if (details) {
          const isOpening = details.hidden;
          details.hidden = !isOpening;
          toggleButton.setAttribute('aria-expanded', String(isOpening));
          toggleButton.textContent = isOpening ? labels.close : labels.manage;
        }

        return;
      }

      const button = event.target.closest('button[data-action]');
      if (!button) return;

      const card = button.closest('[data-comment-id]');
      const commentId = card?.dataset.commentId;
      const action = button.dataset.action;

      if (!commentId || !action) return;

      const confirmation = button.dataset.confirm;
      if (confirmation && !window.confirm(confirmation)) {
        return;
      }

      button.disabled = true;
      showMessage('');

      try {
        const response = await fetch('/api/admin/comments/moderate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            commentId,
            action,
            note: `${labels.notePrefix}: ${action}`
          })
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(result.error || labels.actionFailed, 'error');
          button.disabled = false;
          return;
        }

        showMessage(labels.commentUpdated, 'ok');
        await loadComments();
      } catch {
        showMessage(labels.connectionError, 'error');
        button.disabled = false;
      }
    });

    initializeFiltersFromUrl();
    loadComments();
  </script>
</BaseLayout>
