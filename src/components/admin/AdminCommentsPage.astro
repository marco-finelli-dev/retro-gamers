          guest_restrict: 'Limita identità ospite',
          guest_block: 'Blocca identità ospite',
          guest_unblock: 'Sblocca identità',
          account_restrict: 'Limita utente registrato',
          account_ban: 'Blocca utente registrato',
          account_unblock: 'Sblocca utente registrato',
