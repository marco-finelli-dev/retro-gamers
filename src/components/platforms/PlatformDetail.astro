---
import '../../styles/components/platforms.css';
import '../../styles/components/platforms-refresh.css';
import PlatformBreadcrumb from './PlatformBreadcrumb.astro';
import PlatformBrand from './PlatformBrand.astro';
import { urlFor } from '../../lib/image';

import {
  platformTypeLabels
} from '../../lib/platforms';

const { platform, lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const typeLabels = {
  it: platformTypeLabels,
  en: {
    arcade: 'Arcade',
    computer: 'Computer',
    console: 'Console'
  }
};

const typeLabel =
  typeLabels[lang]?.[platform.platformType] ||
  platformTypeLabels[platform.platformType] ||
  (isEn ? 'Platform' : 'Piattaforma');

const labels = {
  specs: isEn ? 'Technical specs' : 'Scheda tecnica',
  history: isEn ? 'History' : 'La storia',
  year: isEn ? 'Release year' : 'Anno di uscita',
  cpu: 'CPU',
  ram: 'RAM',
  graphics: isEn ? 'Graphics' : 'Grafica',
  audio: 'Audio',
  resolution: isEn ? 'Resolution' : 'Risoluzione',
  media: isEn ? 'Media' : 'Supporti'
};

const getLogo = (platform) => {
  if (!platform?.logo) return '';

  return urlFor(platform.logo)
    .width(900)
    .quality(86)
    .auto('format')
    .url();
};

const getLogoLight = (platform) => {
  if (!platform?.logoLight) return '';

  return urlFor(platform.logoLight)
    .width(900)
    .quality(86)
    .auto('format')
    .url();
};

const getCover = (platform) => {
  if (!platform?.cover) return '';

  return urlFor(platform.cover)
    .width(1400)
    .quality(78)
    .auto('format')
    .url();
};

const getManufacturerLogo = (platform) => {
  if (!platform?.manufacturer?.logo) return '';

  return urlFor(platform.manufacturer.logo)
    .width(700)
    .quality(86)
    .auto('format')
    .url();
};

const getManufacturerLogoLight = (platform) => {
  if (!platform?.manufacturer?.logoLight) return '';

  return urlFor(platform.manufacturer.logoLight)
    .width(700)
    .quality(86)
    .auto('format')
    .url();
};

const logo = getLogo(platform);
const logoLight = getLogoLight(platform) || logo;
const cover = getCover(platform);
const manufacturerLogo = getManufacturerLogo(platform);
const manufacturerLogoLight = getManufacturerLogoLight(platform) || manufacturerLogo;
const hasPlatformLogo = Boolean(logo);

const logoAlt =
  platform.logo?.alt ||
  platform.logoLight?.alt ||
  platform.name;

const specValue = (itValue, enValue) =>
  isEn
    ? enValue || itValue
    : itValue;

const localizedSpecs = {
  cpu: specValue(platform.specs?.cpu, platform.specs?.cpuEn),
  ram: specValue(platform.specs?.ram, platform.specs?.ramEn),
  graphics: specValue(platform.specs?.gpu, platform.specs?.gpuEn),
  audio: specValue(platform.specs?.audio, platform.specs?.audioEn),
  resolution: specValue(platform.specs?.resolution, platform.specs?.resolutionEn),
  media: specValue(platform.specs?.media, platform.specs?.mediaEn)
};

const chips = [
  typeLabel,
  platform.badgeLabel,
  localizedSpecs.media
].filter(Boolean);

const specs = [
  { label: labels.year, value: platform.specs?.year },
  { label: labels.cpu, value: localizedSpecs.cpu },
  { label: labels.ram, value: localizedSpecs.ram },
  { label: labels.graphics, value: localizedSpecs.graphics },
  { label: labels.audio, value: localizedSpecs.audio },
  { label: labels.resolution, value: localizedSpecs.resolution },
  { label: labels.media, value: localizedSpecs.media }
].filter((item) => item.value);

const historyText = isEn
  ? platform.historyEn || platform.history
  : platform.history;

const historyParagraphs = historyText
  ? historyText.split('\n').filter(Boolean)
  : [];
---

<div class="platforms-page">
  <div class="container">
    <PlatformBreadcrumb type={platform.platformType} manufacturer={platform.manufacturer} platform={platform} lang={lang} />

    <section class={`platform-sheet platform-sheet--${platform.platformType}`}>


      <div class="platform-sheet__grid">

        <div class="platform-sheet__left">

          <div class="platform-sheet__visual">

            {cover ? (
              <img
                src={cover}
                alt={platform.cover?.alt || platform.name}
                class="platform-sheet__cover"
                loading="eager"
              />
            ) : (
              <div class="platform-sheet__fallback">

                {logo && (
                  <picture class="platform-sheet__fallback-logo-picture">
                    <img
                      src={logo}
                      alt={logoAlt}
                      class="platform-sheet__fallback-logo platform-sheet__fallback-logo--dark"
                      loading="eager"
                    />

                    <img
                      src={logoLight}
                      alt=""
                      class="platform-sheet__fallback-logo platform-sheet__fallback-logo--light"
                      loading="eager"
                      aria-hidden="true"
                    />
                  </picture>
                )}

              </div>
            )}

          </div>

          {chips.length > 0 && (
            <div class="platform-sheet__chips platform-mobile">
              {chips.map((chip) => (
                <span>{chip}</span>
              ))}
            </div>
          )}

          {specs.length > 0 && (
            <section class="platform-sheet__specs">

              <div class="platform-sheet__section-title">
                <span>{labels.specs}</span>
              </div>

              <div class="platform-spec-table">
                {specs.map((item) => (
                  <div class="platform-spec-row">
                    <span>{item.label}</span>
                    <strong>{item.value}</strong>
                  </div>
                ))}
              </div>

            </section>
          )}

        </div>

        <div class="platform-sheet__right">

          <header class="platform-sheet__header" data-platform={platform.slug} data-manufacturer={platform.manufacturer?.slug}>
            <div class="platform-desktop">
              <PlatformBrand manufacturerLogo={manufacturerLogo} manufacturerLogoLight={manufacturerLogoLight} logo={logo} logoLight={logoLight} logoAlt={logoAlt} platform={platform} header={true} decorativePlatform={true} />
            </div>
            <h1 class:list={{ 'sr-only': hasPlatformLogo, 'platform-sheet__title': true, 'platform-sheet__section-title': !hasPlatformLogo }}>
              <span>{platform.name}</span>
            </h1>
            <div class="platform-sheet__metadata platform-desktop">
              {[typeLabel, platform.badgeLabel].filter(Boolean).map((value, index) => (
                <span class="platform-sheet__metadata-item">
                  {index > 0 && <span class="platform-sheet__metadata-separator" aria-hidden="true">·</span>}
                  {value}
                </span>
              ))}
            </div>
          </header>

          <div class="platform-mobile">
            <PlatformBrand manufacturerLogo={manufacturerLogo} manufacturerLogoLight={manufacturerLogoLight} logo={logo} logoLight={logoLight} logoAlt={logoAlt} platform={platform} decorativePlatform={true} />
          </div>

          {historyParagraphs.length > 0 && (
            <section class="platform-sheet__history">

              <div class="platform-sheet__section-title">
                <span>{labels.history}</span>
              </div>

              <div class="platform-sheet__history-text">
                {historyParagraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>

            </section>
          )}

        </div>

      </div>

    </section>

  </div>
</div>
