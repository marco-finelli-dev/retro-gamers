---
import '../../styles/components/platforms.css';
import { urlFor } from '../../lib/image';

import {
  platformTypeLabels
} from '../../lib/platforms';

const { platform } = Astro.props;

const typeLabel = platformTypeLabels[platform.platformType] || 'Piattaforma';

const getLogo = (platform) => {
  if (!platform?.logo) return '';
  return urlFor(platform.logo).width(900).quality(86).auto('format').url();
};

const getCover = (platform) => {
  if (!platform?.cover) return '';
  return urlFor(platform.cover).width(1400).quality(78).auto('format').url();
};

const getManufacturerLogo = (platform) => {
  if (!platform?.manufacturer?.logo) return '';
  return urlFor(platform.manufacturer.logo).width(700).quality(86).auto('format').url();
};

const logo = getLogo(platform);
const cover = getCover(platform);
const manufacturerLogo = getManufacturerLogo(platform);

const chips = [
  typeLabel,
  platform.badgeLabel,
  platform.specs?.media
].filter(Boolean);

const specs = [
  { label: 'Anno di uscita', value: platform.specs?.year },
  { label: 'CPU', value: platform.specs?.cpu },
  { label: 'RAM', value: platform.specs?.ram },
  { label: 'Grafica', value: platform.specs?.gpu },
  { label: 'Audio', value: platform.specs?.audio },
  { label: 'Risoluzione', value: platform.specs?.resolution }
].filter((item) => item.value);

const historyParagraphs = platform.history
  ? platform.history.split('\n').filter(Boolean)
  : [];
---

<div class="platforms-page">
  <div class="container">

    <section class={`platform-sheet platform-sheet--${platform.platformType}`}>

      <div class="platform-sheet__grid">

        <div class="platform-sheet__left">

          <div class="platform-sheet__visual">

            {cover ? (
              <img
                src={cover}
                alt={platform.cover?.alt || platform.name}
                class="platform-sheet__cover"
                loading="eager"
              />
            ) : (
              <div class="platform-sheet__fallback">

                {logo && (
                  <img
                    src={logo}
                    alt={platform.logo?.alt || platform.name}
                    loading="eager"
                  />
                )}

              </div>
            )}

          </div>

          {chips.length > 0 && (
            <div class="platform-sheet__chips">
              {chips.map((chip) => (
                <span>{chip}</span>
              ))}
            </div>
          )}

          {specs.length > 0 && (
            <section class="platform-sheet__specs">

              <div class="platform-sheet__section-title">
                <span>Scheda tecnica</span>
              </div>

              <div class="platform-spec-table">
                {specs.map((item) => (
                  <div class="platform-spec-row">
                    <span>{item.label}</span>
                    <strong>{item.value}</strong>
                  </div>
                ))}
              </div>

            </section>
          )}

        </div>

        <div class="platform-sheet__right">

          {(manufacturerLogo || logo) && (
            <div class="platform-sheet__brand">

              {manufacturerLogo && (
                <img
                  src={manufacturerLogo}
                  alt={platform.manufacturer?.logo?.alt || platform.manufacturer?.name}
                  class="platform-sheet__manufacturer-logo"
                  loading="eager"
                />
              )}

              {manufacturerLogo && logo && (
                <span class="platform-sheet__brand-separator" aria-hidden="true"></span>
              )}

              {logo && (
                <img
                  src={logo}
                  alt={platform.logo?.alt || platform.name}
                  class="platform-sheet__platform-logo"
                  loading="eager"
                />
              )}

            </div>
          )}

          {historyParagraphs.length > 0 && (
            <section class="platform-sheet__history">

              <div class="platform-sheet__section-title">
                <span>La storia</span>
              </div>

              <div class="platform-sheet__history-text">
                {historyParagraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>

            </section>
          )}

        </div>

      </div>

    </section>

  </div>
</div>