---
import '../../styles/components/platforms.css';
import {
  platformTypeLabels,
  platformTypeDescriptions
} from '../../lib/platforms';
import { getPlatformTypeUrl } from '../../lib/routes.js';

const { platforms = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const labels = {
  kicker: isEn ? 'Platforms' : 'Piattaforme',
  title: isEn ? 'Retro gaming platforms' : 'Piattaforme retro gaming',
  description: isEn
    ? 'Consoles, home computers and arcade systems form the physical backbone of video game history. This section collects profiles of the platforms that defined different eras, markets and ways of playing, from 8-bit and 16-bit machines to early 3D consoles and arcade boards. Each page combines historical context, technical specifications, manufacturers, competitors and landmark games, creating an organised archive that continues to grow.'
    : 'Console, home computer e sistemi arcade sono il cuore materiale della storia del videogioco. In questa sezione raccogliamo schede dedicate alle piattaforme che hanno definito epoche, mercati e modi diversi di giocare: dalle macchine a 8 e 16 bit alle console 3D, fino alle board da sala giochi. Ogni pagina unisce contesto storico, caratteristiche tecniche, produttori, rivali e titoli simbolo, creando un archivio ordinato e in continua crescita.',
  countSingular: isEn ? 'platform' : 'piattaforma',
  countPlural: isEn ? 'platforms' : 'piattaforme'
};

const typeLabels = {
  it: platformTypeLabels,
  en: {
    arcade: 'Arcade',
    computer: 'Computers',
    console: 'Consoles'
  }
};

const typeDescriptions = {
  it: platformTypeDescriptions,
  en: {
    arcade: 'Cabinets, boards and arcade systems that shaped the coin-op experience.',
    computer: 'Home computers, personal computers and machines that shaped home computing.',
    console: 'Home and handheld systems created for domestic gaming.'
  }
};

const types = [
  {
    type: 'arcade',
    icon: '/images/icons/arcade-icon.png',
    iconWidth: 67,
    iconHeight: 80
  },
  {
    type: 'computer',
    icon: '/images/icons/computer-icon.png',
    iconWidth: 77,
    iconHeight: 80
  },
  {
    type: 'console',
    icon: '/images/icons/console-icon.png',
    iconWidth: 80,
    iconHeight: 38
  }
];

const countByType = (type) =>
  platforms.filter((platform) => platform.platformType === type).length;

const getCountLabel = (count) =>
  `${count} ${count === 1 ? labels.countSingular : labels.countPlural}`;
---

<div class="platforms-page">
  <div class="container">

    <section class="platforms-hero">
      <div class="platforms-hero__inner">
        <span>{labels.kicker}</span>
        <h1>{labels.title}</h1>
        <p>{labels.description}</p>
      </div>
    </section>

    <section class="platform-type-grid">

      {types.map((item) => {
        const count = countByType(item.type);

        return (
          <a
            href={getPlatformTypeUrl(item.type, lang)}
            class={`platform-type-card platform-type-card--${item.type}`}
          >

            <div class={`platform-type-card__icon platform-type-card__icon--${item.type}`} aria-hidden="true">
  <img
    src={item.icon}
    alt=""
    width={item.iconWidth}
    height={item.iconHeight}
    loading="lazy"
  />
</div>

            <div class="platform-type-card__content">
              <span>{getCountLabel(count)}</span>
              <h2>{typeLabels[lang]?.[item.type] || platformTypeLabels[item.type]}</h2>
              <p>{typeDescriptions[lang]?.[item.type] || platformTypeDescriptions[item.type]}</p>
            </div>

          </a>
        );
      })}

    </section>

  </div>
</div>
