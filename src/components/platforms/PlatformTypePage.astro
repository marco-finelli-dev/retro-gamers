---
import '../../styles/components/platforms.css';
import PlatformCard from './PlatformCard.astro';

import {
  platformTypeLabels,
  platformTypeDescriptions,
  groupPlatformsByManufacturer
} from '../../lib/platforms';
import { getPlatformManufacturerUrl } from '../../lib/routes.js';

const { type, platforms = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const labels = {
  kicker: isEn ? 'Platforms' : 'Piattaforme',
  viewManufacturer: isEn ? 'View manufacturer' : 'Vedi produttore',
  emptyTitle: isEn ? 'No platforms yet' : 'Nessuna piattaforma',
  emptyText: isEn
    ? 'This section will be updated soon.'
    : 'Questa sezione verrà popolata presto.'
};

const typeLabels = {
  it: platformTypeLabels,
  en: {
    arcade: 'Arcade',
    computer: 'Computers',
    console: 'Consoles'
  }
};

const typeDescriptions = {
  it: platformTypeDescriptions,
  en: {
    arcade: 'Cabinets, boards and arcade systems that shaped the coin-op experience.',
    computer: 'Home computers, personal computers and machines that shaped home computing.',
    console: 'Home and handheld systems created for domestic gaming.'
  }
};

const getManufacturerHref = (type, slug) => {
  if (!slug) return '#';

  return getPlatformManufacturerUrl(type, slug, lang);
};

const groups = groupPlatformsByManufacturer(platforms);

const title = typeLabels[lang]?.[type] || platformTypeLabels[type] || 'Piattaforme';
const description = typeDescriptions[lang]?.[type] || platformTypeDescriptions[type] || '';
---

<div class="platforms-page">
  <div class="container">

    <section class="platforms-hero">
      <div class="platforms-hero__inner">
        <span>{labels.kicker}</span>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
    </section>

    {groups.length > 0 ? (
      <section class="manufacturer-list">

        {groups.map((group) => (
          <section class="manufacturer-block">

            <div class="manufacturer-block__header">

              <div>
                <span>{title}</span>
                <h2>{group.manufacturer?.name}</h2>
              </div>

              <a href={getManufacturerHref(type, group.manufacturer?.slug)}>
                {labels.viewManufacturer} →
              </a>

            </div>

            <div class="platform-grid">
              {group.platforms.map((platform) => (
                <PlatformCard platform={platform} lang={lang} />
              ))}
            </div>

          </section>
        ))}

      </section>
    ) : (
      <section class="platform-empty">
        <span>RG</span>
        <h2>{labels.emptyTitle}</h2>
        <p>{labels.emptyText}</p>
      </section>
    )}

  </div>
</div>
