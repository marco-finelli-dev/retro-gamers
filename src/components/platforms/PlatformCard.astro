---
import { urlFor } from '../../lib/image';
import { getPlatformUrl } from '../../lib/platforms';

const { platform, lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const typeUrlSlugs = {
  arcade: 'arcade',
  computer: 'computers',
  console: 'consoles'
};

const getPlatformHref = (platform) => {
  if (!platform) return '#';

  if (isEn) {
    const typeSlug = typeUrlSlugs[platform.platformType] || platform.platformType;
    const manufacturerSlug = platform.manufacturer?.slug;
    const platformSlug = platform.slug;

    if (typeSlug && manufacturerSlug && platformSlug) {
      return `/en/platforms/${typeSlug}/${manufacturerSlug}/${platformSlug}/`;
    }
  }

  return getPlatformUrl(platform);
};

const getLogo = (platform) => {
  if (!platform?.logo?.asset) return '';

  return urlFor(platform.logo)
    .width(520)
    .quality(80)
    .auto('format')
    .url();
};

const getCover = (platform) => {
  if (!platform?.cover?.asset) return '';

  return urlFor(platform.cover)
    .width(900)
    .quality(76)
    .auto('format')
    .url();
};

const getManufacturerLogo = (platform) => {
  if (!platform?.manufacturer?.logo?.asset) return '';

  return urlFor(platform.manufacturer.logo)
    .width(360)
    .quality(80)
    .auto('format')
    .url();
};

const cover = getCover(platform);
const logo = getLogo(platform);
const manufacturerLogo = getManufacturerLogo(platform);

const manufacturerName =
  platform.manufacturer?.name ||
  (isEn ? 'Unknown manufacturer' : 'Produttore sconosciuto');

const year = platform.specs?.year || '';
const badge = platform.badgeLabel || '';
---

<a href={getPlatformHref(platform)} class={`platform-card platform-card--${platform.platformType}`}>

  <div class="platform-card__visual">

    {cover ? (
      <img
        src={cover}
        alt={platform.cover?.alt || platform.name}
        class="platform-card__cover"
        width="900"
        height="560"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="platform-card__fallback">
        {logo && (
          <img
            src={logo}
            alt={platform.logo?.alt || platform.name}
            class="platform-card__logo"
            width="520"
            height="220"
            loading="lazy"
            decoding="async"
          />
        )}

        {manufacturerLogo && (
          <img
            src={manufacturerLogo}
            alt={platform.manufacturer?.logo?.alt || manufacturerName}
            class="platform-card__manufacturer-logo"
            width="360"
            height="160"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    )}

  </div>

  <div class="platform-card__body">

    <div class="platform-card__main">
      <span>{manufacturerName}</span>
      <h2>{platform.name}</h2>
    </div>

    {(year || badge) && (
      <div class="platform-card__facts">
        {year && (
          <span>{year}</span>
        )}

        {badge && (
          <span>{badge}</span>
        )}
      </div>
    )}

  </div>

</a>