---
import '../../styles/components/platforms.css';
import PlatformCard from './PlatformCard.astro';

import {
  platformTypeLabels
} from '../../lib/platforms';
import { getPlatformTypeUrl } from '../../lib/routes.js';

const {
  type,
  manufacturer,
  platforms = [],
  lang = 'it'
} = Astro.props;

const isEn = lang === 'en';

const typeLabels = {
  it: platformTypeLabels,
  en: {
    arcade: 'Arcade',
    computer: 'Computers',
    console: 'Consoles'
  }
};

const title = manufacturer?.name || (isEn ? 'Manufacturer' : 'Produttore');

const typeLabel =
  typeLabels[lang]?.[type] ||
  platformTypeLabels[type] ||
  (isEn ? 'Platforms' : 'Piattaforme');

const typeHref = getPlatformTypeUrl(type, lang);

const labels = {
  description: isEn
    ? `All ${typeLabel.toLowerCase()} associated with ${title} in the Retro-Gamers archive.`
    : `Tutte le piattaforme ${typeLabel.toLowerCase()} associate a ${title} presenti nell’archivio Retro-Gamers.`,
  back: isEn
    ? `Back to ${typeLabel}`
    : `Torna a ${typeLabel}`,
  emptyTitle: isEn ? 'No platforms yet' : 'Nessuna piattaforma',
  emptyText: isEn
    ? 'This manufacturer does not have any linked platforms yet.'
    : 'Questo produttore non ha ancora piattaforme collegate.'
};
---

<div class="platforms-page">
  <div class="container">

    <section class="platforms-hero platforms-hero--manufacturer">
      <div class="platforms-hero__inner">

        <div class="platforms-hero__content">

          <span>{typeLabel}</span>

          <h1>{title}</h1>

          <p>{labels.description}</p>

          <a href={typeHref} class="platforms-back-link">
            ← {labels.back}
          </a>

        </div>

      </div>
    </section>

    {platforms.length > 0 ? (
      <section class="platform-grid">
        {platforms.map((platform) => (
          <PlatformCard platform={platform} lang={lang} />
        ))}
      </section>
    ) : (
      <section class="platform-empty">
        <span>RG</span>
        <h2>{labels.emptyTitle}</h2>
        <p>{labels.emptyText}</p>
      </section>
    )}

  </div>
</div>
