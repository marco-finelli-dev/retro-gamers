---
import { urlFor } from '../lib/image';
import { getPostUrl } from '../lib/routes';

const { post = null, showMeta = false } = Astro.props;

if (!post) return;

/* ========================
   DATA
======================== */

const title = post.title || '';

const getImage = (post) => {
  if (!post?.featuredImage?.asset) return '/placeholder-retro.png';

  return urlFor(post.featuredImage)
    .width(520)
    .height(325)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const image = getImage(post);
const url = getPostUrl(post);

/* ========================
   CATEGORY
======================== */

const category = post.categories?.[0] || null;
const categoryName = category?.name || '';

/* ========================
   META
======================== */

const piattaforme = post.platforms?.map((p) => p.name).filter(Boolean).join(', ');
const sviluppatori = post.developers?.map((d) => d.name).filter(Boolean).join(', ');
const anno = post.gameInfo?.releaseYear;

/* ========================
   EXCERPT
======================== */

const excerpt = post.excerpt || '';
---

<div class="card">

  <a href={url} class="card__image">
    <div class="screen">
      <img
        class="game"
        src={image}
        alt={post.featuredImage?.alt || title}
        width="520"
        height="325"
        loading="lazy"
        decoding="async"
      />
    </div>
  </a>

  {!showMeta && categoryName && (
    <div class="card__category">
      {categoryName}
    </div>
  )}

  {showMeta && (
    <div class="meta">

      {piattaforme && (
        <span>{piattaforme}</span>
      )}

      {sviluppatori && (
        <>
          {" • "}
          <span>{sviluppatori}</span>
        </>
      )}

      {anno && (
        <>
          {" • "}
          <span>{anno}</span>
        </>
      )}

    </div>
  )}

  <h2 class="card__title">
    <a href={url}>
      {title}
    </a>
  </h2>

  {excerpt && (
    <p class="excerpt">{excerpt}</p>
  )}

</div>