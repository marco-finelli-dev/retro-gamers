---
import '../../styles/components/archive-page.css';
import '../../styles/components/pagination.css';
import ArchiveCard from './ArchiveCard.astro';
import EntityArticleCard from './EntityArticleCard.astro';
import '../../styles/components/reviews-listing.css';
import ReviewCard from '../cards/ReviewCard.astro';
import { getFormatFilterAliases, getFormatFilterValue, getFormatLabel } from '../../lib/formatLabels';
import { PAGE_SIZE } from '../../lib/pagination';
import { withApprovedCommentCounts } from '../../lib/supabase/comment-counts';

const {
  reviewListing = false,
  editorialListing = false,
  desktopTitle = '',
  desktopDescription = '',
  title = 'Archivio',
  eyebrow = 'Retro-Gamers',
  description = '',
  posts: rawPosts = [],
  showFilters = true,
  lang = 'it',
  emptyTitle = null,
  emptyText = null
} = Astro.props;

const isEnglish = lang === 'en';
const refreshedListing = reviewListing || editorialListing;
const posts = await withApprovedCommentCounts(rawPosts, isEnglish ? 'en' : 'it');

const ui = isEnglish
  ? {
      contentAvailableSingular: 'content available',
      contentAvailablePlural: 'contents available',
      filterArchive: 'Filter archive',
      filterIntro: 'Find what you are looking for',
      type: 'Type',
      platform: 'Platform',
      category: 'Category',
      genre: 'Genre',
      mode: 'Mode',
      year: 'Year',
      format: 'Format',
      product: 'Product',
      all: 'All',
      allFemale: 'All',
      search: 'Search',
      reset: 'Reset',
      visibleContents: 'contents<br />shown',
      emptyTitle: 'No content found',
      emptyText: 'Come back soon: this section will be updated with new content.',
      noResults: 'No results',
      noResultsText: 'Try changing or resetting the selected filters.',
      previous: 'Previous',
      next: 'Next',
      pageStatus: (page, pages) => `Page ${page} of ${pages}`,
      typeLabels: {
        review: 'Reviews',
        news: 'News',
        feature: 'Features',
        guide: 'Guides',
        interview: 'Interviews',
        memories: 'Memories',
        hardware: 'Hardware',
        article: 'Articles'
      },
      productLabels: {
        book: 'Books',
        hardware: 'Hardware',
        accessory: 'Accessories',
        software: 'Software',
        gadget: 'Gadgets',
        service: 'Services',
        other: 'Other'
      }
    }
  : {
      contentAvailableSingular: 'contenuto disponibile',
      contentAvailablePlural: 'contenuti disponibili',
      filterArchive: 'Filtra archivio',
      filterIntro: 'Trova subito quello che cerchi',
      type: 'Tipo',
      platform: 'Piattaforma',
      category: 'Categoria',
      genre: 'Genere',
      mode: 'Modalità',
      year: 'Anno',
      format: 'Formato',
      product: 'Prodotto',
      all: 'Tutti',
      allFemale: 'Tutte',
      search: 'Cerca',
      reset: 'Reset',
      visibleContents: 'contenuti<br />visualizzati',
      emptyTitle: 'Nessun contenuto trovato',
      emptyText: 'Torna presto: questa sezione verrà aggiornata con nuovi contenuti.',
      noResults: 'Nessun risultato',
      noResultsText: 'Prova a cambiare o azzerare i filtri selezionati.',
      previous: 'Precedente',
      next: 'Successiva',
      pageStatus: (page, pages) => `Pagina ${page} di ${pages}`,
      typeLabels: {
        review: 'Recensioni',
        news: 'News',
        feature: 'Speciali',
        guide: 'Guide',
        interview: 'Interviste',
        memories: 'Memories',
        hardware: 'Hardware',
        article: 'Articoli'
      },
      productLabels: {
        book: 'Libri',
        hardware: 'Hardware',
        accessory: 'Accessori',
        software: 'Software',
        gadget: 'Gadget',
        service: 'Servizi',
        other: 'Altro'
      }
    };

const total = posts.length;

const contentCountLabel =
  total === 1
    ? ui.contentAvailableSingular
    : ui.contentAvailablePlural;

const finalEmptyTitle = emptyTitle || ui.emptyTitle;
const finalEmptyText = emptyText || ui.emptyText;

const uniqueBy = (items = [], key = 'slug') => {
  const seen = new Set();

  return items.filter((item) => {
    const value = item?.[key];
    if (!value) return false;
    if (seen.has(value)) return false;

    seen.add(value);
    return true;
  });
};

const platforms = uniqueBy(
  posts.flatMap((post) => post.platforms || [])
).sort((a, b) => a.name.localeCompare(b.name));

const categories = uniqueBy(
  posts.flatMap((post) => post.categories || [])
).sort((a, b) => a.name.localeCompare(b.name));

const genres = uniqueBy(
  posts.flatMap((post) => post.genres || [])
).sort((a, b) => a.name.localeCompare(b.name));

const modes = uniqueBy(
  posts.flatMap((post) => post.modes || [])
).sort((a, b) => a.name.localeCompare(b.name));

const years = [...new Set(
  posts
    .map((post) => post.gameInfo?.releaseYear)
    .filter(Boolean)
)].sort((a, b) => Number(b) - Number(a));

const types = [...new Set(
  posts
    .map((post) => post.type)
    .filter(Boolean)
)].sort();

const getMonetizationProductTypes = (post) => [
  post.monetization?.productType,
  ...(post.monetization?.products || []).map((product) => product.productType)
].filter(Boolean);

const productTypes = [...new Set(
  posts
    .flatMap(getMonetizationProductTypes)
    .filter(Boolean)
)].sort();

const formatOptions = [
  ...new Map(
    posts
      .flatMap((post) => {
        const value = post.gameInfo?.mediaFormat;

        return Array.isArray(value)
          ? value
          : value
            ? [value]
            : [];
      })
      .map((format) => getFormatFilterValue(format))
      .filter(Boolean)
      .map((format) => [
        format,
        {
          value: format,
          label: getFormatLabel(format, lang)
        }
      ])
  ).values()
].sort((a, b) => a.label.localeCompare(b.label));

const hasFilters =
  platforms.length > 0 ||
  categories.length > 0 ||
  genres.length > 0 ||
  modes.length > 0 ||
  years.length > 0 ||
  formatOptions.length > 0 ||
  types.length > 1 ||
  productTypes.length > 0;
---

<div class:list={["archive-page", !refreshedListing && "reviews-listing archive-standard-refresh"]}>
  <div class="container">

    <section class="archive-hero">
      <div class="archive-hero__inner">

        <div class="archive-hero__content">
          <span class:list={[refreshedListing && 'reviews-listing__mobile']}>{eyebrow}</span>
          {refreshedListing ? <><h1 class="reviews-listing__mobile">{title}</h1><h1 class="reviews-listing__desktop">{editorialListing ? desktopTitle : isEnglish ? 'Reviews' : 'Recensioni'}</h1></> : <h1>{title}</h1>}

          {description && (
            refreshedListing ? <><p class="reviews-listing__mobile">{description}</p><p class="reviews-listing__desktop">{editorialListing ? desktopDescription : isEnglish ? 'Our console, computer and arcade game reviews.' : 'Le nostre recensioni per console, computer e arcade.'}</p></> : <p>{description}</p>
          )}

          {total > 0 && (
            <small class:list={['archive-hero__count', refreshedListing && 'reviews-listing__mobile']}>
              {total} {contentCountLabel}
            </small>
          )}
        </div>

      </div>
    </section>

    {(showFilters || reviewListing) && hasFilters && posts.length > 0 && (
      <section class:list={['archive-filters', reviewListing && !showFilters && 'reviews-listing__desktop']} data-archive-filters>

        <div class="archive-filters__bar">

          <div class:list={['archive-filters__intro', reviewListing && 'reviews-listing__mobile']}>
            <span>{ui.filterArchive}</span>
            <strong>{ui.filterIntro}</strong>
          </div>

          <div class="archive-filters__grid">

            {types.length > 1 && (
              <label class="archive-filter">
                <span>{ui.type}</span>
                <select data-filter="type">
                  <option value="">{ui.all}</option>
                  {types.map((type) => (
                    <option value={type}>{ui.typeLabels[type] || type}</option>
                  ))}
                </select>
              </label>
            )}

            {platforms.length > 0 && (
              <label class="archive-filter">
                <span>{ui.platform}</span>
                <select data-filter="platform">
                  <option value="">{isEnglish ? ui.all : ui.allFemale}</option>
                  {platforms.map((platform) => (
                    <option value={platform.slug}>{platform.name}</option>
                  ))}
                </select>
              </label>
            )}

            {categories.length > 0 && (
              <label class="archive-filter">
                <span>{ui.category}</span>
                <select data-filter="category">
                  <option value="">{isEnglish ? ui.all : ui.allFemale}</option>
                  {categories.map((category) => (
                    <option value={category.slug}>
                      {isEnglish ? category.nameEn || category.name : category.name}
                    </option>
                  ))}
                </select>
              </label>
            )}

            {genres.length > 0 && (
              <label class="archive-filter">
                <span>{ui.genre}</span>
                <select data-filter="genre">
                  <option value="">{ui.all}</option>
                  {genres.map((genre) => (
                    <option value={genre.slug}>{isEnglish ? genre.nameEn || genre.name : genre.name}</option>
                  ))}
                </select>
              </label>
            )}

            {modes.length > 0 && (
              <label class="archive-filter">
                <span>{ui.mode}</span>
                <select data-filter="mode">
                  <option value="">{ui.all}</option>
                  {modes.map((mode) => (
                    <option value={mode.slug}>{isEnglish ? mode.nameEn || mode.name : mode.name}</option>
                  ))}
                </select>
              </label>
            )}

            {years.length > 0 && (
              <label class="archive-filter">
                <span>{ui.year}</span>
                <select data-filter="year">
                  <option value="">{ui.all}</option>
                  {years.map((year) => (
                    <option value={year}>{year}</option>
                  ))}
                </select>
              </label>
            )}

            {formatOptions.length > 0 && (
              <label class="archive-filter">
                <span>{ui.format}</span>
                <select data-filter="format">
                  <option value="">{ui.all}</option>
                  {formatOptions.map((format) => (
                    <option value={format.value}>{format.label}</option>
                  ))}
                </select>
              </label>
            )}

            {(productTypes.length > 0 || reviewListing) && (
              <label class="archive-filter">
                <span>{ui.product}</span>
                <select data-filter="product">
                  <option value="">{ui.all}</option>
                  {productTypes.map((product) => (
                    <option value={product}>{ui.productLabels[product] || product}</option>
                  ))}
                </select>
              </label>
            )}

          </div>

          <div class="archive-filters__actions">
            <button type="button" class="archive-filters__submit" data-filter-submit>
              {ui.search}
            </button>

            <button type="button" class="archive-filters__reset" data-filter-reset>
              {ui.reset}
            </button>
          </div>

          <div class:list={['archive-filters__result', reviewListing && 'reviews-listing__mobile']}>
            <span data-filter-count>{posts.length}</span>
            <small set:html={ui.visibleContents} />
          </div>

        </div>

      </section>
    )}

    {refreshedListing && <p class="reviews-listing__desktop reviews-listing__count"><span data-filter-count>{posts.length}</span> {editorialListing ? contentCountLabel : isEnglish ? 'reviews' : 'recensioni'}</p>}

    {posts.length > 0 ? (

      <section class="archive-grid" aria-label={title} data-archive-grid data-page-size={PAGE_SIZE}>
        {posts.map((post, index) => {
          const platformSlugs = post.platforms?.map((item) => item.slug).filter(Boolean) || [];
          const categorySlugs = post.categories?.map((item) => item.slug).filter(Boolean) || [];
          const genreSlugs = post.genres?.map((item) => item.slug).filter(Boolean) || [];
          const modeSlugs = post.modes?.map((item) => item.slug).filter(Boolean) || [];
          const year = post.gameInfo?.releaseYear || '';
          const formatValues = Array.isArray(post.gameInfo?.mediaFormat)
            ? post.gameInfo.mediaFormat
            : post.gameInfo?.mediaFormat
              ? [post.gameInfo.mediaFormat]
              : [];
          const formatSlugs = formatValues.flatMap((format) => getFormatFilterAliases(format));
          const productType = getMonetizationProductTypes(post).join('|');

          return (
            <article
              data-archive-item
              data-type={post.type || ''}
              data-platforms={platformSlugs.join('|')}
              data-categories={categorySlugs.join('|')}
              data-genres={genreSlugs.join('|')}
              data-modes={modeSlugs.join('|')}
              data-year={year}
              data-formats={formatSlugs.join('|')}
              data-product={productType}
              hidden={index >= PAGE_SIZE}
            >
              {refreshedListing ? (
                <>
                  <div class="reviews-listing__desktop reviews-listing__card"><ReviewCard post={post} lang={lang} variant="compact" metadataVariant={editorialListing ? "editorial" : "home-reviews"} /></div>
                  <div class="reviews-listing__mobile reviews-listing__card"><ArchiveCard post={post} lang={lang} /></div>
                </>
              ) : <EntityArticleCard post={post} lang={lang} />}
            </article>
          );
        })}
      </section>

      <nav
        class="rg-pagination archive-pagination"
        aria-label={reviewListing ? (isEnglish ? 'Reviews pagination' : 'Paginazione recensioni') : (isEnglish ? 'Archive pagination' : 'Paginazione archivio')}
        data-archive-pagination
        hidden={posts.length <= PAGE_SIZE}
      >
        <a class="rg-pagination__link" href="#" data-pagination-prev hidden>
          <><svg class="reviews-pagination__chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m7.5 3-3 3 3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg><span data-pagination-label>{ui.previous}</span></>
        </a>
        <span class:list={['rg-pagination__status', 'reviews-listing__mobile']} data-pagination-status>
          {ui.pageStatus(1, Math.max(1, Math.ceil(posts.length / PAGE_SIZE)))}
        </span>
        <span class="reviews-pagination__numbers" data-pagination-numbers></span>
        <a class="rg-pagination__link" href="#" data-pagination-next hidden>
          <><span data-pagination-label>{ui.next}</span><svg class="reviews-pagination__chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m4.5 3 3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></>
        </a>
      </nav>

    ) : (

      <section class="archive-empty">
        <span class:list={[refreshedListing && 'reviews-listing__mobile']}>RG</span>
        {refreshedListing && <img class="reviews-listing__desktop reviews-listing__empty-logo" src="/favicon.svg" alt="" aria-hidden="true" width="52" height="52" />}
        <h2>{finalEmptyTitle}</h2>
        <p>{finalEmptyText}</p>
      </section>

    )}

    <section class="archive-empty archive-empty--filtered" data-filter-empty hidden>
      <span class:list={[refreshedListing && 'reviews-listing__mobile']}>RG</span>
        {refreshedListing && <img class="reviews-listing__desktop reviews-listing__empty-logo" src="/favicon.svg" alt="" aria-hidden="true" width="52" height="52" />}
      <h2>{ui.noResults}</h2>
      <p>{ui.noResultsText}</p>
    </section>

  </div>
</div>

<script define:vars={{
  previousLabel: ui.previous,
  nextLabel: ui.next,
  pageStatusPrefix: isEnglish ? 'Page' : 'Pagina',
  pageStatusSeparator: isEnglish ? 'of' : 'di',
}}>
  const root = document.querySelector('[data-archive-filters]');
  const grid = document.querySelector('[data-archive-grid]');
  const empty = document.querySelector('[data-filter-empty]');
  const counts = document.querySelectorAll('[data-filter-count]');
  const pagination = document.querySelector('[data-archive-pagination]');
  const paginationPrev = pagination?.querySelector('[data-pagination-prev]');
  const paginationNext = pagination?.querySelector('[data-pagination-next]');
  const paginationStatus = pagination?.querySelector('[data-pagination-status]');
  const paginationNumbers = pagination?.querySelector('[data-pagination-numbers]');

  if (grid) {
    const controls = root
      ? Array.from(root.querySelectorAll('[data-filter]'))
      : [];
    const items = Array.from(grid.querySelectorAll('[data-archive-item]'));
    const reset = root?.querySelector('[data-filter-reset]');
    const submit = root?.querySelector('[data-filter-submit]');
    const pageSize = Number.parseInt(grid.dataset.pageSize || '12', 10) || 12;
    const queryFilters = new Set(
      controls
        .map((control) => control.dataset.filter)
        .filter(Boolean)
    );
    let currentPage = 1;
    let currentTotalPages = 1;

    const includesToken = (list, value) => {
      if (!value) return true;
      if (!list) return false;

      return list.split('|').includes(value);
    };

    const normalizeFormatValue = (value = '') => {
      return String(value)
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '-');
    };

    const getFormatAliases = (value = '') => {
      const normalized = normalizeFormatValue(value);
      const map = {
        cdrom: 'cd-rom',
        'cd-rom': 'cdrom',
        dvdrom: 'dvd-rom',
        'dvd-rom': 'dvdrom',
        gdrom: 'gd-rom',
        'gd-rom': 'gdrom',
        arcade_pcb: 'arcade-pcb',
        'arcade-pcb': 'arcade_pcb'
      };

      return [...new Set([normalized, map[normalized]].filter(Boolean))];
    };

    const getFilters = () => Object.fromEntries(
      controls.map((control) => [control.dataset.filter, control.value])
    );

    const getPageFromQuery = () => {
      const value = Number.parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10);

      return Number.isFinite(value) && value > 0 ? value : 1;
    };

    const buildPageUrl = (filters, pageNumber) => {
      const url = new URL(window.location.href);

      queryFilters.forEach((key) => {
        if (filters[key]) {
          url.searchParams.set(key, filters[key]);
        } else {
          url.searchParams.delete(key);
        }
      });

      if (pageNumber > 1) {
        url.searchParams.set('page', String(pageNumber));
      } else {
        url.searchParams.delete('page');
      }

      return `${url.pathname}${url.search}${url.hash}`;
    };

    const syncQueryString = (filters, pageNumber) => {
      window.history.replaceState({}, '', buildPageUrl(filters, pageNumber));
    };

    const getMatchingItems = (filters) => items.filter((item) =>
      (!filters.type || item.dataset.type === filters.type) &&
      includesToken(item.dataset.platforms, filters.platform) &&
      includesToken(item.dataset.categories, filters.category) &&
      includesToken(item.dataset.genres, filters.genre) &&
      includesToken(item.dataset.modes, filters.mode) &&
      (!filters.year || item.dataset.year === filters.year) &&
      includesToken(item.dataset.formats, filters.format) &&
      includesToken(item.dataset.product, filters.product)
    );

    const getReviewPageNumbers = (total, current) => {
      if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
      const pages = [...new Set([1, current - 1, current, current + 1, total])]
        .filter((page) => page >= 1 && page <= total)
        .sort((a, b) => a - b);
      const result = [];
      pages.forEach((page, index) => {
        const previous = pages[index - 1];
        if (page - previous === 2) result.push(previous + 1);
        else if (page - previous > 2) result.push(null);
        result.push(page);
      });
      return result;
    };

    const updatePagination = (filters, matchingItems) => {
      currentTotalPages = Math.max(1, Math.ceil(matchingItems.length / pageSize));
      currentPage = Math.min(Math.max(1, currentPage), currentTotalPages);

      if (!pagination) return;

      pagination.hidden = matchingItems.length <= pageSize;

      if (paginationNumbers) {
        paginationNumbers.replaceChildren();
        getReviewPageNumbers(currentTotalPages, currentPage).forEach((page) => {
          const item = document.createElement(page === null ? 'span' : 'a');
          item.textContent = page === null ? '…' : String(page);
          if (page === null) {
            item.className = 'reviews-pagination__ellipsis';
            item.setAttribute('aria-hidden', 'true');
          } else {
            item.className = 'reviews-pagination__number';
            item.href = buildPageUrl(filters, page);
            item.dataset.page = String(page);
            item.setAttribute('aria-label', `${pageStatusPrefix} ${page}`);
            if (page === currentPage) item.setAttribute('aria-current', 'page');
          }
          paginationNumbers.append(item);
        });
      }

      if (paginationStatus) {
        paginationStatus.textContent = `${pageStatusPrefix} ${currentPage} ${pageStatusSeparator} ${currentTotalPages}`;
      }

      if (paginationPrev) {
        paginationPrev.hidden = currentPage <= 1;
        (paginationPrev.querySelector('[data-pagination-label]') || paginationPrev).textContent = previousLabel;
        paginationPrev.href = buildPageUrl(filters, currentPage - 1);
      }

      if (paginationNext) {
        paginationNext.hidden = currentPage >= currentTotalPages;
        (paginationNext.querySelector('[data-pagination-label]') || paginationNext).textContent = nextLabel;
        paginationNext.href = buildPageUrl(filters, currentPage + 1);
      }
    };

    let appliedFilters = {};
    const applyFilters = ({ updateUrl = false, resetPage = false, keepApplied = false } = {}) => {
      const filters = keepApplied ? appliedFilters : getFilters();
      appliedFilters = { ...filters };
      const matchingItems = getMatchingItems(filters);

      if (resetPage) {
        currentPage = 1;
      }

      updatePagination(filters, matchingItems);

      const offset = (currentPage - 1) * pageSize;
      const pageItems = new Set(matchingItems.slice(offset, offset + pageSize));

      items.forEach((item) => {
        item.hidden = !pageItems.has(item);
      });

      counts.forEach((count) => { count.textContent = String(matchingItems.length); });
      if (empty) empty.hidden = matchingItems.length > 0;
      grid.hidden = matchingItems.length === 0;

      if (updateUrl) {
        syncQueryString(filters, currentPage);
      }
    };

    const initializeFromQuery = () => {
      const params = new URLSearchParams(window.location.search);

      controls.forEach((control) => {
        const key = control.dataset.filter;
        if (!queryFilters.has(key)) return;

        const rawValue = params.get(key);
        if (!rawValue) return;

        let value = key === 'format'
          ? normalizeFormatValue(rawValue)
          : rawValue;

        let hasOption = Array.from(control.options).some((option) => option.value === value);

        if (!hasOption && key === 'format') {
          const alias = getFormatAliases(value).find((item) =>
            Array.from(control.options).some((option) => option.value === item)
          );

          if (alias) {
            value = alias;
            hasOption = true;
          }
        }

        if (hasOption) {
          control.value = value;
        }
      });

      currentPage = getPageFromQuery();
    };

    submit?.addEventListener('click', () => {
      applyFilters({ updateUrl: true, resetPage: true });
    });

    controls.forEach((control) => {
      control.addEventListener('change', () => {
        if (root?.dataset.customFilters === 'ready') return;
        applyFilters({ updateUrl: true, resetPage: true });
      });
    });

    controls.forEach((control) => {
      control.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          applyFilters({ updateUrl: true, resetPage: true });
        }
      });
    });

    reset?.addEventListener('click', () => {
      controls.forEach((control) => {
        control.value = '';
      });

      applyFilters({ updateUrl: true, resetPage: true });
      root?.dispatchEvent(new Event('archive:filters-reset'));
    });

    paginationNumbers?.addEventListener('click', (event) => {
      const link = event.target.closest('a[data-page]');
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      currentPage = Number(link.dataset.page);
      applyFilters({ updateUrl: true, keepApplied: true });
      paginationNumbers.querySelector('[aria-current="page"]')?.focus({ preventScroll: true });
      grid.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });

    paginationPrev?.addEventListener('click', (event) => {
      if (currentPage <= 1) return;

      event.preventDefault();
      currentPage -= 1;
      applyFilters({ updateUrl: true, keepApplied: root?.dataset.customFilters === 'ready' });
      grid.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });

    paginationNext?.addEventListener('click', (event) => {
      if (currentPage >= currentTotalPages) return;

      event.preventDefault();
      currentPage += 1;
      applyFilters({ updateUrl: true, keepApplied: root?.dataset.customFilters === 'ready' });
      grid.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });

    initializeFromQuery();
    applyFilters({ updateUrl: true });
  }
</script>
