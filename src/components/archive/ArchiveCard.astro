---
import { urlFor } from '../../lib/image';
import { getPostUrl } from '../../lib/routes';
import { getReviewRibbonBadge } from '../../lib/reviewBadges';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const {
  post,
  lang = post?.language || 'it'
} = Astro.props;

const isEnglish = lang === 'en';

const getImage = (post, width = 520, height = 325) => {
  if (!post?.featuredImage?.asset) return '/placeholder-retro.png';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const getTypeLabel = (type = '') => {
  const map = isEnglish
    ? {
        review: 'Review',
        article: 'Article',
        guide: 'Guide',
        interview: 'Interview',
        news: 'News',
        feature: 'Feature',
        memories: 'Memories',
        hardware: 'Hardware'
      }
    : {
        review: 'Recensione',
        article: 'Articolo',
        guide: 'Guida',
        interview: 'Intervista',
        news: 'News',
        feature: 'Speciale',
        memories: 'Memories',
        hardware: 'Hardware'
      };

  return map[type] || type || (isEnglish ? 'Article' : 'Articolo');
};

const getCategory = (post) => {
  /*
    Le categorie arrivano da Sanity e per ora sono in italiano.
    Nelle pagine inglesi, se non abbiamo categorie tradotte,
    meglio usare la label del tipo contenuto.
  */
  if (isEnglish) return getTypeLabel(post?.type);

  return post?.categories?.[0]?.name || getTypeLabel(post?.type);
};

const cleanText = (value) =>
  value?.replace(/\[…\]/g, '').trim() || '';

const getExcerpt = (post) =>
  cleanText(post?.cardExcerpt) ||
  cleanText(post?.subtitle) ||
  cleanText(post?.excerpt);
  
const date = post?.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString(isEnglish ? 'en-US' : 'it-IT', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    })
  : '';

const score = post?.rating?.overall;
const reviewBadge = getReviewRibbonBadge(score, lang);
---

<a href={getPostUrl(post)} class="archive-card">

  <div class="archive-card__image">
    <img
      src={getImage(post, 520, 325)}
      alt={post.featuredImage?.alt || post.title}
      width="520"
      height="325"
      loading="lazy"
      decoding="async"
    />

    {reviewBadge && (
      <img
        src={reviewBadge.src}
        alt={reviewBadge.alt}
        class={`archive-card__badge review-ribbon-badge review-badge--card review-badge--${reviewBadge.key}`}
        width="1746"
        height="592"
        loading="lazy"
        decoding="async"
      />
    )}

    {score && (
      <div class="archive-card__score">
        {Number(score).toFixed(1)}
      </div>
    )}
  </div>

  <div class="archive-card__content">

    <div class="archive-card__meta">
      <span>{getCategory(post)}</span>

      {date && (
        <small>{date}</small>
      )}
    </div>

    <h2>{post.title}</h2>

    {getExcerpt(post) && (
      <p>{getExcerpt(post)}</p>
    )}

    <div class="archive-card__footer">
      <span>{getTypeLabel(post.type)}</span>

      <span class="archive-card__footer-meta">
        <CommentCountBadge count={post.commentCount} lang={lang} />

        {post.platforms?.[0]?.name && (
          <small>{post.platforms[0].name}</small>
        )}
      </span>
    </div>

  </div>

</a>
