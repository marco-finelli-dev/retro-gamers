---
const { rating, compact = false, lang = 'it' } = Astro.props;

const score = rating?.overall;
const formattedScore =
  score !== undefined && score !== null ? Number(score).toFixed(1) : '-';

const labels = {
  it: {
    fallbackScore: 'Voto',
    graphics: 'Grafica',
    sound: 'Sonoro',
    gameplay: 'Gameplay',
    longevity: 'Longevità'
  },
  en: {
    fallbackScore: 'Score',
    graphics: 'Graphics',
    sound: 'Sound',
    gameplay: 'Gameplay',
    longevity: 'Longevity'
  }
};

const t = labels[lang] || labels.it;

const label =
  Number(score) >= 9.5 ? 'Top' :
  Number(score) >= 9 ? 'Must' :
  Number(score) >= 8 ? 'Good' :
  t.fallbackScore;

const rows = [
  { label: t.graphics, value: rating?.grafica },
  { label: t.sound, value: rating?.sonoro },
  { label: t.gameplay, value: rating?.giocabilita },
  { label: t.longevity, value: rating?.longevita }
].filter((row) => row.value !== undefined && row.value !== null);
---

<div class={`review-score-box ${compact ? 'is-compact' : ''}`}>

  <div class="review-score-box__main">
    <span>{formattedScore}</span>
    <small>{label}</small>
  </div>

  {rows.length > 0 && (
    <div class="review-score-box__details">
      {rows.map((row) => (
        <div class="review-score-row">
          <span>{row.label}</span>
          <strong>{Number(row.value).toFixed(1)}</strong>
        </div>
      ))}
    </div>
  )}

</div>