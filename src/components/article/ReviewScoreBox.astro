---
import { formatReviewScore, getReviewRibbonBadge } from '../../lib/reviewBadges';

const { rating, compact = false, lang = 'it' } = Astro.props;

const score = rating?.overall;
const numericScore = Number(score);
const formattedScore = formatReviewScore(score);

const labels = {
  it: {
    graphics: 'Grafica',
    sound: 'Sonoro',
    gameplay: 'Gameplay',
    longevity: 'Longevità'
  },
  en: {
    graphics: 'Graphics',
    sound: 'Sound',
    gameplay: 'Gameplay',
    longevity: 'Longevity'
  }
};

const t = labels[lang] || labels.it;
const reviewBadge = getReviewRibbonBadge(numericScore, lang);

const rows = [
  { label: t.graphics, value: rating?.grafica },
  { label: t.sound, value: rating?.sonoro },
  { label: t.gameplay, value: rating?.giocabilita },
  { label: t.longevity, value: rating?.longevita }
].filter((row) => row.value !== undefined && row.value !== null);
---

<div class={`review-score-box ${compact ? 'is-compact' : ''}`}>

  <div class={`review-score-box__main ${reviewBadge ? 'has-review-badge' : ''}`}>
    {reviewBadge && (
      <img
        src={reviewBadge.src}
        alt={reviewBadge.alt}
        class={`review-badge review-badge--sidebar review-badge--${reviewBadge.key}`}
        width="240"
        height="81"
        loading="lazy"
        decoding="async"
      />
    )}

    <span>{formattedScore}</span>
  </div>

  {rows.length > 0 && (
    <div class="review-score-box__details">
      {rows.map((row) => (
        <div class="review-score-row">
          <span>{row.label}</span>
          <strong>{Number(row.value).toFixed(1)}</strong>
        </div>
      ))}
    </div>
  )}

</div>
