---
import { getPostUrl, getArchiveUrl, getPlatformUrl, getCategoryUrl } from '../../lib/routes';
import { urlFor } from '../../lib/image';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const {
  post,
  relatedPosts = []
} = Astro.props;

const lang = post?.language || 'it';

const typeLabels = {
  it: {
    review: 'Recensione',
    news: 'News',
    feature: 'Speciale',
    guide: 'Guida',
    memories: 'Memories',
    interview: 'Intervista',
    hardware: 'Hardware',
    article: 'Articolo'
  },
  en: {
    review: 'Review',
    news: 'News',
    feature: 'Feature',
    guide: 'Guide',
    memories: 'Memories',
    interview: 'Interview',
    hardware: 'Hardware',
    article: 'Article'
  }
};

const ui = {
  it: {
    related: 'Articoli correlati',
    creators: 'Creatori collegati',
    explore: 'Esplora',
    archiveFallback: 'Esplora archivio',
    archiveLabels: {
      news: 'Tutte le news',
      feature: 'Tutti gli speciali',
      guide: 'Tutte le guide',
      memories: 'Tutte le memories',
      hardware: 'Tutto l’hardware',
      article: 'Tutti gli articoli',
      interview: 'Tutte le interviste'
    }
  },
  en: {
    related: 'Related articles',
    creators: 'Related creators',
    explore: 'Explore',
    archiveFallback: 'Explore archive',
    archiveLabels: {
      news: 'All news',
      feature: 'All features',
      guide: 'All guides',
      memories: 'All memories',
      hardware: 'All hardware',
      article: 'All articles',
      interview: 'All interviews'
    }
  }
};

const t = ui[lang] || ui.it;

const getTaxonomyName = (item) => {
  if (!item) return '';

  if (lang === 'en') {
    return item.nameEn || item.name || '';
  }

  return item.name || item.nameEn || '';
};

const archiveLink = {
  label: t.archiveLabels[post.type] || t.archiveFallback,
  href: getArchiveUrl(post.type, lang)
};

const sidebarRelated = relatedPosts
  .filter((item) => item?._id !== post?._id)
  .slice(0, 5);

const creators = Array.isArray(post.creators)
  ? post.creators.filter((creator) => creator?.name && creator?.slug)
  : [];

const sidebarTags = [
  ...(post.platforms || []).map((item) => ({
    label: getTaxonomyName(item),
    href: getPlatformUrl(item, lang)
  })),

  ...(post.categories || []).map((item) => ({
    label: getTaxonomyName(item),
    href: getCategoryUrl(item, lang)
  }))
]
  .filter((item) => item.label && item.href)
  .slice(0, 6);

const getMainImage = (post) => {
  const source =
    post.featuredImage?.asset
      ? post.featuredImage
      : post.gameInfo?.cover?.asset
        ? post.gameInfo.cover
        : null;

  if (!source) return '';

  return urlFor(source)
    .width(520)
    .height(390)
    .fit('crop')
    .quality(74)
    .auto('format')
    .url();
};

const getRelatedImage = (item) => {
  const source =
    item.featuredImage?.asset
      ? item.featuredImage
      : item.gameInfo?.cover?.asset
        ? item.gameInfo.cover
        : null;

  if (!source) return '/placeholder-retro.png';

  return urlFor(source)
    .width(180)
    .height(120)
    .fit('crop')
    .quality(70)
    .auto('format')
    .url();
};

const getCreatorUrl = (creator) =>
  lang === 'en'
    ? `/en/creators/${creator.slug}/`
    : `/creatori/${creator.slug}/`;

const getCreatorRole = (creator) =>
  lang === 'en'
    ? creator.roleEn || creator.role || ''
    : creator.role || creator.roleEn || '';

const getCreatorImage = (creator) => {
  if (!creator?.portrait?.asset) return '';

  return urlFor(creator.portrait)
    .width(96)
    .height(96)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const getCreatorInitials = (name = '') =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();

const image = getMainImage(post);

const getTypeLabel = (item) =>
  typeLabels[lang]?.[item.type] ||
  typeLabels.it[item.type] ||
  'Article';
---

<div class="article-sidebar">

  {image && (
    <figure class="article-sidebar__image">
      <img
        src={image}
        alt={post.featuredImage?.alt || post.gameInfo?.cover?.alt || post.title || ''}
        width="520"
        height="390"
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}

  <div class="article-sidebar__sticky">

    {creators.length > 0 && (
      <section class="article-sidebar__panel article-sidebar__panel--creators">
        <h2>{t.creators}</h2>

        <div class="article-sidebar-creators">
          {creators.map((creator) => {
            const portrait = getCreatorImage(creator);
            const role = getCreatorRole(creator);

            return (
              <a href={getCreatorUrl(creator)} class="article-sidebar-creator">
                <span class="article-sidebar-creator__portrait">
                  {portrait ? (
                    <img
                      src={portrait}
                      alt={creator.portrait?.alt || creator.name}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span>{getCreatorInitials(creator.name) || 'RG'}</span>
                  )}
                </span>

                <span class="article-sidebar-creator__body">
                  <strong>{creator.name}</strong>
                  {role && <small>{role}</small>}
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {sidebarRelated.length > 0 && (
      <section class="article-sidebar__panel article-sidebar__panel--related">
        <h2>{t.related}</h2>

        <div class="article-sidebar-related">
          {sidebarRelated.map((item) => (
            <a href={getPostUrl(item)} class="article-sidebar-related__card">

              <span class="article-sidebar-related__image">
                <img
                  src={getRelatedImage(item)}
                  alt={item.featuredImage?.alt || item.gameInfo?.cover?.alt || item.title}
                  width="180"
                  height="120"
                  loading="lazy"
                  decoding="async"
                />
              </span>

              <span class="article-sidebar-related__content">
                <small>{getTypeLabel(item)}</small>
                <strong>{item.title}</strong>
                <CommentCountBadge count={item.commentCount} lang={lang} />
              </span>

            </a>
          ))}
        </div>
      </section>
    )}

    <section class="article-sidebar__panel article-sidebar__panel--explore">
      <h2>{t.explore}</h2>

      <div class="article-sidebar-explore">
        <a href={archiveLink.href}>
          {archiveLink.label}
        </a>

        {sidebarTags.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))}
      </div>
    </section>

  </div>

</div>
