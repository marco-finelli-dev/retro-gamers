---
import { getPostUrl } from '../../lib/routes';
import { urlFor } from '../../lib/image';

const {
  post,
  relatedPosts = []
} = Astro.props;

const typeLabels = {
  review: 'Recensione',
  news: 'News',
  feature: 'Speciale',
  guide: 'Guida',
  memories: 'Memories',
  interview: 'Intervista',
  hardware: 'Hardware',
  article: 'Articolo'
};

const archiveLinks = {
  news: {
    label: 'Tutte le news',
    href: '/news/'
  },
  feature: {
    label: 'Tutti gli speciali',
    href: '/speciali/'
  },
  guide: {
    label: 'Tutte le guide',
    href: '/guide/'
  },
  memories: {
    label: 'Tutte le memories',
    href: '/memories/'
  },
  hardware: {
    label: 'Tutto l’hardware',
    href: '/hardware/'
  },
  article: {
    label: 'Tutti gli articoli',
    href: '/articoli/'
  },
  interview: {
    label: 'Tutte le interviste',
    href: '/interviste/'
  }
};

const archiveLink =
  archiveLinks[post.type] ||
  {
    label: 'Esplora archivio',
    href: '/articoli/'
  };

const sidebarRelated = relatedPosts
  .filter((item) => item?._id !== post?._id)
  .slice(0, 5);

const sidebarTags = [
  ...(post.platforms || []),
  ...(post.categories || []),
  ...(post.genres || []),
  ...(post.developers || [])
]
  .filter((item) => item?.name)
  .slice(0, 6);

const getMainImage = (post) => {
  const source =
    post.featuredImage?.asset
      ? post.featuredImage
      : post.gameInfo?.cover?.asset
        ? post.gameInfo.cover
        : null;

  if (!source) return '';

  return urlFor(source)
    .width(520)
    .height(390)
    .fit('crop')
    .quality(74)
    .auto('format')
    .url();
};

const getRelatedImage = (item) => {
  const source =
    item.featuredImage?.asset
      ? item.featuredImage
      : item.gameInfo?.cover?.asset
        ? item.gameInfo.cover
        : null;

  if (!source) return '/placeholder-retro.png';

  return urlFor(source)
    .width(180)
    .height(120)
    .fit('crop')
    .quality(70)
    .auto('format')
    .url();
};

const image = getMainImage(post);

const getTypeLabel = (item) =>
  typeLabels[item.type] || 'Articolo';
---

<div class="article-sidebar">

  {image && (
    <figure class="article-sidebar__image">
      <img
        src={image}
        alt={post.featuredImage?.alt || post.gameInfo?.cover?.alt || post.title || ''}
        width="520"
        height="390"
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}

  <div class="article-sidebar__sticky">

    {sidebarRelated.length > 0 && (
      <section class="article-sidebar__panel article-sidebar__panel--related">
        <h2>Articoli correlati</h2>

        <div class="article-sidebar-related">
          {sidebarRelated.map((item) => (
            <a href={getPostUrl(item)} class="article-sidebar-related__card">

              <span class="article-sidebar-related__image">
                <img
                  src={getRelatedImage(item)}
                  alt={item.featuredImage?.alt || item.gameInfo?.cover?.alt || item.title}
                  width="180"
                  height="120"
                  loading="lazy"
                  decoding="async"
                />
              </span>

              <span class="article-sidebar-related__content">
                <small>{getTypeLabel(item)}</small>
                <strong>{item.title}</strong>
              </span>

            </a>
          ))}
        </div>
      </section>
    )}

    <section class="article-sidebar__panel article-sidebar__panel--explore">
      <h2>Esplora</h2>

      <div class="article-sidebar-explore">
        <a href={archiveLink.href}>
          {archiveLink.label}
        </a>

        {sidebarTags.map((item) => (
          <span>{item.name}</span>
        ))}
      </div>
    </section>

  </div>

</div>