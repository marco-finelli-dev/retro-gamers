---
import { getArchiveUrl } from '../../lib/routes';
import ArticleShare from './ArticleShare.astro';

const { post } = Astro.props;

const lang = post?.language || 'it';

const typeLabels = {
  it: {
    review: 'Recensione',
    news: 'News',
    feature: 'Speciale',
    guide: 'Guida',
    memories: 'Memories',
    interview: 'Intervista',
    hardware: 'Hardware',
    article: 'Articolo'
  },
  en: {
    review: 'Review',
    news: 'News',
    feature: 'Feature',
    guide: 'Guide',
    memories: 'Memories',
    interview: 'Interview',
    hardware: 'Hardware',
    article: 'Article'
  }
};

const typeLabel =
  typeLabels[lang]?.[post.type] ||
  typeLabels.it[post.type] ||
  'Articolo';

const byLabel = lang === 'en' ? 'By' : 'Di';
const readingTimeLabel = lang === 'en' ? 'Reading time' : 'Tempo di lettura';
const minuteLabel = lang === 'en' ? 'min.' : 'min.';

const isReview = post.type === 'review';

const platforms =
  isReview
    ? post.platforms?.map((platform) => {
        const manufacturer = platform.manufacturer?.name || '';
        const name = platform.name || '';

        return [manufacturer, name].filter(Boolean).join(' ');
      }).filter(Boolean) || []
    : [];

const developer =
  isReview
    ? post.developers?.[0]?.name ||
      post.publishers?.[0]?.name ||
      ''
    : '';

const year =
  isReview
    ? post.gameInfo?.releaseYear || ''
    : '';

const metaItems = [
  developer,
  ...platforms,
  year
].filter(Boolean);

const publishedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'it-IT', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    })
  : '';

const authorDisplayName =
  post.author?.displayName === 'nickname' && post.author?.nickname
    ? post.author.nickname
    : post.author?.name || '';

const authorUrl = post.author?.slug
  ? `/autori/${post.author.slug}/`
  : '';

const readingTime =
  post.readingTime ||
  post.readingTimeMinutes ||
  post.tempoLettura ||
  null;

const infoItems = [
  publishedDate,
  readingTime ? `${readingTimeLabel}: ${readingTime} ${minuteLabel}` : '',
].filter(Boolean);
---

<section class="article-hero">

  <div class="article-hero__top">

    <a href={getArchiveUrl(post.type, lang)} class="article-hero__eyebrow">
      {typeLabel}
    </a>

    {metaItems.length > 0 && (
      <div class="article-hero__meta">
        {metaItems.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    )}

  </div>

  <div class="article-hero__content">

    <h1>{post.title}</h1>

    {(post.subtitle || post.excerpt) && (
      <p>{post.subtitle || post.excerpt}</p>
    )}

    <div class="article-hero__footer">

      {(authorDisplayName || infoItems.length > 0) && (
        <div class="article-hero__info">

          {authorDisplayName && (
            authorUrl ? (
              <a href={authorUrl}>
                {byLabel} {authorDisplayName}
              </a>
            ) : (
              <span>
                {byLabel} {authorDisplayName}
              </span>
            )
          )}

          {infoItems.map((item) => (
            <span>{item}</span>
          ))}

        </div>
      )}

      <ArticleShare post={post} compact />

    </div>

  </div>

</section>