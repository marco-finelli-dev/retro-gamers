---
import { getArchiveUrl, getPostUrl } from '../../lib/routes';
import ArticleShare from './ArticleShare.astro';
import ArticleSaveButton from './ArticleSaveButton.astro';

const { post, editorialQuickEdit = null } = Astro.props;

const lang = post?.language || 'it';

const typeLabels = {
  it: {
    review: 'Recensione',
    news: 'News',
    feature: 'Speciale',
    guide: 'Guida',
    memories: 'Memories',
    interview: 'Intervista',
    hardware: 'Hardware',
    article: 'Articolo'
  },
  en: {
    review: 'Review',
    news: 'News',
    feature: 'Feature',
    guide: 'Guide',
    memories: 'Memories',
    interview: 'Interview',
    hardware: 'Hardware',
    article: 'Article'
  }
};

const typeLabel =
  typeLabels[lang]?.[post.type] ||
  typeLabels.it[post.type] ||
  'Articolo';

const byLabel = lang === 'en' ? 'By' : 'A cura di';
const roleLabels = {
  it: {
    editor: 'Redattore',
    contributor: 'Collaboratore',
    guest: 'Ospite'
  },
  en: {
    editor: 'Editor',
    contributor: 'Contributor',
    guest: 'Guest'
  }
};

const isReview = post.type === 'review';
const overallRating = Number(post?.rating?.overall);
const isEditorsChoice =
  isReview && Number.isFinite(overallRating) && overallRating >= 9;
const editorChoiceAlt = lang === 'en' ? "Editor's Choice" : 'Scelta della redazione';

const platforms =
  isReview
    ? post.platforms?.map((platform) => platform.name || '').filter(Boolean) || []
    : [];

const developer =
  isReview
    ? post.developers?.[0]?.name ||
      post.publishers?.[0]?.name ||
      ''
    : '';

const year =
  isReview
    ? post.gameInfo?.releaseYear || ''
    : '';

const metaItems = [
  developer,
  ...platforms,
  year
]
  .filter(Boolean)
  .filter((item, index, items) => items.indexOf(item) === index);

const dateLocale = lang === 'en' ? 'en-US' : 'it-IT';

const formatDate = (date?: string) =>
  date
    ? new Date(date).toLocaleDateString(dateLocale, {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      })
    : '';

const publishedDate = formatDate(post.publishedAt);
const updatedDate = formatDate(post.lastUpdated);

const showUpdated =
  post.lastUpdated &&
  (!post.publishedAt ||
    new Date(post.lastUpdated).toDateString() !==
      new Date(post.publishedAt).toDateString());

const updatedLabel = lang === 'en' ? 'Updated on' : 'Aggiornato il';

const authorDisplayName =
  post.author?.displayName === 'nickname' && post.author?.nickname
    ? post.author.nickname
    : post.author?.name || '';

const authorSlug =
  typeof post.author?.slug === 'string'
    ? post.author.slug
    : post.author?.slug?.current;

const authorUrl = authorSlug
  ? lang === 'en'
    ? `/en/authors/${authorSlug}/`
    : `/autori/${authorSlug}/`
  : '';

const authorRole =
  post.author?.role
    ? roleLabels[lang]?.[post.author.role] || roleLabels.it[post.author.role]
    : '';

const authorAvatar = post.author?.image?.asset?.url || '';
const authorAvatarAlt = post.author?.image?.alt || authorDisplayName;
const authorInitials = authorDisplayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();

const readingTime =
  post.readingTime ||
  post.readingTimeMinutes ||
  post.tempoLettura ||
  null;

const mastheadInfoItems = [
  publishedDate,
  showUpdated && updatedDate ? `${updatedLabel} ${updatedDate}` : '',
].filter(Boolean);
const heroInfoItems = [authorRole, ...mastheadInfoItems].filter(Boolean);

const articleSlug =
  typeof post.slug === 'string'
    ? post.slug
    : post.slug?.current || '';

const articleUrl = getPostUrl({
  ...post,
  slug: articleSlug,
});

const articleId =
  String(post._id || post.id || `${lang}:${post.type || 'article'}:${articleSlug}`)
    .replace(/^drafts\./, '');

const quickEditLabels = {
  edit: lang === 'en' ? 'Edit article' : 'Modifica articolo',
  adopt: lang === 'en' ? 'Open in new editor' : 'Apri nel nuovo editor',
  loading: lang === 'en' ? 'Opening editor…' : 'Apertura editor…',
  error: lang === 'en'
    ? 'The article editor could not be opened.'
    : 'Non è stato possibile aprire l’editor articolo.',
};
---

<section class="article-hero">

  <div class="article-hero__top">

    <div class="article-hero__top-main">
      <a href={getArchiveUrl(post.type, lang)} class="article-hero__eyebrow rg-meta-primary">
        {typeLabel}
      </a>

    </div>

  </div>

  <div class:list={[
    'article-hero__content',
    { 'article-hero__content--with-editor-choice': isEditorsChoice }
  ]}>

    <h1>{post.title}</h1>

    {isEditorsChoice && (
      <span class="article-hero__editor-choice">
        <img
          src="/images/badges/editor-choice-ivory.svg"
          alt={editorChoiceAlt}
          class="article-hero__editor-choice-asset article-hero__editor-choice-asset--light"
          width="850"
          height="639"
          decoding="async"
        />
        <img
          src="/images/badges/editor-choice-navy.svg"
          alt={editorChoiceAlt}
          class="article-hero__editor-choice-asset article-hero__editor-choice-asset--dark"
          width="850"
          height="639"
          decoding="async"
        />
      </span>
    )}

    {(post.subtitle || post.excerpt) && (
      <p>{post.subtitle || post.excerpt}</p>
    )}

  </div>

</section>

<script>
  const initArticleEditorialQuickEdit = () => {
    document
      .querySelectorAll('[data-article-editorial-quick-edit]:not([data-article-editorial-quick-edit-ready])')
      .forEach((root) => {
        if (!(root instanceof HTMLElement)) return;

        root.dataset.articleEditorialQuickEditReady = 'true';

        const button = root.querySelector('[data-article-editorial-quick-edit-button]');
        const message = root.querySelector('[data-article-editorial-quick-edit-message]');

        if (!(button instanceof HTMLButtonElement)) return;

        const defaultLabel = button.dataset.labelDefault || button.textContent || '';
        const loadingLabel = button.dataset.labelLoading || defaultLabel;
        const errorLabel = button.dataset.labelError || '';

        const showMessage = (text) => {
          if (!(message instanceof HTMLElement)) return;

          message.textContent = text;
          message.hidden = !text;
        };

        button.addEventListener('click', async () => {
          const endpoint = button.dataset.endpoint || '';

          if (!endpoint || button.disabled) return;

          button.disabled = true;
          button.textContent = loadingLabel;
          showMessage('');

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
              },
              body: JSON.stringify({
                uiLanguage: button.dataset.uiLanguage === 'en' ? 'en' : 'it',
              }),
            });
            const result = await response.json().catch(() => null);
            const editUrl = typeof result?.editUrl === 'string' && result.editUrl.trim()
              ? result.editUrl.trim()
              : button.dataset.fallbackEditUrl || '';

            if (
              !response.ok &&
              result?.error === 'revision_draft_exists' &&
              button.dataset.fallbackEditUrl
            ) {
              window.location.assign(button.dataset.fallbackEditUrl);
              return;
            }

            if (!response.ok || !result?.ok || !editUrl) {
              throw new Error(result?.error || 'quick_edit_failed');
            }

            window.location.assign(editUrl);
          } catch {
            button.disabled = false;
            button.textContent = defaultLabel;
            showMessage(errorLabel);
          }
        });
      });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleEditorialQuickEdit, { once: true });
  } else {
    initArticleEditorialQuickEdit();
  }
</script>
