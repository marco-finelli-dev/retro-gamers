---
import { getArchiveUrl, getPostUrl } from '../../lib/routes';
import ArticleShare from './ArticleShare.astro';
import ArticleSaveButton from './ArticleSaveButton.astro';

const { post, editorialQuickEdit = null } = Astro.props;

const lang = post?.language || 'it';

const typeLabels = {
  it: {
    review: 'Recensione',
    news: 'News',
    feature: 'Speciale',
    guide: 'Guida',
    memories: 'Memories',
    interview: 'Intervista',
    hardware: 'Hardware',
    article: 'Articolo'
  },
  en: {
    review: 'Review',
    news: 'News',
    feature: 'Feature',
    guide: 'Guide',
    memories: 'Memories',
    interview: 'Interview',
    hardware: 'Hardware',
    article: 'Article'
  }
};

const typeLabel =
  typeLabels[lang]?.[post.type] ||
  typeLabels.it[post.type] ||
  'Articolo';

const byLabel = lang === 'en' ? 'By' : 'A cura di';
const readingTimeLabel = lang === 'en' ? 'Reading time' : 'Tempo di lettura';
const minuteLabel = lang === 'en' ? 'min.' : 'min.';
const roleLabels = {
  it: {
    editor: 'Redattore',
    contributor: 'Collaboratore',
    guest: 'Ospite'
  },
  en: {
    editor: 'Editor',
    contributor: 'Contributor',
    guest: 'Guest'
  }
};

const isReview = post.type === 'review';

const platforms =
  isReview
    ? post.platforms?.map((platform) => platform.name || '').filter(Boolean) || []
    : [];

const developer =
  isReview
    ? post.developers?.[0]?.name ||
      post.publishers?.[0]?.name ||
      ''
    : '';

const year =
  isReview
    ? post.gameInfo?.releaseYear || ''
    : '';

const metaItems = [
  developer,
  ...platforms,
  year
]
  .filter(Boolean)
  .filter((item, index, items) => items.indexOf(item) === index);

const dateLocale = lang === 'en' ? 'en-US' : 'it-IT';

const formatDate = (date?: string) =>
  date
    ? new Date(date).toLocaleDateString(dateLocale, {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      })
    : '';

const publishedDate = formatDate(post.publishedAt);
const updatedDate = formatDate(post.lastUpdated);

const showUpdated =
  post.lastUpdated &&
  (!post.publishedAt ||
    new Date(post.lastUpdated).toDateString() !==
      new Date(post.publishedAt).toDateString());

const updatedLabel = lang === 'en' ? 'Updated on' : 'Aggiornato il';

const authorDisplayName =
  post.author?.displayName === 'nickname' && post.author?.nickname
    ? post.author.nickname
    : post.author?.name || '';

const authorSlug =
  typeof post.author?.slug === 'string'
    ? post.author.slug
    : post.author?.slug?.current;

const authorUrl = authorSlug
  ? lang === 'en'
    ? `/en/authors/${authorSlug}/`
    : `/autori/${authorSlug}/`
  : '';

const authorRole =
  post.author?.role
    ? roleLabels[lang]?.[post.author.role] || roleLabels.it[post.author.role]
    : '';

const authorAvatar = post.author?.image?.asset?.url || '';
const authorAvatarAlt = post.author?.image?.alt || authorDisplayName;
const authorInitials = authorDisplayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();

const readingTime =
  post.readingTime ||
  post.readingTimeMinutes ||
  post.tempoLettura ||
  null;

const infoItems = [
  publishedDate,
  showUpdated && updatedDate ? `${updatedLabel} ${updatedDate}` : '',
  readingTime ? `${readingTimeLabel}: ${readingTime} ${minuteLabel}` : '',
].filter(Boolean);
const heroInfoItems = [authorRole, ...infoItems].filter(Boolean);

const articleSlug =
  typeof post.slug === 'string'
    ? post.slug
    : post.slug?.current || '';

const articleUrl = getPostUrl({
  ...post,
  slug: articleSlug,
});

const articleId =
  String(post._id || post.id || `${lang}:${post.type || 'article'}:${articleSlug}`)
    .replace(/^drafts\./, '');

const quickEditLabels = {
  edit: lang === 'en' ? 'Edit article' : 'Modifica articolo',
  adopt: lang === 'en' ? 'Open in new editor' : 'Apri nel nuovo editor',
  loading: lang === 'en' ? 'Opening editor…' : 'Apertura editor…',
  error: lang === 'en'
    ? 'The article editor could not be opened.'
    : 'Non è stato possibile aprire l’editor articolo.',
};
---

<section class="article-hero">

  <div class="article-hero__top">

    <div class="article-hero__top-main">
      <a href={getArchiveUrl(post.type, lang)} class="article-hero__eyebrow">
        {typeLabel}
      </a>

      {metaItems.length > 0 && (
        <div class="article-hero__meta">
          {metaItems.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      )}
    </div>

  </div>

  <div class="article-hero__content">

    <h1>{post.title}</h1>

    {(post.subtitle || post.excerpt) && (
      <p>{post.subtitle || post.excerpt}</p>
    )}

    <div class="article-hero__footer">

      {(authorDisplayName || infoItems.length > 0) && (
        <div class="article-hero__byline">

          {authorDisplayName && (
            <div class="article-hero__author">
              {authorUrl ? (
                <a href={authorUrl} class="article-hero__author-avatar" aria-label={authorDisplayName}>
                  {authorAvatar ? (
                    <img
                      src={authorAvatar}
                      alt={authorAvatarAlt}
                      width="56"
                      height="56"
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <span>{authorInitials || 'RG'}</span>
                  )}
                </a>
              ) : (
                <span class="article-hero__author-avatar" aria-hidden={!authorAvatar}>
                  {authorAvatar ? (
                    <img
                      src={authorAvatar}
                      alt={authorAvatarAlt}
                      width="56"
                      height="56"
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <span>{authorInitials || 'RG'}</span>
                  )}
                </span>
              )}

              <div class="article-hero__author-body">
                <div class="article-hero__author-line">
                  <small>{byLabel}</small>

                  {authorUrl ? (
                    <a href={authorUrl} class="article-hero__author-name">
                      {authorDisplayName}
                    </a>
                  ) : (
                    <strong class="article-hero__author-name">
                      {authorDisplayName}
                    </strong>
                  )}
                </div>

                {heroInfoItems.length > 0 && (
                  <div class="article-hero__info">
                    {heroInfoItems.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                )}

              </div>
            </div>
          )}

          {!authorDisplayName && infoItems.length > 0 && (
            <div class="article-hero__meta-stack">
              {infoItems.length > 0 && (
                <div class="article-hero__info">
                  {infoItems.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              )}

            </div>
          )}

        </div>
      )}

      <div class="article-hero__actions">
        {editorialQuickEdit?.mode === 'edit' && editorialQuickEdit.editUrl && (
          <div class="article-save article-hero__editor-action">
            <a
              class="article-save__button article-editorial-edit"
              href={editorialQuickEdit.editUrl}
              rel="nofollow"
              aria-label={quickEditLabels.edit}
              title={quickEditLabels.edit}
            >
              {quickEditLabels.edit}
            </a>
          </div>
        )}

        {editorialQuickEdit?.mode === 'create_revision' && editorialQuickEdit.revisionEndpoint && (
          <div class="article-save article-hero__editor-action" data-article-editorial-quick-edit>
            <button
              class="article-save__button article-editorial-edit"
              type="button"
              data-article-editorial-quick-edit-button
              data-endpoint={editorialQuickEdit.revisionEndpoint}
              data-ui-language={lang}
              data-fallback-edit-url={editorialQuickEdit.editUrl}
              data-label-default={quickEditLabels.edit}
              data-label-loading={quickEditLabels.loading}
              data-label-error={quickEditLabels.error}
              aria-label={quickEditLabels.edit}
              title={quickEditLabels.edit}
            >
              {quickEditLabels.edit}
            </button>
            <p class="article-save__message article-editorial-edit__message" data-article-editorial-quick-edit-message hidden></p>
          </div>
        )}

        {editorialQuickEdit?.mode === 'adopt' && editorialQuickEdit.adoptEndpoint && (
          <div class="article-save article-hero__editor-action" data-article-editorial-quick-edit>
            <button
              class="article-save__button article-editorial-edit"
              type="button"
              data-article-editorial-quick-edit-button
              data-endpoint={editorialQuickEdit.adoptEndpoint}
              data-ui-language={lang}
              data-fallback-edit-url={editorialQuickEdit.editUrl}
              data-label-default={quickEditLabels.adopt}
              data-label-loading={quickEditLabels.loading}
              data-label-error={quickEditLabels.error}
              aria-label={quickEditLabels.adopt}
              title={quickEditLabels.adopt}
            >
              {quickEditLabels.adopt}
            </button>
            <p class="article-save__message article-editorial-edit__message" data-article-editorial-quick-edit-message hidden></p>
          </div>
        )}

        <div class="article-hero__save-action">
          <ArticleSaveButton
            articleId={articleId}
            articleSlug={articleSlug}
            articleTitle={post.title}
            articleLanguage={lang}
            articleCategory={typeLabel}
            articleUrl={articleUrl}
          />
        </div>

        <ArticleShare post={post} compact />
      </div>

    </div>

  </div>

</section>

<script>
  const initArticleEditorialQuickEdit = () => {
    document
      .querySelectorAll('[data-article-editorial-quick-edit]:not([data-article-editorial-quick-edit-ready])')
      .forEach((root) => {
        if (!(root instanceof HTMLElement)) return;

        root.dataset.articleEditorialQuickEditReady = 'true';

        const button = root.querySelector('[data-article-editorial-quick-edit-button]');
        const message = root.querySelector('[data-article-editorial-quick-edit-message]');

        if (!(button instanceof HTMLButtonElement)) return;

        const defaultLabel = button.dataset.labelDefault || button.textContent || '';
        const loadingLabel = button.dataset.labelLoading || defaultLabel;
        const errorLabel = button.dataset.labelError || '';

        const showMessage = (text) => {
          if (!(message instanceof HTMLElement)) return;

          message.textContent = text;
          message.hidden = !text;
        };

        button.addEventListener('click', async () => {
          const endpoint = button.dataset.endpoint || '';

          if (!endpoint || button.disabled) return;

          button.disabled = true;
          button.textContent = loadingLabel;
          showMessage('');

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
              },
              body: JSON.stringify({
                uiLanguage: button.dataset.uiLanguage === 'en' ? 'en' : 'it',
              }),
            });
            const result = await response.json().catch(() => null);
            const editUrl = typeof result?.editUrl === 'string' && result.editUrl.trim()
              ? result.editUrl.trim()
              : button.dataset.fallbackEditUrl || '';

            if (
              !response.ok &&
              result?.error === 'revision_draft_exists' &&
              button.dataset.fallbackEditUrl
            ) {
              window.location.assign(button.dataset.fallbackEditUrl);
              return;
            }

            if (!response.ok || !result?.ok || !editUrl) {
              throw new Error(result?.error || 'quick_edit_failed');
            }

            window.location.assign(editUrl);
          } catch {
            button.disabled = false;
            button.textContent = defaultLabel;
            showMessage(errorLabel);
          }
        });
      });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleEditorialQuickEdit, { once: true });
  } else {
    initArticleEditorialQuickEdit();
  }
</script>
