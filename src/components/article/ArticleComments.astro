---
const { post, comments = [] } = Astro.props;

const lang = post?.language === 'en' ? 'en' : 'it';

const rawSlug =
  typeof post?.slug === 'string'
    ? post.slug
    : post?.slug?.current || Astro.url.pathname.split('/').filter(Boolean).pop() || '';

const articleSlug = rawSlug;
const articleTitle = post?.title || '';
const articleUrl = Astro.url.pathname;
const accountLoginHref = lang === 'en' ? '/en/account/login/' : '/account/login/';
const registerHref = lang === 'en' ? '/en/account/register/' : '/account/register/';
const loginHref = `${accountLoginHref}?returnTo=${encodeURIComponent(`${articleUrl}#comments`)}`;

const labels = {
  it: {
    title: 'Memorie dei lettori',
    countSingular: 'memoria',
    countPlural: 'memorie',
    intro:
      'Commenti, ricordi e punti di vista restano qui, accanto all’articolo.',
    comment: 'Commento',
    submit: 'Invia commento',
    moderation:
      'I commenti vengono moderati prima della pubblicazione. Usa un tono civile e resta in tema con l’articolo.',
    rulesLink: 'Regolamento commenti',
    empty:
      'Sii il primo a lasciare un ricordo su questo articolo.',
    loading: 'Caricamento commenti...',
    leaveComment: 'Lascia un commento',
    reply: 'Rispondi',
    replyTo: 'Risposta a',
    cancelReply: 'Annulla risposta',
    loginRequired: 'Accedi o registrati per lasciare un commento.',
    loginLink: 'Accedi',
    registerLink: 'Registrati',
    loggedAs: 'Stai commentando come',
    notifyReplies: 'Avvisami se qualcuno risponde al mio commento',
    notifyThread: 'Avvisami se continua la discussione',
    sent: 'Commento inviato. Sarà visibile dopo la moderazione.',
    error: 'Qualcosa è andato storto. Riprova.',
    reader: 'Lettore',
    legacyBadge: 'Archivio',
    like: 'Mi piace',
    dislike: 'Non mi piace',
    loginToReact: 'Accedi o registrati per votare un commento.',
    ownReactionError: 'Non puoi votare un tuo commento.',
    reactionExpired: 'Non puoi più modificare questa reazione.',
    reactionError: 'Non è stato possibile aggiornare il voto. Riprova.',
    report: 'Segnala',
    reportReason: 'Motivo della segnalazione (opzionale)',
    reportPlaceholder: 'Aggiungi un contesto utile per la redazione.',
    reportSubmit: 'Invia segnalazione',
    reportCancel: 'Annulla',
    reportSuccess: 'Segnalazione inviata. Grazie, la controlleremo.',
    reportDuplicate: 'Hai già segnalato questo commento.',
    reportError: 'Non è stato possibile inviare la segnalazione. Riprova.',
    sortLabel: 'Ordina',
    sortOldest: 'Meno recenti',
    sortNewest: 'Più recenti',
    sortLiked: 'Più apprezzati'
  },
  en: {
    title: 'Reader memories',
    countSingular: 'memory',
    countPlural: 'memories',
    intro:
      'Comments, memories and points of view stay here, beside the article.',
    comment: 'Comment',
    submit: 'Submit comment',
    moderation:
      'Comments are reviewed before publication. Please keep the discussion respectful and on topic.',
    rulesLink: 'Comment rules',
    empty:
      'Be the first to leave a memory on this article.',
    loading: 'Loading comments...',
    leaveComment: 'Leave a comment',
    reply: 'Reply',
    replyTo: 'Reply to',
    cancelReply: 'Cancel reply',
    loginRequired: 'Log in or register to leave a comment.',
    loginLink: 'Log in',
    registerLink: 'Register',
    loggedAs: 'You are commenting as',
    notifyReplies: 'Notify me when someone replies to my comment',
    notifyThread: 'Notify me if the discussion continues',
    sent: 'Comment sent. It will appear after moderation.',
    error: 'Something went wrong. Please try again.',
    reader: 'Reader',
    legacyBadge: 'Archive',
    like: 'Like',
    dislike: 'Dislike',
    loginToReact: 'Sign in or create an account to react to a comment.',
    ownReactionError: 'You cannot react to your own comment.',
    reactionExpired: 'You can no longer change this reaction.',
    reactionError: 'The reaction could not be updated. Please try again.',
    report: 'Report',
    reportReason: 'Reason for the report (optional)',
    reportPlaceholder: 'Add useful context for the editorial team.',
    reportSubmit: 'Send report',
    reportCancel: 'Cancel',
    reportSuccess: 'Report sent. Thank you, we will review it.',
    reportDuplicate: 'You have already reported this comment.',
    reportError: 'The report could not be sent. Please try again.',
    sortLabel: 'Sort',
    sortOldest: 'Oldest first',
    sortNewest: 'Newest first',
    sortLiked: 'Most liked'
  }
};

const t = labels[lang] || labels.it;
const commentRulesHref = lang === 'en' ? '/en/comment-rules/' : '/regolamento-commenti/';

const legacyComments = Array.isArray(comments)
  ? comments
      .filter((comment) => !comment?.parentComment)
      .map((comment) => ({
        id: `legacy-${comment._id}`,
        body: comment.body || '',
        created_at: comment.createdAt || null,
        isLegacy: true,
        isHighlighted: Boolean(comment.isHighlighted),
        profiles: {
          display_name: comment.authorName || t.reader,
          username: comment.authorName || t.reader,
          user_badges: {
            label_it: t.legacyBadge,
            label_en: t.legacyBadge
          }
        },
        replies: Array.isArray(comment.editorReplies)
          ? comment.editorReplies.map((reply, index) => ({
              id: `legacy-${comment._id}-editor-${index}`,
              body: reply.body || '',
              created_at: reply.createdAt || null,
              isLegacy: true,
              profiles: {
                display_name: reply.authorName || 'Retro-Gamers.it',
                username: reply.authorName || 'Retro-Gamers.it',
                user_badges: {
                  label_it: reply.authorRole || 'Redazione',
                  label_en: reply.authorRole || 'Editor'
                }
              }
            }))
          : []
      }))
  : [];

const legacyCommentsJson = JSON.stringify(legacyComments).replace(/</g, '\\u003c');
---

<section
  class="article-comments"
  id="comments"
  data-rg-comments
  data-article-slug={articleSlug}
  data-article-language={lang}
  data-article-title={articleTitle}
  data-article-url={articleUrl}
>
  <div class="article-comments__header">
    <div>
      <span class="article-comments__kicker" data-comments-count>
        0 {t.countPlural}
      </span>

      <h2>{t.title}</h2>

      <p>{t.intro}</p>

      <a class="article-comments__rules-link" href={commentRulesHref}>
        {t.rulesLink}
      </a>

      <p class="article-comments__status" data-comments-status hidden></p>
    </div>
  </div>

  <div class="article-comments__composer" data-comments-auth-box hidden>
    <p class="article-comments__empty">{t.loginRequired}</p>

    <div class="article-comments__actions article-comments__auth-actions">
      <a href={loginHref}>{t.loginLink}</a>
      <a href={registerHref}>{t.registerLink}</a>
    </div>
  </div>

  <details class="article-comments__composer" data-comments-composer hidden>
    <summary>
      <span>{t.leaveComment}</span>
    </summary>

    <form class="article-comments__form" data-comments-form>
      <input type="hidden" name="parentId" value="" data-parent-comment-id />

      <div class="article-comments__replying-to" data-replying-to hidden>
        <span data-replying-to-text></span>

        <button type="button" data-cancel-reply>
          {t.cancelReply}
        </button>
      </div>

      <p class="article-comments__current-user" data-current-user></p>

      <label>
        <span>{t.comment}</span>
        <textarea
          name="body"
          required
          minlength="3"
          maxlength="3000"
          rows="6"
          data-comment-textarea
        ></textarea>
      </label>

      <label class="article-comments__checkbox">
        <input type="checkbox" name="notifyReplies" checked />
        <span>{t.notifyReplies}</span>
      </label>

      <label class="article-comments__checkbox">
        <input type="checkbox" name="notifyThread" />
        <span>{t.notifyThread}</span>
      </label>

      <div class="article-comments__actions">
        <small>{t.moderation}</small>
        <button type="submit">{t.submit}</button>
      </div>
    </form>
  </details>

  <div class="article-comments__toolbar" data-comments-toolbar hidden>
    <span>{t.sortLabel}</span>

    <div class="article-comments__sort" role="group" aria-label={t.sortLabel}>
      <button type="button" data-comments-sort="oldest" aria-pressed="true">
        {t.sortOldest}
      </button>

      <button type="button" data-comments-sort="newest" aria-pressed="false">
        {t.sortNewest}
      </button>

      <button type="button" data-comments-sort="liked" aria-pressed="false">
        {t.sortLiked}
      </button>
    </div>
  </div>

  <div class="article-comments__list" data-comments-list>
    <p class="article-comments__empty">{t.loading}</p>
  </div>

  <script type="application/json" data-legacy-comments set:html={legacyCommentsJson}></script>
</section>

<script>
  import { getCommunityRank } from '../../lib/community-rank';

  const commentLabels = {
    it: {
      commentSingular: 'memoria',
      commentPlural: 'memorie',
      empty:
        'Sii il primo a lasciare un ricordo su questo articolo.',
      sent: 'Commento inviato. Sarà visibile dopo la moderazione.',
      error: 'Qualcosa è andato storto. Riprova.',
      loggedAs: 'Stai commentando come',
      reply: 'Rispondi',
      replyTo: 'Risposta a',
      reader: 'Lettore',
      like: 'Mi piace',
      dislike: 'Non mi piace',
      loginToReact: 'Accedi o registrati per votare un commento.',
      ownReactionError: 'Non puoi votare un tuo commento.',
      reactionExpired: 'Non puoi più modificare questa reazione.',
      reactionError: 'Non è stato possibile aggiornare il voto. Riprova.',
      reactionOtherSingular: 'altro',
      reactionOtherPlural: 'altri',
      avatarOf: 'Avatar di {name}',
      directLink: 'Link diretto al commento',
      targetLoading: 'Caricamento commento...',
      report: 'Segnala',
      reportReason: 'Motivo della segnalazione (opzionale)',
      reportPlaceholder: 'Aggiungi un contesto utile per la redazione.',
      reportSubmit: 'Invia segnalazione',
      reportCancel: 'Annulla',
      reportSuccess: 'Segnalazione inviata. Grazie, la controlleremo.',
      reportDuplicate: 'Hai già segnalato questo commento.',
      reportError: 'Non è stato possibile inviare la segnalazione. Riprova.',
      roleStaff: 'Staff Retro-Gamers',
      roleModerator: 'Moderatore',
      communityPoints: 'Punti community: {points}',
      communityLevel: 'Livello: {level}',
      pendingStatus: 'In attesa',
      edit: 'Modifica',
      editLabel: 'Modifica commento',
      saveEdit: 'Salva modifica',
      cancelEdit: 'Annulla',
      editSuccess: 'Commento aggiornato.',
      editExpired: 'Il tempo per modificare questo commento è scaduto.',
      editError: 'Non è stato possibile aggiornare il commento. Riprova.',
      sortLabel: 'Ordina',
      sortOldest: 'Meno recenti',
      sortNewest: 'Più recenti',
      sortLiked: 'Più apprezzati'
    },
    en: {
      commentSingular: 'memory',
      commentPlural: 'memories',
      empty:
        'Be the first to leave a memory on this article.',
      sent: 'Comment sent. It will appear after moderation.',
      error: 'Something went wrong. Please try again.',
      loggedAs: 'You are commenting as',
      reply: 'Reply',
      replyTo: 'Reply to',
      reader: 'Reader',
      like: 'Like',
      dislike: 'Dislike',
      loginToReact: 'Sign in or create an account to react to a comment.',
      ownReactionError: 'You cannot react to your own comment.',
      reactionExpired: 'You can no longer change this reaction.',
      reactionError: 'The reaction could not be updated. Please try again.',
      reactionOtherSingular: 'other',
      reactionOtherPlural: 'others',
      avatarOf: 'Avatar for {name}',
      directLink: 'Direct link to comment',
      targetLoading: 'Loading comment...',
      report: 'Report',
      reportReason: 'Reason for the report (optional)',
      reportPlaceholder: 'Add useful context for the editorial team.',
      reportSubmit: 'Send report',
      reportCancel: 'Cancel',
      reportSuccess: 'Report sent. Thank you, we will review it.',
      reportDuplicate: 'You have already reported this comment.',
      reportError: 'The report could not be sent. Please try again.',
      roleStaff: 'Retro-Gamers Staff',
      roleModerator: 'Moderator',
      communityPoints: 'Community points: {points}',
      communityLevel: 'Level: {level}',
      pendingStatus: 'Pending',
      edit: 'Edit',
      editLabel: 'Edit comment',
      saveEdit: 'Save edit',
      cancelEdit: 'Cancel',
      editSuccess: 'Comment updated.',
      editExpired: 'The edit window for this comment has expired.',
      editError: 'The comment could not be updated. Please try again.',
      sortLabel: 'Sort',
      sortOldest: 'Oldest first',
      sortNewest: 'Newest first',
      sortLiked: 'Most liked'
    }
  };

  const escapeHtml = (value) =>
    String(value || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

  const formatCommentDate = (value, language) => {
    if (!value) return '';

    return new Intl.DateTimeFormat(language === 'en' ? 'en-US' : 'it-IT', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    }).format(new Date(value));
  };

  const getAuthorName = (profile, fallback) =>
    profile?.display_name || profile?.username || fallback;

  const getAvatarInitial = (profile, fallback) => {
    const source = getAuthorName(profile, fallback) || profile?.email || fallback;
    const match = String(source || '').trim().match(/[A-Za-zÀ-ÖØ-öø-ÿ0-9]/);

    return (match?.[0] || '?').toUpperCase();
  };

  const getBadgeLabel = (profile, language) => {
    const badge = profile?.user_badges;

    if (!badge) return '';

    return language === 'en'
      ? badge.label_en || badge.label_it || ''
      : badge.label_it || badge.label_en || '';
  };

  const readerBadgeImagePaths = {
    arcade_kid: '/badges/reader/arcade-kid.webp',
    eight_bit_player: '/badges/reader/eight-bit-player.webp',
    sixteen_bit_veteran: '/badges/reader/sixteen-bit-veteran.webp',
    amiga_user: '/badges/reader/amiga-user.webp',
    console_warrior: '/badges/reader/console-warrior.webp',
    point_click_lover: '/badges/reader/point-click-lover.webp',
    jrpg_explorer: '/badges/reader/jrpg-explorer.webp',
    retro_collector: '/badges/reader/retro-collector.webp'
  };

  const getBadgeImageSrc = (badge) => {
    const value = readerBadgeImagePaths[String(badge?.key || '').trim()]
      || String(badge?.image_path || '').trim();

    if (!value) return '';

    if (/^https?:\/\//i.test(value) || value.startsWith('/')) {
      return value;
    }

    return `/${value.replace(/^\/+/, '')}`;
  };

  const getProfileHref = (profile, language, isLegacy = false) => {
    const username = String(profile?.username || '').trim();

    if (isLegacy || !username || !/^[a-z0-9_-]{3,24}$/i.test(username)) {
      return '';
    }

    const encodedUsername = encodeURIComponent(username.toLowerCase());

    return language === 'en'
      ? `/en/users/${encodedUsername}/`
      : `/utenti/${encodedUsername}/`;
  };

  const getCommunityPoints = (profile) => {
    const points = Number(profile?.community_points || 0);

    return Number.isFinite(points) && points > 0 ? Math.floor(points) : 0;
  };

  const renderCommunityPointsBadge = (points, labels) => {
    if (!points) return '';

    const label = labels.communityPoints.replace('{points}', String(points));

    return `
      <span
        class="community-points-badge article-comment__points-badge"
        aria-label="${escapeHtml(label)}"
        title="${escapeHtml(label)}"
      >
        ${escapeHtml(points)}
      </span>
    `;
  };

  const renderAvatar = (initial, avatarLabel, href = '', src = '', communityPoints = 0, labels = commentLabels.it) => {
    const avatar = `
      <span class="article-comment__avatar-frame">
        <span class="article-comment__avatar" role="img" aria-label="${escapeHtml(avatarLabel)}">
          <span class="article-comment__avatar-fallback" aria-hidden="true">${escapeHtml(initial)}</span>
          ${src ? `
            <img
              src="${escapeHtml(src)}"
              alt=""
              loading="lazy"
              decoding="async"
              onerror="this.hidden = true"
            />
          ` : ''}
        </span>

        ${renderCommunityPointsBadge(communityPoints, labels)}
      </span>
    `;

    return href
      ? `<a class="article-comment__avatar-link" href="${escapeHtml(href)}">${avatar}</a>`
      : avatar;
  };

  const renderAuthorName = (authorName, href = '') =>
    href
      ? `<a class="article-comment__author-link" href="${escapeHtml(href)}">${escapeHtml(authorName)}</a>`
      : escapeHtml(authorName);

  const getRoleBadge = (profile, labels) => {
    const role = String(profile?.role || '').trim().toLowerCase();

    if (role === 'admin') {
      return {
        label: labels.roleStaff,
        modifier: 'staff'
      };
    }

    if (role === 'moderator') {
      return {
        label: labels.roleModerator,
        modifier: 'moderator'
      };
    }

    return null;
  };

  const renderRoleBadge = (profile, labels) => {
    const badge = getRoleBadge(profile, labels);

    return badge
      ? `<span class="article-comment__role-badge article-comment__role-badge--${escapeHtml(badge.modifier)}">${escapeHtml(badge.label)}</span>`
      : '';
  };

  const renderCommunityLevel = (profile, labels) => {
    const points = getCommunityPoints(profile);

    if (!points) return '';

    const rank = getCommunityRank(points);
    const label = labels.communityLevel.replace('{level}', rank.label);

    return `
      <span
        class="article-comment__level-pill"
        aria-label="${escapeHtml(label)}"
        title="${escapeHtml(label)}"
      >
        ${escapeHtml(label)}
      </span>
    `;
  };

  const renderStatusBadge = (comment, labels) =>
    comment?.status === 'pending'
      ? `<span class="article-comment__status-badge">${escapeHtml(labels.pendingStatus)}</span>`
      : '';

  const getCommentAnchorId = (comment) =>
    comment?.id ? `comment-${String(comment.id)}` : '';

  const renderCommentTime = (comment, language, labels) => {
    if (!comment.created_at) return '';

    const anchorId = getCommentAnchorId(comment);
    const time = `
      <time datetime="${escapeHtml(comment.created_at)}">
        ${escapeHtml(formatCommentDate(comment.created_at, language))}
      </time>
    `;

    return anchorId
      ? `<a class="article-comment__permalink" href="#${escapeHtml(anchorId)}" aria-label="${escapeHtml(labels.directLink)}">${time}</a>`
      : time;
  };

  const readLegacyComments = (root) => {
    const node = root.querySelector('[data-legacy-comments]');

    if (!node?.textContent?.trim()) return [];

    try {
      const parsed = JSON.parse(node.textContent);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  const sortComments = (comments) =>
    [...comments].sort((a, b) => {
      const aTime = a.created_at ? new Date(a.created_at).getTime() : 0;
      const bTime = b.created_at ? new Date(b.created_at).getTime() : 0;
      return aTime - bTime;
    });

  const dedupeComments = (comments) => {
    const seen = new Set();

    return comments.filter((comment) => {
      const key = String(comment.id || '');

      if (!key || seen.has(key)) return false;

      seen.add(key);
      return true;
    });
  };

  const renderBadge = (badgeLabel, badge = null) =>
    badgeLabel
      ? `<span class="article-comment__badge-label">
          ${getBadgeImageSrc(badge) ? `<img src="${escapeHtml(getBadgeImageSrc(badge))}" alt="" loading="lazy" decoding="async" />` : ''}
          <span>${escapeHtml(badgeLabel)}</span>
        </span>`
      : '';

  const renderCommentBody = (body) =>
    `<p class="article-comment__body" data-comment-body>${escapeHtml(body).replaceAll('\n', '<br>')}</p>`;

  const getReactionCount = (comment, key) => {
    const value = Number(comment?.[key] || 0);
    return Number.isFinite(value) && value > 0 ? value : 0;
  };

  const getReactionUsers = (comment, key) =>
    Array.isArray(comment?.[key])
      ? comment[key].map((name) => String(name || '').trim()).filter(Boolean)
      : [];

  const renderReactionTooltip = (title, users, totalCount, labels) => {
    const names = Array.isArray(users)
      ? users.map((name) => String(name || '').trim()).filter(Boolean)
      : [];

    if (totalCount <= 0 || names.length === 0) return '';

    const remainingCount = Math.max(0, totalCount - names.length);
    const otherLabel = remainingCount === 1
      ? labels.reactionOtherSingular
      : labels.reactionOtherPlural;

    return `
      <span class="comment-reaction-tooltip" role="tooltip">
        <strong>${escapeHtml(title)}</strong>
        <span class="comment-reaction-tooltip__list">
          ${names.map((name) => `
            <span class="comment-reaction-tooltip__user">${escapeHtml(name)}</span>
          `).join('')}
          ${remainingCount > 0 ? `
            <span class="comment-reaction-tooltip__more">+ ${remainingCount} ${escapeHtml(otherLabel)}</span>
          ` : ''}
        </span>
      </span>
    `;
  };

  const renderReactionControls = (comment, labels) => {
    if (comment.isLegacy || !comment.id) return '';

    const likeCount = getReactionCount(comment, 'likeCount');
    const dislikeCount = getReactionCount(comment, 'dislikeCount');
    const likeUsers = getReactionUsers(comment, 'likeUsers');
    const dislikeUsers = getReactionUsers(comment, 'dislikeUsers');
    const isOwnComment = Boolean(comment.isOwnComment);

    const userReaction = !isOwnComment && comment.userReaction === 'dislike'
      ? 'dislike'
      : !isOwnComment && comment.userReaction === 'like'
        ? 'like'
        : '';
    const disabledClass = isOwnComment ? ' is-disabled' : '';
    const disabledAttributes = isOwnComment ? 'disabled aria-disabled="true"' : '';
    const ownCommentValue = isOwnComment ? 'true' : 'false';
    const likeTooltip = renderReactionTooltip(labels.like, likeUsers, likeCount, labels);
    const dislikeTooltip = renderReactionTooltip(labels.dislike, dislikeUsers, dislikeCount, labels);
    const likeWrapperFocus = isOwnComment && likeTooltip ? ' tabindex="0"' : '';
    const dislikeWrapperFocus = isOwnComment && dislikeTooltip ? ' tabindex="0"' : '';

    return `
      <div class="article-comment__reaction-controls" data-comment-reactions="${escapeHtml(comment.id)}">
        <span class="comment-reaction-wrap"${likeWrapperFocus}>
          <button
            class="comment-reaction comment-reaction--like${userReaction === 'like' ? ' is-active' : ''}${disabledClass}"
            type="button"
            data-comment-id="${escapeHtml(comment.id)}"
            data-comment-reaction="like"
            data-own-comment="${ownCommentValue}"
            aria-pressed="${userReaction === 'like' ? 'true' : 'false'}"
            ${disabledAttributes}
            aria-label="${escapeHtml(labels.like)}"
          >
            <span class="comment-reaction__count" data-reaction-count>${likeCount}</span>
          </button>
          ${likeTooltip}
        </span>

        <span class="comment-reaction-wrap"${dislikeWrapperFocus}>
          <button
            class="comment-reaction comment-reaction--dislike${userReaction === 'dislike' ? ' is-active' : ''}${disabledClass}"
            type="button"
            data-comment-id="${escapeHtml(comment.id)}"
            data-comment-reaction="dislike"
            data-own-comment="${ownCommentValue}"
            aria-pressed="${userReaction === 'dislike' ? 'true' : 'false'}"
            ${disabledAttributes}
            aria-label="${escapeHtml(labels.dislike)}"
          >
            <span class="comment-reaction__count" data-reaction-count>${dislikeCount}</span>
          </button>
          ${dislikeTooltip}
        </span>
      </div>
    `;
  };

  const renderReportControls = (comment, labels) => {
    if (comment.isLegacy || !comment.id || comment.isOwnComment || !comment.canReport) return '';

    return `
      <div class="article-comment__report" data-comment-report="${escapeHtml(comment.id)}">
        <button
          class="article-comment__report-toggle"
          type="button"
          data-report-comment="${escapeHtml(comment.id)}"
          aria-expanded="false"
        >
          ${escapeHtml(labels.report)}
        </button>

        <form class="article-comment__report-form" data-report-form hidden>
          <label>
            <span>${escapeHtml(labels.reportReason)}</span>
            <textarea
              name="reason"
              maxlength="1000"
              rows="3"
              placeholder="${escapeHtml(labels.reportPlaceholder)}"
            ></textarea>
          </label>

          <div class="article-comment__report-actions">
            <button type="submit">${escapeHtml(labels.reportSubmit)}</button>
            <button type="button" data-report-cancel>${escapeHtml(labels.reportCancel)}</button>
          </div>

          <p class="article-comment__report-message" data-report-message hidden></p>
        </form>
      </div>
    `;
  };

  const renderEditControls = (comment, labels) => {
    if (comment.isLegacy || !comment.id || !comment.canEdit) return '';

    return `
      <div class="article-comment__edit" data-comment-edit="${escapeHtml(comment.id)}">
        <button
          class="article-comment__edit-toggle"
          type="button"
          data-edit-comment="${escapeHtml(comment.id)}"
          aria-expanded="false"
        >
          ${escapeHtml(labels.edit)}
        </button>

        <form class="article-comment__edit-form" data-edit-form hidden>
          <label>
            <span>${escapeHtml(labels.editLabel)}</span>
            <textarea
              name="body"
              required
              minlength="3"
              maxlength="3000"
              rows="4"
            >${escapeHtml(comment.body)}</textarea>
          </label>

          <div class="article-comment__edit-actions">
            <button type="submit">${escapeHtml(labels.saveEdit)}</button>
            <button type="button" data-edit-cancel>${escapeHtml(labels.cancelEdit)}</button>
          </div>

          <p class="article-comment__edit-message" data-edit-message hidden></p>
        </form>
      </div>
    `;
  };

  const renderCommentActions = (comment, labels) => {
    const editControls = renderEditControls(comment, labels);
    const reportControls = renderReportControls(comment, labels);
    const reactionControls = renderReactionControls(comment, labels);

    if (!editControls && !reportControls && !reactionControls) return '';

    return `
      <div class="article-comment__secondary-actions">
        ${editControls}
        ${reportControls}
        ${reactionControls}
      </div>
    `;
  };

  const renderReply = (reply, language, labels) => {
    const profile = reply.profiles || {};
    const authorName = getAuthorName(profile, labels.reader);
    const badgeLabel = getBadgeLabel(profile, language);
    const roleBadge = renderRoleBadge(profile, labels);
    const communityLevel = renderCommunityLevel(profile, labels);
    const statusBadge = renderStatusBadge(reply, labels);
    const initial = getAvatarInitial(profile, labels.reader);
    const avatarLabel = labels.avatarOf.replace('{name}', authorName);
    const profileHref = getProfileHref(profile, language, Boolean(reply.isLegacy));
    const avatarUrl = profile.avatar_url || '';
    const communityPoints = reply.isLegacy ? 0 : getCommunityPoints(profile);

    return `
      <div
        class="article-comment__editor-reply"
        ${reply.id ? `id="${escapeHtml(getCommentAnchorId(reply))}" data-comment-id="${escapeHtml(reply.id)}"` : ''}
      >
        <div class="article-comment__editor-reply-header">
          ${renderAvatar(initial, avatarLabel, profileHref, avatarUrl, communityPoints, labels)}

          <div class="article-comment__editor-reply-meta">
            <strong class="article-comment__author-row">
              ${renderAuthorName(authorName, profileHref)}
              ${roleBadge}
              ${communityLevel}
            </strong>

            <div class="article-comment__editor-reply-submeta">
              ${renderCommentTime(reply, language, labels)}

              ${statusBadge}

              ${renderBadge(badgeLabel, profile?.user_badges)}
            </div>
          </div>
        </div>

        ${renderCommentBody(reply.body)}

        ${renderCommentActions(reply, labels)}
      </div>
    `;
  };

  const renderComment = (comment, language, labels, canReply) => {
    const profile = comment.profiles || {};
    const authorName = getAuthorName(profile, labels.reader);
    const badgeLabel = getBadgeLabel(profile, language);
    const roleBadge = renderRoleBadge(profile, labels);
    const communityLevel = renderCommunityLevel(profile, labels);
    const statusBadge = renderStatusBadge(comment, labels);
    const initial = getAvatarInitial(profile, labels.reader);
    const avatarLabel = labels.avatarOf.replace('{name}', authorName);
    const replies = Array.isArray(comment.replies) ? sortComments(comment.replies) : [];
    const isLegacy = Boolean(comment.isLegacy);
    const profileHref = getProfileHref(profile, language, isLegacy);
    const highlightedClass = comment.isHighlighted ? ' article-comment--highlighted' : '';
    const avatarUrl = profile.avatar_url || '';
    const communityPoints = isLegacy ? 0 : getCommunityPoints(profile);
    const hasOwnReply = replies.some((reply) => Boolean(reply.isOwnComment));

    const canReplyToComment = canReply && !isLegacy && comment.status === 'approved' && !hasOwnReply;

    return `
      <article
        class="article-comment${highlightedClass}"
        ${comment.id ? `id="${escapeHtml(getCommentAnchorId(comment))}" data-comment-id="${escapeHtml(comment.id)}"` : ''}
      >
        <header class="article-comment__header">
          ${renderAvatar(initial, avatarLabel, profileHref, avatarUrl, communityPoints, labels)}

          <div class="article-comment__meta">
            <h3 class="article-comment__author-row">
              ${renderAuthorName(authorName, profileHref)}
              ${roleBadge}
              ${communityLevel}
            </h3>

            ${renderCommentTime(comment, language, labels)}

            ${statusBadge}

            ${renderBadge(badgeLabel, profile?.user_badges)}
          </div>

          ${canReplyToComment ? `
            <div class="article-comment__reactions">
              <button
                class="article-comment__reply-button"
                type="button"
                data-reply-to-comment="${escapeHtml(comment.id)}"
                data-reply-to-author="${escapeHtml(authorName)}"
              >
                ${escapeHtml(labels.reply)}
              </button>
            </div>
          ` : ''}
        </header>

        ${renderCommentBody(comment.body)}

        ${canReplyToComment ? `
          <div class="article-comment__mobile-actions">
            <button
              class="article-comment__mobile-reply-button"
              type="button"
              data-reply-to-comment="${escapeHtml(comment.id)}"
              data-reply-to-author="${escapeHtml(authorName)}"
            >
              ${escapeHtml(labels.reply)}
            </button>
          </div>
        ` : ''}

        ${renderCommentActions(comment, labels)}

        ${replies.length > 0 ? `
          <div class="article-comment__editor-replies">
            ${replies.map((reply) => renderReply(reply, language, labels)).join('')}
          </div>
        ` : ''}
      </article>
    `;
  };

  const initComments = (root) => {
    const articleSlug = root.dataset.articleSlug || '';
    const articleLanguage = root.dataset.articleLanguage === 'en' ? 'en' : 'it';
    const articleTitle = root.dataset.articleTitle || '';
    const articleUrl = root.dataset.articleUrl || '';
    const labels = commentLabels[articleLanguage] || commentLabels.it;
    const legacyComments = readLegacyComments(root);

    const listNode = root.querySelector('[data-comments-list]');
    const countNode = root.querySelector('[data-comments-count]');
    const statusNode = root.querySelector('[data-comments-status]');
    const authBox = root.querySelector('[data-comments-auth-box]');
    const composer = root.querySelector('[data-comments-composer]');
    const toolbarNode = root.querySelector('[data-comments-toolbar]');
    const sortButtons = root.querySelectorAll('[data-comments-sort]');
    const form = root.querySelector('[data-comments-form]');
    const currentUserNode = root.querySelector('[data-current-user]');
    const parentInput = root.querySelector('[data-parent-comment-id]');
    const replyingTo = root.querySelector('[data-replying-to]');
    const replyingToText = root.querySelector('[data-replying-to-text]');
    const cancelReply = root.querySelector('[data-cancel-reply]');
    const textarea = root.querySelector('[data-comment-textarea]');

    let currentProfile = null;
    let loadedComments = [];
    let lastPermalinkTarget = null;
    let permalinkScrollAttempts = 0;

    const allowedSorts = new Set(['oldest', 'newest', 'liked']);
    const readCommentSort = () => {
      const sort = new URL(window.location.href).searchParams.get('commentsSort') || 'oldest';

      return allowedSorts.has(sort) ? sort : 'oldest';
    };
    let currentSort = readCommentSort();

    const setStatus = (message, type = 'ok') => {
      if (!statusNode) return;

      statusNode.textContent = message;
      statusNode.hidden = !message;
      statusNode.classList.toggle('article-comments__status--ok', type === 'ok');
      statusNode.classList.toggle('article-comments__status--error', type === 'error');
    };

    const updateCount = (count) => {
      if (!countNode) return;

      const label = count === 1 ? labels.commentSingular : labels.commentPlural;
      countNode.textContent = `${count} ${label}`;
    };

    const getCommentHashTargetId = () => {
      const hash = window.location.hash || '';

      if (!hash.startsWith('#comment-')) {
        return '';
      }

      try {
        return decodeURIComponent(hash.slice(1));
      } catch {
        return hash.slice(1);
      }
    };

    const jumpToCommentsForCommentHash = () => {
      if (!getCommentHashTargetId()) {
        return false;
      }

      root.scrollIntoView({
        block: 'start',
        behavior: 'auto',
      });

      if (listNode && !listNode.querySelector('[id^="comment-"]')) {
        listNode.innerHTML = `
          <p class="article-comments__empty article-comments__empty--target">
            ${escapeHtml(labels.targetLoading)}
          </p>
        `;
      }

      return true;
    };

    const highlightPermalinkTarget = (target) => {
      if (lastPermalinkTarget && lastPermalinkTarget !== target) {
        lastPermalinkTarget.classList.remove('article-comment--permalink-target');
      }

      target.classList.add('article-comment--permalink-target');
      lastPermalinkTarget = target;
    };

    const scrollToCommentHash = (shouldRetry = false) => {
      const targetId = getCommentHashTargetId();

      if (!targetId) {
        return false;
      }

      const target = document.getElementById(targetId);

      if (!target) {
        if (shouldRetry && permalinkScrollAttempts < 24) {
          permalinkScrollAttempts += 1;
          window.setTimeout(() => scrollToCommentHash(true), 120);
        }

        return false;
      }

      permalinkScrollAttempts = 0;
      highlightPermalinkTarget(target);
      target.scrollIntoView({
        block: 'start',
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth',
      });

      return true;
    };

    const queueCommentHashScroll = () => {
      window.requestAnimationFrame(() => {
        scrollToCommentHash(true);
      });
    };

    const getCommentTime = (comment) =>
      comment?.created_at ? new Date(comment.created_at).getTime() : 0;

    const sortRootComments = (comments) =>
      [...comments].sort((a, b) => {
        const aTime = getCommentTime(a);
        const bTime = getCommentTime(b);
        const idCompare = String(a.id || '').localeCompare(String(b.id || ''));

        if (currentSort === 'newest') {
          return (bTime - aTime) || idCompare;
        }

        if (currentSort === 'liked') {
          const likeCompare = getReactionCount(b, 'likeCount') - getReactionCount(a, 'likeCount');

          return likeCompare || (aTime - bTime) || idCompare;
        }

        return (aTime - bTime) || idCompare;
      });

    const updateSortControls = () => {
      sortButtons.forEach((button) => {
        const isActive = button.dataset.commentsSort === currentSort;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    const updateSortUrl = () => {
      const url = new URL(window.location.href);
      url.searchParams.set('commentsSort', currentSort);
      url.hash = window.location.hash;
      window.history.replaceState(window.history.state, '', url);
    };

    const renderComments = (comments) => {
      const mergedComments = sortRootComments(dedupeComments([...legacyComments, ...comments]));

      updateCount(mergedComments.length);
      updateSortControls();

      if (toolbarNode) {
        toolbarNode.hidden = mergedComments.length < 2;
      }

      if (!listNode) return;

      if (mergedComments.length === 0) {
        listNode.innerHTML = `<p class="article-comments__empty">${escapeHtml(labels.empty)}</p>`;
        queueCommentHashScroll();
        return;
      }

      listNode.innerHTML = mergedComments
        .map((comment) => renderComment(comment, articleLanguage, labels, Boolean(currentProfile)))
        .join('');
      queueCommentHashScroll();
    };

    const updateReactionTooltip = (button, title, users, totalCount) => {
      const wrapper = button?.closest('.comment-reaction-wrap');

      if (!wrapper) return;

      const nextTooltip = renderReactionTooltip(title, users, Number(totalCount || 0), labels);
      const currentTooltip = wrapper.querySelector('.comment-reaction-tooltip');

      if (!nextTooltip) {
        currentTooltip?.remove();
        return;
      }

      if (currentTooltip) {
        currentTooltip.outerHTML = nextTooltip;
      } else {
        wrapper.insertAdjacentHTML('beforeend', nextTooltip);
      }
    };

    const updateReactionGroup = (
      group,
      userReaction,
      likeCount,
      dislikeCount,
      likeUsers = null,
      dislikeUsers = null
    ) => {
      if (!group) return;

      group.querySelectorAll('[data-comment-reaction]').forEach((reactionButton) => {
        const reaction = reactionButton.dataset.commentReaction;
        const isActive = reaction === userReaction;
        const count = reaction === 'dislike' ? dislikeCount : likeCount;
        const users = reaction === 'dislike' ? dislikeUsers : likeUsers;
        const title = reaction === 'dislike' ? labels.dislike : labels.like;
        const countNode = reactionButton.querySelector('[data-reaction-count]');

        reactionButton.classList.toggle('is-active', isActive);
        reactionButton.setAttribute('aria-pressed', isActive ? 'true' : 'false');

        if (countNode) {
          countNode.textContent = String(Number(count || 0));
        }

        if (Array.isArray(users)) {
          updateReactionTooltip(reactionButton, title, users, count);
        }
      });
    };

    const handleReaction = async (button) => {
      if (!currentProfile) {
        setStatus(labels.loginToReact, 'error');
        return;
      }

      if (button.dataset.ownComment === 'true') {
        setStatus(labels.ownReactionError, 'error');
        return;
      }

      const commentId = button.dataset.commentId || '';
      const reaction = button.dataset.commentReaction || '';

      if (!commentId || (reaction !== 'like' && reaction !== 'dislike')) return;

      const group = button.closest('[data-comment-reactions]');
      const buttons = group
        ? Array.from(group.querySelectorAll('[data-comment-reaction]'))
        : [button];

      buttons.forEach((reactionButton) => {
        reactionButton.disabled = true;
      });

      setStatus('');

      try {
        const response = await fetch('/api/comments/reaction', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            commentId,
            reaction
          })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          setStatus(
            result.code === 'own_comment'
              ? labels.ownReactionError
              : result.code === 'reaction_expired'
                ? labels.reactionExpired
              : result.error || labels.reactionError,
            'error'
          );
          return;
        }

        updateReactionGroup(
          group,
          result.userReaction || null,
          result.likeCount,
          result.dislikeCount,
          result.likeUsers,
          result.dislikeUsers
        );
      } catch {
        setStatus(labels.reactionError, 'error');
      } finally {
        buttons.forEach((reactionButton) => {
          reactionButton.disabled = false;
        });
      }
    };

    const setReportMessage = (form, message, type = 'ok') => {
      const messageNode = form?.querySelector('[data-report-message]');

      if (!messageNode) return;

      messageNode.textContent = message;
      messageNode.dataset.type = type;
      messageNode.hidden = !message;
    };

    const closeReportForm = (form) => {
      if (!form) return;

      form.hidden = true;
      const wrapper = form.closest('[data-comment-report]');
      const toggle = wrapper?.querySelector('[data-report-comment]');
      toggle?.setAttribute('aria-expanded', 'false');
      setReportMessage(form, '');
    };

    const closeOtherReportForms = (activeForm) => {
      listNode?.querySelectorAll('[data-report-form]').forEach((form) => {
        if (form !== activeForm) {
          closeReportForm(form);
        }
      });
    };

    const setEditMessage = (form, message, type = 'ok') => {
      const messageNode = form?.querySelector('[data-edit-message]');

      if (!messageNode) return;

      messageNode.textContent = message;
      messageNode.dataset.type = type;
      messageNode.hidden = !message;
    };

    const setEditFormOpen = (form, isOpen) => {
      if (!form) return;

      form.hidden = !isOpen;
      const wrapper = form.closest('[data-comment-edit]');
      const toggle = wrapper?.querySelector('[data-edit-comment]');
      const commentNode = form.closest('[data-comment-id]');
      const bodyNode = commentNode?.querySelector('[data-comment-body]');

      toggle?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

      if (bodyNode) {
        bodyNode.hidden = isOpen;
      }

      if (!isOpen) {
        setEditMessage(form, '');
      }
    };

    const closeEditForm = (form) => {
      setEditFormOpen(form, false);
    };

    const closeOtherEditForms = (activeForm) => {
      listNode?.querySelectorAll('[data-edit-form]').forEach((form) => {
        if (form !== activeForm) {
          closeEditForm(form);
        }
      });
    };

    const toggleEditForm = (button) => {
      if (!currentProfile) {
        return;
      }

      const wrapper = button.closest('[data-comment-edit]');
      const form = wrapper?.querySelector('[data-edit-form]');

      if (!form) return;

      const willOpen = form.hidden;
      closeOtherEditForms(form);
      setEditFormOpen(form, willOpen);

      if (willOpen) {
        form.querySelector('textarea')?.focus();
      }
    };

    const toggleReportForm = (button) => {
      if (!currentProfile) {
        return;
      }

      const wrapper = button.closest('[data-comment-report]');
      const form = wrapper?.querySelector('[data-report-form]');

      if (!form) return;

      const willOpen = form.hidden;
      closeOtherReportForms(form);
      form.hidden = !willOpen;
      button.setAttribute('aria-expanded', willOpen ? 'true' : 'false');

      if (willOpen) {
        form.querySelector('textarea')?.focus();
      }
    };

    const handleEditSubmit = async (form) => {
      if (!currentProfile) {
        return;
      }

      const wrapper = form.closest('[data-comment-edit]');
      const commentId = wrapper?.dataset.commentEdit || '';
      const submitButton = form.querySelector('button[type="submit"]');
      const body = String(new FormData(form).get('body') || '').trim();

      if (!commentId || !submitButton) return;

      submitButton.disabled = true;
      setEditMessage(form, '');

      try {
        const response = await fetch('/api/comments/update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            commentId,
            body
          })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          setEditMessage(
            form,
            result.code === 'edit_window_expired'
              ? labels.editExpired
              : result.error || labels.editError,
            'error'
          );
          return;
        }

        setStatus(labels.editSuccess, 'ok');
        await loadComments();
      } catch {
        setEditMessage(form, labels.editError, 'error');
      } finally {
        submitButton.disabled = false;
      }
    };

    const handleReportSubmit = async (form) => {
      if (!currentProfile) {
        return;
      }

      const wrapper = form.closest('[data-comment-report]');
      const commentId = wrapper?.dataset.commentReport || '';
      const submitButton = form.querySelector('button[type="submit"]');
      const reason = String(new FormData(form).get('reason') || '').trim();

      if (!commentId || !submitButton) return;

      submitButton.disabled = true;
      setReportMessage(form, '');

      try {
        const response = await fetch('/api/comments/report', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            commentId,
            reason
          })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          setReportMessage(
            form,
            result.code === 'duplicate_report'
              ? labels.reportDuplicate
              : labels.reportError,
            'error'
          );
          return;
        }

        form.reset();
        setReportMessage(form, labels.reportSuccess, 'ok');
      } catch {
        setReportMessage(form, labels.reportError, 'error');
      } finally {
        submitButton.disabled = false;
      }
    };

    const applyViewerState = (viewer = null) => {
      const canComment = Boolean(viewer?.canComment);
      currentProfile = canComment
        ? {
            id: viewer.profileId || '',
            user_id: viewer.userId || '',
            username: viewer.username || '',
            display_name: viewer.displayName || '',
            role: viewer.role || '',
            status: viewer.status || ''
          }
        : null;

      if (authBox) authBox.hidden = canComment;
      if (composer) composer.hidden = !canComment;

      if (currentUserNode) {
        currentUserNode.textContent = canComment
          ? `${labels.loggedAs} ${getAuthorName(currentProfile, labels.reader)}`
          : '';
      }
    };

    const loadComments = async () => {
      if (!listNode) return;

      try {
        const response = await fetch(
          `/api/comments/list?articleSlug=${encodeURIComponent(articleSlug)}&articleLanguage=${encodeURIComponent(articleLanguage)}`
        );
        const result = await response.json();

        if (!result.ok) {
          listNode.innerHTML = `<p class="article-comments__empty">${escapeHtml(result.error || labels.error)}</p>`;
          renderComments([]);
          return;
        }

        applyViewerState(result.viewer);
        loadedComments = Array.isArray(result.comments) ? result.comments : [];
        renderComments(loadedComments);
      } catch {
        applyViewerState(null);
        listNode.innerHTML = `<p class="article-comments__empty">${escapeHtml(labels.error)}</p>`;
        updateCount(legacyComments.length);
      }
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const body = String(formData.get('body') || '').trim();
      const submitButton = form.querySelector('button[type="submit"]');

      if (!body || !submitButton) return;

      submitButton.disabled = true;
      setStatus('');

      try {
        const response = await fetch('/api/comments/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            articleSlug,
            articleLanguage,
            articleTitle,
            articleUrl,
            parentId: String(formData.get('parentId') || '') || null,
            body,
            notifyReplies: formData.get('notifyReplies') === 'on',
            notifyThread: formData.get('notifyThread') === 'on'
          })
        });

        const result = await response.json();

        if (!result.ok) {
          setStatus(result.error || labels.error, 'error');
          return;
        }

        form.reset();
        if (parentInput) parentInput.value = '';
        if (replyingTo) replyingTo.hidden = true;
        if (composer) composer.open = false;

        setStatus(result.message || labels.sent, 'ok');

        if (result.comment) {
          await loadComments();
        }
      } catch {
        setStatus(labels.error, 'error');
      } finally {
        submitButton.disabled = false;
      }
    });

    listNode?.addEventListener('click', (event) => {
      const target = event.target;
      const reactionButton = target instanceof Element
        ? target.closest('[data-comment-reaction]')
        : null;

      if (reactionButton) {
        handleReaction(reactionButton);
        return;
      }

      const reportButton = target instanceof Element
        ? target.closest('[data-report-comment]')
        : null;

      if (reportButton) {
        toggleReportForm(reportButton);
        return;
      }

      const editButton = target instanceof Element
        ? target.closest('[data-edit-comment]')
        : null;

      if (editButton) {
        toggleEditForm(editButton);
        return;
      }

      const editCancel = target instanceof Element
        ? target.closest('[data-edit-cancel]')
        : null;

      if (editCancel) {
        closeEditForm(editCancel.closest('[data-edit-form]'));
        return;
      }

      const reportCancel = target instanceof Element
        ? target.closest('[data-report-cancel]')
        : null;

      if (reportCancel) {
        closeReportForm(reportCancel.closest('[data-report-form]'));
        return;
      }

      const button = target instanceof Element
        ? target.closest('[data-reply-to-comment]')
        : null;

      if (!button || !currentProfile) return;

      const commentId = button.dataset.replyToComment;
      const author = button.dataset.replyToAuthor || '';

      if (parentInput) parentInput.value = commentId || '';

      if (replyingTo && replyingToText) {
        replyingToText.textContent = `${labels.replyTo} ${author}`;
        replyingTo.hidden = false;
      }

      if (composer) {
        composer.hidden = false;
        composer.open = true;
      }

      textarea?.focus();
    });

    listNode?.addEventListener('submit', (event) => {
      const editForm = event.target instanceof Element
        ? event.target.closest('[data-edit-form]')
        : null;

      if (editForm) {
        event.preventDefault();
        handleEditSubmit(editForm);
        return;
      }

      const form = event.target instanceof Element
        ? event.target.closest('[data-report-form]')
        : null;

      if (!form) return;

      event.preventDefault();
      handleReportSubmit(form);
    });

    sortButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextSort = button.dataset.commentsSort || 'oldest';

        if (!allowedSorts.has(nextSort) || nextSort === currentSort) {
          return;
        }

        currentSort = nextSort;
        updateSortUrl();
        renderComments(loadedComments);
      });
    });

    cancelReply?.addEventListener('click', () => {
      if (parentInput) parentInput.value = '';
      if (replyingTo) replyingTo.hidden = true;
    });

    window.addEventListener('hashchange', () => {
      permalinkScrollAttempts = 0;
      jumpToCommentsForCommentHash();
      queueCommentHashScroll();
    });

    jumpToCommentsForCommentHash();

    Promise.resolve()
      .then(loadComments)
      .catch(() => {
        renderComments([]);
      });
  };

  document.querySelectorAll('[data-rg-comments]').forEach(initComments);
</script>
