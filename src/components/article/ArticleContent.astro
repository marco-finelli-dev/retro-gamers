---
import { getPostUrl } from '../../lib/routes';
import { urlFor } from '../../lib/image';
import ConsentYouTube from '../common/ConsentYouTube.astro';

const { content = [], lang = 'it' } = Astro.props;

function escapeHTML(str = '') {
  return String(str).replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[char]));
}

function preserveLineBreaks(str = '') {
  return escapeHTML(str).replace(/\n/g, '<br>');
}

function getInternalUrl(reference) {
  if (!reference?.slug) return '#';

  return getPostUrl({
    type: reference.type || 'article',
    slug: reference.slug,
    language: reference.language || 'it'
  });
}

function getPlatformUrl(reference) {
  if (!reference?.slug || !reference?.platformType || !reference?.manufacturer?.slug) {
    return '#';
  }

  const typeMap = {
    console: {
      it: 'console',
      en: 'consoles'
    },
    computer: {
      it: 'computer',
      en: 'computers'
    },
    arcade: {
      it: 'arcade',
      en: 'arcade'
    }
  };

  const localizedType =
    typeMap[reference.platformType]?.[lang] ||
    reference.platformType;

  const prefix = lang === 'en' ? '/en/platforms' : '/piattaforme';

  return `${prefix}/${localizedType}/${reference.manufacturer.slug}/${reference.slug}/`;
}

function getCreatorUrl(reference) {
  if (!reference?.slug) return '#';

  return lang === 'en'
    ? `/en/creators/${reference.slug}/`
    : `/creatori/${reference.slug}/`;
}

function getCompanyUrl(reference) {
  if (!reference?.slug) return '#';

  return lang === 'en'
    ? `/en/companies/${reference.slug}/`
    : `/aziende/${reference.slug}/`;
}

function isAffiliateUrl(url = '') {
  return /amazon\.|amzn\.to|ebay\.|rover\.ebay/i.test(url);
}

function getExternalRel(url = '') {
  return isAffiliateUrl(url)
    ? 'sponsored nofollow noopener noreferrer'
    : 'noopener noreferrer';
}

function getExternalClass(url = '') {
  return isAffiliateUrl(url)
    ? 'article-affiliate-link'
    : '';
}

function getImageUrl(image, width = 980, height = null, fit = null) {
  if (!image?.asset) return '';

  let builder = urlFor(image)
    .width(width)
    .quality(76)
    .auto('format');

  if (height) {
    builder = builder.height(height);

    if (fit) {
      builder = builder.fit(fit);
    }
  }

  return builder.url();
}

function getOriginalImageUrl(image) {
  return image?.asset?.url || '';
}

function getDisplayMode(item = {}, fallback = 'cover') {
  const mode = item.displayMode;

  if (
    mode === 'cover' ||
    mode === 'contain' ||
    mode === 'wide' ||
    mode === 'natural'
  ) {
    return mode;
  }

  if (item.isWide) {
    return 'wide';
  }

  return fallback;
}

function getSingleImageWidth(displayMode = 'cover') {
  if (displayMode === 'wide') return 1320;
  if (displayMode === 'natural') return 1200;
  if (displayMode === 'contain') return 1100;

  return 980;
}

function getSingleImageHeight(displayMode = 'cover') {
  if (displayMode === 'wide') return null;
  if (displayMode === 'natural') return null;
  if (displayMode === 'contain') return null;

  return null;
}

function getGalleryImageUrl(image, displayMode = 'cover') {
  if (!image?.asset) return '';

  if (displayMode === 'contain' || displayMode === 'natural') {
    return urlFor(image)
      .width(900)
      .quality(78)
      .auto('format')
      .url();
  }

  return urlFor(image)
    .width(720)
    .height(450)
    .fit('crop')
    .quality(76)
    .auto('format')
    .url();
}

function renderTextChild(child, markDefs = []) {
  let output = preserveLineBreaks(child.text || '');

  if (!child.marks?.length) return output;

  child.marks.forEach((mark) => {
    const def = markDefs.find((d) => d._key === mark);

    if (mark === 'strong') {
      output = `<strong>${output}</strong>`;
      return;
    }

    if (mark === 'em') {
      output = `<em>${output}</em>`;
      return;
    }

    if (mark === 'code') {
      output = `<code>${output}</code>`;
      return;
    }

    if (def?.href) {
      const rel = getExternalRel(def.href);
      const className = getExternalClass(def.href);
      const classAttr = className ? ` class="${className}"` : '';

      output = `<a href="${escapeHTML(def.href)}" target="_blank" rel="${rel}"${classAttr}>${output}</a>`;
      return;
    }

    if (def?._type === 'internalLink') {
      output = `<a href="${escapeHTML(getInternalUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'platformLink') {
      output = `<a href="${escapeHTML(getPlatformUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'creatorLink') {
      output = `<a href="${escapeHTML(getCreatorUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'companyLink') {
      output = `<a href="${escapeHTML(getCompanyUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'pageLink') {
      const path = def.path || '#';

      output = `<a href="${escapeHTML(path)}">${output}</a>`;
      return;
    }

    if (def?._type === 'taxonomyLink') {
      const slug = def.reference?.slug;

      if (slug) {
        const prefix = lang === 'en' ? '/en' : '';
        output = `<a href="${prefix}/tag/${escapeHTML(slug)}/">${output}</a>`;
      }

      return;
    }
  });

  return output;
}

function renderBlockChildren(block) {
  return block.children
    ?.map((child) => renderTextChild(child, block.markDefs || []))
    .join('') || '';
}

function isBlankBlockHtml(html = '') {
  return String(html)
    .replace(/<br\s*\/?>/gi, '')
    .replace(/&nbsp;/gi, '')
    .replace(/<[^>]*>/g, '')
    .trim().length === 0;
}

/*
  Gallery principale:
  2 → 2
  3 → 3
  4 → 4
  5 → 3 + 2
  6 → 3 + 3
  7 → 4 + 3
  8 → 4 + 4
*/
function chunkBalanced(images = []) {
  const total = images.length;

  if (total <= 4) return [images];

  if (total === 5) {
    return [
      images.slice(0, 3),
      images.slice(3)
    ];
  }

  if (total === 6) {
    return [
      images.slice(0, 3),
      images.slice(3)
    ];
  }

  if (total === 7) {
    return [
      images.slice(0, 4),
      images.slice(4)
    ];
  }

  if (total === 8) {
    return [
      images.slice(0, 4),
      images.slice(4)
    ];
  }

  const rows = [];
  let index = 0;
  let remaining = total;

  while (remaining > 0) {
    let take = 4;

    if (remaining === 5 || remaining === 6) {
      take = 3;
    }

    rows.push(images.slice(index, index + take));

    index += take;
    remaining -= take;
  }

  return rows;
}
---

<div class="article-content">

  {content?.map((block) => {

    if (block._type === 'block') {
      const html = renderBlockChildren(block);

      if (isBlankBlockHtml(html)) {
        return null;
      }

      if (block.style === 'h2') {
        return <h2 set:html={html} />;
      }

      if (block.style === 'h3') {
        return <h3 set:html={html} />;
      }

      if (block.style === 'blockquote') {
        return <blockquote set:html={html} />;
      }

      return <p set:html={html} />;
    }

    if (block._type === 'image') {
      const displayMode = getDisplayMode(block);
      const imageWidth = getSingleImageWidth(displayMode);
      const imageHeight = getSingleImageHeight(displayMode);

      const imageUrl = getImageUrl(block, imageWidth, imageHeight);
      const fullImageUrl = getOriginalImageUrl(block);

      if (!imageUrl) return null;

      return (
        <figure class={`article-figure article-figure--${displayMode} ${block.isWide ? 'is-wide' : ''}`}>
          <img
            src={imageUrl}
            data-fullsrc={fullImageUrl || imageUrl}
            data-caption={block.caption || ''}
            class="js-article-lightbox-image"
            alt={block.alt || ''}
            width={displayMode === 'wide' ? '1320' : '980'}
            height={displayMode === 'wide' ? '742' : '552'}
            loading="lazy"
            decoding="async"
          />

          {block.caption && (
            <figcaption>{block.caption}</figcaption>
          )}
        </figure>
      );
    }

    if (block._type === 'imageRow') {
      const rows = chunkBalanced(block.images || []);
      const isUniformHeight = block.layout === 'uniformHeight';
      const groupCaption = typeof block.groupCaption === 'string'
        ? block.groupCaption.trim()
        : '';

      return (
        <div class={`article-image-gallery ${isUniformHeight ? 'article-image-gallery--uniform-height' : ''}`}>
          {rows.map((row) => (
            <div
              class={`article-image-row article-image-row--${row.length}`}
              style={`--image-count: ${row.length};`}
            >
              {row.map((img) => {
                const displayMode = getDisplayMode(img);
                const imageUrl = getGalleryImageUrl(img.image, displayMode);
                const fullImageUrl = getOriginalImageUrl(img.image);

                if (!imageUrl) return null;

                return (
                  <figure class={`article-image-row__item article-image-row__item--${displayMode}`}>
                    <img
                      src={imageUrl}
                      data-fullsrc={fullImageUrl || imageUrl}
                      data-caption={img.caption || ''}
                      class="js-article-lightbox-image"
                      alt={img.alt || ''}
                      width={displayMode === 'contain' || displayMode === 'natural' ? '900' : '720'}
                      height={displayMode === 'contain' || displayMode === 'natural' ? undefined : '450'}
                      loading="lazy"
                      decoding="async"
                    />

                    {img.caption && (
                      <figcaption>{img.caption}</figcaption>
                    )}
                  </figure>
                );
              })}
            </div>
          ))}

          {groupCaption && (
            <p class="article-image-gallery__caption">{groupCaption}</p>
          )}
        </div>
      );
    }

    if (block._type === 'video') {
      return (
        <ConsentYouTube
          url={block.url}
          title={block.title || 'Video YouTube'}
        />
      );
    }

    if (block._type === 'asideBox') {
      const asideContent = block.content || [];

      return (
        <aside class={`article-aside-box ${block.tone || 'info'}`}>

          {block.title && (
            <h4>{block.title}</h4>
          )}

          {asideContent.map((inner) => {
            if (inner._type === 'block') {
              const html = renderBlockChildren(inner);

              if (isBlankBlockHtml(html)) {
                return null;
              }

              return <p set:html={html} />;
            }

            if (inner._type === 'image') {
              const displayMode = getDisplayMode(inner, 'contain');
              const imageUrl = getImageUrl(inner, 720);
              const fullImageUrl = getOriginalImageUrl(inner);

              if (!imageUrl) return null;

              return (
                <figure class={`article-aside-figure article-aside-figure--${displayMode}`}>
                  <img
                    src={imageUrl}
                    data-fullsrc={fullImageUrl || imageUrl}
                    data-caption={inner.caption || ''}
                    class="js-article-lightbox-image"
                    alt={inner.alt || ''}
                    width="720"
                    height="405"
                    loading="lazy"
                    decoding="async"
                  />

                  {inner.caption && (
                    <figcaption>{inner.caption}</figcaption>
                  )}
                </figure>
              );
            }

            if (inner._type === 'imageRow') {
              const rows = chunkBalanced(inner.images || []);
              const isUniformHeight = inner.layout === 'uniformHeight';
              const groupCaption = typeof inner.groupCaption === 'string'
                ? inner.groupCaption.trim()
                : '';

              return (
                <div class={`article-aside-gallery ${isUniformHeight ? 'article-aside-gallery--uniform-height' : ''}`}>
                  {rows.map((row) => (
                    <div
                      class={`article-aside-row article-aside-row--${row.length}`}
                      style={`--aside-image-count: ${row.length};`}
                    >
                      {row.map((img) => {
                        const displayMode = getDisplayMode(img);
                        const imageUrl = getGalleryImageUrl(img.image, displayMode);
                        const fullImageUrl = getOriginalImageUrl(img.image);

                        if (!imageUrl) return null;

                        return (
                          <figure class={`article-aside-row__item article-aside-row__item--${displayMode}`}>
                            <img
                              src={imageUrl}
                              data-fullsrc={fullImageUrl || imageUrl}
                              data-caption={img.caption || ''}
                              class="js-article-lightbox-image"
                              alt={img.alt || ''}
                              width={displayMode === 'contain' || displayMode === 'natural' ? '900' : '720'}
                              height={displayMode === 'contain' || displayMode === 'natural' ? undefined : '450'}
                              loading="lazy"
                              decoding="async"
                            />

                            {img.caption && (
                              <figcaption>{img.caption}</figcaption>
                            )}
                          </figure>
                        );
                      })}
                    </div>
                  ))}

                  {groupCaption && (
                    <p class="article-aside-gallery__caption">{groupCaption}</p>
                  )}
                </div>
              );
            }

            return null;
          })}

        </aside>
      );
    }

    return null;
  })}

</div>
