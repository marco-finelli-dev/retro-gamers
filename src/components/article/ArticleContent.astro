---
import {
  getCompanyUrl as getSharedCompanyUrl,
  getCreatorUrl as getSharedCreatorUrl,
  getPlatformUrl as getSharedPlatformUrl,
  getSanityDocumentUrl
} from '../../lib/routes';
import { getRgAffiliateProviderFromUrl } from '../../lib/analytics/client';
import { urlFor } from '../../lib/image';
import { getYouTubeVideoId } from '../../lib/youtube-video';
import ConsentYouTube from '../common/ConsentYouTube.astro';

const {
  content = [],
  lang = 'it',
  isPreview = false,
  articleSlug = '',
  contentType = ''
} = Astro.props;

const getAnalyticsToken = (value = '') =>
  String(value || '')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_-]+/g, '-')
    .replace(/^-+|-+$/g, '');

const articleAnalyticsLanguage = lang === 'en' ? 'en' : 'it';
const articleAnalyticsSlug = getAnalyticsToken(articleSlug);
const articleAnalyticsContentType = getAnalyticsToken(contentType);

function escapeHTML(str = '') {
  return String(str).replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[char]));
}

function preserveLineBreaks(str = '') {
  return escapeHTML(str).replace(/\n/g, '<br>');
}

function getInternalUrl(reference) {
  return getSanityDocumentUrl(reference, lang);
}

function getReferenceSlug(reference) {
  return typeof reference?.slug === 'string'
    ? reference.slug
    : reference?.slug?.current || '';
}

function getPlatformUrl(reference) {
  const slug = getReferenceSlug(reference);
  const manufacturerSlug = getReferenceSlug(reference?.manufacturer);

  if (!slug || !reference?.platformType || !manufacturerSlug) {
    return '#';
  }

  return getSharedPlatformUrl({
    ...reference,
    slug,
    manufacturer: {
      ...(reference.manufacturer || {}),
      slug: manufacturerSlug
    }
  }, lang);
}

function getCreatorUrl(reference) {
  const slug = getReferenceSlug(reference);

  return slug ? getSharedCreatorUrl({ ...reference, slug }, lang) : '#';
}

function getCompanyUrl(reference) {
  const slug = getReferenceSlug(reference);

  return slug ? getSharedCompanyUrl({ ...reference, slug }, lang) : '#';
}

function isAffiliateUrl(url = '') {
  return getRgAffiliateProviderFromUrl(url) !== 'other';
}

function getExternalRel(url = '') {
  return isAffiliateUrl(url)
    ? 'sponsored nofollow noopener noreferrer'
    : 'noopener noreferrer';
}

function getExternalClass(url = '') {
  return isAffiliateUrl(url)
    ? 'article-affiliate-link'
    : '';
}

function getAffiliateAnalyticsAttributes(url = '') {
  if (!isAffiliateUrl(url)) return '';

  const provider = getRgAffiliateProviderFromUrl(url);
  const attributes = [
    'data-rg-affiliate-link',
    `data-rg-affiliate-language="${escapeHTML(articleAnalyticsLanguage)}"`,
    `data-rg-affiliate-provider="${escapeHTML(provider)}"`,
    'data-rg-affiliate-placement="article_body"',
  ];

  if (articleAnalyticsSlug) {
    attributes.push(`data-rg-affiliate-article-slug="${escapeHTML(articleAnalyticsSlug)}"`);
  }

  if (articleAnalyticsContentType) {
    attributes.push(`data-rg-affiliate-content-type="${escapeHTML(articleAnalyticsContentType)}"`);
  }

  return ` ${attributes.join(' ')}`;
}

function isGifImage(image) {
  const asset = image?.asset || {};
  const mimeType = String(asset.mimeType || '').toLowerCase();
  const extension = String(asset.extension || '').toLowerCase();
  const originalFilename = String(asset.originalFilename || '').toLowerCase();
  const url = String(asset.url || '').toLowerCase();

  return mimeType === 'image/gif'
    || extension === 'gif'
    || originalFilename.endsWith('.gif')
    || /\.gif(?:$|\?)/.test(url);
}

function getImageUrl(image, width = 980, height = null, fit = null) {
  if (!image?.asset) return '';

  if (isGifImage(image)) {
    return image.asset.url || '';
  }

  let builder = urlFor(image)
    .width(width)
    .quality(76)
    .auto('format');

  if (height) {
    builder = builder.height(height);

    if (fit) {
      builder = builder.fit(fit);
    }
  }

  return builder.url();
}

function getOriginalImageUrl(image) {
  return image?.asset?.url || '';
}

function getImageAspectRatio(image) {
  const dimensions = image?.asset?.metadata?.dimensions || image?.asset?.dimensions || null;
  const width = Number(dimensions?.width);
  const height = Number(dimensions?.height);

  if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) {
    return null;
  }

  return Number((width / height).toFixed(4));
}

function getImageRowTemplate(items = []) {
  const columns = items
    .map((item) => getImageAspectRatio(item?.image) || 1.3333)
    .map((ratio) => `${ratio}fr`);

  return columns.length > 0 ? columns.join(' ') : '';
}

function getDisplayMode(item = {}, fallback = 'cover') {
  const mode = item.displayMode;

  if (
    mode === 'cover' ||
    mode === 'contain' ||
    mode === 'wide' ||
    mode === 'natural'
  ) {
    return mode;
  }

  if (item.isWide) {
    return 'wide';
  }

  return fallback;
}

function getSingleImageWidth(displayMode = 'cover') {
  if (displayMode === 'wide') return 1320;
  if (displayMode === 'natural') return 1200;
  if (displayMode === 'contain') return 1100;

  return 980;
}

function getSingleImageHeight(displayMode = 'cover') {
  if (displayMode === 'wide') return null;
  if (displayMode === 'natural') return null;
  if (displayMode === 'contain') return null;

  return null;
}

function getGalleryImageUrl(image, displayMode = 'cover', { noCrop = false } = {}) {
  if (!image?.asset) return '';

  if (isGifImage(image)) {
    return image.asset.url || '';
  }

  if (noCrop || displayMode === 'contain' || displayMode === 'natural') {
    return urlFor(image)
      .width(900)
      .quality(78)
      .auto('format')
      .url();
  }

  return urlFor(image)
    .width(720)
    .height(450)
    .fit('crop')
    .quality(76)
    .auto('format')
    .url();
}

function getLightboxGroupId(scope, index, key) {
  return `article-${scope}-${key || index}`;
}

function getRowStartIndex(rows = [], rowIndex = 0) {
  return rows
    .slice(0, rowIndex)
    .reduce((total, row) => total + row.length, 0);
}

function renderTextChild(child, markDefs = []) {
  let output = preserveLineBreaks(child.text || '');

  if (!child.marks?.length) return output;

  child.marks.forEach((mark) => {
    const def = markDefs.find((d) => d._key === mark);

    if (mark === 'strong') {
      output = `<strong>${output}</strong>`;
      return;
    }

    if (mark === 'em') {
      output = `<em>${output}</em>`;
      return;
    }

    if (mark === 'code') {
      output = `<code>${output}</code>`;
      return;
    }

    if (def?.href) {
      const rel = getExternalRel(def.href);
      const className = getExternalClass(def.href);
      const classAttr = className ? ` class="${className}"` : '';
      const affiliateAnalyticsAttrs = getAffiliateAnalyticsAttributes(def.href);

      output = `<a href="${escapeHTML(def.href)}" target="_blank" rel="${rel}"${classAttr}${affiliateAnalyticsAttrs}>${output}</a>`;
      return;
    }

    if (def?._type === 'internalLink') {
      if (
        !isPreview &&
        def.reference?._type === 'article' &&
        def.reference?.isPublic === false
      ) {
        return;
      }

      output = `<a href="${escapeHTML(getInternalUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'platformLink') {
      output = `<a href="${escapeHTML(getPlatformUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'creatorLink') {
      output = `<a href="${escapeHTML(getCreatorUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'companyLink') {
      output = `<a href="${escapeHTML(getCompanyUrl(def.reference))}">${output}</a>`;
      return;
    }

    if (def?._type === 'pageLink') {
      const path = def.path || '#';

      output = `<a href="${escapeHTML(path)}">${output}</a>`;
      return;
    }

    if (def?._type === 'taxonomyLink') {
      const slug = def.reference?.slug;

      if (slug) {
        const prefix = lang === 'en' ? '/en' : '';
        output = `<a href="${prefix}/tag/${escapeHTML(slug)}/">${output}</a>`;
      }

      return;
    }
  });

  return output;
}

function renderBlockChildren(block) {
  return block.children
    ?.map((child) => renderTextChild(child, block.markDefs || []))
    .join('') || '';
}

function isBlankBlockHtml(html = '') {
  return String(html)
    .replace(/<br\s*\/?>/gi, '')
    .replace(/&nbsp;/gi, '')
    .replace(/<[^>]*>/g, '')
    .trim().length === 0;
}

function isBlockquoteBlock(block) {
  return block?._type === 'block' && block.style === 'blockquote';
}

function isPreviousBlockquote(contentBlocks = [], index = 0) {
  return index > 0 && isBlockquoteBlock(contentBlocks[index - 1]);
}

function getBlockquoteGroup(contentBlocks = [], startIndex = 0) {
  const group = [];

  for (let index = startIndex; index < contentBlocks.length; index += 1) {
    const block = contentBlocks[index];

    if (!isBlockquoteBlock(block)) break;

    const html = renderBlockChildren(block);

    if (!isBlankBlockHtml(html)) {
      group.push({
        key: block._key || `${startIndex}-${index}`,
        html,
      });
    }
  }

  return group;
}

function getListItemType(block) {
  const listItem = String(block?.listItem || '').trim();
  return listItem === 'bullet' || listItem === 'number' ? listItem : '';
}

function getListLevel(block) {
  const level = Number(block?.level);
  return Number.isInteger(level) && level >= 1 ? Math.min(level, 6) : 1;
}

function isListBlock(block) {
  return block?._type === 'block' && Boolean(getListItemType(block));
}

function isPreviousListBlock(contentBlocks = [], index = 0) {
  if (index <= 0) return false;

  const currentBlock = contentBlocks[index];
  const previousBlock = contentBlocks[index - 1];

  return (
    isListBlock(currentBlock)
    && isListBlock(previousBlock)
    && getListItemType(currentBlock) === getListItemType(previousBlock)
  );
}

function getListGroup(contentBlocks = [], startIndex = 0) {
  const startBlock = contentBlocks[startIndex];
  const listItem = getListItemType(startBlock);
  const group = [];

  if (!listItem) return { listItem: '', items: [] };

  for (let index = startIndex; index < contentBlocks.length; index += 1) {
    const block = contentBlocks[index];

    if (!isListBlock(block) || getListItemType(block) !== listItem) break;

    const html = renderBlockChildren(block);

    if (!isBlankBlockHtml(html)) {
      group.push({
        key: block._key || `${startIndex}-${index}`,
        html,
        level: getListLevel(block),
      });
    }
  }

  return { listItem, items: group };
}

/*
  Gallery principale:
  2 → 2
  3 → 3
  4 → 4
  5 → 3 + 2
  6 → 3 + 3
  7 → 4 + 3
  8 → 4 + 4
*/
function chunkBalanced(images = []) {
  const total = images.length;

  if (total <= 4) return [images];

  if (total === 5) {
    return [
      images.slice(0, 3),
      images.slice(3)
    ];
  }

  if (total === 6) {
    return [
      images.slice(0, 3),
      images.slice(3)
    ];
  }

  if (total === 7) {
    return [
      images.slice(0, 4),
      images.slice(4)
    ];
  }

  if (total === 8) {
    return [
      images.slice(0, 4),
      images.slice(4)
    ];
  }

  const rows = [];
  let index = 0;
  let remaining = total;

  while (remaining > 0) {
    let take = 4;

    if (remaining === 5 || remaining === 6) {
      take = 3;
    }

    rows.push(images.slice(index, index + take));

    index += take;
    remaining -= take;
  }

  return rows;
}
---

<div class="article-content">

  {content?.map((block, blockIndex) => {

    if (block._type === 'block') {
      const html = renderBlockChildren(block);

      if (isBlankBlockHtml(html)) {
        return null;
      }

      if (isListBlock(block)) {
        if (isPreviousListBlock(content, blockIndex)) {
          return null;
        }

        const listGroup = getListGroup(content, blockIndex);

        if (listGroup.items.length === 0) {
          return null;
        }

        const listClass = `article-list article-list--${listGroup.listItem}`;

        if (listGroup.listItem === 'number') {
          return (
            <ol class={listClass}>
              {listGroup.items.map((listBlock) => (
                <li
                  class={`article-list__item article-list__item--level-${listBlock.level}`}
                  set:html={listBlock.html}
                />
              ))}
            </ol>
          );
        }

        return (
          <ul class={listClass}>
            {listGroup.items.map((listBlock) => (
              <li
                class={`article-list__item article-list__item--level-${listBlock.level}`}
                set:html={listBlock.html}
              />
            ))}
          </ul>
        );
      }

      if (block.style === 'h2') {
        return <h2 set:html={html} />;
      }

      if (block.style === 'h3') {
        return <h3 set:html={html} />;
      }

      if (block.style === 'blockquote') {
        if (isPreviousBlockquote(content, blockIndex)) {
          return null;
        }

        const quoteGroup = getBlockquoteGroup(content, blockIndex);

        if (quoteGroup.length === 0) {
          return null;
        }

        return (
          <blockquote class="article-blockquote-group">
            {quoteGroup.map((quoteBlock) => (
              <p set:html={quoteBlock.html} />
            ))}
          </blockquote>
        );
      }

      return <p set:html={html} />;
    }

    if (block._type === 'image') {
      const displayMode = getDisplayMode(block);
      const imageWidth = getSingleImageWidth(displayMode);
      const imageHeight = getSingleImageHeight(displayMode);

      const imageUrl = getImageUrl(block, imageWidth, imageHeight);
      const fullImageUrl = getOriginalImageUrl(block);

      if (!imageUrl) return null;

      return (
        <figure class={`article-figure article-figure--${displayMode} ${block.isWide ? 'is-wide' : ''}`}>
          <img
            src={imageUrl}
            data-fullsrc={fullImageUrl || imageUrl}
            data-caption={block.caption || ''}
            class="js-article-lightbox-image"
            alt={block.alt || ''}
            width={displayMode === 'wide' ? '1320' : '980'}
            height={displayMode === 'wide' ? '742' : '552'}
            loading="lazy"
            decoding="async"
          />

          {block.caption && (
            <figcaption>{block.caption}</figcaption>
          )}
        </figure>
      );
    }

    if (block._type === 'imageRow') {
      const images = block.images || [];
      const isUniformHeight = block.layout === 'uniformHeight';
      const rows = isUniformHeight
        ? [images].filter((row) => row.length > 0)
        : chunkBalanced(images);
      const groupCaption = typeof block.groupCaption === 'string'
        ? block.groupCaption.trim()
        : '';
      const lightboxGroupId = getLightboxGroupId('gallery', blockIndex, block._key);

      return (
        <div class={`article-image-gallery ${isUniformHeight ? 'article-image-gallery--uniform-height' : ''}`}>
          {rows.map((row, rowIndex) => (
            <div
              class={`article-image-row article-image-row--${row.length}`}
              style={`--image-count: ${row.length};${isUniformHeight ? ` --image-row-template: ${getImageRowTemplate(row)};` : ''}`}
            >
              {row.map((img, imageIndex) => {
                const displayMode = getDisplayMode(img);
                const imageUrl = getGalleryImageUrl(img.image, displayMode, { noCrop: isUniformHeight });
                const fullImageUrl = getOriginalImageUrl(img.image);
                const lightboxIndex = getRowStartIndex(rows, rowIndex) + imageIndex;
                const aspectRatio = isUniformHeight ? getImageAspectRatio(img.image) : null;

                if (!imageUrl) return null;

                return (
                  <figure
                    class={`article-image-row__item article-image-row__item--${displayMode}`}
                    style={aspectRatio ? `--image-aspect-ratio: ${aspectRatio};` : undefined}
                  >
                    <img
                      src={imageUrl}
                      data-fullsrc={fullImageUrl || imageUrl}
                      data-caption={img.caption || ''}
                      data-lightbox-group={lightboxGroupId}
                      data-lightbox-index={lightboxIndex}
                      class="js-article-lightbox-image"
                      alt={img.alt || ''}
                      width={isUniformHeight || displayMode === 'contain' || displayMode === 'natural' ? '900' : '720'}
                      height={isUniformHeight || displayMode === 'contain' || displayMode === 'natural' ? undefined : '450'}
                      loading="lazy"
                      decoding="async"
                    />

                    {img.caption && (
                      <figcaption>{img.caption}</figcaption>
                    )}
                  </figure>
                );
              })}
            </div>
          ))}

          {groupCaption && (
            <p class="article-image-gallery__caption">{groupCaption}</p>
          )}
        </div>
      );
    }

    if (block._type === 'video') {
      return (
        <ConsentYouTube
          url={block.url}
          title={block.title || 'Video YouTube'}
        />
      );
    }

    if (block._type === 'videoRow') {
      const videos = Array.isArray(block.videos)
        ? block.videos.filter((video) => getYouTubeVideoId(video?.url)).slice(0, 2)
        : [];
      const groupCaption = typeof block.groupCaption === 'string'
        ? block.groupCaption.trim()
        : '';

      if (videos.length === 0) return null;

      return (
        <div class="article-video-gallery">
          <div
            class={`article-video-row article-video-row--${videos.length}`}
            style={`--video-count: ${videos.length};`}
          >
            {videos.map((video) => {
              if (!video?.url) return null;

              return (
                <figure class="article-video-row__item">
                  <ConsentYouTube
                    url={video.url}
                    title={video.title || 'Video YouTube'}
                  />

                  {video.caption && (
                    <figcaption>{video.caption}</figcaption>
                  )}
                </figure>
              );
            })}
          </div>

          {groupCaption && (
            <p class="article-video-gallery__caption">{groupCaption}</p>
          )}
        </div>
      );
    }

    if (block._type === 'asideBox') {
      const asideContent = block.content || [];

      return (
        <aside class={`article-aside-box ${block.tone || 'info'}`}>

          {block.title && (
            <h4>{block.title}</h4>
          )}

          {asideContent.map((inner, innerIndex) => {
            if (inner._type === 'block') {
              const html = renderBlockChildren(inner);

              if (isBlankBlockHtml(html)) {
                return null;
              }

              return <p set:html={html} />;
            }

            if (inner._type === 'image') {
              const displayMode = getDisplayMode(inner, 'contain');
              const imageUrl = getImageUrl(inner, 720);
              const fullImageUrl = getOriginalImageUrl(inner);

              if (!imageUrl) return null;

              return (
                <figure class={`article-aside-figure article-aside-figure--${displayMode}`}>
                  <img
                    src={imageUrl}
                    data-fullsrc={fullImageUrl || imageUrl}
                    data-caption={inner.caption || ''}
                    class="js-article-lightbox-image"
                    alt={inner.alt || ''}
                    width="720"
                    height="405"
                    loading="lazy"
                    decoding="async"
                  />

                  {inner.caption && (
                    <figcaption>{inner.caption}</figcaption>
                  )}
                </figure>
              );
            }

            if (inner._type === 'imageRow') {
              const images = inner.images || [];
              const isUniformHeight = inner.layout === 'uniformHeight';
              const rows = isUniformHeight
                ? [images].filter((row) => row.length > 0)
                : chunkBalanced(images);
              const groupCaption = typeof inner.groupCaption === 'string'
                ? inner.groupCaption.trim()
                : '';
              const lightboxGroupId = getLightboxGroupId('aside-gallery', `${blockIndex}-${innerIndex}`, inner._key);

              return (
                <div class={`article-aside-gallery ${isUniformHeight ? 'article-aside-gallery--uniform-height' : ''}`}>
                  {rows.map((row, rowIndex) => (
                    <div
                      class={`article-aside-row article-aside-row--${row.length}`}
                      style={`--aside-image-count: ${row.length};${isUniformHeight ? ` --aside-row-template: ${getImageRowTemplate(row)};` : ''}`}
                    >
                      {row.map((img, imageIndex) => {
                        const displayMode = getDisplayMode(img);
                        const imageUrl = getGalleryImageUrl(img.image, displayMode, { noCrop: isUniformHeight });
                        const fullImageUrl = getOriginalImageUrl(img.image);
                        const lightboxIndex = getRowStartIndex(rows, rowIndex) + imageIndex;
                        const aspectRatio = isUniformHeight ? getImageAspectRatio(img.image) : null;

                        if (!imageUrl) return null;

                        return (
                          <figure
                            class={`article-aside-row__item article-aside-row__item--${displayMode}`}
                            style={aspectRatio ? `--image-aspect-ratio: ${aspectRatio};` : undefined}
                          >
                            <img
                              src={imageUrl}
                              data-fullsrc={fullImageUrl || imageUrl}
                              data-caption={img.caption || ''}
                              data-lightbox-group={lightboxGroupId}
                              data-lightbox-index={lightboxIndex}
                              class="js-article-lightbox-image"
                              alt={img.alt || ''}
                              width={isUniformHeight || displayMode === 'contain' || displayMode === 'natural' ? '900' : '720'}
                              height={isUniformHeight || displayMode === 'contain' || displayMode === 'natural' ? undefined : '450'}
                              loading="lazy"
                              decoding="async"
                            />

                            {img.caption && (
                              <figcaption>{img.caption}</figcaption>
                            )}
                          </figure>
                        );
                      })}
                    </div>
                  ))}

                  {groupCaption && (
                    <p class="article-aside-gallery__caption">{groupCaption}</p>
                  )}
                </div>
              );
            }

            return null;
          })}

        </aside>
      );
    }

    return null;
  })}

</div>
