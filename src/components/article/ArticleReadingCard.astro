---
import '../../styles/article/article-reading-card.css';

const {
  typeLabel = '',
  title = '',
  readingTime = 1,
  lang = 'it'
} = Astro.props;

const isEnglish = lang === 'en';
---

<div
  class="article-reading-card"
  data-article-reading-card
  data-reading-minutes={Math.max(1, Number(readingTime) || 1)}
  aria-hidden="true"
>
  <div class="article-reading-card__surface">
    <div class="article-reading-card__copy">
      <span class="article-reading-card__type">{typeLabel}</span>
      <strong class="article-reading-card__title">{title}</strong>
      <span class="article-reading-card__section" data-reading-section hidden></span>
    </div>

    <div class="article-reading-card__time">
      <div
        class="article-reading-card__progress"
        data-reading-progress-ring
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label={isEnglish ? `${readingTime} minutes remaining` : `${readingTime} minuti di lettura rimanenti`}
      >
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <circle class="article-reading-card__progress-track" cx="24" cy="24" r="20" pathLength="100" />
          <circle class="article-reading-card__progress-value" cx="24" cy="24" r="20" pathLength="100" />
        </svg>
        <span data-reading-minutes-left>{readingTime}</span>
      </div>
      <span class="article-reading-card__time-label">
        {isEnglish ? 'MINUTES LEFT' : 'MINUTI RIMASTI'}
      </span>
    </div>

    <div class="article-reading-card__index" id="article-reading-index" data-reading-index hidden>
      <span>{isEnglish ? 'In this article' : 'In questo articolo'}</span>
      <nav aria-label={isEnglish ? 'Article index' : 'Indice articolo'} data-reading-index-list></nav>
    </div>
  </div>
</div>

<script is:inline define:vars={{ isEnglish }}>
  (() => {
    const initReadingCard = () => {
      const card = document.querySelector('[data-article-reading-card]');
      const article = document.querySelector('[data-rg-article-page]');
      const hero = article?.querySelector('.article-hero');
      const content = article?.querySelector('.article-page__content > .article-content');
      if (!(card instanceof HTMLElement) || !(hero instanceof HTMLElement) || !(content instanceof HTMLElement)) return;

      const ring = card.querySelector('[data-reading-progress-ring]');
      const minutesNode = card.querySelector('[data-reading-minutes-left]');
      const sectionNode = card.querySelector('[data-reading-section]');
      const indexToggle = card.querySelector('[data-reading-index-toggle]');
      const indexPanel = card.querySelector('[data-reading-index]');
      const indexList = card.querySelector('[data-reading-index-list]');
      const backTop = card.querySelector('[data-reading-back-top]');
      const totalMinutes = Math.max(1, Number(card.dataset.readingMinutes) || 1);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const headings = Array.from(content.querySelectorAll('h2, h3'));
      const usedIds = new Set(Array.from(document.querySelectorAll('[id]')).map((node) => node.id));

      const slugify = (value) => String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'sezione';

      headings.forEach((heading, index) => {
        if (!heading.id) {
          const base = slugify(heading.textContent);
          let id = base;
          let suffix = 2;
          while (usedIds.has(id)) id = `${base}-${suffix++}`;
          heading.id = id;
          usedIds.add(id);
        }
        heading.dataset.readingHeadingIndex = String(index);
      });

      if (indexList instanceof HTMLElement && headings.length) {
        headings.forEach((heading, index) => {
          const link = document.createElement('a');
          link.href = `#${encodeURIComponent(heading.id)}`;
          link.dataset.readingIndexLink = String(index);
          link.dataset.level = heading.tagName.toLowerCase();
          link.textContent = heading.textContent?.trim() || '';
          indexList.append(link);
        });
      } else if (indexToggle instanceof HTMLButtonElement) {
        indexToggle.hidden = true;
      }

      let frame;
      let activeIndex = -1;
      const documentTop = (node) => node.getBoundingClientRect().top + window.scrollY;
      const closeIndex = () => {
        if (!(indexPanel instanceof HTMLElement) || !(indexToggle instanceof HTMLButtonElement)) return;
        indexPanel.hidden = true;
        indexToggle.setAttribute('aria-expanded', 'false');
      };

      const setActiveHeading = (nextIndex) => {
        if (activeIndex === nextIndex) return;
        activeIndex = nextIndex;
        const heading = headings[nextIndex];
        if (sectionNode instanceof HTMLElement) {
          sectionNode.textContent = heading?.textContent?.trim() || '';
          sectionNode.hidden = !heading;
        }
        indexList?.querySelectorAll('[data-reading-index-link]').forEach((link, index) => {
          if (index === nextIndex) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      const update = () => {
        frame = undefined;
        const heroBounds = hero.getBoundingClientRect();
        const visible = heroBounds.bottom <= 0;
        card.classList.toggle('is-visible', visible);
        card.setAttribute('aria-hidden', String(!visible));
        if (!visible) closeIndex();

        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const start = documentTop(content);
        const end = Math.max(start + 1, start + content.scrollHeight - viewportHeight);
        const progress = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
        const percent = Math.round(progress * 100);
        const minutesLeft = progress >= 1 ? 0 : Math.max(1, Math.ceil(totalMinutes * (1 - progress)));
        card.style.setProperty('--article-reading-progress', String(percent));
        if (minutesNode) minutesNode.textContent = String(minutesLeft);
        if (ring) {
          ring.setAttribute('aria-valuenow', String(percent));
          ring.setAttribute('aria-label', isEnglish
            ? `${minutesLeft} minutes remaining`
            : `${minutesLeft} minuti di lettura rimanenti`);
        }

        const threshold = card.getBoundingClientRect().bottom + 20;
        let nextActive = -1;
        headings.forEach((heading, index) => {
          if (heading.getBoundingClientRect().top <= threshold) nextActive = index;
        });
        setActiveHeading(nextActive);
      };

      const requestUpdate = () => {
        if (frame !== undefined) return;
        frame = window.requestAnimationFrame(update);
      };

      indexToggle?.addEventListener('click', () => {
        if (!(indexPanel instanceof HTMLElement) || !(indexToggle instanceof HTMLButtonElement)) return;
        const open = indexPanel.hidden;
        indexPanel.hidden = !open;
        indexToggle.setAttribute('aria-expanded', String(open));
        if (open) indexPanel.querySelector('a')?.focus({ preventScroll: true });
      });

      indexList?.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href^="#"]') : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (!target) return;
        event.preventDefault();
        history.pushState(null, '', link.hash);
        target.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
        closeIndex();
      });

      backTop?.addEventListener('click', () => {
        hero.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
        closeIndex();
      });

      document.addEventListener('click', (event) => {
        if (!card.contains(event.target)) closeIndex();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeIndex();
      });
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });
      document.fonts?.ready?.then(requestUpdate);
      update();
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReadingCard, { once: true });
    else initReadingCard();
  })();
</script>
