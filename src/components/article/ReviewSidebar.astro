---
import ReviewScoreBox from './ReviewScoreBox.astro';
import { urlFor } from '../../lib/image';
import { getCompanyUrl } from '../../lib/routes';

const { post } = Astro.props;

const lang = post?.language || 'it';

const labels = {
  it: {
    gameCard: 'Scheda gioco',
    platform: 'Piattaforma',
    format: 'Formato',
    developer: 'Sviluppatore',
    publisher: 'Publisher',
    creators: 'Creatori',
    year: 'Anno',
    genre: 'Genere',
    mode: 'Modalità',
    mediaFormats: {
      cartridge: 'Cartuccia',
      floppy: 'Floppy disk',
      tape: 'Cassetta / tape',
      cdrom: 'CD-ROM',
      gdrom: 'GD-ROM',
      hucard: 'HuCard',
      arcade_pcb: 'PCB arcade',
      digital: 'Digitale',
      other: 'Altro'
    }
  },
  en: {
    gameCard: 'Game info',
    platform: 'Platform',
    format: 'Format',
    developer: 'Developer',
    publisher: 'Publisher',
    creators: 'Creators',
    year: 'Year',
    genre: 'Genre',
    mode: 'Mode',
    mediaFormats: {
      cartridge: 'Cartridge',
      floppy: 'Floppy disk',
      tape: 'Cassette / tape',
      cdrom: 'CD-ROM',
      gdrom: 'GD-ROM',
      hucard: 'HuCard',
      arcade_pcb: 'Arcade PCB',
      digital: 'Digital',
      other: 'Other'
    }
  }
};

const t = labels[lang] || labels.it;

const getTaxonomyName = (item) =>
  lang === 'en'
    ? item.nameEn || item.name
    : item.name;

const creators = Array.isArray(post.creators)
  ? post.creators.filter((creator) => creator?.name && creator?.slug)
  : [];

const getCreatorUrl = (creator) =>
  lang === 'en'
    ? `/en/creators/${creator.slug}/`
    : `/creatori/${creator.slug}/`;

const companyTaxonomyTypes = new Set(['developers', 'publishers', 'manufacturer']);

function renderTaxonomyList(items = [], type = '') {
  return items
    .map((item) => ({
      label: getTaxonomyName(item),
      href: companyTaxonomyTypes.has(type) && item?.slug
        ? getCompanyUrl(item, lang)
        : ''
    }))
    .filter((item) => item.label);
}

const cover = post.gameInfo?.cover?.asset
  ? urlFor(post.gameInfo.cover)
      .width(720)
      .quality(78)
      .auto('format')
      .url()
  : '';

const coverAlt =
  post.gameInfo?.cover?.alt ||
  `${post.title} cover` ||
  '';

const rawMediaFormat = post.gameInfo?.mediaFormat;

const mediaFormat = Array.isArray(rawMediaFormat)
  ? rawMediaFormat
      .map((format) => t.mediaFormats[format] || format)
      .filter(Boolean)
      .join(', ')
  : rawMediaFormat
    ? t.mediaFormats[rawMediaFormat] || rawMediaFormat
    : '';

const infoRows = [
  {
    label: t.platform,
    value: post.platforms?.map((item) => item.name).join(', ')
  },
  {
    label: t.format,
    value: mediaFormat
  },
  {
    label: t.developer,
    value: renderTaxonomyList(post.developers, 'developers'),
    type: 'taxonomyList'
  },
  {
    label: t.publisher,
    value: renderTaxonomyList(post.publishers, 'publishers'),
    type: 'taxonomyList'
  },
  {
    label: lang === 'en' ? 'Manufacturer' : 'Produttore',
    value: renderTaxonomyList(post.manufacturer, 'manufacturer'),
    type: 'taxonomyList'
  },
  {
    label: t.creators,
    value: creators,
    type: 'creators'
  },
  {
    label: t.year,
    value: post.gameInfo?.releaseYear
  },
  {
    label: t.genre,
    value: post.genres?.map(getTaxonomyName).join(' · ')
  },
  {
    label: t.mode,
    value: post.modes?.map(getTaxonomyName).join(' · ')
  }
].filter((row) =>
  row.type === 'creators' || row.type === 'taxonomyList'
    ? row.value.length > 0
    : row.value
);
---

<div class={`review-sidebar ${!cover ? 'has-no-cover' : ''}`}>

  {cover && (
    <figure class="review-sidebar__cover">
      <img
        src={cover}
        alt={coverAlt}
        width="720"
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}

  <div class="review-sidebar__sticky">

    {post.rating && (
      <ReviewScoreBox rating={post.rating} compact lang={lang} />
    )}

    {infoRows.length > 0 && (
      <section class="review-sidebar__panel">
        <h2>{t.gameCard}</h2>

        <dl class="review-info-list">
          {infoRows.map((row) => (
            <div>
              <dt>{row.label}</dt>
              {row.type === 'creators' ? (
                <dd>
                  {row.value.map((creator, index) => (
                    <>
                      {index > 0 && ', '}
                      <a class="review-info-link" href={getCreatorUrl(creator)}>
                        {creator.name}
                      </a>
                    </>
                  ))}
                </dd>
              ) : row.type === 'taxonomyList' ? (
                <dd>
                  {row.value.map((item, index) => (
                    <>
                      {index > 0 && ', '}
                      {item.href ? (
                        <a class="review-info-link" href={item.href}>
                          {item.label}
                        </a>
                      ) : (
                        <>{item.label}</>
                      )}
                    </>
                  ))}
                </dd>
              ) : (
                <dd>{row.value}</dd>
              )}
            </div>
          ))}
        </dl>
      </section>
    )}

  </div>

</div>
