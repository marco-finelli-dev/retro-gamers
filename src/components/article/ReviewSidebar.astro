---
import ReviewScoreBox from './ReviewScoreBox.astro';
import { urlFor } from '../../lib/image';
import { getCompanyUrl, getPlatformUrl } from '../../lib/routes';

const { post } = Astro.props;

const lang = post?.language || 'it';

const labels = {
  it: {
    gameCard: 'Scheda gioco',
    platform: 'Piattaforma',
    format: 'Formato',
    developer: 'Sviluppatore',
    publisher: 'Publisher',
    creators: 'Creatori',
    year: 'Anno',
    genre: 'Genere',
    mode: 'Modalità',
    mediaFormats: {
      cartridge: 'Cartuccia',
      floppy: 'Floppy disk',
      tape: 'Cassetta / tape',
      cdrom: 'CD-ROM',
      'cd-rom': 'CD-ROM',
      gdrom: 'GD-ROM',
      'gd-rom': 'GD-ROM',
      hucard: 'HuCard',
      arcade_pcb: 'PCB arcade',
      'arcade-pcb': 'PCB arcade',
      digital: 'Digitale',
      other: 'Altro'
    }
  },
  en: {
    gameCard: 'Game info',
    platform: 'Platform',
    format: 'Format',
    developer: 'Developer',
    publisher: 'Publisher',
    creators: 'Creators',
    year: 'Year',
    genre: 'Genre',
    mode: 'Mode',
    mediaFormats: {
      cartridge: 'Cartridge',
      floppy: 'Floppy disk',
      tape: 'Cassette / tape',
      cdrom: 'CD-ROM',
      'cd-rom': 'CD-ROM',
      gdrom: 'GD-ROM',
      'gd-rom': 'GD-ROM',
      hucard: 'HuCard',
      arcade_pcb: 'Arcade PCB',
      'arcade-pcb': 'Arcade PCB',
      digital: 'Digital',
      other: 'Other'
    }
  }
};

const t = labels[lang] || labels.it;

const getTaxonomySlug = (item) => {
  if (!item) return '';

  if (typeof item.slug === 'string') return item.slug;
  if (typeof item.slug?.current === 'string') return item.slug.current;

  return '';
};

const getTaxonomyName = (item) => {
  if (!item) return '';

  return lang === 'en'
    ? item.nameEn || item.name || getTaxonomySlug(item)
    : item.name || item.nameEn || getTaxonomySlug(item);
};

const toTaxonomyArray = (value) => {
  if (Array.isArray(value)) return value.filter(Boolean);
  if (value) return [value];

  return [];
};

const creators = Array.isArray(post.creators)
  ? post.creators.filter((creator) => creator?.name && creator?.slug)
  : [];

const getCreatorUrl = (creator) =>
  lang === 'en'
    ? `/en/creators/${creator.slug}/`
    : `/creatori/${creator.slug}/`;

const companyTaxonomyTypes = new Set(['developers', 'publishers', 'manufacturer']);

function getSafeCompanyHref(item, type = '') {
  const slug = getTaxonomySlug(item);

  if (!companyTaxonomyTypes.has(type) || !slug) return '';

  return getCompanyUrl({ ...item, slug }, lang);
}

function renderTaxonomyList(items, type = '') {
  return toTaxonomyArray(items)
    .map((item) => ({
      label: getTaxonomyName(item),
      href: getSafeCompanyHref(item, type)
    }))
    .filter((item) => item.label);
}

const getArchiveFilterUrl = (key, value) => {
  if (!key || !value) return '';

  const baseUrl = lang === 'en' ? '/en/archive/' : '/archivio/';

  return `${baseUrl}?${key}=${encodeURIComponent(value)}`;
};

const normalizeFormatValue = (value = '') => {
  const map = {
    cdrom: 'cd-rom',
    gdrom: 'gd-rom',
    arcade_pcb: 'arcade-pcb'
  };

  const normalized = String(value)
    .trim()
    .toLowerCase()
    .replace(/_/g, '-')
    .replace(/\s+/g, '-');

  return map[normalized] || normalized;
};

function getSafePlatformHref(platform) {
  const slug = getTaxonomySlug(platform);
  const manufacturerSlug = getTaxonomySlug(platform?.manufacturer);
  const platformType = platform?.platformType;

  if (!slug || !manufacturerSlug || !platformType) return '';

  return getPlatformUrl(
    {
      ...platform,
      slug,
      manufacturer: {
        ...(platform.manufacturer || {}),
        slug: manufacturerSlug
      }
    },
    lang
  );
}

function renderPlatformList(platforms) {
  return toTaxonomyArray(platforms)
    .map((platform) => ({
      label: getTaxonomyName(platform),
      href: getSafePlatformHref(platform)
    }))
    .filter((platform) => platform.label);
}

function renderArchiveTaxonomyList(items, key) {
  return toTaxonomyArray(items)
    .map((item) => {
      const slug = getTaxonomySlug(item);

      return {
        label: getTaxonomyName(item),
        href: slug ? getArchiveFilterUrl(key, slug) : ''
      };
    })
    .filter((item) => item.label);
}

function renderYearList(year) {
  if (!year) return [];

  const value = String(year);

  return [
    {
      label: value,
      href: getArchiveFilterUrl('year', value)
    }
  ];
}

const cover = post.gameInfo?.cover?.asset
  ? urlFor(post.gameInfo.cover)
      .width(720)
      .quality(78)
      .auto('format')
      .url()
  : '';

const coverAlt =
  post.gameInfo?.cover?.alt ||
  `${post.title} cover` ||
  '';

const rawMediaFormat = post.gameInfo?.mediaFormat;

function renderMediaFormatList(value) {
  return toTaxonomyArray(value)
    .map((format) => {
      const normalized = normalizeFormatValue(format);

      return {
        label: t.mediaFormats[format] || t.mediaFormats[normalized] || format,
        href: normalized ? getArchiveFilterUrl('format', normalized) : ''
      };
    })
    .filter((format) => format.label);
}

const infoRows = [
  {
    label: t.platform,
    value: renderPlatformList(post.platforms),
    type: 'taxonomyList'
  },
  {
    label: t.format,
    value: renderMediaFormatList(rawMediaFormat),
    type: 'taxonomyList'
  },
  {
    label: t.developer,
    value: renderTaxonomyList(post.developers, 'developers'),
    type: 'taxonomyList'
  },
  {
    label: t.publisher,
    value: renderTaxonomyList(post.publishers, 'publishers'),
    type: 'taxonomyList'
  },
  {
    label: lang === 'en' ? 'Manufacturer' : 'Produttore',
    value: renderTaxonomyList(post.manufacturer, 'manufacturer'),
    type: 'taxonomyList'
  },
  {
    label: t.creators,
    value: creators,
    type: 'creators'
  },
  {
    label: t.year,
    value: renderYearList(post.gameInfo?.releaseYear),
    type: 'taxonomyList'
  },
  {
    label: t.genre,
    value: renderArchiveTaxonomyList(post.genres, 'genre'),
    type: 'taxonomyList'
  },
  {
    label: t.mode,
    value: renderArchiveTaxonomyList(post.modes, 'mode'),
    type: 'taxonomyList'
  }
].filter((row) =>
  row.type === 'creators' || row.type === 'taxonomyList'
    ? row.value.length > 0
    : row.value
);
---

<div class={`review-sidebar ${!cover ? 'has-no-cover' : ''}`}>

  {cover && (
    <figure class="review-sidebar__cover">
      <img
        src={cover}
        alt={coverAlt}
        width="720"
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}

  <div class="review-sidebar__sticky">

    {post.rating && (
      <ReviewScoreBox rating={post.rating} compact lang={lang} />
    )}

    {infoRows.length > 0 && (
      <section class="review-sidebar__panel">
        <h2>{t.gameCard}</h2>

        <dl class="review-info-list">
          {infoRows.map((row) => (
            <div>
              <dt>{row.label}</dt>
              {row.type === 'creators' ? (
                <dd>
                  {row.value.map((creator, index) => (
                    <>
                      {index > 0 && ', '}
                      <a class="review-info-link" href={getCreatorUrl(creator)}>
                        {creator.name}
                      </a>
                    </>
                  ))}
                </dd>
              ) : row.type === 'taxonomyList' ? (
                <dd>
                  {row.value.map((item, index) => (
                    <>
                      {index > 0 && ', '}
                      {item.href ? (
                        <a class="review-info-link" href={item.href}>
                          {item.label}
                        </a>
                      ) : (
                        <>{item.label}</>
                      )}
                    </>
                  ))}
                </dd>
              ) : (
                <dd>{row.value}</dd>
              )}
            </div>
          ))}
        </dl>
      </section>
    )}

  </div>

</div>
