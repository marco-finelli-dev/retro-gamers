---
import '../../styles/article/article-reader-rating.css';

const {
  postId = '',
  editorialScore = null,
  lang = 'it'
} = Astro.props;

const isEn = lang === 'en';

const labels = isEn
  ? {
      cta: 'Rate it too',
      title: 'Reader rating',
      editorial: 'Retro-Gamers',
      yours: 'Your rating',
      readers: 'Readers',
      promptTitle: 'Have you played this title?',
      promptText: 'Leave your rating and compare it with our verdict.',
      loginText: 'Log in or register to vote.',
      noVotes: 'No reader ratings yet',
      editableNotice: 'You can change your rating for a few minutes after submitting it.',
      lockedNotice: 'Rating saved. It can no longer be changed.',
      yourRatingPrefix: 'Your rating:',
      alreadyVoted: 'You have already voted',
      submittedThanks: 'Thanks for your rating!',
      summarySingular: 'rating',
      summaryPlural: 'ratings',
      summaryFrom: 'from',
      firstCta: 'Be the first to rate it',
      comparisonSeparator: '·',
      voteSingular: 'vote',
      votePlural: 'votes',
      updated: 'Rating updated',
      login: 'Log in',
      register: 'Register',
      save: 'Save rating',
      update: 'Update rating',
      minus: 'Decrease rating',
      plus: 'Increase rating'
    }
  : {
      cta: 'Vota anche tu',
      title: 'Il voto dei lettori',
      editorial: 'Retro-Gamers',
      yours: 'Il tuo voto',
      readers: 'Lettori',
      promptTitle: 'Hai giocato questo titolo?',
      promptText: 'Lascia il tuo voto e confrontalo con quello della redazione.',
      loginText: 'Accedi o registrati per votare.',
      noVotes: 'Nessun voto dei lettori',
      editableNotice: 'Puoi modificare il voto per pochi minuti dopo l’invio.',
      lockedNotice: 'Voto registrato. Non è più modificabile.',
      yourRatingPrefix: 'Il tuo voto:',
      alreadyVoted: 'Hai già votato',
      submittedThanks: 'Grazie per il tuo voto!',
      summarySingular: 'voto',
      summaryPlural: 'voti',
      summaryFrom: 'da',
      firstCta: 'Vota per primo',
      comparisonSeparator: '·',
      voteSingular: 'voto',
      votePlural: 'voti',
      updated: 'Voto aggiornato',
      login: 'Accedi',
      register: 'Registrati',
      save: 'Salva voto',
      update: 'Aggiorna voto',
      minus: 'Diminuisci voto',
      plus: 'Aumenta voto'
    };

const loginHref = isEn ? '/en/account/login/' : '/account/login/';
const registerHref = isEn ? '/en/account/register/' : '/account/register/';

const formatScore = (value) => {
  const number = Number(value);

  if (!Number.isFinite(number)) {
    return '-';
  }

  return number.toFixed(1);
};

const clampScore = (value) => {
  const number = Number(value);

  if (!Number.isFinite(number)) {
    return 8;
  }

  const halfStep = Math.round(number * 2) / 2;
  return Math.min(10, Math.max(1, halfStep));
};

const initialScore = clampScore(editorialScore);
const editorialDisplay = formatScore(editorialScore);
const editorialComparison = `${labels.editorial} ${editorialDisplay}`;
const panelId = `reader-rating-panel-${String(postId || 'review')
  .replace(/[^a-zA-Z0-9_-]+/g, '-')
  .replace(/^-+|-+$/g, '')}`;
---

{postId && (
  <section
    class="article-reader-rating"
    data-reader-rating
    data-post-id={postId}
    data-lang={isEn ? 'en' : 'it'}
    data-default-score={initialScore}
    data-updated-label={labels.updated}
    data-no-votes-label={labels.noVotes}
    data-editable-notice-label={labels.editableNotice}
    data-locked-notice-label={labels.lockedNotice}
    data-your-rating-prefix-label={labels.yourRatingPrefix}
    data-summary-voted-label={labels.alreadyVoted}
    data-summary-success-label={labels.submittedThanks}
    data-summary-from-label={labels.summaryFrom}
    data-summary-singular-label={labels.summarySingular}
    data-summary-plural-label={labels.summaryPlural}
    data-summary-cta-label={labels.cta}
    data-summary-first-cta-label={labels.firstCta}
    data-editorial-label={labels.editorial}
    data-readers-label={labels.readers}
    data-comparison-separator={labels.comparisonSeparator}
    data-save-label={labels.save}
    data-update-label={labels.update}
    data-vote-singular={labels.voteSingular}
    data-vote-plural={labels.votePlural}
  >
    <details class="article-reader-rating__details" data-reader-rating-details>
      <summary
        class="article-reader-rating__toggle"
        aria-expanded="false"
        aria-controls={panelId}
        data-reader-rating-toggle
      >
        <span class="article-reader-rating__summary">
          <span class="article-reader-rating__label">{labels.title}</span>
          <strong data-reader-rating-summary>{labels.noVotes}</strong>
          <span class="article-reader-rating__user-state" data-reader-rating-user-state hidden></span>
        </span>

        <span class="article-reader-rating__action" data-reader-rating-action>
          {labels.firstCta}
        </span>
      </summary>

      <div class="article-reader-rating__panel" id={panelId}>
        <div class="article-reader-rating__intro">
          <h3>{labels.promptTitle}</h3>
          <p>{labels.promptText}</p>
          <p class="article-reader-rating__comparison" data-reader-rating-comparison>
            {editorialComparison}
          </p>
          <p class="article-reader-rating__edit-note" data-reader-rating-edit-note hidden></p>
        </div>

        <p class="article-reader-rating__count" data-reader-rating-count>
          {labels.noVotes}
        </p>

        <div class="article-reader-rating__vote" data-reader-rating-controls hidden>
          <span class="article-reader-rating__vote-label">{labels.yours}</span>

          <div class="article-reader-rating__stepper" role="group" aria-label={labels.yours}>
            <button type="button" data-reader-rating-minus aria-label={labels.minus}>−</button>
            <output data-reader-rating-selected>{formatScore(initialScore)}</output>
            <button type="button" data-reader-rating-plus aria-label={labels.plus}>+</button>
          </div>

          <button type="button" class="article-reader-rating__save" data-reader-rating-save>
            {labels.save}
          </button>
        </div>

        <div class="article-reader-rating__auth" data-reader-rating-auth hidden>
          <p>{labels.loginText}</p>
          <div>
            <a href={loginHref}>{labels.login}</a>
            <a href={registerHref}>{labels.register}</a>
          </div>
        </div>

        <p class="article-reader-rating__status" data-reader-rating-status aria-live="polite" hidden></p>
      </div>
    </details>
  </section>
)}

<script>
  import { trackRgEvent } from '../../lib/analytics/client';

  (() => {
    const formatScore = (value) => {
      const number = Number(value);

      if (!Number.isFinite(number)) {
        return '-';
      }

      return number.toFixed(1);
    };

    const clampScore = (value) => {
      const number = Number(value);

      if (!Number.isFinite(number)) {
        return 8;
      }

      const halfStep = Math.round(number * 2) / 2;
      return Math.min(10, Math.max(1, halfStep));
    };

    const updateVoteCount = (root, totalVotes) => {
      const count = root.querySelector('[data-reader-rating-count]');
      const noVotesLabel = root.dataset.noVotesLabel || 'No reader ratings yet';
      const voteSingular = root.dataset.voteSingular || 'vote';
      const votePlural = root.dataset.votePlural || 'votes';

      if (!count) return;

      if (!totalVotes) {
        count.textContent = noVotesLabel;
        return;
      }

      count.textContent = `${totalVotes} ${totalVotes === 1 ? voteSingular : votePlural}`;
    };

    const SUMMARY_SUCCESS_DURATION_MS = 4000;

    const initReaderRating = (root) => {
      if (root.dataset.readerRatingReady === 'true') {
        return;
      }

      root.dataset.readerRatingReady = 'true';

      const postId = root.dataset.postId || '';
      const articlePage = root.closest('[data-rg-article-page]');
      const articleSlug = articlePage instanceof HTMLElement
        ? articlePage.dataset.rgArticleSlug || ''
        : '';
      const controls = root.querySelector('[data-reader-rating-controls]');
      const auth = root.querySelector('[data-reader-rating-auth]');
      const details = root.querySelector('[data-reader-rating-details]');
      const toggle = root.querySelector('[data-reader-rating-toggle]');
      const minus = root.querySelector('[data-reader-rating-minus]');
      const plus = root.querySelector('[data-reader-rating-plus]');
      const selected = root.querySelector('[data-reader-rating-selected]');
      const save = root.querySelector('[data-reader-rating-save]');
      const summary = root.querySelector('[data-reader-rating-summary]');
      const action = root.querySelector('[data-reader-rating-action]');
      const userState = root.querySelector('[data-reader-rating-user-state]');
      const comparison = root.querySelector('[data-reader-rating-comparison]');
      const editNote = root.querySelector('[data-reader-rating-edit-note]');
      const status = root.querySelector('[data-reader-rating-status]');
      const updatedLabel = root.dataset.updatedLabel || 'Updated';

      let selectedScore = clampScore(root.dataset.defaultScore);
      let savedScore = null;
      let canUserEdit = true;
      let justSubmitted = false;
      let successTimeout = null;
      let latestSummaryData = null;

      const updateToggleState = () => {
        if (!toggle || !details) return;

        toggle.setAttribute('aria-expanded', String(details.open));
      };

      const setStatus = (message, isError = false) => {
        if (!status) return;

        status.textContent = message;
        status.hidden = !message;
        status.classList.toggle('is-error', Boolean(isError));
      };

      const renderSelected = () => {
        if (selected) {
          selected.textContent = formatScore(selectedScore);
        }

        if (minus) {
          minus.disabled = !canUserEdit || selectedScore <= 1;
        }

        if (plus) {
          plus.disabled = !canUserEdit || selectedScore >= 10;
        }

        if (save && !save.disabled) {
          save.disabled = !canUserEdit;
        }
      };

      const renderSummary = (data) => {
        latestSummaryData = data;

        const totalVotes = Number(data.totalVotes || 0);
        const hasAverage = totalVotes > 0 && data.averageScore !== null && data.averageScore !== undefined;
        savedScore = data.myScore === null || data.myScore === undefined
          ? null
          : Number(data.myScore);
        const hasUserRating = savedScore !== null;
        canUserEdit = !hasUserRating || data.canEditUserRating !== false;

        const summaryFromLabel = root.dataset.summaryFromLabel || 'from';
        const summarySingularLabel = root.dataset.summarySingularLabel || 'rating';
        const summaryPluralLabel = root.dataset.summaryPluralLabel || 'ratings';
        const noVotesLabel = root.dataset.noVotesLabel || 'No reader ratings yet';
        const summaryText = hasAverage
          ? `${formatScore(data.averageScore)} ${summaryFromLabel} ${totalVotes} ${totalVotes === 1 ? summarySingularLabel : summaryPluralLabel}`
          : noVotesLabel;

        if (summary) {
          summary.textContent = summaryText;
        }

        if (action) {
          action.textContent = justSubmitted
            ? (root.dataset.summarySuccessLabel || 'Thanks for your rating!')
            : hasUserRating
            ? (root.dataset.summaryVotedLabel || 'You have already voted')
            : (
                hasAverage
                  ? (root.dataset.summaryCtaLabel || 'Rate it too')
                  : (root.dataset.summaryFirstCtaLabel || 'Be the first to rate it')
              );
          action.classList.toggle('is-voted', hasUserRating && !justSubmitted);
          action.classList.toggle('is-success', justSubmitted);
        }

        if (comparison) {
          const editorialLabel = root.dataset.editorialLabel || 'Retro-Gamers';
          const readersLabel = root.dataset.readersLabel || 'Readers';
          const separator = root.dataset.comparisonSeparator || '·';
          comparison.textContent = hasAverage
            ? `${editorialLabel} ${formatScore(root.dataset.defaultScore)} ${separator} ${readersLabel} ${formatScore(data.averageScore)}`
            : `${editorialLabel} ${formatScore(root.dataset.defaultScore)}`;
        }

        updateVoteCount(root, totalVotes);

        selectedScore = savedScore === null
          ? selectedScore
          : clampScore(savedScore);

        if (save) {
          save.textContent = hasUserRating
            ? (root.dataset.updateLabel || 'Update rating')
            : (root.dataset.saveLabel || 'Save rating');
          save.disabled = !canUserEdit;
        }

        if (userState) {
          if (!data.isAuthenticated || !hasUserRating) {
            userState.hidden = true;
            userState.textContent = '';
            userState.classList.remove('is-locked');
          } else {
            const prefix = root.dataset.yourRatingPrefixLabel || 'Your rating:';
            const notice = canUserEdit
              ? (root.dataset.editableNoticeLabel || '')
              : (root.dataset.lockedNoticeLabel || 'Rating saved. It can no longer be changed.');
            userState.hidden = false;
            userState.textContent = notice
              ? `${prefix} ${formatScore(savedScore)}. ${notice}`
              : `${prefix} ${formatScore(savedScore)}.`;
            userState.classList.toggle('is-locked', !canUserEdit);
          }
        }

        if (editNote) {
          if (!data.isAuthenticated || !hasUserRating) {
            editNote.hidden = true;
            editNote.textContent = '';
            editNote.classList.remove('is-locked');
          } else if (canUserEdit) {
            editNote.hidden = false;
            editNote.textContent = root.dataset.editableNoticeLabel || '';
            editNote.classList.remove('is-locked');
          } else {
            const prefix = root.dataset.yourRatingPrefixLabel || 'Your rating:';
            const lockedNotice = root.dataset.lockedNoticeLabel || 'Rating saved. It can no longer be changed.';
            editNote.hidden = false;
            editNote.textContent = `${prefix} ${formatScore(savedScore)}. ${lockedNotice}`;
            editNote.classList.add('is-locked');
          }
        }

        if (data.isAuthenticated) {
          if (controls) controls.hidden = !canUserEdit;
          if (auth) auth.hidden = true;
        } else {
          if (controls) controls.hidden = true;
          if (auth) auth.hidden = false;
        }

        renderSelected();
      };

      const showSubmittedFeedback = () => {
        justSubmitted = true;

        if (successTimeout) {
          window.clearTimeout(successTimeout);
        }

        successTimeout = window.setTimeout(() => {
          justSubmitted = false;
          successTimeout = null;

          if (latestSummaryData) {
            renderSummary(latestSummaryData);
          }
        }, SUMMARY_SUCCESS_DURATION_MS);
      };

      const loadSummary = async () => {
        try {
          const response = await fetch(`/api/review-ratings?postId=${encodeURIComponent(postId)}`, {
            headers: {
              Accept: 'application/json'
            }
          });
          const data = await response.json();

          if (!response.ok) {
            throw new Error(data?.error || 'Rating unavailable.');
          }

          renderSummary(data);
        } catch (error) {
          setStatus(error?.message || 'Rating unavailable.', true);
          if (controls) controls.hidden = true;
          if (auth) auth.hidden = true;
        }
      };

      minus?.addEventListener('click', () => {
        selectedScore = clampScore(selectedScore - 0.5);
        setStatus('');
        renderSelected();
      });

      plus?.addEventListener('click', () => {
        selectedScore = clampScore(selectedScore + 0.5);
        setStatus('');
        renderSelected();
      });

      save?.addEventListener('click', async () => {
        save.disabled = true;
        setStatus('');

        try {
          const response = await fetch('/api/review-ratings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({
              postId,
              score: selectedScore,
              lang: root.dataset.lang || 'it'
            })
          });
          const data = await response.json();

          if (!response.ok) {
            if (data?.code === 'rating_edit_expired') {
              renderSummary(data);
              setStatus(data?.error || 'Rating not updated.', true);
              return;
            }

            throw new Error(data?.error || 'Rating not updated.');
          }

          showSubmittedFeedback();
          renderSummary(data);
          setStatus(updatedLabel);
          trackRgEvent('reader_vote_success', {
            language: root.dataset.lang === 'en' ? 'en' : 'it',
            article_slug: articleSlug,
            score: selectedScore,
          });
        } catch (error) {
          setStatus(error?.message || 'Rating not updated.', true);
        } finally {
          save.disabled = !canUserEdit;
        }
      });

      renderSelected();
      updateToggleState();
      details?.addEventListener('toggle', updateToggleState);
      loadSummary();
    };

    document
      .querySelectorAll('[data-reader-rating]')
      .forEach(initReaderRating);
  })();
</script>
