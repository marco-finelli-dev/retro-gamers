---
import ArticleHero from './ArticleHero.astro';
import ArticleContent from './ArticleContent.astro';
import ArticleLightbox from './ArticleLightbox.astro';
import ArticleReadingProgress from './ArticleReadingProgress.astro';
import ArticleSidebar from './ArticleSidebar.astro';
import ReviewSidebar from './ReviewSidebar.astro';
import ArticleFinalRating from './ArticleFinalRating.astro';
import ArticleProsCons from './ArticleProsCons.astro';
import ArticleAffiliateBox from './ArticleAffiliateBox.astro';
import SupportButton from '../common/SupportButton.astro';
import ArticleSeriesBox from './ArticleSeriesBox.astro';
import ArticleComments from './ArticleComments.astro';
import ArticleCommunityPrompt from './ArticleCommunityPrompt.astro';
import NewsletterPromo from '../newsletter/NewsletterPromo.astro';
import { getCanonicalReviewRatingPostId } from '../../lib/review-ratings';
import '../../styles/article/article.css';

const {
  post,
  relatedPosts = [],
  seriesPosts = [],
  comments = [],
  communityPreview = [],
  languageSwitch = null,
  hideNewsletterPromo = false
} = Astro.props;

const isReview = post?.type === 'review';
const currentLang = post?.language || 'it';
const heroCommentCount = Number(post?.commentCount || 0);
const heroCommentsLabel = currentLang === 'en'
  ? heroCommentCount > 0
    ? `${heroCommentCount} ${heroCommentCount === 1 ? 'reader memory' : 'reader memories'}`
    : 'Leave the first memory'
  : heroCommentCount > 0
    ? `${heroCommentCount} ${heroCommentCount === 1 ? 'memoria dei lettori' : 'memorie dei lettori'}`
    : 'Lascia il primo ricordo';
const heroCommentsAriaLabel = currentLang === 'en'
  ? `Go to reader memories: ${heroCommentsLabel}`
  : `Vai alle memorie dei lettori: ${heroCommentsLabel}`;
const reviewPros = Array.isArray(post?.pros)
  ? post.pros.filter((item) => typeof item === 'string' && item.trim())
  : [];
const reviewCons = Array.isArray(post?.cons)
  ? post.cons.filter((item) => typeof item === 'string' && item.trim())
  : [];
const hasReviewProsCons = isReview && (reviewPros.length > 0 || reviewCons.length > 0);
const reviewRatingPostId = isReview
  ? getCanonicalReviewRatingPostId(post)
  : '';

const articlePageClass = [
  'article-page',
  isReview ? 'is-review' : ''
].filter(Boolean).join(' ');

const switchCta =
  currentLang === 'en'
    ? '🇮🇹 Leggi in italiano'
    : '🇬🇧 Read in English';

const previewComments = Array.isArray(communityPreview)
  ? communityPreview.slice(0, 2)
  : [];
const hasCommunityPreview = previewComments.length > 0;
const getAuthorInitial = (name = '') =>
  String(name || '')
    .trim()
    .match(/[A-Za-zÀ-ÖØ-öø-ÿ0-9]/)?.[0]
    ?.toUpperCase() || 'R';
const commentsDiscovery = currentLang === 'en'
  ? {
      label: 'Reader memories',
      previewTitle: 'From the community',
      previewText: 'A few memories already shared by readers below this article.',
      previewCta: 'Read all memories',
      previewFooter: 'Do you have a memory too? Leave it below the article.',
      title: 'Do you have a memory tied to this article?',
      text:
        'Share it in the comments: on the site it stays with the piece instead of disappearing into the social feed.',
      cta: 'Go to comments'
    }
  : {
      label: 'Memorie dei lettori',
      previewTitle: 'Dalla community',
      previewText: 'Alcuni ricordi già lasciati dai lettori sotto questo articolo.',
      previewCta: 'Leggi tutte le memorie',
      previewFooter: 'Hai un ricordo anche tu? Lascialo sotto l’articolo.',
      title: 'Hai un ricordo legato a questo articolo?',
      text:
        'Raccontalo nei commenti: sul sito resta accanto al pezzo e non si perde nel flusso dei social.',
      cta: 'Vai ai commenti'
    };
---

<ArticleReadingProgress />

<main class={articlePageClass}>

  <ArticleHero post={post} />

  <div class="article-post-hero-actions">
    <div class="article-post-hero-actions__language">
      {languageSwitch?.url && (
        <a href={languageSwitch.url} class="article-language-switch">
          {switchCta}
        </a>
      )}
    </div>

    <div class="article-post-hero-actions__community">
      <a href="#comments" class="article-community-jump" aria-label={heroCommentsAriaLabel}>
        <span class="article-community-jump__icon" aria-hidden="true"></span>
        <span>{heroCommentsLabel}</span>
      </a>
    </div>
  </div>

  <div class="article-page__body">

    <article class="article-page__content">

     {post.monetization?.isAffiliate && (
  <aside class="affiliate-disclosure">
    <span>
      {currentLang === 'en' ? 'Transparency' : 'Trasparenza'}
    </span>

    <p>
      {currentLang === 'en'
        ? 'This article may contain affiliate links. If you buy through these links, Retro-Gamers.it may receive a small commission, at no additional cost to you.'
        : 'Questo articolo può contenere link affiliati. Se acquisti tramite questi collegamenti, Retro-Gamers.it può ricevere una piccola commissione, senza costi aggiuntivi per te.'}
    </p>
  </aside>
)}

      <ArticleAffiliateBox post={post} />

      <ArticleContent content={post.content} lang={currentLang} />

       <ArticleSeriesBox post={post} seriesPosts={seriesPosts} />

      {isReview && post.rating && (

        <ArticleFinalRating
          rating={post.rating}
          lang={currentLang}
          readerRatingPostId={reviewRatingPostId}
        />

      )}

      {hasReviewProsCons && (
        <ArticleProsCons pros={reviewPros} cons={reviewCons} lang={currentLang} />
      )}

      <SupportButton lang={currentLang} variant="box" />

      {!hideNewsletterPromo && <NewsletterPromo lang={currentLang} variant="article-end" />}

      <ArticleLightbox />

    </article>

       <aside class="article-page__sidebar">
      {isReview ? (
        <ReviewSidebar post={post} relatedPosts={relatedPosts} />
      ) : (
        <ArticleSidebar
          post={post}
          relatedPosts={relatedPosts}
          hideNewsletterPromo={hideNewsletterPromo}
        />
      )}
    </aside>

  </div>

  <aside
    class:list={[
      'article-comments-discovery',
      hasCommunityPreview && 'article-comments-discovery--with-preview'
    ]}
    aria-labelledby="article-comments-discovery-title"
  >
    {hasCommunityPreview ? (
      <>
        <div class="article-comments-discovery__header">
          <div>
            <span class="article-comments-discovery__label">{commentsDiscovery.label}</span>
            <h2 id="article-comments-discovery-title">{commentsDiscovery.previewTitle}</h2>
            <p>{commentsDiscovery.previewText}</p>
          </div>

          <a href="#comments">{commentsDiscovery.previewCta}</a>
        </div>

        <div class="article-comments-discovery__preview" aria-label={commentsDiscovery.previewTitle}>
          {previewComments.map((comment) => (
            <article class="article-comments-discovery__card">
              {comment.authorProfileUrl ? (
                <a
                  href={comment.authorProfileUrl}
                  class="article-comments-discovery__avatar"
                  aria-label={comment.authorName}
                >
                  {comment.avatarUrl ? (
                    <img
                      src={comment.avatarUrl}
                      alt=""
                      width="42"
                      height="42"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span>{getAuthorInitial(comment.authorName)}</span>
                  )}
                </a>
              ) : (
                <span class="article-comments-discovery__avatar" aria-hidden="true">
                  {comment.avatarUrl ? (
                    <img
                      src={comment.avatarUrl}
                      alt=""
                      width="42"
                      height="42"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span>{getAuthorInitial(comment.authorName)}</span>
                  )}
                </span>
              )}

              <div>
                <strong>{comment.authorName}</strong>
                <p>{comment.excerpt}</p>
              </div>
            </article>
          ))}
        </div>

        <p class="article-comments-discovery__footer">{commentsDiscovery.previewFooter}</p>
      </>
    ) : (
      <>
        <div>
          <span class="article-comments-discovery__label">{commentsDiscovery.label}</span>
          <h2 id="article-comments-discovery-title">{commentsDiscovery.title}</h2>
          <p>{commentsDiscovery.text}</p>
        </div>

        <a href="#comments">{commentsDiscovery.cta}</a>
      </>
    )}
  </aside>

  <ArticleComments post={post} comments={comments} />

</main>

<ArticleCommunityPrompt lang={currentLang} />
