---
import ArticleHero from './ArticleHero.astro';
import ArticleContent from './ArticleContent.astro';
import ArticleLightbox from './ArticleLightbox.astro';
import ArticleReadingProgress from './ArticleReadingProgress.astro';
import ArticleSidebar from './ArticleSidebar.astro';
import ReviewSidebar from './ReviewSidebar.astro';
import ArticleFinalRating from './ArticleFinalRating.astro';
import ArticleProsCons from './ArticleProsCons.astro';
import ArticleAffiliateBox from './ArticleAffiliateBox.astro';
import SupportButton from '../common/SupportButton.astro';
import ArticleSeriesBox from './ArticleSeriesBox.astro';
import ArticleComments from './ArticleComments.astro';
import ArticleCommunityPrompt from './ArticleCommunityPrompt.astro';
import NewsletterPromo from '../newsletter/NewsletterPromo.astro';
import { getCanonicalReviewRatingPostId } from '../../lib/review-ratings';
import { getContentDetailSegment } from '../../lib/routes.js';
import '../../styles/article/article.css';

const {
  post,
  relatedPosts = [],
  seriesPosts = [],
  comments = [],
  languageSwitch = null,
  isPreview = false,
  hideNewsletterPromo = false
} = Astro.props;

const isReview = post?.type === 'review';
const currentLang = post?.language || 'it';
const heroCommentCount = Number(post?.commentCount || 0);
const heroCommentsLabel = currentLang === 'en'
  ? heroCommentCount > 0
    ? `${heroCommentCount} ${heroCommentCount === 1 ? 'reader memory' : 'reader memories'}`
    : 'Leave the first memory'
  : heroCommentCount > 0
    ? `${heroCommentCount} ${heroCommentCount === 1 ? 'memoria dei lettori' : 'memorie dei lettori'}`
    : 'Lascia il primo ricordo';
const heroCommentsAriaLabel = currentLang === 'en'
  ? `Go to reader memories: ${heroCommentsLabel}`
  : `Vai alle memorie dei lettori: ${heroCommentsLabel}`;
const reviewPros = Array.isArray(post?.pros)
  ? post.pros.filter((item) => typeof item === 'string' && item.trim())
  : [];
const reviewCons = Array.isArray(post?.cons)
  ? post.cons.filter((item) => typeof item === 'string' && item.trim())
  : [];
const hasReviewProsCons = isReview && (reviewPros.length > 0 || reviewCons.length > 0);
const reviewRatingPostId = isReview
  ? getCanonicalReviewRatingPostId(post)
  : '';
const getAnalyticsToken = (value) =>
  String(value || '')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
const getSlug = (value) =>
  typeof value === 'string'
    ? value
    : value?.current || '';
const articleAnalyticsLanguage = currentLang === 'en' ? 'en' : 'it';
const articleAnalyticsContentType = getAnalyticsToken(post?.type || 'article');
const articleAnalyticsCategorySlug =
  getAnalyticsToken(getContentDetailSegment(post?.type, articleAnalyticsLanguage)) ||
  articleAnalyticsContentType;
const articleAnalyticsSlug = getAnalyticsToken(getSlug(post?.slug));
const articleAnalyticsAuthorSlug = getAnalyticsToken(getSlug(post?.author?.slug));

const articlePageClass = [
  'article-page',
  isReview ? 'is-review' : ''
].filter(Boolean).join(' ');

const switchCta =
  currentLang === 'en'
    ? '🇮🇹 Leggi in italiano'
    : '🇬🇧 Read in English';
const switchLanguage =
  languageSwitch?.language === 'en'
    ? 'en'
    : languageSwitch?.language === 'it'
      ? 'it'
      : currentLang === 'en'
        ? 'it'
        : 'en';

const commentsDiscovery = currentLang === 'en'
  ? {
      label: 'Reader memories',
      title: 'Do you have a memory tied to this article?',
      text:
        'Share it in the comments: on the site it stays with the piece instead of disappearing into the social feed.',
      cta: 'Go to comments'
    }
  : {
      label: 'Memorie dei lettori',
      title: 'Hai un ricordo legato a questo articolo?',
      text:
        'Raccontalo nei commenti: sul sito resta accanto al pezzo e non si perde nel flusso dei social.',
      cta: 'Vai ai commenti'
    };
---

<ArticleReadingProgress />

<div
  class={articlePageClass}
  data-rg-article-page
  data-rg-article-language={articleAnalyticsLanguage}
  data-rg-article-content-type={articleAnalyticsContentType}
  data-rg-article-category-slug={articleAnalyticsCategorySlug}
  data-rg-article-slug={articleAnalyticsSlug}
  data-rg-article-author-slug={articleAnalyticsAuthorSlug || undefined}
>

  <ArticleHero post={post} />

  <div class="article-post-hero-actions">
    <div class="article-post-hero-actions__language">
      {languageSwitch?.url && (
        <a
          href={languageSwitch.url}
          class="article-language-switch"
          data-language-session-override={switchLanguage}
        >
          {switchCta}
        </a>
      )}
    </div>

    <div class="article-post-hero-actions__community">
      <a href="#comments" class="article-community-jump" aria-label={heroCommentsAriaLabel}>
        <span class="article-community-jump__icon" aria-hidden="true"></span>
        <span>{heroCommentsLabel}</span>
      </a>
    </div>
  </div>

  <div class="article-page__body">

    <article class="article-page__content">

     {post.monetization?.isAffiliate && (
  <aside class="affiliate-disclosure">
    <span>
      {currentLang === 'en' ? 'Transparency' : 'Trasparenza'}
    </span>

    <p>
      {currentLang === 'en'
        ? 'This article may contain affiliate links. If you buy through these links, Retro-Gamers.it may receive a small commission, at no additional cost to you.'
        : 'Questo articolo può contenere link affiliati. Se acquisti tramite questi collegamenti, Retro-Gamers.it può ricevere una piccola commissione, senza costi aggiuntivi per te.'}
    </p>
  </aside>
)}

      <ArticleAffiliateBox post={post} />

      <ArticleContent
        content={post.content}
        lang={currentLang}
        isPreview={isPreview}
        articleSlug={articleAnalyticsSlug}
        contentType={articleAnalyticsContentType}
      />

      <aside
        class="article-comments-discovery article-comments-discovery--article-end"
        aria-labelledby="article-comments-invite-title"
      >
        <div>
          <span class="article-comments-discovery__label">{commentsDiscovery.label}</span>
          <h2 id="article-comments-invite-title">{commentsDiscovery.title}</h2>
          <p>{commentsDiscovery.text}</p>
        </div>

        <a href="#comments">{commentsDiscovery.cta}</a>
      </aside>

       <ArticleSeriesBox post={post} seriesPosts={seriesPosts} />

      {isReview && post.rating && (

        <ArticleFinalRating
          rating={post.rating}
          lang={currentLang}
          readerRatingPostId={reviewRatingPostId}
        />

      )}

      {hasReviewProsCons && (
        <ArticleProsCons pros={reviewPros} cons={reviewCons} lang={currentLang} />
      )}

      <SupportButton lang={currentLang} variant="box" />

      {!hideNewsletterPromo && <NewsletterPromo lang={currentLang} variant="article-end" />}

    </article>

       <aside class="article-page__sidebar">
      {isReview ? (
        <ReviewSidebar post={post} relatedPosts={relatedPosts} />
      ) : (
        <ArticleSidebar
          post={post}
          relatedPosts={relatedPosts}
          hideNewsletterPromo={hideNewsletterPromo}
        />
      )}
    </aside>

  </div>

  <ArticleComments post={post} comments={comments} />

</div>

<ArticleLightbox lang={currentLang} />

<ArticleCommunityPrompt lang={currentLang} />

<script>
  import { trackRgEvent } from '../../lib/analytics/client';

  const getAffiliateProvider = (value) => {
    if (value === 'amazon' || value === 'ebay' || value === 'gog' || value === 'other') {
      return value;
    }

    return 'other';
  };

  const getAffiliatePlacement = (value) => {
    if (
      value === 'affiliate_box' ||
      value === 'article_body' ||
      value === 'hardware_card' ||
      value === 'product_cta'
    ) {
      return value;
    }

    return 'article_body';
  };

  document.querySelectorAll('[data-rg-article-page]').forEach((articlePage) => {
    if (!(articlePage instanceof HTMLElement)) return;

    const language = articlePage.dataset.rgArticleLanguage === 'en' ? 'en' : 'it';
    const contentType = articlePage.dataset.rgArticleContentType || '';
    const categorySlug = articlePage.dataset.rgArticleCategorySlug || '';
    const articleSlug = articlePage.dataset.rgArticleSlug || '';
    const authorSlug = articlePage.dataset.rgArticleAuthorSlug || '';

    if (
      articlePage.dataset.rgArticleViewTracked !== 'true' &&
      contentType &&
      categorySlug &&
      articleSlug
    ) {
      articlePage.dataset.rgArticleViewTracked = 'true';

      trackRgEvent('article_view', {
        language,
        content_type: contentType,
        category_slug: categorySlug,
        article_slug: articleSlug,
        ...(authorSlug ? { author_slug: authorSlug } : {}),
      });
    }

    if (articlePage.dataset.rgAffiliateListenerAttached === 'true') return;

    articlePage.dataset.rgAffiliateListenerAttached = 'true';

    articlePage.addEventListener('click', (event) => {
      const affiliateLink = event.target instanceof Element
        ? event.target.closest('[data-rg-affiliate-link]')
        : null;

      if (!(affiliateLink instanceof HTMLAnchorElement)) return;
      if (!articlePage.contains(affiliateLink)) return;

      trackRgEvent('affiliate_click', {
        language: affiliateLink.dataset.rgAffiliateLanguage === 'en' ? 'en' : 'it',
        provider: getAffiliateProvider(affiliateLink.dataset.rgAffiliateProvider),
        placement: getAffiliatePlacement(affiliateLink.dataset.rgAffiliatePlacement),
        ...(affiliateLink.dataset.rgAffiliateArticleSlug || articleSlug
          ? { article_slug: affiliateLink.dataset.rgAffiliateArticleSlug || articleSlug }
          : {}),
        ...(affiliateLink.dataset.rgAffiliateContentType || contentType
          ? { content_type: affiliateLink.dataset.rgAffiliateContentType || contentType }
          : {}),
      });
    });
  });
</script>
