---
import ArticleHero from './ArticleHero.astro';
import ArticleContent from './ArticleContent.astro';
import ArticleLightbox from './ArticleLightbox.astro';
import ArticleSidebar from './ArticleSidebar.astro';
import ReviewSidebar from './ReviewSidebar.astro';
import ArticleFinalRating from './ArticleFinalRating.astro';
import ArticleAffiliateBox from './ArticleAffiliateBox.astro';
import ArticleSeriesBox from './ArticleSeriesBox.astro';
import '../../styles/article/article.css';

const {
  post,
  relatedPosts = [],
  seriesPosts = []
} = Astro.props;

const isReview = post?.type === 'review';
---

<main class={`article-page ${isReview ? 'is-review' : ''}`}>

  <ArticleHero post={post} />

  <div class="article-page__body">

    <article class="article-page__content">

      {post.monetization?.isAffiliate && (
        <aside class="affiliate-disclosure">
          <span>Trasparenza</span>

          <p>
            Questo articolo può contenere link affiliati. Se acquisti tramite questi collegamenti,
            Retro-Gamers.it può ricevere una piccola commissione, senza costi aggiuntivi per te.
          </p>
        </aside>
      )}

      <ArticleAffiliateBox post={post} />

      <ArticleContent content={post.content} />

<ArticleSeriesBox post={post} seriesPosts={seriesPosts} />

{isReview && post.rating && (
  <ArticleFinalRating rating={post.rating} />
)}

<ArticleLightbox />

    </article>

    <aside class="article-page__sidebar">
      {isReview ? (
        <ReviewSidebar post={post} relatedPosts={relatedPosts} />
      ) : (
        <ArticleSidebar post={post} relatedPosts={relatedPosts} />
      )}
    </aside>

  </div>

</main>