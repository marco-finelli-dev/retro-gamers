---
import ArticleReaderRating from './ArticleReaderRating.astro';
import ReviewScoreRing from '../reviews/ReviewScoreRing.astro';

const { rating, lang = 'it', readerRatingPostId = '' } = Astro.props;

const score = rating?.overall;
const numericScore = Number(score);
const hasOverallScore = score !== null && score !== undefined && Number.isFinite(numericScore);
const isEditorsChoice = hasOverallScore && numericScore >= 9;
const editorChoiceAlt = lang === 'en' ? "Editor's Choice" : 'Scelta della redazione';

const labels = {
  it: {
    kicker: 'Verdetto',
    title: 'Il giudizio finale',
    technical: 'Valutazioni',
    graphics: 'Grafica',
    sound: 'Sonoro',
    gameplay: 'Gameplay',
    longevity: 'Longevità',
    total: 'Totale'
  },
  en: {
    kicker: 'Verdict',
    title: 'Final verdict',
    technical: 'Ratings',
    graphics: 'Graphics',
    sound: 'Sound',
    gameplay: 'Gameplay',
    longevity: 'Longevity',
    total: 'Total'
  }
};

const t = labels[lang] || labels.it;
const technicalRatings = [
  { label: t.graphics, value: rating?.grafica },
  { label: t.sound, value: rating?.sonoro },
  { label: t.gameplay, value: rating?.giocabilita },
  { label: t.longevity, value: rating?.longevita }
].filter((item) => Number.isFinite(Number(item.value)));
---

<section class="article-final-rating">

  <div class="article-final-rating__content">

    <div class="article-final-rating__heading">
      <span>{t.kicker}</span>
      <h2>{t.title}</h2>
    </div>

    {(rating?.summary || technicalRatings.length > 0 || hasOverallScore) && (
      <div class="article-final-rating__body">
        {(technicalRatings.length > 0 || hasOverallScore) && (
          <section class="article-final-rating__ratings" aria-labelledby="article-final-rating-ratings-title">
            <div class="article-final-rating__ratings-heading">
              <h3 id="article-final-rating-ratings-title">{t.technical}</h3>
              {isEditorsChoice && (
                <span class="article-final-rating__editor-choice">
                  <img
                    src="/images/badges/editor-choice-ivory.svg"
                    alt={editorChoiceAlt}
                    class="article-final-rating__editor-choice-asset article-final-rating__editor-choice-asset--light"
                    width="850"
                    height="639"
                    decoding="async"
                  />
                  <img
                    src="/images/badges/editor-choice-navy.svg"
                    alt={editorChoiceAlt}
                    class="article-final-rating__editor-choice-asset article-final-rating__editor-choice-asset--dark"
                    width="850"
                    height="639"
                    decoding="async"
                  />
                </span>
              )}
            </div>
            {technicalRatings.length > 0 && (
              <dl>
                {technicalRatings.map((item) => (
                  <div>
                    <dt>{item.label}</dt>
                    <dd>{Number(item.value).toFixed(1)}</dd>
                  </div>
                ))}
              </dl>
            )}
            {hasOverallScore && (
              <div class="article-final-rating__total">
                <span class="article-final-rating__total-label">{t.total}</span>
                <ReviewScoreRing score={numericScore} lang={lang} size="compact" />
              </div>
            )}
          </section>
        )}

        {rating?.summary && (
          <div class="article-final-rating__summary">
            <p>{rating.summary}</p>
          </div>
        )}
      </div>
    )}

    {readerRatingPostId && (
      <ArticleReaderRating
        postId={readerRatingPostId}
        editorialScore={numericScore}
        lang={lang}
      />
    )}

  </div>

</section>
