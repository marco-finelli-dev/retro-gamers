---
const { lang = 'it' } = Astro.props;
const isEnglish = lang === 'en';

const labels = isEnglish
  ? {
      close: 'Close enlarged image',
      dialog: 'Enlarged image',
      open: 'Open enlarged image',
      previous: 'Previous image',
      next: 'Next image'
    }
  : {
      close: 'Chiudi immagine',
      dialog: 'Immagine ingrandita',
      open: 'Apri immagine ingrandita',
      previous: 'Immagine precedente',
      next: 'Immagine successiva'
    };
---

<div
  class="article-lightbox"
  data-article-lightbox
  data-lightbox-open-label={labels.open}
  data-lightbox-previous-label={labels.previous}
  data-lightbox-next-label={labels.next}
  hidden
>
  <button
    class="article-lightbox__backdrop"
    type="button"
    data-lightbox-close
    aria-label={labels.close}
  ></button>

  <div class="article-lightbox__stage" role="dialog" aria-modal="true" aria-label={labels.dialog}>
    <button
      class="article-lightbox__close"
      type="button"
      data-lightbox-close
      aria-label={labels.close}
    >
      ×
    </button>

    <button
      class="article-lightbox__nav article-lightbox__nav--previous"
      type="button"
      data-lightbox-previous
      aria-label={labels.previous}
      hidden
    >
      ‹
    </button>

    <img
      src=""
      alt=""
      class="article-lightbox__image"
      data-lightbox-image
    />

    <button
      class="article-lightbox__nav article-lightbox__nav--next"
      type="button"
      data-lightbox-next
      aria-label={labels.next}
      hidden
    >
      ›
    </button>

    <p class="article-lightbox__caption" data-lightbox-caption hidden></p>
  </div>
</div>

<script is:inline>
  (() => {
    const lightbox = document.querySelector('[data-article-lightbox]');
    if (!lightbox) return;

    const image = lightbox.querySelector('[data-lightbox-image]');
    const caption = lightbox.querySelector('[data-lightbox-caption]');
    const closeButtons = lightbox.querySelectorAll('[data-lightbox-close]');
    const previousButton = lightbox.querySelector('[data-lightbox-previous]');
    const nextButton = lightbox.querySelector('[data-lightbox-next]');
    const openLabel =
      lightbox.getAttribute('data-lightbox-open-label') ||
      'Apri immagine ingrandita';

    const candidates = document.querySelectorAll('.js-article-lightbox-image');

    if (!candidates.length) return;

    let lastFocusedElement = null;
    let activeItems = [];
    let activeIndex = -1;
    let touchStartX = 0;
    let touchStartY = 0;

    const getItemData = (img) => {
      const fullSrc =
        img.dataset.fullsrc ||
        img.currentSrc ||
        img.src;

      const captionText =
        img.dataset.caption ||
        img.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ||
        '';

      return {
        src: fullSrc,
        alt: img.alt || '',
        caption: captionText
      };
    };

    const updateNavigation = () => {
      const hasGallery = activeItems.length > 1;

      if (previousButton) {
        previousButton.hidden = !hasGallery;
      }

      if (nextButton) {
        nextButton.hidden = !hasGallery;
      }
    };

    const renderItem = (img) => {
      const item = getItemData(img);

      image.src = item.src;
      image.alt = item.alt;

      if (item.caption) {
        caption.textContent = item.caption;
        caption.hidden = false;
      } else {
        caption.textContent = '';
        caption.hidden = true;
      }
    };

    const getGalleryItems = (img) => {
      const group = img.dataset.lightboxGroup;

      if (!group) {
        return [img];
      }

      return Array
        .from(candidates)
        .filter((candidate) => candidate.dataset.lightboxGroup === group)
        .sort((a, b) => {
          const aIndex = Number.parseInt(a.dataset.lightboxIndex || '0', 10);
          const bIndex = Number.parseInt(b.dataset.lightboxIndex || '0', 10);

          return aIndex - bIndex;
        });
    };

    const showAt = (index) => {
      if (activeItems.length < 2) return;

      const nextIndex =
        (index + activeItems.length) % activeItems.length;

      activeIndex = nextIndex;
      renderItem(activeItems[activeIndex]);
    };

    const showPrevious = () => {
      showAt(activeIndex - 1);
    };

    const showNext = () => {
      showAt(activeIndex + 1);
    };

    const open = (img) => {
      lastFocusedElement = document.activeElement;
      activeItems = getGalleryItems(img);
      activeIndex = Math.max(activeItems.indexOf(img), 0);

      renderItem(activeItems[activeIndex] || img);
      updateNavigation();

      lightbox.hidden = false;
      document.documentElement.classList.add('has-lightbox-open');

      const closeButton = lightbox.querySelector('.article-lightbox__close');
      closeButton?.focus();
    };

    const close = () => {
      lightbox.hidden = true;
      image.src = '';
      image.alt = '';
      caption.textContent = '';
      caption.hidden = true;
      activeItems = [];
      activeIndex = -1;
      touchStartX = 0;
      touchStartY = 0;
      updateNavigation();

      document.documentElement.classList.remove('has-lightbox-open');

      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      }

      lastFocusedElement = null;
    };

    candidates.forEach((img) => {
      img.classList.add('is-lightboxable');
      img.setAttribute('tabindex', '0');
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', openLabel);

      img.addEventListener('click', () => open(img));

      img.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open(img);
        }
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', close);
    });

    previousButton?.addEventListener('click', showPrevious);
    nextButton?.addEventListener('click', showNext);

    lightbox.addEventListener('touchstart', (event) => {
      if (activeItems.length < 2 || event.touches.length !== 1) return;

      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
    }, { passive: true });

    lightbox.addEventListener('touchend', (event) => {
      if (activeItems.length < 2 || !touchStartX || event.changedTouches.length !== 1) return;

      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;

      touchStartX = 0;
      touchStartY = 0;

      if (Math.abs(deltaX) < 48 || Math.abs(deltaX) < Math.abs(deltaY) * 1.4) {
        return;
      }

      if (deltaX < 0) {
        showNext();
      } else {
        showPrevious();
      }
    }, { passive: true });

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;

      if (event.key === 'Escape') {
        close();
        return;
      }

      if (activeItems.length > 1 && event.key === 'ArrowLeft') {
        event.preventDefault();
        showPrevious();
        return;
      }

      if (activeItems.length > 1 && event.key === 'ArrowRight') {
        event.preventDefault();
        showNext();
        return;
      }

      if (event.key === 'Tab') {
        const focusable = Array
          .from(lightbox.querySelectorAll('button:not([hidden])'))
          .filter((button) => !button.disabled);

        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
          return;
        }

        if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
