---
import { getRgAffiliateProviderFromUrl } from '../../lib/analytics/client';

const { post, products = null } = Astro.props;

const lang = post?.language || 'it';
const monetization = post?.monetization || {};
const scopedProducts = Array.isArray(products) ? products : null;
const getAnalyticsToken = (value) =>
  String(value || '')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_-]+/g, '-')
    .replace(/^-+|-+$/g, '');

const labels = {
  it: {
    defaultAffiliateLabel: 'Vai all’offerta',
    defaultDescription:
      'Una proposta collegata al tema dell’articolo, utile per approfondire o rivivere l’esperienza originale.',
    recommendedTitle: 'Prodotto consigliato',
    productTypeLabels: {
      book: 'Libro',
      hardware: 'Hardware',
      accessory: 'Accessorio',
      software: 'Software',
      gadget: 'Gadget',
      service: 'Servizio',
      other: 'Consigliato'
    },
    defaultProductType: 'Consigliato'
  },

  en: {
    defaultAffiliateLabel: 'View product',
    defaultDescription:
      'A suggested product related to the topic of this article, useful for further reading or completing your retro setup.',
    recommendedTitle: 'Recommended product',
    productTypeLabels: {
      book: 'Book',
      hardware: 'Hardware',
      accessory: 'Accessory',
      software: 'Software',
      gadget: 'Gadget',
      service: 'Service',
      other: 'Recommended'
    },
    defaultProductType: 'Recommended'
  }
};

const t = labels[lang] || labels.it;

const articleSlug = getAnalyticsToken(
  typeof post?.slug === 'string' ? post.slug : post?.slug?.current
);
const contentType = getAnalyticsToken(post?.type || 'article');

const normalizeOffer = (offer, index) => {
  const affiliateUrl = String(offer?.affiliateUrl || '').trim();

  if (!affiliateUrl || offer?.isActive === false) return null;

  const label = String(offer?.label || '').trim();
  const affiliateLabel =
    String(offer?.affiliateLabel || '').trim() ||
    label ||
    t.defaultAffiliateLabel;

  return {
    key: offer?._key || `offer-${index}`,
    label,
    displayLabel: label || affiliateLabel,
    retailer: String(offer?.retailer || '').trim(),
    affiliateUrl,
    affiliateProvider: getRgAffiliateProviderFromUrl(affiliateUrl),
    affiliateLabel,
    priceLabel: String(offer?.priceLabel || '').trim(),
    isPrimary: offer?.isPrimary === true,
  };
};

const normalizeProduct = (product, index) => {
  const offers = Array.isArray(product?.offers)
    ? product.offers
        .map((offer, offerIndex) => normalizeOffer(offer, offerIndex))
        .filter(Boolean)
        .sort((a, b) => Number(b.isPrimary) - Number(a.isPrimary))
    : [];

  if (offers.length === 0) return null;

  return {
    key: product?._key || `product-${index}`,
    name: String(product?.name || '').trim() || t.recommendedTitle,
    description: String(product?.description || '').trim() || t.defaultDescription,
    productType:
      t.productTypeLabels[product?.productType] ||
      t.defaultProductType,
    offers,
  };
};

const newProducts = Array.isArray(scopedProducts || monetization.products)
  ? (scopedProducts || monetization.products)
      .map((product, index) => normalizeProduct(product, index))
      .filter(Boolean)
  : [];

const legacyAffiliateUrl = String(monetization.affiliateUrl || '').trim();
const legacyProducts = legacyAffiliateUrl
  ? [
      {
        key: 'legacy-product',
        name: t.recommendedTitle,
        description:
          String(monetization.affiliateDescription || '').trim() ||
          t.defaultDescription,
        productType:
          t.productTypeLabels[monetization.productType] ||
          t.defaultProductType,
        offers: [
          {
            key: 'legacy-offer',
            label: '',
            retailer: '',
            affiliateUrl: legacyAffiliateUrl,
            affiliateProvider: getRgAffiliateProviderFromUrl(legacyAffiliateUrl),
            affiliateLabel:
              String(monetization.affiliateLabel || '').trim() ||
              t.defaultAffiliateLabel,
            priceLabel: String(monetization.priceLabel || '').trim(),
            isPrimary: true,
          },
        ],
      },
    ]
  : [];

const affiliateProducts = scopedProducts ? newProducts : newProducts.length > 0 ? newProducts : legacyProducts;
const isVisible = monetization.isAffiliate && affiliateProducts.length > 0;
---

{isVisible && (
  <aside class="affiliate-box">

    {affiliateProducts.map((product) => (
      <div class="affiliate-box__product">
        <div class="affiliate-box__content">
          <span>{product.productType}</span>

          <h2>
            {product.name}
          </h2>

          <p>{product.description}</p>
        </div>

        <div class="affiliate-box__offers">
          {product.offers.map((offer) => (
            <div class="affiliate-box__offer">
              <div class="affiliate-box__offer-meta">
                {offer.displayLabel && <strong>{offer.displayLabel}</strong>}
                {offer.retailer && <span>{offer.retailer}</span>}
                {offer.priceLabel && (
                  <em class="affiliate-box__price">
                    {offer.priceLabel}
                  </em>
                )}
              </div>

              <a
                href={offer.affiliateUrl}
                target="_blank"
                rel="sponsored nofollow noopener noreferrer"
                data-rg-affiliate-link
                data-rg-affiliate-language={lang === 'en' ? 'en' : 'it'}
                data-rg-affiliate-provider={offer.affiliateProvider}
                data-rg-affiliate-placement="affiliate_box"
                data-rg-affiliate-article-slug={articleSlug || undefined}
                data-rg-affiliate-content-type={contentType || undefined}
              >
                {offer.affiliateLabel}
              </a>
            </div>
          ))}
        </div>
      </div>
    ))}

  </aside>
)}
