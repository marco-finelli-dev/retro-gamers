---
import { urlFor } from '../../lib/image';
import { getPostUrl } from '../../lib/routes';
import ReviewScoreRing from '../reviews/ReviewScoreRing.astro';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const { post, lang = 'it', variant = 'compact', metadataVariant = 'default' } = Astro.props;

const isEn = lang === 'en';
const isFeature = variant === 'feature';
const isHomeReviews = metadataVariant === 'home-reviews';

if (!post) return;

const getImage = (post, width = 520, height = 390) => {
  if (!post?.featuredImage?.asset) return '/og-image.jpg';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const getTaxonomyLabel = (item) => {
  if (!item) return '';

  return isEn
    ? item.nameEn || item.name
    : item.name;
};

const homeReviewMetadata = [
  getTaxonomyLabel(post.platforms?.[0]),
  getTaxonomyLabel(post.publishers?.[0]),
  post.gameInfo?.releaseYear ? String(post.gameInfo.releaseYear) : ''
].filter(Boolean);
const reviewLabel = isEn ? 'Review' : 'Recensione';
const rating = Number(post.rating?.overall);
const isEditorsChoice = Number.isFinite(rating) && rating >= 9;
const showEditorsChoice = true;

const cleanText = (value) =>
  typeof value === 'string'
    ? value.replace(/\[…\]/g, '').trim()
    : '';

const excerpt =
  cleanText(post.cardExcerpt) ||
  cleanText(post.excerpt) ||
  cleanText(post.subtitle);

const imageWidth = isFeature ? 840 : 520;
const imageHeight = isFeature ? 630 : 390;

---

<a
  href={getPostUrl(post)}
  class:list={['rg-review-card', 'rg-editorial-link', `rg-review-card--${isFeature ? 'feature' : 'compact'}`]}
>

  <div class="rg-review-card__image">
    <img
      src={getImage(post, imageWidth, imageHeight)}
      alt={post.featuredImage?.alt || post.title}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
    />

    <ReviewScoreRing
      score={post.rating?.overall}
      lang={lang}
      size={isFeature ? 'feature' : 'compact'}
    />

    {showEditorsChoice && isEditorsChoice && (
      <span
        class:list={[
          'rg-review-card__editor-choice',
          `rg-review-card__editor-choice--${isFeature ? 'feature' : 'compact'}`
        ]}
        role="img"
        aria-label="Editor's Choice"
      >
        <img
          src="/images/badges/editor-choice-compact-navy.svg"
          alt=""
          class="rg-review-card__editor-choice-asset rg-review-card__editor-choice-asset--dark"
          width="922"
          height="312"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <img
          src="/images/badges/editor-choice-compact-ivory.svg"
          alt=""
          class="rg-review-card__editor-choice-asset rg-review-card__editor-choice-asset--light"
          width="922"
          height="312"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </span>
    )}
  </div>

  <div class="rg-review-card__body">
    {isHomeReviews ? (
      (homeReviewMetadata.length > 0 || Number(post.commentCount || 0) > 0) && (
        <div class="rg-review-card__kicker rg-meta-line">
          {homeReviewMetadata.map((item, index) => (
            <>
              {index > 0 && <span class="rg-review-card__separator rg-meta-separator" aria-hidden="true">·</span>}
              <span class:list={['rg-review-card__system', index === 0 ? 'rg-meta-primary' : 'rg-meta-secondary']}>{item}</span>
            </>
          ))}
          {homeReviewMetadata.length > 0 && Number(post.commentCount || 0) > 0 && <span class="rg-review-card__separator rg-meta-separator" aria-hidden="true">·</span>}
          <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" class="rg-meta-auxiliary" />
        </div>
      )
    ) : (
      <div class="rg-review-card__kicker rg-meta-line">
        <span class="rg-review-card__type rg-meta-primary">{reviewLabel}</span>
        {getTaxonomyLabel(post.platforms?.[0]) && (
          <>
            <span class="rg-review-card__separator rg-meta-separator" aria-hidden="true">·</span>
            <span class="rg-review-card__system rg-meta-secondary">{getTaxonomyLabel(post.platforms?.[0])}</span>
          </>
        )}
        {Number(post.commentCount || 0) > 0 && (
          <>
            <span class="rg-review-card__separator rg-meta-separator" aria-hidden="true">·</span>
            <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" class="rg-meta-auxiliary" />
          </>
        )}
      </div>
    )}

    <h3 class="rg-editorial-title">{post.title}</h3>

    {excerpt && <p>{excerpt}</p>}
  </div>

</a>
