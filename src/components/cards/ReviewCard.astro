---
import { urlFor } from '../../lib/image';
import { getFormatLabel } from '../../lib/formatLabels';
import { getPostUrl } from '../../lib/routes';
import { formatReviewScore, getReviewRibbonBadge } from '../../lib/reviewBadges';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const { post, lang = 'it' } = Astro.props;

const isEn = lang === 'en';

if (!post) return;

const getScore = (post) => post.rating?.overall ?? post.score ?? 0;

const getScoreClass = (score) => {
  if (score >= 9) return 'is-top';
  if (score >= 7) return 'is-good';
  return 'is-low';
};

const getImage = (post, width = 520, height = 325) => {
  if (!post?.featuredImage?.asset) return '/placeholder-retro.png';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const platform = post.platforms?.[0]?.name || '';
const developer = post.developers?.[0]?.name || '';
const year = post.gameInfo?.releaseYear || '';

const getTaxonomyLabel = (item) => {
  if (!item) return '';

  return isEn
    ? item.nameEn || item.name
    : item.name;
};

const genres =
  post.genres
    ?.map((genre) => getTaxonomyLabel(genre))
    .filter(Boolean) || [];

const genreBadges = genres.slice(0, 1).map((genre) => ({
  label: genre,
  title: genre
}));

const platformBadge =
  post.platforms?.[0]?.badgeLabel ||
  post.platforms?.[0]?.platformType?.toUpperCase() ||
  '';

const rawMediaFormat = Array.isArray(post.gameInfo?.mediaFormat)
  ? post.gameInfo.mediaFormat[0]
  : post.gameInfo?.mediaFormat;

const mediaFormat =
  getFormatLabel(rawMediaFormat, lang, { variant: 'compact' }) ||
  post.platforms?.[0]?.platformType?.toUpperCase() ||
  'SYSTEM';

const score = getScore(post);
const reviewBadge = getReviewRibbonBadge(score, lang);

const metaItems = [
  platform,
  developer,
  year
].filter(Boolean);

---

<a href={getPostUrl(post)} class="rg-review-card">

  {metaItems.length > 0 && (
    <div class="rg-review-card__meta">
      {metaItems.join(' · ')}
    </div>
  )}

  <div class="rg-review-card__image">
    <img
      src={getImage(post, 520, 325)}
      alt={post.featuredImage?.alt || post.title}
      width="520"
      height="325"
      loading="lazy"
      decoding="async"
    />

    {reviewBadge && (
      <img
        src={reviewBadge.src}
        alt={reviewBadge.alt}
        class={`rg-review-card__badge review-ribbon-badge review-badge--home review-badge--${reviewBadge.key}`}
        width="240"
        height="81"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="rg-review-card__body">
    <div class="rg-card-meta-inline">
      <span>{genreBadges[0]?.label || (isEn ? 'Review' : 'Recensione')}</span>
      <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" />
    </div>

    <h3>{post.title}</h3>
  </div>

  <div class="rg-review-card__footer">

    {score ? (
      <div class={`rg-score ${getScoreClass(score)}`}>
        <span>{formatReviewScore(score)}</span>
      </div>
    ) : null}

    {platformBadge && (
      <div class="rg-platform-badge" title={`${platform} · ${mediaFormat}`}>
        <span>{platformBadge}</span>
        <small>{mediaFormat}</small>
      </div>
    )}

  </div>

</a>
