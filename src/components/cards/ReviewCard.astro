---
import { urlFor } from '../../lib/image';
import { getPostUrl } from '../../lib/routes';
import ReviewScoreRing from '../reviews/ReviewScoreRing.astro';

const { post, lang = 'it', variant = 'compact' } = Astro.props;

const isEn = lang === 'en';
const isFeature = variant === 'feature';

if (!post) return;

const getImage = (post, width = 520, height = 390) => {
  if (!post?.featuredImage?.asset) return '/og-image.jpg';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const getTaxonomyLabel = (item) => {
  if (!item) return '';

  return isEn
    ? item.nameEn || item.name
    : item.name;
};

const platforms = (post.platforms || [])
  .map((platform) => getTaxonomyLabel(platform))
  .filter(Boolean);
const platformLabel = platforms.join(' - ');
const reviewLabel = isEn ? 'Review' : 'Recensione';
const rating = Number(post.rating?.overall);
const isEditorsChoice = Number.isFinite(rating) && rating >= 9;
const showEditorsChoice = true;

const cleanText = (value) =>
  typeof value === 'string'
    ? value.replace(/\[…\]/g, '').trim()
    : '';

const excerpt =
  cleanText(post.cardExcerpt) ||
  cleanText(post.excerpt) ||
  cleanText(post.subtitle);

const imageWidth = isFeature ? 840 : 520;
const imageHeight = isFeature ? 630 : 390;

---

<a
  href={getPostUrl(post)}
  class:list={['rg-review-card', `rg-review-card--${isFeature ? 'feature' : 'compact'}`]}
>

  <div class="rg-review-card__image">
    <img
      src={getImage(post, imageWidth, imageHeight)}
      alt={post.featuredImage?.alt || post.title}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
    />

    <ReviewScoreRing
      score={post.rating?.overall}
      lang={lang}
      size={isFeature ? 'feature' : 'compact'}
    />

    {showEditorsChoice && isEditorsChoice && (
      <img
        src="/images/badges/editor-choice-compact-ivory.svg"
        alt="Editor's Choice"
        class:list={[
          'rg-review-card__editor-choice',
          `rg-review-card__editor-choice--${isFeature ? 'feature' : 'compact'}`
        ]}
        width="922"
        height="312"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="rg-review-card__body">
    <div class="rg-review-card__kicker">
      <span class="rg-review-card__type">{reviewLabel}</span>

      {platformLabel && (
        <>
          <span class="rg-review-card__separator" aria-hidden="true">·</span>
          <span class="rg-review-card__system" title={platformLabel}>{platformLabel}</span>
        </>
      )}
    </div>

    <h3>{post.title}</h3>

    {excerpt && <p>{excerpt}</p>}
  </div>

</a>
