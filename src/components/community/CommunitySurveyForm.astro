---
import type {
  CommunitySurveyAvailabilityState,
  CommunitySurveyLanguage,
  CommunitySurveyPublic,
  CommunitySurveyResponseState,
} from '../../lib/community-surveys';

interface Props {
  survey: CommunitySurveyPublic;
  lang: CommunitySurveyLanguage;
  responseState: CommunitySurveyResponseState;
  availabilityState?: CommunitySurveyAvailabilityState;
}

const { survey, lang, responseState, availabilityState = 'open' } = Astro.props as Props;
const isEn = lang === 'en';
const copy = isEn
  ? {
      title: 'Take part',
      kicker: 'Your voice',
      intro:
        'A few questions to help shape the next steps of the Retro-Gamers.it community. Your answers are anonymous and are not linked to your account or email address.',
      questionCount: (count: number) => `${count} ${count === 1 ? 'question' : 'questions'}`,
      singleHint: 'Choose one option.',
      multipleHint: 'Choose one or more options.',
      maxSelectionsHint: (count: number) => `Select up to ${count} options.`,
      textHint: 'Write your answer.',
      openAnswerPrivacy:
        'To protect your privacy, do not include personal data in open answers.',
      textPlaceholder: 'Write your thoughts here...',
      questionLabel: 'Question',
      ofLabel: 'of',
      continue: 'Continue',
      back: 'Back',
      submit: 'Send answers',
      submitting: 'Sending...',
      missing: 'Answer this question before continuing.',
      maxSelectionsError: 'You can select up to {count} options.',
      sending:
        'Saving your anonymous response...',
      success:
        'Thanks for taking part. Your anonymous response has been recorded.',
      successDetail:
        'Your answers will help us understand what the Retro-Gamers.it community wants to see next.',
      already:
        'You have already taken part in this survey from this browser.',
      alreadyDetail:
        'To keep the survey fair, each browser can submit one anonymous response.',
      notOpen:
        'This survey is not open yet.',
      closed:
        'This survey is closed. Thank you to everyone who took part.',
      error:
        'We could not save your answers. Please try again in a moment.',
    }
  : {
      title: 'Partecipa',
      kicker: 'La tua voce',
      intro:
        'Poche domande per orientare i prossimi passi della community Retro-Gamers.it. Le risposte sono anonime e non vengono collegate al tuo account o alla tua email.',
      questionCount: (count: number) => `${count} ${count === 1 ? 'domanda' : 'domande'}`,
      singleHint: 'Scegli una sola opzione.',
      multipleHint: 'Scegli una o più opzioni.',
      maxSelectionsHint: (count: number) => `Seleziona fino a ${count} opzioni.`,
      textHint: 'Scrivi la tua risposta.',
      openAnswerPrivacy:
        'Per proteggere la tua privacy, non inserire dati personali nelle risposte aperte.',
      textPlaceholder: 'Scrivi qui il tuo pensiero...',
      questionLabel: 'Domanda',
      ofLabel: 'di',
      continue: 'Continua',
      back: 'Indietro',
      submit: 'Invia risposte',
      submitting: 'Invio in corso...',
      missing: 'Rispondi a questa domanda prima di continuare.',
      maxSelectionsError: 'Puoi selezionare al massimo {count} opzioni.',
      sending:
        'Stiamo salvando la tua risposta anonima...',
      success:
        'Grazie per aver partecipato. La tua risposta anonima è stata registrata.',
      successDetail:
        'Le tue risposte ci aiuteranno a capire cosa vorrebbe vedere la community di Retro-Gamers.it nei prossimi mesi.',
      already:
        'Hai già partecipato a questo sondaggio da questo browser.',
      alreadyDetail:
        'Per mantenere il sondaggio corretto, ogni browser può inviare una sola risposta anonima.',
      notOpen:
        'Il sondaggio non è ancora aperto.',
      closed:
        'Il sondaggio è chiuso. Grazie a tutti per aver partecipato.',
      error:
        'Non è stato possibile salvare le risposte. Riprova tra poco.',
    };
const formId = `community-survey-${survey.surveyKey}`;
const questionCountLabel = copy.questionCount(survey.questions.length);
const totalQuestions = survey.questions.length;
const isSurveyOpen = availabilityState === 'open';
const hasExistingResponse = isSurveyOpen && responseState.hasResponded;
const availabilityMessage = availabilityState === 'scheduled'
  ? copy.notOpen
  : availabilityState === 'closed'
    ? copy.closed
    : '';
---

<section class="community-card community-survey-card" aria-labelledby={`${formId}-title`}>
  <header class="community-survey-card__header">
    <div class="community-survey-card__title-row">
      <div>
        <p class="community-kicker">{copy.kicker}</p>
        <h2 id={`${formId}-title`}>{copy.title}</h2>
      </div>
      <span>{questionCountLabel}</span>
    </div>
    <p>{copy.intro}</p>
  </header>

  <div
    class="community-survey-status community-survey-status--success"
    data-community-survey-success
    hidden={!hasExistingResponse}
  >
    <strong>{hasExistingResponse ? copy.already : ''}</strong>
    <p>{hasExistingResponse ? copy.alreadyDetail : ''}</p>
  </div>

  <div
    class="community-survey-status"
    hidden={isSurveyOpen}
  >
    <strong>{availabilityMessage}</strong>
  </div>

  <form
    class="community-survey-form"
    data-community-survey-form
    novalidate
    data-survey-key={survey.surveyKey}
    data-survey-document-id={survey._id}
    data-survey-language={survey.language}
    data-endpoint={`/api/community/surveys/${encodeURIComponent(survey.surveyKey)}/responses`}
    data-message-missing={copy.missing}
    data-message-max-selections={copy.maxSelectionsError}
    data-message-error={copy.error}
    data-message-success={copy.success}
    data-message-success-detail={copy.successDetail}
    data-message-already={copy.already}
    data-message-already-detail={copy.alreadyDetail}
    data-message-not-open={copy.notOpen}
    data-message-closed={copy.closed}
    data-message-sending={copy.sending}
    data-label-question={copy.questionLabel}
    data-label-of={copy.ofLabel}
    data-label-continue={copy.continue}
    data-label-submit={copy.submit}
    data-label-submitting={copy.submitting}
    hidden={hasExistingResponse || !isSurveyOpen}
  >
    <div class="community-survey-stepper" aria-live="polite">
      <div class="community-survey-stepper__meta">
        <span data-survey-progress-label>
          {copy.questionLabel} 1 {copy.ofLabel} {totalQuestions}
        </span>
      </div>
      <div
        class="community-survey-progress"
        role="progressbar"
        aria-valuemin="1"
        aria-valuemax={totalQuestions}
        aria-valuenow="1"
        aria-label={`${copy.questionLabel} 1 ${copy.ofLabel} ${totalQuestions}`}
        data-survey-progress
      >
        <span style={`--community-survey-progress: ${(1 / totalQuestions) * 100}%`}></span>
      </div>
    </div>

    {survey.questions.map((question, index) => {
      const questionName = `${formId}-${question.questionId}`;
      const hint =
        question.type === 'single'
          ? copy.singleHint
          : question.type === 'multiple'
            ? question.maxSelections
              ? copy.maxSelectionsHint(question.maxSelections)
              : copy.multipleHint
            : copy.textHint;

      return (
        <fieldset
          class="community-survey-question"
          data-survey-question
          data-survey-step={index}
          data-question-id={question.questionId}
          data-question-type={question.type}
          data-max-selections={question.type === 'multiple' && question.maxSelections
            ? question.maxSelections
            : undefined}
          tabindex="-1"
          hidden={index !== 0}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <legend>
            <span>{index + 1}</span>
            {question.text}
          </legend>

          <p>{hint}</p>

          {question.type === 'text' ? (
            <>
              <p class="community-survey-privacy-note">{copy.openAnswerPrivacy}</p>
              <textarea
                name={questionName}
                rows="5"
                maxlength="2000"
                placeholder={copy.textPlaceholder}
                required
              ></textarea>
            </>
          ) : (
            <div class="community-survey-options">
              {question.options.map((option) => {
                const inputId = `${questionName}-${option.optionId}`;
                const inputType = question.type === 'multiple' ? 'checkbox' : 'radio';

                return (
                  <label for={inputId}>
                    <input
                      id={inputId}
                      type={inputType}
                      name={questionName}
                      value={option.optionId}
                      required={question.type === 'single'}
                    />
                    <span>{option.label}</span>
                  </label>
                );
              })}
            </div>
          )}
        </fieldset>
      );
    })}

    <div class="community-survey-form__footer">
      <p class="community-survey-form__message" data-survey-form-status aria-live="polite"></p>
      <div class="community-survey-form__actions">
        <button
          class="community-action-button community-survey-back"
          type="button"
          data-survey-back
          hidden
        >
          {copy.back}
        </button>
        <button
          class="community-action-button community-survey-next"
          type="button"
          data-survey-next
          hidden={totalQuestions <= 1}
        >
          {copy.continue}
        </button>
        <button
          class="community-action-button community-survey-submit"
          type="submit"
          hidden={totalQuestions > 1}
        >
          <span class="community-survey-submit__spinner" aria-hidden="true"></span>
          <span data-survey-submit-label>{copy.submit}</span>
        </button>
      </div>
    </div>
  </form>
</section>

<script>
  const prefersReducedSurveyMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const setQuestionInvalid = (question, invalid) => {
    if (!(question instanceof HTMLElement)) return;
    question.toggleAttribute('data-invalid', invalid);
    question.setAttribute('aria-invalid', invalid ? 'true' : 'false');
  };

  const setMessage = (node, message, tone = 'error') => {
    if (!(node instanceof HTMLElement)) return;

    node.textContent = message || '';
    node.dataset.tone = tone;
  };

  document.querySelectorAll('[data-community-survey-form]').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;

    const questions = Array.from(form.querySelectorAll('[data-survey-question]'))
      .filter((question) => question instanceof HTMLElement);
    const backButton = form.querySelector('[data-survey-back]');
    const nextButton = form.querySelector('[data-survey-next]');
    const submitButton = form.querySelector('button[type="submit"]');
    const submitLabelNode = submitButton?.querySelector('[data-survey-submit-label]');
    const statusNode = form.querySelector('[data-survey-form-status]');
    const progressNode = form.querySelector('[data-survey-progress]');
    const progressBarNode = progressNode?.querySelector('span');
    const progressLabelNode = form.querySelector('[data-survey-progress-label]');
    const successNode = form
      .closest('.community-survey-card')
      ?.querySelector('[data-community-survey-success]');
    const surveyCard = form.closest('.community-survey-card');
    const submitLabel = form.dataset.labelSubmit || 'Invia';
    const submittingLabel = form.dataset.labelSubmitting || submitLabel;
    const missingMessage = form.dataset.messageMissing || '';
    const maxSelectionsMessage = form.dataset.messageMaxSelections || '';
    const errorMessage = form.dataset.messageError || '';
    const successMessage = form.dataset.messageSuccess || '';
    const successDetail = form.dataset.messageSuccessDetail || '';
    const alreadyMessage = form.dataset.messageAlready || successMessage;
    const alreadyDetail = form.dataset.messageAlreadyDetail || '';
    const notOpenMessage = form.dataset.messageNotOpen || errorMessage;
    const closedMessage = form.dataset.messageClosed || errorMessage;
    const sendingMessage = form.dataset.messageSending || '';
    const questionLabel = form.dataset.labelQuestion || 'Domanda';
    const ofLabel = form.dataset.labelOf || 'di';
    let currentStep = 0;

    const getQuestionMaxSelections = (question) => {
      if (!(question instanceof HTMLElement)) return null;

      const maxSelections = Number(question.dataset.maxSelections || 0);

      return Number.isInteger(maxSelections) && maxSelections >= 2
        ? maxSelections
        : null;
    };

    const getMaxSelectionsMessage = (count) =>
      (maxSelectionsMessage || missingMessage).replace('{count}', String(count));

    const updateMultipleSelectionLimit = (question) => {
      if (!(question instanceof HTMLElement)) return;
      if (question.dataset.questionType !== 'multiple') return;

      const maxSelections = getQuestionMaxSelections(question);
      const inputs = Array.from(
        question.querySelectorAll('input[type="checkbox"]')
      ).filter((input) => input instanceof HTMLInputElement);

      if (!maxSelections) {
        inputs.forEach((input) => {
          input.disabled = false;
        });
        return;
      }

      const checkedCount = inputs.filter((input) => input.checked).length;
      const hasReachedLimit = checkedCount >= maxSelections;

      inputs.forEach((input) => {
        input.disabled = !input.checked && hasReachedLimit;
      });
    };

    const setSuccess = (message, detail) => {
      if (!(successNode instanceof HTMLElement)) return;

      successNode.hidden = false;
      successNode.querySelector('strong')?.replaceChildren(message);
      successNode.querySelector('p')?.replaceChildren(detail || '');
    };

    const setControlsDisabled = (disabled) => {
      [backButton, nextButton, submitButton].forEach((button) => {
        if (button instanceof HTMLButtonElement) {
          button.disabled = disabled;
        }
      });
    };

    const getQuestionAnswer = (question, { markInvalid = false } = {}) => {
      const questionId = question.dataset.questionId || '';
      const type = question.dataset.questionType || '';

      if (markInvalid) {
        setQuestionInvalid(question, false);
      }

      if (type === 'single') {
        const checked = question.querySelector('input[type="radio"]:checked');
        const optionId = checked instanceof HTMLInputElement ? checked.value : '';

        if (!optionId && markInvalid) {
          setQuestionInvalid(question, true);
        }

        return {
          answer: { questionId, optionId },
          valid: Boolean(optionId),
        };
      }

      if (type === 'multiple') {
        const maxSelections = getQuestionMaxSelections(question);
        const optionIds = Array.from(
          question.querySelectorAll('input[type="checkbox"]:checked')
        )
          .filter((input) => input instanceof HTMLInputElement)
          .map((input) => input.value);

        if (
          (optionIds.length < 1 ||
            (maxSelections && optionIds.length > maxSelections)) &&
          markInvalid
        ) {
          setQuestionInvalid(question, true);
        }

        return {
          answer: { questionId, optionIds },
          valid:
            optionIds.length > 0 &&
            (!maxSelections || optionIds.length <= maxSelections),
          message: maxSelections && optionIds.length > maxSelections
            ? getMaxSelectionsMessage(maxSelections)
            : '',
        };
      }

      const textarea = question.querySelector('textarea');
      const textAnswer = textarea instanceof HTMLTextAreaElement
        ? textarea.value.trim()
        : '';

      if (!textAnswer && markInvalid) {
        setQuestionInvalid(question, true);
      }

      return {
        answer: { questionId, textAnswer },
        valid: Boolean(textAnswer),
      };
    };

    const focusCurrentQuestion = () => {
      const activeQuestion = questions[currentStep];

      if (!(activeQuestion instanceof HTMLElement)) return;

      if (surveyCard instanceof HTMLElement) {
        surveyCard.scrollIntoView({
          block: 'start',
          behavior: prefersReducedSurveyMotion ? 'auto' : 'smooth',
        });
      }

      window.requestAnimationFrame(() => {
        activeQuestion.focus({ preventScroll: true });
      });
    };

    const updateStep = ({ shouldFocus = false } = {}) => {
      const totalSteps = questions.length || 1;
      const progressPercent = ((currentStep + 1) / totalSteps) * 100;

      questions.forEach((question, index) => {
        if (!(question instanceof HTMLElement)) return;

        const isActive = index === currentStep;

        question.hidden = !isActive;
        question.toggleAttribute('data-active', isActive);
        question.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      if (progressLabelNode instanceof HTMLElement) {
        progressLabelNode.textContent = `${questionLabel} ${currentStep + 1} ${ofLabel} ${totalSteps}`;
      }

      if (progressNode instanceof HTMLElement) {
        progressNode.setAttribute('aria-valuenow', String(currentStep + 1));
        progressNode.setAttribute('aria-label', `${questionLabel} ${currentStep + 1} ${ofLabel} ${totalSteps}`);
      }

      if (progressBarNode instanceof HTMLElement) {
        progressBarNode.style.setProperty('--community-survey-progress', `${progressPercent}%`);
      }

      if (backButton instanceof HTMLElement) {
        backButton.hidden = currentStep === 0;
      }

      if (nextButton instanceof HTMLElement) {
        nextButton.hidden = currentStep >= totalSteps - 1;
      }

      if (submitButton instanceof HTMLElement) {
        submitButton.hidden = currentStep < totalSteps - 1;
      }

      if (shouldFocus) {
        focusCurrentQuestion();
      }
    };

    if (backButton instanceof HTMLButtonElement) {
      backButton.addEventListener('click', () => {
        if (form.hasAttribute('data-submitting')) return;
        currentStep = Math.max(0, currentStep - 1);
        setMessage(statusNode, '', 'info');
        updateStep({ shouldFocus: true });
      });
    }

    if (nextButton instanceof HTMLButtonElement) {
      nextButton.addEventListener('click', () => {
        if (form.hasAttribute('data-submitting')) return;

        const activeQuestion = questions[currentStep];

        const result = activeQuestion instanceof HTMLElement
          ? getQuestionAnswer(activeQuestion, { markInvalid: true })
          : null;

        if (!result?.valid) {
          setMessage(statusNode, result?.message || missingMessage, 'error');
          return;
        }

        setMessage(statusNode, '', 'info');
        currentStep = Math.min(questions.length - 1, currentStep + 1);
        updateStep({ shouldFocus: true });
      });
    }

    questions.forEach((question) => {
      if (!(question instanceof HTMLElement)) return;

      updateMultipleSelectionLimit(question);

      question.addEventListener('change', () => {
        setQuestionInvalid(question, false);
        updateMultipleSelectionLimit(question);
      });

      question.addEventListener('input', () => {
        setQuestionInvalid(question, false);
      });
    });

    updateStep();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (form.hasAttribute('data-submitting')) return;

      const answers = [];
      let hasMissingAnswer = false;
      let firstInvalidStep = -1;
      let validationMessage = missingMessage;

      questions.forEach((question, index) => {
        if (!(question instanceof HTMLElement)) return;

        const result = getQuestionAnswer(question, { markInvalid: true });

        if (!result.valid) {
          hasMissingAnswer = true;

          if (firstInvalidStep === -1) {
            firstInvalidStep = index;
            validationMessage = result.message || missingMessage;
          }
        }

        answers.push(result.answer);
      });

      if (hasMissingAnswer) {
        currentStep = firstInvalidStep === -1 ? currentStep : firstInvalidStep;
        updateStep({ shouldFocus: true });
        setMessage(statusNode, validationMessage, 'error');
        return;
      }

      setMessage(statusNode, '', 'info');
      form.toggleAttribute('data-submitting', true);
      setMessage(statusNode, sendingMessage, 'info');

      setControlsDisabled(true);

      if (submitLabelNode instanceof HTMLElement) {
        submitLabelNode.textContent = submittingLabel;
      }

      try {
        const response = await fetch(form.dataset.endpoint || '', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            surveyDocumentId: form.dataset.surveyDocumentId || '',
            language: form.dataset.surveyLanguage || 'it',
            answers,
          }),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          if (response.status === 409 && result?.error === 'already_submitted') {
            setSuccess(alreadyMessage, alreadyDetail);

            form.hidden = true;
            return;
          }

          if (result?.error === 'survey_not_open') {
            setMessage(statusNode, notOpenMessage, 'error');
            return;
          }

          if (result?.error === 'survey_closed') {
            setMessage(statusNode, closedMessage, 'error');
            return;
          }

          setMessage(statusNode, errorMessage, 'error');
          return;
        }

        setSuccess(successMessage, successDetail);

        form.hidden = true;
      } catch {
        setMessage(statusNode, errorMessage, 'error');
      } finally {
        form.removeAttribute('data-submitting');
        setControlsDisabled(false);

        if (submitLabelNode instanceof HTMLElement) {
          submitLabelNode.textContent = submitLabel;
        }
      }
    });
  });
</script>
