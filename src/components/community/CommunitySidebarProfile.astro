---
import UserAvatar from '../account/UserAvatar.astro';

interface Props {
  name?: string | null;
  username?: string | null;
  email?: string | null;
  avatarUrl?: string | null;
  badge?: string | null;
  badgeImageUrl?: string | null;
  label?: string;
}

const {
  name = '',
  username = '',
  email = '',
  avatarUrl = '',
  badge = '',
  badgeImageUrl = '',
  label = 'Profilo community',
} = Astro.props;

const displayName = name || username || email || 'Utente Retro-Gamers';
const handle = username ? `@${username}` : email || '';
---

<section class="community-sidebar-card community-profile-card">
  <UserAvatar name={displayName} email={email} src={avatarUrl} size="md" />

  <div class="community-profile-card__content">
    <span>{label}</span>
    <strong>{displayName}</strong>
    {handle && <small>{handle}</small>}
    {badge && (
      <span class="community-profile-card__badge">
        {badgeImageUrl && <img src={badgeImageUrl} alt="" loading="lazy" decoding="async" />}
        <span>{badge}</span>
      </span>
    )}

    {Astro.slots.has('default') && (
      <div class="community-link-list">
        <slot />
      </div>
    )}
  </div>

  <slot name="details" />
</section>
