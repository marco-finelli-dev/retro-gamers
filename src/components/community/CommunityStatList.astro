---
interface StatItem {
  label: string;
  value: string | number;
  href?: string;
  ariaLabel?: string;
}

interface Props {
  title?: string;
  items: StatItem[];
}

const { title = '', items } = Astro.props;
---

<section class="community-sidebar-card community-stat-section">
  {title && <h2>{title}</h2>}

  <div class="community-stat-list">
    {items.map((item) => (
      item.href ? (
        <a href={item.href} aria-label={item.ariaLabel}>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </a>
      ) : (
        <div>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      )
    ))}
  </div>
</section>
