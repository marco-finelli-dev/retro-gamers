---
import '../../styles/pages/community.css';
import '../../styles/pages/management-refresh.css';
import '../../styles/pages/management-mobile.css';

interface Props {
  class?: string;
  sidebar?: boolean;
}

const { class: className = '', sidebar } = Astro.props;
const hasSidebar = sidebar ?? Astro.slots.has('sidebar');
const hasBefore = Astro.slots.has('before');
// Presentation only: the writing workspace and public Community pages do not opt in.
const areaPath = Astro.url.pathname.replace(/^\/en(?=\/)/, '').replace(/\/+$/, '');
const managementRefresh = areaPath.startsWith('/admin/') || areaPath === '/admin'
  || ['/account', '/account/memories', '/account/ratings', '/account/favorites',
    '/account/messages', '/account/editor', '/account/editor/profile', '/account/editor/articles',
    '/account/editor/articles/new'].includes(areaPath)
  || areaPath.startsWith('/account/messages/private');
const classes = ['community-page', managementRefresh && 'management-area', className].filter(Boolean).join(' ');
---

<div class={classes}>
  {hasBefore && (
    <div class="community-layout-before">
      <slot name="before" />
    </div>
  )}

  <div class:list={['community-shell', hasSidebar && 'community-shell--with-sidebar']}>
    <div class="community-main">
      <slot />
    </div>

    {hasSidebar && (
      <aside class="community-sidebar">
        <slot name="sidebar" />
      </aside>
    )}
  </div>
</div>
