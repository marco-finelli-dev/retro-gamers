---
import '../../styles/pages/community-hub.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import UserAvatar from '../account/UserAvatar.astro';
import CommunityHero from './CommunityHero.astro';
import CommunityLayout from './CommunityLayout.astro';
import { getAllPosts, groupPosts } from '../../lib/posts';
import {
  getCommunityHubStats,
  getLatestCommunityComments,
  getMostDiscussedPosts,
} from '../../lib/supabase/community-hub';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';

type Lang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: Lang };
const currentLang: Lang = lang === 'en' ? 'en' : 'it';
const isEn = currentLang === 'en';

const copy = isEn
  ? {
      title: 'Community | Retro-Gamers.it',
      description: 'Reader profiles, comments, memories, ratings and badges from the Retro-Gamers.it community.',
      canonical: 'https://www.retro-gamers.it/en/community/',
      languageSwitch: '/community/',
      heroTitle: 'Community',
      heroDescription:
        'Retro-Gamers.it is not just an archive of reviews and features: it is a place where readers, memories and conversations can stay alive.',
      profileCtaGuest: 'Create your profile',
      profileCtaAuth: 'Go to your account',
      profileHrefGuest: '/en/account/register/',
      profileHrefAuth: '/en/account/',
      badgesCta: 'Discover badges',
      badgesHref: '/en/badges/',
      newsletterCta: 'Subscribe to the newsletter',
      newsletterHref: '/en/newsletter/',
      stats: {
        comments: 'Public comments',
        ratings: 'Reader ratings',
        profiles: 'Active profiles',
        articles: 'Discussed articles',
      },
      latestTitle: 'Latest reader memories',
      latestEmpty: 'No public memories to show yet.',
      articleFallback: 'Article',
      readDiscussion: 'Read the discussion',
      profileLabel: 'Reader profile',
      mostDiscussedTitle: 'Most discussed articles',
      archiveKicker: 'Living archive',
      mostDiscussedEmpty: 'Discussions will grow together with the community.',
      commentsLabel: (count: number) => `${count} ${count === 1 ? 'comment' : 'comments'}`,
      joinTitle: 'Keep the memories alive',
      joinCards: [
        {
          title: 'Comment',
          text: 'Add memories, impressions and details that can give new life to a game.',
        },
        {
          title: 'Rate',
          text: 'Share your opinion on reviews and help other readers find their way.',
        },
        {
          title: 'Follow',
          text: 'Choose interests, badges and the newsletter to build your own space inside Retro-Gamers.it.',
        },
      ],
      locale: 'en-US',
    }
  : {
      title: 'Community | Retro-Gamers.it',
      description: 'Profili lettore, commenti, memorie, voti e badge della community di Retro-Gamers.it.',
      canonical: 'https://www.retro-gamers.it/community/',
      languageSwitch: '/en/community/',
      heroTitle: 'Community',
      heroDescription:
        'Retro-Gamers.it non è solo un archivio di recensioni e speciali: è uno spazio dove lettori, ricordi e discussioni possono restare vivi.',
      profileCtaGuest: 'Crea il tuo profilo',
      profileCtaAuth: 'Vai al tuo account',
      profileHrefGuest: '/account/register/',
      profileHrefAuth: '/account/',
      badgesCta: 'Scopri i badge',
      badgesHref: '/badges/',
      newsletterCta: 'Iscriviti alla newsletter',
      newsletterHref: '/newsletter/',
      stats: {
        comments: 'Commenti pubblici',
        ratings: 'Voti lettori',
        profiles: 'Profili attivi',
        articles: 'Articoli discussi',
      },
      latestTitle: 'Ultime memorie dai lettori',
      latestEmpty: 'Non ci sono ancora memorie pubbliche da mostrare.',
      articleFallback: 'Articolo',
      readDiscussion: 'Leggi la discussione',
      profileLabel: 'Profilo lettore',
      mostDiscussedTitle: 'Articoli più discussi',
      archiveKicker: 'Archivio vivo',
      mostDiscussedEmpty: 'Le discussioni cresceranno insieme alla community.',
      commentsLabel: (count: number) => `${count} ${count === 1 ? 'commento' : 'commenti'}`,
      joinTitle: 'Fai vivere i ricordi',
      joinCards: [
        {
          title: 'Commenta',
          text: 'Aggiungi ricordi, impressioni e dettagli che possono dare nuova vita a un gioco.',
        },
        {
          title: 'Vota',
          text: 'Condividi il tuo giudizio sulle recensioni e aiuta altri lettori a orientarsi.',
        },
        {
          title: 'Segui',
          text: 'Scegli interessi, badge e newsletter per costruire il tuo spazio dentro Retro-Gamers.it.',
        },
      ],
      locale: 'it-IT',
    };

const allPosts = await getAllPosts();
const groupedPosts = groupPosts(allPosts);
const headerReviews = isEn
  ? allPosts.filter((post) => post.type === 'review' && post.language === 'en')
  : groupedPosts.allReviews;
const headerNews = isEn
  ? allPosts.filter((post) => post.type === 'news' && post.language === 'en')
  : groupedPosts.allNews;
const postsForLang = allPosts.filter((post) => (post.language || 'it') === currentLang);
const session = await getUserSessionFromCookies(Astro.cookies);
const isLoggedIn = Boolean(!session.error && session.user && session.profile);
const [latestComments, stats, mostDiscussedPosts] = await Promise.all([
  getLatestCommunityComments(currentLang),
  getCommunityHubStats(currentLang),
  getMostDiscussedPosts(postsForLang, currentLang),
]);
const dateFormatter = new Intl.DateTimeFormat(copy.locale, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const profileCtaHref = isLoggedIn ? copy.profileHrefAuth : copy.profileHrefGuest;
const profileCtaLabel = isLoggedIn ? copy.profileCtaAuth : copy.profileCtaGuest;
const statsItems = [
  { label: copy.stats.comments, value: stats.approvedComments },
  { label: copy.stats.ratings, value: stats.readerRatings },
  { label: copy.stats.profiles, value: stats.activeProfiles },
  { label: copy.stats.articles, value: stats.discussedArticles },
];
const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/community/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/community/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/community/' },
];
---

<BaseLayout
  reviews={headerReviews}
  news={headerNews}
  title={copy.title}
  description={copy.description}
  image="/og-image.jpg"
  canonical={copy.canonical}
  lang={currentLang}
  languageSwitch={copy.languageSwitch}
  alternateLanguages={alternateLanguages}
>
  <CommunityLayout class="community-hub-page">
    <CommunityHero
      kicker="Retro-Gamers.it"
      title={copy.heroTitle}
      description={copy.heroDescription}
    >
      <Fragment slot="aside">
        <div class="community-hub-cta-list" aria-label="Community actions">
          <a href={profileCtaHref}>{profileCtaLabel}</a>
          <a href={copy.badgesHref}>{copy.badgesCta}</a>
          <a href={copy.newsletterHref}>{copy.newsletterCta}</a>
        </div>
      </Fragment>
    </CommunityHero>

    <section class="community-hub-stats" aria-label="Community stats">
      {statsItems.map((item) => (
        <article>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </article>
      ))}
    </section>

    <section class="community-card community-hub-section" aria-labelledby="community-latest-comments">
      <div class="community-hub-section__heading">
        <p class="community-kicker">Community</p>
        <h2 id="community-latest-comments">{copy.latestTitle}</h2>
      </div>

      {latestComments.length > 0 ? (
        <div class="community-hub-comments">
          {latestComments.map((comment) => (
            <article class="community-hub-comment">
              <header>
                <UserAvatar
                  name={comment.authorName}
                  src={comment.avatarUrl || ''}
                  size="sm"
                  label={`${copy.profileLabel}: ${comment.authorName}`}
                />

                <div>
                  <strong>
                    {comment.profileUrl ? (
                      <a href={comment.profileUrl}>{comment.authorName}</a>
                    ) : (
                      comment.authorName
                    )}
                  </strong>
                  <span>
                    {comment.createdAt
                      ? dateFormatter.format(new Date(comment.createdAt))
                      : copy.articleFallback}
                  </span>
                  {comment.badgeLabel && (
                    <small class="community-hub-comment__badge">
                      {comment.badgeImageUrl && <img src={comment.badgeImageUrl} alt="" loading="lazy" decoding="async" />}
                      {comment.badgeLabel}
                    </small>
                  )}
                </div>
              </header>

              <p>{comment.excerpt}</p>

              <footer>
                <a href={comment.articleUrl}>{comment.articleTitle}</a>
                <a href={comment.articleUrl}>{copy.readDiscussion}</a>
              </footer>
            </article>
          ))}
        </div>
      ) : (
        <p class="community-hub-empty">{copy.latestEmpty}</p>
      )}
    </section>

    <section class="community-card community-hub-section" aria-labelledby="community-most-discussed">
      <div class="community-hub-section__heading">
        <p class="community-kicker">{copy.archiveKicker}</p>
        <h2 id="community-most-discussed">{copy.mostDiscussedTitle}</h2>
      </div>

      {mostDiscussedPosts.length > 0 ? (
        <div class="community-hub-posts">
          {mostDiscussedPosts.map((post) => (
            <article class="community-hub-post">
              {post.imageUrl && (
                <a class="community-hub-post__media" href={post.url} aria-label={post.title}>
                  <img src={post.imageUrl} alt="" loading="lazy" decoding="async" />
                </a>
              )}

              <div class="community-hub-post__body">
                <span>{copy.commentsLabel(post.commentCount)}</span>
                <h3><a href={post.url}>{post.title}</a></h3>
                {post.excerpt && <p>{post.excerpt}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="community-hub-empty">{copy.mostDiscussedEmpty}</p>
      )}
    </section>

    <section class="community-card community-hub-section" aria-labelledby="community-join">
      <div class="community-hub-section__heading">
        <p class="community-kicker">Retro-Gamers.it</p>
        <h2 id="community-join">{copy.joinTitle}</h2>
      </div>

      <div class="community-hub-join-grid">
        {copy.joinCards.map((card) => (
          <article>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>
  </CommunityLayout>
</BaseLayout>
