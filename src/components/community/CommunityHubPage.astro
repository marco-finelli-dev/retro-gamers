---
import '../../styles/pages/community-hub.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import UserAvatar from '../account/UserAvatar.astro';
import CommunityHero from './CommunityHero.astro';
import CommunityLayout from './CommunityLayout.astro';
import { getAllPosts, groupPosts } from '../../lib/posts';
import {
  getCommunityHubStats,
  getLatestCommunityComments,
  getMostDiscussedPosts,
} from '../../lib/supabase/community-hub';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';

type Lang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: Lang };
const currentLang: Lang = lang === 'en' ? 'en' : 'it';
const isEn = currentLang === 'en';

const copy = isEn
  ? {
      title: 'Community',
      description: 'Reader profiles, comments, memories, ratings and badges from the Retro-Gamers.it community.',
      canonical: 'https://www.retro-gamers.it/en/community/',
      languageSwitch: '/community/',
      heroTitle: 'Community',
      heroDescription:
        'A place where reviews, memories and conversations stay close to the articles, instead of disappearing into the social feed.',
      profileCtaGuest: 'Create your profile',
      profileCtaAuth: 'Go to your account',
      profileHrefGuest: '/en/account/register/',
      profileHrefAuth: '/en/account/',
      badgesCta: 'Discover badges',
      badgesHref: '/en/badges/',
      newsletterCta: 'Subscribe to the newsletter',
      newsletterHref: '/en/newsletter/',
      stats: {
        comments: 'Public comments',
        ratings: 'Reader ratings',
        profiles: 'Active profiles',
        articles: 'Discussed articles',
      },
      hubTitle: 'Inside the community',
      hubDescription: "Memories, conversations and articles gathering readers' voices.",
      memories: {
        title: 'Reader memories',
        empty: 'The first memories will arrive with the readers.',
        read: 'Read the discussion',
      },
      discussions: {
        title: 'Most discussed articles',
        cta: 'Read the articles',
        empty: 'Discussions will grow together with the community.',
      },
      profileLabel: 'Reader profile',
      commentsLabel: (count: number) => `${count} ${count === 1 ? 'comment' : 'comments'}`,
    }
  : {
      title: 'Community',
      description: 'Profili lettore, commenti, memorie, voti e badge della community di Retro-Gamers.it.',
      canonical: 'https://www.retro-gamers.it/community/',
      languageSwitch: '/en/community/',
      heroTitle: 'Community',
      heroDescription:
        'Un luogo dove recensioni, ricordi e discussioni restano accanto agli articoli, senza perdersi nel flusso dei social.',
      profileCtaGuest: 'Crea il tuo profilo',
      profileCtaAuth: 'Vai al tuo account',
      profileHrefGuest: '/account/register/',
      profileHrefAuth: '/account/',
      badgesCta: 'Scopri i badge',
      badgesHref: '/badges/',
      newsletterCta: 'Iscriviti alla newsletter',
      newsletterHref: '/newsletter/',
      stats: {
        comments: 'Commenti pubblici',
        ratings: 'Voti lettori',
        profiles: 'Profili attivi',
        articles: 'Articoli discussi',
      },
      hubTitle: 'Dentro la community',
      hubDescription: 'Memorie, discussioni e articoli che stanno raccogliendo le voci dei lettori.',
      memories: {
        title: 'Memorie dei lettori',
        empty: 'Le prime memorie arriveranno con i lettori.',
        read: 'Leggi la discussione',
      },
      discussions: {
        title: 'Articoli più discussi',
        cta: 'Leggi gli articoli',
        empty: 'Le discussioni cresceranno insieme alla community.',
      },
      profileLabel: 'Profilo lettore',
      commentsLabel: (count: number) => `${count} ${count === 1 ? 'commento' : 'commenti'}`,
    };

const allPosts = await getAllPosts();
const groupedPosts = groupPosts(allPosts);
const headerReviews = isEn
  ? allPosts.filter((post) => post.type === 'review' && post.language === 'en')
  : groupedPosts.allReviews;
const headerNews = isEn
  ? allPosts.filter((post) => post.type === 'news' && post.language === 'en')
  : groupedPosts.allNews;
const postsForLang = allPosts.filter((post) => (post.language || 'it') === currentLang);
const session = await getUserSessionFromCookies(Astro.cookies);
const isLoggedIn = Boolean(!session.error && session.user && session.profile);
const [latestComments, stats, mostDiscussedPosts] = await Promise.all([
  getLatestCommunityComments(currentLang, 6, allPosts),
  getCommunityHubStats(currentLang, allPosts),
  getMostDiscussedPosts(postsForLang, currentLang),
]);
const profileCtaHref = isLoggedIn ? copy.profileHrefAuth : copy.profileHrefGuest;
const profileCtaLabel = isLoggedIn ? copy.profileCtaAuth : copy.profileCtaGuest;
const memoryPreviewItems = latestComments.slice(0, 4);
const discussionPreviewItems = mostDiscussedPosts.slice(0, 4);
const statsItems = [
  { label: copy.stats.comments, value: stats.approvedComments },
  { label: copy.stats.ratings, value: stats.readerRatings },
  { label: copy.stats.profiles, value: stats.activeProfiles },
  { label: copy.stats.articles, value: stats.discussedArticles },
];
const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/community/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/community/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/community/' },
];
---

<BaseLayout
  reviews={headerReviews}
  news={headerNews}
  title={copy.title}
  description={copy.description}
  image="/og-image.jpg"
  canonical={copy.canonical}
  lang={currentLang}
  languageSwitch={copy.languageSwitch}
  alternateLanguages={alternateLanguages}
>
  <CommunityLayout class="community-hub-page">
    <CommunityHero
      kicker="Retro-Gamers.it"
      title={copy.heroTitle}
      description={copy.heroDescription}
      class="community-hub-hero"
    >
      <div class="community-hub-hero__actions" aria-label="Community actions">
        <a class="community-hub-hero__primary" href={profileCtaHref}>{profileCtaLabel}</a>
        {!isLoggedIn && <a class="community-hub-hero__secondary-cta" href={copy.newsletterHref}>{copy.newsletterCta}</a>}
        <a class="community-hub-hero__secondary-cta" href={copy.badgesHref}>{copy.badgesCta}</a>
      </div>

      <div class="community-hub-stats" aria-label="Community stats">
        {statsItems.map((item) => (
          <article>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </article>
        ))}
      </div>
    </CommunityHero>

    <section class="community-card community-hub-section community-hub-main" aria-labelledby="community-hub-main">
      <div class="community-hub-section__heading">
        <p class="community-kicker">Community</p>
        <h2 id="community-hub-main">{copy.hubTitle}</h2>
        <p>{copy.hubDescription}</p>
      </div>

      <div class="community-hub-columns">
        <section class="community-hub-column community-hub-column--memories" aria-labelledby="community-hub-memories">
          <div class="community-hub-column__heading">
            <h3 id="community-hub-memories">{copy.memories.title}</h3>
          </div>

          {memoryPreviewItems.length > 0 ? (
            <div class="community-hub-memory-list">
              {memoryPreviewItems.map((comment) => (
                <article class="community-hub-memory">
                  <header>
                    <UserAvatar
                      name={comment.authorName}
                      src={comment.avatarUrl || ''}
                      size="sm"
                      label={`${copy.profileLabel}: ${comment.authorName}`}
                    />
                    <strong>{comment.authorName}</strong>
                    {comment.authorType === 'guest' && (
                      <span class="community-hub-memory__guest-badge">
                        {isEn ? 'Guest' : 'Ospite'}
                      </span>
                    )}
                  </header>

                  <p>{comment.excerpt}</p>

                  <footer>
                    <a href={comment.articleUrl}>{comment.articleTitle}</a>
                    <a href={comment.articleUrl}>{copy.memories.read}</a>
                  </footer>
                </article>
              ))}
            </div>
          ) : (
            <p class="community-hub-empty community-hub-empty--compact">{copy.memories.empty}</p>
          )}
        </section>

        <section class="community-hub-column community-hub-column--discussions" aria-labelledby="community-hub-discussions">
          <div class="community-hub-column__heading">
            <h3 id="community-hub-discussions">{copy.discussions.title}</h3>
          </div>

          {discussionPreviewItems.length > 0 ? (
            <div class="community-hub-discussion-grid">
              {discussionPreviewItems.map((post) => (
                <article class="community-hub-discussion-card">
                  {post.imageUrl && (
                    <a class="community-hub-discussion-card__media" href={post.url} aria-label={post.title}>
                      <img src={post.imageUrl} alt="" loading="lazy" decoding="async" />
                    </a>
                  )}
                  {!post.imageUrl && <div class="community-hub-discussion-card__media community-hub-discussion-card__media--placeholder" aria-hidden="true"></div>}
                  <div class="community-hub-discussion-card__body">
                    <span>{copy.commentsLabel(post.commentCount)}</span>
                    <h4><a href={post.url}>{post.title}</a></h4>
                    {post.excerpt && <p>{post.excerpt}</p>}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="community-hub-empty community-hub-empty--compact">{copy.discussions.empty}</p>
          )}
        </section>
      </div>
    </section>
  </CommunityLayout>
</BaseLayout>
