---
import { getCountryFlagUrl } from '../../lib/country-flags';
interface Props { code?: string; }
const src = getCountryFlagUrl(Astro.props.code);
---
{src && <img class="country-flag" src={src} alt="" width="20" height="15" loading="lazy" decoding="async" />}
<style>
  .country-flag { display: inline-block; flex: 0 0 20px; width: 20px; height: 15px; aspect-ratio: 4 / 3; object-fit: contain; vertical-align: middle; border: 0; border-radius: 0; filter: none; box-shadow: none; }
</style>
