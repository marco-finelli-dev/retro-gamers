---
import '../../styles/components/entity-listings.css';

const { href, title, image, alt, excerpt, metadata = [], tool = false } = Astro.props;
---
<article class:list={['pt-card', tool && 'pt-card--tool']}>
  <a class="pt-card__link" href={href}>
    <div class="pt-card__media">
      {image ? <img src={image} alt={alt || title} loading="lazy" decoding="async" /> : <span aria-hidden="true">{title?.slice(0, 2).toUpperCase()}</span>}
    </div>
    <div class="pt-card__body">
      <div class="pt-meta">{metadata.filter(Boolean).map(item => <span>{item}</span>)}</div>
      <h3>{title}</h3>
      {excerpt && <p>{excerpt}</p>}
    </div>
  </a>
</article>
