---
const {
  lang = 'it',
  variant = 'box'
} = Astro.props;

const donateUrl = import.meta.env.PUBLIC_PAYPAL_DONATE_URL || '';

const isEnglish = lang === 'en';

const copy = isEnglish
  ? {
      label: 'Did you enjoy this article?',
      title: 'Support Retro-Gamers.it',
      text: 'Retro-Gamers.it is an independent project, built in our spare time and free from invasive advertising. If you enjoy what you read, you can help us keep it alive.',
      cta: 'Donate'
    }
  : {
      label: 'Ti è piaciuto l’articolo?',
      title: 'Supporta Retro-Gamers.it',
      text: 'Retro-Gamers.it è un progetto indipendente, costruito nel tempo libero e senza pubblicità invasiva. Se ti piace quello che leggi, puoi aiutarci a tenerlo vivo.',
      cta: 'Dona'
    };

const className = `support support--${variant}`;
---

{donateUrl && variant === 'footer' && (
  <a
    href={donateUrl}
    class={className}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span>{copy.label}</span>
  </a>
)}

{donateUrl && variant !== 'footer' && (
  <a
    href={donateUrl}
    class={className}
    target="_blank"
    rel="noopener noreferrer"
  >
    <div class="support__content">
      <span>{copy.label}</span>
      <h2>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>

    <strong class="support__cta">{copy.cta}</strong>
  </a>
)}