---
const {
  lang = 'it',
  variant = 'box'
} = Astro.props;

const donateUrl = import.meta.env.PUBLIC_PAYPAL_DONATE_URL || '';

const isEnglish = lang === 'en';

const copy = isEnglish
  ? {
      label: 'Support Retro-Gamers.it',
      title: 'Support the project',
      text: 'Help keep Retro-Gamers.it independent, free from invasive advertising and focused on videogame history and retro culture.',
      cta: 'Donate'
    }
  : {
      label: 'Supporta Retro-Gamers.it',
      title: 'Supporta il progetto',
      text: 'Aiuta Retro-Gamers.it a restare indipendente, libero da pubblicità invasiva e dedicato alla storia dei videogiochi e alla cultura retro.',
      cta: 'Dona'
    };

const className = `support support--${variant}`;
---

{donateUrl && variant === 'footer' && (
  <a
    href={donateUrl}
    class={className}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span>{copy.label}</span>
  </a>
)}

{donateUrl && variant !== 'footer' && (
  <a
    href={donateUrl}
    class={className}
    target="_blank"
    rel="noopener noreferrer"
  >
    <div class="support__content">
      <span>{copy.label}</span>
      <h2>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>

    <strong class="support__cta">{copy.cta}</strong>
  </a>
)}