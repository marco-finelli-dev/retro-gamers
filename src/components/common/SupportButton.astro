---
const {
  lang = 'it',
  variant = 'box'
} = Astro.props;

const donateUrl = import.meta.env.PUBLIC_PAYPAL_DONATE_URL || '';

const isEnglish = lang === 'en';

const label = isEnglish
  ? 'Support Retro-Gamers.it'
  : 'Supporta Retro-Gamers.it';

const text = isEnglish
  ? 'Help keep this independent project alive.'
  : 'Aiuta a mantenere vivo questo progetto indipendente.';

const cta = isEnglish
  ? 'Support the project'
  : 'Supporta il progetto';

const className = [
  'support-button',
  `support-button--${variant}`
].join(' ');
---

{donateUrl && (
  <a
    href={donateUrl}
    class={className}
    target="_blank"
    rel="noopener noreferrer"
  >
    {variant === 'footer' ? (
      <span>{label}</span>
    ) : (
      <>
        <span>{label}</span>
        <strong>{cta}</strong>
        <small>{text}</small>
      </>
    )}
  </a>
)}