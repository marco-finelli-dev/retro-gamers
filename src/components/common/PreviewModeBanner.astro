---
const {
  lang = 'it',
  returnTo = '/'
} = Astro.props;

const isEnglish = lang === 'en';
const label = isEnglish ? 'Preview mode' : 'Modalità anteprima';
const exitLabel = isEnglish ? 'Exit preview' : 'Esci dall’anteprima';
const exitUrl = `/api/draft-mode/disable?redirectTo=${encodeURIComponent(returnTo)}`;
---

<aside class="preview-mode-banner" role="status" aria-label={label}>
  <strong>{label}</strong>
  <a href={exitUrl}>{exitLabel}</a>
</aside>

<style>
  .preview-mode-banner {
    position: sticky;
    top: 0;
    z-index: 1000;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    color: #fff7d6;
    background: #4b3200;
    border-bottom: 1px solid rgba(255, 247, 214, 0.35);
    font-size: 0.875rem;
  }

  .preview-mode-banner a {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
