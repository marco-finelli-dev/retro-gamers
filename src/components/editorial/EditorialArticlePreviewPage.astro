---
import '../../styles/pages/editorial-area.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../article/ArticlePage.astro';
import { getCreatorRefsFromPortableText, getCreatorsReferencingArticle, mergeCreatorRefs } from '../../lib/creators';
import { fetchPreviewableEditorialArticle, requireEditorialArticleContext } from '../../lib/editorial/articles.server';
import {
  fetchEditorialArticlePreviewPost,
  fetchEditorialArticlePreviewRelatedPostCandidates,
  fetchEditorialArticlePreviewSeriesPosts
} from '../../lib/editorial/article-preview.server';
import { canPublishWorkflowArticle, getWorkflowTransitionPermissions } from '../../lib/editorial/permissions';
import { getPublicPostSummaries, getRelatedPosts } from '../../lib/posts';
import {
  attachApprovedCommentCounts,
  getApprovedCommentCountMap
} from '../../lib/supabase/comment-counts';

type EditorialLang = 'it' | 'en';

const { lang = 'it', id = '' } = Astro.props as { lang?: EditorialLang; id?: string };
const currentLang: EditorialLang = lang === 'en' ? 'en' : 'it';
const isEnglish = currentLang === 'en';

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Vary', 'Cookie');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const copy = isEnglish
  ? {
      pageTitle: 'Private article preview | Retro-Gamers.it',
      pageDescription: 'Private editorial preview for a Retro-Gamers article draft.',
      deniedTitle: 'Preview unavailable',
      deniedDescription: 'This private preview could not be loaded.',
      bannerLabel: 'Private preview',
      bannerText: 'This content is not public.',
      editArticle: 'Edit article',
      backToArticles: 'Back to articles',
      requestChanges: 'Request changes',
      approve: 'Approve',
      publish: 'Publish',
      author: 'Author',
      requestChangesConfirm: 'Return this article to the author for changes?',
      approveConfirm: 'Approve this article?',
      publishConfirm: 'Publish this article? It will become visible on the site.',
      workflowUpdating: 'Updating workflow…',
      workflowUpdated: 'Workflow updated.',
      workflowGenericError: 'The workflow action could not be completed.',
      publishUpdating: 'Publishing…',
      publishUpdated: 'Article published.',
      publishGenericError: 'The article could not be published.',
      publishRevisionConflict: 'Publishing failed: the draft changed. Reload the preview and try again.',
      publishRequiresDraft: 'Publishing failed: the draft is no longer available.',
      publishPreflightError: 'Publishing failed: the article is missing required publication data.',
      publishMissingSinglePrefix: 'Publishing failed: missing ',
      publishMissingMultiplePrefix: 'Publishing failed. Missing: ',
      missingFieldLabels: {
        title: 'title',
        slug: 'slug',
        type: 'content type',
        language: 'language',
        author: 'author',
      },
      publishForbidden: 'You do not have permission to publish this article.',
      publishPartialFailure: 'The article was published in Sanity, but workflow completion failed. Try publishing again to complete reconciliation.',
      fallbackDescription: 'Features, reviews and stories from the world of retro gaming.',
    }
  : {
      pageTitle: 'Anteprima privata articolo | Retro-Gamers.it',
      pageDescription: 'Anteprima editoriale privata per una bozza articolo Retro-Gamers.',
      deniedTitle: 'Anteprima non disponibile',
      deniedDescription: 'Non è stato possibile caricare questa anteprima privata.',
      bannerLabel: 'Anteprima privata',
      bannerText: 'Questo contenuto non è pubblico.',
      editArticle: 'Modifica articolo',
      backToArticles: 'Torna agli articoli',
      requestChanges: 'Richiedi modifiche',
      approve: 'Approva',
      publish: 'Pubblica',
      author: 'Autore',
      requestChangesConfirm: 'Restituire l’articolo all’autore per modifiche?',
      approveConfirm: 'Approvare questo articolo?',
      publishConfirm: 'Pubblicare questo articolo? Diventerà visibile sul sito.',
      workflowUpdating: 'Aggiornamento workflow…',
      workflowUpdated: 'Workflow aggiornato.',
      workflowGenericError: 'Non è stato possibile completare l’azione workflow.',
      publishUpdating: 'Pubblicazione…',
      publishUpdated: 'Articolo pubblicato.',
      publishGenericError: 'Non è stato possibile pubblicare l’articolo.',
      publishRevisionConflict: 'Pubblicazione non riuscita: la bozza è cambiata. Ricarica l’anteprima e riprova.',
      publishRequiresDraft: 'Pubblicazione non riuscita: la bozza non è più disponibile.',
      publishPreflightError: 'Pubblicazione non riuscita: mancano dati obbligatori per la pubblicazione.',
      publishMissingSinglePrefix: 'Pubblicazione non riuscita: manca ',
      publishMissingMultiplePrefix: 'Pubblicazione non riuscita. Mancano: ',
      missingFieldLabels: {
        title: 'titolo',
        slug: 'slug',
        type: 'tipo',
        language: 'lingua',
        author: 'autore',
      },
      publishForbidden: 'Non hai i permessi per pubblicare questo articolo.',
      publishPartialFailure: 'L’articolo è stato pubblicato su Sanity, ma il workflow non è stato completato. Riprova a pubblicare per completare la riconciliazione.',
      fallbackDescription: 'Recensioni, news, speciali e guide dal mondo retro-gaming.',
    };

const editHref = isEnglish
  ? `/en/account/editor/articles/${encodeURIComponent(id)}/`
  : `/account/editor/articles/${encodeURIComponent(id)}/`;
const articlesHref = isEnglish
  ? '/en/account/editor/articles/'
  : '/account/editor/articles/';

function getPlainTextFromContent(content = []) {
  return content
    .flatMap((block) => {
      if (block?._type === 'block') {
        return block.children?.map((child) => child.text || '') || [];
      }

      if (block?._type === 'asideBox') {
        return block.content
          ?.filter((inner) => inner?._type === 'block')
          .flatMap((inner) =>
            inner.children?.map((child) => child.text || '') || []
          ) || [];
      }

      return [];
    })
    .join(' ');
}

function getReadingTime(content = []) {
  const text = getPlainTextFromContent(content);
  const words = text.trim().split(/\s+/).filter(Boolean).length;

  return Math.max(1, Math.ceil(words / 220));
}

function getEditorialPageTitle(post, fallback = '') {
  const seoTitle = String(post?.seoTitle || '').trim();
  const title = String(post?.title || '').trim();
  const fallbackValue = String(fallback || '').trim();
  const looksLikeSlug =
    seoTitle &&
    (seoTitle === fallbackValue ||
      (/^[a-z0-9]+(?:-[a-z0-9]+)+$/i.test(seoTitle) &&
        !/[\s:,.!?'"’“”]/.test(seoTitle)));

  return looksLikeSlug
    ? title || seoTitle
    : seoTitle || title || copy.pageTitle;
}

function getNormalizedDocumentId(value = '') {
  return String(value || '').replace(/^drafts\./, '');
}

function mergePreviewSeriesPosts(currentPost, seriesPosts = []) {
  if (!currentPost?.editorialSeries?.[0]?._id) return [];

  const currentRootId = getNormalizedDocumentId(currentPost._id);
  const hasCurrentPost = seriesPosts.some((item) =>
    getNormalizedDocumentId(item?._id) === currentRootId
  );

  return hasCurrentPost ? seriesPosts : [...seriesPosts, currentPost];
}

let post = null;
let error = '';
let documentLifecycle = 'missing';
let documentSource = '';
let workflowPermissions = null;
let canPublish = false;
let previewAuthor = null;

const access = await requireEditorialArticleContext(Astro.cookies);

if (access.ok) {
  const editableResult = await fetchPreviewableEditorialArticle({
    context: access.context,
    rootDocumentId: id,
  });

  if (editableResult.ok) {
    documentLifecycle = editableResult.documentLifecycle;
    documentSource = editableResult.documentSource;
    workflowPermissions = getWorkflowTransitionPermissions(access.context, editableResult.ownership);
    canPublish = canPublishWorkflowArticle(access.context, editableResult.ownership);
    previewAuthor = editableResult.article?.author || null;

    post = await fetchEditorialArticlePreviewPost(String(editableResult.sourceDocument?._id || ''));

    if (!post) {
      error = 'sanity_preview_document_missing';
    }
  } else {
    Astro.response.status = editableResult.status || 500;
    error = editableResult.error || 'preview_load_failed';
  }
} else {
  Astro.response.status = access.status || 401;
  error = access.error || 'unauthorized';
}

const rootPostId = String(post?._id || '').replace(/^drafts\./, '');
const portableTextCreators = getCreatorRefsFromPortableText(post?.content || []);
const seriesId = post?.editorialSeries?.[0]?._id || '';
const [
  publicPostSummaries,
  relatedPostCandidates,
  inverseCreators,
  previewSeriesPosts,
] = post
  ? await Promise.all([
      getPublicPostSummaries(),
      fetchEditorialArticlePreviewRelatedPostCandidates(),
      getCreatorsReferencingArticle(rootPostId),
      fetchEditorialArticlePreviewSeriesPosts({
        seriesId,
        language: currentLang,
      }),
    ])
  : [[], [], [], []];

const hydratedPost = post
  ? {
      ...post,
      creators: mergeCreatorRefs(post.creators, inverseCreators, portableTextCreators),
      language: post.language || currentLang,
      readingTime: getReadingTime(post.content || []),
    }
  : null;

const headerPosts = publicPostSummaries.filter((item) => (item.language || 'it') === currentLang);
const headerReviews = headerPosts.filter((item) => item.type === 'review');
const headerNews = headerPosts.filter((item) => item.type === 'news');
const relatedCandidatePosts = relatedPostCandidates.filter((item) =>
  getNormalizedDocumentId(item?._id) !== rootPostId
);
const relatedPosts = hydratedPost ? getRelatedPosts(hydratedPost, relatedCandidatePosts, 3) : [];
const commentCountMap = hydratedPost
  ? await getApprovedCommentCountMap([hydratedPost, ...relatedPosts], currentLang)
  : new Map();
const hydratedPostWithCommentCount = hydratedPost
  ? attachApprovedCommentCounts([hydratedPost], commentCountMap, currentLang)[0]
  : null;
const relatedPostsWithCommentCounts = attachApprovedCommentCounts(
  relatedPosts,
  commentCountMap,
  currentLang
);
const seriesPosts = hydratedPostWithCommentCount
  ? mergePreviewSeriesPosts(hydratedPostWithCommentCount, previewSeriesPosts)
  : [];
const pageTitle = getEditorialPageTitle(hydratedPostWithCommentCount, hydratedPostWithCommentCount?.slug);
const pageDescription =
  hydratedPostWithCommentCount?.excerpt ||
  hydratedPostWithCommentCount?.subtitle ||
  copy.fallbackDescription;
const pageImage =
  hydratedPostWithCommentCount?.featuredImage?.asset?.url ||
  hydratedPostWithCommentCount?.gameInfo?.cover?.asset?.url ||
  '/og-image.jpg';
const articleAuthorName =
  hydratedPostWithCommentCount?.author?.displayName === 'nickname' && hydratedPostWithCommentCount?.author?.nickname
    ? hydratedPostWithCommentCount.author.nickname
    : hydratedPostWithCommentCount?.author?.name || '';
const articleAuthorSlug =
  typeof hydratedPostWithCommentCount?.author?.slug === 'string'
    ? hydratedPostWithCommentCount.author.slug
    : hydratedPostWithCommentCount?.author?.slug?.current || '';
const articleAuthorUrl = articleAuthorSlug
  ? currentLang === 'en'
    ? `/en/authors/${articleAuthorSlug}/`
    : `/autori/${articleAuthorSlug}/`
  : '';
const canRequestChanges = Boolean(workflowPermissions?.canRequestChanges);
const canApprove = Boolean(workflowPermissions?.canApprove);
const previewAuthorLabel = articleAuthorName || previewAuthor?.label || '—';
---

<BaseLayout
  reviews={headerReviews}
  news={headerNews}
  lang={currentLang}
  title={post ? pageTitle : copy.pageTitle}
  description={post ? pageDescription : copy.pageDescription}
  image={pageImage}
  canonical={Astro.url.href}
  type={post ? 'article' : 'website'}
  publishedAt={hydratedPostWithCommentCount?.publishedAt}
  updatedAt={hydratedPostWithCommentCount?.lastUpdated}
  articleAuthorName={articleAuthorName}
  articleAuthorUrl={articleAuthorUrl}
  noindex={true}
>
  <div class="editorial-private-preview">
    <aside class="editorial-private-preview__banner" role="status">
      <div class="editorial-private-preview__summary">
        <strong>{copy.bannerLabel}</strong>
        <span>{copy.bannerText}</span>
        {documentLifecycle !== 'missing' && (
          <small>{documentSource || documentLifecycle}</small>
        )}
      </div>
      <div class="editorial-private-preview__meta">
        <span>{copy.author}</span>
        <strong>{previewAuthorLabel}</strong>
      </div>
      <div class="editorial-private-preview__actions">
        {canRequestChanges && (
          <button
            class="editorial-mini-button"
            type="button"
            data-editorial-preview-workflow-action="request_changes"
            data-endpoint={`/api/editor/articles/${encodeURIComponent(id)}/workflow`}
            data-confirm={copy.requestChangesConfirm}
          >
            {copy.requestChanges}
          </button>
        )}
        {canApprove && (
          <button
            class="editorial-mini-button"
            type="button"
            data-editorial-preview-workflow-action="approve"
            data-endpoint={`/api/editor/articles/${encodeURIComponent(id)}/workflow`}
            data-confirm={copy.approveConfirm}
          >
            {copy.approve}
          </button>
        )}
        {canPublish && (
          <button
            class="editorial-mini-button editorial-mini-button--primary"
            type="button"
            data-editorial-preview-publish
            data-endpoint={`/api/editor/articles/${encodeURIComponent(id)}/publish`}
            data-confirm={copy.publishConfirm}
          >
            {copy.publish}
          </button>
        )}
      </div>
      <div class="editorial-private-preview__navigation">
        <a href={editHref}>{copy.editArticle}</a>
        <a href={articlesHref}>{copy.backToArticles}</a>
      </div>
    </aside>

    {hydratedPostWithCommentCount ? (
      <ArticlePage
        post={hydratedPostWithCommentCount}
        relatedPosts={relatedPostsWithCommentCounts}
        seriesPosts={seriesPosts}
        comments={[]}
        hideNewsletterPromo={false}
        isPreview={true}
        disableCommunity={true}
      />
    ) : (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.bannerLabel}</p>
        <h1>{copy.deniedTitle}</h1>
        <p class="editorial-message" data-tone="error">{copy.deniedDescription}</p>
        <p class="editorial-message">{error}</p>
        <a class="editorial-button" href={articlesHref}>{copy.backToArticles}</a>
      </section>
    )}
  </div>
</BaseLayout>

<script define:vars={{
  articlesHref,
  workflowUpdating: copy.workflowUpdating,
  workflowUpdated: copy.workflowUpdated,
  workflowGenericError: copy.workflowGenericError,
  publishUpdating: copy.publishUpdating,
  publishUpdated: copy.publishUpdated,
  publishGenericError: copy.publishGenericError,
  publishRevisionConflict: copy.publishRevisionConflict,
  publishRequiresDraft: copy.publishRequiresDraft,
  publishPreflightError: copy.publishPreflightError,
  publishMissingSinglePrefix: copy.publishMissingSinglePrefix,
  publishMissingMultiplePrefix: copy.publishMissingMultiplePrefix,
  missingFieldLabels: copy.missingFieldLabels,
  publishForbidden: copy.publishForbidden,
  publishPartialFailure: copy.publishPartialFailure,
}}>
  const workflowButtons = document.querySelectorAll('[data-editorial-preview-workflow-action]');
  const publishButton = document.querySelector('[data-editorial-preview-publish]');

  const formatMissingFields = (fields) => {
    if (!Array.isArray(fields)) return '';

    return fields
      .map((field) => missingFieldLabels?.[field] || field)
      .filter(Boolean)
      .join(', ');
  };

  const getPublishErrorMessage = (error, phase, missingFields = []) => {
    if (error === 'article_publish_forbidden') return publishForbidden;
    if (error === 'publish_revision_conflict') return publishRevisionConflict;
    if (error === 'publish_requires_draft') return publishRequiresDraft;
    if (error === 'publish_partial_failure') return publishPartialFailure;
    if (error === 'publish_missing_required_fields') {
      const formattedFields = formatMissingFields(missingFields);

      if (!formattedFields) {
        return publishPreflightError;
      }

      return missingFields.length === 1
        ? `${publishMissingSinglePrefix}${formattedFields}.`
        : `${publishMissingMultiplePrefix}${formattedFields}.`;
    }
    if (
      phase === 'sanity_preflight' ||
      error === 'publish_title_required' ||
      error === 'publish_slug_required' ||
      error === 'publish_type_required' ||
      error === 'publish_language_required' ||
      error === 'author_ownership_conflict'
    ) {
      return publishPreflightError;
    }

    return publishGenericError;
  };

  const setPreviewActionsDisabled = (disabled) => {
    document
      .querySelectorAll('[data-editorial-preview-workflow-action], [data-editorial-preview-publish]')
      .forEach((control) => {
        if (disabled) {
          control.setAttribute('disabled', 'disabled');
        } else {
          control.removeAttribute('disabled');
        }
      });
  };

  workflowButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const endpoint = button.getAttribute('data-endpoint') || '';
      const action = button.getAttribute('data-editorial-preview-workflow-action') || '';
      const confirmMessage = button.getAttribute('data-confirm') || '';

      if (!endpoint || !action) return;
      if (confirmMessage && !window.confirm(confirmMessage)) return;

      const originalText = button.textContent || '';
      button.setAttribute('disabled', 'disabled');
      button.textContent = workflowUpdating;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify({ action }),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.error || 'workflow_failed');
        }

        button.textContent = workflowUpdated;
        window.location.assign(articlesHref);
      } catch {
        button.removeAttribute('disabled');
        button.textContent = originalText || workflowGenericError;
        window.alert(workflowGenericError);
      }
    });
  });

  if (publishButton) {
    publishButton.addEventListener('click', async () => {
      const endpoint = publishButton.getAttribute('data-endpoint') || '';
      const confirmMessage = publishButton.getAttribute('data-confirm') || '';

      if (!endpoint) return;
      if (confirmMessage && !window.confirm(confirmMessage)) return;

      const originalText = publishButton.textContent || '';
      setPreviewActionsDisabled(true);
      publishButton.textContent = publishUpdating;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            accept: 'application/json',
          },
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          const missingFields = Array.isArray(result?.missingFields) ? result.missingFields : [];
          const message = getPublishErrorMessage(result?.error || 'publish_failed', result?.phase || '', missingFields);
          console.warn('Editorial publish failed', {
            error: result?.error || 'publish_failed',
            phase: result?.phase || 'unknown',
            missingFields,
            status: response.status,
          });
          throw new Error(message);
        }

        publishButton.textContent = publishUpdated;
        window.location.assign(articlesHref);
      } catch (error) {
        setPreviewActionsDisabled(false);
        const message = error instanceof Error && error.message ? error.message : publishGenericError;
        publishButton.textContent = originalText || publishGenericError;
        window.alert(message);
      }
    });
  }
</script>
