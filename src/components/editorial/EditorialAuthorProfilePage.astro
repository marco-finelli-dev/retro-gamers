---
import '../../styles/pages/editorial-area.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../community/CommunityHero.astro';
import CommunityLayout from '../community/CommunityLayout.astro';
import CommunitySidebarProfile from '../community/CommunitySidebarProfile.astro';
import CommunitySidebarSection from '../community/CommunitySidebarSection.astro';
import CommunityStatList from '../community/CommunityStatList.astro';
import { getPublicAuthorRoleLabel } from '../../lib/editorial/labels';
import {
  fetchEditorialAuthorProfile,
  fetchPublishedArticleCountForAuthor,
  requireActiveEditorialAuthorContext,
} from '../../lib/editorial/profile.server';

type EditorialLang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: EditorialLang };
const currentLang: EditorialLang = lang === 'en' ? 'en' : 'it';
const isEnglish = currentLang === 'en';
const access = await requireActiveEditorialAuthorContext(Astro.cookies);

const copy = isEnglish
  ? {
      pageTitle: 'Author profile | Retro-Gamers.it',
      pageDescription: 'Edit your public Retro-Gamers author profile.',
      kicker: 'Editorial area',
      title: 'Author profile',
      description:
        'Update only your public Sanity author profile. Editorial role and public slug are managed separately.',
      deniedTitle: 'Editorial access required',
      deniedDescription:
        'This page is available only to active editorial contributors linked to a Sanity author profile.',
      missingAuthorTitle: 'Sanity author not found',
      missingAuthorDescription:
        'Your editorial access is linked to an author profile that is not available in the published dataset. Profile editing is blocked until the link is fixed.',
      back: 'Back to dashboard',
      publicProfileIt: 'Italian author page',
      publicProfileEn: 'English author page',
      profileLabel: 'Author identity',
      overviewLabel: 'Overview',
      tools: 'Tools',
      accountCta: 'Go to account',
      name: 'Name',
      nickname: 'Nickname',
      displayName: 'Display name mode',
      displayNameReal: 'Use real name',
      displayNameNickname: 'Use nickname',
      bio: 'Italian bio',
      bioEn: 'English bio',
      richBioReadOnly:
        'This biography contains formatting or links. To avoid losing them, edit it from Sanity Studio.',
      image: 'Avatar image',
      cover: 'Cover image',
      imageAlt: 'Avatar alt text',
      coverAlt: 'Cover alt text',
      website: 'Website',
      facebook: 'Facebook',
      twitter: 'X / Twitter',
      tiktok: 'TikTok',
      youtube: 'YouTube',
      twitch: 'Twitch',
      save: 'Save profile',
      saving: 'Saving...',
      saved: 'Profile saved.',
      upload: 'Upload image',
      uploading: 'Uploading...',
      uploadSaved: 'Image uploaded.',
      uploadHelpAvatar: 'JPG, PNG or WebP. Max 2 MB. The previous asset is not deleted.',
      uploadHelpCover: 'JPG, PNG or WebP. Max 5 MB. The previous asset is not deleted.',
      currentImage: 'Current image',
      currentCover: 'Current cover',
      noCurrentImage: 'No current avatar image',
      noCurrentCover: 'No current cover image',
      localPreview: 'New image',
      recommendedAvatar: 'Recommended: 1000 × 1000 px, 1:1. JPG, PNG or WebP. Max 2 MB.',
      recommendedCover: 'Recommended: 1600 × 600 px, panoramic 8:3. JPG, PNG or WebP. Max 5 MB.',
      coverCropNote:
        'Keep faces, text and important elements near the centre: the cover may be cropped on smaller screens.',
      fileReady: 'File ready',
      recommendedFormat: 'Recommended format.',
      ratioWarningAvatar: 'Usable image, but the recommended ratio is 1:1.',
      ratioWarningCover: 'Usable image, but the recommended ratio is 8:3.',
      lowResolutionWarning: 'Low resolution: the result may look less sharp.',
      chooseFile: 'Choose a file or drop it here',
      dropFile: 'Drop the image here',
      readonlyData: 'Editorial information',
      slug: 'Slug',
      authorRole: 'Public author role',
      completeness: 'Profile completeness',
      publishedArticles: 'Published articles',
      notSet: 'Not set',
      error: 'Unable to update the profile. Please try again.',
      conflict: 'The author profile changed while you were editing. Reload the page and try again.',
      invalidUrl: 'Use complete http or https URLs.',
      invalidAlt: 'Alt text is required for uploads and must stay under 120 characters.',
      invalidFile: 'Use a JPG, PNG or WebP image within the allowed size.',
      invalidMime: 'Use JPG, PNG or WebP. SVG is not allowed.',
      invalidSizeAvatar: 'Avatar images must be 2 MB or smaller.',
      invalidSizeCover: 'Cover images must be 5 MB or smaller.',
      unsaved: 'Unsaved changes',
    }
  : {
      pageTitle: 'Profilo autore | Retro-Gamers.it',
      pageDescription: 'Modifica il tuo profilo autore pubblico su Retro-Gamers.it.',
      kicker: 'Area redazione',
      title: 'Profilo autore',
      description:
        'Aggiorna soltanto il tuo profilo autore pubblico Sanity. Ruolo editoriale e slug pubblico sono gestiti separatamente.',
      deniedTitle: 'Accesso redazionale richiesto',
      deniedDescription:
        'Questa pagina è disponibile solo per collaboratori redazionali attivi collegati a un profilo autore Sanity.',
      missingAuthorTitle: 'Autore Sanity non trovato',
      missingAuthorDescription:
        'Il tuo accesso redazionale è collegato a un profilo autore non disponibile nel dataset pubblicato. La modifica del profilo resta bloccata finché il collegamento non viene corretto.',
      back: 'Torna alla dashboard',
      publicProfileIt: 'Pagina autore italiana',
      publicProfileEn: 'Pagina autore inglese',
      profileLabel: 'Identità autore',
      overviewLabel: 'Panoramica',
      tools: 'Strumenti',
      accountCta: 'Vai all’account',
      name: 'Nome',
      nickname: 'Nickname',
      displayName: 'Nome visualizzato',
      displayNameReal: 'Usa nome reale',
      displayNameNickname: 'Usa nickname',
      bio: 'Bio in italiano',
      bioEn: 'Bio in inglese',
      richBioReadOnly:
        'Questa bio contiene formattazione o link. Per evitare di perderli, modificala da Sanity Studio.',
      image: 'Immagine autore',
      cover: 'Cover autore',
      imageAlt: 'Alt text immagine autore',
      coverAlt: 'Alt text cover',
      website: 'Sito web',
      facebook: 'Facebook',
      twitter: 'X / Twitter',
      tiktok: 'TikTok',
      youtube: 'YouTube',
      twitch: 'Twitch',
      save: 'Salva profilo',
      saving: 'Salvataggio...',
      saved: 'Profilo salvato.',
      upload: 'Carica immagine',
      uploading: 'Caricamento...',
      uploadSaved: 'Immagine caricata.',
      uploadHelpAvatar: 'JPG, PNG o WebP. Max 2 MB. L’asset precedente non viene eliminato.',
      uploadHelpCover: 'JPG, PNG o WebP. Max 5 MB. L’asset precedente non viene eliminato.',
      currentImage: 'Immagine attuale',
      currentCover: 'Cover attuale',
      noCurrentImage: 'Nessuna immagine autore impostata',
      noCurrentCover: 'Nessuna cover autore impostata',
      localPreview: 'Nuova immagine',
      recommendedAvatar: 'Consigliato: 1000 × 1000 px, rapporto 1:1. JPG, PNG o WebP. Max 2 MB.',
      recommendedCover: 'Consigliato: 1600 × 600 px, panoramica 8:3. JPG, PNG o WebP. Max 5 MB.',
      coverCropNote:
        'Mantieni volti, testi ed elementi importanti nella zona centrale: su mobile la cover può essere ritagliata.',
      fileReady: 'File pronto',
      recommendedFormat: 'Formato consigliato.',
      ratioWarningAvatar: 'Immagine utilizzabile, ma il rapporto consigliato è 1:1.',
      ratioWarningCover: 'Immagine utilizzabile, ma il rapporto consigliato è 8:3.',
      lowResolutionWarning: 'Risoluzione bassa: il risultato potrebbe essere meno nitido.',
      chooseFile: 'Scegli un file o trascinalo qui',
      dropFile: 'Rilascia l’immagine qui',
      readonlyData: 'Informazioni editoriali',
      slug: 'Slug',
      authorRole: 'Ruolo autore pubblico',
      completeness: 'Completezza profilo',
      publishedArticles: 'Articoli pubblicati',
      notSet: 'Non impostato',
      error: 'Non riesco ad aggiornare il profilo. Riprova.',
      conflict: 'Il profilo autore è cambiato mentre lo stavi modificando. Ricarica la pagina e riprova.',
      invalidUrl: 'Usa URL completi con http o https.',
      invalidAlt: 'L’alt text è richiesto per gli upload e deve restare sotto 120 caratteri.',
      invalidFile: 'Usa un’immagine JPG, PNG o WebP entro la dimensione consentita.',
      invalidMime: 'Usa JPG, PNG o WebP. SVG non è consentito.',
      invalidSizeAvatar: 'Le immagini autore devono essere al massimo 2 MB.',
      invalidSizeCover: 'Le cover devono essere al massimo 5 MB.',
      unsaved: 'Modifiche non salvate',
    };

let author = null;
let publishedArticleCount = 0;

if (access.ok) {
  author = await fetchEditorialAuthorProfile(access.context.sanityAuthorId);

  if (author) {
    publishedArticleCount = await fetchPublishedArticleCountForAuthor(access.context.sanityAuthorId);
  }
}

const dashboardHref = isEnglish ? '/en/account/editor/' : '/account/editor/';
const accountHref = isEnglish ? '/en/account/' : '/account/';
const languageSwitch = isEnglish ? '/account/editor/profile/' : '/en/account/editor/profile/';
const sidebarName = author?.displayName === 'nickname' && author.nickname
  ? author.nickname
  : author?.name || '';
const authorPublicUrlIt = author?.slug ? `/autori/${author.slug}/` : '';
const authorPublicUrlEn = author?.slug ? `/en/authors/${author.slug}/` : '';
const authorRoleLabel = author
  ? getPublicAuthorRoleLabel(author.role, currentLang)
  : '';
---

<BaseLayout
  lang={currentLang}
  title={copy.pageTitle}
  description={copy.pageDescription}
  canonical={Astro.url.href}
  languageSwitch={languageSwitch}
  noindex={true}
>
  <CommunityLayout class="editorial-area-page editorial-profile-page" sidebar={access.ok && Boolean(author)}>
    {access.ok && author && (
      <Fragment slot="sidebar">
        <CommunitySidebarProfile
          label={copy.profileLabel}
          name={sidebarName || author.name}
          avatarUrl={author.image?.asset?.url || ''}
        />

        <CommunityStatList
          title={copy.overviewLabel}
          items={[
            { label: copy.publishedArticles, value: publishedArticleCount },
            { label: copy.completeness, value: author.completeness.label },
          ]}
        />

        <CommunitySidebarSection title={copy.tools}>
          <div class="community-link-list">
            <a href={dashboardHref}>{copy.back}</a>
            {authorPublicUrlIt && (
              <a href={authorPublicUrlIt} data-language-session-override="it">
                {copy.publicProfileIt}
              </a>
            )}
            {authorPublicUrlEn && (
              <a href={authorPublicUrlEn} data-language-session-override="en">
                {copy.publicProfileEn}
              </a>
            )}
          </div>
        </CommunitySidebarSection>
      </Fragment>
    )}

    <CommunityHero
      kicker={copy.kicker}
      title={copy.title}
      description={copy.description}
    />

    {!access.ok && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2>{copy.deniedTitle}</h2>
        <p>{copy.deniedDescription}</p>
        <a class="editorial-button" href={accountHref}>{copy.accountCta}</a>
      </section>
    )}

    {access.ok && !author && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.profileLabel}</p>
        <h2>{copy.missingAuthorTitle}</h2>
        <p>{copy.missingAuthorDescription}</p>
      </section>
    )}

    {access.ok && author && (
      <div class="editorial-profile-shell" data-editor-profile-root data-lang={currentLang}>
        <section class="editorial-card editorial-profile-summary">
          {author.cover?.asset?.url && (
            <img
              class="editorial-profile-summary__cover"
              src={author.cover.asset.url}
              alt={author.cover.alt || ''}
              width="1180"
              height="420"
              data-editor-cover-preview
            />
          )}

          <div class="editorial-profile-summary__body">
            <div class="editorial-profile-summary__avatar">
              <img
                src={author.image?.asset?.url || ''}
                alt={author.image?.alt || ''}
                width="132"
                height="132"
                hidden={!author.image?.asset?.url}
                data-editor-avatar-preview
              />
              <span aria-hidden="true" hidden={Boolean(author.image?.asset?.url)} data-editor-avatar-placeholder>
                {author.name.slice(0, 1).toUpperCase()}
              </span>
            </div>

            <div>
              <p class="editorial-kicker">{copy.profileLabel}</p>
              <h2>{sidebarName || author.name}</h2>
              <p>{copy.completeness}: <strong data-editor-completeness>{author.completeness.label}</strong></p>
            </div>
          </div>
        </section>

        <section class="editorial-card">
          <div class="editorial-section-heading">
            <p class="editorial-kicker">{copy.profileLabel}</p>
            <h2>{copy.title}</h2>
            <p>
              {isEnglish
                ? 'Only whitelisted public author fields are editable here.'
                : 'Qui sono modificabili solo i campi pubblici autore esplicitamente consentiti.'}
            </p>
          </div>

          <form class="editorial-form" data-editor-profile-form>
            <input type="hidden" name="_rev" value={author._rev} data-editor-profile-rev />

            <div class="editorial-form-grid">
              <label>
                <span>{copy.name}</span>
                <input name="name" value={author.name} maxlength="120" required />
              </label>

              <label>
                <span>{copy.nickname}</span>
                <input name="nickname" value={author.nickname} maxlength="120" />
              </label>

              <label>
                <span>{copy.displayName}</span>
                <select name="displayName">
                  <option value="real" selected={author.displayName !== 'nickname'}>{copy.displayNameReal}</option>
                  <option value="nickname" selected={author.displayName === 'nickname'}>{copy.displayNameNickname}</option>
                </select>
              </label>

              <label>
                <span>{copy.website}</span>
                <input name="website" type="url" value={author.website} placeholder="https://…" />
              </label>
            </div>

            {author.bioEditable ? (
              <label>
                <span>{copy.bio}</span>
                <textarea name="bioText" rows="8" maxlength="3000">{author.bioText}</textarea>
              </label>
            ) : (
              <div class="editorial-readonly-field">
                <span>{copy.bio}</span>
                <p>{copy.richBioReadOnly}</p>
                <pre>{author.bioText}</pre>
              </div>
            )}

            {author.bioEnEditable ? (
              <label>
                <span>{copy.bioEn}</span>
                <textarea name="bioEnText" rows="8" maxlength="3000">{author.bioEnText}</textarea>
              </label>
            ) : (
              <div class="editorial-readonly-field">
                <span>{copy.bioEn}</span>
                <p>{copy.richBioReadOnly}</p>
                <pre>{author.bioEnText}</pre>
              </div>
            )}

            <div class="editorial-form-grid">
              <label>
                <span>{copy.facebook}</span>
                <input name="facebook" type="url" value={author.facebook} placeholder="https://…" />
              </label>
              <label>
                <span>{copy.twitter}</span>
                <input name="twitter" type="url" value={author.twitter} placeholder="https://…" />
              </label>
              <label>
                <span>{copy.tiktok}</span>
                <input name="tiktok" type="url" value={author.tiktok} placeholder="https://…" />
              </label>
              <label>
                <span>{copy.youtube}</span>
                <input name="youtube" type="url" value={author.youtube} placeholder="https://…" />
              </label>
              <label>
                <span>{copy.twitch}</span>
                <input name="twitch" type="url" value={author.twitch} placeholder="https://…" />
              </label>
            </div>

            <div class="editorial-form-grid">
              <label>
                <span>{copy.imageAlt}</span>
                <input name="imageAlt" value={author.image?.alt || ''} maxlength="120" />
              </label>
              <label>
                <span>{copy.coverAlt}</span>
                <input name="coverAlt" value={author.cover?.alt || ''} maxlength="120" />
              </label>
            </div>

            <div class="editorial-form-actions">
              <button type="submit" class="editorial-button" data-editor-save-button>
                {copy.save}
              </button>
              <a href={dashboardHref}>{copy.back}</a>
            </div>

            <p class="editorial-message editorial-message--unsaved" data-editor-unsaved-message hidden>{copy.unsaved}</p>
            <p class="editorial-message" data-editor-profile-message hidden></p>
          </form>
        </section>

        <section class="editorial-assets-grid">
          <form class="editorial-card editorial-upload-card" data-editor-upload-form data-asset-type="avatar">
            <div class="editorial-upload-card__header">
              <p class="editorial-kicker">{copy.image}</p>
              <h2>{copy.image}</h2>
              <p>{copy.uploadHelpAvatar}</p>
              <p class="editorial-upload-guidance">{copy.recommendedAvatar}</p>
            </div>

            <div class="editorial-current-media editorial-current-media--avatar">
              <span>{copy.currentImage}</span>
              <div class="editorial-current-media__frame editorial-current-media__frame--avatar">
                <img
                  src={author.image?.asset?.url || ''}
                  alt={author.image?.alt || ''}
                  hidden={!author.image?.asset?.url}
                  data-editor-avatar-preview
                />
                <span
                  class="editorial-current-media__placeholder"
                  hidden={Boolean(author.image?.asset?.url)}
                  data-editor-avatar-placeholder
                >
                  {copy.noCurrentImage}
                </span>
              </div>
            </div>

            <div class="editorial-local-preview editorial-local-preview--avatar" data-editor-local-preview hidden>
              <span>{copy.localPreview}</span>
              <div class="editorial-local-preview__frame editorial-local-preview__frame--avatar">
                <img alt="" data-editor-local-preview-image />
              </div>
              <p class="editorial-file-meta" data-editor-file-meta></p>
              <p class="editorial-file-advice" data-editor-file-advice></p>
            </div>

            <div class="editorial-upload-card__controls">
              <label class="editorial-dropzone" data-editor-dropzone>
                <input type="file" name="file" accept="image/jpeg,image/png,image/webp" />
                <span data-editor-drop-label>{copy.chooseFile}</span>
              </label>

              <button type="submit" class="editorial-button">{copy.upload}</button>
              <p class="editorial-message" data-editor-upload-message hidden></p>
            </div>
          </form>

          <form class="editorial-card editorial-upload-card" data-editor-upload-form data-asset-type="cover">
            <div class="editorial-upload-card__header">
              <p class="editorial-kicker">{copy.cover}</p>
              <h2>{copy.cover}</h2>
              <p>{copy.uploadHelpCover}</p>
              <p class="editorial-upload-guidance">{copy.recommendedCover}</p>
              <p class="editorial-upload-guidance">{copy.coverCropNote}</p>
            </div>

            <div class="editorial-current-media editorial-current-media--cover">
              <span>{copy.currentCover}</span>
              <div class="editorial-current-media__frame editorial-current-media__frame--cover">
                <img
                  src={author.cover?.asset?.url || ''}
                  alt={author.cover?.alt || ''}
                  hidden={!author.cover?.asset?.url}
                  data-editor-cover-preview
                />
                <span
                  class="editorial-current-media__placeholder"
                  hidden={Boolean(author.cover?.asset?.url)}
                  data-editor-cover-placeholder
                >
                  {copy.noCurrentCover}
                </span>
              </div>
            </div>

            <div class="editorial-local-preview editorial-local-preview--cover" data-editor-local-preview hidden>
              <span>{copy.localPreview}</span>
              <div class="editorial-local-preview__frame editorial-local-preview__frame--cover">
                <img alt="" data-editor-local-preview-image />
              </div>
              <p class="editorial-file-meta" data-editor-file-meta></p>
              <p class="editorial-file-advice" data-editor-file-advice></p>
            </div>

            <div class="editorial-upload-card__controls">
              <label class="editorial-dropzone" data-editor-dropzone>
                <input type="file" name="file" accept="image/jpeg,image/png,image/webp" />
                <span data-editor-drop-label>{copy.chooseFile}</span>
              </label>

              <button type="submit" class="editorial-button">{copy.upload}</button>
              <p class="editorial-message" data-editor-upload-message hidden></p>
            </div>
          </form>
        </section>

        <section class="editorial-card">
          <div class="editorial-section-heading">
            <p class="editorial-kicker">{copy.readonlyData}</p>
            <h2>{copy.readonlyData}</h2>
          </div>

          <dl class="editorial-definition-list editorial-definition-list--grid">
            <div>
              <dt>{copy.slug}</dt>
              <dd>{author.slug || copy.notSet}</dd>
            </div>
            <div>
              <dt>{copy.authorRole}</dt>
              <dd>{authorRoleLabel || copy.notSet}</dd>
            </div>
          </dl>
        </section>
      </div>
    )}
  </CommunityLayout>

  <script is:inline>
(() => {
  const root = document.querySelector('[data-editor-profile-root]');

  if (!root) return;

  const isEnglish = root.dataset.lang === 'en';
  const messages = isEnglish
    ? {
        saved: 'Profile saved.',
        saving: 'Saving...',
        uploading: 'Uploading...',
        upload: 'Upload image',
        uploadSaved: 'Image uploaded.',
        error: 'Unable to update the profile. Please try again.',
        conflict: 'The author profile changed while you were editing. Reload the page and try again.',
        richBioReadOnly: 'This biography contains formatting or links. Edit it from Sanity Studio to avoid losing them.',
        invalidUrl: 'Use complete http or https URLs.',
        invalidAlt: 'Alt text is required for uploads and must stay under 120 characters.',
        invalidFile: 'Use a JPG, PNG or WebP image within the allowed size.',
        invalidMime: 'Use JPG, PNG or WebP. SVG is not allowed.',
        invalidSizeAvatar: 'Avatar images must be 2 MB or smaller.',
        invalidSizeCover: 'Cover images must be 5 MB or smaller.',
        chooseFile: 'Choose a file or drop it here',
        dropFile: 'Drop the image here',
        fileReady: 'File ready',
        recommendedFormat: 'Recommended format.',
        ratioWarningAvatar: 'Usable image, but the recommended ratio is 1:1.',
        ratioWarningCover: 'Usable image, but the recommended ratio is 8:3.',
        lowResolutionWarning: 'Low resolution: the result may look less sharp.',
      }
    : {
        saved: 'Profilo salvato.',
        saving: 'Salvataggio...',
        uploading: 'Caricamento...',
        upload: 'Carica immagine',
        uploadSaved: 'Immagine caricata.',
        error: 'Non riesco ad aggiornare il profilo. Riprova.',
        conflict: 'Il profilo autore è cambiato mentre lo stavi modificando. Ricarica la pagina e riprova.',
        richBioReadOnly: 'Questa bio contiene formattazione o link. Modificala da Sanity Studio per evitare di perderli.',
        invalidUrl: 'Usa URL completi con http o https.',
        invalidAlt: 'L’alt text è richiesto per gli upload e deve restare sotto 120 caratteri.',
        invalidFile: 'Usa un’immagine JPG, PNG o WebP entro la dimensione consentita.',
        invalidMime: 'Usa JPG, PNG o WebP. SVG non è consentito.',
        invalidSizeAvatar: 'Le immagini autore devono essere al massimo 2 MB.',
        invalidSizeCover: 'Le cover devono essere al massimo 5 MB.',
        chooseFile: 'Scegli un file o trascinalo qui',
        dropFile: 'Rilascia l’immagine qui',
        fileReady: 'File pronto',
        recommendedFormat: 'Formato consigliato.',
        ratioWarningAvatar: 'Immagine utilizzabile, ma il rapporto consigliato è 1:1.',
        ratioWarningCover: 'Immagine utilizzabile, ma il rapporto consigliato è 8:3.',
        lowResolutionWarning: 'Risoluzione bassa: il risultato potrebbe essere meno nitido.',
      };

  const form = root.querySelector('[data-editor-profile-form]');
  const revInput = root.querySelector('[data-editor-profile-rev]');
  const saveButton = root.querySelector('[data-editor-save-button]');
  const profileMessage = root.querySelector('[data-editor-profile-message]');
  const unsavedMessage = root.querySelector('[data-editor-unsaved-message]');
  const completenessNode = root.querySelector('[data-editor-completeness]');
  const selectedFiles = new WeakMap();
  const selectedObjectUrls = new WeakMap();
  const allowedImageMimeTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);
  const uploadConfig = {
    avatar: {
      maxSize: 2 * 1024 * 1024,
      minWidth: 500,
      minHeight: 500,
      ratio: 1,
      tolerance: 0.08,
      invalidSize: messages.invalidSizeAvatar,
      ratioWarning: messages.ratioWarningAvatar,
      previewSelector: '[data-editor-avatar-preview]',
      placeholderSelector: '[data-editor-avatar-placeholder]',
    },
    cover: {
      maxSize: 5 * 1024 * 1024,
      minWidth: 1000,
      minHeight: 375,
      ratio: 1600 / 600,
      tolerance: 0.15,
      invalidSize: messages.invalidSizeCover,
      ratioWarning: messages.ratioWarningCover,
      previewSelector: '[data-editor-cover-preview]',
      placeholderSelector: '[data-editor-cover-placeholder]',
    },
  };
  let profileSnapshot = '';

  const getProfileSnapshot = () => {
    if (!form) return '';

    return new URLSearchParams(new FormData(form)).toString();
  };

  const setUnsavedState = () => {
    if (!unsavedMessage || !profileSnapshot) return;

    unsavedMessage.hidden = getProfileSnapshot() === profileSnapshot;
  };

  const markProfileClean = () => {
    profileSnapshot = getProfileSnapshot();

    if (unsavedMessage) {
      unsavedMessage.hidden = true;
    }
  };

  const setMessage = (node, text, tone = 'info') => {
    if (!node) return;

    node.textContent = text;
    node.hidden = !text;
    node.dataset.tone = tone;
  };

  const getErrorMessage = (error) => {
    if (error === 'revision_conflict') return messages.conflict;
    if (error === 'invalid_url') return messages.invalidUrl;
    if (error === 'rich_bio_readonly') return messages.richBioReadOnly;
    if (error === 'invalid_alt') return messages.invalidAlt;
    if (error === 'invalid_file_type' || error === 'invalid_file_size' || error === 'missing_file') {
      return messages.invalidFile;
    }

    return messages.error;
  };

  const formatFileSize = (bytes) => {
    const size = Number(bytes || 0);

    if (size >= 1024 * 1024) {
      return `${(size / (1024 * 1024)).toFixed(size >= 10 * 1024 * 1024 ? 0 : 1)} MB`;
    }

    return `${Math.max(1, Math.round(size / 1024))} KB`;
  };

  const getBlockingFileError = (file, assetType) => {
    const config = uploadConfig[assetType] || uploadConfig.avatar;
    const fileType = String(file?.type || '').toLowerCase();
    const fileName = String(file?.name || '').toLowerCase();

    if (
      !file ||
      !allowedImageMimeTypes.has(fileType) ||
      fileType === 'image/svg+xml' ||
      fileName.endsWith('.svg')
    ) {
      return messages.invalidMime;
    }

    if (file.size > config.maxSize) {
      return config.invalidSize;
    }

    return '';
  };

  const getImageDimensions = (file) =>
    new Promise((resolve) => {
      if (!file || !allowedImageMimeTypes.has(file.type)) {
        resolve(null);
        return;
      }

      const url = URL.createObjectURL(file);
      const image = new Image();

      image.onload = () => {
        URL.revokeObjectURL(url);
        resolve({
          width: image.naturalWidth,
          height: image.naturalHeight,
        });
      };

      image.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(null);
      };

      image.src = url;
    });

  const setAdvice = (node, text, tone = 'info') => {
    if (!node) return;

    node.textContent = text;
    node.dataset.tone = tone;
  };

  const getImageAdvice = (dimensions, assetType) => {
    const config = uploadConfig[assetType] || uploadConfig.avatar;

    if (!dimensions) {
      return {
        text: '',
        tone: 'info',
      };
    }

    const warnings = [];
    const ratio = dimensions.width / Math.max(dimensions.height, 1);
    const ratioDelta = Math.abs(ratio - config.ratio) / config.ratio;

    if (ratioDelta > config.tolerance) {
      warnings.push(config.ratioWarning);
    }

    if (dimensions.width < config.minWidth || dimensions.height < config.minHeight) {
      warnings.push(messages.lowResolutionWarning);
    }

    if (warnings.length) {
      return {
        text: warnings.join(' '),
        tone: 'warning',
      };
    }

    return {
      text: messages.recommendedFormat,
      tone: 'success',
    };
  };

  const clearSelectedFile = (uploadForm) => {
    const objectUrl = selectedObjectUrls.get(uploadForm);

    if (objectUrl) {
      URL.revokeObjectURL(objectUrl);
      selectedObjectUrls.delete(uploadForm);
    }

    selectedFiles.delete(uploadForm);

    const localPreview = uploadForm.querySelector('[data-editor-local-preview]');
    const localPreviewImage = uploadForm.querySelector('[data-editor-local-preview-image]');
    const fileMeta = uploadForm.querySelector('[data-editor-file-meta]');
    const fileAdvice = uploadForm.querySelector('[data-editor-file-advice]');
    const fileInput = uploadForm.querySelector('input[type="file"]');
    const dropLabel = uploadForm.querySelector('[data-editor-drop-label]');

    if (localPreview) {
      localPreview.hidden = true;
    }

    if (localPreviewImage) {
      localPreviewImage.removeAttribute('src');
    }

    if (fileMeta) {
      fileMeta.textContent = '';
    }

    if (fileAdvice) {
      fileAdvice.textContent = '';
      fileAdvice.dataset.tone = 'info';
    }

    if (fileInput) {
      fileInput.value = '';
    }

    if (dropLabel) {
      dropLabel.textContent = messages.chooseFile;
    }
  };

  const updateSelectedFilePreview = async (uploadForm, file, assetType) => {
    if (!file) return;

    const oldObjectUrl = selectedObjectUrls.get(uploadForm);

    if (oldObjectUrl) {
      URL.revokeObjectURL(oldObjectUrl);
    }

    selectedFiles.set(uploadForm, file);

    const dropLabel = uploadForm.querySelector('[data-editor-drop-label]');
    const localPreview = uploadForm.querySelector('[data-editor-local-preview]');
    const localPreviewImage = uploadForm.querySelector('[data-editor-local-preview-image]');
    const fileMeta = uploadForm.querySelector('[data-editor-file-meta]');
    const fileAdvice = uploadForm.querySelector('[data-editor-file-advice]');
    const blockingError = getBlockingFileError(file, assetType);
    const dimensions = await getImageDimensions(file);

    if (dropLabel) {
      dropLabel.textContent = file.name || messages.fileReady;
    }

    if (localPreview) {
      localPreview.hidden = false;
    }

    if (localPreviewImage && allowedImageMimeTypes.has(file.type)) {
      const objectUrl = URL.createObjectURL(file);
      selectedObjectUrls.set(uploadForm, objectUrl);
      localPreviewImage.src = objectUrl;
    } else if (localPreviewImage) {
      localPreviewImage.removeAttribute('src');
    }

    if (fileMeta) {
      const dimensionLabel = dimensions
        ? `${dimensions.width} × ${dimensions.height} px`
        : messages.fileReady;
      const typeLabel = file.type || 'file';
      fileMeta.textContent = `${dimensionLabel} · ${formatFileSize(file.size)} · ${typeLabel}`;
    }

    if (blockingError) {
      setAdvice(fileAdvice, blockingError, 'error');
      return;
    }

    const advice = getImageAdvice(dimensions, assetType);
    setAdvice(fileAdvice, advice.text, advice.tone);
  };

  const updateAuthorState = (author) => {
    if (!author) return;

    if (revInput) {
      revInput.value = author._rev || revInput.value;
    }

    root.querySelectorAll('[data-editor-profile-rev]').forEach((node) => {
      node.value = author._rev || node.value;
    });

    if (completenessNode && author.completeness?.label) {
      completenessNode.textContent = author.completeness.label;
    }

    const updatePreviews = (selector, placeholderSelector, image) => {
      const url = image?.asset?.url || '';
      const alt = image?.alt || '';

      root.querySelectorAll(selector).forEach((node) => {
        node.src = url;
        node.alt = alt;
        node.hidden = !url;
      });

      root.querySelectorAll(placeholderSelector).forEach((node) => {
        node.hidden = Boolean(url);
      });
    };

    updatePreviews('[data-editor-avatar-preview]', '[data-editor-avatar-placeholder]', author.image);
    updatePreviews('[data-editor-cover-preview]', '[data-editor-cover-placeholder]', author.cover);
  };

  markProfileClean();

  form?.addEventListener('input', setUnsavedState);
  form?.addEventListener('change', setUnsavedState);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setMessage(profileMessage, messages.saving);
    const saveButtonText = saveButton?.textContent || '';

    if (saveButton) {
      saveButton.disabled = true;
      saveButton.textContent = messages.saving;
    }

    const payload = Object.fromEntries(new FormData(form).entries());

    try {
      const response = await fetch('/api/editor/profile', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });
      const result = await response.json();

      if (!response.ok || !result.ok) {
        setMessage(profileMessage, getErrorMessage(result?.error), 'error');
        return;
      }

      updateAuthorState(result.author);
      setMessage(profileMessage, messages.saved, 'success');
      markProfileClean();
    } catch {
      setMessage(profileMessage, messages.error, 'error');
    } finally {
      if (saveButton) {
        saveButton.disabled = false;
        saveButton.textContent = saveButtonText || (isEnglish ? 'Save profile' : 'Salva profilo');
      }
    }
  });

  root.querySelectorAll('[data-editor-upload-form]').forEach((uploadForm) => {
    const dropzone = uploadForm.querySelector('[data-editor-dropzone]');
    const dropLabel = uploadForm.querySelector('[data-editor-drop-label]');
    const fileInput = uploadForm.querySelector('input[type="file"]');
    const submitButton = uploadForm.querySelector('button[type="submit"]');
    const messageNode = uploadForm.querySelector('[data-editor-upload-message]');
    const assetType = uploadForm.dataset.assetType === 'cover' ? 'cover' : 'avatar';

    fileInput?.addEventListener('change', () => {
      updateSelectedFilePreview(uploadForm, fileInput.files?.[0], assetType);
    });

    dropzone?.addEventListener('dragover', (event) => {
      event.preventDefault();
      dropzone.dataset.dragActive = 'true';
      if (dropLabel) {
        dropLabel.textContent = messages.dropFile;
      }
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.dataset.dragActive = 'false';
      if (dropLabel && !selectedFiles.get(uploadForm)) {
        dropLabel.textContent = messages.chooseFile;
      }
    });

    dropzone?.addEventListener('drop', (event) => {
      event.preventDefault();
      dropzone.dataset.dragActive = 'false';
      updateSelectedFilePreview(uploadForm, event.dataTransfer?.files?.[0], assetType);
    });

    uploadForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      setMessage(messageNode, messages.uploading);

      const file = selectedFiles.get(uploadForm) || fileInput?.files?.[0];
      const altInput = form?.querySelector(`[name="${assetType === 'cover' ? 'coverAlt' : 'imageAlt'}"]`);
      const alt = String(altInput?.value || '').trim();
      const uploadButtonText = submitButton?.textContent || '';

      if (!file || !alt) {
        setMessage(messageNode, !file ? messages.invalidFile : messages.invalidAlt, 'error');
        return;
      }

      const fileError = getBlockingFileError(file, assetType);

      if (fileError) {
        setMessage(messageNode, fileError, 'error');
        return;
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = messages.uploading;
      }

      const payload = new FormData();
      payload.set('assetType', assetType);
      payload.set('_rev', revInput?.value || '');
      payload.set('alt', alt);
      payload.set('file', file);

      try {
        const response = await fetch('/api/editor/assets', {
          method: 'POST',
          body: payload,
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          setMessage(messageNode, getErrorMessage(result?.error), 'error');
          return;
        }

        updateAuthorState(result.author);
        clearSelectedFile(uploadForm);
        markProfileClean();
        setMessage(messageNode, messages.uploadSaved, 'success');
      } catch {
        setMessage(messageNode, messages.error, 'error');
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = uploadButtonText || messages.upload;
        }
      }
    });
  });
})();
  </script>
</BaseLayout>
