---
import '../../styles/pages/editorial-area.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../community/CommunityHero.astro';
import CommunityLayout from '../community/CommunityLayout.astro';
import EditorialSectionNav from './EditorialSectionNav.astro';
import EditorialSidebar from './EditorialSidebar.astro';
import {
  fetchOwnEditorialArticles,
  fetchReviewQueueEditorialArticles,
} from '../../lib/editorial/articles.server';
import { getEditorialRoleLabel, getPublicAuthorRoleLabel } from '../../lib/editorial/labels';
import {
  fetchEditorialAuthorProfile,
  fetchPublishedArticleCountForAuthor,
  requireActiveEditorialAuthorContext,
} from '../../lib/editorial/profile.server';

type EditorialLang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: EditorialLang };
const currentLang: EditorialLang = lang === 'en' ? 'en' : 'it';
const isEnglish = currentLang === 'en';
const access = await requireActiveEditorialAuthorContext(Astro.cookies);

const copy = isEnglish
  ? {
      pageTitle: 'Editorial area | Retro-Gamers.it',
      pageDescription: 'Your private editorial dashboard on Retro-Gamers.it.',
      kicker: 'Editorial area',
      title: 'Editorial dashboard',
      description:
        'Your private workspace for author identity, drafts and editorial actions on Retro-Gamers.it.',
      deniedTitle: 'Editorial access required',
      deniedDescription:
        'This area is available only to active editorial contributors linked to a Sanity author profile.',
      missingAuthorTitle: 'Sanity author not found',
      missingAuthorDescription:
        'Your editorial access is linked to an author profile that is not available in the published dataset. Profile editing is blocked until the link is fixed.',
      profileLabel: 'Author identity',
      overviewLabel: 'Overview',
      editorialRole: 'Editorial role',
      authorRole: 'Public author role',
      publishedArticles: 'Published articles',
      completeness: 'Profile completeness',
      drafts: 'Drafts and changes',
      reviewQueue: 'Review queue',
      authorStatus: 'Author profile status',
      authorSummary: 'Your editorial identity and operational status.',
      notSet: 'Not set',
      loginCta: 'Go to account',
    }
  : {
      pageTitle: 'Area redazione | Retro-Gamers.it',
      pageDescription: 'La tua dashboard redazionale privata su Retro-Gamers.it.',
      kicker: 'Area redazione',
      title: 'Dashboard redazionale',
      description:
        'Il tuo workspace privato per identità autore, bozze e azioni redazionali su Retro-Gamers.it.',
      deniedTitle: 'Accesso redazionale richiesto',
      deniedDescription:
        'Quest’area è disponibile solo per collaboratori redazionali attivi collegati a un profilo autore Sanity.',
      missingAuthorTitle: 'Autore Sanity non trovato',
      missingAuthorDescription:
        'Il tuo accesso redazionale è collegato a un profilo autore non disponibile nel dataset pubblicato. La modifica del profilo resta bloccata finché il collegamento non viene corretto.',
      profileLabel: 'Identità autore',
      overviewLabel: 'Panoramica',
      editorialRole: 'Ruolo redazionale',
      authorRole: 'Ruolo autore pubblico',
      publishedArticles: 'Articoli pubblicati',
      completeness: 'Completezza profilo',
      drafts: 'Bozze e modifiche',
      reviewQueue: 'Coda revisione',
      authorStatus: 'Stato profilo autore',
      authorSummary: 'La tua identità redazionale e lo stato operativo.',
      notSet: 'Non impostato',
      loginCta: 'Vai all’account',
    };

let author = null;
let publishedArticleCount = 0;
let ownArticleItems = [];
let reviewArticleItems = [];

if (access.ok) {
  author = await fetchEditorialAuthorProfile(access.context.sanityAuthorId);

  if (author) {
    publishedArticleCount = await fetchPublishedArticleCountForAuthor(access.context.sanityAuthorId);
  }

  const ownArticlesResult = await fetchOwnEditorialArticles(access.context);

  if (ownArticlesResult.ok) {
    ownArticleItems = ownArticlesResult.items;
  }

  if (access.context.permissions.canReadSubmittedArticles) {
    const reviewArticlesResult = await fetchReviewQueueEditorialArticles(access.context);

    if (reviewArticlesResult.ok) {
      reviewArticleItems = reviewArticlesResult.items;
    }
  }
}

const accountHref = isEnglish ? '/en/account/' : '/account/';
const languageSwitch = isEnglish ? '/account/editor/' : '/en/account/editor/';
const sidebarName = author?.displayName === 'nickname' && author.nickname
  ? author.nickname
  : author?.name || (access.ok ? String(access.context.profile?.display_name || '') : '');
const editorialRoleLabel = access.ok
  ? getEditorialRoleLabel(access.context.editorialRole, currentLang)
  : '';
const authorRoleLabel = author
  ? getPublicAuthorRoleLabel(author.role, currentLang)
  : '';
const draftArticleCount = ownArticleItems.filter((item) => (
  item.workflowStatus === 'draft' ||
  item.workflowStatus === 'changes_requested' ||
  item.sanityLifecycle === 'revision_draft'
)).length;
---

<BaseLayout
  lang={currentLang}
  title={copy.pageTitle}
  description={copy.pageDescription}
  canonical={Astro.url.href}
  languageSwitch={languageSwitch}
  noindex={true}
>
  <CommunityLayout class="editorial-area-page" sidebar={access.ok && Boolean(author)}>
    {access.ok && author && (
      <Fragment slot="sidebar">
        <EditorialSidebar
          lang={currentLang}
          author={author}
          editorialRole={access.context.editorialRole}
          fallbackName={String(access.context.profile?.display_name || '')}
          publishedArticleCount={publishedArticleCount}
        />
      </Fragment>
    )}

    <CommunityHero
      kicker={copy.kicker}
      title={copy.title}
      description={copy.description}
    />

    {access.ok && (
      <EditorialSectionNav
        activeSection="dashboard"
        lang={currentLang}
        authorPreviewHref={author?.publicUrls?.[currentLang]}
      />
    )}

    {!access.ok && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2>{copy.deniedTitle}</h2>
        <p>{copy.deniedDescription}</p>
        <a class="editorial-button" href={accountHref}>{copy.loginCta}</a>
      </section>
    )}

    {access.ok && !author && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.profileLabel}</p>
        <h2>{copy.missingAuthorTitle}</h2>
        <p>{copy.missingAuthorDescription}</p>
      </section>
    )}

    {access.ok && author && (
      <div class="editorial-dashboard-grid">
        <section class="editorial-card editorial-author-card editorial-dashboard-intro">
          <div class="editorial-author-card__body">
            <p class="editorial-kicker">{copy.overviewLabel}</p>
            <h2>{sidebarName || author.name}</h2>
            <p>{copy.authorSummary}</p>
            <dl class="editorial-definition-list editorial-definition-list--grid">
              <div>
                <dt>{copy.editorialRole}</dt>
                <dd>{editorialRoleLabel}</dd>
              </div>
              <div>
                <dt>{copy.authorRole}</dt>
                <dd>{authorRoleLabel || copy.notSet}</dd>
              </div>
              <div>
                <dt>{copy.authorStatus}</dt>
                <dd>{author.completeness.label}</dd>
              </div>
            </dl>
          </div>
        </section>

        <section class="editorial-card editorial-card--compact">
          <span>{copy.publishedArticles}</span>
          <strong>{publishedArticleCount}</strong>
        </section>

        <section class="editorial-card editorial-card--compact">
          <span>{copy.drafts}</span>
          <strong>{draftArticleCount}</strong>
        </section>

        <section class="editorial-card editorial-card--compact">
          <span>{copy.reviewQueue}</span>
          <strong>{reviewArticleItems.length}</strong>
        </section>

        <section class="editorial-card editorial-card--compact">
          <span>{copy.completeness}</span>
          <strong>{author.completeness.label}</strong>
        </section>

      </div>
    )}
  </CommunityLayout>
</BaseLayout>
