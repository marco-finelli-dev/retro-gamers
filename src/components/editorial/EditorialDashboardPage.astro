---
import '../../styles/pages/editorial-area.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../community/CommunityHero.astro';
import CommunityLayout from '../community/CommunityLayout.astro';
import CommunitySidebarProfile from '../community/CommunitySidebarProfile.astro';
import CommunitySidebarSection from '../community/CommunitySidebarSection.astro';
import CommunityStatList from '../community/CommunityStatList.astro';
import { getEditorialRoleLabel, getPublicAuthorRoleLabel } from '../../lib/editorial/labels';
import {
  fetchEditorialAuthorProfile,
  fetchPublishedArticleCountForAuthor,
  requireActiveEditorialAuthorContext,
} from '../../lib/editorial/profile.server';

type EditorialLang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: EditorialLang };
const currentLang: EditorialLang = lang === 'en' ? 'en' : 'it';
const isEnglish = currentLang === 'en';
const access = await requireActiveEditorialAuthorContext(Astro.cookies);

const copy = isEnglish
  ? {
      pageTitle: 'Editorial area | Retro-Gamers.it',
      pageDescription: 'Your private editorial dashboard on Retro-Gamers.it.',
      kicker: 'Editorial area',
      title: 'Editorial dashboard',
      description:
        'A first private workspace for your Retro-Gamers author identity. The article editor will arrive in a separate step.',
      deniedTitle: 'Editorial access required',
      deniedDescription:
        'This area is available only to active editorial contributors linked to a Sanity author profile.',
      missingAuthorTitle: 'Sanity author not found',
      missingAuthorDescription:
        'Your editorial access is linked to an author profile that is not available in the published dataset. Profile editing is blocked until the link is fixed.',
      profileLabel: 'Author identity',
      overviewLabel: 'Overview',
      editorialRole: 'Editorial role',
      authorRole: 'Public author role',
      publishedArticles: 'Published articles',
      completeness: 'Profile completeness',
      completenessHint: 'Informative profile checklist',
      dashboardLinks: 'Workspace',
      editProfile: 'Edit author profile',
      publicProfileIt: 'Italian author page',
      publicProfileEn: 'English author page',
      articleEditorTitle: 'Article editor',
      articleEditorDescription:
        'Draft creation, article editing and review workflow are intentionally not part of this step.',
      unavailable: 'Not available yet',
      notSet: 'Not set',
      loginCta: 'Go to account',
    }
  : {
      pageTitle: 'Area redazione | Retro-Gamers.it',
      pageDescription: 'La tua dashboard redazionale privata su Retro-Gamers.it.',
      kicker: 'Area redazione',
      title: 'Dashboard redazionale',
      description:
        'Un primo spazio privato per la tua identità autore su Retro-Gamers. L’editor articoli arriverà in un cantiere separato.',
      deniedTitle: 'Accesso redazionale richiesto',
      deniedDescription:
        'Quest’area è disponibile solo per collaboratori redazionali attivi collegati a un profilo autore Sanity.',
      missingAuthorTitle: 'Autore Sanity non trovato',
      missingAuthorDescription:
        'Il tuo accesso redazionale è collegato a un profilo autore non disponibile nel dataset pubblicato. La modifica del profilo resta bloccata finché il collegamento non viene corretto.',
      profileLabel: 'Identità autore',
      overviewLabel: 'Panoramica',
      editorialRole: 'Ruolo redazionale',
      authorRole: 'Ruolo autore pubblico',
      publishedArticles: 'Articoli pubblicati',
      completeness: 'Completezza profilo',
      completenessHint: 'Checklist informativa del profilo',
      dashboardLinks: 'Strumenti',
      editProfile: 'Modifica profilo autore',
      publicProfileIt: 'Pagina autore italiana',
      publicProfileEn: 'Pagina autore inglese',
      articleEditorTitle: 'Editor articoli',
      articleEditorDescription:
        'Creazione bozze, modifica articoli e workflow di revisione sono volutamente fuori da questo step.',
      unavailable: 'Non disponibile ancora',
      notSet: 'Non impostato',
      loginCta: 'Vai all’account',
    };

let author = null;
let publishedArticleCount = 0;

if (access.ok) {
  author = await fetchEditorialAuthorProfile(access.context.sanityAuthorId);

  if (author) {
    publishedArticleCount = await fetchPublishedArticleCountForAuthor(access.context.sanityAuthorId);
  }
}

const profileHref = isEnglish ? '/en/account/editor/profile/' : '/account/editor/profile/';
const accountHref = isEnglish ? '/en/account/' : '/account/';
const languageSwitch = isEnglish ? '/account/editor/' : '/en/account/editor/';
const sidebarName = author?.displayName === 'nickname' && author.nickname
  ? author.nickname
  : author?.name || (access.ok ? String(access.context.profile?.display_name || '') : '');
const authorPublicUrlIt = author?.slug ? `/autori/${author.slug}/` : '';
const authorPublicUrlEn = author?.slug ? `/en/authors/${author.slug}/` : '';
const editorialRoleLabel = access.ok
  ? getEditorialRoleLabel(access.context.editorialRole, currentLang)
  : '';
const authorRoleLabel = author
  ? getPublicAuthorRoleLabel(author.role, currentLang)
  : '';
---

<BaseLayout
  lang={currentLang}
  title={copy.pageTitle}
  description={copy.pageDescription}
  canonical={Astro.url.href}
  languageSwitch={languageSwitch}
  noindex={true}
>
  <CommunityLayout class="editorial-area-page" sidebar={access.ok && Boolean(author)}>
    {access.ok && author && (
      <Fragment slot="sidebar">
        <CommunitySidebarProfile
          label={copy.profileLabel}
          name={sidebarName || author.name}
          avatarUrl={author.image?.asset?.url || ''}
        />

        <CommunityStatList
          title={copy.overviewLabel}
          items={[
            { label: copy.publishedArticles, value: publishedArticleCount },
            { label: copy.completeness, value: author.completeness.label },
          ]}
        />

        <CommunitySidebarSection title={copy.dashboardLinks}>
          <div class="community-link-list">
            <a href={profileHref}>{copy.editProfile}</a>
            {authorPublicUrlIt && (
              <a href={authorPublicUrlIt} data-language-session-override="it">
                {copy.publicProfileIt}
              </a>
            )}
            {authorPublicUrlEn && (
              <a href={authorPublicUrlEn} data-language-session-override="en">
                {copy.publicProfileEn}
              </a>
            )}
          </div>
        </CommunitySidebarSection>
      </Fragment>
    )}

    <CommunityHero
      kicker={copy.kicker}
      title={copy.title}
      description={copy.description}
    />

    {!access.ok && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2>{copy.deniedTitle}</h2>
        <p>{copy.deniedDescription}</p>
        <a class="editorial-button" href={accountHref}>{copy.loginCta}</a>
      </section>
    )}

    {access.ok && !author && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.profileLabel}</p>
        <h2>{copy.missingAuthorTitle}</h2>
        <p>{copy.missingAuthorDescription}</p>
      </section>
    )}

    {access.ok && author && (
      <div class="editorial-dashboard-grid">
        <section class="editorial-card editorial-author-card">
          <div class="editorial-author-card__body">
            <p class="editorial-kicker">{copy.overviewLabel}</p>
            <h2>
              {isEnglish
                ? 'Your editorial workspace'
                : 'Il tuo spazio redazionale'}
            </h2>
            <dl class="editorial-definition-list">
              <div>
                <dt>{copy.editorialRole}</dt>
                <dd>{editorialRoleLabel}</dd>
              </div>
              <div>
                <dt>{copy.authorRole}</dt>
                <dd>{authorRoleLabel || copy.notSet}</dd>
              </div>
            </dl>
          </div>
        </section>

        <section class="editorial-card editorial-action-card">
          <div>
            <p class="editorial-kicker">{copy.dashboardLinks}</p>
            <h2>{copy.editProfile}</h2>
            <p>
              {isEnglish
                ? 'Update the public author information that appears on Retro-Gamers.it.'
                : 'Aggiorna le informazioni pubbliche autore mostrate su Retro-Gamers.it.'}
            </p>
          </div>
          <a class="editorial-button" href={profileHref}>{copy.editProfile}</a>
        </section>

        <section class="editorial-card editorial-action-card">
          <div>
            <p class="editorial-kicker">{copy.completeness}</p>
            <h2>{author.completeness.label}</h2>
            <p>{copy.completenessHint}</p>
          </div>
          <span class="editorial-pill">{publishedArticleCount} {copy.publishedArticles.toLowerCase()}</span>
        </section>

        <section class="editorial-card editorial-action-card editorial-action-card--disabled" aria-disabled="true">
          <div>
            <p class="editorial-kicker">{copy.unavailable}</p>
            <h2>{copy.articleEditorTitle}</h2>
            <p>{copy.articleEditorDescription}</p>
          </div>
          <span class="editorial-pill">{copy.unavailable}</span>
        </section>
      </div>
    )}
  </CommunityLayout>
</BaseLayout>
