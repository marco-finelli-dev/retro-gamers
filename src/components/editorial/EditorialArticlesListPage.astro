---
import '../../styles/pages/editorial-area.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../community/CommunityHero.astro';
import CommunityLayout from '../community/CommunityLayout.astro';
import EditorialSectionNav from './EditorialSectionNav.astro';
import EditorialSidebar from './EditorialSidebar.astro';
import {
  fetchOwnEditorialArticles,
  fetchReviewQueueEditorialArticles,
  getEditorialArticleEditPath,
  getEditorialArticlePreviewPath,
  requireEditorialArticleContext,
} from '../../lib/editorial/articles.server';
import {
  fetchEditorialAuthorProfile,
  fetchPublishedArticleCountForAuthor,
} from '../../lib/editorial/profile.server';
import { canCreateRevisionDraft } from '../../lib/editorial/permissions';

type EditorialLang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: EditorialLang };
const currentLang: EditorialLang = lang === 'en' ? 'en' : 'it';
const isEnglish = currentLang === 'en';
const access = await requireEditorialArticleContext(Astro.cookies);

const copy = isEnglish
  ? {
      pageTitle: 'Article workspace | Retro-Gamers.it',
      pageDescription: 'Manage your Retro-Gamers article drafts.',
      kicker: 'Editorial area',
      title: 'Article workspace',
      description:
        'Create, review and manage your editorial articles in the Retro-Gamers workspace.',
      deniedTitle: 'Editorial access required',
      deniedDescription:
        'This workspace is available only to active editorial contributors.',
      newArticle: 'New article',
      editArticle: 'Edit article',
      openReview: 'Open review',
      managePublishing: 'Manage publishing',
      view: 'View',
      viewArticle: 'View article',
      articleActions: 'Article actions',
      createEnglishTranslation: 'Create English translation',
      imageFallback: 'Editorial article',
      filtersLabel: 'Filter your articles',
      searchPlaceholder: 'Search article...',
      lifecycleFilter: 'Sanity status',
      languageFilter: 'Language',
      typeFilter: 'Type',
      sortFilter: 'Sort by',
      allLifecycles: 'All Sanity states',
      allLanguages: 'All languages',
      allTypes: 'All types',
      sortUpdatedDesc: 'Last updated',
      sortTitleAsc: 'Title A-Z',
      sortTitleDesc: 'Title Z-A',
      sortCreatedDesc: 'Newest created',
      sortWorkflow: 'Workflow status',
      quickFiltersLabel: 'Quick filters',
      quickAll: 'All',
      quickDrafts: 'Drafts',
      quickReview: 'In review',
      quickPublished: 'Published',
      quickRevisions: 'Revisions',
      quickOrphans: 'Orphans',
      articleListKicker: 'Article list',
      articleListTitle: 'Editorial articles',
      articleCountSingular: 'article',
      articleCountPlural: 'articles',
      missingDraft: 'Sanity document not found',
      lifecycle: {
        draft: 'DRAFT',
        revision_draft: 'UNPUBLISHED CHANGES',
        published: 'PUBLISHED',
        missing: 'SANITY DOCUMENT NOT FOUND',
      },
      workflow: {
        draft: 'Draft',
        submitted: 'Submitted for review',
        changes_requested: 'Changes requested',
        approved: 'Approved',
        published: 'Published',
      },
      noArticlesTitle: 'No editorial drafts yet',
      noArticlesText: 'Create your first draft to start writing inside the custom editor.',
      noFilterResultsTitle: 'No articles match these filters',
      noFilterResultsText: 'Try changing search text, status, language or content type.',
      type: 'Type',
      language: 'Language',
      author: 'Author',
      workflowStatus: 'Workflow',
      submitted: 'Submitted',
      reviewed: 'Reviewed',
      updated: 'Updated',
      untitled: 'Untitled draft',
      requestChanges: 'Request changes',
      approve: 'Approve',
      readyForPublish: 'Ready for publishing',
      requestChangesConfirm: 'Return this article to the author for changes?',
      approveConfirm: 'Approve this article?',
      workflowUpdating: 'Updating workflow…',
      workflowUpdated: 'Workflow updated.',
      workflowGenericError: 'The workflow action could not be completed.',
      translationCreating: 'Creating English translation…',
      translationCreated: 'English translation created.',
      translationAlreadyExists: 'An English translation already exists.',
      translationGenericError: 'The English translation could not be created.',
      revisionCreating: 'Opening revision draft…',
      revisionCreated: 'Revision draft ready.',
      revisionGenericError: 'The revision draft could not be created.',
    }
  : {
      pageTitle: 'Editor articoli | Retro-Gamers.it',
      pageDescription: 'Gestisci le tue bozze articolo su Retro-Gamers.it.',
      kicker: 'Area redazione',
      title: 'Editor articoli',
      description:
        'Crea, revisiona e gestisci i tuoi articoli nel workspace redazionale di Retro-Gamers.',
      deniedTitle: 'Accesso redazionale richiesto',
      deniedDescription:
        'Questo workspace è disponibile solo per collaboratori redazionali attivi.',
      newArticle: 'Nuovo articolo',
      editArticle: 'Modifica articolo',
      openReview: 'Apri revisione',
      managePublishing: 'Gestisci pubblicazione',
      view: 'Visualizza',
      viewArticle: 'Visualizza articolo',
      articleActions: 'Azioni articolo',
      createEnglishTranslation: 'Crea traduzione inglese',
      imageFallback: 'Articolo redazionale',
      filtersLabel: 'Filtra i tuoi articoli',
      searchPlaceholder: 'Cerca articolo...',
      lifecycleFilter: 'Stato Sanity',
      languageFilter: 'Lingua',
      typeFilter: 'Tipo',
      sortFilter: 'Ordina per',
      allLifecycles: 'Tutti gli stati Sanity',
      allLanguages: 'Tutte le lingue',
      allTypes: 'Tutti i tipi',
      sortUpdatedDesc: 'Ultimo aggiornamento',
      sortTitleAsc: 'Titolo A-Z',
      sortTitleDesc: 'Titolo Z-A',
      sortCreatedDesc: 'Data creazione più recente',
      sortWorkflow: 'Stato workflow',
      quickFiltersLabel: 'Filtri rapidi',
      quickAll: 'Tutti',
      quickDrafts: 'Bozze',
      quickReview: 'In revisione',
      quickPublished: 'Pubblicati',
      quickRevisions: 'Revisioni',
      quickOrphans: 'Orfani',
      articleListKicker: 'Lista articoli',
      articleListTitle: 'Articoli redazionali',
      articleCountSingular: 'articolo',
      articleCountPlural: 'articoli',
      missingDraft: 'Documento Sanity non trovato',
      lifecycle: {
        draft: 'BOZZA',
        revision_draft: 'MODIFICHE NON PUBBLICATE',
        published: 'PUBBLICATO',
        missing: 'DOCUMENTO SANITY NON TROVATO',
      },
      workflow: {
        draft: 'Bozza',
        submitted: 'In revisione',
        changes_requested: 'Modifiche richieste',
        approved: 'Approvato',
        published: 'Pubblicato',
      },
      noArticlesTitle: 'Nessuna bozza redazionale',
      noArticlesText: 'Crea la prima bozza per iniziare a scrivere nel custom editor.',
      noFilterResultsTitle: 'Nessun articolo corrisponde ai filtri',
      noFilterResultsText: 'Prova a cambiare ricerca, stato, lingua o tipo contenuto.',
      type: 'Tipo',
      language: 'Lingua',
      author: 'Autore',
      workflowStatus: 'Workflow',
      submitted: 'Inviato',
      reviewed: 'Revisionato',
      updated: 'Aggiornato',
      untitled: 'Bozza senza titolo',
      requestChanges: 'Richiedi modifiche',
      approve: 'Approva',
      readyForPublish: 'Pronto per pubblicazione',
      requestChangesConfirm: 'Restituire l’articolo all’autore per modifiche?',
      approveConfirm: 'Approvare questo articolo?',
      workflowUpdating: 'Aggiornamento workflow…',
      workflowUpdated: 'Workflow aggiornato.',
      workflowGenericError: 'Non è stato possibile completare l’azione workflow.',
      translationCreating: 'Creazione traduzione inglese…',
      translationCreated: 'Traduzione inglese creata.',
      translationAlreadyExists: 'Esiste già una traduzione inglese.',
      translationGenericError: 'Non è stato possibile creare la traduzione inglese.',
      revisionCreating: 'Apertura bozza di revisione…',
      revisionCreated: 'Bozza di revisione pronta.',
      revisionGenericError: 'Non è stato possibile creare la bozza di revisione.',
    };

const newArticleHref = isEnglish ? '/en/account/editor/articles/new/' : '/account/editor/articles/new/';
const languageSwitch = isEnglish ? '/account/editor/articles/' : '/en/account/editor/articles/';
let items = [];
let listError = '';
let reviewItems = [];
let reviewError = '';
let editorialArticleItems = [];
let author = null;
let publishedArticleCount = 0;

function formatDateTime(value) {
  return value ? new Date(value).toLocaleString(isEnglish ? 'en' : 'it') : '—';
}

function getWorkflowLabel(status) {
  return copy.workflow[status] || status || '—';
}

function getArticleSummary(article) {
  return article?.subtitle || article?.cardExcerpt || article?.excerpt || '';
}

function getArticleImage(article) {
  const featuredImage = article?.featuredImage;
  const gameCover = article?.gameInfo?.cover;
  const image = featuredImage?.asset?.url ? featuredImage : gameCover?.asset?.url ? gameCover : null;

  if (!image?.asset?.url) return null;

  return {
    src: image.asset.url,
    alt: image.alt || article?.title || copy.imageFallback,
  };
}

function getLanguageBadge(language) {
  return String(language || '—').toUpperCase();
}

function getArticleStateBadge(item) {
  const lifecycle = item?.sanityLifecycle || '';

  if (lifecycle === 'missing' || lifecycle === 'revision_draft') {
    return {
      status: lifecycle,
      label: copy.lifecycle[lifecycle] || lifecycle,
    };
  }

  return {
    status: item?.workflowStatus || 'draft',
    label: getWorkflowLabel(item?.workflowStatus),
  };
}

function getOwnArticleActionLabel(item) {
  if (item.workflowStatus === 'draft' || item.workflowStatus === 'changes_requested') {
    return copy.editArticle;
  }

  if (item.workflowStatus === 'published') {
    return copy.viewArticle;
  }

  return copy.view;
}

function getReviewArticleActionLabel(item) {
  if (item.workflowStatus === 'approved' && access.ok && access.context.permissions.canPublishArticle) {
    return copy.managePublishing;
  }

  return copy.openReview;
}

function getArticleMenuId(scope, item) {
  const safeId = String(item?.sanityDocumentId || 'article').replace(/[^A-Za-z0-9_-]/g, '-');

  return `editorial-${scope}-${safeId}-actions`;
}

function canCreateEnglishTranslationForItem(item, article) {
  return Boolean(
    access.ok &&
      access.context.permissions.canCreateArticle &&
      article?.language === 'it' &&
      item?.hasEnglishTranslation !== true
  );
}

function canCreatePublishedRevisionForItem(item) {
  return Boolean(
    access.ok &&
      item?.workflowStatus === 'published' &&
      item?.sanityLifecycle === 'published' &&
      canCreateRevisionDraft(access.context)
  );
}

function canOpenPublishedRevisionForItem(item) {
  return Boolean(
    access.ok &&
      item?.workflowStatus === 'published' &&
      item?.sanityLifecycle === 'revision_draft' &&
      canCreateRevisionDraft(access.context)
  );
}

function buildUnifiedEditorialArticleItems(ownItems, queueItems) {
  const queueIds = new Set(queueItems.map((item) => item.sanityDocumentId));
  const mergedItems = new Map();

  for (const item of ownItems) {
    mergedItems.set(item.sanityDocumentId, {
      ...item,
      isReviewQueueItem: queueIds.has(item.sanityDocumentId),
    });
  }

  for (const item of queueItems) {
    const existing = mergedItems.get(item.sanityDocumentId);

    mergedItems.set(item.sanityDocumentId, {
      ...(existing || item),
      workflowPermissions: item.workflowPermissions || existing?.workflowPermissions,
      isReviewQueueItem: true,
    });
  }

  return Array.from(mergedItems.values()).sort((first, second) => {
    const firstTimestamp = Date.parse(first.article?.updatedAt || first.updatedAt || first.createdAt || '');
    const secondTimestamp = Date.parse(second.article?.updatedAt || second.updatedAt || second.createdAt || '');

    return (Number.isFinite(secondTimestamp) ? secondTimestamp : 0) -
      (Number.isFinite(firstTimestamp) ? firstTimestamp : 0);
  });
}

if (access.ok) {
  author = await fetchEditorialAuthorProfile(access.context.sanityAuthorId);

  if (author) {
    publishedArticleCount = await fetchPublishedArticleCountForAuthor(access.context.sanityAuthorId);
  }

  const result = await fetchOwnEditorialArticles(access.context);

  if (result.ok) {
    items = result.items;
  } else {
    listError = result.error;
  }

  if (access.context.permissions.canReadSubmittedArticles) {
    const reviewResult = await fetchReviewQueueEditorialArticles(access.context);

    if (reviewResult.ok) {
      reviewItems = reviewResult.items;
    } else {
      reviewError = reviewResult.error;
    }
  }

  editorialArticleItems = buildUnifiedEditorialArticleItems(items, reviewItems);
}

const visibleOwnTypeOptions = Array.from(
  new Set(
    editorialArticleItems
      .map((item) => item.article || item.draft)
      .map((article) => article?.type)
      .filter(Boolean)
  )
).sort((a, b) => String(a).localeCompare(String(b)));
---

<BaseLayout
  lang={currentLang}
  title={copy.pageTitle}
  description={copy.pageDescription}
  canonical={Astro.url.href}
  languageSwitch={languageSwitch}
  noindex={true}
>
  <CommunityLayout class="editorial-area-page editorial-workspace-page" sidebar={access.ok && Boolean(author)}>
    {access.ok && author && (
      <Fragment slot="sidebar">
        <EditorialSidebar
          lang={currentLang}
          author={author}
          editorialRole={access.context.editorialRole}
          publishedArticleCount={publishedArticleCount}
        />
      </Fragment>
    )}

    <CommunityHero
      kicker={copy.kicker}
      title={copy.title}
      description={copy.description}
    />

    {access.ok && (
      <EditorialSectionNav
        activeSection="articles"
        lang={currentLang}
        authorPreviewHref={author?.publicUrls?.[currentLang]}
      />
    )}

    {access.ok && (
      <p class="editorial-message" data-editorial-dashboard-status hidden aria-live="polite"></p>
    )}

    {!access.ok && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2>{copy.deniedTitle}</h2>
        <p>{copy.deniedDescription}</p>
      </section>
    )}

    {access.ok && (
      <section class="editorial-card editorial-article-list">
        <div class="editorial-article-list__header">
          <div>
            <p class="editorial-kicker">{copy.articleListKicker}</p>
            <h2>{copy.articleListTitle}</h2>
          </div>
          <a class="editorial-button" href={newArticleHref}>{copy.newArticle}</a>
        </div>

        <p class="editorial-message" data-editorial-workflow-status hidden aria-live="polite"></p>

        {listError && (
          <p class="editorial-message" data-tone="error">{listError}</p>
        )}

        {reviewError && (
          <p class="editorial-message" data-tone="error">{reviewError}</p>
        )}

        {!listError && editorialArticleItems.length === 0 && (
          <div class="editorial-empty-state">
            <h3>{copy.noArticlesTitle}</h3>
            <p>{copy.noArticlesText}</p>
          </div>
        )}

        {!listError && editorialArticleItems.length > 0 && (
          <div class="editorial-article-controls">
            <div class="editorial-article-quick-filters" role="group" aria-label={copy.quickFiltersLabel}>
              <button type="button" data-editorial-quick-filter="all" aria-pressed="true">
                <span>{copy.quickAll}</span>
                <span data-editorial-quick-filter-count>0</span>
              </button>
              <button type="button" data-editorial-quick-filter="drafts" aria-pressed="false">
                <span>{copy.quickDrafts}</span>
                <span data-editorial-quick-filter-count>0</span>
              </button>
              <button type="button" data-editorial-quick-filter="review" aria-pressed="false">
                <span>{copy.quickReview}</span>
                <span data-editorial-quick-filter-count>0</span>
              </button>
              <button type="button" data-editorial-quick-filter="published" aria-pressed="false">
                <span>{copy.quickPublished}</span>
                <span data-editorial-quick-filter-count>0</span>
              </button>
              <button type="button" data-editorial-quick-filter="revisions" aria-pressed="false">
                <span>{copy.quickRevisions}</span>
                <span data-editorial-quick-filter-count>0</span>
              </button>
              <button type="button" data-editorial-quick-filter="orphans" aria-pressed="false">
                <span>{copy.quickOrphans}</span>
                <span data-editorial-quick-filter-count>0</span>
              </button>
            </div>

            <form class="editorial-article-filters" data-editorial-article-filters aria-label={copy.filtersLabel}>
              <label class="editorial-article-filter editorial-article-filter--search">
                <span>{copy.filtersLabel}</span>
                <input
                  type="search"
                  name="search"
                  placeholder={copy.searchPlaceholder}
                  autocomplete="off"
                  data-editorial-filter-search
                />
              </label>
              <label class="editorial-article-filter">
                <span>{copy.languageFilter}</span>
                <select name="language" data-editorial-filter-language>
                  <option value="">{copy.allLanguages}</option>
                  <option value="it">IT</option>
                  <option value="en">EN</option>
                </select>
              </label>
              <label class="editorial-article-filter">
                <span>{copy.typeFilter}</span>
                <select name="type" data-editorial-filter-type>
                  <option value="">{copy.allTypes}</option>
                  {visibleOwnTypeOptions.map((type) => (
                    <option value={type}>{type}</option>
                  ))}
                </select>
              </label>
              <label class="editorial-article-filter">
                <span>{copy.sortFilter}</span>
                <select name="sort" data-editorial-sort>
                  <option value="updated_desc">{copy.sortUpdatedDesc}</option>
                  <option value="title_asc">{copy.sortTitleAsc}</option>
                  <option value="title_desc">{copy.sortTitleDesc}</option>
                  <option value="created_desc">{copy.sortCreatedDesc}</option>
                  <option value="workflow">{copy.sortWorkflow}</option>
                </select>
              </label>
            </form>

            <p class="editorial-article-count" data-editorial-article-count aria-live="polite">
              {editorialArticleItems.length} {editorialArticleItems.length === 1 ? copy.articleCountSingular : copy.articleCountPlural}
            </p>
          </div>
        )}

        {!listError && editorialArticleItems.length > 0 && (
          <div class="editorial-article-list__items" data-editorial-article-items>
            {editorialArticleItems.map((item, index) => {
              const article = item.article || item.draft;
              const isReviewQueueItem = Boolean(item.isReviewQueueItem);
              const canEdit = item.workflowStatus === 'draft' || item.workflowStatus === 'changes_requested';
              const canCreatePublishedRevision = canCreatePublishedRevisionForItem(item);
              const canOpenPublishedRevision = canOpenPublishedRevisionForItem(item);
              const canRequestChanges = isReviewQueueItem && item.workflowPermissions?.canRequestChanges;
              const canApprove = isReviewQueueItem && item.workflowPermissions?.canApprove;
              const showPublishPlaceholder =
                isReviewQueueItem && item.workflowStatus === 'approved' && access.context.permissions.canPublishArticle;
              const href = canEdit || canOpenPublishedRevision
                ? getEditorialArticleEditPath(item.sanityDocumentId, currentLang)
                : getEditorialArticlePreviewPath(item.sanityDocumentId, currentLang);
              const actionLabel = canCreatePublishedRevision || canOpenPublishedRevision
                ? copy.editArticle
                : isReviewQueueItem
                  ? getReviewArticleActionLabel(item)
                  : getOwnArticleActionLabel(item);
              const cardImage = getArticleImage(article);
              const summary = getArticleSummary(article);
              const authorLabel = article?.author?.label || item.author?.label || item.sanityAuthorId;
              const updatedAt = article?.updatedAt || item.updatedAt;
              const createdAt = article?.createdAt || item.createdAt;
              const articleTitle = article?.title || copy.untitled;
              const menuId = getArticleMenuId(isReviewQueueItem ? 'review' : 'own', item);
              const canCreateEnglishTranslation = canCreateEnglishTranslationForItem(item, article);
              const stateBadge = getArticleStateBadge(item);
              const searchIndex = [
                articleTitle,
                summary,
                article?.slug,
              ].filter(Boolean).join(' ');

              return (
                <article
                  class="editorial-article-row"
                  data-editorial-article
                  data-workflow-status={item.workflowStatus}
                  data-sanity-lifecycle={item.sanityLifecycle}
                  data-review-queue={isReviewQueueItem ? 'true' : 'false'}
                  data-article-language={article?.language || ''}
                  data-article-type={article?.type || ''}
                  data-search-index={searchIndex}
                  data-sort-title={articleTitle}
                  data-updated-at={updatedAt || ''}
                  data-created-at={createdAt || ''}
                  data-original-index={index}
                >
                  <div class="editorial-article-row__media">
                    {cardImage ? (
                      <img
                        class="editorial-article-row__image"
                        src={cardImage.src}
                        alt={cardImage.alt}
                        loading="lazy"
                      />
                    ) : (
                      <div class="editorial-article-row__placeholder" aria-hidden="true">
                        <span>{copy.imageFallback}</span>
                      </div>
                    )}
                  </div>

                  <div class="editorial-article-row__body">
                    <div class="editorial-article-row__badges" aria-label={copy.workflowStatus}>
                      <span class="editorial-article-row__badge" data-status={stateBadge.status}>
                        {stateBadge.label}
                      </span>
                      <span class="editorial-article-row__badge">{getLanguageBadge(article?.language)}</span>
                      <span class="editorial-article-row__badge">{article?.type || '—'}</span>
                    </div>
                    <h3>{articleTitle}</h3>
                    {summary && <p class="editorial-article-row__summary">{summary}</p>}
                    <p class="editorial-article-row__meta-line">
                      {authorLabel} <span aria-hidden="true">·</span> {copy.updated} {formatDateTime(updatedAt)}
                    </p>
                    {!article && (
                      <p class="editorial-message" data-tone="error">{copy.missingDraft}</p>
                    )}
                    {showPublishPlaceholder && (
                      <p class="editorial-message">{copy.readyForPublish}</p>
                    )}
                  </div>

                  {article && (
                    <div class="editorial-article-row__actions">
                      <div class="editorial-article-row__menu" data-editorial-article-menu>
                        <button
                          class="editorial-pte__image-menu-button editorial-article-row__menu-button"
                          type="button"
                          aria-label={copy.articleActions}
                          title={copy.articleActions}
                          aria-haspopup="menu"
                          aria-expanded="false"
                          aria-controls={menuId}
                          data-editorial-article-menu-trigger
                        >
                          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                            <circle cx="7" cy="12" r="1.8" />
                            <circle cx="12" cy="12" r="1.8" />
                            <circle cx="17" cy="12" r="1.8" />
                          </svg>
                        </button>
                        <div
                          id={menuId}
                          class="editorial-pte__image-menu-panel editorial-article-row__menu-panel"
                          role="menu"
                          data-editorial-article-menu-panel
                          hidden
                        >
                          {canCreatePublishedRevision ? (
                            <button
                              type="button"
                              role="menuitem"
                              data-editorial-revision-action
                              data-endpoint={`/api/editor/articles/${encodeURIComponent(item.sanityDocumentId)}/revision`}
                            >
                              {actionLabel}
                            </button>
                          ) : (
                            <a href={href} role="menuitem">{actionLabel}</a>
                          )}
                          {canCreateEnglishTranslation && (
                            <button
                              type="button"
                              role="menuitem"
                              data-editorial-translation-action
                              data-endpoint={`/api/editor/articles/${encodeURIComponent(item.sanityDocumentId)}/translation`}
                            >
                              {copy.createEnglishTranslation}
                            </button>
                          )}
                          {canRequestChanges && (
                            <button
                              type="button"
                              role="menuitem"
                              data-editorial-workflow-action="request_changes"
                              data-endpoint={`/api/editor/articles/${encodeURIComponent(item.sanityDocumentId)}/workflow`}
                              data-confirm={copy.requestChangesConfirm}
                            >
                              {copy.requestChanges}
                            </button>
                          )}
                          {canApprove && (
                            <button
                              type="button"
                              role="menuitem"
                              data-editorial-workflow-action="approve"
                              data-endpoint={`/api/editor/articles/${encodeURIComponent(item.sanityDocumentId)}/workflow`}
                              data-confirm={copy.approveConfirm}
                            >
                              {copy.approve}
                            </button>
                          )}
                        </div>
                      </div>
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        )}

        {!listError && editorialArticleItems.length > 0 && (
          <div class="editorial-empty-state editorial-empty-state--compact" data-editorial-filter-empty hidden aria-live="polite">
            <h3>{copy.noFilterResultsTitle}</h3>
            <p>{copy.noFilterResultsText}</p>
          </div>
        )}
      </section>
    )}
  </CommunityLayout>
</BaseLayout>

<script define:vars={{
  workflowUpdating: copy.workflowUpdating,
  workflowUpdated: copy.workflowUpdated,
  workflowGenericError: copy.workflowGenericError,
  translationCreating: copy.translationCreating,
  translationCreated: copy.translationCreated,
  translationAlreadyExists: copy.translationAlreadyExists,
  translationGenericError: copy.translationGenericError,
  revisionCreating: copy.revisionCreating,
  revisionCreated: copy.revisionCreated,
  revisionGenericError: copy.revisionGenericError,
  editorialUiLanguage: currentLang,
  articleCountSingular: copy.articleCountSingular,
  articleCountPlural: copy.articleCountPlural,
}}>
  const dashboardStatus = document.querySelector('[data-editorial-dashboard-status]');
  const workflowStatus = document.querySelector('[data-editorial-workflow-status]');
  const articleMenus = document.querySelectorAll('[data-editorial-article-menu]');
  const articleMenuTriggers = document.querySelectorAll('[data-editorial-article-menu-trigger]');
  const workflowButtons = document.querySelectorAll('[data-editorial-workflow-action]');
  const translationButtons = document.querySelectorAll('[data-editorial-translation-action]');
  const revisionButtons = document.querySelectorAll('[data-editorial-revision-action]');
  const articleFilterForm = document.querySelector('[data-editorial-article-filters]');
  const articleItems = document.querySelector('[data-editorial-article-items]');
  const articleCards = Array.from(document.querySelectorAll('[data-editorial-article]'));
  const filterEmptyState = document.querySelector('[data-editorial-filter-empty]');
  const articleCount = document.querySelector('[data-editorial-article-count]');
  const quickFilterButtons = Array.from(document.querySelectorAll('[data-editorial-quick-filter]'));
  let activeQuickFilter = 'all';

  const normalizeFilterText = (value) => String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

  const getArticleCountLabel = (visible) => {
    const articleLabel = visible === 1 ? articleCountSingular : articleCountPlural;

    return `${visible} ${articleLabel}`;
  };

  const getTimestamp = (value) => {
    const timestamp = Date.parse(String(value || ''));

    return Number.isFinite(timestamp) ? timestamp : 0;
  };

  const workflowSortOrder = {
    draft: 10,
    changes_requested: 20,
    submitted: 30,
    approved: 40,
    published: 50,
  };

  const compareOriginalOrder = (first, second) => (
    Number(first.dataset.originalIndex || 0) - Number(second.dataset.originalIndex || 0)
  );

  const compareArticleCards = (sortMode) => (first, second) => {
    if (!(first instanceof HTMLElement) || !(second instanceof HTMLElement)) return 0;

    if (sortMode === 'title_asc' || sortMode === 'title_desc') {
      const result = normalizeFilterText(first.dataset.sortTitle)
        .localeCompare(normalizeFilterText(second.dataset.sortTitle));

      return sortMode === 'title_desc' ? -result || compareOriginalOrder(first, second) : result || compareOriginalOrder(first, second);
    }

    if (sortMode === 'created_desc') {
      return (
        getTimestamp(second.dataset.createdAt) -
        getTimestamp(first.dataset.createdAt)
      ) || compareOriginalOrder(first, second);
    }

    if (sortMode === 'workflow') {
      const firstStatus = workflowSortOrder[first.dataset.workflowStatus] || 999;
      const secondStatus = workflowSortOrder[second.dataset.workflowStatus] || 999;

      return (firstStatus - secondStatus) || (
        getTimestamp(second.dataset.updatedAt) -
        getTimestamp(first.dataset.updatedAt)
      ) || compareOriginalOrder(first, second);
    }

    return (
      getTimestamp(second.dataset.updatedAt) -
      getTimestamp(first.dataset.updatedAt)
    ) || compareOriginalOrder(first, second);
  };

  const matchesQuickFilter = (card, quickFilter) => {
    if (!(card instanceof HTMLElement)) return false;

    const workflowStatus = card.dataset.workflowStatus || '';
    const sanityLifecycle = card.dataset.sanityLifecycle || '';

    if (quickFilter === 'drafts') {
      return (
        (workflowStatus === 'draft' || workflowStatus === 'changes_requested') &&
        sanityLifecycle !== 'missing' &&
        sanityLifecycle !== 'revision_draft'
      );
    }

    if (quickFilter === 'review') {
      return (
        (workflowStatus === 'submitted' || workflowStatus === 'approved') &&
        sanityLifecycle !== 'missing' &&
        sanityLifecycle !== 'revision_draft'
      );
    }

    if (quickFilter === 'published') {
      return workflowStatus === 'published' && sanityLifecycle === 'published';
    }

    if (quickFilter === 'revisions') {
      return sanityLifecycle === 'revision_draft';
    }

    if (quickFilter === 'orphans') {
      return sanityLifecycle === 'missing';
    }

    return true;
  };

  const updateQuickFilterButtons = () => {
    quickFilterButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      const quickFilter = button.dataset.editorialQuickFilter || 'all';
      const isActive = quickFilter === activeQuickFilter;
      const count = articleCards.filter((card) => matchesQuickFilter(card, quickFilter)).length;
      const countNode = button.querySelector('[data-editorial-quick-filter-count]');

      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      if (countNode) countNode.textContent = String(count);
    });
  };

  const closeArticleMenus = (except = null) => {
    articleMenus.forEach((menu) => {
      if (except && menu === except) return;

      const trigger = menu.querySelector('[data-editorial-article-menu-trigger]');
      const panel = menu.querySelector('[data-editorial-article-menu-panel]');

      trigger?.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    });
  };

  articleMenuTriggers.forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();

      const menu = trigger.closest('[data-editorial-article-menu]');
      const panel = menu?.querySelector('[data-editorial-article-menu-panel]');
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      closeArticleMenus(menu);
      trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (panel) panel.hidden = isOpen;
    });
  });

  articleMenus.forEach((menu) => {
    menu.addEventListener('click', (event) => {
      event.stopPropagation();
    });
  });

  document.addEventListener('click', () => {
    closeArticleMenus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeArticleMenus();
    }
  });

  const setWorkflowStatus = (message, tone = '') => {
    if (!workflowStatus) return;

    workflowStatus.hidden = false;
    workflowStatus.textContent = message;
    if (tone) {
      workflowStatus.setAttribute('data-tone', tone);
    } else {
      workflowStatus.removeAttribute('data-tone');
    }
  };

  const setDashboardStatus = (message, tone = '') => {
    if (!dashboardStatus) return;

    dashboardStatus.hidden = false;
    dashboardStatus.textContent = message;
    if (tone) {
      dashboardStatus.setAttribute('data-tone', tone);
    } else {
      dashboardStatus.removeAttribute('data-tone');
    }
  };

  const updateArticleFilters = () => {
    if (!articleFilterForm || articleCards.length === 0) return;

    const getFilterValue = (selector) => {
      const control = articleFilterForm.querySelector(selector);

      return control instanceof HTMLInputElement || control instanceof HTMLSelectElement
        ? control.value
        : '';
    };
    const search = normalizeFilterText(getFilterValue('[data-editorial-filter-search]'));
    const sanityLifecycle = getFilterValue('[data-editorial-filter-lifecycle]');
    const language = getFilterValue('[data-editorial-filter-language]');
    const type = getFilterValue('[data-editorial-filter-type]');
    const sortMode = getFilterValue('[data-editorial-sort]') || 'updated_desc';
    const sortedCards = [...articleCards].sort(compareArticleCards(sortMode));
    let visibleCount = 0;

    sortedCards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;

      const matchesSearch = !search || normalizeFilterText(card.dataset.searchIndex).includes(search);
      const matchesLifecycle = !sanityLifecycle || card.dataset.sanityLifecycle === sanityLifecycle;
      const matchesLanguage = !language || card.dataset.articleLanguage === language;
      const matchesType = !type || card.dataset.articleType === type;
      const matchesQuick = matchesQuickFilter(card, activeQuickFilter);
      const isVisible = matchesQuick && matchesSearch && matchesLifecycle && matchesLanguage && matchesType;

      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
      if (articleItems) {
        articleItems.append(card);
      }
    });

    if (articleItems) {
      articleItems.hidden = visibleCount === 0;
    }

    if (filterEmptyState) {
      filterEmptyState.hidden = visibleCount > 0;
    }

    if (articleCount) {
      articleCount.textContent = getArticleCountLabel(visibleCount);
    }
    updateQuickFilterButtons();
  };

  quickFilterButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    button.addEventListener('click', () => {
      activeQuickFilter = button.dataset.editorialQuickFilter || 'all';
      closeArticleMenus();
      updateArticleFilters();
    });
  });

  if (articleFilterForm) {
    articleFilterForm.addEventListener('submit', (event) => {
      event.preventDefault();
    });
    articleFilterForm.addEventListener('input', () => {
      closeArticleMenus();
      updateArticleFilters();
    });
    articleFilterForm.addEventListener('change', () => {
      closeArticleMenus();
      updateArticleFilters();
    });
    updateArticleFilters();
  }

  workflowButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const endpoint = button.getAttribute('data-endpoint') || '';
      const action = button.getAttribute('data-editorial-workflow-action') || '';
      const confirmMessage = button.getAttribute('data-confirm') || '';

      if (!endpoint || !action) return;
      closeArticleMenus();
      if (confirmMessage && !window.confirm(confirmMessage)) return;

      const originalText = button.textContent || '';
      button.setAttribute('disabled', 'disabled');
      button.textContent = workflowUpdating;
      setWorkflowStatus(workflowUpdating);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify({ action }),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.error || 'workflow_failed');
        }

        setWorkflowStatus(workflowUpdated, 'success');
        window.location.reload();
      } catch {
        button.removeAttribute('disabled');
        button.textContent = originalText;
        setWorkflowStatus(workflowGenericError, 'error');
      }
    });
  });

  translationButtons.forEach((button) => {
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      event.stopPropagation();

      const endpoint = button.getAttribute('data-endpoint') || '';

      if (!endpoint || !(button instanceof HTMLButtonElement) || button.disabled) return;
      closeArticleMenus();

      const originalText = button.textContent || '';
      button.setAttribute('disabled', 'disabled');
      button.textContent = translationCreating;
      setDashboardStatus(translationCreating);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
        });
        const result = await response.json().catch(() => null);

        const createdArticleId = typeof result?.id === 'string' ? result.id.trim() : '';
        const editUrl = createdArticleId
          ? `/en/account/editor/articles/${encodeURIComponent(createdArticleId)}/`
          : '';

        if (!response.ok || !result?.ok || !editUrl) {
          throw new Error(result?.error || 'translation_failed');
        }

        setDashboardStatus(translationCreated, 'success');
        window.location.assign(editUrl);
      } catch (error) {
        button.removeAttribute('disabled');
        button.textContent = originalText;
        setDashboardStatus(
          error instanceof Error && error.message === 'article_translation_exists'
            ? translationAlreadyExists
            : translationGenericError,
          'error'
        );
      }
    });
  });

  revisionButtons.forEach((button) => {
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      event.stopPropagation();

      const endpoint = button.getAttribute('data-endpoint') || '';

      if (!endpoint || !(button instanceof HTMLButtonElement) || button.disabled) return;
      closeArticleMenus();

      const originalText = button.textContent || '';
      button.setAttribute('disabled', 'disabled');
      button.textContent = revisionCreating;
      setDashboardStatus(revisionCreating);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify({ uiLanguage: editorialUiLanguage }),
        });
        const result = await response.json().catch(() => null);
        const editUrl = typeof result?.editUrl === 'string' ? result.editUrl.trim() : '';

        if (!response.ok || !result?.ok || !editUrl) {
          throw new Error(result?.error || 'revision_failed');
        }

        setDashboardStatus(revisionCreated, 'success');
        window.location.assign(editUrl);
      } catch {
        button.removeAttribute('disabled');
        button.textContent = originalText;
        setDashboardStatus(revisionGenericError, 'error');
      }
    });
  });
</script>
