---
import '../../styles/pages/editorial-area.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../community/CommunityHero.astro';
import CommunityLayout from '../community/CommunityLayout.astro';
import CommunitySidebarSection from '../community/CommunitySidebarSection.astro';
import {
  fetchOwnEditorialArticles,
  fetchReviewQueueEditorialArticles,
  getEditorialArticleEditPath,
  getEditorialArticlePreviewPath,
  requireEditorialArticleContext,
} from '../../lib/editorial/articles.server';
import { getEditorialRoleLabel } from '../../lib/editorial/labels';

type EditorialLang = 'it' | 'en';

const { lang = 'it' } = Astro.props as { lang?: EditorialLang };
const currentLang: EditorialLang = lang === 'en' ? 'en' : 'it';
const isEnglish = currentLang === 'en';
const access = await requireEditorialArticleContext(Astro.cookies);

const copy = isEnglish
  ? {
      pageTitle: 'Article workspace | Retro-Gamers.it',
      pageDescription: 'Manage your Retro-Gamers article drafts.',
      kicker: 'Editorial area',
      title: 'Article workspace',
      description:
        'Create and edit your private Sanity article drafts. Publishing and review actions are intentionally not active in this step.',
      deniedTitle: 'Editorial access required',
      deniedDescription:
        'This workspace is available only to active editorial contributors.',
      newArticle: 'New article',
      editArticle: 'Edit article',
      openReview: 'Open review',
      view: 'View',
      draft: 'Draft',
      ownArticles: 'Your articles',
      reviewQueue: 'Review queue',
      reviewQueueKicker: 'Editorial review',
      reviewQueueDescription: 'Submitted and approved articles waiting for editorial action.',
      missingDraft: 'Sanity document not found',
      lifecycle: {
        draft: 'DRAFT',
        revision_draft: 'UNPUBLISHED CHANGES',
        published: 'PUBLISHED',
        missing: 'SANITY DOCUMENT NOT FOUND',
      },
      workflow: {
        draft: 'Draft',
        submitted: 'Submitted for review',
        changes_requested: 'Changes requested',
        approved: 'Approved',
        published: 'Published',
      },
      noArticlesTitle: 'No editorial drafts yet',
      noArticlesText: 'Create your first draft to start writing inside the custom editor.',
      noReviewItemsTitle: 'No articles waiting for review',
      noReviewItemsText: 'Submitted articles will appear here when contributors send them to the editorial desk.',
      dashboard: 'Editorial dashboard',
      profile: 'Author profile',
      role: 'Editorial role',
      type: 'Type',
      language: 'Language',
      author: 'Author',
      workflowStatus: 'Workflow',
      submitted: 'Submitted',
      reviewed: 'Reviewed',
      updated: 'Updated',
      untitled: 'Untitled draft',
      requestChanges: 'Request changes',
      approve: 'Approve',
      readyForPublish: 'Ready for publishing',
      requestChangesConfirm: 'Return this article to the author for changes?',
      approveConfirm: 'Approve this article?',
      workflowUpdating: 'Updating workflow…',
      workflowUpdated: 'Workflow updated.',
      workflowGenericError: 'The workflow action could not be completed.',
    }
  : {
      pageTitle: 'Editor articoli | Retro-Gamers.it',
      pageDescription: 'Gestisci le tue bozze articolo su Retro-Gamers.it.',
      kicker: 'Area redazione',
      title: 'Editor articoli',
      description:
        'Crea e modifica le tue bozze private Sanity. Pubblicazione e revisione restano volutamente non attive in questo step.',
      deniedTitle: 'Accesso redazionale richiesto',
      deniedDescription:
        'Questo workspace è disponibile solo per collaboratori redazionali attivi.',
      newArticle: 'Nuovo articolo',
      editArticle: 'Modifica articolo',
      openReview: 'Apri revisione',
      view: 'Visualizza',
      draft: 'Bozza',
      ownArticles: 'I tuoi articoli',
      reviewQueue: 'Da revisionare',
      reviewQueueKicker: 'Revisione editoriale',
      reviewQueueDescription: 'Articoli inviati e approvati in attesa di azione redazionale.',
      missingDraft: 'Documento Sanity non trovato',
      lifecycle: {
        draft: 'BOZZA',
        revision_draft: 'MODIFICHE NON PUBBLICATE',
        published: 'PUBBLICATO',
        missing: 'DOCUMENTO SANITY NON TROVATO',
      },
      workflow: {
        draft: 'Bozza',
        submitted: 'In revisione',
        changes_requested: 'Modifiche richieste',
        approved: 'Approvato',
        published: 'Pubblicato',
      },
      noArticlesTitle: 'Nessuna bozza redazionale',
      noArticlesText: 'Crea la prima bozza per iniziare a scrivere nel custom editor.',
      noReviewItemsTitle: 'Nessun articolo in coda',
      noReviewItemsText: 'Gli articoli inviati dai contributor compariranno qui.',
      dashboard: 'Dashboard redazionale',
      profile: 'Profilo autore',
      role: 'Ruolo redazionale',
      type: 'Tipo',
      language: 'Lingua',
      author: 'Autore',
      workflowStatus: 'Workflow',
      submitted: 'Inviato',
      reviewed: 'Revisionato',
      updated: 'Aggiornato',
      untitled: 'Bozza senza titolo',
      requestChanges: 'Richiedi modifiche',
      approve: 'Approva',
      readyForPublish: 'Pronto per pubblicazione',
      requestChangesConfirm: 'Restituire l’articolo all’autore per modifiche?',
      approveConfirm: 'Approvare questo articolo?',
      workflowUpdating: 'Aggiornamento workflow…',
      workflowUpdated: 'Workflow aggiornato.',
      workflowGenericError: 'Non è stato possibile completare l’azione workflow.',
    };

const dashboardHref = isEnglish ? '/en/account/editor/' : '/account/editor/';
const profileHref = isEnglish ? '/en/account/editor/profile/' : '/account/editor/profile/';
const newArticleHref = isEnglish ? '/en/account/editor/articles/new/' : '/account/editor/articles/new/';
const languageSwitch = isEnglish ? '/account/editor/articles/' : '/en/account/editor/articles/';
let items = [];
let listError = '';
let reviewItems = [];
let reviewError = '';
const canSeeReviewQueue = Boolean(access.ok && access.context.permissions.canReadSubmittedArticles);
const reviewQueueWorkflowStatuses = new Set(['submitted', 'approved']);

function formatDateTime(value) {
  return value ? new Date(value).toLocaleString(isEnglish ? 'en' : 'it') : '—';
}

function getWorkflowLabel(status) {
  return copy.workflow[status] || status || '—';
}

if (access.ok) {
  const result = await fetchOwnEditorialArticles(access.context);

  if (result.ok) {
    items = result.items;
  } else {
    listError = result.error;
  }

  if (access.context.permissions.canReadSubmittedArticles) {
    const reviewResult = await fetchReviewQueueEditorialArticles(access.context);

    if (reviewResult.ok) {
      reviewItems = reviewResult.items;
    } else {
      reviewError = reviewResult.error;
    }
  }
}

const visibleOwnItems = canSeeReviewQueue
  ? items.filter((item) => !reviewQueueWorkflowStatuses.has(item.workflowStatus))
  : items;
---

<BaseLayout
  lang={currentLang}
  title={copy.pageTitle}
  description={copy.pageDescription}
  canonical={Astro.url.href}
  languageSwitch={languageSwitch}
  noindex={true}
>
  <CommunityLayout class="editorial-area-page editorial-workspace-page" sidebar={access.ok}>
    {access.ok && (
      <Fragment slot="sidebar">
        <CommunitySidebarSection title={copy.kicker}>
          <div class="community-link-list">
            <a href={dashboardHref}>{copy.dashboard}</a>
            <a href={profileHref}>{copy.profile}</a>
            <a href={newArticleHref}>{copy.newArticle}</a>
          </div>
        </CommunitySidebarSection>
        <CommunitySidebarSection title={copy.role}>
          <p>{getEditorialRoleLabel(access.context.editorialRole, currentLang)}</p>
        </CommunitySidebarSection>
      </Fragment>
    )}

    <CommunityHero
      kicker={copy.kicker}
      title={copy.title}
      description={copy.description}
    />

    {!access.ok && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2>{copy.deniedTitle}</h2>
        <p>{copy.deniedDescription}</p>
      </section>
    )}

    {access.ok && (
      <section class="editorial-card editorial-article-list">
        <div class="editorial-article-list__header">
          <div>
            <p class="editorial-kicker">{copy.draft}</p>
            <h2>{copy.ownArticles}</h2>
          </div>
          <a class="editorial-button" href={newArticleHref}>{copy.newArticle}</a>
        </div>

        {listError && (
          <p class="editorial-message" data-tone="error">{listError}</p>
        )}

        {!listError && visibleOwnItems.length === 0 && (
          <div class="editorial-empty-state">
            <h3>{copy.noArticlesTitle}</h3>
            <p>{copy.noArticlesText}</p>
          </div>
        )}

        {!listError && visibleOwnItems.length > 0 && (
          <div class="editorial-article-list__items">
            {visibleOwnItems.map((item) => {
              const article = item.article || item.draft;
              const canEdit = item.workflowStatus === 'draft' || item.workflowStatus === 'changes_requested';
              const href = canEdit
                ? getEditorialArticleEditPath(item.sanityDocumentId, currentLang)
                : getEditorialArticlePreviewPath(item.sanityDocumentId, currentLang);
              const actionLabel = canEdit ? copy.editArticle : copy.view;
              const lifecycle = item.sanityLifecycle || 'missing';
              const lifecycleLabel = copy.lifecycle[lifecycle] || copy.lifecycle.missing;
              const updatedAt = article?.updatedAt || item.updatedAt;

              return (
                <article class="editorial-article-row">
                  <div>
                    <p class="editorial-kicker">{lifecycleLabel}</p>
                    <h3>{article?.title || copy.untitled}</h3>
                    <dl class="editorial-article-row__meta">
                      <div>
                        <dt>{copy.language}</dt>
                        <dd>{article?.language || '—'}</dd>
                      </div>
                      <div>
                        <dt>{copy.type}</dt>
                        <dd>{article?.type || '—'}</dd>
                      </div>
                      <div>
                        <dt>{copy.workflowStatus}</dt>
                        <dd>{getWorkflowLabel(item.workflowStatus)}</dd>
                      </div>
                      <div>
                        <dt>{copy.updated}</dt>
                        <dd>{formatDateTime(updatedAt)}</dd>
                      </div>
                    </dl>
                    {!article && (
                      <p class="editorial-message" data-tone="error">{copy.missingDraft}</p>
                    )}
                  </div>

                  {article && (
                    <a class="editorial-button" href={href}>{actionLabel}</a>
                  )}
                </article>
              );
            })}
          </div>
        )}
      </section>
    )}

    {access.ok && canSeeReviewQueue && (
      <section class="editorial-card editorial-article-list">
        <div class="editorial-article-list__header">
          <div>
            <p class="editorial-kicker">{copy.reviewQueueKicker}</p>
            <h2>{copy.reviewQueue}</h2>
            <p>{copy.reviewQueueDescription}</p>
          </div>
        </div>

        <p class="editorial-message" data-editorial-workflow-status hidden aria-live="polite"></p>

        {reviewError && (
          <p class="editorial-message" data-tone="error">{reviewError}</p>
        )}

        {!reviewError && reviewItems.length === 0 && (
          <div class="editorial-empty-state">
            <h3>{copy.noReviewItemsTitle}</h3>
            <p>{copy.noReviewItemsText}</p>
          </div>
        )}

        {!reviewError && reviewItems.length > 0 && (
          <div class="editorial-article-list__items">
            {reviewItems.map((item) => {
              const article = item.article || item.draft;
              const previewHref = getEditorialArticlePreviewPath(item.sanityDocumentId, currentLang);
              const lifecycle = item.sanityLifecycle || 'missing';
              const lifecycleLabel = copy.lifecycle[lifecycle] || copy.lifecycle.missing;
              const authorLabel = article?.author?.label || item.author?.label || item.sanityAuthorId;
              const canRequestChanges = item.workflowPermissions?.canRequestChanges;
              const canApprove = item.workflowPermissions?.canApprove;
              const showPublishPlaceholder =
                item.workflowStatus === 'approved' && access.context.permissions.canPublishArticle;

              return (
                <article class="editorial-article-row">
                  <div>
                    <p class="editorial-kicker">{lifecycleLabel}</p>
                    <h3>{article?.title || copy.untitled}</h3>
                    <dl class="editorial-article-row__meta">
                      <div>
                        <dt>{copy.author}</dt>
                        <dd>{authorLabel}</dd>
                      </div>
                      <div>
                        <dt>{copy.language}</dt>
                        <dd>{article?.language || '—'}</dd>
                      </div>
                      <div>
                        <dt>{copy.type}</dt>
                        <dd>{article?.type || '—'}</dd>
                      </div>
                      <div>
                        <dt>{copy.workflowStatus}</dt>
                        <dd>{getWorkflowLabel(item.workflowStatus)}</dd>
                      </div>
                      <div>
                        <dt>{copy.submitted}</dt>
                        <dd>{formatDateTime(item.submittedAt)}</dd>
                      </div>
                      <div>
                        <dt>{copy.reviewed}</dt>
                        <dd>{formatDateTime(item.reviewedAt)}</dd>
                      </div>
                    </dl>
                    {!article && (
                      <p class="editorial-message" data-tone="error">{copy.missingDraft}</p>
                    )}
                    {showPublishPlaceholder && (
                      <p class="editorial-message">{copy.readyForPublish}</p>
                    )}
                  </div>

                  {article && (
                    <div class="editorial-action-card__actions">
                      <a class="editorial-button" href={previewHref}>{copy.openReview}</a>
                      {canRequestChanges && (
                        <button
                          class="editorial-mini-button"
                          type="button"
                          data-editorial-workflow-action="request_changes"
                          data-endpoint={`/api/editor/articles/${encodeURIComponent(item.sanityDocumentId)}/workflow`}
                          data-confirm={copy.requestChangesConfirm}
                        >
                          {copy.requestChanges}
                        </button>
                      )}
                      {canApprove && (
                        <button
                          class="editorial-mini-button"
                          type="button"
                          data-editorial-workflow-action="approve"
                          data-endpoint={`/api/editor/articles/${encodeURIComponent(item.sanityDocumentId)}/workflow`}
                          data-confirm={copy.approveConfirm}
                        >
                          {copy.approve}
                        </button>
                      )}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        )}
      </section>
    )}
  </CommunityLayout>
</BaseLayout>

<script define:vars={{ workflowUpdating: copy.workflowUpdating, workflowUpdated: copy.workflowUpdated, workflowGenericError: copy.workflowGenericError }}>
  const workflowStatus = document.querySelector('[data-editorial-workflow-status]');
  const workflowButtons = document.querySelectorAll('[data-editorial-workflow-action]');

  const setWorkflowStatus = (message, tone = '') => {
    if (!workflowStatus) return;

    workflowStatus.hidden = false;
    workflowStatus.textContent = message;
    if (tone) {
      workflowStatus.setAttribute('data-tone', tone);
    } else {
      workflowStatus.removeAttribute('data-tone');
    }
  };

  workflowButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const endpoint = button.getAttribute('data-endpoint') || '';
      const action = button.getAttribute('data-editorial-workflow-action') || '';
      const confirmMessage = button.getAttribute('data-confirm') || '';

      if (!endpoint || !action) return;
      if (confirmMessage && !window.confirm(confirmMessage)) return;

      const originalText = button.textContent || '';
      button.setAttribute('disabled', 'disabled');
      button.textContent = workflowUpdating;
      setWorkflowStatus(workflowUpdating);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify({ action }),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.error || 'workflow_failed');
        }

        setWorkflowStatus(workflowUpdated, 'success');
        window.location.reload();
      } catch {
        button.removeAttribute('disabled');
        button.textContent = originalText;
        setWorkflowStatus(workflowGenericError, 'error');
      }
    });
  });
</script>
