const dashboardHref = isEnglish ? '/en/account/editor/' : '/account/editor/';
const articlesHref = isEnglish ? '/en/account/editor/articles/' : '/account/editor/articles/';
const newArticleHref = isEnglish ? '/en/account/editor/articles/new/' : '/account/editor/articles/new/';
const languageSwitch = isEnglish
  ? `/account/editor/articles/${encodeURIComponent(id)}/`
  : `/en/account/editor/articles/${encodeURIComponent(id)}/`;
let article = null;
let error = '';

const toClientArticle = (value) => JSON.parse(JSON.stringify(value));
const getLoggableRootDocumentId = (value) => {
  const documentId = String(value || '').trim();

  if (
    documentId &&
    !documentId.startsWith('drafts.') &&
    /^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(documentId)
  ) {
    return documentId;
  }

  return '[invalid]';
};
const logEditPageFailure = ({
  rootDocumentId,
  failureCode,
  status,
}) => {
  console.error('Editorial article edit page load failed:', {
    context: 'editorial-article.edit-page',
    rootDocumentId: getLoggableRootDocumentId(rootDocumentId),
    failureCode,
    status,
  });
};

if (access.ok) {
  const result = await fetchEditableEditorialArticle({
    context: access.context,
    rootDocumentId: id,
  });

  if (result.ok && result.article) {
    article = toClientArticle(result.article);
  } else {
    error = 'draft_load_failed';
    logEditPageFailure({
      rootDocumentId: id,
      failureCode: result.error || 'article_missing',
      status: result.status || 500,
    });
  }
} else {
  error = 'draft_load_failed';
  logEditPageFailure({
    rootDocumentId: id,
    failureCode: access.error,
    status: access.status,
  });
}
---

<BaseLayout
  lang={currentLang}
  title={copy.pageTitle}
  description={copy.pageDescription}
  canonical={Astro.url.href}
  languageSwitch={languageSwitch}
  noindex={true}
>
  <div class="container editorial-area-page editorial-workspace-page editorial-edit-workspace-page">
    <CommunityHero
      kicker={copy.kicker}
      title={copy.title}
      description={copy.description}
    />

    {access.ok && (
      <nav class="editorial-edit-workspace-nav" aria-label={copy.kicker}>
        <a href={dashboardHref}>{copy.dashboard}</a>
        <a href={articlesHref}>{copy.articles}</a>
        <a href={newArticleHref}>{copy.newArticle}</a>
      </nav>
    )}

    {!article && (
      <section class="editorial-card editorial-card--notice">
        <p class="editorial-kicker">{copy.kicker}</p>
        <h2>{copy.deniedTitle}</h2>
        <p class="editorial-message" data-tone={error ? 'error' : undefined}>{copy.deniedDescription}</p>
      </section>
    )}

    {article && (
      <ArticlePortableTextEditor
        client:only="react"
        article={article}
        lang={currentLang}
        articlesHref={articlesHref}
        saveEndpoint={`/api/editor/articles/${encodeURIComponent(id)}`}
        labels={copy.labels}
      >
        <section slot="fallback" class="editorial-card editorial-card--notice" aria-live="polite">
          <p class="editorial-kicker">{copy.kicker}</p>
          <p>{copy.editorLoading}</p>
        </section>
      </ArticlePortableTextEditor>
    )}
  </div>
</BaseLayout>
