---
import '../../styles/pages/playable-classics.css';

import { toHTML } from '@portabletext/to-html';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { urlFor } from '../../lib/image';
import {
  getAllPosts,
  groupPosts,
  isPostPubliclyDistributed
} from '../../lib/posts';
import {
  getPlayableClassicUrl,
  type PlayableClassic,
  type PlayableClassicLang,
} from '../../lib/playable-classics';
import {
  getCompanyUrl,
  getEmulatorToolUrl,
  getPlatformUrl,
  getPostUrl,
} from '../../lib/routes';

const {
  classic,
  lang = 'it',
} = Astro.props as { classic: PlayableClassic; lang?: PlayableClassicLang };

const currentLang: PlayableClassicLang = lang === 'en' ? 'en' : 'it';
const isEn = currentLang === 'en';

const [allPosts] = await Promise.all([
  getAllPosts(),
]);

const groupedPosts = groupPosts(allPosts);
const headerReviews = isEn
  ? allPosts.filter((post) => post.type === 'review' && post.language === 'en')
  : groupedPosts.allReviews;
const headerNews = isEn
  ? allPosts.filter((post) => post.type === 'news' && post.language === 'en')
  : groupedPosts.allNews;

const copy = isEn
  ? {
      sectionTitle: 'Playable Classics',
      sectionHref: '/en/playable-classics/',
      policyHref: '/en/playable-classics/policy/',
      policyCta: 'Read the policy',
      canonicalBase: 'https://www.retro-gamers.it/en/playable-classics',
      languageSwitch: '/classici-giocabili-oggi/',
      defaultDescription: (title: string) =>
        `${title}: historical context, legal status and practical notes on Retro-Gamers.it.`,
      year: 'Release year',
      platforms: 'Platforms',
      developer: 'Developer',
      publisher: 'Publisher',
      genre: 'Genre',
      legalStatus: 'Legal status',
      distribution: 'Distribution',
      legalSource: 'Legal source',
      notesTitle: 'Legal notes',
      licenseNotes: 'License notes',
      redistributionNotes: 'Redistribution notes',
      downloadTitle: 'No internal download yet',
      downloadText:
        'This page is currently published as a guide and historical context. It does not include files downloadable from Retro-Gamers.it.',
      downloadFuture:
        'Future internal downloads will be reserved for registered users after editorial and legal review.',
      downloadReadyTitle: 'Available downloads',
      downloadPackagesText:
        'Choose the package that matches the platform you want to use. Each file is served through a temporary link reserved for registered users.',
      downloadButton: 'Download package',
      downloadPreparing: 'Preparing temporary download link...',
      downloadReady: 'Temporary link ready. The download will open in a new tab.',
      downloadGenericError: 'The download is not available right now. Please try again later.',
      downloadUnauthorized: 'Sign in to generate the temporary download link.',
      downloadForbidden: 'This page is not configured for internal downloads.',
      downloadNotFound: 'This downloadable page is no longer available.',
      downloadUnavailable: 'Download storage is not configured yet.',
      packageVersion: 'Version',
      packageSize: 'Size',
      checksum: 'SHA-256',
      packagePlatform: 'Platform',
      packageType: 'Type',
      packageLanguage: 'Language',
      packageNotes: 'Notes',
      loginCta: 'Go to your account',
      loginHref: '/en/account/',
      instructionsTitle: 'How to play today',
      recommendedToolsTitle: 'Recommended tools',
      recommendedForLabel: 'Recommended for',
      toolNotesLabel: 'Note',
      primaryTool: 'Primary',
      setupInstructions: 'Quick setup notes',
      technicalNotes: 'Technical notes',
      languageNotes: 'Language notes',
      relatedPosts: 'Related articles',
      relatedCreators: 'Related creators',
      readArticle: 'Read article',
      backToIndex: 'Back to Playable Classics',
      legalStatuses: {
        verifiedFreeware: 'Verified freeware',
        openSource: 'Open source',
        authorizedHomebrew: 'Authorized homebrew',
        redistributableDemo: 'Redistributable demo',
        redistributableShareware: 'Redistributable shareware',
        officialExternalReference: 'Official external reference',
        guideOnly: 'Guide only',
      },
      distributions: {
        internalDownload: 'Internal download',
        officialExternalReference: 'Official external reference',
        guideOnly: 'Guide only',
      },
      packageTypes: {
        game: 'Game',
        diskImages: 'Disk images',
        documentation: 'Documentation',
        patch: 'Patch',
        emulatorConfig: 'Emulator config',
        extras: 'Extras',
        other: 'Other',
      },
      toolTypes: {
        interpreter: 'Interpreter',
        emulator: 'Emulator',
        frontend: 'Frontend',
        utility: 'Utility',
        other: 'Other',
      },
    }
  : {
      sectionTitle: 'Classici giocabili oggi',
      sectionHref: '/classici-giocabili-oggi/',
      policyHref: '/classici-giocabili-oggi/policy/',
      policyCta: 'Leggi la policy',
      canonicalBase: 'https://www.retro-gamers.it/classici-giocabili-oggi',
      languageSwitch: '/en/playable-classics/',
      defaultDescription: (title: string) =>
        `${title}: contesto storico, stato legale e note pratiche su Retro-Gamers.it.`,
      year: 'Anno uscita',
      platforms: 'Piattaforme',
      developer: 'Sviluppatore',
      publisher: 'Publisher',
      genre: 'Genere',
      legalStatus: 'Stato legale',
      distribution: 'Distribuzione',
      legalSource: 'Fonte legale',
      notesTitle: 'Note legali',
      licenseNotes: 'Note licenza',
      redistributionNotes: 'Note redistribuzione',
      downloadTitle: 'Download interno non disponibile',
      downloadText:
        'Questa scheda è pubblicata come guida e contesto storico. Non contiene file scaricabili da Retro-Gamers.it.',
      downloadFuture:
        'I futuri download interni saranno riservati agli utenti registrati dopo verifica editoriale e legale.',
      downloadReadyTitle: 'Download disponibili',
      downloadPackagesText:
        'Scegli il pacchetto compatibile con la piattaforma che vuoi usare. Ogni file viene servito con un link temporaneo riservato agli utenti registrati.',
      downloadButton: 'Scarica il pacchetto',
      downloadPreparing: 'Preparazione del link temporaneo...',
      downloadReady: 'Link temporaneo pronto. Il download si aprirà in una nuova scheda.',
      downloadGenericError: 'Il download non è disponibile in questo momento. Riprova più tardi.',
      downloadUnauthorized: 'Accedi per generare il link temporaneo di download.',
      downloadForbidden: 'Questa scheda non è configurata per il download interno.',
      downloadNotFound: 'Questa scheda scaricabile non è più disponibile.',
      downloadUnavailable: 'Lo storage download non è ancora configurato.',
      packageVersion: 'Versione',
      packageSize: 'Dimensione',
      checksum: 'SHA-256',
      packagePlatform: 'Piattaforma',
      packageType: 'Tipo',
      packageLanguage: 'Lingua',
      packageNotes: 'Note',
      loginCta: 'Accedi al tuo account',
      loginHref: '/account/login/',
      instructionsTitle: 'Come giocarlo oggi',
      recommendedToolsTitle: 'Emulatori consigliati',
      recommendedForLabel: 'Consigliato per',
      toolNotesLabel: 'Nota',
      primaryTool: 'Principale',
      setupInstructions: 'Istruzioni rapide',
      technicalNotes: 'Note tecniche',
      languageNotes: 'Note lingua',
      relatedPosts: 'Articoli collegati',
      relatedCreators: 'Creator collegati',
      readArticle: 'Leggi articolo',
      backToIndex: 'Torna ai Classici giocabili oggi',
      legalStatuses: {
        verifiedFreeware: 'Freeware verificato',
        openSource: 'Open source',
        authorizedHomebrew: 'Homebrew autorizzato',
        redistributableDemo: 'Demo redistribuibile',
        redistributableShareware: 'Shareware redistribuibile',
        officialExternalReference: 'Riferimento esterno ufficiale',
        guideOnly: 'Solo guida',
      },
      distributions: {
        internalDownload: 'Download interno',
        officialExternalReference: 'Riferimento esterno ufficiale',
        guideOnly: 'Solo guida',
      },
      packageTypes: {
        game: 'Gioco',
        diskImages: 'Disk images',
        documentation: 'Documentazione',
        patch: 'Patch',
        emulatorConfig: 'Config emulatore',
        extras: 'Extra',
        other: 'Altro',
      },
      toolTypes: {
        interpreter: 'Interprete',
        emulator: 'Emulatore',
        frontend: 'Frontend',
        utility: 'Utility',
        other: 'Altro',
      },
    };

const canonicalUrl = `${copy.canonicalBase}/${classic.slug}/`;
const translatedVersion =
  classic.translatedVersion?.slug
    ? classic.translatedVersion
    : (classic.translatedVersions || []).find((version) =>
        version?.slug && version.language !== currentLang
      ) || null;
const translatedLanguage: PlayableClassicLang =
  translatedVersion?.language === 'it' || translatedVersion?.language === 'en'
    ? translatedVersion.language
    : currentLang === 'en'
      ? 'it'
      : 'en';
const translatedPath = translatedVersion
  ? getPlayableClassicUrl(translatedVersion, translatedLanguage)
  : '';
const translatedUrl = translatedPath ? `https://www.retro-gamers.it${translatedPath}` : '';
const languageSwitchUrl = translatedPath || copy.languageSwitch;
const xDefaultUrl =
  currentLang === 'it'
    ? canonicalUrl
    : translatedLanguage === 'it' && translatedUrl
      ? translatedUrl
      : canonicalUrl;
const alternateLanguages = [
  { lang: currentLang, url: canonicalUrl },
  ...(translatedUrl
    ? [
        { lang: translatedLanguage, url: translatedUrl },
        { lang: 'x-default', url: xDefaultUrl },
      ]
    : []),
];

const title = classic.seoTitle || classic.title;
const description =
  classic.metaDescription ||
  classic.excerpt ||
  classic.subtitle ||
  copy.defaultDescription(classic.title);
const coverUrl = classic.coverImage?.asset
  ? urlFor(classic.coverImage)
      .width(1280)
      .height(720)
      .fit('crop')
      .quality(78)
      .auto('format')
      .url()
  : '';

function escapeHTML(value = '') {
  return String(value).replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }[char] || char));
}

function getPortableImage(value: any) {
  if (!value?.asset) return '';

  const imageUrl = urlFor(value)
    .width(980)
    .quality(76)
    .auto('format')
    .url();

  const caption = value.caption
    ? `<figcaption>${escapeHTML(value.caption)}</figcaption>`
    : '';

  return `
    <figure>
      <img
        src="${escapeHTML(imageUrl)}"
        alt="${escapeHTML(value.alt || '')}"
        width="980"
        height="552"
        loading="lazy"
        decoding="async"
      />
      ${caption}
    </figure>
  `;
}

function renderPortableText(blocks: any[] = []) {
  if (!Array.isArray(blocks) || blocks.length === 0) return '';

  return toHTML(blocks, {
    components: {
      types: {
        image: ({ value }) => getPortableImage(value),
      },
      marks: {
        link: ({ children, value }) => {
          const href = value?.href || '#';
          const isMail = href.startsWith('mailto:');
          const rel = isMail ? '' : ' rel="noopener noreferrer"';
          const target = isMail ? '' : ' target="_blank"';

          return `<a href="${escapeHTML(href)}"${target}${rel}>${children}</a>`;
        },
      },
    },
  });
}

const bodyHtml = renderPortableText(classic.body);
const setupHtml = renderPortableText(classic.setupInstructions);

const getLabel = (map: Record<string, string>, value?: string) =>
  (value && map[value]) || value || '';

const getName = (item: any) =>
  isEn
    ? item?.nameEn || item?.name || item?.title || ''
    : item?.name || item?.title || item?.nameEn || '';
const getTaxonomySlug = (item: any) => {
  if (!item) return '';

  if (typeof item.slug === 'string') return item.slug;
  if (typeof item.slug?.current === 'string') return item.slug.current;

  return '';
};
const getArchiveFilterUrl = (key: string, value: string) => {
  if (!key || !value) return '';

  const baseUrl = currentLang === 'en' ? '/en/archive/' : '/archivio/';

  return `${baseUrl}?${key}=${encodeURIComponent(value)}`;
};

const legalStatusLabel = getLabel(copy.legalStatuses, classic.legalStatus);
const distributionLabel = getLabel(copy.distributions, classic.distributionType);
const hasInternalDownload =
  classic.downloadable === true &&
  classic.distributionType === 'internalDownload';
const getPackageTypeLabel = (type?: string) =>
  (type && copy.packageTypes[type]) || (type ? type.replace(/[-_]/g, ' ') : '');
const getToolTypeLabel = (type?: string) =>
  (type && copy.toolTypes[type]) || (type ? type.replace(/[-_]/g, ' ') : '');

const normalizeName = (value = '') => value.trim().toLowerCase();
const relationCompanies = classic.relatedCompanies || [];
const relationCreators = classic.relatedCreators || [];
const findCompanyByName = (value = '') => {
  const normalized = normalizeName(value);
  if (!normalized) return null;

  return relationCompanies.find((company) =>
    [company.name, company.nameEn, company.title]
      .filter(Boolean)
      .map((name) => normalizeName(String(name)))
      .includes(normalized)
  );
};
const getCompanyFactItems = (items: any[] = []) =>
  items.map((item) => {
    const label = getName(item);
    const company = findCompanyByName(label);

    return {
      label,
      href: company ? getCompanyUrl(company, currentLang) : '',
    };
  }).filter((item) => item.label);
const getPlatformFactItems = (items: any[] = []) =>
  items.map((item) => {
    const label = getName(item);
    const href = item?.slug && item?.manufacturer?.slug && item?.platformType
      ? getPlatformUrl(item, currentLang)
      : '';

    return { label, href };
  }).filter((item) => item.label);
const getGenreFactItems = (items: any[] = []) =>
  items.map((item) => {
    const label = getName(item);
    const slug = getTaxonomySlug(item);

    return {
      label,
      href: slug ? getArchiveFilterUrl('genre', slug) : '',
    };
  }).filter((item) => item.label);
const facts = [
  classic.originalYear && {
    label: copy.year,
    items: [{
      label: String(classic.originalYear),
      href: getArchiveFilterUrl('year', String(classic.originalYear)),
    }],
  },
  classic.originalPlatforms?.length && {
    label: copy.platforms,
    items: getPlatformFactItems(classic.originalPlatforms),
  },
  classic.developer?.length && {
    label: copy.developer,
    items: getCompanyFactItems(classic.developer),
  },
  classic.publisher?.length && {
    label: copy.publisher,
    items: getCompanyFactItems(classic.publisher),
  },
  classic.genre?.length && {
    label: copy.genre,
    items: getGenreFactItems(classic.genre),
  },
].filter((item) => item && item.items.length > 0) as Array<{
  label: string;
  items: Array<{ label: string; href?: string }>;
}>;

const recommendedToolSource = [...(classic.recommendedTools || [])]
  .filter((item) => item?.tool?.title)
  .sort((a, b) => Number(b.isPrimary === true) - Number(a.isPrimary === true));
const getRecommendedToolDocument = (tool: any) => {
  if (!tool) return null;

  if (tool.language === currentLang) {
    return tool;
  }

  if (tool.translatedVersion?.slug && tool.translatedVersion.language === currentLang) {
    return tool.translatedVersion;
  }

  return (tool.translatedVersions || []).find((version: any) =>
    version?.slug && version.language === currentLang
  ) || tool;
};
const recommendedToolItems = recommendedToolSource.map((item) => {
  const toolDocument = getRecommendedToolDocument(item.tool);
  const toolLanguage = toolDocument?.language || currentLang;

  return {
    ...item,
    title: toolDocument?.title || item.tool?.title || '',
    url: toolDocument?.slug ? getEmulatorToolUrl(toolDocument, toolLanguage) : '',
    typeLabel: getToolTypeLabel(toolDocument?.toolType || item.tool?.toolType),
  };
});

const noteItems = [
  classic.licenseNotes && { label: copy.licenseNotes, value: classic.licenseNotes },
  classic.redistributionNotes && { label: copy.redistributionNotes, value: classic.redistributionNotes },
].filter(Boolean) as Array<{ label: string; value: string }>;

const activeDownloadPackages = (classic.downloadPackages || [])
  .filter((downloadPackage) => downloadPackage?.packageId && downloadPackage.isActive !== false)
  .map((downloadPackage) => {
    const typeLabel = getPackageTypeLabel(downloadPackage.packageType);
    const platformLabel = downloadPackage.platform ? getName(downloadPackage.platform) : '';
    const platformSlug = getTaxonomySlug(downloadPackage.platform);
    const analyticsRequiresLogin = classic.requiresLogin === true || downloadPackage.requiresLogin === true;
    const languageLabel = downloadPackage.language
      ? String(downloadPackage.language).toUpperCase()
      : '';
    const metadata = [
      platformLabel && { label: copy.packagePlatform, value: platformLabel },
      typeLabel && { label: copy.packageType, value: typeLabel },
      languageLabel && { label: copy.packageLanguage, value: languageLabel },
      downloadPackage.packageVersion && { label: copy.packageVersion, value: downloadPackage.packageVersion },
      downloadPackage.packageSize && { label: copy.packageSize, value: downloadPackage.packageSize },
      downloadPackage.checksumSha256 && {
        label: copy.checksum,
        value: downloadPackage.checksumSha256,
        code: true,
      },
    ].filter(Boolean) as Array<{ label: string; value: string; code?: boolean }>;

    return {
      ...downloadPackage,
      endpoint: `/api/playable-classics/${classic.slug}/download/${encodeURIComponent(downloadPackage.packageId || '')}`,
      typeLabel,
      platformLabel,
      platformSlug,
      analyticsRequiresLogin,
      languageLabel,
      metadata,
    };
  });
const hasDownloadPackages = activeDownloadPackages.length > 0;
const relatedPostTypeLabels: Record<string, string> = isEn
  ? {
      article: 'Article',
      feature: 'Feature',
      guide: 'Guide',
      interview: 'Interview',
      news: 'News',
      review: 'Review',
      special: 'Feature',
    }
  : {
      article: 'Articolo',
      feature: 'Speciale',
      guide: 'Guida',
      interview: 'Intervista',
      news: 'News',
      review: 'Recensione',
      special: 'Speciale',
    };

const getRelatedPostTypeLabel = (type?: string) => {
  if (!type) return isEn ? 'Article' : 'Articolo';

  return relatedPostTypeLabels[type] || type.replace(/[-_]/g, ' ');
};

const getRelatedPostExcerpt = (post: any) =>
  post.cardExcerpt || post.excerpt || post.subtitle || '';

const getRelatedPostImage = (post: any) =>
  post.featuredImage?.asset
    ? urlFor(post.featuredImage)
        .width(168)
        .height(128)
        .fit('crop')
        .quality(74)
        .auto('format')
        .url()
    : '';

const getCreatorUrl = (creator: any) =>
  creator?.slug
    ? currentLang === 'en'
      ? `/en/creators/${creator.slug}/`
      : `/creatori/${creator.slug}/`
    : '';
const getCreatorRole = (creator: any) =>
  isEn
    ? creator?.roleEn || creator?.role || ''
    : creator?.role || creator?.roleEn || '';
const getCreatorImage = (creator: any) =>
  creator?.portrait?.asset
    ? urlFor(creator.portrait)
        .width(96)
        .height(96)
        .fit('crop')
        .quality(72)
        .auto('format')
        .url()
    : '';
const getCreatorInitials = (name = '') =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();

const isRelatedPostInCurrentLanguage = (post: any) =>
  isPostPubliclyDistributed(post) &&
  (isEn ? post?.language === 'en' : post?.language !== 'en');

const getLocalizedRelatedPost = (post: any) => {
  if (isRelatedPostInCurrentLanguage(post)) {
    return post;
  }

  if (isRelatedPostInCurrentLanguage(post?.translationOf)) {
    return post.translationOf;
  }

  return (post?.translatedVersions || []).find(isRelatedPostInCurrentLanguage) || null;
};

const uniqueRelatedPosts = (posts: any[] = []) => {
  const seen = new Set();

  return posts.filter((post) => {
    const key = post?._id || post?.slug;

    if (!key || seen.has(key)) {
      return false;
    }

    seen.add(key);
    return true;
  });
};

const localizedRelatedPosts = uniqueRelatedPosts(
  (classic.relatedPosts || [])
    .map(getLocalizedRelatedPost)
    .filter(Boolean)
    .filter((post) => post?.slug)
);

const relatedPostCards = localizedRelatedPosts.map((post) => ({
  ...post,
  excerpt: getRelatedPostExcerpt(post),
  imageUrl: getRelatedPostImage(post),
  typeLabel: getRelatedPostTypeLabel(post.type),
  url: getPostUrl(post),
}));
const downloadMessageAttrs = {
  preparing: copy.downloadPreparing,
  ready: copy.downloadReady,
  generic: copy.downloadGenericError,
  unauthorized: copy.downloadUnauthorized,
  forbidden: copy.downloadForbidden,
  notFound: copy.downloadNotFound,
  unavailable: copy.downloadUnavailable,
};
---

<BaseLayout
  reviews={headerReviews}
  news={headerNews}
  title={title}
  description={description}
  image={coverUrl || '/og-image.jpg'}
  canonical={canonicalUrl}
  lang={currentLang}
  languageSwitch={{ url: languageSwitchUrl }}
  alternateLanguages={alternateLanguages}
>
  <div class="playable-classics-page playable-classic-detail">
    <div class="container">
      <a class="playable-classic-back" href={copy.sectionHref}>{copy.backToIndex}</a>

      <section class="playable-classic-hero">
        <div class="playable-classic-hero__content">
          <span>{copy.sectionTitle}</span>
          <h1>{classic.title}</h1>
          {(classic.subtitle || classic.excerpt) && (
            <p>{classic.subtitle || classic.excerpt}</p>
          )}

          <div class="playable-classic-hero__chips">
            {legalStatusLabel && <span>{legalStatusLabel}</span>}
            {distributionLabel && <span>{distributionLabel}</span>}
            {classic.requiresLogin && <span>{isEn ? 'Registered users' : 'Utenti registrati'}</span>}
          </div>
        </div>
      </section>

      <div class="playable-classic-layout">
        <article class="playable-classic-main">
          {bodyHtml ? (
            <div class="playable-classic-richtext" set:html={bodyHtml} />
          ) : (
            <p class="playable-classic-empty-copy">{description}</p>
          )}

          {hasInternalDownload && hasDownloadPackages && (
            <section
              class="playable-classic-download playable-classic-download--ready playable-classic-download--main"
              data-playable-classic-download-group
            >
              <h2>{copy.downloadReadyTitle}</h2>
              <p>{copy.downloadPackagesText}</p>

              <div class="playable-classic-download-packages">
                {activeDownloadPackages.map((downloadPackage) => (
                  <article
                    class="playable-classic-download-package"
                    data-playable-classic-download
                    data-endpoint={downloadPackage.endpoint}
                    data-message-preparing={downloadMessageAttrs.preparing}
                    data-message-ready={downloadMessageAttrs.ready}
                    data-message-generic={downloadMessageAttrs.generic}
                    data-message-unauthorized={downloadMessageAttrs.unauthorized}
                    data-message-forbidden={downloadMessageAttrs.forbidden}
                    data-message-not-found={downloadMessageAttrs.notFound}
                    data-message-unavailable={downloadMessageAttrs.unavailable}
                    data-analytics-language={currentLang}
                    data-analytics-classic-slug={classic.slug}
                    data-analytics-package-type={downloadPackage.packageType}
                    data-analytics-platform-slug={downloadPackage.platformSlug}
                    data-analytics-requires-login={downloadPackage.analyticsRequiresLogin ? 'true' : 'false'}
                  >
                    <header class="playable-classic-download-package__header">
                      <div>
                        <h3>{downloadPackage.title}</h3>
                        <div class="playable-classic-download-package__meta">
                          {downloadPackage.platformLabel && <span>{downloadPackage.platformLabel}</span>}
                          {downloadPackage.typeLabel && <span>{downloadPackage.typeLabel}</span>}
                          {downloadPackage.languageLabel && <small>{downloadPackage.languageLabel}</small>}
                        </div>
                      </div>
                    </header>

                    {downloadPackage.metadata.length > 0 && (
                      <dl class="playable-classic-package">
                        {downloadPackage.metadata.map((item) => (
                          <>
                            <dt>{item.label}</dt>
                            <dd>{item.code ? <code>{item.value}</code> : item.value}</dd>
                          </>
                        ))}
                      </dl>
                    )}

                    {downloadPackage.notes && (
                      <p class="playable-classic-download-package__notes">
                        <strong>{copy.packageNotes}:</strong> {downloadPackage.notes}
                      </p>
                    )}

                    <div class="playable-classic-download__actions">
                      <button type="button" data-download-button>{copy.downloadButton}</button>
                      <a href={copy.loginHref} data-download-login hidden>{copy.loginCta}</a>
                    </div>

                    <p
                      class="playable-classic-download__status"
                      data-download-status
                      role="status"
                      aria-live="polite"
                      hidden
                    ></p>
                  </article>
                ))}
              </div>

              <div class="playable-classic-download__actions playable-classic-download__actions--policy">
                <a href={copy.policyHref}>{copy.policyCta}</a>
              </div>
            </section>
          )}

          {(setupHtml || classic.technicalNotes || classic.languageNotes) && (
            <section class="playable-classic-panel">
              <h2>{copy.instructionsTitle}</h2>

              {setupHtml && (
                <div class="playable-classic-richtext playable-classic-richtext--compact">
                  <h3>{copy.setupInstructions}</h3>
                  <div set:html={setupHtml} />
                </div>
              )}

              {classic.technicalNotes && (
                <p><strong>{copy.technicalNotes}:</strong> {classic.technicalNotes}</p>
              )}

              {classic.languageNotes && (
                <p><strong>{copy.languageNotes}:</strong> {classic.languageNotes}</p>
              )}
            </section>
          )}
        </article>

        <aside class="playable-classic-sidebar" aria-label={isEn ? 'Playable classic details' : 'Dettagli classico giocabile'}>
          {coverUrl && (
            <figure class="playable-classic-cover">
              <img
                src={coverUrl}
                alt={classic.coverImage?.alt || classic.title}
                width="1280"
                height="720"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
          )}

          <div class="playable-classic-sidebar__sticky">
          {facts.length > 0 && (
            <section class="playable-classic-facts">
              {facts.map((item) => (
                <div>
                  <span>{item.label}</span>
                  <strong>
                    {item.items.map((fact, index) => (
                      <>
                        {fact.href ? (
                          <a href={fact.href}>{fact.label}</a>
                        ) : (
                          <span>{fact.label}</span>
                        )}
                        {index < item.items.length - 1 && <span>, </span>}
                      </>
                    ))}
                  </strong>
                </div>
              ))}
            </section>
          )}

          {recommendedToolItems.length > 0 && (
            <section class="playable-classic-panel playable-classic-panel--sidebar">
              <h2>{copy.recommendedToolsTitle}</h2>
              <div class="playable-classic-tools">
                {recommendedToolItems.map((tool) => (
                  <article class:list={['playable-classic-tool', tool.isPrimary && 'playable-classic-tool--primary']}>
                    <header>
                      {tool.url ? (
                        <a class="playable-classic-tool__name" href={tool.url}>
                          {tool.title}
                        </a>
                      ) : (
                        <strong class="playable-classic-tool__name">{tool.title}</strong>
                      )}

                      {(tool.typeLabel || tool.isPrimary) && (
                        <span class="playable-classic-tool__badges">
                          {tool.typeLabel && <small>{tool.typeLabel}</small>}
                          {tool.isPrimary && <small>{copy.primaryTool}</small>}
                        </span>
                      )}
                    </header>

                    {tool.recommendedFor && (
                      <p class="playable-classic-tool__for"><strong>{copy.recommendedForLabel}:</strong> {tool.recommendedFor}</p>
                    )}

                    {tool.notes && <p><strong>{copy.toolNotesLabel}:</strong> {tool.notes}</p>}
                  </article>
                ))}
              </div>
            </section>
          )}

          {!hasInternalDownload && (
            <section class="playable-classic-download">
              <h2>{copy.downloadTitle}</h2>
              <p>{copy.downloadText}</p>
              {classic.requiresLogin && <p>{copy.downloadFuture}</p>}
              <div class="playable-classic-download__actions">
                <a href={copy.policyHref}>{copy.policyCta}</a>
              </div>
            </section>
          )}

          {relatedPostCards.length > 0 && (
            <section class="playable-classic-panel playable-classic-panel--sidebar">
              <h2>{copy.relatedPosts}</h2>

              <div class="playable-classic-related-posts">
                {relatedPostCards.map((post) => (
                  <a class="playable-classic-related-post" href={post.url}>
                    <span class="playable-classic-related-post__meta">
                      <span>{post.typeLabel}</span>
                      {post.language && <small>{post.language.toUpperCase()}</small>}
                    </span>

                    <span class={`playable-classic-related-post__content${post.imageUrl ? '' : ' playable-classic-related-post__content--text'}`}>
                      {post.imageUrl && (
                        <span class="playable-classic-related-post__media">
                          <img
                            src={post.imageUrl}
                            alt={post.featuredImage?.alt || post.title}
                            width="84"
                            height="64"
                            loading="lazy"
                            decoding="async"
                          />
                        </span>
                      )}
                      <strong>{post.title}</strong>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {relationCreators.length > 0 && (
            <section class="playable-classic-panel playable-classic-panel--sidebar">
              <h2>{copy.relatedCreators}</h2>
              <div class="playable-classic-creators">
                {relationCreators.map((creator) => {
                  const creatorUrl = getCreatorUrl(creator);
                  const portrait = getCreatorImage(creator);
                  const role = getCreatorRole(creator);
                  const CardTag = creatorUrl ? 'a' : 'div';

                  return (
                    <CardTag
                      class="playable-classic-creator-card"
                      href={creatorUrl || undefined}
                    >
                      <span class="playable-classic-creator-card__portrait">
                        {portrait ? (
                          <img
                            src={portrait}
                            alt={creator.portrait?.alt || creator.name}
                            width="48"
                            height="48"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span>{getCreatorInitials(creator.name) || 'RG'}</span>
                        )}
                      </span>

                      <span class="playable-classic-creator-card__body">
                        <strong>{creator.name}</strong>
                        {role && <small>{role}</small>}
                      </span>
                    </CardTag>
                  );
                })}
              </div>
            </section>
          )}

          {(noteItems.length > 0 || classic.legalSourceUrl) && (
            <section class="playable-classic-panel playable-classic-panel--sidebar">
              <h2>{copy.notesTitle}</h2>
              {noteItems.map((item) => (
                <div class="playable-classic-note">
                  <h3>{item.label}</h3>
                  <p>{item.value}</p>
                </div>
              ))}

              {classic.legalSourceUrl && (
                <div class="playable-classic-source">
                  <a class="playable-classic-source__pill" href={classic.legalSourceUrl} target="_blank" rel="noopener noreferrer">
                    {classic.legalSourceLabel ? `${copy.legalSource}: ${classic.legalSourceLabel}` : copy.legalSource}
                  </a>
                </div>
              )}
            </section>
          )}
          </div>
        </aside>
      </div>
    </div>
  </div>

  <script>
    import { trackRgEvent } from '../../lib/analytics/client';

    const downloadRoots = document.querySelectorAll('[data-playable-classic-download]');

    downloadRoots.forEach((downloadRoot) => {
      const button = downloadRoot.querySelector('[data-download-button]');
      const status = downloadRoot.querySelector('[data-download-status]');
      const loginLink = downloadRoot.querySelector('[data-download-login]');
      const endpoint = downloadRoot.getAttribute('data-endpoint') || '';
      const analyticsLanguage = downloadRoot.getAttribute('data-analytics-language') === 'en' ? 'en' : 'it';
      const analyticsClassicSlug = downloadRoot.getAttribute('data-analytics-classic-slug') || '';
      const analyticsPackageType = downloadRoot.getAttribute('data-analytics-package-type') || '';
      const analyticsPlatformSlug = downloadRoot.getAttribute('data-analytics-platform-slug') || '';
      const analyticsRequiresLogin = downloadRoot.getAttribute('data-analytics-requires-login');
      const messages = {
        preparing: downloadRoot.getAttribute('data-message-preparing') || '',
        ready: downloadRoot.getAttribute('data-message-ready') || '',
        generic: downloadRoot.getAttribute('data-message-generic') || '',
        unauthorized: downloadRoot.getAttribute('data-message-unauthorized') || '',
        forbidden: downloadRoot.getAttribute('data-message-forbidden') || '',
        notFound: downloadRoot.getAttribute('data-message-not-found') || '',
        unavailable: downloadRoot.getAttribute('data-message-unavailable') || '',
      };

      const setStatus = (message, tone = 'neutral') => {
        if (!status) return;
        status.textContent = message;
        status.hidden = false;
        status.dataset.tone = tone;
      };

      const getErrorMessage = (response, payload) => {
        if (response.status === 401) return messages.unauthorized;
        if (response.status === 404) return messages.notFound;
        if (response.status === 503) return messages.unavailable;
        if (response.status === 403) return messages.forbidden;
        return payload?.message || messages.generic;
      };

      button?.addEventListener('click', async () => {
        if (!endpoint) return;

        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        loginLink?.setAttribute('hidden', '');
        setStatus(messages.preparing, 'neutral');

        try {
          const response = await fetch(endpoint, {
            method: 'GET',
            credentials: 'same-origin',
            headers: {
              Accept: 'application/json',
            },
          });

          const payload = await response.json().catch(() => null);

          if (!response.ok || payload?.ok !== true || !payload?.url) {
            setStatus(getErrorMessage(response, payload), 'error');

            if (response.status === 401) {
              loginLink?.removeAttribute('hidden');
            }

            return;
          }

          setStatus(messages.ready, 'success');

          try {
            trackRgEvent('download_start', {
              language: analyticsLanguage,
              classic_slug: analyticsClassicSlug,
              ...(analyticsPackageType ? { package_type: analyticsPackageType } : {}),
              ...(analyticsPlatformSlug ? { platform_slug: analyticsPlatformSlug } : {}),
              ...(analyticsRequiresLogin === 'true' || analyticsRequiresLogin === 'false'
                ? { requires_login: analyticsRequiresLogin === 'true' }
                : {}),
            });
          } catch {
            // Analytics must never block the download flow.
          }

          const link = document.createElement('a');
          link.href = payload.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.click();
        } catch {
          setStatus(messages.generic, 'error');
        } finally {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      });
    });
  </script>
</BaseLayout>
