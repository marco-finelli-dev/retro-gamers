---
import Search from './Search.astro';
import ReviewsMenu from './ReviewsMenu.astro';
import NewsMenu from './NewsMenu.astro';
import PlatformsMenu from './PlatformsMenu.astro';
import MobileMenu from './MobileMenu.astro';
import '../../styles/components/header/header.css';

const { reviews = [], news = [] } = Astro.props;
---

<header class="site-header">

  <div class="site-header__inner">

    <!-- LOGO -->
    <a href="/" class="site-header__logo" aria-label="Vai alla home di Retro Gamers">
      <img
        src="/images/retro-gamer-header-logo.webp"
        alt="Retro Gamers"
        width="160"
        height="48"
      />
    </a>

    <!-- NAV DESKTOP -->
    <nav class="site-header__nav" aria-label="Navigazione principale">

      <!-- RECENSIONI -->
      <div class="site-header__nav-item has-dropdown">
<button
  type="button"
  class="site-header__nav-link site-header__nav-button"
  aria-haspopup="true"
>
  Recensioni
</button>

        <div class="site-header__dropdown">
          <ReviewsMenu posts={reviews} />
        </div>
      </div>

      <!-- NEWS -->
      <div class="site-header__nav-item has-dropdown">
   <button
  type="button"
  class="site-header__nav-link site-header__nav-button"
  aria-haspopup="true"
>
  News
</button>

        <div class="site-header__dropdown">
          <NewsMenu posts={news} />
        </div>
      </div>

      <a href="/speciali/" class="site-header__nav-link">
        Speciali
      </a>

      <a href="/guide/" class="site-header__nav-link">
        Guide
      </a>

      <a href="/memories/" class="site-header__nav-link">
        Memories
      </a>

     <div class="site-header__nav-item has-dropdown">
<button
  type="button"
  class="site-header__nav-link site-header__nav-button"
  aria-haspopup="true"
>
  Piattaforme
</button>

  <div class="site-header__dropdown">
    <PlatformsMenu />
  </div>
</div>

    </nav>

    <!-- ACTIONS -->
  <div class="site-header__actions">
  <Search />

  <button
    type="button"
    class="mobile-menu-toggle"
    aria-label="Apri menu"
    aria-controls="mobile-menu"
    aria-expanded="false"
    data-mobile-menu-toggle
  >
    <svg
      class="mobile-menu-toggle__icon mobile-menu-toggle__icon--open"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M4 7H20" />
      <path d="M4 12H20" />
      <path d="M4 17H20" />
    </svg>

    <svg
      class="mobile-menu-toggle__icon mobile-menu-toggle__icon--close"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M6 6L18 18" />
      <path d="M18 6L6 18" />
    </svg>
  </button>
</div>

  </div>

</header>

<MobileMenu />