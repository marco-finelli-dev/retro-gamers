---
import Search from './Search.astro';
import ReviewsMenu from './ReviewsMenu.astro';
import NewsMenu from './NewsMenu.astro';
import PlatformsMenu from './PlatformsMenu.astro';
import MobileMenu from './MobileMenu.astro';
import '../../styles/components/header/header.css';

const {
  reviews = [],
  news = [],
  lang = 'it',
  languageSwitch = null
} = Astro.props;

const isEnglish = lang === 'en';

const labels = isEnglish
  ? {
      home: 'Go to Retro Gamers home',
      navigation: 'Main navigation',
      reviews: 'Reviews',
      news: 'News',
      features: 'Features',
      guides: 'Guides',
      memories: 'Memories',
      community: 'Community',
      platforms: 'Platforms',
      openMenu: 'Open menu'
    }
  : {
      home: 'Vai alla home di Retro Gamers',
      navigation: 'Navigazione principale',
      reviews: 'Recensioni',
      news: 'News',
      features: 'Speciali',
      guides: 'Guide',
      memories: 'Memories',
      community: 'Community',
      platforms: 'Piattaforme',
      openMenu: 'Apri menu'
    };

const homeUrl = isEnglish ? '/en/' : '/';

const languageSwitchUrl =
  typeof languageSwitch === 'string'
    ? languageSwitch
    : languageSwitch?.url;

const languageUrl =
  languageSwitchUrl ||
  (isEnglish ? '/' : '/en/');

const languageLabel = isEnglish
  ? 'Passa alla versione italiana'
  : 'Switch to English version';

const flagSrc = isEnglish
  ? '/icons/flag-it.webp'
  : '/icons/flag-en.webp';

const flagAlt = isEnglish
  ? 'Italiano'
  : 'English';

const accountLoginHref = isEnglish ? '/en/account/login/' : '/account/login/';
const accountHref = isEnglish ? '/en/account/' : '/account/';
const accountFavoritesHref = isEnglish ? '/en/account/favorites/' : '/account/favorites/';
const accountMemoriesHref = isEnglish ? '/en/account/memories/' : '/account/memories/';
const accountMessagesHref = isEnglish ? '/en/account/messages/' : '/account/messages/';
const adminHref = isEnglish ? '/en/admin/' : '/admin/';
---

<header class="site-header">

  <div class="site-header__inner">

    <!-- LOGO -->
    <a href={homeUrl} class="site-header__logo" aria-label={labels.home}>
      <img
        src="/images/retro-gamer-header-logo.webp"
        alt="Retro Gamers"
        width="160"
        height="48"
      />
    </a>

    <!-- NAV DESKTOP -->
    <nav class="site-header__nav" aria-label={labels.navigation}>

      <!-- RECENSIONI / REVIEWS -->
      <div class="site-header__nav-item has-dropdown">
        <button
          type="button"
          class="site-header__nav-link site-header__nav-button"
          aria-haspopup="true"
        >
          {labels.reviews}
        </button>

        <div class="site-header__dropdown">
          <ReviewsMenu posts={reviews} lang={lang} />
        </div>
      </div>

      <!-- NEWS -->
      <div class="site-header__nav-item has-dropdown">
        <button
          type="button"
          class="site-header__nav-link site-header__nav-button"
          aria-haspopup="true"
        >
          {labels.news}
        </button>

        <div class="site-header__dropdown">
          <NewsMenu posts={news} lang={lang} />
        </div>
      </div>

      <a href={isEnglish ? '/en/features/' : '/speciali/'} class="site-header__nav-link">
        {labels.features}
      </a>

      <a href={isEnglish ? '/en/guides/' : '/guide/'} class="site-header__nav-link">
        {labels.guides}
      </a>

      <a href={isEnglish ? '/en/memories/' : '/memories/'} class="site-header__nav-link">
        {labels.memories}
      </a>

      <a href={isEnglish ? '/en/community/' : '/community/'} class="site-header__nav-link">
        {labels.community}
      </a>

      <div class="site-header__nav-item has-dropdown">
        <button
          type="button"
          class="site-header__nav-link site-header__nav-button"
          aria-haspopup="true"
        >
          {labels.platforms}
        </button>

        <div class="site-header__dropdown">
          <PlatformsMenu lang={lang} />
        </div>
      </div>

    </nav>

    <!-- ACTIONS -->
    <div class="site-header__actions">
        <button
          type="button"
          class="site-header__theme-toggle"
          data-theme-toggle
          aria-label="Cambia tema"
        >
          <span data-theme-icon aria-hidden="true">◐</span>
        </button>
            <a
        href={languageUrl}
        class="site-header__language-toggle"
        aria-label={languageLabel}
        title={languageLabel}
      >
        <img
          src={flagSrc}
          alt={flagAlt}
          width="22"
          height="22"
          loading="eager"
          decoding="async"
        />
      </a>

      <div class="site-header__account" data-account-menu data-lang={lang}>
        <button
          type="button"
          class="site-header__account-link"
          aria-label="Account"
          title="Account"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="site-account-menu"
          data-account-menu-toggle
        >
          <span
            class="site-header__account-avatar"
            data-account-avatar
            aria-hidden="true"
          ></span>

          <img
            class="site-header__account-icon"
            src="/icons/account-user.svg"
            alt=""
            width="22"
            height="22"
            aria-hidden="true"
            loading="eager"
            decoding="async"
          />

          <span class="site-header__account-notification" data-account-unread hidden></span>
        </button>

        <div
          id="site-account-menu"
          class="site-header__account-menu"
          role="menu"
          data-account-menu-panel
          hidden
        >
          <div class="site-header__account-group" data-account-guest>
            <a href={accountLoginHref} role="menuitem">
              {isEnglish ? 'Log in / Register' : 'Accedi / Registrati'}
            </a>
          </div>

          <div class="site-header__account-group" data-account-auth hidden>
            <a href={accountHref} role="menuitem">
              {isEnglish ? 'My account' : 'Il mio account'}
            </a>

            <a href={accountFavoritesHref} role="menuitem">
              {isEnglish ? 'Favorites' : 'Preferiti'}
            </a>

            <a href={accountMemoriesHref} role="menuitem">
              {isEnglish ? 'My memories' : 'Le mie memorie'}
            </a>

            <a href={accountMessagesHref} role="menuitem">
              <span>{isEnglish ? 'Messages' : 'Messaggi'}</span>
              <span class="site-header__account-unread" data-account-unread hidden></span>
            </a>

            <a href={accountHref} role="menuitem" data-account-public-profile hidden>
              {isEnglish ? 'Public profile' : 'Profilo pubblico'}
            </a>

            <a href={adminHref} role="menuitem" data-account-staff hidden>
              {isEnglish ? 'Editorial tools' : 'Area redazione'}
            </a>

            <button type="button" role="menuitem" data-account-logout>
              {isEnglish ? 'Sign out' : 'Esci'}
            </button>
          </div>
        </div>
      </div>

      <Search lang={lang} />

      <button
        type="button"
        class="mobile-menu-toggle"
        aria-label={labels.openMenu}
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <svg
          class="mobile-menu-toggle__icon mobile-menu-toggle__icon--open"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M4 7H20" />
          <path d="M4 12H20" />
          <path d="M4 17H20" />
        </svg>

        <svg
          class="mobile-menu-toggle__icon mobile-menu-toggle__icon--close"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M6 6L18 18" />
          <path d="M18 6L6 18" />
        </svg>
      </button>
    </div>

  </div>

</header>

<MobileMenu lang={lang} />

<script is:inline>
(() => {
  const root = document.querySelector('[data-account-menu]');
  const trigger = root?.querySelector('[data-account-menu-toggle]');
  const panel = root?.querySelector('[data-account-menu-panel]');
  const isEnglish = root?.dataset.lang === 'en';
  const staffRoles = new Set(['admin', 'moderator']);
  const unreadPollingIntervalMs = 55_000;
  let isAccountLoggedIn = false;
  let unreadPollingTimer = 0;
  let unreadRefreshInFlight = false;

  const getAccountName = (profile, user) =>
    profile?.display_name || profile?.username || user?.email || '';

  const getAccountInitial = (profile, user) => {
    const source = getAccountName(profile, user);
    const match = String(source || '').trim().match(/[A-Za-zÀ-ÖØ-öø-ÿ0-9]/);

    return (match?.[0] || '?').toUpperCase();
  };

  const getAccountAvatarUrl = (profile) =>
    String(profile?.avatar_url || profile?.avatarUrl || '').trim();

  const getPublicProfileUrl = (profile) => {
    const username = String(profile?.username || '').trim().toLowerCase();

    if (!/^[a-z0-9_-]{3,24}$/.test(username)) {
      return '';
    }

    return isEnglish
      ? `/en/users/${encodeURIComponent(username)}/`
      : `/utenti/${encodeURIComponent(username)}/`;
  };

  const setUnreadCount = (count = 0) => {
    const safeCount = Number.isFinite(Number(count)) ? Math.max(0, Number(count)) : 0;
    const label = safeCount > 99 ? '99+' : String(safeCount);

    root?.classList.toggle('has-unread', safeCount > 0);

    document.querySelectorAll('[data-account-unread]').forEach((node) => {
      node.textContent = safeCount > 0 ? label : '';
      node.hidden = safeCount <= 0;
    });
  };

  const stopUnreadPolling = () => {
    if (!unreadPollingTimer) return;
    window.clearTimeout(unreadPollingTimer);
    unreadPollingTimer = 0;
  };

  const scheduleUnreadPolling = () => {
    stopUnreadPolling();

    if (!isAccountLoggedIn || document.hidden) {
      return;
    }

    unreadPollingTimer = window.setTimeout(async () => {
      await refreshUnreadCount(isAccountLoggedIn);
      scheduleUnreadPolling();
    }, unreadPollingIntervalMs);
  };

  const refreshUnreadCount = async (isLoggedIn) => {
    if (!isLoggedIn) {
      setUnreadCount(0);
      stopUnreadPolling();
      return;
    }

    if (unreadRefreshInFlight) {
      return;
    }

    unreadRefreshInFlight = true;

    try {
      const response = await fetch('/api/account/messages/unread-count');
      const result = await response.json();

      setUnreadCount(result?.unreadCount || 0);
    } catch {
      setUnreadCount(0);
    } finally {
      unreadRefreshInFlight = false;
    }
  };

  const closeMenu = () => {
    if (!root || !trigger || !panel) return;
    root.classList.remove('is-open');
    panel.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
  };

  const openMenu = () => {
    if (!root || !trigger || !panel) return;
    root.classList.add('is-open');
    panel.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
  };

  const toggleMenu = () => {
    if (!panel || panel.hidden) {
      openMenu();
      return;
    }

    closeMenu();
  };

  const setAccountAvatar = (isLoggedIn, profile = null, user = null) => {
    const displayName = getAccountName(profile, user);
    const initial = isLoggedIn ? getAccountInitial(profile, user) : '';
    const publicProfileUrl = isLoggedIn ? getPublicProfileUrl(profile) : '';
    const avatarUrl = isLoggedIn ? getAccountAvatarUrl(profile) : '';

    root?.classList.toggle('has-avatar', Boolean(isLoggedIn && initial));
    root?.classList.toggle('has-real-avatar', Boolean(isLoggedIn && avatarUrl));

    document.querySelectorAll('[data-account-avatar]').forEach((node) => {
      node.textContent = initial;

      if (avatarUrl) {
        const img = document.createElement('img');
        img.src = avatarUrl;
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.addEventListener('error', () => {
          img.hidden = true;
        });
        node.appendChild(img);
      }
    });

    document.querySelectorAll('[data-mobile-account-name]').forEach((node) => {
      node.textContent = displayName || (isEnglish ? 'My account' : 'Il mio account');
    });

    document.querySelectorAll('[data-account-public-profile]').forEach((node) => {
      node.hidden = !publicProfileUrl;

      if (publicProfileUrl) {
        node.setAttribute('href', publicProfileUrl);
      }
    });
  };

  const setAccountState = (isLoggedIn, isStaff = false, profile = null, user = null) => {
    isAccountLoggedIn = Boolean(isLoggedIn);
    root?.classList.toggle('is-authenticated', isLoggedIn);
    root?.classList.toggle('is-staff', isLoggedIn && isStaff);
    setAccountAvatar(isLoggedIn, profile, user);

    const accountLabel = isLoggedIn
      ? (isStaff
          ? (isEnglish ? 'Staff account' : 'Account staff')
          : (isEnglish ? 'User account' : 'Account utente'))
      : 'Account';

    trigger?.setAttribute('aria-label', accountLabel);
    trigger?.setAttribute('title', accountLabel);

    document.querySelectorAll('[data-account-guest]').forEach((node) => {
      node.hidden = isLoggedIn;
    });

    document.querySelectorAll('[data-account-auth]').forEach((node) => {
      node.hidden = !isLoggedIn;
    });

    document.querySelectorAll('[data-account-staff]').forEach((node) => {
      node.hidden = !isStaff;
    });

    document.querySelectorAll('[data-mobile-account-guest]').forEach((node) => {
      node.hidden = isLoggedIn;
    });

    document.querySelectorAll('[data-mobile-account-auth]').forEach((node) => {
      node.hidden = !isLoggedIn;
    });
  };

  const refreshAccountState = async () => {
    try {
      const response = await fetch('/api/auth/me');
      const result = await response.json();
      const role = result?.profile?.role;

      if (!response.ok || !result.ok || !result.profile) {
        setAccountState(false);
        refreshUnreadCount(false);
        return;
      }

      setAccountState(
        true,
        staffRoles.has(role),
        result.profile,
        result.user
      );
      refreshUnreadCount(true).then(scheduleUnreadPolling);
    } catch {
      setAccountState(false);
      refreshUnreadCount(false);
    }
  };

  const logout = async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
    } finally {
      window.location.href = isEnglish ? '/en/account/login/' : '/account/login/';
    }
  };

  trigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    toggleMenu();
  });

  panel?.addEventListener('click', (event) => {
    event.stopPropagation();
  });

  document.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
    }
  });

  document.querySelectorAll('[data-account-logout]').forEach((button) => {
    button.addEventListener('click', logout);
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopUnreadPolling();
      return;
    }

    if (isAccountLoggedIn) {
      refreshUnreadCount(true).then(scheduleUnreadPolling);
    }
  });

  window.addEventListener('focus', () => {
    if (isAccountLoggedIn) {
      refreshUnreadCount(true).then(scheduleUnreadPolling);
    }
  });

  window.addEventListener('retro-gamers:refresh-unread', () => {
    if (isAccountLoggedIn) {
      refreshUnreadCount(true).then(scheduleUnreadPolling);
    }
  });

  refreshAccountState();
})();
</script>
