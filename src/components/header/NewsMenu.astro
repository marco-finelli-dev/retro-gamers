---
import '../../styles/components/header/dropdown.css';
import { getPostUrl } from '../../lib/routes';
import { urlFor } from '../../lib/image';

const { posts = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const labels = {
  more: isEn ? 'View all news' : 'Vedi tutte le news'
};

const archiveHref = isEn ? '/en/news/' : '/news/';

const finalPosts = posts
  .filter((post) => {
    const postLang = post.language || 'it';
    return postLang === lang;
  })
  .slice(0, 5);

const getImage = (post) => {
  if (!post?.featuredImage?.asset) return '';

  return urlFor(post.featuredImage)
    .width(180)
    .height(120)
    .fit('crop')
    .quality(70)
    .auto('format')
    .url();
};

const getCategory = (post) => {
  const category = post.categories?.[0];

  if (!category) return post.type || '';

  return isEn
    ? category.nameEn || category.name || ''
    : category.name || category.nameEn || '';
};
---

<div class="rg-dropdown rg-dropdown--news">

  <div class="rg-dropdown__panel">

    {finalPosts.map((post) => {
      const image = getImage(post);
      const category = getCategory(post);

      return (
        <a href={getPostUrl(post)} class="rg-dropdown__item rg-dropdown__item--news">

          <div class="rg-dropdown__thumb">
            {image && (
              <img
                src={image}
                alt={post.title || ''}
                width="180"
                height="120"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>

          <div class="rg-dropdown__content">

            {category && (
              <div class="rg-dropdown__meta">
                {category}
              </div>
            )}

            <div class="rg-dropdown__title">
              {post.title}
            </div>

          </div>

        </a>
      );
    })}

    <a href={archiveHref} class="rg-dropdown__more">
      {labels.more} <span>→</span>
    </a>

  </div>

</div>