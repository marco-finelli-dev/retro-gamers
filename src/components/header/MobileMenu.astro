---
import { getArchiveUrl, getCompanyUrl, getCreatorUrl, getPlatformIndexUrl } from '../../lib/routes.js';
import { getLocalizedLanguageUrl } from '../../lib/language-switch.js';
import { getOpenCommunitySurveyForLanguage, getCommunitySurveyUrl } from '../../lib/community-surveys';
const { lang = 'it', languageSwitch = null } = Astro.props;
const isEnglish = lang === 'en';
const homeHref = isEnglish ? '/en/' : '/';
const communityHref = `${homeHref}community/`;
const survey = await getOpenCommunitySurveyForLanguage(lang);
const surveyHref = survey ? getCommunitySurveyUrl(survey, lang) : communityHref;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href) => {
  const path = new URL(href, Astro.url).pathname.replace(/\/+$/, '') || '/';
  return currentPath === path || (!href.includes('#') && path !== '/' && currentPath.startsWith(`${path}/`));
};
const languageHref = typeof languageSwitch === 'string' ? languageSwitch : languageSwitch?.url || (isEnglish ? '/' : '/en/');
const languageLabel = isEnglish ? 'Switch to Italian' : 'Passa alla versione inglese';
const groups = [
  {
    label: 'MAGAZINE',
    links: [
      { label: isEnglish ? 'Reviews' : 'Recensioni', href: getArchiveUrl('review', lang) },
      { label: 'News', href: getArchiveUrl('news', lang) },
      { label: isEnglish ? 'Features' : 'Speciali', href: getArchiveUrl('feature', lang) },
      { label: isEnglish ? 'Interviews' : 'Interviste', href: getArchiveUrl('interview', lang) },
      { label: isEnglish ? 'Guides' : 'Guide', href: getArchiveUrl('guide', lang) },
      { label: isEnglish ? 'Authors' : 'Autori', href: getLocalizedLanguageUrl({ currentUrl: '/autori/', targetLang: lang }) }
    ]
  },
  {
    label: isEnglish ? 'ARCHIVE' : 'ARCHIVIO',
    links: [
      { label: isEnglish ? 'Platforms' : 'Piattaforme', href: getPlatformIndexUrl(lang) },
      { label: 'Creator', href: getCreatorUrl(null, lang) },
      { label: isEnglish ? 'Companies' : 'Aziende', href: getCompanyUrl(null, lang) }
    ]
  },
  {
    label: 'COMMUNITY',
    links: [
      { label: 'Quiz', href: `${homeHref}quiz/` },
      { label: isEnglish ? 'Surveys' : 'Sondaggi', href: surveyHref }
    ]
  }
];

const themes = [{ value: 'system', label: 'Auto' }, { value: 'light', label: isEnglish ? 'Light' : 'Chiaro' }, { value: 'dark', label: isEnglish ? 'Dark' : 'Scuro' }];
---
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label={isEnglish ? 'Site menu' : 'Menu del sito'} aria-hidden="true" inert data-mobile-menu>
  <div class="mobile-menu__backdrop" data-mobile-menu-close></div>
  <div class="mobile-menu__panel">
    <div class="mobile-menu__header">
      <span>Menu</span>
      <button type="button" class="mobile-menu__close" aria-label={isEnglish ? 'Close menu' : 'Chiudi menu'} data-mobile-menu-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="mobile-menu__preferences">
      <a class="mobile-menu__language" href={languageHref} aria-label={languageLabel} title={languageLabel}
        data-language-session-override={isEnglish ? 'it' : 'en'} data-rg-language-switch data-rg-language-switch-from={lang}
        data-rg-language-switch-to={isEnglish ? 'it' : 'en'} data-rg-language-switch-placement="header">
        <img src={isEnglish ? '/icons/flag-it.webp' : '/icons/flag-en.webp'} width="24" height="24" alt="" />
        <span>{isEnglish ? 'IT' : 'EN'}</span>
      </a>
      <div class="mobile-menu__themes" role="group" aria-label={isEnglish ? 'Theme' : 'Tema'}>
        {themes.map(theme => <button type="button" data-theme-choice={theme.value} aria-pressed="false" aria-label={theme.label} title={theme.label}>
          <span class="mobile-menu__theme-icon" aria-hidden="true" style={`--mobile-theme-icon: url('/icons/rails/${theme.value === 'system' ? 'light-dark' : theme.value === 'light' ? 'sun' : 'moon'}.svg')`}></span>
        </button>)}
      </div>
    </div>
    <nav aria-label={isEnglish ? 'Site navigation' : 'Navigazione del sito'}>
      {groups.map((group, index) => <section class="mobile-menu__section" aria-labelledby={`mobile-group-${index}`}>
        <h2 id={`mobile-group-${index}`}>{group.label}</h2>
        <div class="mobile-menu__links">{group.links.map(item => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}</div>
      </section>)}
    </nav>

  </div>
</div>
