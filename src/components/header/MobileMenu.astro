---
const { lang = 'it' } = Astro.props;

const isEnglish = lang === 'en';

const ui = isEnglish
  ? {
      aria: 'Mobile menu',
      menu: 'Menu',
      close: 'Close menu',
      discover: 'Discover',
      platforms: 'Platforms'
    }
  : {
      aria: 'Menu mobile',
      menu: 'Menu',
      close: 'Chiudi menu',
      discover: 'Scopri',
      platforms: 'Piattaforme'
    };

const mainLinks = isEnglish
  ? [
      { label: 'Reviews', href: '/en/reviews/' },
      { label: 'News', href: '/en/news/' },
      { label: 'Features', href: '/en/features/' },
      { label: 'Guides', href: '/en/guides/' },
      { label: 'Memories', href: '/en/memories/' },
      { label: 'Interviews', href: '/en/interviews/' },
      { label: 'Hardware', href: '/en/hardware/' }
    ]
  : [
      { label: 'Recensioni', href: '/recensioni/' },
      { label: 'News', href: '/news/' },
      { label: 'Speciali', href: '/speciali/' },
      { label: 'Guide', href: '/guide/' },
      { label: 'Memories', href: '/memories/' },
      { label: 'Interviste', href: '/interviste/' },
      { label: 'Hardware', href: '/hardware/' }
    ];

const platformLinks = isEnglish
  ? [
      { label: 'All platforms', href: '/en/platforms/' },
      { label: 'Consoles', href: '/en/platforms/consoles/' },
      { label: 'Computers', href: '/en/platforms/computers/' },
      { label: 'Arcade', href: '/en/platforms/arcade/' }
    ]
  : [
      { label: 'Tutte le piattaforme', href: '/piattaforme/' },
      { label: 'Console', href: '/piattaforme/console/' },
      { label: 'Computer', href: '/piattaforme/computer/' },
      { label: 'Arcade', href: '/piattaforme/arcade/' }
    ];

const accountLabels = isEnglish
  ? {
      title: 'Account',
      signIn: 'Sign in',
      register: 'Register',
      account: 'My account',
      memories: 'My memories',
      moderation: 'Comment moderation',
      users: 'Users management',
      signOut: 'Sign out'
    }
  : {
      title: 'Account',
      signIn: 'Accedi',
      register: 'Registrati',
      account: 'Il mio account',
      memories: 'Le mie memorie',
      moderation: 'Moderazione commenti',
      users: 'Gestione utenti',
      signOut: 'Esci'
    };
---

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
  <div class="mobile-menu__backdrop" data-mobile-menu-close></div>

  <nav class="mobile-menu__panel" aria-label={ui.aria}>

    <div class="mobile-menu__header">
      <span>{ui.menu}</span>

      <button
        type="button"
        class="mobile-menu__close"
        aria-label={ui.close}
        data-mobile-menu-close
      >
        ×
      </button>
    </div>

    <div class="mobile-menu__section" data-mobile-account-menu>
      <span>{accountLabels.title}</span>

      <div class="mobile-menu__links">
        <div data-account-guest data-mobile-account-guest>
          <a href="/account/login/">{accountLabels.signIn}</a>
          <a href="/account/register/">{accountLabels.register}</a>
        </div>

        <div data-account-auth data-mobile-account-auth hidden>
          <a href="/account/">{accountLabels.account}</a>
          <a href="/account/#memories">{accountLabels.memories}</a>
          <a href="/admin/comments/" data-account-staff hidden>{accountLabels.moderation}</a>
          <a href="/admin/users/" data-account-staff hidden>{accountLabels.users}</a>
          <button type="button" data-account-logout>{accountLabels.signOut}</button>
        </div>
      </div>
    </div>

    <div class="mobile-menu__section">
      <span>{ui.discover}</span>

      <div class="mobile-menu__links">
        {mainLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>

    <div class="mobile-menu__section">
      <span>{ui.platforms}</span>

      <div class="mobile-menu__links">
        {platformLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>

  </nav>
</div>
