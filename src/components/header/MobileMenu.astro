---
import {
  getArchiveUrl,
  getPlatformIndexUrl,
  getPlatformTypeUrl
} from '../../lib/routes.js';

const { lang = 'it' } = Astro.props;

const isEnglish = lang === 'en';

const archiveHrefs = {
  reviews: getArchiveUrl('review', lang),
  news: getArchiveUrl('news', lang),
  features: getArchiveUrl('feature', lang),
  guides: getArchiveUrl('guide', lang),
  memories: getArchiveUrl('memories', lang)
};

const platformHrefs = {
  index: getPlatformIndexUrl(lang),
  console: getPlatformTypeUrl('console', lang),
  computer: getPlatformTypeUrl('computer', lang),
  arcade: getPlatformTypeUrl('arcade', lang)
};

const ui = isEnglish
  ? {
      aria: 'Mobile menu',
      menu: 'Menu',
      close: 'Close menu',
      discover: 'Discover',
      platforms: 'Platforms'
    }
  : {
      aria: 'Menu mobile',
      menu: 'Menu',
      close: 'Chiudi menu',
      discover: 'Scopri',
      platforms: 'Piattaforme'
    };

const mainLinks = isEnglish
  ? [
      { label: 'Reviews', href: archiveHrefs.reviews },
      { label: 'News', href: archiveHrefs.news },
      { label: 'Features', href: archiveHrefs.features },
      { label: 'Guides', href: archiveHrefs.guides },
      { label: 'Playable Classics', href: '/en/playable-classics/' },
      { label: 'Emulators', href: '/en/emulators/' },
      { label: 'Memories', href: archiveHrefs.memories },
      { label: 'Interviews', href: '/en/interviews/' },
      { label: 'Hardware', href: '/en/hardware/' }
    ]
  : [
      { label: 'Recensioni', href: archiveHrefs.reviews },
      { label: 'News', href: archiveHrefs.news },
      { label: 'Speciali', href: archiveHrefs.features },
      { label: 'Guide', href: archiveHrefs.guides },
      { label: 'Classici giocabili oggi', href: '/classici-giocabili-oggi/' },
      { label: 'Emulatori e interpreti', href: '/emulatori/' },
      { label: 'Memories', href: archiveHrefs.memories },
      { label: 'Interviste', href: '/interviste/' },
      { label: 'Hardware', href: '/hardware/' }
    ];

const platformLinks = isEnglish
  ? [
      { label: 'All platforms', href: platformHrefs.index },
      { label: 'Consoles', href: platformHrefs.console },
      { label: 'Computers', href: platformHrefs.computer },
      { label: 'Arcade', href: platformHrefs.arcade }
    ]
  : [
      { label: 'Tutte le piattaforme', href: platformHrefs.index },
      { label: 'Console', href: platformHrefs.console },
      { label: 'Computer', href: platformHrefs.computer },
      { label: 'Arcade', href: platformHrefs.arcade }
    ];

const accountLabels = isEnglish
  ? {
      title: 'Account',
      signIn: 'Log in / Register',
      account: 'My account',
      favorites: 'Favorites',
      memories: 'My memories',
      messages: 'Messages',
      editorialTools: 'Editorial area',
      administrationArea: 'Administration area',
      moderationArea: 'Moderation area',
      signOut: 'Sign out'
    }
  : {
      title: 'Account',
      signIn: 'Accedi / Registrati',
      account: 'Il mio account',
      favorites: 'Preferiti',
      memories: 'Le mie memorie',
      messages: 'Messaggi',
      editorialTools: 'Area redazione',
      administrationArea: 'Area amministrazione',
      moderationArea: 'Area moderazione',
      signOut: 'Esci'
    };

const accountLoginHref = isEnglish ? '/en/account/login/' : '/account/login/';
const accountHref = isEnglish ? '/en/account/' : '/account/';
const accountFavoritesHref = isEnglish ? '/en/account/favorites/' : '/account/favorites/';
const accountMemoriesHref = isEnglish ? '/en/account/memories/' : '/account/memories/';
const accountMessagesHref = isEnglish ? '/en/account/messages/' : '/account/messages/';
const accountEditorHref = isEnglish ? '/en/account/editor/' : '/account/editor/';
const accountAdminHref = isEnglish ? '/en/admin/' : '/admin/';
const accountModerationHref = isEnglish ? '/en/admin/comments/' : '/admin/comments/';
const currentLanguageTarget = isEnglish ? 'en' : 'it';
---

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert data-mobile-menu>
  <div class="mobile-menu__backdrop" data-mobile-menu-close></div>

  <nav class="mobile-menu__panel" aria-label={ui.aria}>

    <div class="mobile-menu__header">
      <span>{ui.menu}</span>

      <button
        type="button"
        class="mobile-menu__close"
        aria-label={ui.close}
        data-mobile-menu-close
      >
        ×
      </button>
    </div>

    <div class="mobile-menu__section" data-mobile-account-menu>
      <span>{accountLabels.title}</span>

      <div class="mobile-menu__links">
        <div data-account-guest data-mobile-account-guest>
          <a href={accountLoginHref}>{accountLabels.signIn}</a>
        </div>

        <div data-account-auth data-mobile-account-auth hidden>
          <div class="mobile-menu__account-summary">
            <span
              class="mobile-menu__account-avatar"
              data-account-avatar
              aria-hidden="true"
            ></span>

            <span data-mobile-account-name>{accountLabels.account}</span>
          </div>

          <a href={accountHref}>{accountLabels.account}</a>
          <a href={accountFavoritesHref}>{accountLabels.favorites}</a>
          <a href={accountMemoriesHref}>{accountLabels.memories}</a>
          <a href={accountMessagesHref}>
            <span>{accountLabels.messages}</span>
            <span class="mobile-menu__account-unread" data-account-unread hidden></span>
          </a>
          <a href={accountHref} data-account-public-profile hidden>
            {isEnglish ? 'Public profile' : 'Profilo pubblico'}
          </a>

          <a
            href={accountEditorHref}
            data-account-editorial-area
            data-language-session-override={currentLanguageTarget}
            hidden
          >
            {accountLabels.editorialTools}
          </a>

          <a
            href={accountAdminHref}
            data-account-admin-area
            data-language-session-override={currentLanguageTarget}
            hidden
          >
            {accountLabels.administrationArea}
          </a>

          <a
            href={accountModerationHref}
            data-account-moderation-area
            data-language-session-override={currentLanguageTarget}
            hidden
          >
            {accountLabels.moderationArea}
          </a>

          <button type="button" data-account-logout>{accountLabels.signOut}</button>
        </div>
      </div>
    </div>

    <div class="mobile-menu__section">
      <span>{ui.discover}</span>

      <div class="mobile-menu__links">
        {mainLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>

    <div class="mobile-menu__section">
      <span>{ui.platforms}</span>

      <div class="mobile-menu__links">
        {platformLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>

  </nav>
</div>
