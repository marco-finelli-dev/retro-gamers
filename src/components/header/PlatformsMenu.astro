---
import '../../styles/components/header/dropdown.css';

const { lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const items = isEn
  ? [
      {
        title: 'Consoles',
        label: 'Home systems',
        href: '/en/platforms/consoles/',
        icon: '/images/icons/console-icon.png',
        iconWidth: 80,
        iconHeight: 38
      },
      {
        title: 'Computers',
        label: 'Home computers',
        href: '/en/platforms/computers/',
        icon: '/images/icons/computer-icon.png',
        iconWidth: 77,
        iconHeight: 80
      },
      {
        title: 'Arcade',
        label: 'Cabinets and boards',
        href: '/en/platforms/arcade/',
        icon: '/images/icons/arcade-icon.png',
        iconWidth: 67,
        iconHeight: 80
      }
    ]
  : [
      {
        title: 'Console',
        label: 'Sistemi da salotto',
        href: '/piattaforme/console/',
        icon: '/images/icons/console-icon.png',
        iconWidth: 80,
        iconHeight: 38
      },
      {
        title: 'Computer',
        label: 'Home computer',
        href: '/piattaforme/computer/',
        icon: '/images/icons/computer-icon.png',
        iconWidth: 77,
        iconHeight: 80
      },
      {
        title: 'Arcade',
        label: 'Cabinet e board',
        href: '/piattaforme/arcade/',
        icon: '/images/icons/arcade-icon.png',
        iconWidth: 67,
        iconHeight: 80
      }
    ];

const moreHref = isEn ? '/en/platforms/' : '/piattaforme/';
const moreLabel = isEn ? 'All platforms' : 'Tutte le piattaforme';
const resourceLinks = isEn
  ? [
      { label: 'Playable Classics', href: '/en/playable-classics/' },
      { label: 'Emulators', href: '/en/emulators/' }
    ]
  : [
      { label: 'Classici giocabili oggi', href: '/classici-giocabili-oggi/' },
      { label: 'Emulatori e interpreti', href: '/emulatori/' }
    ];
---

<div class="rg-dropdown rg-dropdown--platforms">

  <div class="rg-dropdown__panel rg-dropdown__panel--platforms">

    <div class="rg-platforms-grid">

      {items.map((item) => (
        <a href={item.href} class="rg-platform-link">

          <span class="rg-platform-link__icon" aria-hidden="true">
            <img
              src={item.icon}
              alt=""
              width={item.iconWidth}
              height={item.iconHeight}
              loading="lazy"
            />
          </span>

          <span class="rg-platform-link__text">
            <strong>{item.title}</strong>
            <small>{item.label}</small>
          </span>

        </a>
      ))}

    </div>

    {resourceLinks.map((item) => (
      <a href={item.href} class="rg-dropdown__more">
        {item.label} <span>→</span>
      </a>
    ))}

    <a href={moreHref} class="rg-dropdown__more">
      {moreLabel} <span>→</span>
    </a>

  </div>

</div>
