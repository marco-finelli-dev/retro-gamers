---
import '../../styles/components/header/search.css';

const { lang = 'it' } = Astro.props;

const isEn = lang === 'en';
const placeholder = isEn ? 'Search the site...' : 'Cerca nel sito...';
const inputLabel = isEn ? 'Search the site' : 'Cerca nel sito';
const openLabel = isEn ? 'Open search' : 'Apri ricerca';
const closeLabel = isEn ? 'Close search' : 'Chiudi ricerca';
---

<div class="search-wrapper" data-lang={lang}>

  <button
    type="button"
    class="search-toggle"
    aria-label={openLabel}
    aria-controls="site-search-dialog"
    aria-expanded="false"
    data-open-label={openLabel}
    data-close-label={closeLabel}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="white" stroke-width="2" fill="none"/>
      <line x1="16" y1="16" x2="21" y2="21" stroke="white" stroke-width="2"/>
    </svg>
  </button>

  <div
    id="site-search-dialog"
    class="search-bar"
    role="dialog"
    aria-modal="true"
    aria-label={isEn ? 'Site search' : 'Ricerca nel sito'}
    aria-hidden="true"
    inert
    hidden
  >
    <label class="sr-only" for="site-search-input">{inputLabel}</label>
    <input id="site-search-input" type="text" placeholder={placeholder} />

    <div class="search-results">
      <div class="hover-bg"></div>
    </div>

    <button
      type="button"
      class="search-close"
      aria-label={closeLabel}
    >
      ✕
    </button>
  </div>

</div>

<div class="search-overlay" aria-hidden="true" hidden></div>

<script is:inline>
(() => {

  /* ========================
     HELPERS
  ======================== */

  function normalize(str = '') {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function scoreItem(item, query) {
    const q = normalize(query);

    const title = normalize(item.title || '');
    const extra = normalize(item.searchableText || '');

    if (title === q) return 100;
    if (title.startsWith(q)) return 90;
    if (title.includes(q)) return 75;
    if (extra.includes(q)) return 50;

    return 0;
  }

  function escapeHTML(str = '') {
    return str.replace(/[&<>"']/g, m => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[m]));
  }

  function highlight(text, query) {
    const safe = escapeHTML(text);
    const q = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    return safe.replace(
      new RegExp(`(${q})`, 'gi'),
      '<span class="highlight">$1</span>'
    );
  }

  function optimizeImageUrl(url = '', width = 180, height = 120) {
    if (!url) return '';

    const separator = url.includes('?') ? '&' : '?';

    return `${url}${separator}w=${width}&h=${height}&fit=crop&auto=format&q=70`;
  }

  /* ========================
     ELEMENTS
  ======================== */

  const wrapper = document.querySelector('.search-wrapper');
  if (!wrapper) return;

  const currentLang = wrapper.dataset.lang || 'it';
  const isEn = currentLang === 'en';

  const toggle = wrapper.querySelector('.search-toggle');
  const bar = wrapper.querySelector('.search-bar');
  const closeBtn = wrapper.querySelector('.search-close');
  const input = wrapper.querySelector('input');
  const results = wrapper.querySelector('.search-results');
  const overlay = document.querySelector('.search-overlay');

  let debounce;
  let cache = null;
  let isOpen = false;
  let closeTimer;
  let lastFocusedElement = null;

  /* ========================
     LABELS / ROUTES
  ======================== */

  const articleLabels = isEn
    ? {
        review: 'Review',
        article: 'Article',
        guide: 'Guide',
        interview: 'Interview',
        news: 'News',
        feature: 'Feature',
        special: 'Feature',
        memories: 'Memories',
        hardware: 'Hardware'
      }
    : {
        review: 'Recensione',
        article: 'Articolo',
        guide: 'Guida',
        interview: 'Intervista',
        news: 'News',
        feature: 'Speciale',
        special: 'Speciale',
        memories: 'Memories',
        hardware: 'Hardware'
      };

  const platformLabels = {
    console: 'Console',
    computer: 'Computer',
    arcade: 'Arcade'
  };

  const getArticleUrl = (article) => {
    const routes = isEn
      ? {
          review: 'reviews',
          news: 'news',
          feature: 'features',
          special: 'features',
          guide: 'guides',
          memories: 'memories',
          interview: 'interviews',
          hardware: 'hardware',
          article: 'articles'
        }
      : {
          review: 'recensioni',
          news: 'news',
          feature: 'speciali',
          special: 'speciali',
          guide: 'guide',
          memories: 'memories',
          interview: 'interviste',
          hardware: 'hardware',
          article: 'articoli'
        };

    const section = routes[article.type] || routes.article;

    return isEn
      ? `/en/${section}/${article.slug}/`
      : `/${section}/${article.slug}/`;
  };

  const getPlatformUrl = (platform) => {
    if (
      !platform?.platformType ||
      !platform?.manufacturer?.slug ||
      !platform?.slug
    ) {
      return isEn ? '/en/platforms/' : '/piattaforme/';
    }

    const typeMap = isEn
      ? {
          console: 'consoles',
          computer: 'computers',
          arcade: 'arcade'
        }
      : {
          console: 'console',
          computer: 'computer',
          arcade: 'arcade'
        };

    const typeSlug = typeMap[platform.platformType] || platform.platformType;

    return isEn
      ? `/en/platforms/${typeSlug}/${platform.manufacturer.slug}/${platform.slug}/`
      : `/piattaforme/${typeSlug}/${platform.manufacturer.slug}/${platform.slug}/`;
  };

  const getTaxonomyName = (item) => {
    if (!item) return '';

    return isEn
      ? item.nameEn || item.name || ''
      : item.name || item.nameEn || '';
  };

  /* ========================
     UI CONTROL
  ======================== */

  function reset() {
    results.classList.remove('active');
    results.innerHTML = '<div class="hover-bg"></div>';
  }

  function lockScroll() {
    document.documentElement.classList.add('has-search-open');
    document.body.classList.add('has-search-open');
  }

  function unlockScroll() {
    document.documentElement.classList.remove('has-search-open');
    document.body.classList.remove('has-search-open');
  }

  function openSearch() {
    if (isOpen) return;

    isOpen = true;
    window.clearTimeout(closeTimer);
    lastFocusedElement = document.activeElement;

    bar.hidden = false;
    bar.removeAttribute('inert');
    bar.setAttribute('aria-hidden', 'false');

    if (overlay) {
      overlay.hidden = false;
    }

    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', toggle.dataset.closeLabel || 'Chiudi ricerca');
    lockScroll();

    requestAnimationFrame(() => {
      if (!isOpen) return;

      bar.classList.add('active');
      overlay?.classList.add('active');
      input?.focus();
    });
  }

  function closeSearch(restoreFocus = true) {
    if (!isOpen) return;

    isOpen = false;
    window.clearTimeout(closeTimer);

    bar.classList.remove('active');
    overlay?.classList.remove('active');
    bar.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', toggle.dataset.openLabel || 'Apri ricerca');
    unlockScroll();

    if (input) input.value = '';

    window.clearTimeout(debounce);
    reset();

    if (
      restoreFocus &&
      lastFocusedElement &&
      lastFocusedElement.isConnected &&
      typeof lastFocusedElement.focus === 'function'
    ) {
      lastFocusedElement.focus({ preventScroll: true });
    }

    lastFocusedElement = null;
    bar.setAttribute('inert', '');

    closeTimer = window.setTimeout(() => {
      if (isOpen) return;

      bar.hidden = true;

      if (overlay) {
        overlay.hidden = true;
      }
    }, 300);
  }

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    isOpen ? closeSearch() : openSearch();
  });

  bar?.addEventListener('click', (event) => {
    event.stopPropagation();
  });

  bar?.addEventListener('keydown', (event) => {
    if (!isOpen || event.key !== 'Tab') return;

    const focusableElements = Array.from(
      bar.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])')
    ).filter((element) => !element.hidden && element.offsetParent !== null);

    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];

    if (!firstElement || !lastElement) return;

    if (event.shiftKey && document.activeElement === firstElement) {
      event.preventDefault();
      lastElement.focus();
      return;
    }

    if (!event.shiftKey && document.activeElement === lastElement) {
      event.preventDefault();
      firstElement.focus();
    }
  });

  closeBtn?.addEventListener('click', (event) => {
    event.stopPropagation();
    closeSearch();
  });

  overlay?.addEventListener('click', () => closeSearch());

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen) return;

    event.preventDefault();
    closeSearch();
  });

  document.addEventListener('click', (event) => {
    if (!isOpen) return;
    if (wrapper.contains(event.target)) return;

    closeSearch(false);
  });

  /* ========================
     SEARCH
  ======================== */

  input?.addEventListener('input', () => {

    const query = input.value.trim();
    clearTimeout(debounce);

    if (query.length < 2) {
      reset();
      return;
    }

    debounce = setTimeout(async () => {

      try {

        if (!cache) {
          const res = await fetch('/api/search');
          cache = await res.json();
        }

        /* ========================
           BUILD INDEX
        ======================== */

        const articles = (cache.articles || [])
          .filter((article) => (article.language || 'it') === currentLang)
          .map((article) => {
            const articleLabel = articleLabels[article.type] || (isEn ? 'Article' : 'Articolo');
            const platformName = article.platforms?.[0]?.name || '';
            const year = article.gameInfo?.releaseYear || '';

            return {
              ...article,
              kind: 'article',
              label: articleLabel,
              url: getArticleUrl(article),
              image: optimizeImageUrl(
                article.featuredImage?.asset?.url ||
                article.featuredImage?.url ||
                article.gameInfo?.cover?.asset?.url ||
                article.gameInfo?.cover?.url ||
                article.cover?.asset?.url ||
                article.cover?.url ||
                '',
                180,
                120
              ),
              eyebrow: [
                articleLabel,
                platformName,
                year
              ].filter(Boolean).join(' · '),
              searchableText: `
                ${article.title || ''}
                ${article.cardExcerpt || article.subtitle || article.excerpt || ''}
                ${article.type || ''}
                ${(article.categories || []).map(getTaxonomyName).join(' ')}
                ${(article.platforms || []).map(p => p.name).join(' ')}
                ${(article.genres || []).map(getTaxonomyName).join(' ')}
                ${(article.developers || []).map(getTaxonomyName).join(' ')}
                ${year || ''}
              `
            };
          });

        const platforms = (cache.platforms || [])
          .map((platform) => {
            const platformLabel = platformLabels[platform.platformType] || (isEn ? 'Platform' : 'Piattaforma');

            return {
              title: platform.name,
              slug: platform.slug,
              kind: 'platform',
              label: platformLabel,
              url: getPlatformUrl(platform),
              image: optimizeImageUrl(
                platform.cover?.asset?.url ||
                platform.cover?.url ||
                platform.featuredImage?.asset?.url ||
                platform.featuredImage?.url ||
                '',
                180,
                120
              ),
              eyebrow: [
                platformLabel,
                platform.manufacturer?.name,
                platform.specs?.year
              ].filter(Boolean).join(' · '),
              searchableText: `
                ${platform.name || ''}
                ${platform.platformType || ''}
                ${platform.manufacturer?.name || ''}
                ${platform.specs?.year || ''}
                ${platform.history || ''}
                ${platform.historyEn || ''}
              `
            };
          });

        const all = [
          ...articles,
          ...platforms
        ];

        /* ========================
           RANKING
        ======================== */

        const ranked = all
          .map(item => ({
            ...item,
            score: scoreItem(item, query)
          }))
          .filter(i => i.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 6);

        /* ========================
           RENDER
        ======================== */

        let html = '<div class="hover-bg"></div>';

        if (!ranked.length) {
          html += isEn
            ? `
              <div class="search-empty">
                <strong>No results</strong>
                <span>Try a game, a platform, a genre or a developer.</span>
              </div>
            `
            : `
              <div class="search-empty">
                <strong>Nessun risultato</strong>
                <span>Prova con un gioco, una piattaforma, un genere o uno sviluppatore.</span>
              </div>
            `;
        } else {

          html += ranked.map(post => {

            const image = post.image || '';
            const title = post.title || '';
            const eyebrow = post.eyebrow || post.label || '';

            return `
              <a href="${post.url}" class="search-item">

                <div class="search-thumb ${image ? '' : 'is-empty'}">
                  ${image
                    ? `<img src="${image}" alt="" width="180" height="120" loading="lazy" decoding="async">`
                    : `<span>${escapeHTML(post.label?.slice(0, 2) || 'RG')}</span>`
                  }
                </div>

                <div class="search-content">
                  <div class="search-category">
                    ${escapeHTML(eyebrow)}
                  </div>

                  <div class="search-title">
                    ${highlight(title, query)}
                  </div>
                </div>

              </a>
            `;
          }).join('');
        }

        results.innerHTML = html;
        results.classList.add('active');

      } catch (err) {
        console.error('Search error:', err);
        reset();
      }

    }, 200);
  });

})();
</script>
