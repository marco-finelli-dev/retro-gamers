---
import { getArchiveUrl, getPlatformTypeUrl, getPlatformIndexUrl, getCreatorUrl, getCompanyUrl, getPlayableClassicUrl, getEmulatorToolUrl } from '../../lib/routes.js';
import { getOpenCommunitySurveyForLanguage, getCommunitySurveyUrl } from '../../lib/community-surveys';
const { lang = 'it' } = Astro.props;
const en = lang === 'en';
const home = en ? '/en/' : '/';
const community = `${home}community/`;
const item = (label: string, href: string) => ({ label, href });
const editorial = (type: string, it: string, english = it) => item(en ? english : it, getArchiveUrl(type, lang));
const survey = await getOpenCommunitySurveyForLanguage(lang);
const surveyHref = survey ? getCommunitySurveyUrl(survey, lang) : community;
const preferenceLabels = {
  title: en ? 'Preferences' : 'Preferenze',
  theme: en ? 'Theme' : 'Tema',
  language: en ? 'Language' : 'Lingua',
  automatic: en ? 'Auto' : 'Auto',
  light: en ? 'Light' : 'Chiaro',
  dark: en ? 'Dark' : 'Scuro'
};
const themeOptions = [
  { id: 'system', label: preferenceLabels.automatic, icon: 'M4 5h16v11H4z M9 20h6 M12 16v4 M8 9l2 2 4-4' },
  { id: 'light', label: preferenceLabels.light, icon: 'M12 3v2 M12 19v2 M3 12h2 M19 12h2 M5.64 5.64l1.42 1.42 M16.94 16.94l1.42 1.42 M18.36 5.64l-1.42 1.42 M7.06 16.94l-1.42 1.42 M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0' },
  { id: 'dark', label: preferenceLabels.dark, icon: 'M20 15.5A8 8 0 0 1 8.5 4 8 8 0 1 0 20 15.5z' }
];
const languageOptions = [
  { code: 'it', label: 'Italiano' },
  { code: 'en', label: 'English' }
];
const currentLanguageHref = `${Astro.url.pathname}${Astro.url.search}`;
const siteLinks = en ? {
  about: item('About', '/en/about/'),
  collaborations: item('Collaborations', '/en/collaborations/'),
  contact: item('Contact', '/en/contact/'),
  newsletter: item('Newsletter', '/en/newsletter/'),
  authors: item('Authors', '/en/authors/'),
  archive: item('Archive', '/en/archive/'),
  resources: item('Resources', '/en/resources/')
} : {
  about: item('Chi siamo', '/chi-siamo/'),
  collaborations: item('Collaborazioni', '/collaborazioni/'),
  contact: item('Contatti', '/contatti/'),
  newsletter: item('Newsletter', '/newsletter/'),
  authors: item('Autori', '/autori/'),
  archive: item('Archivio', '/archivio/'),
  resources: item('Risorse', '/risorse/')
};
const left = [
  { id: 'account', title: 'Account', icon: '', items: [] },
  { id: 'community', title: 'Community', icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M16 3a4 4 0 0 1 0 8 M22 21v-2a4 4 0 0 0-3-3.87 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0', items: [item('Community',community), item('Quiz',`${home}quiz/`), item(en ? 'Discussions' : 'Discussioni',`${community}#community-hub-discussions`), item(en ? 'Surveys' : 'Sondaggi',surveyHref)] },
  { id: 'preferences', title: preferenceLabels.title, icon: 'M4 7h10 M18 7h2 M14 5v4 M4 17h2 M10 17h10 M6 15v4 M4 12h6 M14 12h6 M10 10v4', items: [] },
  { id: 'info', title: 'Info', icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20 M12 10v7 M12 7h.01', items: [siteLinks.about, siteLinks.collaborations, siteLinks.contact, siteLinks.newsletter] }
];
const socialLinks = [
  { label: 'Facebook', href: 'https://www.facebook.com/profile.php?id=100063648424822', icon: { type: 'mask', value: 'facebook' }, external: true },
  { label: 'X', href: 'https://x.com/RetroGamers13', icon: { type: 'mask', value: 'x' }, external: true },
  { label: 'WhatsApp', href: 'https://whatsapp.com/channel/0029VbDPq3A7j6g5WNSANq0S', icon: { type: 'mask', value: 'whatsapp' }, external: true }
];
const platformLinks = [
  { label: 'Console', href: getPlatformTypeUrl('console', lang), icon: { type: 'path', value: 'M5 7h14l3 11-4 1-3-4H9l-3 4-4-1z M6 10v4 M4 12h4 M16 11h.01 M18 13h.01' }, external: false },
  { label: 'Computer', href: getPlatformTypeUrl('computer', lang), icon: { type: 'path', value: 'M4 3h16v12H4z M12 15v3 M3 21h18l-2-3H5z' }, external: false },
  { label: 'Arcade', href: getPlatformTypeUrl('arcade', lang), icon: { type: 'path', value: 'M6 2h12l2 5-2 7 2 8H4l2-8-2-7z M7 6h10v6H7z M8 17h8' }, external: false }
];
const right = [
  { id: 'magazine', title: 'Magazine', icon: 'M3 4h18v16H3z M7 8h4v4H7z M15 8h2 M15 12h2 M7 16h10', items: [editorial('news','News'), editorial('review','Recensioni','Reviews'), editorial('feature','Speciali','Features'), editorial('guide','Guide','Guides')] },
  { id: 'stories', title: en ? 'Stories' : 'Storie', icon: 'M12 5v16 M12 5C8 2 4 3 2 4v15c4-2 7-1 10 2 3-3 6-4 10-2V4c-2-1-6-2-10 1', items: [editorial('memories','Memories'), editorial('interview','Interviste','Interviews'), item('Creator',getCreatorUrl(null,lang)), item(en ? 'Companies' : 'Aziende',getCompanyUrl(null,lang))] },
  { id: 'universe', title: en ? 'Retro universe' : 'Universo Retro', icon: 'M4 5h16v12H4z M8 21h8 M12 17v4 M8 9h8', items: [item(en ? 'Platforms' : 'Piattaforme',getPlatformIndexUrl(lang)), editorial('hardware', 'Hardware e libri', 'Hardware & Books'), item(en ? 'Playable Classics' : 'Classici giocabili oggi',getPlayableClassicUrl(null,lang)), item(en ? 'Emulators & Interpreters' : 'Emulatori e interpreti',getEmulatorToolUrl(null,lang))] },
  { id: 'explore', title: en ? 'Explore' : 'Esplora', icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20 M15.5 8.5l-2 5-5 2 2-5z', items: [siteLinks.authors, siteLinks.archive, siteLinks.resources] }
];
---
<div class="site-rails">
  {[{ side: 'left', groups: left, label: 'Community' }, { side: 'right', groups: right, label: en ? 'Site navigation' : 'Navigazione del sito' }].map(({side, groups,label}) =>
    <aside class={`site-rail site-rail--${side}`} data-site-rail aria-label={label}>
      <div class="site-rail__primary">
        <div class="site-rail__controls">
          {groups.map(group => group.id === 'account' ? <div data-rail-account><slot name="account" /></div> :
            <button class="site-rail__button" type="button" data-rail-section={group.id} aria-label={group.title} title={group.title} aria-controls={`dock-${side}`} aria-expanded="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={group.icon}/></svg>
            </button>)}
        </div>
        <div id={`dock-${side}`} class="site-rail__panel" inert>
          <div class="site-rail__heading"><h2 data-dock-title>{label}</h2><button type="button" class="site-rail__close" data-dock-close aria-label={en ? 'Close panel' : 'Chiudi pannello'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg></button></div>
          <div class="site-rail__content">
            {groups.map(group => <nav data-dock-content={group.id} data-title={group.title} aria-label={group.title} hidden>
              {group.id === 'preferences' ? (
                <div class="site-rail__preferences">
                  <div class="site-rail__preference-group">
                    <span class="site-rail__preference-label">{preferenceLabels.theme}</span>
                    <div class="site-rail__theme-choices" role="group" aria-label={preferenceLabels.theme}>
                      {themeOptions.map(option => (
                        <button type="button" data-theme-choice={option.id} aria-label={option.label} aria-pressed="false">
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={option.icon}/></svg>
                          <span>{option.label}</span>
                        </button>
                      ))}
                    </div>
                    <div class="site-rail__preference-source" data-rail-preference="theme"></div>
                  </div>
                  <div class="site-rail__preference-group">
                    <span class="site-rail__preference-label">{preferenceLabels.language}</span>
                    <div class="site-rail__language-choices" aria-label={preferenceLabels.language}>
                      {languageOptions.map(option => option.code === lang ? (
                        <a class="site-rail__language-choice" href={currentLanguageHref} aria-label={option.label} aria-current="page">
                          <span aria-hidden="true">{option.code.toUpperCase()}</span>
                        </a>
                      ) : (
                        <div class="site-rail__language-choice-host" data-rail-preference="language"></div>
                      ))}
                    </div>
                  </div>
                </div>
              ) : group.items.map(link => <a class="site-rail__link" href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a>)}
            </nav>)}
          </div>
        </div>
      </div>
      <nav class="site-rail__mini" aria-label={side === 'left' ? 'Social' : (en ? 'Platform shortcuts' : 'Accesso rapido piattaforme')}>
        {(side === 'left' ? socialLinks : platformLinks).slice(0, 3).map(link => <a class="site-rail__button" href={link.href} aria-label={link.label} title={link.label} data-external={link.external ? 'true' : undefined}>
          {link.icon.type === 'mask' ? <span class="site-rail__social-icon" style={`--social-icon: url('/icons/social/${link.icon.value}.svg')`} aria-hidden="true"/> : <svg viewBox="0 0 24 24" aria-hidden="true"><path d={link.icon.value}/></svg>}
        </a>)}
      </nav>
    </aside>)}
</div>
<script>
  const rails = Array.from(document.querySelectorAll<HTMLElement>('[data-site-rail]'));
  const desktop = window.matchMedia('(min-width: 1200px)');
  const account = document.querySelector<HTMLElement>('[data-account-menu]');
  const accountTrigger = account?.querySelector<HTMLButtonElement>('[data-account-menu-toggle]');
  const preferences = ['theme', 'language'].map(kind => {
    const control = document.querySelector<HTMLElement>(`.site-header__${kind}-toggle`)!;
    const placeholder = document.createComment(`header-${kind}`);
    control.before(placeholder);
    return { kind, control, placeholder };
  });
  preferences[0].control.addEventListener('click', event => {
    if (desktop.matches) event.stopPropagation();
  });
  const mobileSlot = document.querySelector('[data-header-account]');
  const railSlot = document.querySelector('[data-rail-account]');
  const close = (rail: HTMLElement, restore = false) => {
    const selected = rail.dataset.selected;
    const trigger = selected === 'account' ? accountTrigger : rail.querySelector<HTMLButtonElement>(`[data-rail-section="${selected}"]`);
    if (restore || rail.querySelector('.site-rail__panel')?.contains(document.activeElement)) trigger?.focus({ preventScroll: true });
    rail.classList.remove('is-open');
    delete rail.dataset.selected;
    rail.querySelectorAll('[data-rail-section]').forEach(node => node.setAttribute('aria-expanded','false'));
    rail.querySelector<HTMLElement>('.site-rail__panel')!.inert = true;
    if (selected === 'account' && account?.classList.contains('is-open')) accountTrigger?.click();
  };
  const open = (rail: HTMLElement, section: string) => {
    rails.forEach(other => { if (other !== rail) close(other); });
    if (section !== 'account' && account?.classList.contains('is-open')) accountTrigger?.click();
    rail.dataset.selected = section;
    rail.classList.add('is-open');
    rail.querySelector<HTMLElement>('.site-rail__panel')!.inert = false;
    rail.querySelectorAll<HTMLElement>('[data-dock-content]').forEach(node => {
      node.hidden = node.dataset.dockContent !== section;
      if (!node.hidden) rail.querySelector('[data-dock-title]')!.textContent = node.dataset.title!;
    });
    rail.querySelectorAll<HTMLElement>('[data-rail-section]').forEach(node => node.setAttribute('aria-expanded',String(node.dataset.railSection === section)));
    rail.querySelector('.site-rail__content')!.scrollTop = 0;
  };
  rails.forEach(rail => {
    rail.querySelectorAll<HTMLElement>('[data-rail-section]').forEach(button => button.addEventListener('click', () => {
      const section = button.dataset.railSection!;
      rail.dataset.selected === section ? close(rail) : open(rail,section);
    }));
    rail.querySelector('[data-dock-close]')?.addEventListener('click', () => close(rail,true));
    rail.addEventListener('focusout', () => requestAnimationFrame(() => { if (!rail.contains(document.activeElement)) close(rail); }));
  });
  // Retain the existing account controller, session updates and keyboard menu.
  if (account) new MutationObserver(() => {
    if (!desktop.matches) return;
    const rail = rails[0];
    if (account.classList.contains('is-open')) { if (rail.dataset.selected !== 'account') open(rail,'account'); }
    else if (rail.dataset.selected === 'account') close(rail);
  }).observe(account, { attributes: true, attributeFilter: ['class'] });
  document.addEventListener('click', event => rails.forEach(rail => { if (!rail.contains(event.target as Node)) close(rail); }));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !event.defaultPrevented) rails.filter(rail => rail.classList.contains('is-open')).forEach(rail => { event.preventDefault(); close(rail,true); });
  });
  const updateMode = () => {
    if (!desktop.matches && rails.some(rail => rail.contains(document.activeElement))) document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]')?.focus({preventScroll:true});
    rails.forEach(rail => close(rail));
    preferences.forEach(({kind,control,placeholder}) => {
      if (desktop.matches) document.querySelector(`[data-rail-preference="${kind}"]`)?.append(control);
      else placeholder.after(control);
    });
    if (account) (desktop.matches ? railSlot : mobileSlot)?.prepend(account);
  };
  desktop.addEventListener('change',updateMode);
  updateMode();
</script>
