---
import '../../styles/components/header/dropdown.css';
import { getPostUrl } from '../../lib/routes';
import { urlFor } from '../../lib/image';

const { posts = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';

/* =========================
   LABELS
========================= */

const labels = {
  more: isEn ? 'View all reviews' : 'Vedi tutte le recensioni'
};

const archiveHref = isEn ? '/en/reviews/' : '/recensioni/';

/* =========================
   DATA
========================= */

const all = posts
  .filter((post) => {
    const postLang = post.language || 'it';
    return postLang === lang;
  })
  .map((p) => ({
    ...p,
    score: p?.score ?? p?.rating?.overall ?? 0
  }))
  .filter((post) => post?._id);

const uniqueById = (items) => {
  const seen = new Set();

  return items.filter((item) => {
    if (seen.has(item._id)) return false;

    seen.add(item._id);
    return true;
  });
};

const recentPosts = [...all]
  .sort(
    (a, b) =>
      new Date(b.publishedAt || 0).getTime() -
      new Date(a.publishedAt || 0).getTime()
  )
  .slice(0, 2);

const topPosts = [...all]
  .filter((post) => !recentPosts.some((item) => item._id === post._id))
  .sort((a, b) => {
    if ((b.score || 0) === (a.score || 0)) {
      return (
        new Date(b.publishedAt || 0).getTime() -
        new Date(a.publishedAt || 0).getTime()
      );
    }

    return (b.score || 0) - (a.score || 0);
  })
  .slice(0, 2);

const archiveCandidates = all.filter(
  (post) =>
    !recentPosts.some((item) => item._id === post._id) &&
    !topPosts.some((item) => item._id === post._id)
);

const daySeed = Math.floor(Date.now() / 86_400_000);

const archivePost =
  archiveCandidates.length > 0
    ? archiveCandidates[daySeed % archiveCandidates.length]
    : null;

const finalPosts = uniqueById([
  ...recentPosts,
  ...topPosts,
  archivePost
].filter(Boolean)).slice(0, 5);

const formatScore = (score) =>
  score ? Number(score).toFixed(1) : '-';

const getScoreLabel = (score) => {
  if (score >= 9.5) return 'TOP';
  if (score >= 9) return 'MUST';
  if (score >= 8.5) return 'GOOD';
  return '';
};

const getScoreClass = (score) => {
  if (score >= 9.5) return 'is-top';
  if (score >= 9) return 'is-must';
  if (score >= 8.5) return 'is-good';
  return 'is-low';
};

const getMeta = (post) => {
  const platform = post.platforms?.[0]?.name || '';
  const developer = post.developers?.[0]?.name || '';
  const year = post.gameInfo?.releaseYear || '';

  return [platform, developer, year].filter(Boolean).join(' · ');
};

const getImage = (post) => {
  if (!post?.featuredImage?.asset) return '';

  return urlFor(post.featuredImage)
    .width(180)
    .height(120)
    .fit('crop')
    .quality(70)
    .auto('format')
    .url();
};
---

<div class="rg-dropdown rg-dropdown--reviews">

  <div class="rg-dropdown__panel">

    {finalPosts.map((post) => {
      const image = getImage(post);
      const score = post.score ?? 0;

      return (
        <a href={getPostUrl(post)} class="rg-dropdown__item rg-dropdown__item--review">

          <div class="rg-dropdown__thumb">
            {image && (
              <img
                src={image}
                alt={post.title || ''}
                width="180"
                height="120"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>

          <div class="rg-dropdown__content">

            {getMeta(post) && (
              <div class="rg-dropdown__meta">
                {getMeta(post)}
              </div>
            )}

            <div class="rg-dropdown__title">
              {post.title}
            </div>

          </div>

          <div class={`rg-dropdown__score ${getScoreClass(score)}`}>
            <span>{formatScore(score)}</span>
            {getScoreLabel(score) && (
              <small>{getScoreLabel(score)}</small>
            )}
          </div>

        </a>
      );
    })}

    <a href={archiveHref} class="rg-dropdown__more">
      {labels.more} <span>→</span>
    </a>

  </div>

</div>