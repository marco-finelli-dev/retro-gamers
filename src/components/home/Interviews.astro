---
import '../../styles/components/home-headings.css';
import '../../styles/components/interviews.css';
import { urlFor } from '../../lib/image';
import { getArchiveUrl, getPostUrl } from '../../lib/routes';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const { posts = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';
const [mainInterview, ...secondaryInterviews] = posts.slice(0, 5);

const labels = {
  title: isEn ? 'Interviews' : 'Interviste',
  all: isEn ? 'All interviews' : 'Tutte le interviste',
  href: getArchiveUrl('interview', lang)
};

const cleanText = (value?: string) => value?.replace(/\[…\]/g, '').trim() || '';

const getExcerpt = (post: any) =>
  cleanText(post?.cardExcerpt) || cleanText(post?.subtitle) || cleanText(post?.excerpt);

const getSecondaryMetadata = (post: any) => {
  const category = post?.categories?.[0];
  const platform = post?.platforms?.[0];

  if (category) return isEn ? category.nameEn || category.name : category.name || category.nameEn;
  return platform?.name || '';
};

const getImage = (post: any, width: number, height: number) => {
  if (!post?.featuredImage?.asset) return '/og-image.jpg';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(74)
    .auto('format')
    .url();
};
---

{mainInterview && (
  <section class="rg-home-interviews" aria-labelledby={`home-interviews-${lang}`}>
    <div class="rg-module-heading rg-module-heading--centered rg-home-interviews__heading">
      <h2 id={`home-interviews-${lang}`}>{labels.title}</h2>
    </div>

    <div class="rg-home-interviews__grid">
      <a href={getPostUrl(mainInterview)} class="rg-home-interviews__feature rg-editorial-link">
        <span class="rg-home-interviews__feature-image">
          <img
            src={getImage(mainInterview, 960, 540)}
            alt={mainInterview.featuredImage?.alt || mainInterview.title}
            width="960"
            height="540"
            loading="lazy"
            decoding="async"
          />
        </span>

        <span class="rg-home-interviews__feature-content">
          {(getSecondaryMetadata(mainInterview) || Number(mainInterview.commentCount || 0) > 0) && (
            <span class="rg-home-interviews__meta rg-meta-line">
              {getSecondaryMetadata(mainInterview) && <span class="rg-home-interviews__kicker rg-meta-primary">{getSecondaryMetadata(mainInterview)}</span>}
              {getSecondaryMetadata(mainInterview) && Number(mainInterview.commentCount || 0) > 0 && <span class="rg-meta-separator" aria-hidden="true">·</span>}
              <CommentCountBadge count={mainInterview.commentCount} lang={lang} variant="compact" class="rg-meta-auxiliary" />
            </span>
          )}
          <strong class="rg-editorial-title">{mainInterview.title}</strong>
          {getExcerpt(mainInterview) && <span class="rg-home-interviews__excerpt">{getExcerpt(mainInterview)}</span>}
        </span>
      </a>

      <div class="rg-home-interviews__secondary-list">
        {secondaryInterviews.map((post: any) => {
          const secondaryMetadata = getSecondaryMetadata(post);

          return (
          <a href={getPostUrl(post)} class="rg-home-interviews__secondary rg-editorial-link">
            <span class="rg-home-interviews__secondary-image">
              <img
                src={getImage(post, 320, 240)}
                alt={post.featuredImage?.alt || post.title}
                width="320"
                height="240"
                loading="lazy"
                decoding="async"
              />
            </span>

            <span class="rg-home-interviews__secondary-content">
              {(secondaryMetadata || Number(post.commentCount || 0) > 0) && (
                <span class="rg-home-interviews__meta rg-meta-line">
                  {secondaryMetadata && <span class="rg-home-interviews__kicker rg-meta-primary">{secondaryMetadata}</span>}
                  {secondaryMetadata && Number(post.commentCount || 0) > 0 && <span class="rg-meta-separator" aria-hidden="true">·</span>}
                  <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" class="rg-meta-auxiliary" />
                </span>
              )}
              <strong class="rg-editorial-title">{post.title}</strong>
            </span>
          </a>
          );
        })}

        <a href={labels.href} class="rg-archive-link rg-home-interviews__section-link">{labels.all} →</a>
      </div>
    </div>
  </section>
)}
