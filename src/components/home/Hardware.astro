---
import '../../styles/components/hardware.css';
import { urlFor } from '../../lib/image';
import { getPostUrl } from '../../lib/routes';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const { posts = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const items = posts.slice(0, 3);

const labels = {
  eyebrow: isEn ? 'Gear, books & accessories' : 'Gear, libri & accessori',
  title: 'Hardware',
  description: isEn
    ? 'Consoles, controllers, FPGA, books, accessories and retro gear worth keeping an eye on.'
    : 'Console, controller, FPGA, libri, accessori e oggetti retro da tenere d’occhio.',
  allHardware: isEn ? 'All hardware' : 'Tutto l’hardware',
  href: isEn ? '/en/hardware/' : '/hardware/',
  comingSoon: isEn ? 'Coming soon' : 'Prossimamente',
  emptyTitle: isEn
    ? 'Hardware, accessories and retro releases'
    : 'Hardware, accessori e nuove uscite retro',
  emptyText: isEn
    ? 'Here we will collect consoles, controllers, FPGA boards, mini systems, video scalers, books and interesting products for retro-gaming enthusiasts.'
    : 'Qui raccoglieremo console, controller, FPGA, mini sistemi, scaler video, libri e prodotti interessanti per chi vive il retro-gaming anche fuori dallo schermo.',
  readArticle: isEn ? 'Read the article' : 'Leggi l’articolo',
  learnMore: isEn ? 'Learn more' : 'Scopri di più'
};

const getImage = (post, width = 640, height = 400) => {
  if (!post?.featuredImage?.asset) return '/placeholder-retro.png';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(74)
    .auto('format')
    .url();
};

const cleanText = (value) =>
  value?.replace(/\[…\]/g, '').trim() || '';

const getExcerpt = (post) =>
  cleanText(post?.cardExcerpt) ||
  cleanText(post?.subtitle) ||
  cleanText(post?.excerpt);

const getProductLabel = (post) => {
  const productType = post?.monetization?.productType;

  const map = isEn
    ? {
        book: 'Book',
        hardware: 'Hardware',
        accessory: 'Accessory',
        software: 'Software',
        gadget: 'Gadget',
        service: 'Service',
        other: 'Recommended'
      }
    : {
        book: 'Libro',
        hardware: 'Hardware',
        accessory: 'Accessorio',
        software: 'Software',
        gadget: 'Gadget',
        service: 'Servizio',
        other: 'Consigliato'
      };

  if (post?.type === 'hardware') return 'Hardware';

  return map[productType] || (isEn ? 'Recommended' : 'Consigliato');
};

const getCta = (post) => {
  if (post?.monetization?.isAffiliate) {
    return post.monetization.affiliateLabel || labels.learnMore;
  }

  return labels.readArticle;
};
---

<section class="section-box hardware-strip">

  <div class="hardware-strip__header">

    <div>
      <span>{labels.eyebrow}</span>
      <h2>{labels.title}</h2>
      <p>{labels.description}</p>
    </div>

    <a href={labels.href} class="hardware-strip__link">
      {labels.allHardware}
    </a>

  </div>

  {items.length > 0 ? (

    <div class="hardware-strip__grid">

      {items.map((post) => {
        const isAffiliate = post?.monetization?.isAffiliate;
        const productLabel = getProductLabel(post);

        return (
          <a href={getPostUrl(post)} class="hardware-card">

            <div class="hardware-card__image">
              <img
                src={getImage(post, 640, 400)}
                alt={post.featuredImage?.alt || post.title}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="hardware-card__content">
              <div class="rg-card-meta-inline">
                <span>{productLabel}</span>
                <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" />
              </div>
              <h3>{post.title}</h3>

              {getExcerpt(post) && (
                <p>{getExcerpt(post)}</p>
              )}

              <small>
                {getCta(post)} →
              </small>

              {isAffiliate && post.monetization?.priceLabel && (
                <em class="hardware-card__price">
                  {post.monetization.priceLabel}
                </em>
              )}
            </div>

          </a>
        );
      })}

    </div>

  ) : (

    <div class="hardware-empty">

      <div class="hardware-empty__content">
        <span>{labels.comingSoon}</span>
        <h3>{labels.emptyTitle}</h3>
        <p>{labels.emptyText}</p>
      </div>

      <div class="hardware-empty__badge">
        <strong>RG</strong>
        <small>GEAR</small>
      </div>

    </div>

  )}

</section>
