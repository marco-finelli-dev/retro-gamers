---
import UserAvatar from '../account/UserAvatar.astro';
import { urlFor } from '../../lib/image';
import {
  getCommunitySurveyUrl,
  getOpenCommunitySurveyForLanguage,
} from '../../lib/community-surveys';
import { getQuizUrl, type QuizSummary } from '../../lib/quiz';
import type { CommunityHubComment } from '../../lib/supabase/community-hub';

type Lang = 'it' | 'en';

interface Props {
  lang?: Lang;
  latestComments?: CommunityHubComment[];
  quizzes?: QuizSummary[];
  isLoggedIn?: boolean;
}

const {
  lang = 'it',
  latestComments = [],
  quizzes = [],
  isLoggedIn = false,
} = Astro.props;

const isEn = lang === 'en';
const comments = latestComments.slice(0, 10);
const publishedQuizzes = quizzes;
const sectionId = `home-community-strip-title-${lang}`;
const participationTitleId = `home-community-participation-title-${lang}`;
const voicesTitleId = `home-community-voices-title-${lang}`;
const surveyPromptTitleId = `home-community-survey-prompt-title-${lang}`;
const surveyPromptDescriptionId = `home-community-survey-prompt-description-${lang}`;
const activeSurvey = await getOpenCommunitySurveyForLanguage(isEn ? 'en' : 'it');
const hasActiveSurvey = Boolean(activeSurvey);
const hasSingleQuiz = publishedQuizzes.length === 1 && !hasActiveSurvey;
const hasParticipationItems = publishedQuizzes.length > 0 || hasActiveSurvey;
const compactExcerptMaxLength = 160;
const surveyPromptCooldownMs = 7 * 24 * 60 * 60 * 1000;

const copy = isEn
  ? {
      eyebrow: 'Community',
      title: 'Retro-Gamers Community',
      text: 'Play, comment and take part in the life of Retro-Gamers.',
      participationTitle: 'Play and take part',
      quizTitle: 'Retro-Gamers Quiz',
      quizAll: 'All quizzes',
      quizCta: 'Play',
      surveyCta: 'Take the survey',
      surveyAnonymous: 'Anonymous',
      surveyPromptEyebrow: 'Community survey',
      surveyPromptTitle: 'Help us shape the future of Retro-Gamers.it',
      surveyPromptText: (count: number) =>
        `We’ve prepared ${count} anonymous ${count === 1 ? 'question' : 'questions'} about the site’s content, your interests and what we could improve.`,
      surveyPromptNote: 'It only takes a few minutes.',
      surveyPromptDismiss: 'Not now',
      surveyPromptClose: 'Close survey invitation',
      voicesTitle: 'Community voices',
      voicesText: 'Comments, memories and conversations from readers who are bringing Retro-Gamers.it to life beyond the articles.',
      primary: 'Visit the community',
      secondary: isLoggedIn ? 'Go to your account' : 'Create your profile',
      empty: 'The first memories will arrive with the readers.',
      fromArticle: 'From',
      readDiscussion: 'Read the discussion',
      profileLabel: 'Profile',
      railLabel: 'Latest reader memories',
      quizRailLabel: 'Published Retro-Gamers quizzes',
      participationRailLabel: 'Retro-Gamers quizzes and community survey',
      questions: 'questions',
      seconds: 's',
      difficultyLabels: {
        easy: 'Easy',
        medium: 'Medium',
        hard: 'Hard',
        expert: 'Expert',
      },
    }
  : {
      eyebrow: 'Community',
      title: 'Community Retro-Gamers',
      text: 'Gioca, commenta e partecipa alla vita del sito.',
      participationTitle: 'Gioca e partecipa',
      quizTitle: 'Quiz Retro-Gamers',
      quizAll: 'Tutti i quiz',
      quizCta: 'Gioca',
      surveyCta: 'Partecipa al sondaggio',
      surveyAnonymous: 'Anonimo',
      surveyPromptEyebrow: 'Sondaggio community',
      surveyPromptTitle: 'Aiutaci a costruire il futuro di Retro-Gamers.it',
      surveyPromptText: (count: number) =>
        `Abbiamo preparato ${count} ${count === 1 ? 'domanda anonima' : 'domande anonime'} sui contenuti del sito, i tuoi interessi e su cosa possiamo migliorare.`,
      surveyPromptNote: 'Richiede solo pochi minuti.',
      surveyPromptDismiss: 'Non ora',
      surveyPromptClose: 'Chiudi invito sondaggio',
      voicesTitle: 'Le voci della community',
      voicesText: 'Commenti, ricordi e discussioni dai lettori che stanno dando vita a Retro-Gamers.it oltre gli articoli.',
      primary: 'Vai alla community',
      secondary: isLoggedIn ? 'Vai al tuo account' : 'Crea il tuo profilo',
      empty: 'Le prime memorie arriveranno con i lettori.',
      fromArticle: 'Da',
      readDiscussion: 'Leggi la discussione',
      profileLabel: 'Profilo',
      railLabel: 'Ultime memorie dai lettori',
      quizRailLabel: 'Quiz Retro-Gamers pubblicati',
      participationRailLabel: 'Quiz Retro-Gamers e sondaggio community',
      questions: 'domande',
      seconds: 's',
      difficultyLabels: {
        easy: 'Facile',
        medium: 'Medio',
        hard: 'Difficile',
        expert: 'Esperto',
      },
    };

const communityHref = isEn ? '/en/community/' : '/community/';
const quizHref = isEn ? '/en/quiz/' : '/quiz/';
const surveyHref = activeSurvey ? getCommunitySurveyUrl(activeSurvey, isEn ? 'en' : 'it') : '';
const profileHref = isEn
  ? (isLoggedIn ? '/en/account/' : '/en/account/register/')
  : (isLoggedIn ? '/account/' : '/account/register/');

const getCompactExcerpt = (preferred?: string, fallback?: string) => {
  const text = String(preferred || fallback || '').replace(/\s+/g, ' ').trim();

  if (text.length <= compactExcerptMaxLength) return text;

  return `${text.slice(0, compactExcerptMaxLength - 1).trim()}…`;
};

const getQuizCoverUrl = (quiz: QuizSummary) => {
  if (!quiz.coverImage?.asset) return '';

  return urlFor(quiz.coverImage)
    .width(480)
    .height(360)
    .fit('crop')
    .quality(74)
    .auto('format')
    .url();
};

const getSurveyCoverUrl = () => {
  if (!activeSurvey?.cardImage?.asset) return '';

  return urlFor(activeSurvey.cardImage)
    .width(480)
    .height(360)
    .fit('crop')
    .quality(74)
    .auto('format')
    .url();
};

const surveyCoverUrl = getSurveyCoverUrl();
const surveyExcerpt = activeSurvey
  ? getCompactExcerpt(activeSurvey.excerpt, activeSurvey.description)
  : '';

const getQuizDifficultyLabel = (difficulty?: string) =>
  difficulty && (copy.difficultyLabels as Record<string, string>)[difficulty]
    ? (copy.difficultyLabels as Record<string, string>)[difficulty]
    : difficulty || '';
---

<section class="section-box home-community-strip" aria-labelledby={sectionId}>
  <div class="home-community-strip__header">
    <div>
      <span class="home-community-strip__kicker">{copy.eyebrow}</span>
      <h2 id={sectionId}>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>
  </div>

  {hasParticipationItems && (
    <section class="home-community-strip__block home-community-strip__block--quiz" aria-labelledby={participationTitleId}>
      <header class="home-community-strip__block-header">
        <h3 id={participationTitleId}>{hasActiveSurvey ? copy.participationTitle : copy.quizTitle}</h3>
        {publishedQuizzes.length > 0 && (
          <a class="home-community-strip__link home-community-strip__link--primary" href={quizHref}>
            {copy.quizAll}
          </a>
        )}
      </header>

      <div
        class:list={[
          'home-community-strip__quiz-grid',
          hasSingleQuiz && 'home-community-strip__quiz-grid--featured',
          hasActiveSurvey && 'home-community-strip__quiz-grid--participation',
        ]}
        aria-label={hasActiveSurvey ? copy.participationRailLabel : copy.quizRailLabel}
      >
        {activeSurvey && (
          <a
            class:list={[
              'home-community-strip__quiz-card',
              'home-community-strip__survey-card',
              !surveyCoverUrl && 'home-community-strip__survey-card--text-only',
            ]}
            href={surveyHref}
          >
            {surveyCoverUrl && (
              <span class="home-community-strip__quiz-media home-community-strip__survey-media">
                <img
                  src={surveyCoverUrl}
                  alt={activeSurvey.cardImage?.alt || activeSurvey.title}
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            )}

            <span class="home-community-strip__quiz-body home-community-strip__survey-body">
              <span class="home-community-strip__quiz-meta">
                <span>{activeSurvey.questions.length} {copy.questions}</span>
                <span>{copy.surveyAnonymous}</span>
              </span>

              <strong>{activeSurvey.title}</strong>
              <span class="home-community-strip__quiz-excerpt home-community-strip__survey-excerpt">
                {surveyExcerpt}
              </span>
              <span class="home-community-strip__quiz-cta">{copy.surveyCta}</span>
            </span>
          </a>
        )}

        {publishedQuizzes.map((quiz) => {
          const coverUrl = getQuizCoverUrl(quiz);
          const difficulty = getQuizDifficultyLabel(quiz.difficulty);
          const href = getQuizUrl(quiz, isEn ? 'en' : 'it');
          const quizExcerpt = getCompactExcerpt(quiz.excerpt, quiz.subtitle);

          return (
            <a
              class={`home-community-strip__quiz-card${hasSingleQuiz ? ' home-community-strip__quiz-card--featured' : ''}`}
              href={href}
            >
              <span class="home-community-strip__quiz-media">
                {coverUrl ? (
                  <img
                    src={coverUrl}
                    alt={quiz.coverImage?.alt || quiz.title}
                    width="480"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="home-community-strip__quiz-fallback" aria-hidden="true">
                    {quiz.title?.slice(0, 2).toUpperCase()}
                  </span>
                )}
              </span>

              <span class="home-community-strip__quiz-body">
                <span class="home-community-strip__quiz-meta">
                  {difficulty && <span>{difficulty}</span>}
                  {Number.isFinite(quiz.questionCount) && (
                    <span>{quiz.questionCount} {copy.questions}</span>
                  )}
                  {quiz.timeLimitSeconds && (
                    <span>{quiz.timeLimitSeconds} {copy.seconds}</span>
                  )}
                </span>

                <strong>{quiz.title}</strong>
                <span class="home-community-strip__quiz-excerpt">{quizExcerpt}</span>
                <span class="home-community-strip__quiz-cta">{copy.quizCta}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="home-community-strip__block home-community-strip__block--voices" aria-labelledby={voicesTitleId}>
    <header class="home-community-strip__block-header home-community-strip__block-header--with-copy">
      <div>
        <h3 id={voicesTitleId}>{copy.voicesTitle}</h3>
        <p>{copy.voicesText}</p>
      </div>

      <div class="home-community-strip__actions" aria-label={copy.voicesTitle}>
        <a class="home-community-strip__link home-community-strip__link--primary" href={communityHref}>
          {copy.primary}
        </a>
        <a class="home-community-strip__link home-community-strip__link--secondary" href={profileHref}>
          {copy.secondary}
        </a>
      </div>
    </header>

    <div class="home-community-strip__comments" aria-label={copy.railLabel} tabindex="0">
      {comments.length > 0 ? (
        comments.map((comment) => (
          <article class="home-community-strip__comment">
            <header>
              <UserAvatar
                name={comment.authorName}
                src={comment.avatarUrl}
                size="sm"
                label={`${copy.profileLabel}: ${comment.authorName}`}
              />

              <div class="home-community-strip__author">
                <strong>
                  {comment.profileUrl ? (
                    <a href={comment.profileUrl}>{comment.authorName}</a>
                  ) : (
                    comment.authorName
                  )}
                </strong>

                {comment.badgeLabel && (
                  <span class="home-community-strip__badge">
                    {comment.badgeImageUrl && (
                      <img src={comment.badgeImageUrl} alt="" loading="lazy" decoding="async" />
                    )}
                    {comment.badgeLabel}
                  </span>
                )}
              </div>
            </header>

            <p>{comment.excerpt}</p>

            <footer>
              <span>{copy.fromArticle}</span>
              <a class="home-community-strip__article" href={comment.articleUrl}>{comment.articleTitle}</a>
              <a class="home-community-strip__discussion" href={comment.articleUrl}>
                {copy.readDiscussion}
              </a>
            </footer>
          </article>
        ))
      ) : (
        <p class="home-community-strip__empty">{copy.empty}</p>
      )}
    </div>
  </section>
</section>

{activeSurvey && (
  <>
    <div
      class="home-survey-prompt"
      data-home-survey-prompt
      data-survey-key={activeSurvey.surveyKey}
      data-dismissed-key={`communitySurveyPromptDismissed:${activeSurvey.surveyKey}`}
      data-completed-key={`communitySurveyCompleted:${activeSurvey.surveyKey}`}
      data-cooldown-ms={String(surveyPromptCooldownMs)}
      hidden
    >
      <section
        class="home-survey-prompt__dialog"
        role="dialog"
        aria-modal="false"
        aria-labelledby={surveyPromptTitleId}
        aria-describedby={surveyPromptDescriptionId}
        tabindex="-1"
      >
        <button
          class="home-survey-prompt__close"
          type="button"
          aria-label={copy.surveyPromptClose}
          data-home-survey-prompt-dismiss
        >
          ×
        </button>

        <p class="home-survey-prompt__eyebrow">{copy.surveyPromptEyebrow}</p>
        <h2 id={surveyPromptTitleId}>{copy.surveyPromptTitle}</h2>
        <p id={surveyPromptDescriptionId}>
          {copy.surveyPromptText(activeSurvey.questions.length)}
        </p>
        <p class="home-survey-prompt__note">{copy.surveyPromptNote}</p>

        <div class="home-survey-prompt__actions">
          <a
            class="home-survey-prompt__primary"
            href={surveyHref}
            data-home-survey-prompt-cta
          >
            {copy.surveyCta}
          </a>
          <button
            class="home-survey-prompt__secondary"
            type="button"
            data-home-survey-prompt-dismiss
          >
            {copy.surveyPromptDismiss}
          </button>
        </div>
      </section>
    </div>

    <script>
      (() => {
        const prompt = document.querySelector('[data-home-survey-prompt]');

        if (!(prompt instanceof HTMLElement)) return;

        const dismissControls = Array.from(prompt.querySelectorAll('[data-home-survey-prompt-dismiss]'));
        const cta = prompt.querySelector('[data-home-survey-prompt-cta]');
        const dismissedKey = prompt.dataset.dismissedKey || '';
        const completedKey = prompt.dataset.completedKey || '';
        const cooldownMs = Number(prompt.dataset.cooldownMs || 0) || 604800000;
        const openDelayMs = 2500;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let openTimer = 0;
        let isOpen = false;

        const storage = {
          get(key) {
            try {
              return key ? window.localStorage.getItem(key) : null;
            } catch {
              return null;
            }
          },
          set(key, value) {
            try {
              if (key) window.localStorage.setItem(key, value);
            } catch {
              // Ignore storage failures: the prompt should still be dismissible.
            }
          },
        };

        const hasCompletedSurvey = () => Boolean(storage.get(completedKey));

        const hasRecentDismissal = () => {
          const value = Number(storage.get(dismissedKey) || 0);

          return Number.isFinite(value) && value > 0 && Date.now() - value < cooldownMs;
        };

        const shouldSkipPrompt = () => hasCompletedSurvey() || hasRecentDismissal();

        const rememberDismissal = () => {
          storage.set(dismissedKey, String(Date.now()));
        };

        const handleKeydown = (event) => {
          if (event.key === 'Escape' && isOpen) {
            event.preventDefault();
            closePrompt();
          }
        };

        const openPrompt = () => {
          if (shouldSkipPrompt()) return;

          if (prompt.parentElement !== document.body) {
            document.body.append(prompt);
          }

          prompt.hidden = false;
          isOpen = true;
          document.addEventListener('keydown', handleKeydown);

          window.requestAnimationFrame(() => {
            prompt.dataset.open = 'true';
          });
        };

        const closePrompt = ({ remember = true } = {}) => {
          if (!isOpen && prompt.hidden) return;

          if (remember) {
            rememberDismissal();
          }

          isOpen = false;
          prompt.dataset.open = 'false';
          document.removeEventListener('keydown', handleKeydown);

          window.setTimeout(
            () => {
              prompt.hidden = true;
            },
            prefersReducedMotion ? 0 : 180
          );
        };

        dismissControls.forEach((control) => {
          control.addEventListener('click', () => {
            closePrompt();
          });
        });

        if (cta instanceof HTMLAnchorElement) {
          cta.addEventListener('click', () => {
            rememberDismissal();
          });
        }

        const scheduleOpen = () => {
          if (shouldSkipPrompt()) return;

          window.clearTimeout(openTimer);
          openTimer = window.setTimeout(() => {
            if (!shouldSkipPrompt()) {
              openPrompt();
            }
          }, openDelayMs);
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', scheduleOpen, { once: true });
        } else {
          scheduleOpen();
        }

        window.addEventListener('pagehide', () => {
          window.clearTimeout(openTimer);
          document.removeEventListener('keydown', handleKeydown);
        });
      })();
    </script>
  </>
)}
