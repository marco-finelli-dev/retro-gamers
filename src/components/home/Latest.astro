---
import '../../styles/components/latest.css';
import '../../styles/components/home-headings.css';
import { toHomeLatestItem } from '../../lib/home-latest';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const {
  posts = [],
  excludedPostIds = [],
  hasMore = false,
  lang = 'it'
} = Astro.props;

const isEn = lang === 'en';
const items = posts.map((post) => toHomeLatestItem(post, isEn ? 'en' : 'it'));
const labels = {
  title: isEn ? 'More articles' : 'Altri articoli',
  loadMore: isEn ? 'Load more articles' : 'Carica altri articoli'
};
---

{items.length > 0 && (
  <section
    class="rg-latest"
    aria-labelledby={`home-latest-${lang}`}
    data-home-latest
    data-endpoint="/api/home/latest-articles"
    data-language={lang}
    data-excluded-post-ids={JSON.stringify(excludedPostIds)}
  >
    <div class="rg-module-heading rg-latest__heading">
      <h2 id={`home-latest-${lang}`}>{labels.title}</h2>
    </div>

    <div class="rg-latest__grid" data-home-latest-grid>
      {items.map((item) => (
        <a href={item.url} class="rg-latest__item rg-editorial-link">
          <span class="rg-latest__image">
            <img src={item.image} alt={item.alt} width="240" height="240" loading="lazy" decoding="async" />
          </span>
          <span class="rg-latest__content">
            <span class="rg-latest__meta rg-meta-line">
              <span class="rg-latest__kicker rg-meta-primary">
                {item.kicker}
              </span>
              {item.secondary && (
                <>
                  <span class="rg-meta-separator" aria-hidden="true">·</span>
                  <span class="rg-latest__kicker rg-meta-secondary">{item.secondary}</span>
                </>
              )}
              {item.commentCount > 0 && <span class="rg-meta-separator" aria-hidden="true">·</span>}
              <CommentCountBadge count={item.commentCount} lang={lang} variant="compact" class="rg-meta-auxiliary" />
            </span>
            <strong class="rg-editorial-title">{item.title}</strong>
            {item.excerpt && <span class="rg-latest__excerpt">{item.excerpt}</span>}
          </span>
        </a>
      ))}
    </div>

    <div class="rg-latest__load-more" data-home-latest-controls hidden={!hasMore}>
      <button type="button" class="rg-cta-filled-raised rg-cta-filled-raised--primary" data-home-latest-load>
        <span class="rg-cta-filled-raised__face">{labels.loadMore}</span>
      </button>
    </div>
  </section>
)}

<script>
  const appendItem = (grid, item, language) => {
    const link = document.createElement('a');
    link.className = 'rg-latest__item rg-editorial-link';
    link.href = item.url;

    const image = document.createElement('span');
    image.className = 'rg-latest__image';
    const imageElement = document.createElement('img');
    imageElement.src = item.image;
    imageElement.alt = item.alt || item.title || '';
    imageElement.width = 240;
    imageElement.height = 240;
    imageElement.loading = 'lazy';
    imageElement.decoding = 'async';
    image.append(imageElement);

    const content = document.createElement('span');
    content.className = 'rg-latest__content';
    const kicker = document.createElement('span');
    kicker.className = 'rg-latest__kicker rg-meta-primary';
    kicker.textContent = item.kicker;
    const title = document.createElement('strong');
    title.className = 'rg-editorial-title';
    title.textContent = item.title;
    const meta = document.createElement('span');
    meta.className = 'rg-latest__meta rg-meta-line';
    meta.append(kicker);

    if (item.secondary) {
      const separator = document.createElement('span');
      separator.className = 'rg-meta-separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = '·';
      const secondary = document.createElement('span');
      secondary.className = 'rg-latest__kicker rg-meta-secondary';
      secondary.textContent = item.secondary;
      meta.append(separator, secondary);
    }

    if (Number(item.commentCount || 0) > 0) {
      const separator = document.createElement('span');
      separator.className = 'rg-meta-separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = '·';
      const commentCount = document.createElement('span');
      commentCount.className = 'rg-comment-count rg-comment-count--compact rg-meta-auxiliary';
      const count = Number(item.commentCount || 0);
      commentCount.setAttribute(
        'aria-label',
        language === 'en'
          ? `${count} ${count === 1 ? 'comment' : 'comments'}`
          : `${count} ${count === 1 ? 'commento' : 'commenti'}`
      );
      const icon = document.createElement('span');
      icon.className = 'rg-comment-count__icon';
      icon.setAttribute('aria-hidden', 'true');
      const value = document.createElement('span');
      value.className = 'rg-comment-count__value';
      value.textContent = String(item.commentCount);
      commentCount.append(icon, value);
      meta.append(separator, commentCount);
    }

    content.append(meta, title);

    if (item.excerpt) {
      const excerpt = document.createElement('span');
      excerpt.className = 'rg-latest__excerpt';
      excerpt.textContent = item.excerpt;
      content.append(excerpt);
    }

    link.append(image, content);
    grid.append(link);
  };

  document.querySelectorAll('[data-home-latest]').forEach((section) => {
    const grid = section.querySelector('[data-home-latest-grid]');
    const controls = section.querySelector('[data-home-latest-controls]');
    const button = section.querySelector('[data-home-latest-load]');

    if (!(grid instanceof HTMLElement) || !(controls instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;

    let excludedIds;

    try {
      excludedIds = new Set(JSON.parse(section.dataset.excludedPostIds || '[]'));
    } catch {
      excludedIds = new Set();
    }

    button.addEventListener('click', async () => {
      if (button.disabled) return;

      button.disabled = true;
      button.setAttribute('aria-busy', 'true');

      try {
        const params = new URLSearchParams({
          lang: section.dataset.language === 'en' ? 'en' : 'it',
          exclude: [...excludedIds].join(',')
        });
        const response = await fetch(`${section.dataset.endpoint}?${params.toString()}`, {
          headers: { Accept: 'application/json' }
        });
        const payload = await response.json();

        if (!response.ok || !payload?.ok || !Array.isArray(payload.items)) return;

        payload.items.forEach((item) => {
          appendItem(grid, item, section.dataset.language);
          if (item.id) excludedIds.add(item.id);
        });

        if (!payload.hasMore || payload.items.length === 0) controls.hidden = true;
      } catch {
        // Keep the existing visible feed and allow a later retry.
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    });
  });
</script>
