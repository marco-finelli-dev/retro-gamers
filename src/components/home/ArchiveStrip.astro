---
import '../../styles/components/archive-strip.css';
import { urlFor } from '../../lib/image';
import { getPostUrl } from '../../lib/routes';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const { posts = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const items = posts.slice(0, 4);

const labels = {
  title: isEn ? 'From our archive' : 'Dal nostro archivio',
  description: isEn
    ? 'Stories, games and machines worth rediscovering at your own pace.'
    : 'Storie, giochi e macchine da riscoprire senza fretta.',
  explore: isEn ? 'Explore the archive' : 'Esplora l’archivio',
  href: isEn ? '/en/archive/' : '/archivio/',
  fallbackCategory: isEn ? 'Archive' : 'Archivio'
};

const getImage = (post, width = 520, height = 325) => {
  if (!post?.featuredImage?.asset) return '/placeholder-retro.png';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const cleanText = (value) =>
  value?.replace(/\[…\]/g, '').trim() || '';

const getExcerpt = (post) =>
  cleanText(post?.cardExcerpt) ||
  cleanText(post?.subtitle) ||
  cleanText(post?.excerpt);

const getCategory = (post) => {
  const typeLabels = isEn
    ? {
        review: 'Review',
        feature: 'Feature',
        special: 'Feature',
        memories: 'Memories',
        memory: 'Memory',
        guide: 'Guide',
        interview: 'Interview',
        article: 'Article',
        news: 'News',
        hardware: 'Hardware'
      }
    : {
        review: 'Recensione',
        feature: 'Speciale',
        special: 'Speciale',
        memories: 'Memories',
        memory: 'Memory',
        guide: 'Guida',
        interview: 'Intervista',
        article: 'Articolo',
        news: 'News',
        hardware: 'Hardware'
      };

  const category = post?.categories?.[0];

  return (
    typeLabels[post?.type] ||
    (isEn ? category?.nameEn || category?.name : category?.name || category?.nameEn) ||
    labels.fallbackCategory
  );
};
---

{items.length > 0 && (
  <section class="section-box archive-strip">

    <div class="archive-strip__header">

      <div>
        <h2>{labels.title}</h2>
        <p>{labels.description}</p>
      </div>

      <a href={labels.href} class="archive-strip__link">
        {labels.explore}
      </a>

    </div>

    <div class="archive-strip__grid">

      {items.map((post) => (
        <a href={getPostUrl(post)} class="archive-card">

          <div class="archive-card__image">
            <img
              src={getImage(post, 520, 325)}
              alt={post.featuredImage?.alt || post.title}
              width="520"
              height="325"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="archive-card__content">
            <span>{getCategory(post)}</span>
            <CommentCountBadge count={post.commentCount} lang={lang} />
            <h3>{post.title}</h3>

            {getExcerpt(post) && (
              <p>{getExcerpt(post)}</p>
            )}
          </div>

        </a>
      ))}

    </div>

  </section>
)}
