---
import '../../styles/components/editorial-hub.css';
import { urlFor } from '../../lib/image';
import { getPostUrl } from '../../lib/routes';

const {
  specials = [],
  memories = [],
  guides = [],
  lang = 'it'
} = Astro.props;

const isEn = lang === 'en';

const labels = {
  specials: isEn ? 'Features' : 'Speciali',
  allSpecials: isEn ? 'All features' : 'Tutti gli speciali',
  memories: 'Memories',
  allMemories: isEn ? 'All memories' : 'Tutte le memories',
  quickGuides: isEn ? 'Quick guides' : 'Guide rapide',
  allGuides: isEn ? 'All guides' : 'Tutte le guide',
  platforms: isEn ? 'Platforms' : 'Piattaforme',
  allPlatforms: isEn ? 'All platforms' : 'Tutte le piattaforme'
};

const urls = {
  specials: isEn ? '/en/features/' : '/speciali/',
  memories: isEn ? '/en/memories/' : '/memories/',
  guides: isEn ? '/en/guides/' : '/guide/',
  platforms: isEn ? '/en/platforms/' : '/piattaforme/'
};

const specialItems = specials.slice(0, 5);
const mainMemory = memories[0] || null;
const memoryItems = memories.slice(1, 3);
const guideItems = guides.slice(0, 3);

const platformItems = isEn
  ? [
      {
        label: 'Consoles',
        description: 'Home and handheld systems',
        href: '/en/platforms/consoles/',
        icon: '/images/icons/console-icon.png'
      },
      {
        label: 'Computers',
        description: 'Home computers',
        href: '/en/platforms/computers/',
        icon: '/images/icons/computer-icon.png'
      },
      {
        label: 'Arcade',
        description: 'Cabinets and boards',
        href: '/en/platforms/arcade/',
        icon: '/images/icons/arcade-icon.png'
      }
    ]
  : [
      {
        label: 'Console',
        description: 'Sistemi da salotto',
        href: '/piattaforme/console/',
        icon: '/images/icons/console-icon.png'
      },
      {
        label: 'Computer',
        description: 'Home computer',
        href: '/piattaforme/computer/',
        icon: '/images/icons/computer-icon.png'
      },
      {
        label: 'Arcade',
        description: 'Cabinet e board',
        href: '/piattaforme/arcade/',
        icon: '/images/icons/arcade-icon.png'
      }
    ];

const fallbackGuides = isEn
  ? [
      'How to start collecting',
      'Emulation: the complete guide',
      'RGB: cables and signal guide'
    ]
  : [
      'Come iniziare a collezionare',
      'Emulazione: la guida completa',
      'RGB: guida ai cavi e al segnale'
    ];

const getImage = (post, width = 420, height = 263) => {
  if (!post?.featuredImage?.asset) return '/placeholder-retro.png';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const getExcerpt = (post) =>
  post?.excerpt?.replace(/\[…\]/g, '').trim() || '';

const getCategory = (post) => {
  const cat = post?.categories?.[0];
  if (!cat) return post?.type || '';

  return isEn
    ? cat.nameEn || cat.name || post?.type || ''
    : cat.name || cat.nameEn || post?.type || '';
};
---

<div class="section-box editorial-hub">

  <div class="editorial-hub__grid">

    <!-- SPECIALI / FEATURES -->
    <section class="editorial-panel editorial-panel--specials">

      <div class="editorial-panel__header">
        <h2>{labels.specials}</h2>

        <a href={urls.specials} class="editorial-panel__link">
          {labels.allSpecials}
        </a>
      </div>

      <div class="editorial-list">
        {specialItems.map((post) => (
          <a href={getPostUrl(post)} class="editorial-list-card">

            <div class="editorial-list-card__image">
              <img
                src={getImage(post, 260, 170)}
                alt={post.featuredImage?.alt || post.title}
                width="260"
                height="170"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="editorial-list-card__content">
              <span>{getCategory(post)}</span>
              <h3>{post.title}</h3>

              {getExcerpt(post) && (
                <p>{getExcerpt(post)}</p>
              )}
            </div>

          </a>
        ))}
      </div>

    </section>


    <!-- MEMORIES -->
    <section class="editorial-panel editorial-panel--memories">

      <div class="editorial-panel__header">
        <h2>{labels.memories}</h2>

        <a href={urls.memories} class="editorial-panel__link">
          {labels.allMemories}
        </a>
      </div>

      {mainMemory && (
        <a href={getPostUrl(mainMemory)} class="memory-feature">

          <div class="memory-feature__image">
            <img
              src={getImage(mainMemory, 640, 400)}
              alt={mainMemory.featuredImage?.alt || mainMemory.title}
              width="640"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="memory-feature__content">
            <span>{getCategory(mainMemory)}</span>
            <h3>{mainMemory.title}</h3>

            {getExcerpt(mainMemory) && (
              <p>{getExcerpt(mainMemory)}</p>
            )}
          </div>

        </a>
      )}

      {memoryItems.length > 0 && (
        <div class="memory-mini-list">
          {memoryItems.map((post) => (
            <a href={getPostUrl(post)} class="memory-mini-card">

              <div class="memory-mini-card__image">
                <img
                  src={getImage(post, 220, 140)}
                  alt={post.featuredImage?.alt || post.title}
                  width="220"
                  height="140"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="memory-mini-card__content">
                <span>{getCategory(post)}</span>
                <strong>{post.title}</strong>
              </div>

            </a>
          ))}
        </div>
      )}

    </section>


    <!-- ASIDE -->
    <aside class="editorial-aside">

      <!-- GUIDE -->
      <section class="editorial-panel editorial-panel--guides">

        <div class="editorial-panel__header">
          <h2>{labels.quickGuides}</h2>
        </div>

     <div class="quick-guides">

  {guideItems.length > 0 ? (
    guideItems.map((post) => (
      <a href={getPostUrl(post)} class="quick-guide">

        <span class="quick-guide__icon" aria-hidden="true">
          <img
            src="/images/icons/retro-gamers-section-logo.png"
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
          />
        </span>

        <strong>{post.title}</strong>

      </a>
    ))
  ) : (
    !isEn && fallbackGuides.map((title) => (
      <a href={urls.guides} class="quick-guide">

        <span class="quick-guide__icon" aria-hidden="true">
          <img
            src="/images/icons/retro-gamers-section-logo.png"
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
          />
        </span>

        <strong>{title}</strong>

      </a>
    ))
  )}

</div>

        <a href={urls.guides} class="editorial-panel__footer-link">
          {labels.allGuides}
        </a>

      </section>


      <!-- PIATTAFORME / PLATFORMS -->
      <section class="editorial-panel editorial-panel--platforms">

        <div class="editorial-panel__header">
          <h2>{labels.platforms}</h2>
        </div>

        <div class="platform-shortcuts">
          {platformItems.map((item) => (
            <a href={item.href} class="platform-shortcut">

              <span class="platform-shortcut__icon" aria-hidden="true">
                <img
                  src={item.icon}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                />
              </span>

              <span class="platform-shortcut__text">
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </span>

            </a>
          ))}
        </div>

        <a href={urls.platforms} class="editorial-panel__footer-link">
          {labels.allPlatforms}
        </a>

      </section>

    </aside>

  </div>

</div>