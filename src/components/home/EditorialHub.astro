---
import '../../styles/components/editorial-hub.css';
import { urlFor } from '../../lib/image';
import {
  getArchiveUrl,
  getPostUrl
} from '../../lib/routes';
import CommentCountBadge from '../common/CommentCountBadge.astro';

const {
  specials = [],
  memories = [],
  guides = [],
  lang = 'it'
} = Astro.props;

const isEn = lang === 'en';

const labels = {
  specials: isEn ? 'Features' : 'Speciali',
  allSpecials: isEn ? 'All features' : 'Tutti gli speciali',
  memories: 'Memories',
  allMemories: isEn ? 'All memories' : 'Tutte le memories',
  quickGuides: isEn ? 'Quick guides' : 'Guide rapide',
  allGuides: isEn ? 'All guides' : 'Tutte le guide'
};

const urls = {
  specials: getArchiveUrl('feature', lang),
  memories: getArchiveUrl('memories', lang),
  guides: getArchiveUrl('guide', lang)
};

const specialItems = specials.slice(0, 4);
const mainMemory = memories[0] || null;
const memoryItems = memories.slice(1, 3);
const guideItems = guides.slice(0, 3);

const fallbackGuides = isEn
  ? [
      'How to start collecting',
      'Emulation: the complete guide',
      'RGB: cables and signal guide'
    ]
  : [
      'Come iniziare a collezionare',
      'Emulazione: la guida completa',
      'RGB: guida ai cavi e al segnale'
    ];

const getImage = (post, width = 420, height = 263) => {
  if (!post?.featuredImage?.asset) return '/og-image.jpg';

  return urlFor(post.featuredImage)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(72)
    .auto('format')
    .url();
};

const cleanText = (value) =>
  value?.replace(/\[…\]/g, '').trim() || '';

const getExcerpt = (post) =>
  cleanText(post?.cardExcerpt) ||
  cleanText(post?.subtitle) ||
  cleanText(post?.excerpt);

const getCategory = (post) => {
  const cat = post?.categories?.[0];
  if (!cat) return post?.type || '';

  return isEn
    ? cat.nameEn || cat.name || post?.type || ''
    : cat.name || cat.nameEn || post?.type || '';
};
---

<div class="editorial-modules">
<div class="section-box editorial-hub">

  <div class="editorial-hub__grid">

    <!-- SPECIALI / FEATURES -->
    <section class="editorial-panel editorial-panel--specials">

      <div class="editorial-panel__header">
        <h2>{labels.specials}</h2>

        <a href={urls.specials} class="editorial-panel__link rg-magazine-link">
          {labels.allSpecials}
        </a>
      </div>

      <div class="editorial-list">
        {specialItems.map((post, index) => (
          <a
            href={getPostUrl(post)}
            class:list={[
              'editorial-list-card',
              index === 0
                ? 'editorial-list-card--feature'
                : 'editorial-list-card--secondary'
            ]}
          >

            <div class="editorial-list-card__image">
              <img
                src={getImage(post, index === 0 ? 640 : 280, index === 0 ? 360 : 210)}
                alt={post.featuredImage?.alt || post.title}
                width={index === 0 ? 640 : 280}
                height={index === 0 ? 360 : 210}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="editorial-list-card__content">
              <div class="rg-card-meta-inline">
                <span>{getCategory(post)}</span>
                <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" />
              </div>
              <h3>{post.title}</h3>

              {getExcerpt(post) && (
                <p>{getExcerpt(post)}</p>
              )}
            </div>

          </a>
        ))}
      </div>

    </section>


    <!-- MEMORIES -->
    <section class="editorial-panel editorial-panel--memories">

      <div class="editorial-panel__header">
        <h2>{labels.memories}</h2>

        <a href={urls.memories} class="editorial-panel__link rg-magazine-link">
          {labels.allMemories}
        </a>
      </div>

      {mainMemory && (
        <a href={getPostUrl(mainMemory)} class="memory-feature">

          <div class="memory-feature__image">
            <img
              src={getImage(mainMemory, 640, 360)}
              alt={mainMemory.featuredImage?.alt || mainMemory.title}
              width="640"
              height="360"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="memory-feature__content">
            <div class="rg-card-meta-inline">
              <span>{getCategory(mainMemory)}</span>
              <CommentCountBadge count={mainMemory.commentCount} lang={lang} variant="compact" />
            </div>
            <h3>{mainMemory.title}</h3>

            {getExcerpt(mainMemory) && (
              <p>{getExcerpt(mainMemory)}</p>
            )}
          </div>

        </a>
      )}

      {memoryItems.length > 0 && (
        <div class="memory-mini-list">
          {memoryItems.map((post) => (
            <a href={getPostUrl(post)} class="memory-mini-card">

              <div class="memory-mini-card__image">
                <img
                  src={getImage(post, 220, 165)}
                  alt={post.featuredImage?.alt || post.title}
                width="220"
                height="165"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="memory-mini-card__content">
              <div class="rg-card-meta-inline">
                <span>{getCategory(post)}</span>
                <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" />
              </div>
              <strong>{post.title}</strong>
              </div>

            </a>
          ))}
        </div>
      )}

    </section>


  </div>
</div>

<div class="section-box editorial-hub">
      <!-- GUIDE -->
      <section class="editorial-panel editorial-panel--guides">

        <div class="editorial-panel__header">
          <h2>{labels.quickGuides}</h2>
          <a href={urls.guides} class="editorial-panel__link rg-magazine-link">
            {labels.allGuides}
          </a>
        </div>

     <div class="quick-guides">

  {guideItems.length > 0 ? (
    guideItems.map((post) => (
      <a href={getPostUrl(post)} class="quick-guide">

        <span class="quick-guide__image">
          <img
            src={getImage(post, 320, 240)}
            alt={post.featuredImage?.alt || post.title}
            width="320"
            height="240"
            loading="lazy"
            decoding="async"
          />
        </span>

        <strong>{post.title}</strong>
        <CommentCountBadge count={post.commentCount} lang={lang} variant="compact" />

      </a>
    ))
  ) : (
    !isEn && fallbackGuides.map((title) => (
      <a href={urls.guides} class="quick-guide">

        <strong>{title}</strong>

      </a>
    ))
  )}

</div>

      </section>


</div>

</div>
