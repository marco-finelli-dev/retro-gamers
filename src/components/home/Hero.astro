---
import '../../styles/components/hero.css';
import { getPostUrl } from '../../lib/routes';
import { urlFor } from '../../lib/image';
import { getReviewBadge } from '../../lib/reviewBadges';

const { posts = [], lang = 'it' } = Astro.props;

const isEn = lang === 'en';

const [main, ...rest] = posts || [];
const side = rest.slice(0, 4);
const mainReviewBadge = getReviewBadge(main?.rating?.overall ?? main?.score, lang);

const cleanText = (value) =>
  value?.replace(/\[…\]/g, '').trim() || '';

const getExcerpt = (post) =>
  cleanText(post?.cardExcerpt) ||
  cleanText(post?.subtitle) ||
  cleanText(post?.excerpt);

const getCategory = (post) => {
  const cat = post?.categories?.[0];
  if (!cat) return '';

  return isEn
    ? cat.nameEn || cat.name || ''
    : cat.name || cat.nameEn || '';
};

const getTypeLabel = (type) => {
  const map = isEn
    ? {
        review: 'Review',
        article: 'Article',
        guide: 'Guide',
        interview: 'Interview',
        news: 'News',
        feature: 'Feature',
        special: 'Feature',
        memories: 'Memories',
        hardware: 'Hardware'
      }
    : {
        review: 'Recensione',
        article: 'Articolo',
        guide: 'Guida',
        interview: 'Intervista',
        news: 'News',
        feature: 'Speciale',
        special: 'Speciale',
        memories: 'Memories',
        hardware: 'Hardware'
      };

  return map[type] || type || (isEn ? 'Article' : 'Articolo');
};

const getImage = (image, width = 960, height = null) => {
  if (!image?.asset) return '';

  let builder = urlFor(image)
    .width(width)
    .quality(74)
    .auto('format');

  if (height) {
    builder = builder.height(height).fit('crop');
  }

  return builder.url();
};

const getMainImageSrcSet = (image) =>
  [
    [760, 570],
    [960, 720],
    [1200, 900]
  ]
    .map(([width, height]) => `${getImage(image, width, height)} ${width}w`)
    .join(', ');

const getCommentLabel = (count) => {
  const value = Number(count || 0);

  return isEn
    ? `${value} ${value === 1 ? 'comment' : 'comments'}`
    : `${value} ${value === 1 ? 'commento' : 'commenti'}`;
};
---

<div class="rg-hero">
  <div class="rg-hero__grid">

    {main && (
      <a href={getPostUrl(main)} class="rg-hero-main">

        {main.featuredImage?.asset && (
          <div class="rg-hero-main__visual">
            <img
              src={getImage(main.featuredImage, 1200, 900)}
              srcset={getMainImageSrcSet(main.featuredImage)}
              sizes="(max-width: 768px) calc(100vw - 68px), (max-width: 960px) calc(100vw - 100px), 62vw"
              alt={main.featuredImage?.alt || main.title}
              width="1200"
              height="900"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />

            {mainReviewBadge && (
              <img
                src={mainReviewBadge.src}
                alt={mainReviewBadge.alt}
                class={`review-badge review-badge--hero review-badge--${mainReviewBadge.key}`}
                width="1024"
                height="1024"
                loading="eager"
                decoding="async"
              />
            )}
          </div>
        )}

        <div class="rg-hero-main__content">

          <div class="rg-hero__meta">
            <span>{getTypeLabel(main.type)}</span>

            {getCategory(main) && (
              <small>{getCategory(main)}</small>
            )}

            {Number(main.commentCount || 0) > 0 && (
              <span class="hero-comment-pill" aria-label={getCommentLabel(main.commentCount)}>
                <i aria-hidden="true"></i>
                <b>{main.commentCount}</b>
              </span>
            )}
          </div>

          <h2>{main.title}</h2>

          {getExcerpt(main) && (
            <p>{getExcerpt(main)}</p>
          )}

        </div>

      </a>
    )}

    <div class="rg-hero-side-list">
      {side.map((post, index) => {
        const cat = getCategory(post);
        const isLead = index === 0;

        return (
          <a
            href={getPostUrl(post)}
            class:list={[
              'rg-hero-side-card',
              isLead ? 'rg-hero-side-card--lead' : 'rg-hero-side-card--compact'
            ]}
          >

            {post.featuredImage?.asset && (
              <div class="rg-hero-side-card__visual">
                <img
                  src={getImage(post.featuredImage, isLead ? 640 : 320, isLead ? 480 : 240)}
                  alt={post.featuredImage?.alt || post.title}
                  width={isLead ? 640 : 320}
                  height={isLead ? 480 : 240}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <div class="rg-hero-side-card__content">

              <div class="rg-hero__meta small">
                <span>{getTypeLabel(post.type)}</span>

                {cat && (
                  <small>{cat}</small>
                )}

                {Number(post.commentCount || 0) > 0 && (
                  <span class="hero-comment-pill" aria-label={getCommentLabel(post.commentCount)}>
                    <i aria-hidden="true"></i>
                    <b>{post.commentCount}</b>
                  </span>
                )}
              </div>

              <h3>{post.title}</h3>

            </div>

          </a>
        );
      })}
    </div>

  </div>

</div>
