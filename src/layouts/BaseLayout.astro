---
import '../styles/global.css';

import Header from '../components/header/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentAnalytics from '../components/common/ConsentAnalytics.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import CookieConsent from '../components/common/CookieConsent.astro';
import SanityVisualEditing from '../components/common/SanityVisualEditing';
import RetroExperienceLauncher from '../components/retro-experience/RetroExperienceLauncher.astro';
import { getAllPosts } from '../lib/posts';
import { getLanguageSwitchUrl } from '../lib/language-switch.js';
import { isDraftMode } from '../lib/sanity-preview';
import '../styles/components/support.css';
import '../styles/components/cookie-consent.css';

const {
  reviews: providedReviews = null,
  news: providedNews = null,

  lang = 'it',
  languageSwitch = null,
  alternateLanguages = [],

  title = 'Retro-Gamers.it',
  description = 'Retro-Gamers.it: recensioni, news, speciali, guide e approfondimenti dal mondo retro-gaming, console, arcade e home computer.',
  image = '/og-image.jpg',
  canonical = Astro.url.href,
  type = 'website',
  publishedAt = null,
  updatedAt = null,
  articleAuthorName = null,
  articleAuthorUrl = null,
  noindex = false,
  structuredData = [],
  minimal = false
} = Astro.props;

const hasProvidedReviews =
  Array.isArray(providedReviews) && providedReviews.length > 0;

const hasProvidedNews =
  Array.isArray(providedNews) && providedNews.length > 0;

const needsMenuPosts = !minimal && (!hasProvidedReviews || !hasProvidedNews);

const menuPosts = needsMenuPosts ? await getAllPosts() : [];

const fallbackReviews = menuPosts.filter((post) => {
  const postLang = post.language || 'it';
  return post.type === 'review' && postLang === lang;
});

const fallbackNews = menuPosts.filter((post) => {
  const postLang = post.language || 'it';
  return post.type === 'news' && postLang === lang;
});

const reviews = hasProvidedReviews ? providedReviews : fallbackReviews;
const news = hasProvidedNews ? providedNews : fallbackNews;

const resolvedLanguageSwitchUrl = getLanguageSwitchUrl({
  currentUrl: Astro.url,
  lang,
  languageSwitch,
  alternateLanguages
});

const resolvedLanguageSwitch = {
  ...(typeof languageSwitch === 'object' && languageSwitch ? languageSwitch : {}),
  url: resolvedLanguageSwitchUrl
};

const siteName = 'Retro-Gamers.it';
const siteUrl = 'https://www.retro-gamers.it';
const siteCanonicalUrl = `${siteUrl}/`;
const organizationId = `${siteCanonicalUrl}#organization`;
const websiteId = `${siteCanonicalUrl}#website`;
const organizationDescription =
  'Retro-Gamers.it è un progetto editoriale internazionale dedicato alla storia dei videogiochi, al retro gaming, alle console, agli home computer, agli arcade, ai creator e alla preservazione digitale.';

const pageTitle =
  title === siteName
    ? siteName
    : `${title} | ${siteName}`;

const pageDescription = description;

const absoluteImage = image?.startsWith('http')
  ? image
  : `${siteUrl}${image}`;

const canonicalUrl = canonical?.startsWith('http')
  ? canonical
  : `${siteUrl}${canonical}`;

const ogLocale = lang === 'en' ? 'en_US' : 'it_IT';
const resolvedArticleAuthorName =
  typeof articleAuthorName === 'string' && articleAuthorName.trim()
    ? articleAuthorName.trim()
    : 'Marco Finelli';
const resolvedArticleAuthorUrl =
  typeof articleAuthorUrl === 'string' && articleAuthorUrl.trim()
    ? articleAuthorUrl.trim()
    : '';
const absoluteArticleAuthorUrl = resolvedArticleAuthorUrl
  ? resolvedArticleAuthorUrl.startsWith('http')
    ? resolvedArticleAuthorUrl
    : `${siteUrl}${
        resolvedArticleAuthorUrl.startsWith('/')
          ? resolvedArticleAuthorUrl
          : `/${resolvedArticleAuthorUrl}`
      }`
  : '';
const articleAuthorJsonLd = {
  '@type': 'Person',
  name: resolvedArticleAuthorName,
  ...(absoluteArticleAuthorUrl ? { url: absoluteArticleAuthorUrl } : {})
};

const organizationJsonLd = {
  '@type': 'Organization',
  '@id': organizationId,
  name: siteName,
  url: siteCanonicalUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/logo.png`
  },
  description: organizationDescription,
  founder: {
    '@type': 'Person',
    name: 'Marco Finelli'
  }
};

const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': websiteId,
  inLanguage: lang,
  name: siteName,
  url: siteCanonicalUrl,
  description: pageDescription,
  publisher: {
    '@id': organizationId
  }
};

const articleJsonLd = {
  '@type': 'Article',
  inLanguage: lang,
  headline: title,
  description: pageDescription,
  image: absoluteImage ? [absoluteImage] : undefined,
  datePublished: publishedAt || undefined,
  dateModified: updatedAt || publishedAt || undefined,
  author: articleAuthorJsonLd,
  publisher: {
    '@id': organizationId
  },
  isPartOf: {
    '@id': websiteId
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl
  }
};

const additionalJsonLdNodes = Array.isArray(structuredData)
  ? structuredData.filter(Boolean)
  : structuredData
    ? [structuredData]
    : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationJsonLd,
    websiteJsonLd,
    ...(type === 'article' ? [articleJsonLd] : []),
    ...additionalJsonLdNodes
  ]
};

const isPreview = isDraftMode(Astro.cookies);

if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
  Astro.response.headers.set('Vary', 'Cookie');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
---

<html lang={lang}>
  <head>
    <script is:inline>
      const storedTheme = localStorage.getItem('rg-theme');

      const themePreference =
        storedTheme === 'dark' || storedTheme === 'light' || storedTheme === 'system'
          ? storedTheme
          : 'system';

      const resolvedTheme =
        themePreference === 'system'
          ? window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark'
          : themePreference;

      document.documentElement.dataset.theme = resolvedTheme;
      document.documentElement.dataset.themePreference = themePreference;
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#008EA3" />
    <meta name="theme-color" content="#080A10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F2F7FB" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Retro-Gamers" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {noindex && (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <link rel="canonical" href={canonicalUrl} />

    {alternateLanguages.map((item) => (
      <link
        rel="alternate"
        hreflang={item.lang}
        href={item.url}
      />
    ))}

    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={absoluteImage} />

    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}

    {type === 'article' && updatedAt && (
      <meta property="article:modified_time" content={updatedAt} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

  </head>

  <body>
    {!minimal && <RetroExperienceLauncher />}

    {!minimal && (
      <Header
        reviews={reviews}
        news={news}
        lang={lang}
        languageSwitch={resolvedLanguageSwitch}
      />
    )}

    <main>
      <slot />
    </main>

    {!minimal && <Footer lang={lang} />}

    {!minimal && (
      <>
        <ConsentAnalytics />
        <CookieConsent />
        <Analytics />
        <SpeedInsights />
      </>
    )}

    {isPreview && <SanityVisualEditing client:only="react" />}

    {!minimal && <script src="/scripts/ui.js" defer></script>}
    <script>
      import { trackRgEvent } from '../lib/analytics/client';

      const oauthAnalyticsWindow = window as Window & {
        __rgOAuthLoginAnalyticsHandled?: boolean;
        __rgLanguageSwitchAnalyticsAttached?: boolean;
      };

      const normalizeSwitchLanguage = (value: string | null | undefined): 'it' | 'en' | '' =>
        value === 'it' || value === 'en' ? value : '';

      const normalizeOAuthMethod = (value: string | null): 'google' | 'facebook' | 'apple' | '' =>
        value === 'google' || value === 'facebook' || value === 'apple' ? value : '';

      const normalizeLoginDestination = (value: string | null): 'account' | 'previous_page' | 'home' | '' =>
        value === 'account' || value === 'previous_page' || value === 'home'
          ? value
          : '';

      const normalizeLanguageSwitchPlacement = (
        value: string | null | undefined
      ): 'header' | 'mobile_menu' | 'article_translation' | '' =>
        value === 'header' || value === 'mobile_menu' || value === 'article_translation'
          ? value
          : '';

      const getDestinationFromPath = (pathname: string): 'account' | 'previous_page' | 'home' => {
        if (pathname === '/' || pathname === '/en/' || pathname === '/en') {
          return 'home';
        }

        if (/^\/(?:en\/)?account(?:\/|$)/.test(pathname)) {
          return 'account';
        }

        return 'previous_page';
      };

      const removeOAuthAnalyticsMarker = (url: URL) => {
        url.searchParams.delete('rg_oauth_login');
        url.searchParams.delete('rg_login_destination');

        const search = url.searchParams.toString();
        const cleanedUrl = `${url.pathname}${search ? `?${search}` : ''}${url.hash}`;

        window.history.replaceState(window.history.state, '', cleanedUrl);
      };

      const currentUrl = new URL(window.location.href);
      const oauthMethod = normalizeOAuthMethod(currentUrl.searchParams.get('rg_oauth_login'));
      const oauthDestination = normalizeLoginDestination(
        currentUrl.searchParams.get('rg_login_destination')
      );

      if (currentUrl.searchParams.has('rg_oauth_login')) {
        removeOAuthAnalyticsMarker(currentUrl);
      }

      if (oauthMethod && !oauthAnalyticsWindow.__rgOAuthLoginAnalyticsHandled) {
        oauthAnalyticsWindow.__rgOAuthLoginAnalyticsHandled = true;

        const destination =
          oauthDestination || getDestinationFromPath(window.location.pathname);

        trackRgEvent('login_success', {
          language: document.documentElement.lang === 'en' ? 'en' : 'it',
          method: oauthMethod,
          destination,
        });
      }

      if (!oauthAnalyticsWindow.__rgLanguageSwitchAnalyticsAttached) {
        oauthAnalyticsWindow.__rgLanguageSwitchAnalyticsAttached = true;

        document.addEventListener('click', (event) => {
          const languageSwitch = event.target instanceof Element
            ? event.target.closest('[data-rg-language-switch]')
            : null;

          if (!(languageSwitch instanceof HTMLAnchorElement)) return;
          if (!languageSwitch.getAttribute('href')) return;

          const fromLanguage = normalizeSwitchLanguage(
            languageSwitch.dataset.rgLanguageSwitchFrom
          );
          const toLanguage = normalizeSwitchLanguage(
            languageSwitch.dataset.rgLanguageSwitchTo
          );
          const placement = normalizeLanguageSwitchPlacement(
            languageSwitch.dataset.rgLanguageSwitchPlacement
          );

          if (!fromLanguage || !toLanguage || fromLanguage === toLanguage || !placement) {
            return;
          }

          trackRgEvent('language_switch', {
            from_language: fromLanguage,
            to_language: toLanguage,
            placement,
            ...(languageSwitch.dataset.rgLanguageSwitchContentType
              ? { content_type: languageSwitch.dataset.rgLanguageSwitchContentType }
              : {}),
          });
        });
      }
    </script>
    <script>
      import '../scripts/theme.ts';
    </script>
  </body>
</html>
