---
import '../styles/global.css';

import Header from '../components/header/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentAnalytics from '../components/common/ConsentAnalytics.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import CookieConsent from '../components/common/CookieConsent.astro';
import { getAllPosts } from '../lib/posts';
import { getLanguageSwitchUrl } from '../lib/language-switch.js';
import '../styles/components/support.css';
import '../styles/pages/legal.css';
import '../styles/components/cookie-consent.css';
import '../styles/pages/author.css';
import '../styles/pages/error.css';

const {
  reviews: providedReviews = null,
  news: providedNews = null,

  lang = 'it',
  languageSwitch = null,
  alternateLanguages = [],

  title = 'Retro-Gamers.it',
  description = 'Retro-Gamers.it: recensioni, news, speciali, guide e approfondimenti dal mondo retro-gaming, console, arcade e home computer.',
  image = '/og-image.jpg',
  canonical = Astro.url.href,
  type = 'website',
  publishedAt = null,
  updatedAt = null,
  noindex = false
} = Astro.props;

const hasProvidedReviews =
  Array.isArray(providedReviews) && providedReviews.length > 0;

const hasProvidedNews =
  Array.isArray(providedNews) && providedNews.length > 0;

const needsMenuPosts = !hasProvidedReviews || !hasProvidedNews;

const menuPosts = needsMenuPosts ? await getAllPosts() : [];

const fallbackReviews = menuPosts.filter((post) => {
  const postLang = post.language || 'it';
  return post.type === 'review' && postLang === lang;
});

const fallbackNews = menuPosts.filter((post) => {
  const postLang = post.language || 'it';
  return post.type === 'news' && postLang === lang;
});

const reviews = hasProvidedReviews ? providedReviews : fallbackReviews;
const news = hasProvidedNews ? providedNews : fallbackNews;

const resolvedLanguageSwitchUrl = getLanguageSwitchUrl({
  currentUrl: Astro.url,
  lang,
  languageSwitch,
  alternateLanguages
});

const resolvedLanguageSwitch = {
  ...(typeof languageSwitch === 'object' && languageSwitch ? languageSwitch : {}),
  url: resolvedLanguageSwitchUrl
};

const siteName = 'Retro-Gamers.it';
const siteUrl = 'https://www.retro-gamers.it';

const pageTitle =
  title === siteName
    ? siteName
    : `${title} | ${siteName}`;

const pageDescription = description;

const absoluteImage = image?.startsWith('http')
  ? image
  : `${siteUrl}${image}`;

const canonicalUrl = canonical?.startsWith('http')
  ? canonical
  : `${siteUrl}${canonical}`;

const ogLocale = lang === 'en' ? 'en_US' : 'it_IT';

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        inLanguage: lang,
        headline: title,
        description: pageDescription,
        image: absoluteImage ? [absoluteImage] : undefined,
        datePublished: publishedAt || undefined,
        dateModified: updatedAt || publishedAt || undefined,
        author: {
          '@type': 'Person',
          name: 'Marco Finelli'
        },
        publisher: {
          '@type': 'Organization',
          name: siteName,
          logo: {
            '@type': 'ImageObject',
            url: `${siteUrl}/logo.png`
          }
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl
        }
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        inLanguage: lang,
        name: siteName,
        url: siteUrl,
        description: pageDescription
      };
---

<html lang={lang}>
  <head>
    <script is:inline>
      const storedTheme = localStorage.getItem('rg-theme');

      const themePreference =
        storedTheme === 'dark' || storedTheme === 'light' || storedTheme === 'system'
          ? storedTheme
          : 'system';

      const resolvedTheme =
        themePreference === 'system'
          ? window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark'
          : themePreference;

      document.documentElement.dataset.theme = resolvedTheme;
      document.documentElement.dataset.themePreference = themePreference;
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#008EA3" />
    <meta name="theme-color" content="#080A10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F2F7FB" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Retro-Gamers" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {noindex && (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <link rel="canonical" href={canonicalUrl} />

    {alternateLanguages.map((item) => (
      <link
        rel="alternate"
        hreflang={item.lang}
        href={item.url}
      />
    ))}

    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={absoluteImage} />

    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}

    {type === 'article' && updatedAt && (
      <meta property="article:modified_time" content={updatedAt} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header
      reviews={reviews}
      news={news}
      lang={lang}
      languageSwitch={resolvedLanguageSwitch}
    />

    <main>
      <slot />
    </main>

    <Footer lang={lang} />

    <ConsentAnalytics />
    <CookieConsent />
    <Analytics />
    <SpeedInsights />

    <script src="/scripts/ui.js" defer></script>
    <script src="/scripts/dropdown.js" defer></script>
    <script>
      import '../scripts/theme.ts';
    </script>
  </body>
</html>
