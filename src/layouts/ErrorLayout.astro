---
// Deliberately independent of BaseLayout, navigation, auth and editorial loaders.
import '../styles/global.css';
import '../styles/pages/error.css';

interface Props { title: string; lang?: 'it' | 'en' }
const { title, lang = 'it' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="error-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark light" />
    <title>{title} | Retro-Gamers.it</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Storage can be unavailable in private/restricted browsers. The error
      // page must remain usable, following the same preference as the site.
      (() => {
        let preference = 'system';
        try { preference = localStorage.getItem('rg-theme') || 'system'; } catch {}
        const light = preference === 'light' ||
          (preference !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
        document.documentElement.dataset.theme = light ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body class="error-shell">
    <header class="error-shell__header">
      <a class="error-shell__brand" href={lang === 'en' ? '/en/' : '/'} aria-label="Retro-Gamers.it — Home">
        <img class="error-shell__logo-dark" src="/images/brand/retro-gamers-logo-ivory.svg" width="223" height="57" alt="Retro-Gamers.it" />
        <img class="error-shell__logo-light" src="/images/brand/retro-gamers-logo-navy.svg" width="223" height="57" alt="Retro-Gamers.it" />
      </a>
    </header>
    <main><slot /></main>
  </body>
</html>
