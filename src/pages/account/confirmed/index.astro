---
import '../../../styles/pages/account.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Email confermata | Retro-Gamers.it';
const description = 'Il tuo indirizzo email è stato confermato. Ora puoi accedere al tuo account Retro-Gamers.it.';
---

<BaseLayout title={title} description={description}>
  <div class="account-page">
    <section class="account-card">
      <p class="account-kicker">Profilo lettore</p>
      <h1>Email confermata</h1>
      <p>
        Il tuo indirizzo email è stato confermato. Ora puoi accedere al tuo account Retro-Gamers.it.
      </p>

      <div class="account-actions account-actions--standalone">
        <a href="/account/login/">Accedi</a>
      </div>
    </section>
  </div>
</BaseLayout>
