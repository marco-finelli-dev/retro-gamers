---
import '../../../styles/pages/account.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getActiveReaderBadges } from '../../../lib/badges';

const title = 'Registrati su Retro-Gamers.it';
const description = 'Crea un profilo lettore per commentare gli articoli di Retro-Gamers.it.';

const badges = await getActiveReaderBadges();
const encodedReturnTo = encodeURIComponent('/account/');
const enableAppleLogin = false;
const enableFacebookLogin = false;
const socialProviders = [
  {
    provider: 'google',
    label: 'Continua con Google',
    iconLight: '/icons/oauth/google-light.webp',
    iconDark: '/icons/oauth/google-dark.webp',
  },
  ...(enableAppleLogin
    ? [
        {
          provider: 'apple',
          label: 'Continua con Apple',
          iconLight: '/icons/oauth/apple-light.webp',
          iconDark: '/icons/oauth/apple-dark.webp',
        },
      ]
    : []),
  ...(enableFacebookLogin
    ? [
        {
          provider: 'facebook',
          label: 'Continua con Facebook',
          iconLight: '/icons/oauth/facebook-light.webp',
          iconDark: '/icons/oauth/facebook-dark.webp',
        },
      ]
    : []),
];
---

<BaseLayout title={title} description={description}>
  <main class="account-page">
    <section class="account-card">
      <p class="account-kicker">Profilo lettore</p>
      <h1>Registrati</h1>
      <p>Scegli un nickname, un badge e partecipa alle discussioni sotto gli articoli.</p>

      <div class:list={['account-social-auth', socialProviders.length === 1 && 'account-social-auth--single']} aria-label="Registrazione social">
        {socialProviders.map((provider) => (
          <a
            href={`/api/auth/oauth/start?provider=${provider.provider}&returnTo=${encodedReturnTo}`}
            aria-label={provider.label}
          >
            <span class="account-social-auth__icons" aria-hidden="true">
              <img
                class="account-social-auth__icon account-social-auth__icon--light"
                src={provider.iconLight}
                alt=""
                width="24"
                height="24"
                loading="lazy"
              />
              <img
                class="account-social-auth__icon account-social-auth__icon--dark"
                src={provider.iconDark}
                alt=""
                width="24"
                height="24"
                loading="lazy"
              />
            </span>
            <span>{provider.label}</span>
          </a>
        ))}
      </div>

      <div class="account-divider" aria-hidden="true">
        <span>oppure</span>
      </div>

      <form class="account-form" data-register-form>
        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>Password</span>
          <input type="password" name="password" required minlength="8" autocomplete="new-password" />
        </label>

        <label>
          <span>Username</span>
          <input type="text" name="username" required minlength="3" maxlength="24" autocomplete="username" />
        </label>

        <label>
          <span>Nome visualizzato</span>
          <input type="text" name="displayName" required minlength="2" maxlength="40" />
        </label>

        <label>
          <span>Badge lettore</span>
          <select name="badgeKey" required>
            <option value="">Scegli un badge</option>
            {badges.map((badge) => (
              <option value={badge.key}>{badge.label_it || badge.label_en || badge.key}</option>
            ))}
          </select>
        </label>

        <p class="account-message" data-account-message hidden></p>

        <button type="submit">Crea account</button>
      </form>

      <p class="account-switch">
        Hai già un account?
        <a href="/account/login/">Accedi</a>
      </p>

      <p class="account-resend-confirmation">
        <button type="button" data-resend-confirmation>
          Non hai ricevuto la mail? Reinvia conferma
        </button>
      </p>
    </section>
  </main>

  <script>
    const form = document.querySelector('[data-register-form]');
    const message = document.querySelector('[data-account-message]');
    const resendButton = document.querySelector('[data-resend-confirmation]');
    let lastConfirmationEmail = '';

    const showMessage = (text, type = 'ok') => {
      if (!message) return;
      message.textContent = text;
      message.hidden = false;
      message.dataset.type = type;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const button = form.querySelector('button[type="submit"]');

      if (button) button.disabled = true;

      try {
        const email = String(formData.get('email') || '').trim();

        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            password: String(formData.get('password') || ''),
            username: String(formData.get('username') || ''),
            displayName: String(formData.get('displayName') || ''),
            badgeKey: String(formData.get('badgeKey') || '')
          })
        });

        const result = await response.json();

        if (!result.ok) {
          if (result.code === 'email_not_confirmed') {
            lastConfirmationEmail = email;
          }

          showMessage(result.error || 'Registrazione non riuscita.', 'error');
          return;
        }

        lastConfirmationEmail = email;
        showMessage(result.message || 'Registrazione ricevuta. Controlla la tua email per confermare l’account.', 'ok');
        form.reset();
      } catch {
        showMessage('Errore di connessione. Riprova.', 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });

    resendButton?.addEventListener('click', async () => {
      const emailInput = form?.querySelector('input[name="email"]');
      const typedEmail = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      const email = typedEmail || lastConfirmationEmail;

      if (!email) {
        showMessage('Inserisci la tua email nel campo sopra, poi richiedi un nuovo link.', 'error');
        emailInput?.focus();
        return;
      }

      resendButton.disabled = true;

      try {
        const response = await fetch('/api/auth/resend-confirmation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(result.error || 'Richiesta non completata. Riprova più tardi.', 'error');
          return;
        }

        showMessage(result.message || 'Se l’indirizzo è valido, riceverai una nuova email di conferma.', 'ok');
      } catch {
        showMessage('Errore di connessione. Riprova.', 'error');
      } finally {
        resendButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
