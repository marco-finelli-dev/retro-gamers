---
import '../../../styles/pages/account.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Accedi a Retro-Gamers.it';
const description = 'Accedi al tuo profilo lettore per commentare gli articoli di Retro-Gamers.it.';
const returnTo = Astro.url.searchParams.get('returnTo') || '/';
const encodedReturnTo = encodeURIComponent(returnTo);
const oauthError = Astro.url.searchParams.get('oauthError');
const oauthErrorMessage = oauthError
  ? 'Accesso social non completato. Riprova oppure usa email e password.'
  : '';
const enableAppleLogin = false;
const enableFacebookLogin = false;
const socialProviders = [
  {
    provider: 'google',
    label: 'Continua con Google',
    iconLight: '/icons/oauth/google-light.webp',
    iconDark: '/icons/oauth/google-dark.webp',
  },
  ...(enableAppleLogin
    ? [
        {
          provider: 'apple',
          label: 'Continua con Apple',
          iconLight: '/icons/oauth/apple-light.webp',
          iconDark: '/icons/oauth/apple-dark.webp',
        },
      ]
    : []),
  ...(enableFacebookLogin
    ? [
        {
          provider: 'facebook',
          label: 'Continua con Facebook',
          iconLight: '/icons/oauth/facebook-light.webp',
          iconDark: '/icons/oauth/facebook-dark.webp',
        },
      ]
    : []),
];
---

<BaseLayout title={title} description={description}>
  <main class="account-page">
    <section class="account-card">
      <p class="account-kicker">Profilo lettore</p>
      <h1>Accedi</h1>
      <p>Entra con il tuo account per partecipare alle discussioni sotto gli articoli.</p>

      <div class:list={['account-social-auth', socialProviders.length === 1 && 'account-social-auth--single']} aria-label="Accesso social">
        {socialProviders.map((provider) => (
          <a
            href={`/api/auth/oauth/start?provider=${provider.provider}&returnTo=${encodedReturnTo}`}
            aria-label={provider.label}
          >
            <span class="account-social-auth__icons" aria-hidden="true">
              <img
                class="account-social-auth__icon account-social-auth__icon--light"
                src={provider.iconLight}
                alt=""
                width="24"
                height="24"
                loading="lazy"
              />
              <img
                class="account-social-auth__icon account-social-auth__icon--dark"
                src={provider.iconDark}
                alt=""
                width="24"
                height="24"
                loading="lazy"
              />
            </span>
            <span>{provider.label}</span>
          </a>
        ))}
      </div>

      {oauthErrorMessage && (
        <p class="account-message" data-type="error">{oauthErrorMessage}</p>
      )}

      <div class="account-divider" aria-hidden="true">
        <span>oppure</span>
      </div>

      <form class="account-form" data-login-form>
        <input type="hidden" name="returnTo" value={returnTo} />

        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>Password</span>
          <input type="password" name="password" required autocomplete="current-password" />
        </label>

        <p class="account-message" data-account-message hidden></p>

        <button type="submit">Accedi</button>
      </form>

      <p class="account-switch">
        Non hai ancora un account?
        <a href="/account/register/">Registrati</a>
      </p>
    </section>
  </main>

  <script>
    const form = document.querySelector('[data-login-form]');
    const message = document.querySelector('[data-account-message]');

    const showMessage = (text, type = 'ok') => {
      if (!message) return;
      message.textContent = text;
      message.hidden = false;
      message.dataset.type = type;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const button = form.querySelector('button[type="submit"]');

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: String(formData.get('email') || ''),
            password: String(formData.get('password') || '')
          })
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(result.error || 'Login non riuscito.', 'error');
          return;
        }

        showMessage('Login effettuato. Puoi tornare all’articolo e commentare.', 'ok');

        setTimeout(() => {
          const returnTo = String(formData.get('returnTo') || '/');
          window.location.href = returnTo.startsWith('/') ? returnTo : '/';
        }, 700);
      } catch {
        showMessage('Errore di connessione. Riprova.', 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });
  </script>
</BaseLayout>
