---
import '../../../../../styles/pages/account.css';
import '../../../../../styles/pages/account-messages.css';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import UserAvatar from '../../../../../components/account/UserAvatar.astro';
import { getUserSessionFromCookies } from '../../../../../lib/supabase/auth';
import {
  getPrivateConversationThread,
  getPrivateProfileLabel,
  getPrivateProfileUrl,
  isPrivateMessagesUnavailable,
  markPrivateConversationRead,
} from '../../../../../lib/supabase/private-messages';

const conversationId = String(Astro.params.conversationId || '');
const session = await getUserSessionFromCookies(Astro.cookies);
const isLoggedIn = Boolean(!session.error && session.user && session.profile);
const title = 'Conversazione privata | Retro-Gamers.it';
const description = 'Conversazione privata tra lettori Retro-Gamers.it.';

let thread = null;
let threadError = '';

if (isLoggedIn && session.user) {
  const result = await getPrivateConversationThread(conversationId, session.user.id);
  thread = result.thread;

  if (result.error) {
    threadError = isPrivateMessagesUnavailable(result.error)
      ? 'Messaggi privati non disponibili. Esegui lo SQL private-messages.sql in Supabase.'
      : 'Conversazione non disponibile. Riprova più tardi.';
  } else if (!thread) {
    threadError = 'Conversazione non trovata.';
  } else {
    const markReadResult = await markPrivateConversationRead(session.user.id, conversationId);

    if (!markReadResult.ok) {
      console.error('Private conversation auto mark-read failed:', markReadResult.error);
    }
  }
}

const otherProfile = thread?.otherProfile;
const otherName = getPrivateProfileLabel(otherProfile);
const otherProfileUrl = getPrivateProfileUrl(otherProfile, 'it');
const canReply = Boolean(thread && !thread.isBlockedByViewer && !thread.isViewerBlocked);
const dateFormatter = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<BaseLayout title={title} description={description}>
  <main class="account-page account-messages-page">
    <section class="account-card">
      {isLoggedIn ? (
        <>
          <a class="account-back-link" href="/account/messages/private/">← Tutte le conversazioni</a>

          {thread ? (
            <>
              <header class="private-thread-header">
                <div class="private-thread-header__identity">
                  <UserAvatar
                    name={otherName}
                    src={otherProfile?.avatar_url}
                    size="md"
                    label={`Avatar di ${otherName}`}
                    class="private-thread-header__avatar"
                  />

                  <div class="private-thread-header__body">
                    <p class="account-kicker">Messaggio privato</p>
                    <h1>{otherName}</h1>
                    {otherProfile?.username && <p>@{otherProfile.username}</p>}
                  </div>
                </div>

                <div class="private-thread-header__actions">
                  <a href={otherProfileUrl}>Vedi profilo pubblico</a>

                  <div
                    class="private-thread-actions"
                    data-private-thread-actions
                    data-conversation-id={conversationId}
                  >
                    {thread.isBlockedByViewer ? (
                      <button type="button" data-private-unblock>Sblocca utente</button>
                    ) : (
                      <button type="button" data-private-block>Blocca utente</button>
                    )}
                    <button type="button" data-private-report-conversation>Segnala conversazione</button>
                  </div>
                </div>
              </header>

              {thread.isBlockedByViewer && (
                <p class="account-message" data-type="ok">Hai bloccato questo utente. Puoi sbloccarlo quando vuoi.</p>
              )}

              {thread.isViewerBlocked && (
                <p class="account-message" data-type="error">Non puoi inviare messaggi a questo utente.</p>
              )}

              <div class="private-thread" data-private-thread>
                {thread.messages.length > 0 ? (
                  thread.messages.map((message) => {
                    const isMine = message.sender_id === session.user?.id;

                    return (
                      <article
                        class:list={['private-message', isMine ? 'is-mine' : 'is-theirs']}
                        data-message-id={message.id}
                      >
                        <div class="private-message__bubble">
                          <p>{message.body}</p>
                          <footer>
                            <time datetime={message.created_at}>
                              {dateFormatter.format(new Date(message.created_at))}
                            </time>

                            {!isMine && (
                              <button type="button" data-private-report-message>
                                Segnala
                              </button>
                            )}
                          </footer>
                        </div>
                      </article>
                    );
                  })
                ) : (
                  <p class="account-messages-empty">
                    Nessun messaggio ancora. Scrivi il primo messaggio qui sotto.
                  </p>
                )}
              </div>

              <form
                class="private-reply-form"
                data-private-reply-form
                data-conversation-id={conversationId}
                hidden={!canReply}
              >
                <label>
                  <span>Rispondi</span>
                  <textarea
                    name="body"
                    rows="5"
                    maxlength="2000"
                    required
                    placeholder="Scrivi un messaggio privato..."
                  ></textarea>
                </label>

                <p class="account-message" data-private-message-feedback hidden></p>

                <div class="account-actions">
                  <button type="submit">Invia messaggio</button>
                </div>
              </form>
            </>
          ) : (
            <p class="account-message" data-type="error">{threadError || 'Conversazione non disponibile.'}</p>
          )}
        </>
      ) : (
        <>
          <p class="account-kicker">Messaggi privati</p>
          <h1>Accesso richiesto</h1>
          <p>Accedi per leggere questa conversazione.</p>
          <div class="account-actions account-actions--standalone">
            <a href={`/account/login/?returnTo=${encodeURIComponent(Astro.url.pathname)}`}>Accedi</a>
          </div>
        </>
      )}
    </section>
  </main>

  <script>
    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const form = document.querySelector('[data-private-reply-form]');
    const feedback = document.querySelector('[data-private-message-feedback]');
    const threadActions = document.querySelector('[data-private-thread-actions]');

    const showFeedback = (text, type = 'ok') => {
      if (!feedback) return;
      feedback.textContent = text;
      feedback.dataset.type = type;
      feedback.hidden = !text;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector('button[type="submit"]');
      const formData = new FormData(form);
      button.disabled = true;
      showFeedback('');

      try {
        const response = await fetch('/api/account/private-messages/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            conversationId: form.dataset.conversationId,
            body: String(formData.get('body') || ''),
          }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showFeedback(result.error || 'Messaggio non inviato.', 'error');
          button.disabled = false;
          return;
        }

        window.location.reload();
      } catch {
        showFeedback('Errore di connessione.', 'error');
        button.disabled = false;
      }
    });

    threadActions?.addEventListener('click', async (event) => {
      const blockButton = event.target.closest('[data-private-block]');
      const unblockButton = event.target.closest('[data-private-unblock]');
      const reportButton = event.target.closest('[data-private-report-conversation]');

      if (!blockButton && !unblockButton && !reportButton) return;

      const conversationId = threadActions.dataset.conversationId;
      const endpoint = blockButton
        ? '/api/account/private-messages/block'
        : unblockButton
          ? '/api/account/private-messages/unblock'
          : '/api/account/private-messages/report';
      const reason = reportButton
        ? window.prompt('Motivo della segnalazione, opzionale:') || ''
        : '';

      if ((blockButton || unblockButton) && !window.confirm(blockButton ? 'Bloccare questo utente?' : 'Sbloccare questo utente?')) {
        return;
      }

      const button = blockButton || unblockButton || reportButton;
      button.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversationId, reason }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          window.alert(result.error || 'Azione non riuscita.');
          button.disabled = false;
          return;
        }

        window.location.reload();
      } catch {
        window.alert('Errore di connessione.');
        button.disabled = false;
      }
    });

    document.querySelector('[data-private-thread]')?.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-private-report-message]');
      if (!button) return;

      const message = button.closest('[data-message-id]');
      const messageId = message?.dataset.messageId;
      const conversationId = form?.dataset.conversationId || threadActions?.dataset.conversationId;
      const reason = window.prompt('Motivo della segnalazione, opzionale:') || '';

      button.disabled = true;

      try {
        const response = await fetch('/api/account/private-messages/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversationId, messageId, reason }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          window.alert(result.error || 'Segnalazione non inviata.');
          button.disabled = false;
          return;
        }

        button.textContent = 'Segnalato';
      } catch {
        window.alert('Errore di connessione.');
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
