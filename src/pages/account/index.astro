---
import '../../styles/pages/account.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../../components/community/CommunityHero.astro';
import CommunityLayout from '../../components/community/CommunityLayout.astro';
import CommunitySidebarProfile from '../../components/community/CommunitySidebarProfile.astro';
import CommunitySidebarSection from '../../components/community/CommunitySidebarSection.astro';
import CommunityStatList from '../../components/community/CommunityStatList.astro';
import { getOwnedReaderBadges, getReaderBadgeImageSrcForBadge } from '../../lib/badges';
import { getCommunityRank } from '../../lib/community-rank';
import { getPublicUserUrl } from '../../lib/supabase/public-profiles';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';
import { emptyCommunityStats, getCommunityStats } from '../../lib/supabase/community';
import { getNewsletterSubscriptionForUser } from '../../lib/supabase/newsletter';
import { supabaseAdmin } from '../../lib/supabase/server';
import { touchUserActivity } from '../../lib/supabase/user-activity';

const title = 'Profilo lettore | Retro-Gamers.it';
const description = 'Gestisci il tuo profilo lettore, il nome visualizzato e il badge community.';
const session = await getUserSessionFromCookies(Astro.cookies);
const isLoggedIn = Boolean(!session.error && session.user && session.profile);
const profile = session.profile;
const user = session.user;
const currentBadge = profile?.user_badges;
const currentBadgeImageSrc = getReaderBadgeImageSrcForBadge(currentBadge || { key: profile?.badge_key || '' });
const avatarUrl = profile?.avatar_url || '';
const isStaff = profile?.role === 'admin' || profile?.role === 'moderator';
const accountDisplayName =
  profile?.display_name || profile?.username || user?.email || 'Utente Retro-Gamers';
const publicProfileHref = profile?.username ? getPublicUserUrl(profile.username, 'it') : '';
let badges = [] as Awaited<ReturnType<typeof getOwnedReaderBadges>>;
let currentBio = '';
let currentBioEn = '';
let newsletterStatus: 'none' | 'pending' | 'active' | 'unsubscribed' = 'none';
let newsletterLanguage: 'it' | 'en' = 'it';
const isMissingBioColumnError = (error: { code?: string; message?: string; details?: string } | null) => {
  if (!error) return false;

  const message = `${error.message || ''} ${error.details || ''}`.toLowerCase();

  return (
    message.includes('bio') &&
    !message.includes('bio_en') &&
    (
      error.code === '42703' ||
      error.code === 'PGRST204' ||
      message.includes('column') ||
      message.includes('schema cache')
    )
  );
};

const isMissingBioEnColumnError = (error: { code?: string; message?: string; details?: string } | null) => {
  if (!error) return false;

  const message = `${error.message || ''} ${error.details || ''}`.toLowerCase();

  return (
    message.includes('bio_en') &&
    (
      error.code === '42703' ||
      error.code === 'PGRST204' ||
      message.includes('column') ||
      message.includes('schema cache')
    )
  );
};

const getProfileBio = async (userId: string) => {
  const { data: profileBio, error: profileBioError } = await supabaseAdmin
    .from('profiles')
    .select('bio, bio_en')
    .eq('user_id', userId)
    .maybeSingle();

  if (!profileBioError) {
    return {
      bio: profileBio?.bio || '',
      bioEn: profileBio?.bio_en || '',
    };
  }

  if (isMissingBioEnColumnError(profileBioError)) {
    const { data: fallbackProfileBio, error: fallbackProfileBioError } = await supabaseAdmin
      .from('profiles')
      .select('bio')
      .eq('user_id', userId)
      .maybeSingle();

    if (!fallbackProfileBioError) {
      return {
        bio: fallbackProfileBio?.bio || '',
        bioEn: '',
      };
    }
  }

  if (!isMissingBioColumnError(profileBioError) && !isMissingBioEnColumnError(profileBioError)) {
    console.error('Profile bio query failed:', {
      code: profileBioError.code,
      message: profileBioError.message,
      hint: profileBioError.hint,
    });
  }

  return {
    bio: '',
    bioEn: '',
  };
};

let commentActivity = { ...emptyCommunityStats };

if (isLoggedIn && user?.id) {
  const [, ownedBadges, profileBio, stats, newsletter] = await Promise.all([
    touchUserActivity(user.id, 'account-load'),
    getOwnedReaderBadges(user.id),
    getProfileBio(user.id),
    getCommunityStats(user.id),
    getNewsletterSubscriptionForUser(user.id, user.email),
  ]);

  badges = ownedBadges;
  currentBio = profileBio.bio;
  currentBioEn = profileBio.bioEn;
  commentActivity = stats;
  newsletterStatus = newsletter.status;
  newsletterLanguage = newsletter.language;
}

const communityStatItems = [
  { label: 'Punti community', value: commentActivity.communityPoints },
  { label: 'Commenti pubblicati', value: commentActivity.approved },
  { label: 'In attesa', value: commentActivity.pending },
  { label: 'Like ricevuti', value: commentActivity.likesReceived },
  { label: 'Dislike ricevuti', value: commentActivity.dislikesReceived },
];
const communityRank = getCommunityRank(commentActivity.communityPoints);
const communityRankProgress = Math.round(communityRank.progressToNext);
const newsletterLanguageLabel = newsletterLanguage === 'en' ? 'English' : 'Italiano';
const isNewsletterActive = newsletterStatus === 'active';
const isNewsletterPending = newsletterStatus === 'pending';
const isNewsletterSubscribable = newsletterStatus === 'none' || newsletterStatus === 'unsubscribed';

---

<BaseLayout title={title} description={description}>
  <CommunityLayout class="account-community-page" sidebar={isLoggedIn}>
    <Fragment slot="sidebar">
      {isLoggedIn && (
        <>
          <CommunitySidebarProfile
            name={accountDisplayName}
            username={profile?.username}
            email={user?.email}
            avatarUrl={avatarUrl}
          >
            {publicProfileHref && <a href={publicProfileHref}>Profilo pubblico</a>}
            <a href="/account/messages/">Messaggi</a>
            <a href="/account/memories/">Le mie memorie</a>
            <a href="/account/ratings/">I miei voti</a>
          </CommunitySidebarProfile>

          <CommunitySidebarSection title="Dati account">
            <dl class="community-detail-list" id="memories">
              <div>
                <dt>Email</dt>
                <dd>{user?.email}</dd>
              </div>

              <div>
                <dt>Username</dt>
                <dd>{profile?.username}</dd>
              </div>

              <div>
                <dt>Ruolo</dt>
                <dd>{profile?.role || 'reader'}</dd>
              </div>

              <div>
                <dt>Stato</dt>
                <dd>{profile?.status || 'active'}</dd>
              </div>

              <div>
                <dt>Badge</dt>
                <dd>
                  {currentBadgeImageSrc ? (
                    <span class="account-reader-badge">
                      <img src={currentBadgeImageSrc} alt="" loading="lazy" decoding="async" />
                      <span>{currentBadge?.label_it || currentBadge?.label_en || profile?.badge_key}</span>
                    </span>
                  ) : (
                    currentBadge?.label_it || profile?.badge_key || 'Non impostato'
                  )}
                </dd>
              </div>
            </dl>
          </CommunitySidebarSection>

          <CommunityStatList title="Statistiche community" items={communityStatItems} />
        </>
      )}
    </Fragment>

    {isLoggedIn ? (
      <>
        <CommunityHero
          kicker="Profilo lettore"
          title="Area account"
          description="Gestisci il nome con cui compari nei commenti, il profilo pubblico e il badge che racconta meglio il tuo angolo di retro-gaming."
        />

        <div class="community-content-stack">
            <section class="account-favorites-card" aria-labelledby="account-favorites-title">
              <div>
                <p class="account-kicker">Preferiti</p>
                <h2 id="account-favorites-title">I tuoi preferiti</h2>
                <p>
                  Ritrova gli articoli che hai salvato e gestisci i tuoi interessi retro.
                </p>
              </div>

              <a href="/account/favorites/">Apri preferiti</a>
            </section>

            <section
              class="account-newsletter-card"
              aria-labelledby="account-newsletter-title"
              data-account-newsletter
              data-status={newsletterStatus}
            >
              <div class="account-newsletter-card__heading">
                <p class="account-kicker">Newsletter</p>
                <h2 id="account-newsletter-title">Newsletter</h2>
                <p>
                  Ricevi aggiornamenti su nuovi articoli, recensioni, speciali e iniziative della community.
                </p>
              </div>

              {isNewsletterActive && (
                <form class="account-form account-newsletter-form" data-account-newsletter-form>
                  <p class="account-newsletter-status">Sei iscritto alla newsletter.</p>

                  <p class="account-newsletter-language-summary">
                    <span>Lingua preferita:</span>
                    <strong>{newsletterLanguageLabel}</strong>
                  </p>

                  <p class="account-field-help">
                    La disiscrizione dalla newsletter non modifica le email operative legate all’account, alla sicurezza o ai commenti.
                  </p>

                  <p class="account-message" data-account-newsletter-message hidden></p>

                  <div class="account-actions">
                    <button type="button" data-account-newsletter-unsubscribe>
                      Disiscrivimi
                    </button>
                  </div>
                </form>
              )}

              {isNewsletterPending && (
                <form class="account-form account-newsletter-form" data-account-newsletter-form>
                  <p class="account-newsletter-status">
                    Iscrizione in attesa di conferma. Controlla la tua email.
                  </p>

                  <p class="account-newsletter-language-summary">
                    <span>Lingua preferita:</span>
                    <strong>{newsletterLanguageLabel}</strong>
                  </p>

                  <p class="account-field-help">
                    La newsletter sarà attiva solo dopo la conferma.
                  </p>

                  <p class="account-field-help">
                    La disiscrizione dalla newsletter non modifica le email operative legate all’account, alla sicurezza o ai commenti.
                  </p>

                  <p class="account-message" data-account-newsletter-message hidden></p>

                  <div class="account-actions">
                    <button type="button" data-account-newsletter-unsubscribe>
                      Disiscrivimi
                    </button>
                  </div>
                </form>
              )}

              {isNewsletterSubscribable && (
                <form class="account-form account-newsletter-form" data-account-newsletter-form>
                  <p class="account-newsletter-status">
                    {newsletterStatus === 'unsubscribed'
                      ? 'Hai disattivato la newsletter. Puoi iscriverti di nuovo quando vuoi.'
                      : 'Non sei iscritto alla newsletter.'}
                  </p>

                  <label>
                    <span>Lingua preferita</span>
                    <select
                      name="language"
                      data-account-newsletter-language
                    >
                      <option value="it" selected={newsletterLanguage !== 'en'}>Italiano</option>
                      <option value="en" selected={newsletterLanguage === 'en'}>English</option>
                    </select>
                  </label>

                  <label class="account-newsletter-consent" data-account-newsletter-consent>
                    <input type="checkbox" name="consent" />
                    <span>
                      Acconsento a ricevere la newsletter e dichiaro di aver letto la
                      <a href="/privacy-policy/">Privacy Policy</a>.
                    </span>
                  </label>

                  <p class="account-message" data-account-newsletter-message hidden></p>

                  <div class="account-actions">
                    <button type="button" data-account-newsletter-subscribe>
                      {newsletterStatus === 'unsubscribed' ? 'Iscrivimi di nuovo' : 'Iscrivimi'}
                    </button>
                  </div>
                </form>
              )}
            </section>

            <section class="account-community-rank" aria-labelledby="account-community-rank-title">
              <div>
                <p class="account-kicker">Community</p>
                <h2 id="account-community-rank-title">Livello community</h2>
                <p>
                  Il livello cresce con commenti approvati, voti alle recensioni e like ricevuti sui commenti. Ogni profilo parte da 1 punto, senza classifiche pubbliche.
                </p>
              </div>

              <div class="account-community-rank__summary">
                <span>Livello attuale</span>
                <strong>{communityRank.label}</strong>
                <p>{communityRank.descriptionIt}</p>
              </div>

              {communityRank.nextRank ? (
                <div class="account-community-rank__progress">
                  <div>
                    <span>Prossimo livello: {communityRank.nextRank.label}</span>
                    <strong>{commentActivity.communityPoints} punti</strong>
                  </div>
                  <p class="account-community-rank__progress-note">
                    Progresso: {communityRankProgress}%
                  </p>
                  <div
                    class="account-community-rank__bar"
                    aria-label={`Progresso verso ${communityRank.nextRank.label}`}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow={communityRankProgress}
                    role="progressbar"
                  >
                    <span style={`width: ${communityRankProgress}%`}></span>
                  </div>
                </div>
              ) : (
                <p class="account-community-rank__max">
                  Hai raggiunto il livello massimo.
                </p>
              )}
            </section>

            <section class="account-avatar-section" aria-labelledby="account-avatar-title">
              <div class="account-avatar-section__content">
                <p class="account-kicker">Community</p>
                <h2 id="account-avatar-title">Avatar</h2>
                <p>
                  {avatarUrl
                    ? 'Avatar attuale caricato. Puoi sostituirlo caricando una nuova immagine.'
                    : 'Carica un’immagine per rendere riconoscibile il tuo profilo nella community.'}
                </p>

                <form class="account-form account-avatar-form" data-account-avatar-form>
                  <label
                    class="account-avatar-dropzone"
                    data-account-avatar-dropzone
                    data-replace-label={avatarUrl ? 'Rilascia l’immagine per sostituire l’avatar' : 'Rilascia l’immagine per caricarla'}
                  >
                    <input
                      class="account-avatar-input"
                      type="file"
                      name="avatar"
                      accept="image/jpeg,image/png,image/webp"
                      data-account-avatar-input
                    />
                    <span class="account-avatar-dropzone__label" data-account-avatar-dropzone-label>
                      {avatarUrl
                        ? 'Scegli una nuova immagine per sostituire l’avatar'
                        : 'Trascina qui la tua immagine oppure scegli un file'}
                    </span>
                    <span class="account-avatar-dropzone__help">
                      {avatarUrl
                        ? 'JPG, PNG o WebP. Max 2 MB. L’avatar attuale resterà attivo finché non carichi il nuovo file.'
                        : 'JPG, PNG o WebP. Max 2 MB.'}
                    </span>
                    <span
                      class="account-avatar-dropzone__filename"
                      data-account-avatar-filename
                      hidden
                    ></span>
                  </label>

                  <p class="account-message" data-account-avatar-message hidden></p>

                  <div class="account-actions">
                    <button type="submit">{avatarUrl ? 'Sostituisci avatar' : 'Carica avatar'}</button>
                    <button
                      type="button"
                      data-account-avatar-remove
                      hidden={!avatarUrl}
                    >
                      Rimuovi avatar
                    </button>
                  </div>
                </form>
              </div>
            </section>

            <section class="account-public-profile" aria-labelledby="account-public-profile-title">
              <div class="account-public-profile__heading">
                <p class="account-kicker">Community</p>
                <h2 id="account-public-profile-title">Profilo pubblico</h2>
                <p>
                  Racconta in poche righe chi sei come lettore, giocatore o
                  appassionato retro.
                </p>
              </div>

              <form class="account-form account-form--bio" data-account-bio-form>
                <label>
                  <span>Bio in italiano</span>
                  <textarea
                    name="bio"
                    maxlength="500"
                    rows="5"
                    placeholder="Esempio: cresciuto tra Amiga, sale giochi e riviste consumate fino all’ultima pagina."
                  >{currentBio}</textarea>
                </label>

                <small class="account-character-count" data-account-bio-counter>
                  {currentBio.length}/500
                </small>

                <label>
                  <span>Bio in inglese</span>
                  <textarea
                    name="bioEn"
                    maxlength="500"
                    rows="5"
                    placeholder="Example: raised on Amiga, arcades and worn-out gaming magazines."
                  >{currentBioEn}</textarea>
                </label>

                <small class="account-character-count" data-account-bio-en-counter>
                  {currentBioEn.length}/500
                </small>

                <p class="account-field-help">
                  La bio inglese è opzionale. Se lasciata vuota, nella versione inglese del profilo verrà usata la bio italiana.
                </p>

                <p class="account-message" data-account-bio-message hidden></p>

                <div class="account-actions">
                  <button type="submit">Salva bio</button>
                </div>
              </form>
            </section>

            {isStaff && (
              <section class="account-editorial-tools" aria-labelledby="account-editorial-tools-title">
                <div>
                  <h2 id="account-editorial-tools-title">Pannello redazione</h2>
                  <p>Gestisci commenti in moderazione, utenti registrati e strumenti community.</p>
                </div>

                <div class="account-editorial-tools__actions">
                  <a href="/admin/comments/">Moderazione commenti</a>
                  <a href="/admin/comment-reports/">Segnalazioni commenti</a>
                  <a href="/admin/users/">Gestione utenti</a>
                  <a href="/admin/private-message-reports/">Segnalazioni messaggi</a>
                  <a href="/admin/ratings/">Voti lettori</a>
                </div>
              </section>
            )}

            <section class="account-settings-section" aria-labelledby="account-settings-title">
              <div class="account-settings-section__heading">
                <p class="account-kicker">Impostazioni</p>
                <h2 id="account-settings-title">Profilo</h2>
              </div>

              <form class="account-form" data-account-profile-form>
                <label>
                  <span>Nome visualizzato</span>
                  <input
                    type="text"
                    name="displayName"
                    required
                    minlength="2"
                    maxlength="40"
                    value={profile?.display_name || profile?.username || ''}
                  />
                </label>

                {badges.length > 0 ? (
                  <label>
                    <span>Badge lettore</span>
                    <select name="badgeKey" required>
                      <option value="">Scegli un badge</option>
                      {badges.map((badge) => (
                        <option value={badge.key} selected={badge.key === profile?.badge_key}>
                          {badge.label_it || badge.label_en || badge.key}
                        </option>
                      ))}
                    </select>

                    <small class="account-field-help">
                      Il badge è il simbolo che scegli di mostrare accanto al tuo profilo. Il livello community, invece, cresce automaticamente con la partecipazione.
                    </small>

                    <a class="account-field-link" href="/badges/">Scopri tutti i badge</a>
                  </label>
                ) : (
                  <div class="account-badge-empty">
                    <span>Badge lettore</span>
                    <p>Non hai ancora scelto un badge principale.</p>
                    <p>Quando sblocchi o selezioni un badge, apparirà nel profilo e nei commenti.</p>
                    <a class="account-field-link" href="/badges/">Scopri tutti i badge</a>
                  </div>
                )}

                <p class="account-message" data-account-message hidden></p>

                <div class="account-actions">
                  <button type="submit">Salva profilo</button>
                  <button type="button" data-account-logout>Esci</button>
                </div>
              </form>
            </section>
        </div>
      </>
    ) : (
      <>
        <CommunityHero
          kicker="Profilo lettore"
          title="Area account"
          description="Accedi per gestire il tuo profilo lettore, scegliere il badge e partecipare alle discussioni sotto gli articoli."
        />

        <section class="community-card">
          <div class="account-actions account-actions--standalone">
            <a href="/account/login/">Accedi</a>
            <a href="/account/register/">Registrati</a>
          </div>
        </section>
      </>
    )}
  </CommunityLayout>

  <script>
    const form = document.querySelector('[data-account-profile-form]');
    const profileMessage = document.querySelector('[data-account-message]');
    const bioForm = document.querySelector('[data-account-bio-form]');
    const bioMessage = document.querySelector('[data-account-bio-message]');
    const bioTextarea = document.querySelector('[data-account-bio-form] textarea[name="bio"]');
    const bioEnTextarea = document.querySelector('[data-account-bio-form] textarea[name="bioEn"]');
    const bioCounter = document.querySelector('[data-account-bio-counter]');
    const bioEnCounter = document.querySelector('[data-account-bio-en-counter]');
    const avatarForm = document.querySelector('[data-account-avatar-form]');
    const avatarInput = document.querySelector('[data-account-avatar-input]');
    const avatarMessage = document.querySelector('[data-account-avatar-message]');
    const avatarRemoveButton = document.querySelector('[data-account-avatar-remove]');
    const avatarDropzone = document.querySelector('[data-account-avatar-dropzone]');
    const avatarDropzoneLabel = document.querySelector('[data-account-avatar-dropzone-label]');
    const avatarFilename = document.querySelector('[data-account-avatar-filename]');
    const newsletterConsent = document.querySelector('[data-account-newsletter-consent]');
    const newsletterLanguage = document.querySelector('[data-account-newsletter-language]');
    const newsletterSubscribeButton = document.querySelector('[data-account-newsletter-subscribe]');
    const newsletterUnsubscribeButton = document.querySelector('[data-account-newsletter-unsubscribe]');
    const newsletterMessage = document.querySelector('[data-account-newsletter-message]');
    const logoutButton = document.querySelector('[data-account-logout]');
    const avatarDefaultDropzoneText = avatarDropzoneLabel?.textContent?.trim() || '';
    const avatarReplaceDropzoneText = avatarDropzone?.dataset.replaceLabel || 'Rilascia l’immagine per caricarla';
    let selectedAvatarFile = null;

    const showMessage = (target, text, type = 'ok') => {
      if (!target) return;
      target.textContent = text;
      target.hidden = false;
      target.dataset.type = type;
    };

    const setNewsletterLoading = (isLoading) => {
      if (newsletterSubscribeButton) {
        newsletterSubscribeButton.disabled = isLoading;
      }

      if (newsletterUnsubscribeButton) {
        newsletterUnsubscribeButton.disabled = isLoading;
      }
    };

    const reloadNewsletterState = () => {
      window.setTimeout(() => {
        window.location.reload();
      }, 700);
    };

    newsletterSubscribeButton?.addEventListener('click', async () => {
      const consentInput = newsletterConsent?.querySelector('input[name="consent"]');

      if (!consentInput?.checked) {
        showMessage(newsletterMessage, 'Per iscriverti devi accettare l’informativa privacy.', 'error');
        consentInput?.focus();
        return;
      }

      setNewsletterLoading(true);

      try {
        const response = await fetch('/api/account/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'subscribe',
            language: newsletterLanguage?.value === 'en' ? 'en' : 'it',
            consent: true
          })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(newsletterMessage, result.error || 'Impossibile aggiornare la newsletter.', 'error');
          return;
        }

        showMessage(newsletterMessage, result.message || 'Controlla la tua email per confermare l’iscrizione.', 'ok');
        reloadNewsletterState();

        if (consentInput) {
          consentInput.checked = false;
        }
      } catch {
        showMessage(newsletterMessage, 'Impossibile aggiornare la newsletter.', 'error');
      } finally {
        setNewsletterLoading(false);
      }
    });

    newsletterUnsubscribeButton?.addEventListener('click', async () => {
      setNewsletterLoading(true);

      try {
        const response = await fetch('/api/account/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'unsubscribe' })
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(newsletterMessage, result.error || 'Impossibile aggiornare la newsletter.', 'error');
          return;
        }

        showMessage(newsletterMessage, result.message || 'Newsletter disattivata.', 'ok');
        reloadNewsletterState();
      } catch {
        showMessage(newsletterMessage, 'Impossibile aggiornare la newsletter.', 'error');
      } finally {
        setNewsletterLoading(false);
      }
    });

    const updateBioCounter = () => {
      if (!bioTextarea || !bioCounter) return;
      bioCounter.textContent = `${bioTextarea.value.length}/500`;
    };

    const updateBioEnCounter = () => {
      if (!bioEnTextarea || !bioEnCounter) return;
      bioEnCounter.textContent = `${bioEnTextarea.value.length}/500`;
    };

    updateBioCounter();
    updateBioEnCounter();
    bioTextarea?.addEventListener('input', updateBioCounter);
    bioEnTextarea?.addEventListener('input', updateBioEnCounter);

    const validAvatarTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);

    const updateAvatarFilename = (file) => {
      if (!avatarFilename) return;

      if (!file) {
        avatarFilename.textContent = '';
        avatarFilename.hidden = true;
        return;
      }

      avatarFilename.textContent = `File selezionato: ${file.name}`;
      avatarFilename.hidden = false;
    };

    const handleAvatarFile = (file) => {
      selectedAvatarFile = null;
      updateAvatarFilename(file);

      if (!file) {
        return;
      }

      if (!validAvatarTypes.has(file.type)) {
        showMessage(avatarMessage, 'File non valido. Usa JPG, PNG o WebP.', 'error');
        return;
      }

      if (file.size > 2 * 1024 * 1024) {
        showMessage(avatarMessage, 'Il file è troppo grande. Dimensione massima: 2 MB.', 'error');
        return;
      }

      selectedAvatarFile = file;
      if (avatarMessage) avatarMessage.hidden = true;
    };

    avatarInput?.addEventListener('change', () => {
      handleAvatarFile(avatarInput.files?.[0]);
    });

    if (avatarDropzone && avatarInput) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        avatarDropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          avatarDropzone.dataset.dragActive = 'true';

          if (avatarDropzoneLabel) {
            avatarDropzoneLabel.textContent = avatarReplaceDropzoneText;
          }
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        avatarDropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          delete avatarDropzone.dataset.dragActive;

          if (avatarDropzoneLabel) {
            avatarDropzoneLabel.textContent = avatarDefaultDropzoneText;
          }
        });
      });

      avatarDropzone.addEventListener('drop', (event) => {
        const file = event.dataTransfer?.files?.[0];

        if (!file) {
          return;
        }

        try {
          avatarInput.files = event.dataTransfer.files;
        } catch {
          // Some browsers keep file inputs read-only for dropped files.
        }

        handleAvatarFile(file);
      });
    }

    avatarForm?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const file = selectedAvatarFile || avatarInput?.files?.[0];
      const button = avatarForm.querySelector('button[type="submit"]');

      if (!file || !validAvatarTypes.has(file.type)) {
        showMessage(avatarMessage, 'File non valido. Usa JPG, PNG o WebP.', 'error');
        return;
      }

      if (file.size > 2 * 1024 * 1024) {
        showMessage(avatarMessage, 'Il file è troppo grande. Dimensione massima: 2 MB.', 'error');
        return;
      }

      if (button) button.disabled = true;

      try {
        const payload = new FormData();
        payload.set('avatar', file);

        const response = await fetch('/api/account/avatar/upload', {
          method: 'POST',
          body: payload
        });
        const result = await response.json();

        if (!result.ok) {
          showMessage(avatarMessage, result.error || 'Upload non riuscito.', 'error');
          return;
        }

        showMessage(avatarMessage, 'Avatar aggiornato.', 'ok');
        window.setTimeout(() => window.location.reload(), 450);
      } catch {
        showMessage(avatarMessage, 'Errore di connessione. Riprova.', 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });

    avatarRemoveButton?.addEventListener('click', async () => {
      avatarRemoveButton.disabled = true;

      try {
        const response = await fetch('/api/account/avatar/remove', {
          method: 'POST'
        });
        const result = await response.json();

        if (!result.ok) {
          showMessage(avatarMessage, result.error || 'Rimozione non riuscita.', 'error');
          avatarRemoveButton.disabled = false;
          return;
        }

        showMessage(avatarMessage, 'Avatar rimosso.', 'ok');
        window.setTimeout(() => window.location.reload(), 450);
      } catch {
        showMessage(avatarMessage, 'Errore di connessione. Riprova.', 'error');
        avatarRemoveButton.disabled = false;
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const button = form.querySelector('button[type="submit"]');
      const badgeSelect = form.querySelector('select[name="badgeKey"]');
      const payload = {
        displayName: String(formData.get('displayName') || ''),
        ...(badgeSelect ? { badgeKey: String(formData.get('badgeKey') || '') } : {})
      };

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/account/update-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(profileMessage, result.error || 'Aggiornamento non riuscito.', 'error');
          return;
        }

        showMessage(profileMessage, 'Profilo aggiornato.', 'ok');
      } catch {
        showMessage(profileMessage, 'Errore di connessione. Riprova.', 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });

    bioForm?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(bioForm);
      const button = bioForm.querySelector('button[type="submit"]');
      const bio = String(formData.get('bio') || '');
      const bioEn = String(formData.get('bioEn') || '');

      if (bio.length > 500) {
        showMessage(bioMessage, 'La bio non può superare 500 caratteri.', 'error');
        return;
      }

      if (bioEn.length > 500) {
        showMessage(bioMessage, 'La bio inglese non può superare 500 caratteri.', 'error');
        return;
      }

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/account/update-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bio, bioEn })
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(bioMessage, result.error || 'Aggiornamento non riuscito.', 'error');
          return;
        }

        showMessage(bioMessage, 'Bio aggiornata.', 'ok');
      } catch {
        showMessage(bioMessage, 'Errore di connessione. Riprova.', 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });

    logoutButton?.addEventListener('click', async () => {
      logoutButton.disabled = true;

      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/';
      } catch {
        showMessage(profileMessage, 'Logout non riuscito. Riprova.', 'error');
        logoutButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
