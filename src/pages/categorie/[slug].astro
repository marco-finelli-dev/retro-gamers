---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';

const { slug } = Astro.params;

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const italianPosts = allPosts.filter((post) =>
  (!post.language || post.language === 'it') &&
  (post.categories || []).some((category) => category.slug === slug)
);

const category = italianPosts
  .flatMap((post) => post.categories || [])
  .find((category) => category.slug === slug);

if (!category) {
  return Astro.rewrite('/404');
}

const title = category.name || category.nameEn || 'Categoria';

const description =
  `Tutti gli articoli di Retro-Gamers.it dedicati a ${title.toLowerCase()}: recensioni, speciali, guide, news e approfondimenti dal mondo retro-gaming.`;

const canonicalUrl =
  `https://www.retro-gamers.it/categorie/${slug}/`;
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={title}
  description={description}
  canonical={canonicalUrl}
  lang="it"
>
  <ArchivePage
    title={title}
    eyebrow="Categoria"
    description={description}
    posts={italianPosts}
    lang="it"
  />
</BaseLayout>
