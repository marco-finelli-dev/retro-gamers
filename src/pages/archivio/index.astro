---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/archivio/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/archive/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/archivio/' }
];

const languageSwitch = {
  url: '/en/archive/'
};
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Archivio"
  description="Tutti i contenuti pubblicati su Retro-Gamers.it: recensioni, news, speciali, guide, memories, hardware e interviste dal mondo retro-gaming."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/archivio/"
  languageSwitch={languageSwitch}
  alternateLanguages={alternateLanguages}
>
  <ArchivePage
    title="Archivio"
    eyebrow="Tutti i contenuti"
    description="Tutto quello che abbiamo pubblicato su Retro-Gamers: recensioni, news, speciali, memories, guide, hardware e interviste."
    posts={grouped.all}
  />
</BaseLayout>
