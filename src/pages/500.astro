---
import ErrorLayout from '../layouts/ErrorLayout.astro';

Astro.response.status = 500;
---

<ErrorLayout title="Errore del server">
  <div class="error-page">

    <section class="error-content">

      <span class="error-content__code">500</span>

      <h1>Qualcosa è andato storto</h1>

      <p>
        Il sito ha incontrato un errore temporaneo. Probabilmente un caricamento non è
        andato a buon fine o una risorsa non è disponibile in questo momento.
      </p>

      <div class="error-content__actions">
        <a href="/">Torna alla home</a>
        <a href="/news/">Leggi le news</a>
      </div>

    </section>

  </div>
</ErrorLayout>
