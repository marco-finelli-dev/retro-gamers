---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const { allReviews, allNews } = groupPosts(allPosts);

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/news/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/news/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/news/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/news/',
  name: 'News',
  description: 'Notizie, annunci, nuove uscite e segnalazioni dal mondo retro-gaming.',
  lang: 'it',
  items: createListItems(allNews.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={allReviews}
  news={allNews}
  title="News"
  description="Notizie, annunci, nuove uscite e segnalazioni dal mondo retro-gaming."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/news/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="News"
    eyebrow="Aggiornamenti"
    description="Notizie, annunci, nuove uscite e segnalazioni dal mondo retro-gaming."
    posts={allNews}
    showFilters={false}
  />
</BaseLayout>
