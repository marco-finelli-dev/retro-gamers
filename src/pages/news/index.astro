---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const { allReviews, allNews } = groupPosts(allPosts);

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/news/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/news/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/news/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/news/',
  name: 'News sul retro gaming',
  description: 'Notizie su retro gaming, nuove uscite, hardware, restauri, eventi e progetti dedicati a console, arcade e home computer.',
  lang: 'it',
  items: createListItems(allNews.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={allReviews}
  news={allNews}
  title="News sul retro gaming"
  description="Notizie su retro gaming, nuove uscite, hardware, restauri, eventi e progetti dedicati a console, arcade e home computer."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/news/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="News sul retro gaming"
    eyebrow="Aggiornamenti"
    description="Le news di Retro-Gamers.it seguono ciò che accade oggi attorno ai videogiochi del passato: nuove produzioni per sistemi storici, riedizioni, hardware, restauri, eventi, iniziative di preservazione e progetti indipendenti. Selezioniamo le notizie che hanno un legame concreto con console, home computer, arcade e cultura videoludica, cercando di aggiungere contesto invece di limitarci all’annuncio. Dalle nuove cartucce ai remake, dalle periferiche moderne alle scoperte d’archivio, questa sezione racconta come il retro gaming continui a evolversi e a generare comunità, ricerca e nuove opere."
    posts={allNews}
    showFilters={false}
  />
</BaseLayout>
