---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveCard from '../../components/archive/ArchiveCard.astro';
import Pagination from '../../components/common/Pagination.astro';
import PlatformCard from '../../components/platforms/PlatformCard.astro';
import { urlFor } from '../../lib/image';
import {
  companyTypeLabels,
  getCompanyBySlug,
  getCompanyDescription,
  getCompanyName,
} from '../../lib/companies';
import { getAllPosts, groupPosts } from '../../lib/posts';
import { getCurrentPage, getPaginationUrl, paginateItems, PAGE_SIZE } from '../../lib/pagination';
import '../../styles/pages/companies.css';

const { slug } = Astro.params;

const company = await getCompanyBySlug(slug);

if (!company) {
  return Astro.rewrite('/404');
}

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const name = getCompanyName(company, 'it');
const description = getCompanyDescription(company, 'it');
const history = company.history || '';
const relatedArticles = (company.relatedArticles || [])
  .filter((post) => (post.language || 'it') !== 'en');
const relatedCreators = company.relatedCreators || [];
const relatedPlatforms = company.relatedPlatforms || [];
const typeLabels = (company.type || [])
  .filter((type) => companyTypeLabels.it[type])
  .map((type) => companyTypeLabels.it[type]);

const pageTitle = company.seoTitle || name;
const pageDescription =
  company.metaDescription ||
  description ||
  `${name}: profilo aziendale, articoli, creatori e piattaforme collegati su Retro-Gamers.it.`;

function getLogo(image, width = 620) {
  if (!image?.asset) return '';

  return urlFor(image)
    .width(width)
    .quality(84)
    .auto('format')
    .url();
}

function getPortrait(creator, width = 220, height = 220) {
  if (!creator?.portrait?.asset) return '';

  return urlFor(creator.portrait)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(78)
    .auto('format')
    .url();
}

function getInitials(value = '') {
  return value
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}

const logo = getLogo(company.logo);
const logoLight = getLogo(company.logoLight) || logo;
const primaryLogo = logo || logoLight;
const {
  currentPage: relatedArticlesPage,
  totalPages: relatedArticlesTotalPages,
  items: relatedArticlesPageItems,
} = paginateItems(relatedArticles, getCurrentPage(Astro.url), PAGE_SIZE);
const getRelatedArticlesPageUrl = (pageNumber) => getPaginationUrl(Astro.url, pageNumber);
const hasRelations =
  relatedArticles.length > 0 ||
  relatedCreators.length > 0 ||
  relatedPlatforms.length > 0;
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={pageTitle}
  description={pageDescription}
  canonical={`https://www.retro-gamers.it/aziende/${company.slug}/`}
  languageSwitch={`/en/companies/${company.slug}/`}
  alternateLanguages={[
    { lang: 'it', url: `https://www.retro-gamers.it/aziende/${company.slug}/` },
    { lang: 'en', url: `https://www.retro-gamers.it/en/companies/${company.slug}/` }
  ]}
>
  <main class="companies-page company-detail-page">
    <section class="company-detail-hero">
      <div class="company-detail-hero__logo">
        {primaryLogo ? (
          <span class="company-logo-wrap company-logo-wrap--hero">
            <img
              src={primaryLogo}
              alt={company.logo?.alt || company.logoLight?.alt || name}
              class="company-logo company-logo--dark"
              width="620"
              height="260"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <img
              src={logoLight}
              alt=""
              class="company-logo company-logo--light"
              width="620"
              height="260"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              aria-hidden="true"
            />
          </span>
        ) : (
          <span class="company-detail-hero__fallback">{name}</span>
        )}
      </div>

      <div class="company-detail-hero__content">
        <span class="companies-eyebrow">Scheda azienda</span>
        <h1>{name}</h1>

        {typeLabels.length > 0 && (
          <ul class="company-type-list" aria-label="Tipologie">
            {typeLabels.map((type) => (
              <li>{type}</li>
            ))}
          </ul>
        )}

        {description && (
          <p>{description}</p>
        )}
      </div>
    </section>

    {history && (
      <section class="company-section company-history">
        <div class="company-section__header">
          <span class="companies-eyebrow">Profilo editoriale</span>
          <h2>La storia</h2>
        </div>

        <div class="company-history__content">
          {history.split('\n').filter(Boolean).map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    )}

    {relatedArticles.length > 0 && (
      <section class="company-section">
        <div class="company-section__header">
          <span class="companies-eyebrow">Archivio</span>
          <h2>Articoli collegati</h2>
        </div>

        <div class="company-article-grid">
          {relatedArticlesPageItems.map((post) => (
            <ArchiveCard post={post} lang="it" />
          ))}
        </div>

        <Pagination
          currentPage={relatedArticlesPage}
          totalPages={relatedArticlesTotalPages}
          getPageUrl={getRelatedArticlesPageUrl}
          ariaLabel="Paginazione articoli collegati"
        />
      </section>
    )}

    {relatedCreators.length > 0 && (
      <section class="company-section">
        <div class="company-section__header">
          <span class="companies-eyebrow">Persone</span>
          <h2>Creator collegati</h2>
        </div>

        <div class="company-creator-grid">
          {relatedCreators.map((creator) => {
            const portrait = getPortrait(creator);

            return (
              <a class="company-creator-card" href={`/creatori/${creator.slug}/`}>
                <span class="company-creator-card__portrait">
                  {portrait ? (
                    <img
                      src={portrait}
                      alt={creator.portrait?.alt || creator.name}
                      width="220"
                      height="220"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span>{getInitials(creator.name) || 'RG'}</span>
                  )}
                </span>
                <span>
                  {creator.role && <small>{creator.role}</small>}
                  <strong>{creator.name}</strong>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {relatedPlatforms.length > 0 && (
      <section class="company-section">
        <div class="company-section__header">
          <span class="companies-eyebrow">Hardware</span>
          <h2>Piattaforme collegate</h2>
        </div>

        <div class="company-platform-grid">
          {relatedPlatforms.map((platform) => (
            <PlatformCard platform={platform} lang="it" />
          ))}
        </div>
      </section>
    )}

    {!hasRelations && (
      <section class="companies-empty">
        <h2>Collegamenti in preparazione</h2>
        <p>Articoli, creator e piattaforme saranno aggiunti quando disponibili.</p>
      </section>
    )}
  </main>
</BaseLayout>
