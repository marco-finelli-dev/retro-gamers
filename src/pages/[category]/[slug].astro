---
import Layout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/article/ArticlePage.astro';

import { client } from '../../lib/sanity';
import { getAllPosts, groupPosts, getRelatedPosts } from '../../lib/posts';

const { category, slug } = Astro.params;

const categoryToType = {
  recensioni: 'review',
  news: 'news',
  speciali: 'feature',
  guide: 'guide',
  memories: 'memories',
  interviste: 'interview',
  hardware: 'hardware',
  articoli: 'article'
};

const expectedType = categoryToType[category];

if (!expectedType) {
  return Astro.rewrite('/404');
}

/* ========================
   READING TIME
======================== */

function getPlainTextFromContent(content = []) {
  return content
    .flatMap((block) => {
      if (block._type === 'block') {
        return block.children?.map((child) => child.text || '') || [];
      }

      if (block._type === 'asideBox') {
        return block.content
          ?.filter((inner) => inner._type === 'block')
          .flatMap((inner) =>
            inner.children?.map((child) => child.text || '') || []
          ) || [];
      }

      return [];
    })
    .join(' ');
}

function getReadingTime(content = []) {
  const text = getPlainTextFromContent(content);
  const words = text.trim().split(/\s+/).filter(Boolean).length;

  return Math.max(1, Math.ceil(words / 220));
}

const post = await client.fetch(`
*[
  _type == "article" &&
  slug.current == $slug &&
  type == $expectedType
][0]{
  _id,
  _type,
  type,

  title,
  subtitle,
  excerpt,
  seoTitle,

  "slug": slug.current,
  publishedAt,

 author->{
  name,
  nickname,
  displayName,
  "slug": slug.current
},

  featuredImage {
    alt,
    asset->{ url }
  },

  categories[]->{
    name,
    "slug": slug.current
  },

 platforms[]->{
  name,
  "slug": slug.current,
  platformType,
  badgeLabel,

  manufacturer->{
    name,
    "slug": slug.current
  }
},

  genres[]->{
    name,
    "slug": slug.current
  },

  developers[]->{
    name,
    "slug": slug.current
  },

  publishers[]->{
    name,
    "slug": slug.current
  },

  manufacturer[]->{
    name,
    "slug": slug.current
  },

  modes[]->{
    name,
    "slug": slug.current
  },

  series[]->{
    name,
    "slug": slug.current
  },

  editorialSeries[]->{
    name,
    "slug": slug.current
  },

  relatedSeries[]->{
    name,
    "slug": slug.current
  },

  gameInfo {
    releaseYear,
    mediaFormat,
    cover {
      alt,
      asset->{ url }
    }
  },

  rating,

  monetization {
  isAffiliate,
  productType,
  affiliateUrl,
  affiliateLabel,
  priceLabel,
  disclaimer,
  priority
},

  content[]{
    ...,

    markDefs[]{
      ...,

      _type == "internalLink" => {
        ...,
        reference->{
          type,
          "slug": slug.current
        }
      },

      _type == "taxonomyLink" => {
        ...,
        reference->{
          "slug": slug.current
        }
      }
    },

    _type == "image" => {
      ...,
      asset->{ url }
    },

    _type == "imageRow" => {
      ...,
      images[]{
        ...,
        image{
          asset->{ url }
        }
      }
    },

    _type == "asideBox" => {
      ...,
      content[]{
        ...,

        markDefs[]{
          ...,

          _type == "internalLink" => {
            ...,
            reference->{
              type,
              "slug": slug.current
            }
          },

          _type == "taxonomyLink" => {
            ...,
            reference->{
              "slug": slug.current
            }
          }
        },

        _type == "image" => {
          ...,
          asset->{ url }
        }
      }
    },

    _type == "video" => {
      url
    }
  }
}
`, {
  slug,
  expectedType
});

if (!post) {
  return Astro.rewrite('/404');
}

const readingTime = getReadingTime(post.content);

const hydratedPost = {
  ...post,
  readingTime
};

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const relatedPosts = getRelatedPosts(hydratedPost, grouped.all, 3);
const siteUrl = 'https://www.retro-gamers.it';

const pageTitle =
  post.seoTitle ||
  post.title;

const pageDescription =
  post.excerpt ||
  post.subtitle ||
  'Recensioni, news, speciali e guide dal mondo retro-gaming.';

const pageImage =
  post.featuredImage?.asset?.url ||
  post.gameInfo?.cover?.asset?.url ||
  '/og-image.jpg';

const canonicalUrl =
  `${siteUrl}/${category}/${slug}/`;
---

<Layout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  type="article"
  publishedAt={post.publishedAt}
>
  <ArticlePage post={hydratedPost} relatedPosts={relatedPosts} />
</Layout>