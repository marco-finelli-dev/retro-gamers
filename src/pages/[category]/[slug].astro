---
import Layout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/article/ArticlePage.astro';
import PreviewModeBanner from '../../components/common/PreviewModeBanner.astro';
import {
  getContentTypeFromRouteSegment,
  getPostUrl,
  isContentRouteSegment
} from '../../lib/routes.js';

import { getSanityClient, publicFreshClient } from '../../lib/sanity';
import { isDraftMode } from '../../lib/sanity-preview';
import {
  PUBLIC_POST_GROQ_FILTER,
  getPublicPostSummaries,
  getRelatedPosts,
  isPostPubliclyDistributed
} from '../../lib/posts';
import {
  attachApprovedCommentCounts,
  getApprovedCommentCountMap
} from '../../lib/supabase/comment-counts';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';
import { getNewsletterSubscriptionForUser } from '../../lib/supabase/newsletter';
import { getPublishedArticleQuickEditAction } from '../../lib/editorial/articles.server';
import { getEditorialSessionForUserSession } from '../../lib/editorial/session.server';
import {
  getCreatorRefsFromPortableText,
  getCreatorsReferencingArticle,
  mergeCreatorRefs
} from '../../lib/creators';

/* ========================
   PARAMS + PREVIEW
======================== */

const { category, slug } = Astro.params;

const isPreview = isDraftMode(Astro.cookies);
const sanityClient = getSanityClient(isPreview);
const articleDetailClient = isPreview ? sanityClient : publicFreshClient;

if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
  Astro.response.headers.set('Vary', 'Cookie');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}

const expectedType = category && isContentRouteSegment(category, 'it')
  ? getContentTypeFromRouteSegment(category, 'it')
  : null;

if (!expectedType) {
  return Astro.rewrite('/404');
}

/* ========================
   READING TIME
======================== */

function getPlainTextFromContent(content = []) {
  return content
    .flatMap((block) => {
      if (block._type === 'block') {
        return block.children?.map((child) => child.text || '') || [];
      }

      if (block._type === 'asideBox') {
        return block.content
          ?.filter((inner) => inner._type === 'block')
          .flatMap((inner) =>
            inner.children?.map((child) => child.text || '') || []
          ) || [];
      }

      return [];
    })
    .join(' ');
}

function getReadingTime(content = []) {
  const text = getPlainTextFromContent(content);
  const words = text.trim().split(/\s+/).filter(Boolean).length;

  return Math.max(1, Math.ceil(words / 220));
}

function getEditorialPageTitle(post, fallbackSlug = '') {
  const seoTitle = String(post?.seoTitle || '').trim();
  const title = String(post?.title || '').trim();
  const slugValue = String(fallbackSlug || post?.slug || '').trim();
  const looksLikeSlug =
    seoTitle &&
    (seoTitle === slugValue ||
      (/^[a-z0-9]+(?:-[a-z0-9]+)+$/i.test(seoTitle) &&
        !/[\s:,.!?'"’“”]/.test(seoTitle)));

  return looksLikeSlug
    ? title || seoTitle
    : seoTitle || title;
}

/* ========================
   POST
======================== */

const post = await articleDetailClient.fetch(`
*[
  _type == "article" &&
  slug.current == $slug &&
  type == $expectedType &&
  coalesce(language, "it") == "it"
][0]{
  _id,
  _type,
  type,
  isPublic,
  language,

  translationOf->{
    _id,
    _type,
    type,
    title,
    "slug": slug.current,
    "language": coalesce(language, "it"),
    isPublic
  },

  translatedVersion->{
    _id,
    _type,
    type,
    title,
    "slug": slug.current,
    "language": coalesce(language, "it"),
    isPublic
  },

  title,
  subtitle,
  excerpt,
  cardExcerpt,
  seoTitle,
  aiTransparency,
  aiTransparencyNote,

  "slug": slug.current,
  publishedAt,
  lastUpdated,
  seriesOrder,
  seriesLabel,

  author->{
    name,
    nickname,
    displayName,
    role,
    "slug": slug.current,
    image {
      alt,
      asset->{ url }
    }
  },

  featuredImage {
    alt,
    asset->{ url }
  },

  categories[]->{
    "name": coalesce(name, title),
    "nameEn": coalesce(nameEn, titleEn),
    "slug": slug.current
  },

  platforms[]->{
    name,
    "slug": slug.current,
    platformType,
    badgeLabel,

    manufacturer->{
      name,
      nameEn,
      "slug": slug.current
    }
  },

  genres[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  developers[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  publishers[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  manufacturer[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  modes[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  series[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  editorialSeries[]->{
    _id,
    name,
    nameEn,
    description,
    descriptionEn,
    "slug": slug.current,
    logo {
      alt,
      asset->{ url }
    },
    logoLight {
      alt,
      asset->{ url }
    }
  },

  creators[]->{
    _id,
    name,
    "slug": slug.current,
    role,
    roleEn,
    portrait {
      alt,
      asset->{ url }
    }
  },

  gameInfo {
    releaseYear,
    mediaFormat,
    cover {
      alt,
      asset->{ url }
    }
  },

  rating,
  pros,
  cons,

  monetization {
    isAffiliate,
    productType,
    affiliateUrl,
    affiliateLabel,
    affiliateDescription,
    priceLabel,
    disclaimer,
    priority,
    products[]{
      _key,
      name,
      productType,
      description,
      offers[]{
        _key,
        label,
        retailer,
        affiliateUrl,
        affiliateLabel,
        priceLabel,
        isPrimary,
        isActive
      }
    }
  },

  content[]{
    ...,

    markDefs[]{
      ...,

        _type == "internalLink" => {
        ...,
        reference->{
          _type,
          type,
          isPublic,
          language,
          "slug": slug.current
        }
      },

      _type == "platformLink" => {
        ...,
        reference->{
          name,
          nameEn,
          "slug": slug.current,
          platformType,
          manufacturer->{
            name,
            nameEn,
            "slug": slug.current
          }
        }
      },

      _type == "taxonomyLink" => {
        ...,
        reference->{
          name,
          nameEn,
          "slug": slug.current
        }
      },

      _type == "creatorLink" => {
        ...,
        reference->{
          _id,
          name,
          "slug": slug.current,
          role,
          roleEn,
          portrait {
            alt,
            asset->{ url }
          }
        }
      },

      _type == "companyLink" => {
        ...,
        reference->{
          name,
          nameEn,
          "slug": slug.current,
          type
        }
      }
    },

   _type == "image" => {
  ...,
  alt,
  caption,
  displayMode,
  isWide,
  asset->{ url, mimeType, extension, originalFilename }
},

_type == "imageRow" => {
  ...,
  layout,
  groupCaption,
  images[]{
    ...,
    alt,
    caption,
    displayMode,
    image{
      asset->{ url, mimeType, extension, originalFilename, metadata{ dimensions{ width, height } } }
    }
  }
},

_type == "videoRow" => {
  ...,
  groupCaption,
  videos[]{
    ...,
    url,
    title,
    caption
  }
},

    _type == "asideBox" => {
      ...,
      content[]{
        ...,

        markDefs[]{
          ...,

                    _type == "internalLink" => {
            ...,
            reference->{
              _type,
              type,
              isPublic,
              language,
              "slug": slug.current
            }
          },

          _type == "platformLink" => {
            ...,
            reference->{
              name,
              nameEn,
              "slug": slug.current,
              platformType,
              manufacturer->{
                name,
                nameEn,
                "slug": slug.current
              }
            }
          },

          _type == "taxonomyLink" => {
            ...,
            reference->{
              name,
              nameEn,
              "slug": slug.current
            }
          },

          _type == "creatorLink" => {
            ...,
            reference->{
              _id,
              name,
              "slug": slug.current,
              role,
              roleEn,
              portrait {
                alt,
                asset->{ url }
              }
            }
          },

          _type == "companyLink" => {
            ...,
            reference->{
              name,
              nameEn,
              "slug": slug.current,
              type
            }
          }
        },

  _type == "image" => {
  ...,
  alt,
  caption,
  displayMode,
  isWide,
  asset->{ url, mimeType, extension, originalFilename }
},

_type == "imageRow" => {
  ...,
  layout,
  groupCaption,
  images[]{
    ...,
    alt,
    caption,
    displayMode,
    image{
      asset->{ url, mimeType, extension, originalFilename, metadata{ dimensions{ width, height } } }
    }
  }
}
      }
    },

    _type == "video" => {
      url,
      title
    }
  }
}
`, {
  slug,
  expectedType,
  isPreview
});

if (!post) {
  return Astro.rewrite('/404');
}

const publishedPostId = post._id.replace('drafts.', '');
const portableTextCreators = getCreatorRefsFromPortableText(post.content);

/* ========================
   ENGLISH TRANSLATION
======================== */

const directEnglishTranslation = [
  post.translatedVersion,
  post.translationOf
].find((candidate) =>
  candidate?.slug &&
  candidate.language === 'en' &&
  (isPreview || isPostPubliclyDistributed(candidate))
) || null;

const reverseEnglishTranslationPromise = directEnglishTranslation
  ? Promise.resolve(null)
  : sanityClient.fetch(`
    *[
      _type == "article" &&
      defined(slug.current) &&
      language == "en" &&
      ($isPreview || ${PUBLIC_POST_GROQ_FILTER}) &&
      (
        translationOf._ref == $postId ||
        translatedVersion._ref == $postId
      )
    ][0]{
      _id,
      _type,
      type,
      title,
      "slug": slug.current,
      language,
      isPublic
    }
	  `, {
    postId: publishedPostId,
    isPreview
  });

/* ========================
   HYDRATION
======================== */

const readingTime = getReadingTime(post.content);

/* ========================
   SERIES
======================== */

const seriesId = post.editorialSeries?.[0]?._id || null;

const seriesPostsPromise = seriesId
  ? sanityClient.fetch(`
    *[
      _type == "article" &&
      defined(slug.current) &&
      ($isPreview || ${PUBLIC_POST_GROQ_FILTER}) &&
      coalesce(language, "it") == "it" &&
      references($seriesId)
    ] | order(coalesce(seriesOrder, 999) asc, coalesce(publishedAt, _createdAt) asc) {
      _id,
      type,
      language,
      title,
      subtitle,
      "slug": slug.current,
      publishedAt,
      seriesOrder,
      seriesLabel,
      featuredImage {
        alt,
        asset->{ url }
      },
      gameInfo {
        cover {
          alt,
          asset->{ url }
        }
      }
    }
	  `, { seriesId, isPreview })
  : Promise.resolve([]);

/* ========================
   COMMENTS
======================== */

const commentsPromise = sanityClient.fetch(`
  *[
    _type == "comment" &&
    article._ref == $postId &&
    status == "approved"
  ] | order(createdAt asc) {
    _id,
    authorName,
    body,
    createdAt,
    isHighlighted,
    editorReply,
    editorReplies[]{
      authorName,
      authorRole,
      body,
      createdAt
    },
    likes,
    dislikes,
    language,
    parentComment->{
      _id,
      authorName
    }
  }
`, {
  postId: publishedPostId
});

/* ========================
   GLOBAL DATA
======================== */

const [
  inverseCreators,
  reverseEnglishTranslation,
  seriesPosts,
  comments,
  publicPostSummaries,
  viewerSession
] = await Promise.all([
  getCreatorsReferencingArticle(publishedPostId),
  reverseEnglishTranslationPromise,
  seriesPostsPromise,
  commentsPromise,
  getPublicPostSummaries(),
  getUserSessionFromCookies(Astro.cookies)
]);

const articleCreators = mergeCreatorRefs(
  post.creators,
  inverseCreators,
  portableTextCreators
);

const englishTranslation =
  directEnglishTranslation ||
  reverseEnglishTranslation;

let hydratedPost = {
  ...post,
  creators: articleCreators,
  language: post.language || 'it',
  readingTime
};

const headerReviews = publicPostSummaries.filter((item) =>
  item.type === 'review' && (item.language || 'it') !== 'en'
);
const headerNews = publicPostSummaries.filter((item) =>
  item.type === 'news' && (item.language || 'it') !== 'en'
);

const relatedPosts = getRelatedPosts(hydratedPost, publicPostSummaries, 3);
const commentCountMap = await getApprovedCommentCountMap([hydratedPost, ...relatedPosts], 'it');
hydratedPost = attachApprovedCommentCounts([hydratedPost], commentCountMap, 'it')[0];
const relatedPostsWithCommentCounts = attachApprovedCommentCounts(
  relatedPosts,
  commentCountMap,
  'it'
);

let hideNewsletterPromo = false;

if (!viewerSession.error && viewerSession.user) {
  const newsletter = await getNewsletterSubscriptionForUser(
    viewerSession.user.id,
    viewerSession.user.email
  );

  hideNewsletterPromo = newsletter.status === 'active' || newsletter.status === 'pending';
}

const editorialSession = await getEditorialSessionForUserSession(viewerSession);
const editorialQuickEdit = await getPublishedArticleQuickEditAction({
  context: editorialSession,
  rootDocumentId: publishedPostId,
  language: 'it',
});

const siteUrl = 'https://www.retro-gamers.it';

const pageTitle = getEditorialPageTitle(post, slug);

const pageDescription =
  post.excerpt ||
  post.subtitle ||
  'Recensioni, news, speciali e guide dal mondo retro-gaming.';

const pageImage =
  post.featuredImage?.asset?.url ||
  post.gameInfo?.cover?.asset?.url ||
  '/og-image.jpg';

const canonicalUrl =
  `${siteUrl}/${category}/${slug}/`;

const canonicalPath =
  `/${category}/${slug}/`;

const englishPath =
  englishTranslation?.slug
    ? getPostUrl(englishTranslation)
    : null;

const englishUrl =
  englishPath
    ? `${siteUrl}${englishPath}`
    : null;

const alternateLanguages = englishUrl
  ? [
      {
        lang: 'it',
        url: canonicalUrl
      },
      {
        lang: 'en',
        url: englishUrl
      },
      {
        lang: 'x-default',
        url: canonicalUrl
      }
    ]
  : [];

const articleAuthorName =
  post.author?.displayName === 'nickname' && post.author?.nickname
    ? post.author.nickname
    : post.author?.name || '';
const articleAuthorSlug =
  typeof post.author?.slug === 'string'
    ? post.author.slug
    : post.author?.slug?.current || '';
const articleAuthorUrl = articleAuthorSlug
  ? `/autori/${articleAuthorSlug}/`
  : '';
---

<Layout
  reviews={headerReviews}
  news={headerNews}
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  type="article"
  publishedAt={post.publishedAt}
  updatedAt={post.lastUpdated}
  articleAuthorName={articleAuthorName}
  articleAuthorUrl={articleAuthorUrl}
  lang="it"
  alternateLanguages={alternateLanguages}
  noindex={isPreview || !isPostPubliclyDistributed(post)}
>

  {isPreview && (
    <PreviewModeBanner lang="it" returnTo={canonicalPath} />
  )}

  <ArticlePage
    post={hydratedPost}
    relatedPosts={relatedPostsWithCommentCounts}
    seriesPosts={seriesPosts}
    comments={comments}
    hideNewsletterPromo={hideNewsletterPromo}
    isPreview={isPreview}
    editorialQuickEdit={editorialQuickEdit}
    languageSwitch={
      englishPath
        ? { url: englishPath, language: englishTranslation.language }
        : null
    }
  />

</Layout>
