---
import BaseLayout from '../layouts/BaseLayout.astro';

import Hero from '../components/home/Hero.astro';
import Latest from '../components/home/Latest.astro';
import Reviews from '../components/home/Reviews.astro';
import EditorialHub from '../components/home/EditorialHub.astro';
import ArchiveStrip from '../components/home/ArchiveStrip.astro';
import Interviews from '../components/home/Interviews.astro';
import Hardware from '../components/home/Hardware.astro';

import '../styles/pages/home.css';

import { getAllPosts, groupPosts } from '../lib/posts';
import {
  attachApprovedCommentCounts,
  getApprovedCommentCountMap
} from '../lib/supabase/comment-counts';

const allPosts = await getAllPosts();

const {
  hero,
  reviews,
  specials,
  memories,
  latest,
  news,
  hardware,
  archive,
  interviews,
  guides
} = groupPosts(allPosts);

const homeCommentCountMap = await getApprovedCommentCountMap(
  [
    ...hero,
    ...reviews,
    ...specials,
    ...memories,
    ...guides,
    ...archive,
    ...interviews,
    ...hardware,
    ...latest
  ],
  'it'
);

const withCommentCounts = (posts) =>
  attachApprovedCommentCounts(posts, homeCommentCountMap, 'it');
---

<BaseLayout
  reviews={reviews}
  news={news}
  title="Retro-Gamers.it"
  description="Recensioni, news, speciali, guide e approfondimenti dal mondo retro-gaming, console, arcade e home computer."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/"
>

  <section class="home-hero">
    <div class="container">
      <Hero posts={withCommentCounts(hero)} />
    </div>
  </section>

  <section class="home-reviews">
    <div class="container">
      <Reviews posts={withCommentCounts(reviews)} />
    </div>
  </section>

  <section class="home-editorial">
    <div class="container">
      <EditorialHub
        specials={withCommentCounts(specials)}
        memories={withCommentCounts(memories)}
        guides={withCommentCounts(guides)}
      />
    </div>
  </section>

  <section class="home-archive">
    <div class="container">
      <ArchiveStrip posts={withCommentCounts(archive)} />
    </div>
  </section>

  {interviews.length > 0 && (
    <section class="home-interviews">
      <div class="container">
        <Interviews posts={withCommentCounts(interviews)} />
      </div>
    </section>
  )}

  <section class="home-hardware">
    <div class="container">
      <Hardware posts={withCommentCounts(hardware)} />
    </div>
  </section>

  <section class="home-latest">
    <div class="container">
      <Latest posts={withCommentCounts(latest)} />
    </div>
  </section>

</BaseLayout>
