---
import '../styles/pages/badges.css';

import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getActiveReaderBadges,
  getReaderBadgeImageSrcForBadge,
  getReaderBadgeInitials,
  getReaderBadgeLabel
} from '../lib/badges';

const badges = await getActiveReaderBadges({ lang: 'it' });

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/badges/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/badges/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/badges/' }
];

const languageSwitch = {
  url: '/en/badges/'
};
---

<BaseLayout
  title="Badge lettore"
  description="Piccoli segni d’identità per raccontare il tuo angolo di retro-gaming su Retro-Gamers.it."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/badges/"
  languageSwitch={languageSwitch}
  alternateLanguages={alternateLanguages}
>
  <div class="legal-page">
    <div class="container">

      <section class="legal-hero">
        <span>Community</span>
        <h1>Badge lettore</h1>
        <p>
          Piccoli segni d’identità per raccontare il tuo angolo di retro-gaming.
        </p>
      </section>

      <article class="legal-content">
        <h2>La tua firma nei commenti</h2>

        <p class="reader-badges-intro">
          Puoi scegliere il tuo badge durante la registrazione o cambiarlo dal
          pannello account.
        </p>

        <div class="reader-badges-grid">
          {badges.map((badge) => {
            const label = getReaderBadgeLabel(badge, 'it');
            const imageSrc = getReaderBadgeImageSrcForBadge(badge);
            const fallback = getReaderBadgeInitials(label) || 'RG';

            return (
              <article class="reader-badge-card">
                <div class="reader-badge-card__visual" aria-hidden="true">
                  {imageSrc ? (
                    <img src={imageSrc} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="reader-badge-card__fallback">{fallback}</span>
                  )}
                </div>

                <h2>{label}</h2>
              </article>
            );
          })}
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
