---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const posts = grouped.all.filter((post) =>
  post.type === 'hardware' ||
  post.monetization?.isAffiliate
);

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/hardware/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/hardware/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/hardware/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/hardware/',
  name: 'Hardware',
  description: 'Console, computer, periferiche, accessori e prodotti interessanti per retrogamer e collezionisti.',
  lang: 'it',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Hardware"
  description="Console, computer, periferiche, accessori e prodotti interessanti per retrogamer e collezionisti."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/hardware/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Hardware"
    eyebrow="Gear, libri e accessori"
    description="Console, computer, periferiche, libri, accessori e prodotti interessanti per retrogamer e collezionisti."
    posts={posts}
    showFilters={false}
  />
</BaseLayout>
