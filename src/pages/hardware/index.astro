---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const posts = grouped.all.filter((post) =>
  post.type === 'hardware' ||
  post.monetization?.isAffiliate
);

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/hardware/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/hardware/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/hardware/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/hardware/',
  name: 'Hardware per il retro gaming',
  description: 'Recensioni, prove e guide su hardware, periferiche e accessori per sistemi classici, collezionisti e appassionati di retro gaming.',
  lang: 'it',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Hardware per il retro gaming"
  description="Recensioni, prove e guide su hardware, periferiche e accessori per sistemi classici, collezionisti e appassionati di retro gaming."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/hardware/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Hardware per il retro gaming"
    eyebrow="Gear, libri e accessori"
    description="La sezione Hardware raccoglie prove, approfondimenti e segnalazioni dedicate a computer, console, periferiche e accessori legati al retro gaming. Raccontiamo sia le macchine originali sia le soluzioni moderne pensate per conservarle, collegarle ai display attuali o renderle più pratiche da usare, distinguendo tra analisi tecnica, esperienza diretta e informazioni del produttore. Dai nuovi sistemi ispirati ai classici alle periferiche, ai supporti di memoria e ai prodotti per collezionisti, l’obiettivo è aiutare il lettore a capire cosa offre davvero ogni dispositivo e a chi può essere utile."
    posts={posts}
    showFilters={false}
  />
</BaseLayout>
