---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformsLanding from '../../components/platforms/PlatformsLanding.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { getAllPlatforms } from '../../lib/platforms';
import { getPlatformIndexUrl, getPlatformTypeUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const platforms = await getAllPlatforms();

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/piattaforme/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/platforms/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/piattaforme/' }
];

const platformTypeItems = [
  { name: 'Arcade', url: getPlatformTypeUrl('arcade', 'it') },
  { name: 'Computer', url: getPlatformTypeUrl('computer', 'it') },
  { name: 'Console', url: getPlatformTypeUrl('console', 'it') }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/piattaforme/',
  name: 'Piattaforme',
  description: 'Console, home computer, arcade e sistemi storici raccontati da Retro-Gamers.it: schede, contesto, caratteristiche e percorsi nella storia del videogioco.',
  lang: 'it',
  items: createListItems(platformTypeItems, (item) => item)
});
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Piattaforme"
  description="Console, home computer, arcade e sistemi storici raccontati da Retro-Gamers.it: schede, contesto, caratteristiche e percorsi nella storia del videogioco."
  image="/og-image.jpg"
  canonical={`https://www.retro-gamers.it${getPlatformIndexUrl('it')}`}
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <PlatformsLanding platforms={platforms} />
</BaseLayout>
