---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PlatformDetail from '../../../../components/platforms/PlatformDetail.astro';
import ArchiveCard from '../../../../components/archive/ArchiveCard.astro';
import Pagination from '../../../../components/common/Pagination.astro';

import { getAllPosts, groupPosts } from '../../../../lib/posts';
import {
  getPlatformByPath,
  getPlatformTypeFromParam
} from '../../../../lib/platforms';
import { getCurrentPage, getPaginationUrl, paginateItems, PAGE_SIZE } from '../../../../lib/pagination';

const { type, manufacturer, platform } = Astro.params;

const platformType = getPlatformTypeFromParam(type);

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const platformData = await getPlatformByPath(
  platformType,
  manufacturer,
  platform
);

if (!platformData) {
  return Astro.redirect('/piattaforme/');
}

const currentPage = getCurrentPage(Astro.url);

const relatedPlatformPosts = allPosts
  .filter((post) =>
    (post.language || 'it') !== 'en' &&
    post.platforms?.some((item) => item._id === platformData._id)
  )
  .sort((a, b) =>
    new Date(b.publishedAt || 0).getTime() -
    new Date(a.publishedAt || 0).getTime()
  );

const {
  currentPage: relatedPage,
  total: relatedTotal,
  totalPages: relatedTotalPages,
  items: relatedPagePosts,
} = paginateItems(relatedPlatformPosts, currentPage, PAGE_SIZE);
const getRelatedPageUrl = (pageNumber) => getPaginationUrl(Astro.url, pageNumber);

const truncateDescription = (text, maxLength = 155) => {
  const cleanText = text?.replace(/\s+/g, ' ').trim() || '';

  if (cleanText.length <= maxLength) {
    return cleanText;
  }

  const cutIndex = cleanText.lastIndexOf(' ', maxLength);
  const safeIndex = cutIndex > 0 ? cutIndex : maxLength;

  return `${cleanText.slice(0, safeIndex).trim()}...`;
};

const pageDescription =
  truncateDescription(platformData.history) ||
  `${platformData.name}: storia, caratteristiche e dettagli della piattaforma nell’archivio di Retro-Gamers.it.`;
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={platformData.name}
  description={pageDescription}
  image={platformData.cover?.asset?.url || platformData.logoLight?.asset?.url || platformData.logo?.asset?.url || '/og-image.jpg'}
  canonical={`https://www.retro-gamers.it/piattaforme/${platformType}/${manufacturer}/${platform}/`}
>
  <PlatformDetail platform={platformData} />

  {relatedTotal > 0 && (
    <section class="platform-related">
      <div class="container">
        <div class="platform-related__inner">
          <div class="platform-related__header">
            <span>Archivio</span>
            <h2>Articoli collegati</h2>
            <p>Recensioni, speciali, guide e approfondimenti legati a questa piattaforma.</p>
          </div>

          <div class="platform-related__grid">
            {relatedPagePosts.map((post) => (
              <ArchiveCard post={post} />
            ))}
          </div>

          <Pagination
            currentPage={relatedPage}
            totalPages={relatedTotalPages}
            getPageUrl={getRelatedPageUrl}
            ariaLabel="Paginazione articoli collegati"
          />
        </div>
      </div>
    </section>
  )}
</BaseLayout>
