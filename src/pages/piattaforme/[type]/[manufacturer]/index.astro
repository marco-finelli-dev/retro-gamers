---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ManufacturerPage from '../../../../components/platforms/ManufacturerPage.astro';

import { getAllPosts, groupPosts } from '../../../../lib/posts';
import {
  getPlatformsByTypeAndManufacturer
} from '../../../../lib/platforms';
import {
  getPlatformManufacturerUrl,
  getPlatformTypeFromRouteSegment
} from '../../../../lib/routes.js';

const { type, manufacturer } = Astro.params;

const platformType = getPlatformTypeFromRouteSegment(type, 'it') || 'console';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const platforms = await getPlatformsByTypeAndManufacturer(
  platformType,
  manufacturer
);

const resolvedManufacturer =
  platforms[0]?.manufacturer ||
  {
    name: 'Produttore',
    slug: manufacturer
  };
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={`Piattaforme ${resolvedManufacturer.name}`}
  description={`Tutte le piattaforme ${resolvedManufacturer.name} presenti nell’archivio di Retro-Gamers.it, tra console, computer, arcade e sistemi storici.`}
  image={resolvedManufacturer.logoLight?.asset?.url || resolvedManufacturer.logo?.asset?.url || '/og-image.jpg'}
  canonical={`https://www.retro-gamers.it${getPlatformManufacturerUrl(platformType, manufacturer, 'it')}`}
>
  <ManufacturerPage
    type={platformType}
    manufacturer={resolvedManufacturer}
    platforms={platforms}
  />
</BaseLayout>
