---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ManufacturerPage from '../../../../components/platforms/ManufacturerPage.astro';

import { getAllPosts, groupPosts } from '../../../../lib/posts';
import {
  getAllPlatforms,
  getPlatformsByTypeAndManufacturer,
  getPlatformTypeFromParam
} from '../../../../lib/platforms';

export async function getStaticPaths() {
  const platforms = await getAllPlatforms();

  const paths = new Map();

  for (const platform of platforms) {
    if (!platform.platformType || !platform.manufacturer?.slug) continue;

    const key = `${platform.platformType}/${platform.manufacturer.slug}`;

    if (!paths.has(key)) {
      paths.set(key, {
        params: {
          type: platform.platformType,
          manufacturer: platform.manufacturer.slug
        },
        props: {
          manufacturer: platform.manufacturer
        }
      });
    }
  }

  return Array.from(paths.values());
}

const { type, manufacturer } = Astro.params;
const { manufacturer: manufacturerData } = Astro.props;

const platformType = getPlatformTypeFromParam(type);

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const platforms = await getPlatformsByTypeAndManufacturer(
  platformType,
  manufacturer
);

const resolvedManufacturer =
  manufacturerData ||
  platforms[0]?.manufacturer ||
  {
    name: 'Produttore',
    slug: manufacturer
  };
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={`Piattaforme ${resolvedManufacturer.name}`}
  description={`Tutte le piattaforme ${resolvedManufacturer.name} presenti nell’archivio di Retro-Gamers.it, tra console, computer, arcade e sistemi storici.`}
  image={resolvedManufacturer.logoLight?.asset?.url || resolvedManufacturer.logo?.asset?.url || '/og-image.jpg'}
  canonical={`https://www.retro-gamers.it/piattaforme/${platformType}/${manufacturer}/`}
>
  <ManufacturerPage
    type={platformType}
    manufacturer={resolvedManufacturer}
    platforms={platforms}
  />
</BaseLayout>
