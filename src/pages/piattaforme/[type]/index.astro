---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlatformTypePage from '../../../components/platforms/PlatformTypePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';
import { getPlatformsByType } from '../../../lib/platforms';
import type { PlatformType } from '../../../lib/platforms';
import {
  getPlatformIndexUrl,
  getPlatformTypeFromRouteSegment,
  getPlatformTypeUrl,
  isPlatformRouteSegment
} from '../../../lib/routes.js';

const { type } = Astro.params;

if (!isPlatformRouteSegment(type, 'it')) {
  return Astro.redirect(getPlatformIndexUrl('it'));
}

const platformType = getPlatformTypeFromRouteSegment(type, 'it') as PlatformType;

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const platforms = await getPlatformsByType(platformType);

const pageTitles = {
  arcade: 'Arcade',
  computer: 'Computer',
  console: 'Console'
};

const pageDescriptions = {
  arcade: 'Cabinet, board e sistemi arcade che hanno definito l’esperienza da sala giochi.',
  computer: 'Home computer, personal computer e macchine che hanno fatto la storia dell’informatica domestica.',
  console: 'Console domestiche, portatili e sistemi da gioco che hanno segnato la storia del videogioco.'
};
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={pageTitles[platformType] || 'Piattaforme'}
  description={pageDescriptions[platformType] || 'Console, home computer, arcade e sistemi storici raccontati da Retro-Gamers.it.'}
  image="/og-image.jpg"
  canonical={`https://www.retro-gamers.it${getPlatformTypeUrl(platformType, 'it')}`}
>
  <PlatformTypePage
    type={platformType}
    platforms={platforms}
  />
</BaseLayout>
