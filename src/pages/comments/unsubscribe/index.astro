---
import '../../../styles/pages/account.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase/server';
import { isValidUnsubscribeToken } from '../../../lib/supabase/comment-subscriptions';

const title = 'Disiscrizione notifiche | Retro-Gamers.it';
const description = 'Interrompi le notifiche email dei commenti su Retro-Gamers.it.';
const token = Astro.url.searchParams.get('token')?.trim() ?? '';

let status: 'missing' | 'invalid' | 'success' | 'already' | 'error' = 'missing';
let message = 'Il link di disiscrizione non è valido o non è più attivo.';

if (token) {
  if (!isValidUnsubscribeToken(token)) {
    status = 'invalid';
  } else {
    const { data, error } = await supabaseAdmin
      .from('comment_subscriptions')
      .update({ is_active: false })
      .eq('unsubscribe_token', token)
      .eq('is_active', true)
      .select('id');

    if (error) {
      status = 'error';
    } else if ((data ?? []).length > 0) {
      status = 'success';
      message = 'La disiscrizione è stata completata.';
    } else {
      status = 'already';
    }
  }
}

const isSuccess = status === 'success';
const secondaryText = isSuccess
  ? 'Non riceverai più email per questa conversazione.'
  : 'Se continui a ricevere email da questa conversazione, puoi riprovare usando il link più recente.';
---

<BaseLayout title={title} description={description}>
  <main class="account-page">
    <section class="account-card">
      <p class="account-kicker">Notifiche commenti</p>
      <h1>Disiscrizione</h1>
      <p
        class="account-message"
        data-type={status === 'success' || status === 'already' ? 'ok' : 'error'}
      >
        {message}
      </p>

      <p class="account-switch">
        {secondaryText}
      </p>

      <div class="account-actions account-actions--standalone">
        <a href="/">Torna alla home</a>
      </div>
    </section>
  </main>
</BaseLayout>
