---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const posts = grouped.all.filter((post) => post.type === 'feature');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/speciali/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/features/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/speciali/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/speciali/',
  name: 'Speciali e retrospettive videoludiche',
  description: 'Approfondimenti e retrospettive su videogiochi, autori, software house e cultura digitale, dalla storia del medium alla sua evoluzione.',
  lang: 'it',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Speciali e retrospettive videoludiche"
  description="Approfondimenti e retrospettive su videogiochi, autori, software house e cultura digitale, dalla storia del medium alla sua evoluzione."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/speciali/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Speciali e retrospettive videoludiche"
    eyebrow="Approfondimenti"
    description="Gli speciali di Retro-Gamers.it approfondiscono storie, autori, software house e momenti decisivi della cultura videoludica. Ricostruiamo lo sviluppo di serie, generi e tecnologie attraverso fonti, testimonianze e contesto storico, osservando anche ciò che è rimasto fuori dalle cronache più conosciute. Dai protagonisti dell’industria alle scene creative nate attorno a console e home computer, ogni articolo cerca di restituire complessità, memoria e valore culturale al percorso del videogioco."
    posts={posts}
    showFilters={false}
  />
</BaseLayout>
