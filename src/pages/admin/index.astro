---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityHero from '../../components/community/CommunityHero.astro';
import CommunityLayout from '../../components/community/CommunityLayout.astro';
import CommunitySidebarSection from '../../components/community/CommunitySidebarSection.astro';
import { getUserSessionFromCookies, isStaffProfile } from '../../lib/supabase/auth';
import { supabaseAdmin } from '../../lib/supabase/server';
import '../../styles/pages/admin-dashboard.css';

type CountResult = {
  value: number | null;
  error: string;
};

type RecentComment = {
  id: string;
  article_title?: string | null;
  article_url?: string | null;
  body?: string | null;
  status?: string | null;
  created_at?: string | null;
  profiles?: {
    username?: string | null;
    display_name?: string | null;
  } | null;
};

const title = 'Area redazione | Retro-Gamers.it';
const description = 'Cabina di controllo redazionale per commenti, segnalazioni, utenti e attività community.';
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = isStaffProfile(session.profile);

const dateFormatter = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
});

const isOptionalDataError = (error: unknown) => {
  const apiError = error as { code?: string; message?: string; details?: string; hint?: string } | null;
  const message = `${apiError?.message || ''} ${apiError?.details || ''} ${apiError?.hint || ''}`.toLowerCase();

  return (
    apiError?.code === '42P01' ||
    apiError?.code === '42703' ||
    apiError?.code === 'PGRST204' ||
    apiError?.code === 'PGRST205' ||
    message.includes('does not exist') ||
    message.includes('schema cache')
  );
};

const safeCount = async (callback: () => PromiseLike<{ count: number | null; error: unknown }>): Promise<CountResult> => {
  try {
    const { count, error } = await callback();

    if (error) {
      return {
        value: null,
        error: isOptionalDataError(error) ? 'Dato non disponibile' : 'Conteggio non disponibile',
      };
    }

    return { value: count ?? 0, error: '' };
  } catch {
    return { value: null, error: 'Conteggio non disponibile' };
  }
};

const formatCount = (count: CountResult) =>
  count.value === null ? '—' : new Intl.NumberFormat('it-IT').format(count.value);

let pendingComments: CountResult = { value: null, error: '' };
let openCommentReports: CountResult = { value: null, error: '' };
let openPrivateReports: CountResult = { value: null, error: '' };
let registeredUsers: CountResult = { value: null, error: '' };
let readerRatings: CountResult = { value: null, error: '' };
let recentComments: RecentComment[] = [];
let recentCommentsError = '';

if (isStaff) {
  [
    pendingComments,
    openCommentReports,
    openPrivateReports,
    registeredUsers,
    readerRatings,
  ] = await Promise.all([
    safeCount(() =>
      supabaseAdmin
        .from('comments')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'pending')
        .is('deleted_at', null)
    ),
    safeCount(() =>
      supabaseAdmin
        .from('comment_reports')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'open')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('private_message_reports')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'open')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('profiles')
        .select('id', { count: 'exact', head: true })
    ),
    safeCount(() =>
      supabaseAdmin
        .from('review_ratings')
        .select('id', { count: 'exact', head: true })
    ),
  ]);

  const { data, error } = await supabaseAdmin
    .from('comments')
    .select(`
      id,
      article_title,
      article_url,
      body,
      status,
      created_at,
      profiles:profile_id (
        username,
        display_name
      )
    `)
    .in('status', ['approved', 'pending'])
    .is('deleted_at', null)
    .order('created_at', { ascending: false })
    .limit(5);

  if (error) {
    recentCommentsError = isOptionalDataError(error)
      ? 'Commenti recenti non disponibili.'
      : 'Impossibile caricare i commenti recenti.';
  } else {
    recentComments = (data ?? []) as RecentComment[];
  }
}

const dashboardCards = [
  {
    label: 'Commenti da revisionare',
    value: pendingComments,
    href: '/admin/comments/?status=pending',
    cta: 'Vai alla moderazione',
  },
  {
    label: 'Segnalazioni commenti aperte',
    value: openCommentReports,
    href: '/admin/comment-reports/?status=open',
    cta: 'Vedi segnalazioni',
  },
  {
    label: 'Segnalazioni messaggi aperte',
    value: openPrivateReports,
    href: '/admin/private-message-reports/?status=open',
    cta: 'Vedi segnalazioni',
  },
  {
    label: 'Utenti registrati',
    value: registeredUsers,
    href: '/admin/users/',
    cta: 'Gestisci utenti',
  },
  {
    label: 'Voti lettori',
    value: readerRatings,
    href: '/admin/ratings/',
    cta: 'Vedi voti',
  },
];

const staffLinks = [
  { href: '/admin/', label: 'Area redazione' },
  { href: '/admin/comments/', label: 'Moderazione commenti' },
  { href: '/admin/comment-reports/', label: 'Segnalazioni commenti' },
  { href: '/admin/users/', label: 'Gestione utenti' },
  { href: '/admin/private-message-reports/', label: 'Segnalazioni messaggi' },
  { href: '/admin/ratings/', label: 'Voti lettori' },
];

const getCommentAuthor = (comment: RecentComment) =>
  comment.profiles?.display_name || comment.profiles?.username || 'Lettore';

const getCommentStatusLabel = (status?: string | null) =>
  status === 'pending' ? 'Da revisionare' : 'Approvato';

const truncate = (value = '', maxLength = 170) => {
  const normalized = value.replace(/\s+/g, ' ').trim();

  return normalized.length > maxLength
    ? `${normalized.slice(0, maxLength - 1).trim()}…`
    : normalized;
};
---

<BaseLayout title={title} description={description}>
  <CommunityLayout class="admin-dashboard-page" sidebar={isStaff}>
    <Fragment slot="sidebar">
      {isStaff && (
        <CommunitySidebarSection title="Strumenti redazione">
          <div class="community-staff-links">
            {staffLinks.map((link) => (
              <a class="community-action-link" href={link.href}>{link.label}</a>
            ))}
          </div>
        </CommunitySidebarSection>
      )}
    </Fragment>

    {isStaff ? (
      <>
        <CommunityHero
          kicker="Retro-Gamers.it"
          title="Area redazione"
          description="Una panoramica rapida su commenti, segnalazioni, utenti e attività della community."
        >
          <span slot="aside" class="community-soft-badge">Dashboard</span>
        </CommunityHero>

        <section class="admin-dashboard-grid" aria-label="Riepilogo strumenti redazione">
          {dashboardCards.map((card) => (
            <article class="community-card admin-dashboard-card">
              <span>{card.label}</span>
              <strong>{formatCount(card.value)}</strong>
              {card.value.error && <small>{card.value.error}</small>}
              <a href={card.href}>{card.cta}</a>
            </article>
          ))}
        </section>

        <section class="community-card admin-dashboard-recent">
          <div class="admin-dashboard-section-heading">
            <div>
              <p>Community</p>
              <h2>Commenti recenti</h2>
            </div>

            <a href="/admin/comments/">Apri strumenti</a>
          </div>

          {recentCommentsError ? (
            <p class="admin-dashboard-empty">{recentCommentsError}</p>
          ) : recentComments.length > 0 ? (
            <div class="admin-dashboard-comment-list">
              {recentComments.map((comment) => (
                <article class="admin-dashboard-comment">
                  <header>
                    <span data-status={comment.status || 'approved'}>
                      {getCommentStatusLabel(comment.status)}
                    </span>
                    {comment.created_at && (
                      <time datetime={comment.created_at}>
                        {dateFormatter.format(new Date(comment.created_at))}
                      </time>
                    )}
                  </header>

                  <h3>{comment.article_title || 'Articolo Retro-Gamers.it'}</h3>
                  <p>{truncate(comment.body || '')}</p>

                  <footer>
                    <span>{getCommentAuthor(comment)}</span>
                    <div>
                      {comment.article_url && (
                        <a href={`${comment.article_url}#comment-${comment.id}`}>Vai al commento</a>
                      )}
                      <a href={`/admin/comments/?status=${comment.status === 'pending' ? 'pending' : 'approved'}`}>
                        Moderazione
                      </a>
                    </div>
                  </footer>
                </article>
              ))}
            </div>
          ) : (
            <p class="admin-dashboard-empty">Nessun commento recente da mostrare.</p>
          )}
        </section>
      </>
    ) : (
      <>
        <CommunityHero
          kicker="Retro-Gamers.it"
          title="Accesso redazione"
          description="Questa pagina è riservata allo staff Retro-Gamers.it."
        />

        <section class="community-card">
          <div class="community-staff-links">
            <a class="community-action-link" href="/account/login/">Accedi</a>
          </div>
        </section>
      </>
    )}
  </CommunityLayout>
</BaseLayout>
