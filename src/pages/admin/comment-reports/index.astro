---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommunityHero from '../../../components/community/CommunityHero.astro';
import CommunityLayout from '../../../components/community/CommunityLayout.astro';
import CommunitySidebarSection from '../../../components/community/CommunitySidebarSection.astro';
import { getUserSessionFromCookies } from '../../../lib/supabase/auth';
import '../../../styles/pages/admin-comment-reports.css';

const title = 'Segnalazioni commenti | Retro-Gamers.it';
const description = 'Pannello segnalazioni commenti pubblici Retro-Gamers.it';
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = session.profile?.role === 'admin' || session.profile?.role === 'moderator';
const isAdmin = session.profile?.role === 'admin';
---

<BaseLayout title={title} description={description}>
  <CommunityLayout class="admin-comment-reports-page" sidebar={isStaff}>
    <Fragment slot="sidebar">
      {isStaff && (
        <CommunitySidebarSection title="Strumenti redazione">
          <div class="community-staff-links">
            <a class="community-action-link" href="/admin/">Area redazione</a>
            <a class="community-action-link" href="/admin/comments/">Moderazione commenti</a>
            <a class="community-action-link" href="/admin/comment-reports/">Segnalazioni commenti</a>
            <a class="community-action-link" href="/admin/users/">Gestione utenti</a>
            <a class="community-action-link" href="/admin/private-message-reports/">Segnalazioni messaggi</a>
            <a class="community-action-link" href="/admin/ratings/">Voti lettori</a>
          </div>
        </CommunitySidebarSection>
      )}
    </Fragment>

    <CommunityHero
      kicker="Community"
      title="Segnalazioni commenti"
      description="Verifica i commenti pubblici segnalati dai lettori e tieni ordinata la discussione."
    >
      <span slot="aside" class="community-soft-badge" data-comment-reports-count>Caricamento...</span>
    </CommunityHero>

    <section
      class="community-card admin-comment-reports-panel"
      data-comment-reports-panel
      data-can-hard-delete={isAdmin ? 'true' : 'false'}
    >
      <form class="admin-comment-reports-filters" data-comment-reports-filters>
        <label>
          <span>Stato</span>
          <select name="status">
            <option value="open" selected>Aperte</option>
            <option value="resolved">Gestite</option>
            <option value="archived">Ignorate</option>
            <option value="all">Tutte</option>
          </select>
        </label>

        <button type="submit">Filtra</button>
      </form>

      <div class="admin-comment-reports-message" data-comment-reports-message hidden></div>
      <div class="admin-comment-reports-list" data-comment-reports-list>
        <p class="admin-comment-reports-empty">Caricamento segnalazioni...</p>
      </div>
    </section>
  </CommunityLayout>

  <script>
    const listNode = document.querySelector('[data-comment-reports-list]');
    const countNode = document.querySelector('[data-comment-reports-count]');
    const messageNode = document.querySelector('[data-comment-reports-message]');
    const filtersForm = document.querySelector('[data-comment-reports-filters]');
    const panelNode = document.querySelector('[data-comment-reports-panel]');
    const canHardDelete = panelNode?.dataset.canHardDelete === 'true';

    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const formatDate = (value) => {
      if (!value) return 'Non disponibile';

      return new Intl.DateTimeFormat('it-IT', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }).format(new Date(value));
    };

    const statusLabels = {
      open: 'Aperta',
      resolved: 'Gestita',
      archived: 'Ignorata'
    };

    const emptyMessages = {
      open: 'Nessuna segnalazione aperta.',
      resolved: 'Nessuna segnalazione gestita con questi filtri.',
      archived: 'Nessuna segnalazione ignorata con questi filtri.',
      all: 'Nessuna segnalazione con questi filtri.'
    };

    const getProfileName = (profile) =>
      profile?.display_name || profile?.username || 'Utente';

    const getProfileUrl = (profile) => {
      const username = String(profile?.username || '').trim().toLowerCase();

      if (!/^[a-z0-9_-]{3,24}$/.test(username)) {
        return '';
      }

      return `/utenti/${encodeURIComponent(username)}/`;
    };

    const showMessage = (text, type = 'ok') => {
      if (!messageNode) return;

      messageNode.textContent = text;
      messageNode.dataset.type = type;
      messageNode.hidden = !text;
    };

    const renderProfileLink = (label, profile) => {
      const profileUrl = getProfileUrl(profile);
      const name = getProfileName(profile);
      const username = profile?.username ? `@${profile.username}` : name;

      return profileUrl
        ? `<a href="${escapeHtml(profileUrl)}">${escapeHtml(label)}: ${escapeHtml(username)}</a>`
        : `<span>${escapeHtml(label)}: ${escapeHtml(name)}</span>`;
    };

    const renderReport = (report) => {
      const comment = report.comment || {};
      const articleTitle = comment.article_title || comment.article_slug || 'Articolo non disponibile';
      const status = report.status || 'open';
      const reason = report.reason || 'Nessun motivo specificato.';
      const commentBody = comment.body || 'Commento non disponibile.';
      const commentUrl = report.commentUrl || '';
      const articleUrl = report.articleUrl || comment.article_url || '';
      const adminCommentUrl = report.adminCommentUrl || '/admin/comments/';
      const isHidden = Boolean(comment.deleted_at);
      const commentStatus = isHidden
        ? 'Nascosto'
        : comment.status === 'approved'
          ? 'Approvato'
          : comment.status === 'pending'
            ? 'Da revisionare'
            : comment.status === 'rejected'
              ? 'Rifiutato'
              : comment.status || 'Stato non disponibile';
      const moderationActions = `
        ${!isHidden ? '<button type="button" data-report-moderate="soft_delete" data-confirm="Nascondere questo commento dal sito pubblico?">Nascondi commento</button>' : '<span class="admin-comment-report-card__muted">Commento già nascosto</span>'}
        ${canHardDelete ? '<button type="button" class="admin-comment-report-card__danger-action" data-report-moderate="hard_delete" data-confirm="Questa azione cancellerà definitivamente il commento. Continuare?">Cancella definitivamente</button>' : ''}
      `;

      return `
        <article
          class="admin-comment-report-card"
          data-report-id="${escapeHtml(report.id)}"
          data-comment-id="${escapeHtml(report.commentId || '')}"
          data-current-status="${escapeHtml(status)}"
        >
          <header>
            <div>
              <span data-status="${escapeHtml(status)}">${escapeHtml(statusLabels[status] || status)}</span>
              <h2>${escapeHtml(articleTitle)}</h2>
            </div>

            <time datetime="${escapeHtml(report.createdAt)}">${escapeHtml(formatDate(report.createdAt))}</time>
          </header>

          <div class="admin-comment-report-card__meta">
            ${renderProfileLink('Autore commento', report.reportedUser)}
            ${renderProfileLink('Segnalato da', report.reporter)}
            <span>Stato commento: ${escapeHtml(commentStatus)}</span>
          </div>

          <section class="admin-comment-report-card__comment">
            <h3>Commento segnalato</h3>
            <blockquote>${escapeHtml(commentBody)}</blockquote>
          </section>

          <section class="admin-comment-report-card__reason">
            <h3>Motivo segnalazione</h3>
            <p>${escapeHtml(reason)}</p>
          </section>

          <label class="admin-comment-report-card__note">
            <span>Nota staff</span>
            <textarea rows="3" maxlength="2000" data-report-note>${escapeHtml(report.adminNote || '')}</textarea>
          </label>

          <footer>
            <div class="admin-comment-report-card__link-actions">
              ${articleUrl ? `<a href="${escapeHtml(articleUrl)}" target="_blank" rel="noreferrer">Apri articolo</a>` : ''}
              ${commentUrl ? `<a href="${escapeHtml(commentUrl)}" target="_blank" rel="noreferrer">Vai al commento</a>` : ''}
              <a href="${escapeHtml(adminCommentUrl)}">Gestisci in moderazione</a>
            </div>

            <div class="admin-comment-report-card__status-actions">
              ${status !== 'resolved' ? '<button type="button" data-report-status="resolved">Segna come gestita</button>' : ''}
              ${status !== 'archived' ? '<button type="button" data-report-status="archived">Ignora</button>' : ''}
              ${status !== 'open' ? '<button type="button" data-report-status="open">Riapri</button>' : ''}
              <button type="button" data-report-save-note>Salva nota</button>
            </div>

            <div class="admin-comment-report-card__moderation-actions">
              ${moderationActions}
            </div>
          </footer>
        </article>
      `;
    };

    const loadReports = async () => {
      if (!listNode) return;

      const params = new URLSearchParams(new FormData(filtersForm));

      try {
        const response = await fetch(`/api/admin/comment-reports/list?${params.toString()}`);
        const result = await response.json();

        if (!response.ok || !result.ok) {
          listNode.innerHTML = `<p class="admin-comment-reports-empty">${escapeHtml(result.error || 'Segnalazioni non disponibili.')}</p>`;
          if (countNode) countNode.textContent = 'Accesso non disponibile';
          return;
        }

        const reports = result.reports || [];
        if (countNode) {
          countNode.textContent = reports.length === 1
            ? '1 segnalazione'
            : `${reports.length} segnalazioni`;
        }

        if (reports.length === 0) {
          const status = String(params.get('status') || 'open');
          listNode.innerHTML = `<p class="admin-comment-reports-empty">${escapeHtml(emptyMessages[status] || emptyMessages.all)}</p>`;
          return;
        }

        listNode.innerHTML = reports.map(renderReport).join('');
      } catch {
        listNode.innerHTML = '<p class="admin-comment-reports-empty">Errore di connessione.</p>';
      }
    };

    const updateReport = async (card, status) => {
      const reportId = card?.dataset.reportId;
      const adminNote = card?.querySelector('[data-report-note]')?.value || '';

      if (!reportId || !status) return;

      const buttons = Array.from(card.querySelectorAll('button'));
      buttons.forEach((button) => {
        button.disabled = true;
      });

      try {
        const response = await fetch('/api/admin/comment-reports/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            reportId,
            status,
            adminNote,
          }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(result.error || 'Segnalazione non aggiornata.', 'error');
          buttons.forEach((button) => {
            button.disabled = false;
          });
          return;
        }

        showMessage('Segnalazione aggiornata.', 'ok');
        await loadReports();
        return true;
      } catch {
        showMessage('Errore di connessione.', 'error');
        buttons.forEach((button) => {
          button.disabled = false;
        });
      }

      return false;
    };

    const moderateComment = async (card, action) => {
      const commentId = card?.dataset.commentId;

      if (!commentId || !action) return;

      const buttons = Array.from(card.querySelectorAll('button'));
      buttons.forEach((button) => {
        button.disabled = true;
      });

      try {
        const response = await fetch('/api/admin/comments/moderate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            commentId,
            action,
            note: `Moderazione da segnalazione commento: ${action}`,
          }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(result.error || 'Commento non aggiornato.', 'error');
          buttons.forEach((button) => {
            button.disabled = false;
          });
          return;
        }

        if (action === 'soft_delete') {
          await updateReport(card, 'resolved');
          showMessage('Commento nascosto e segnalazione segnata come gestita.', 'ok');
          return;
        }

        showMessage('Commento aggiornato.', 'ok');
        await loadReports();
      } catch {
        showMessage('Errore di connessione.', 'error');
        buttons.forEach((button) => {
          button.disabled = false;
        });
      }
    };

    filtersForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      showMessage('');
      loadReports();
    });

    listNode?.addEventListener('click', (event) => {
      const target = event.target;
      const statusButton = target instanceof Element
        ? target.closest('button[data-report-status]')
        : null;
      const noteButton = target instanceof Element
        ? target.closest('[data-report-save-note]')
        : null;
      const moderationButton = target instanceof Element
        ? target.closest('button[data-report-moderate]')
        : null;

      if (!statusButton && !noteButton && !moderationButton) return;

      const card = (statusButton || noteButton || moderationButton).closest('[data-report-id]');
      const moderationAction = moderationButton?.dataset.reportModerate;

      if (moderationAction) {
        const confirmation = moderationButton.dataset.confirm;
        if (confirmation && !window.confirm(confirmation)) {
          return;
        }

        moderateComment(card, moderationAction);
        return;
      }

      const status = statusButton?.dataset.reportStatus || card?.dataset.currentStatus;

      updateReport(card, status);
    });

    loadReports();
  </script>
</BaseLayout>
