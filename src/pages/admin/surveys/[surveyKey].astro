---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminDashboardBackLink from '../../../components/admin/AdminDashboardBackLink.astro';
import AdminToolsSidebar from '../../../components/admin/AdminToolsSidebar.astro';
import LocalDateTime from '../../../components/common/LocalDateTime.astro';
import CommunityHero from '../../../components/community/CommunityHero.astro';
import CommunityLayout from '../../../components/community/CommunityLayout.astro';
import {
  buildCommunitySurveyEditorialSummary,
  getCommunitySurveyAdminResults,
  type CommunitySurveyLanguage,
  normalizeTechnicalId,
  type CommunitySurveyQuestionResult,
  type CommunitySurveyStatus,
} from '../../../lib/community-surveys';
import { getCommunitySurveyOpenAnswerSummaryState } from '../../../lib/community-survey-open-answer-summaries.server';
import { getUserSessionFromCookies } from '../../../lib/supabase/auth';
import '../../../styles/pages/admin-surveys.css';

const { surveyKey: rawSurveyKey } = Astro.params;
const surveyKey = normalizeTechnicalId(rawSurveyKey);
const title = 'Risultati sondaggio | Retro-Gamers.it';
const description = 'Risultati raccolti dai sondaggi community Retro-Gamers.it.';
const session = await getUserSessionFromCookies(Astro.cookies);
const isAdmin = session.profile?.role === 'admin';
const numberFormatter = new Intl.NumberFormat('it-IT');
const percentageFormatter = new Intl.NumberFormat('it-IT', {
  maximumFractionDigits: 1,
});
const statusLabels: Record<CommunitySurveyLanguage, Record<CommunitySurveyStatus, string>> = {
  it: {
    draft: 'Bozza',
    open: 'Aperto',
    closed: 'Chiuso',
  },
  en: {
    draft: 'Draft',
    open: 'Open',
    closed: 'Closed',
  },
};
const typeLabels: Record<CommunitySurveyLanguage, Record<CommunitySurveyQuestionResult['type'], string>> = {
  it: {
    single: 'Scelta singola',
    multiple: 'Scelta multipla',
    text: 'Risposta testuale',
  },
  en: {
    single: 'Single choice',
    multiple: 'Multiple choice',
    text: 'Open response',
  },
};
const uiCopy = {
  it: {
    adminKicker: 'Sondaggi community',
    resultsTitle: 'Risultati sondaggio',
    totalParticipants: 'Partecipanti totali',
    italianParticipants: 'Partecipanti IT',
    englishParticipants: 'Partecipanti EN',
    latestResponse: 'Ultima risposta',
    summary: 'Sintesi',
    questions: 'Domande',
    openResponses: 'Risposte aperte',
    allQuestions: 'Tutte le domande',
    allQuestionsDescription: 'Dettaglio completo del sondaggio nell’ordine definito in Sanity.',
    responseArchive: 'Archivio risposte aperte',
    responseArchiveDescription: 'Risposte testuali raccolte, filtrabili per lingua e contenuto.',
    questionLabel: 'Domanda',
    answeredBy: 'Partecipanti',
    textResponses: 'risposte testuali',
    textResponse: 'risposta testuale',
    goToOpenResponses: 'Vai alle risposte aperte',
    noTextAnswers: 'Nessuna risposta testuale raccolta.',
    noQuestions: 'Nessuna domanda trovata nel sondaggio.',
    noOpenResponses: 'Nessuna risposta aperta raccolta.',
    all: 'Tutte',
    it: 'IT',
    en: 'EN',
    newest: 'Più recenti',
    oldest: 'Meno recenti',
    searchResponses: 'Cerca nelle risposte...',
    noFilteredResponses: 'Nessuna risposta corrisponde ai filtri.',
    sortLabel: 'Ordina',
    statusLabel: 'Stato',
    questionFilterLabel: 'Filtra per domanda',
    responseSingular: 'risposta',
    responsePlural: 'risposte',
    resultsKicker: 'Risultati',
    exportCsv: 'Esporta CSV',
    editorialSummaryTitle: 'Sintesi editoriale',
    editorialSummaryDescription: 'Lettura automatica dei risultati quantitativi. Nessun dato viene inviato a servizi esterni.',
    editorialSummarySample: 'Sintesi basata su {total} partecipazioni: {it} IT e {en} EN.',
    editorialSummarySmallSample: 'Campione ancora ridotto. La sintesi editoriale sarà disponibile da {min} partecipanti.',
    editorialSummaryCurrentParticipants: 'Partecipanti attuali: {total}',
    editorialSummaryNoData: 'Non ci sono ancora risultati quantitativi sufficienti per comporre la sintesi.',
    editorialSummaryMultipleNote: 'Le percentuali indicano il peso di ciascuna preferenza sul totale delle selezioni espresse.',
    otherPreferences: 'Altre preferenze',
    tie: 'Pari merito',
    participantsSingular: 'partecipante',
    participantsPlural: 'partecipanti',
    selectionsSingular: 'selezione',
    selectionsPlural: 'selezioni',
    openAnswerAiTitle: 'Resoconto risposte aperte',
    openAnswerAiDescription: 'Interpretazione qualitativa delle risposte testuali del sondaggio.',
    openAnswerAiNote: 'Generato con AI su richiesta dell’amministratore.',
    openAnswerAiNotConfigured: 'Resoconto AI non configurato.',
    openAnswerAiStorageUnavailable: 'Resoconto AI non disponibile. Verifica che community-survey-summaries-v1.sql sia stato eseguito in Supabase.',
    openAnswerAiInsufficient: 'Campione qualitativo ancora ridotto. Il resoconto sarà disponibile da {min} risposte aperte significative.',
    openAnswerAiCurrentCount: 'Risposte significative attuali: {count}',
    openAnswerAiGenerate: 'Genera resoconto',
    openAnswerAiRegenerate: 'Rigenera resoconto',
    openAnswerAiGenerating: 'Generazione in corso…',
    openAnswerAiStale: 'Da aggiornare',
    openAnswerAiGeneratedPrefix: 'Generato il',
    openAnswerAiGeneratedSuffix: '{count} risposte testuali analizzate',
    openAnswerAiError: 'Non è stato possibile generare il resoconto.',
    openAnswerAiNoSummary: 'Nessun resoconto generato.',
    openAnswerAiOverview: 'Quadro generale',
    openAnswerAiRecurringThemes: 'Temi ricorrenti',
    openAnswerAiAppreciatedAspects: 'Cosa viene apprezzato',
    openAnswerAiRequests: 'Richieste e suggerimenti',
    openAnswerAiCriticisms: 'Criticità',
    openAnswerAiOpportunities: 'Opportunità editoriali',
    openAnswerAiSignals: 'Segnali interessanti',
    openAnswerAiCaveats: 'Limiti della lettura',
  },
  en: {
    adminKicker: 'Community surveys',
    resultsTitle: 'Survey results',
    totalParticipants: 'Total participants',
    italianParticipants: 'IT participants',
    englishParticipants: 'EN participants',
    latestResponse: 'Latest response',
    summary: 'Summary',
    questions: 'Questions',
    openResponses: 'Open responses',
    allQuestions: 'All questions',
    allQuestionsDescription: 'Full survey detail in the order defined in Sanity.',
    responseArchive: 'Open response archive',
    responseArchiveDescription: 'Collected text answers, filterable by language and content.',
    questionLabel: 'Question',
    answeredBy: 'Participants',
    textResponses: 'text responses',
    textResponse: 'text response',
    goToOpenResponses: 'Go to open responses',
    noTextAnswers: 'No text responses collected.',
    noQuestions: 'No survey questions found.',
    noOpenResponses: 'No open responses collected.',
    all: 'All',
    it: 'IT',
    en: 'EN',
    newest: 'Newest',
    oldest: 'Oldest',
    searchResponses: 'Search responses...',
    noFilteredResponses: 'No responses match the current filters.',
    sortLabel: 'Sort',
    statusLabel: 'Status',
    questionFilterLabel: 'Filter by question',
    responseSingular: 'response',
    responsePlural: 'responses',
    resultsKicker: 'Results',
    exportCsv: 'Export CSV',
    editorialSummaryTitle: 'Editorial summary',
    editorialSummaryDescription: 'Automatic overview of quantitative results. No data is sent to external services.',
    editorialSummarySample: 'Summary based on {total} participations: {it} IT and {en} EN.',
    editorialSummarySmallSample: 'Sample still too small. The editorial summary will be available from {min} participants.',
    editorialSummaryCurrentParticipants: 'Current participants: {total}',
    editorialSummaryNoData: 'There are not enough quantitative results yet to compose the summary.',
    editorialSummaryMultipleNote: "Percentages show each preference's share of all selections made.",
    otherPreferences: 'Other preferences',
    tie: 'Tie',
    participantsSingular: 'participant',
    participantsPlural: 'participants',
    selectionsSingular: 'selection',
    selectionsPlural: 'selections',
    openAnswerAiTitle: 'Open-answer report',
    openAnswerAiDescription: 'Qualitative interpretation of the survey’s text responses.',
    openAnswerAiNote: 'Generated with AI on administrator request.',
    openAnswerAiNotConfigured: 'AI report is not configured.',
    openAnswerAiStorageUnavailable: 'AI report unavailable. Check that community-survey-summaries-v1.sql has been run in Supabase.',
    openAnswerAiInsufficient: 'Qualitative sample still too small. The report will be available from {min} significant open answers.',
    openAnswerAiCurrentCount: 'Current significant answers: {count}',
    openAnswerAiGenerate: 'Generate report',
    openAnswerAiRegenerate: 'Regenerate report',
    openAnswerAiGenerating: 'Generating…',
    openAnswerAiStale: 'Needs update',
    openAnswerAiGeneratedPrefix: 'Generated on',
    openAnswerAiGeneratedSuffix: '{count} text responses analyzed',
    openAnswerAiError: 'The report could not be generated.',
    openAnswerAiNoSummary: 'No report generated yet.',
    openAnswerAiOverview: 'Overview',
    openAnswerAiRecurringThemes: 'Recurring themes',
    openAnswerAiAppreciatedAspects: 'What is appreciated',
    openAnswerAiRequests: 'Requests and suggestions',
    openAnswerAiCriticisms: 'Friction points',
    openAnswerAiOpportunities: 'Editorial opportunities',
    openAnswerAiSignals: 'Notable signals',
    openAnswerAiCaveats: 'Reading limits',
  },
};

let resultsError = '';
let results:
  | Awaited<ReturnType<typeof getCommunitySurveyAdminResults>> extends { ok: true; results: infer T }
    ? T
    : never
  | null = null;

if (isAdmin && surveyKey) {
  const result = await getCommunitySurveyAdminResults(surveyKey);

  if (result.ok) {
    results = result.results;
  } else if (result.error === 'survey_not_found') {
    resultsError = 'Sondaggio non trovato in Sanity per questo survey key.';
  } else if (result.error === 'invalid_survey_key') {
    resultsError = 'Survey key non valido.';
  } else {
    resultsError =
      result.details ||
      'Risultati non disponibili. Verifica che community-surveys-v1.sql sia stato eseguito in Supabase.';
  }
} else if (isAdmin) {
  resultsError = 'Survey key non valido.';
}

const formatCount = (count: number) => numberFormatter.format(count);
const formatPercentage = (percentage: number) =>
  `${percentageFormatter.format(percentage)}%`;
const getStatusLabel = (
  status: CommunitySurveyStatus | string | undefined,
  language: CommunitySurveyLanguage
) =>
  status && status in statusLabels[language]
    ? statusLabels[language][status as CommunitySurveyStatus]
    : '—';
const getTypeLabel = (
  type: CommunitySurveyQuestionResult['type'],
  language: CommunitySurveyLanguage
) => typeLabels[language][type] || type;
const getQuestionAnswerSummary = (
  question: CommunitySurveyQuestionResult,
  language: CommunitySurveyLanguage
) => {
  if (question.type !== 'multiple') {
    const answerLabel = language === 'en'
      ? question.answerCount === 1
        ? 'answer'
        : 'answers'
      : question.answerCount === 1
        ? 'risposta'
        : 'risposte';

    return `${formatCount(question.answerCount)} ${
      answerLabel
    }`;
  }

  const participantLabel = language === 'en'
    ? question.responseCount === 1
      ? 'participant'
      : 'participants'
    : question.responseCount === 1
      ? 'partecipante'
      : 'partecipanti';
  const selectionLabel = language === 'en'
    ? question.answerCount === 1
      ? 'selection'
      : 'selections'
    : question.answerCount === 1
      ? 'selezione'
      : 'selezioni';

  return [
    `${formatCount(question.responseCount)} ${participantLabel}`,
    `${formatCount(question.answerCount)} ${selectionLabel}`,
  ].join(' · ');
};
const getMultipleQuestionNote = (language: CommunitySurveyLanguage) =>
  language === 'en'
    ? 'For multiple-choice questions, percentages show the share of participants who selected each option. The total may exceed 100%.'
    : 'Le percentuali delle domande a risposta multipla indicano la percentuale di partecipanti che ha selezionato ciascuna opzione. Il totale può superare il 100%.';
const dateLocale = results?.survey.language === 'en' ? 'en-GB' : 'it-IT';
const uiLanguage: CommunitySurveyLanguage = results?.survey.language === 'en' ? 'en' : 'it';
const t = uiCopy[uiLanguage];
const editorialSummary = results ? buildCommunitySurveyEditorialSummary(results) : null;
const openAnswerSummaryState = results
  ? await getCommunitySurveyOpenAnswerSummaryState(results)
  : null;
const textQuestions = results?.questions.filter((question) => question.type === 'text') || [];
const sortTextAnswersNewestFirst = <T extends { timestamp: string }>(answers: T[]) =>
  [...answers].sort((a, b) => {
    const bTime = Date.parse(b.timestamp || '');
    const aTime = Date.parse(a.timestamp || '');

    return (Number.isFinite(bTime) ? bTime : 0) - (Number.isFinite(aTime) ? aTime : 0);
  });
const openResponseGroups = results
  ? textQuestions
      .map((question) => {
        const questionIndex = results.questions.findIndex((item) => item.questionId === question.questionId) + 1;
        const responses = sortTextAnswersNewestFirst(
          question.textAnswers.map((answer) => ({
            ...answer,
            questionId: question.questionId,
            questionIndex,
            questionText: question.text,
            timestamp: answer.submittedAt || answer.createdAt || '',
          }))
        );

        return {
          questionId: question.questionId,
          questionIndex,
          questionText: question.text,
          responses,
        };
      })
      .filter((group) => group.responses.length > 0)
  : [];
const openResponses = openResponseGroups.flatMap((group) => group.responses);
const exportCsvHref = surveyKey
  ? `/api/admin/surveys/${encodeURIComponent(surveyKey)}/export.csv`
  : '';
const surveySeenStorageKey = surveyKey
  ? `retro-gamers:admin-survey-seen:${surveyKey}`
  : '';
const getTextAnswerSummary = (count: number, language: CommunitySurveyLanguage) => {
  if (language === 'en') {
    return `${formatCount(count)} ${count === 1 ? uiCopy.en.textResponse : uiCopy.en.textResponses}`;
  }

  return `${formatCount(count)} ${count === 1 ? uiCopy.it.textResponse : uiCopy.it.textResponses}`;
};
const formatEditorialSummarySample = () =>
  t.editorialSummarySample
    .replace('{total}', formatCount(editorialSummary?.totalResponses || 0))
    .replace('{it}', formatCount(editorialSummary?.languageCounts.it || 0))
    .replace('{en}', formatCount(editorialSummary?.languageCounts.en || 0));
const formatEditorialSummarySmallSample = () =>
  t.editorialSummarySmallSample.replace('{min}', formatCount(editorialSummary?.minResponses || 10));
const formatEditorialSummaryCurrentParticipants = () =>
  t.editorialSummaryCurrentParticipants.replace('{total}', formatCount(editorialSummary?.totalResponses || 0));
const getParticipantLabel = (count: number) =>
  count === 1 ? t.participantsSingular : t.participantsPlural;
const getSelectionLabel = (count: number) =>
  count === 1 ? t.selectionsSingular : t.selectionsPlural;
const formatEditorialSingleOptionMeta = (count: number, percentage: number) =>
  `${formatCount(count)} ${getParticipantLabel(count)} · ${formatPercentage(percentage)}`;
const formatEditorialMultipleOptionMeta = (count: number, percentage: number) =>
  `${formatCount(count)} ${getSelectionLabel(count)} · ${formatPercentage(percentage)}`;
const hasEditorialMultipleSummary = editorialSummary?.items.some((item) => item.type === 'multiple') || false;
const openAnswerSummaryEndpoint = surveyKey
  ? `/api/admin/surveys/${encodeURIComponent(surveyKey)}/summary`
  : '';
const openAnswerAiSummary = openAnswerSummaryState?.summary?.summary || null;
const formatOpenAnswerAiInsufficient = () =>
  t.openAnswerAiInsufficient.replace(
    '{min}',
    formatCount(openAnswerSummaryState?.minSignificantTextAnswerCount || 10)
  );
const formatOpenAnswerAiCurrentCount = () =>
  t.openAnswerAiCurrentCount.replace(
    '{count}',
    formatCount(openAnswerSummaryState?.significantTextAnswerCount || 0)
  );
const formatOpenAnswerAiGeneratedSuffix = () =>
  t.openAnswerAiGeneratedSuffix.replace(
    '{count}',
    formatCount(openAnswerSummaryState?.summary?.sourceTextAnswerCount || 0)
  );
const canGenerateOpenAnswerAiSummary = Boolean(
  openAnswerSummaryState?.isConfigured &&
  openAnswerSummaryState?.isThresholdMet &&
  !openAnswerSummaryState?.storageError &&
  (!openAnswerSummaryState.summary || openAnswerSummaryState.isStale) &&
  openAnswerSummaryEndpoint
);
---

<BaseLayout title={title} description={description}>
  <CommunityLayout class="admin-surveys-page" sidebar={isAdmin}>
    <AdminToolsSidebar slot="sidebar" lang="it" surveyKey={surveyKey} />
    {isAdmin && <AdminDashboardBackLink slot="before" lang="it" />}

    {isAdmin ? (
      <>
        {results ? (
          <>
            <section
              class="community-card admin-surveys-header"
              aria-labelledby="admin-surveys-title"
              data-admin-survey-seen-marker
              data-seen-storage-key={surveySeenStorageKey}
              data-last-response-at={results.latestResponseAt || ''}
            >
              <div class="admin-surveys-header__copy">
                <p>{t.adminKicker}</p>
                <h1 id="admin-surveys-title">{results.survey.title || t.resultsTitle}</h1>
                {results.survey.description && <p>{results.survey.description}</p>}
                {exportCsvHref && (
                  <div class="admin-surveys-header__actions">
                    <a class="admin-surveys-inline-action" href={exportCsvHref}>
                      {t.exportCsv}
                    </a>
                  </div>
                )}
              </div>

              <div class="admin-surveys-kpis" aria-label="Riepilogo sondaggio">
                <article class="admin-surveys-kpi">
                  <span>{t.statusLabel}</span>
                  <strong>{getStatusLabel(results.survey.status, uiLanguage)}</strong>
                </article>
                <article class="admin-surveys-kpi">
                  <span>{t.totalParticipants}</span>
                  <strong>{formatCount(results.totalResponses)}</strong>
                </article>
                <article class="admin-surveys-kpi">
                  <span>{t.italianParticipants}</span>
                  <strong>{formatCount(results.languageCounts.it)}</strong>
                </article>
                <article class="admin-surveys-kpi">
                  <span>{t.englishParticipants}</span>
                  <strong>{formatCount(results.languageCounts.en)}</strong>
                </article>
                <article class="admin-surveys-kpi admin-surveys-kpi--wide admin-surveys-kpi--latest">
                  <span>{t.latestResponse}</span>
                  <strong>
                    <LocalDateTime value={results.latestResponseAt} locale={dateLocale} />
                  </strong>
                </article>
              </div>
            </section>

            <section
              class="community-card admin-surveys-panel"
              aria-labelledby="admin-surveys-results"
              data-admin-surveys-tabs
              data-response-singular={t.responseSingular}
              data-response-plural={t.responsePlural}
              data-no-filtered-responses={t.noFilteredResponses}
            >
              <div class="admin-surveys-section-heading">
                <div>
                  <p>{t.resultsKicker}</p>
                  <h2 id="admin-surveys-results">{t.resultsTitle}</h2>
                </div>
                <span>
                  IT {formatCount(results.languageCounts.it)} · EN {formatCount(results.languageCounts.en)}
                </span>
              </div>

              <div class="admin-surveys-tabs" role="tablist" aria-label={t.resultsTitle}>
                <button
                  id="admin-surveys-tab-summary"
                  class="admin-surveys-tab"
                  type="button"
                  role="tab"
                  aria-selected="true"
                  aria-controls="admin-surveys-panel-summary"
                  data-admin-surveys-tab="summary"
                >
                  {t.summary}
                </button>
                <button
                  id="admin-surveys-tab-questions"
                  class="admin-surveys-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="admin-surveys-panel-questions"
                  tabindex="-1"
                  data-admin-surveys-tab="questions"
                >
                  {t.questions}
                </button>
                <button
                  id="admin-surveys-tab-open-responses"
                  class="admin-surveys-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="admin-surveys-panel-open-responses"
                  tabindex="-1"
                  data-admin-surveys-tab="open-responses"
                >
                  {t.openResponses}
                </button>
              </div>

              <div
                id="admin-surveys-panel-summary"
                class="admin-surveys-view"
                role="tabpanel"
                tabindex="0"
                aria-labelledby="admin-surveys-tab-summary"
                data-admin-surveys-panel="summary"
              >
                {editorialSummary && (
                  <section class="admin-surveys-editorial-summary" aria-labelledby="admin-surveys-editorial-summary-title">
                    <header class="admin-surveys-editorial-summary__header">
                      <div>
                        <p>{t.summary}</p>
                        <h4 id="admin-surveys-editorial-summary-title">{t.editorialSummaryTitle}</h4>
                      </div>
                      <span>{t.editorialSummaryDescription}</span>
                    </header>

                    {editorialSummary.isAvailable ? (
                      <>
                        <p class="admin-surveys-editorial-summary__sample">
                          {formatEditorialSummarySample()}
                        </p>
                        {hasEditorialMultipleSummary && (
                          <p class="admin-surveys-editorial-summary__multiple-note">
                            {t.editorialSummaryMultipleNote}
                          </p>
                        )}

                        {editorialSummary.items.length > 0 ? (
                          <div class="admin-surveys-editorial-summary__list">
                            {editorialSummary.items.map((item) => (
                              <article class="admin-surveys-editorial-summary__item">
                                <div>
                                  <span>{getTypeLabel(item.type, uiLanguage)}</span>
                                  <h5>{item.text}</h5>
                                </div>

                                <div class="admin-surveys-editorial-summary__results">
                                  {item.type === 'single' && item.isTie && <strong>{t.tie}</strong>}
                                  <ul>
                                    {item.topOptions.map((option, index) => (
                                      <li style={`--admin-survey-summary-width: ${option.percentage}%`}>
                                        <div class="admin-surveys-editorial-summary__option">
                                          <span>{item.type === 'multiple' ? `${index + 1}. ${option.label}` : option.label}</span>
                                          <strong>{formatPercentage(option.percentage)}</strong>
                                        </div>
                                        <small>
                                          {item.type === 'multiple'
                                            ? formatEditorialMultipleOptionMeta(option.count, option.percentage)
                                            : formatEditorialSingleOptionMeta(option.count, option.percentage)}
                                        </small>
                                        <div class="admin-surveys-editorial-summary__bar" aria-hidden="true">
                                          <span></span>
                                        </div>
                                      </li>
                                    ))}
                                    {item.type === 'multiple' && item.otherOption && (
                                      <li style={`--admin-survey-summary-width: ${item.otherOption.percentage}%`}>
                                        <div class="admin-surveys-editorial-summary__option">
                                          <span>{t.otherPreferences}</span>
                                          <strong>{formatPercentage(item.otherOption.percentage)}</strong>
                                        </div>
                                        <small>
                                          {formatEditorialMultipleOptionMeta(item.otherOption.count, item.otherOption.percentage)}
                                        </small>
                                        <div class="admin-surveys-editorial-summary__bar" aria-hidden="true">
                                          <span></span>
                                        </div>
                                      </li>
                                    )}
                                  </ul>
                                </div>
                              </article>
                            ))}
                          </div>
                        ) : (
                          <p class="admin-surveys-empty admin-surveys-empty--compact">
                            {t.editorialSummaryNoData}
                          </p>
                        )}
                      </>
                    ) : (
                      <div class="admin-surveys-editorial-summary__small-sample">
                        <strong>{formatEditorialSummarySmallSample()}</strong>
                        <span>{formatEditorialSummaryCurrentParticipants()}</span>
                      </div>
                    )}
                  </section>
                )}

                {openAnswerSummaryState && (
                  <section class="admin-surveys-open-ai-summary" aria-labelledby="admin-surveys-open-ai-summary-title">
                    <header class="admin-surveys-open-ai-summary__header">
                      <div>
                        <p>{t.openResponses}</p>
                        <h4 id="admin-surveys-open-ai-summary-title">{t.openAnswerAiTitle}</h4>
                      </div>
                      <span>{t.openAnswerAiDescription}</span>
                    </header>

                    <p class="admin-surveys-open-ai-summary__note">
                      {t.openAnswerAiNote}
                    </p>

                    {!openAnswerSummaryState.isConfigured ? (
                      <div class="admin-surveys-open-ai-summary__status">
                        <strong>{t.openAnswerAiNotConfigured}</strong>
                      </div>
                    ) : openAnswerSummaryState.storageError ? (
                      <div class="admin-surveys-open-ai-summary__status">
                        <strong>{t.openAnswerAiStorageUnavailable}</strong>
                      </div>
                    ) : !openAnswerSummaryState.isThresholdMet ? (
                      <div class="admin-surveys-open-ai-summary__status">
                        <strong>{formatOpenAnswerAiInsufficient()}</strong>
                        <span>{formatOpenAnswerAiCurrentCount()}</span>
                      </div>
                    ) : (
                      <>
                        {openAnswerAiSummary ? (
                          <div class="admin-surveys-open-ai-summary__content">
                            <div class="admin-surveys-open-ai-summary__meta">
                              <span>
                                {t.openAnswerAiGeneratedPrefix}{' '}
                                <LocalDateTime
                                  value={openAnswerSummaryState.summary?.generatedAt}
                                  locale={dateLocale}
                                />
                                {' · '}
                                {formatOpenAnswerAiGeneratedSuffix()}
                              </span>
                              {openAnswerSummaryState.isStale && (
                                <strong>{t.openAnswerAiStale}</strong>
                              )}
                            </div>

                            <section class="admin-surveys-open-ai-summary__section">
                              <h5>{t.openAnswerAiOverview}</h5>
                              <p>{openAnswerAiSummary.overview}</p>
                            </section>

                            {openAnswerAiSummary.recurringThemes.length > 0 && (
                              <section class="admin-surveys-open-ai-summary__section">
                                <h5>{t.openAnswerAiRecurringThemes}</h5>
                                <div class="admin-surveys-open-ai-summary__theme-list">
                                  {openAnswerAiSummary.recurringThemes.map((theme) => (
                                    <article>
                                      <strong>{theme.title}</strong>
                                      <p>{theme.summary}</p>
                                    </article>
                                  ))}
                                </div>
                              </section>
                            )}

                            {openAnswerAiSummary.appreciatedAspects.length > 0 && (
                              <section class="admin-surveys-open-ai-summary__section">
                                <h5>{t.openAnswerAiAppreciatedAspects}</h5>
                                <ul>
                                  {openAnswerAiSummary.appreciatedAspects.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </section>
                            )}

                            {openAnswerAiSummary.requestsAndSuggestions.length > 0 && (
                              <section class="admin-surveys-open-ai-summary__section">
                                <h5>{t.openAnswerAiRequests}</h5>
                                <ul>
                                  {openAnswerAiSummary.requestsAndSuggestions.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </section>
                            )}

                            {openAnswerAiSummary.criticismsOrFriction.length > 0 && (
                              <section class="admin-surveys-open-ai-summary__section">
                                <h5>{t.openAnswerAiCriticisms}</h5>
                                <ul>
                                  {openAnswerAiSummary.criticismsOrFriction.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </section>
                            )}

                            {openAnswerAiSummary.editorialOpportunities.length > 0 && (
                              <section class="admin-surveys-open-ai-summary__section">
                                <h5>{t.openAnswerAiOpportunities}</h5>
                                <ul>
                                  {openAnswerAiSummary.editorialOpportunities.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </section>
                            )}

                            {openAnswerAiSummary.notableSignals.length > 0 && (
                              <section class="admin-surveys-open-ai-summary__section">
                                <h5>{t.openAnswerAiSignals}</h5>
                                <ul>
                                  {openAnswerAiSummary.notableSignals.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </section>
                            )}

                            {openAnswerAiSummary.caveats.length > 0 && (
                              <section class="admin-surveys-open-ai-summary__section">
                                <h5>{t.openAnswerAiCaveats}</h5>
                                <ul>
                                  {openAnswerAiSummary.caveats.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </section>
                            )}
                          </div>
                        ) : (
                          <p class="admin-surveys-empty admin-surveys-empty--compact">
                            {t.openAnswerAiNoSummary}
                          </p>
                        )}

                        {canGenerateOpenAnswerAiSummary && (
                          <form
                            class="admin-surveys-open-ai-summary__actions"
                            data-admin-survey-open-ai-form
                            data-endpoint={openAnswerSummaryEndpoint}
                            data-generating-label={t.openAnswerAiGenerating}
                            data-error-message={t.openAnswerAiError}
                          >
                            <button
                              class="admin-surveys-inline-action"
                              type="submit"
                              data-admin-survey-open-ai-submit
                            >
                              {openAnswerSummaryState.summary
                                ? t.openAnswerAiRegenerate
                                : t.openAnswerAiGenerate}
                            </button>
                            <p
                              class="admin-surveys-open-ai-summary__error"
                              data-admin-survey-open-ai-error
                              hidden
                            ></p>
                          </form>
                        )}
                      </>
                    )}
                  </section>
                )}
              </div>

              <div
                id="admin-surveys-panel-questions"
                class="admin-surveys-view"
                role="tabpanel"
                tabindex="0"
                aria-labelledby="admin-surveys-tab-questions"
                data-admin-surveys-panel="questions"
                hidden
              >
                <div class="admin-surveys-view-heading">
                  <div>
                    <p>{t.questions}</p>
                    <h3>{t.allQuestions}</h3>
                  </div>
                  <span>{t.allQuestionsDescription}</span>
                </div>

                {results.questions.length > 0 ? (
                  <div class="admin-surveys-question-list">
                    {results.questions.map((question, index) => (
                      <article class="admin-surveys-question-card">
                        <header>
                          <div>
                            <span>{t.questionLabel} {index + 1} · {getTypeLabel(question.type, uiLanguage)}</span>
                            <h3>{question.text}</h3>
                          </div>
                          <small>{getQuestionAnswerSummary(question, results.survey.language)}</small>
                        </header>

                        {question.type === 'text' ? (
                          <div class="admin-surveys-text-summary">
                            <strong>{getTextAnswerSummary(question.textAnswers.length, uiLanguage)}</strong>
                            <button
                              class="admin-surveys-inline-action"
                              type="button"
                              data-admin-surveys-open-responses
                            >
                              {t.goToOpenResponses}
                            </button>
                          </div>
                        ) : (
                          <div class="admin-surveys-options">
                            {question.options.map((option) => (
                              <div class="admin-surveys-option">
                                <div class="admin-surveys-option__meta">
                                  <strong>{option.label}</strong>
                                  <span>
                                    {formatCount(option.count)} · {formatPercentage(option.percentage)}
                                  </span>
                                </div>
                                <div class="admin-surveys-option__bar" aria-hidden="true">
                                  <span style={`--admin-survey-result-width: ${option.percentage}%`}></span>
                                </div>
                              </div>
                            ))}
                            {question.type === 'multiple' && (
                              <p class="admin-surveys-note">
                                {getMultipleQuestionNote(results.survey.language)}
                              </p>
                            )}
                          </div>
                        )}
                      </article>
                    ))}
                  </div>
                ) : (
                  <p class="admin-surveys-empty">{t.noQuestions}</p>
                )}
              </div>

              <div
                id="admin-surveys-panel-open-responses"
                class="admin-surveys-view"
                role="tabpanel"
                tabindex="0"
                aria-labelledby="admin-surveys-tab-open-responses"
                data-admin-surveys-panel="open-responses"
                hidden
              >
                <div class="admin-surveys-view-heading">
                  <div>
                    <p>{t.openResponses}</p>
                    <h3>{t.responseArchive}</h3>
                  </div>
                  <span>{t.responseArchiveDescription}</span>
                </div>

                {openResponses.length > 0 ? (
                  <>
                    <div class="admin-surveys-open-controls">
                      <div class="admin-surveys-language-filters" role="group" aria-label={t.openResponses}>
                        <button type="button" aria-pressed="true" data-admin-surveys-language-filter="all">
                          {t.all}
                        </button>
                        <button type="button" aria-pressed="false" data-admin-surveys-language-filter="it">
                          {t.it}
                        </button>
                        <button type="button" aria-pressed="false" data-admin-surveys-language-filter="en">
                          {t.en}
                        </button>
                      </div>

                      <label class="admin-surveys-search">
                        <span class="sr-only">{t.searchResponses}</span>
                        <input
                          type="search"
                          placeholder={t.searchResponses}
                          autocomplete="off"
                          data-admin-surveys-response-search
                        />
                      </label>

                      <label class="admin-surveys-question-filter">
                        <span class="sr-only">{t.questionFilterLabel}</span>
                        <select data-admin-surveys-question-filter>
                          <option value="all">{t.allQuestions}</option>
                          {textQuestions.map((question) => {
                            const questionIndex = results.questions.findIndex((item) => item.questionId === question.questionId) + 1;

                            return (
                              <option value={question.questionId}>
                                {t.questionLabel} {questionIndex}
                              </option>
                            );
                          })}
                        </select>
                      </label>

                      <label class="admin-surveys-sort">
                        <span class="sr-only">{t.sortLabel}</span>
                        <select data-admin-surveys-response-sort>
                          <option value="newest">{t.newest}</option>
                          <option value="oldest">{t.oldest}</option>
                        </select>
                      </label>
                    </div>

                    <p class="admin-surveys-open-count" data-admin-surveys-open-count>
                      {formatCount(openResponses.length)} {openResponses.length === 1 ? t.responseSingular : t.responsePlural}
                    </p>

                    <div class="admin-surveys-open-response-list" data-admin-surveys-open-list>
                      {openResponseGroups.map((group) => (
                        <section
                          class="admin-surveys-open-group"
                          data-admin-surveys-open-group
                          data-question-id={group.questionId}
                        >
                          <header class="admin-surveys-open-group__header">
                            <div>
                              <span>{t.questionLabel} {group.questionIndex}</span>
                              <h4>{group.questionText}</h4>
                            </div>
                            <strong data-admin-surveys-group-count>
                              {getTextAnswerSummary(group.responses.length, uiLanguage)}
                            </strong>
                          </header>

                          <div class="admin-surveys-open-group__responses" data-admin-surveys-open-group-responses>
                            {group.responses.map((answer) => (
                              <article
                                class="admin-surveys-open-response"
                                data-admin-surveys-open-response
                                data-question-id={group.questionId}
                                data-language={answer.language}
                                data-submitted-at={answer.timestamp}
                                data-search={`${answer.text} ${answer.questionText}`.toLocaleLowerCase()}
                              >
                                <header>
                                  <span class:list={['admin-surveys-language-badge', `admin-surveys-language-badge--${answer.language}`]}>
                                    {answer.language.toUpperCase()}
                                  </span>
                                </header>
                                <p>{answer.text}</p>
                                <footer>
                                  <LocalDateTime value={answer.timestamp} locale={dateLocale} />
                                </footer>
                              </article>
                            ))}
                          </div>
                        </section>
                      ))}
                    </div>

                    <p class="admin-surveys-empty admin-surveys-empty--compact" data-admin-surveys-open-empty hidden>
                      {t.noFilteredResponses}
                    </p>
                  </>
                ) : (
                  <p class="admin-surveys-empty">{t.noOpenResponses}</p>
                )}
              </div>
            </section>

            <script is:inline>
              (() => {
                const seenMarker = document.querySelector('[data-admin-survey-seen-marker]');

                if (seenMarker instanceof HTMLElement) {
                  const storageKey = seenMarker.dataset.seenStorageKey || '';
                  const lastResponseAt = seenMarker.dataset.lastResponseAt || '';

                  if (storageKey && lastResponseAt && Number.isFinite(Date.parse(lastResponseAt))) {
                    try {
                      window.localStorage.setItem(storageKey, lastResponseAt);
                    } catch {
                      // Ignore storage failures: this is only a browser-local admin convenience marker.
                    }
                  }
                }

                const root = document.querySelector('[data-admin-surveys-tabs]');
                if (!root) return;

                const openAiSummaryForm = root.querySelector('[data-admin-survey-open-ai-form]');

                if (openAiSummaryForm instanceof HTMLFormElement) {
                  const submitButton = openAiSummaryForm.querySelector('[data-admin-survey-open-ai-submit]');
                  const errorNode = openAiSummaryForm.querySelector('[data-admin-survey-open-ai-error]');
                  const endpoint = openAiSummaryForm.getAttribute('data-endpoint') || '';
                  const generatingLabel = openAiSummaryForm.getAttribute('data-generating-label') || 'Generazione in corso…';
                  const fallbackError = openAiSummaryForm.getAttribute('data-error-message') || 'Errore.';
                  const originalLabel = submitButton?.textContent || '';

                  openAiSummaryForm.addEventListener('submit', async (event) => {
                    event.preventDefault();

                    if (!endpoint || !(submitButton instanceof HTMLButtonElement)) return;

                    submitButton.disabled = true;
                    submitButton.textContent = generatingLabel;

                    if (errorNode instanceof HTMLElement) {
                      errorNode.hidden = true;
                      errorNode.textContent = '';
                    }

                    try {
                      const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                          Accept: 'application/json',
                        },
                      });
                      const payload = await response.json().catch(() => null);

                      if (!response.ok || !payload?.ok) {
                        throw new Error(payload?.message || fallbackError);
                      }

                      window.location.reload();
                    } catch (error) {
                      if (errorNode instanceof HTMLElement) {
                        errorNode.textContent = error instanceof Error ? error.message : fallbackError;
                        errorNode.hidden = false;
                      }

                      submitButton.disabled = false;
                      submitButton.textContent = originalLabel;
                    }
                  });
                }

                const tabs = Array.from(root.querySelectorAll('[data-admin-surveys-tab]'));
                const panels = Array.from(root.querySelectorAll('[data-admin-surveys-panel]'));

                const activateTab = (view, options = {}) => {
                  tabs.forEach((tab) => {
                    const isActive = tab.getAttribute('data-admin-surveys-tab') === view;
                    tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    tab.tabIndex = isActive ? 0 : -1;

                    if (isActive && options.focusTab) {
                      tab.focus({ preventScroll: true });
                    }
                  });

                  panels.forEach((panel) => {
                    panel.hidden = panel.getAttribute('data-admin-surveys-panel') !== view;
                  });

                  const activePanel = panels.find((panel) => panel.getAttribute('data-admin-surveys-panel') === view);

                  if (activePanel && options.scrollPanel) {
                    activePanel.scrollIntoView({ block: 'start', behavior: 'smooth' });
                  }
                };

                tabs.forEach((tab, index) => {
                  tab.addEventListener('click', () => {
                    activateTab(tab.getAttribute('data-admin-surveys-tab'), { focusTab: false });
                  });

                  tab.addEventListener('keydown', (event) => {
                    const key = event.key;
                    const lastIndex = tabs.length - 1;
                    let nextIndex = index;

                    if (key === 'ArrowRight') nextIndex = index === lastIndex ? 0 : index + 1;
                    else if (key === 'ArrowLeft') nextIndex = index === 0 ? lastIndex : index - 1;
                    else if (key === 'Home') nextIndex = 0;
                    else if (key === 'End') nextIndex = lastIndex;
                    else return;

                    event.preventDefault();
                    activateTab(tabs[nextIndex].getAttribute('data-admin-surveys-tab'), { focusTab: true });
                  });
                });

                root.querySelectorAll('[data-admin-surveys-open-responses]').forEach((button) => {
                  button.addEventListener('click', () => {
                    activateTab('open-responses', { focusTab: true, scrollPanel: true });
                  });
                });

                const languageButtons = Array.from(root.querySelectorAll('[data-admin-surveys-language-filter]'));
                const searchInput = root.querySelector('[data-admin-surveys-response-search]');
                const questionFilter = root.querySelector('[data-admin-surveys-question-filter]');
                const sortSelect = root.querySelector('[data-admin-surveys-response-sort]');
                const list = root.querySelector('[data-admin-surveys-open-list]');
                const emptyState = root.querySelector('[data-admin-surveys-open-empty]');
                const countNode = root.querySelector('[data-admin-surveys-open-count]');
                const groups = list
                  ? Array.from(list.querySelectorAll('[data-admin-surveys-open-group]'))
                  : [];
                const responses = list
                  ? Array.from(list.querySelectorAll('[data-admin-surveys-open-response]'))
                  : [];
                let activeLanguage = 'all';

                const getResponseTime = (node) => {
                  const time = Date.parse(node.getAttribute('data-submitted-at') || '');
                  return Number.isFinite(time) ? time : 0;
                };

                const updateOpenResponses = () => {
                  if (!list) return;

                  const query = String(searchInput?.value || '').trim().toLocaleLowerCase();
                  const selectedQuestionId = String(questionFilter?.value || 'all');
                  const sortOrder = String(sortSelect?.value || 'newest');
                  let visibleCount = 0;

                  groups.forEach((group) => {
                    const groupQuestionId = group.getAttribute('data-question-id') || '';
                    const groupResponses = responses.filter(
                      (node) => node.getAttribute('data-question-id') === groupQuestionId
                    );
                    const visibleResponses = groupResponses.filter((node) => {
                      const language = node.getAttribute('data-language') || '';
                      const searchable = node.getAttribute('data-search') || '';
                      const matchesLanguage = activeLanguage === 'all' || language === activeLanguage;
                      const matchesQuestion = selectedQuestionId === 'all' || groupQuestionId === selectedQuestionId;
                      const matchesSearch = !query || searchable.includes(query);

                      return matchesLanguage && matchesQuestion && matchesSearch;
                    });

                    visibleResponses.sort((a, b) => {
                      const delta = getResponseTime(a) - getResponseTime(b);
                      return sortOrder === 'oldest' ? delta : -delta;
                    });

                    groupResponses.forEach((node) => {
                      node.hidden = !visibleResponses.includes(node);
                    });

                    const groupResponseList = group.querySelector('[data-admin-surveys-open-group-responses]');
                    visibleResponses.forEach((node) => groupResponseList?.append(node));

                    group.hidden = visibleResponses.length === 0;
                    visibleCount += visibleResponses.length;

                    const groupCountNode = group.querySelector('[data-admin-surveys-group-count]');

                    if (groupCountNode) {
                      const singular = root.getAttribute('data-response-singular') || 'risposta';
                      const plural = root.getAttribute('data-response-plural') || 'risposte';
                      groupCountNode.textContent = `${visibleResponses.length} ${
                        visibleResponses.length === 1 ? singular : plural
                      }`;
                    }
                  });

                  if (emptyState) {
                    emptyState.hidden = visibleCount > 0;
                  }

                  if (countNode) {
                    const singular = root.getAttribute('data-response-singular') || 'risposta';
                    const plural = root.getAttribute('data-response-plural') || 'risposte';
                    countNode.textContent = `${visibleCount} ${
                      visibleCount === 1 ? singular : plural
                    }`;
                  }
                };

                languageButtons.forEach((button) => {
                  button.addEventListener('click', () => {
                    activeLanguage = button.getAttribute('data-admin-surveys-language-filter') || 'all';
                    languageButtons.forEach((item) => {
                      item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
                    });
                    updateOpenResponses();
                  });
                });

                searchInput?.addEventListener('input', updateOpenResponses);
                questionFilter?.addEventListener('change', updateOpenResponses);
                sortSelect?.addEventListener('change', updateOpenResponses);
              })();
            </script>
          </>
        ) : (
          <section class="community-card">
            <p class="admin-surveys-empty">{resultsError}</p>
          </section>
        )}
      </>
    ) : (
      <>
        <CommunityHero
          kicker="Retro-Gamers.it"
          title="Accesso amministrativo"
          description="Questa pagina è riservata agli amministratori Retro-Gamers.it."
        />

        <section class="community-card">
          <div class="community-staff-links">
            <a class="community-action-link" href="/account/login/">Accedi</a>
          </div>
        </section>
      </>
    )}
  </CommunityLayout>
</BaseLayout>
