---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommunityHero from '../../../components/community/CommunityHero.astro';
import CommunityLayout from '../../../components/community/CommunityLayout.astro';
import CommunitySidebarSection from '../../../components/community/CommunitySidebarSection.astro';
import { getUserSessionFromCookies } from '../../../lib/supabase/auth';
import '../../../styles/pages/admin-comments.css';

const title = 'Moderazione commenti | Retro-Gamers.it';
const description = 'Pannello moderazione commenti Retro-Gamers.it';
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = session.profile?.role === 'admin' || session.profile?.role === 'moderator';
---

<BaseLayout title={title} description={description}>
  <CommunityLayout class="admin-comments-page" sidebar={isStaff}>
    <Fragment slot="sidebar">
      {isStaff && (
        <CommunitySidebarSection title="Strumenti redazione">
          <div class="community-staff-links">
            <a class="community-action-link" href="/admin/comments/">Moderazione commenti</a>
            <a class="community-action-link" href="/admin/users/">Gestione utenti</a>
            <a class="community-action-link" href="/admin/private-message-reports/">Segnalazioni messaggi</a>
          </div>
        </CommunitySidebarSection>
      )}
    </Fragment>

    <CommunityHero
      kicker="Retro-Gamers.it"
      title="Moderazione commenti"
      description="Controlla la coda, filtra gli stati e mantieni leggibili le discussioni della community."
    >
      <span slot="aside" class="community-soft-badge" data-admin-comments-count>Caricamento...</span>
    </CommunityHero>

    <section class="community-card admin-comments-panel">
      <form class="admin-comments-filters" data-admin-comments-filters>
        <label>
          <span>Stato</span>
          <select name="status">
            <option value="all" selected>Tutti</option>
            <option value="pending">In attesa</option>
            <option value="approved">Approvati</option>
            <option value="rejected">Rifiutati</option>
            <option value="spam">Spam</option>
            <option value="deleted">Eliminati</option>
          </select>
        </label>

        <label>
          <span>Lingua</span>
          <select name="language">
            <option value="all" selected>Tutte</option>
            <option value="it">Italiano</option>
            <option value="en">English</option>
          </select>
        </label>

        <label>
          <span>Ricerca</span>
          <input
            type="search"
            name="q"
            placeholder="Autore, testo, articolo..."
            autocomplete="off"
          />
        </label>

        <div class="admin-comments-filters__actions">
          <button type="submit">Filtra</button>
          <button type="button" data-admin-comments-reset>Reset</button>
        </div>
      </form>

      <div class="admin-comments-message" data-admin-comments-message hidden></div>

      <div class="admin-comments-list" data-admin-comments-list>
        <p class="admin-comments-empty">Caricamento commenti...</p>
      </div>
    </section>
  </CommunityLayout>

  <script>
    const listNode = document.querySelector('[data-admin-comments-list]');
    const countNode = document.querySelector('[data-admin-comments-count]');
    const messageNode = document.querySelector('[data-admin-comments-message]');
    const filtersForm = document.querySelector('[data-admin-comments-filters]');
    const resetButton = document.querySelector('[data-admin-comments-reset]');

    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const showMessage = (text, type = 'ok') => {
      if (!messageNode) return;

      messageNode.textContent = text;
      messageNode.dataset.type = type;
      messageNode.hidden = !text;
    };

    const formatDate = (value) => {
      if (!value) return '';

      return new Intl.DateTimeFormat('it-IT', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }).format(new Date(value));
    };

    const statusLabels = {
      pending: 'In attesa',
      approved: 'Approvato',
      rejected: 'Rifiutato',
      spam: 'Spam',
      deleted: 'Eliminato'
    };

    const getFilterParams = () => {
      const params = new URLSearchParams();

      if (!filtersForm) return params;

      const formData = new FormData(filtersForm);
      const status = String(formData.get('status') || 'all');
      const language = String(formData.get('language') || 'all');
      const q = String(formData.get('q') || '').trim();

      params.set('status', status);
      params.set('language', language);
      if (q) params.set('q', q);

      return params;
    };

    const renderComment = (comment) => {
      const profile = comment.profiles || {};
      const author = profile.display_name || profile.username || 'Utente';
      const badge = profile.user_badges?.label_it || profile.user_badges?.label_en || '';
      const articleUrl = comment.article_url || '#';
      const status = statusLabels[comment.status] || comment.status || 'Stato sconosciuto';
      const parent = comment.parent || null;
      const parentProfile = parent?.profiles || {};
      const parentAuthor = parentProfile.display_name || parentProfile.username || 'Commento originale';

      return `
        <article class="admin-comment-card" data-comment-id="${escapeHtml(comment.id)}">
          <header class="admin-comment-card__header">
            <div>
              <p class="admin-comment-card__article">
                <a href="${escapeHtml(articleUrl)}" target="_blank" rel="noreferrer">
                  ${escapeHtml(comment.article_title || comment.article_slug)}
                </a>
              </p>

              <h2>${escapeHtml(author)}</h2>

              <p class="admin-comment-card__meta">
                <span class="admin-comment-card__status" data-status="${escapeHtml(comment.status || '')}">
                  ${escapeHtml(status)}
                </span>
                ${badge ? `<span>${escapeHtml(badge)}</span>` : ''}
                ${comment.article_language ? `<span>${escapeHtml(comment.article_language.toUpperCase())}</span>` : ''}
                ${comment.created_at ? `<span>${escapeHtml(formatDate(comment.created_at))}</span>` : ''}
              </p>
            </div>
          </header>

          ${parent ? `
            <div class="admin-comment-card__parent">
              <strong>Risposta a ${escapeHtml(parentAuthor)}</strong>
              <p>${escapeHtml(parent.body || '').slice(0, 220)}</p>
            </div>
          ` : ''}

          <div class="admin-comment-card__body">
            ${escapeHtml(comment.body)}
          </div>

          <div class="admin-comment-card__actions">
            <a href="${escapeHtml(articleUrl)}" target="_blank" rel="noreferrer">Apri articolo</a>
            ${comment.status !== 'approved' ? '<button type="button" data-action="approve">Approva</button>' : ''}
            ${comment.status !== 'rejected' ? '<button type="button" data-action="reject">Rifiuta</button>' : ''}
            ${comment.status !== 'spam' ? '<button type="button" data-action="spam" data-confirm="Segnare questo commento come spam?">Spam</button>' : ''}
            ${comment.status !== 'deleted' ? '<button type="button" data-action="delete" data-confirm="Eliminare questo commento dalla moderazione pubblica?">Elimina</button>' : ''}
            ${comment.status !== 'pending' ? '<button type="button" data-action="restore">Rimetti in coda</button>' : ''}
          </div>
        </article>
      `;
    };

    const loadComments = async () => {
      if (!listNode) return;

      try {
        const params = getFilterParams();
        const response = await fetch(`/api/admin/comments/pending?${params.toString()}`);
        const result = await response.json();

        if (!result.ok) {
          listNode.innerHTML = `<p class="admin-comments-empty">${escapeHtml(result.error || 'Errore caricamento commenti.')}</p>`;
          if (countNode) countNode.textContent = 'Accesso non disponibile';
          return;
        }

        const comments = result.comments || [];

        if (countNode) {
          countNode.textContent = comments.length === 1
            ? '1 commento trovato'
            : `${comments.length} commenti trovati`;
        }

        if (comments.length === 0) {
          listNode.innerHTML = '<p class="admin-comments-empty">Nessun commento trovato con questi filtri.</p>';
          return;
        }

        listNode.innerHTML = comments.map(renderComment).join('');
      } catch {
        listNode.innerHTML = '<p class="admin-comments-empty">Errore di connessione.</p>';
      }
    };

    filtersForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      showMessage('');
      loadComments();
    });

    resetButton?.addEventListener('click', () => {
      filtersForm?.reset();
      showMessage('');
      loadComments();
    });

    listNode?.addEventListener('click', async (event) => {
      const button = event.target.closest('button[data-action]');
      if (!button) return;

      const card = button.closest('[data-comment-id]');
      const commentId = card?.dataset.commentId;
      const action = button.dataset.action;

      if (!commentId || !action) return;

      const confirmation = button.dataset.confirm;
      if (confirmation && !window.confirm(confirmation)) {
        return;
      }

      button.disabled = true;
      showMessage('');

      try {
        const response = await fetch('/api/admin/comments/moderate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            commentId,
            action,
            note: `Moderazione da pannello admin: ${action}`
          })
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(result.error || 'Azione non riuscita.', 'error');
          button.disabled = false;
          return;
        }

        showMessage('Commento aggiornato.', 'ok');
        await loadComments();
      } catch {
        showMessage('Errore di connessione.', 'error');
        button.disabled = false;
      }
    });

    loadComments();
  </script>
</BaseLayout>
