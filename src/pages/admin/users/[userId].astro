---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminDashboardBackLink from '../../../components/admin/AdminDashboardBackLink.astro';
import AdminToolsSidebar from '../../../components/admin/AdminToolsSidebar.astro';
import CommunityHero from '../../../components/community/CommunityHero.astro';
import CommunityLayout from '../../../components/community/CommunityLayout.astro';
import { getUserSessionFromCookies } from '../../../lib/supabase/auth';
import '../../../styles/pages/admin-users.css';

const userId = String(Astro.params.userId || '').trim();
const title = 'Dettaglio utente | Retro-Gamers.it';
const description = 'Dettaglio gestione utente Retro-Gamers.it';
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = session.profile?.role === 'admin' || session.profile?.role === 'moderator';
---

<BaseLayout title={title} description={description}>
  <CommunityLayout class="admin-users-page admin-users-detail-page" sidebar={isStaff}>
    <AdminToolsSidebar slot="sidebar" lang="it" />

    {isStaff && <AdminDashboardBackLink slot="before" lang="it" />}

    <CommunityHero
      kicker="Retro-Gamers.it"
      title="Dettaglio utente"
      description="Gestisci ruolo, stato e badge del lettore selezionato."
    >
      <span slot="aside" class="community-soft-badge" data-admin-user-detail-count>Caricamento...</span>
    </CommunityHero>

    <section class="community-card admin-users-panel admin-user-detail-panel" data-admin-user-detail data-user-id={userId}>
      <div class="admin-user-detail-panel__nav">
        <a class="admin-user-card__profile-link" href="/admin/users/">← Torna agli utenti</a>
      </div>

      <div class="admin-users-message" data-admin-users-message hidden></div>

      <div class="admin-users-list" data-admin-user-detail-body>
        <p class="admin-users-empty">Caricamento dettaglio utente...</p>
      </div>
    </section>
  </CommunityLayout>

  <script>
    const detailRoot = document.querySelector('[data-admin-user-detail]');
    const detailNode = document.querySelector('[data-admin-user-detail-body]');
    const countNode = document.querySelector('[data-admin-user-detail-count]');
    const messageNode = document.querySelector('[data-admin-users-message]');
    const userId = detailRoot?.dataset.userId || '';

    let viewerRole = 'moderator';
    let availableBadges = [];
    let badgeManagementAvailable = false;

    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const showMessage = (text, type = 'ok') => {
      if (!messageNode) return;

      messageNode.textContent = text;
      messageNode.dataset.type = type;
      messageNode.hidden = !text;
    };

    const markAdminUserSeen = async (createdAt) => {
      if (viewerRole !== 'admin' || !createdAt || !Number.isFinite(Date.parse(createdAt))) return;

      try {
        const response = await fetch('/api/admin/activity/mark-read', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            category: 'users',
            seenThrough: createdAt,
            lang: 'it'
          })
        });
        const result = await response.json().catch(() => null);

        if (response.ok && result?.ok === true) {
          window.dispatchEvent(new CustomEvent('retro-gamers:refresh-admin-unread'));
        }
      } catch {
        // Read-state updates must not affect user management.
      }
    };

    const formatDate = (value) => {
      if (!value) return 'Non disponibile';

      return new Intl.DateTimeFormat('it-IT', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }).format(new Date(value));
    };

    const formatLastActivity = (value) => {
      if (!value) return 'Mai dopo la registrazione';

      const date = new Date(value);
      const now = new Date();
      const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const startOfYesterday = new Date(startOfToday);
      startOfYesterday.setDate(startOfToday.getDate() - 1);
      const startOfTomorrow = new Date(startOfToday);
      startOfTomorrow.setDate(startOfToday.getDate() + 1);
      const time = new Intl.DateTimeFormat('it-IT', {
        hour: '2-digit',
        minute: '2-digit'
      }).format(date);

      if (date >= startOfToday && date < startOfTomorrow) {
        return `Oggi alle ${time}`;
      }

      if (date >= startOfYesterday && date < startOfToday) {
        return `Ieri alle ${time}`;
      }

      return new Intl.DateTimeFormat('it-IT', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      }).format(date);
    };

    const getUserInitial = (user) => {
      const source = user.displayName || user.username || user.email || 'Utente';
      const match = String(source || '').trim().match(/[A-Za-zÀ-ÖØ-öø-ÿ0-9]/);

      return (match?.[0] || '?').toUpperCase();
    };

    const usernamePattern = /^[a-z0-9_-]{3,24}$/;

    const normalizeUsername = (value) =>
      String(value || '')
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '-');

    const getPublicProfileHref = (username) => {
      const normalizedUsername = normalizeUsername(username);

      if (!usernamePattern.test(normalizedUsername)) {
        return '';
      }

      return `/utenti/${encodeURIComponent(normalizedUsername)}/`;
    };

    const roleLabels = {
      user: 'User',
      moderator: 'Moderator',
      admin: 'Admin'
    };

    const statusLabels = {
      active: 'Active',
      suspended: 'Sospeso',
      banned: 'Bannato'
    };

    const editorialRoleLabels = {
      contributor: 'Contributor',
      editor: 'Editor',
      editorial_admin: 'Editorial admin'
    };

    const editorialStatusLabels = {
      active: 'Attivo',
      suspended: 'Sospeso'
    };

    const getBadgeLabel = (badge) =>
      badge?.labelIt || badge?.labelEn || badge?.key || 'Badge';

    const getBadgeImage = (badge) => {
      const value = String(badge?.imagePath || '').trim();

      if (!value) return '';

      if (/^https?:\/\//i.test(value) || value.startsWith('/')) {
        return value;
      }

      return `/${value.replace(/^\/+/, '')}`;
    };

    const slugifyAuthorName = (value) =>
      String(value || '')
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/['’]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .replace(/-{2,}/g, '-')
        .slice(0, 96);

    const renderRoleActions = (user) => {
      if (!user.canManageRole || viewerRole !== 'admin') {
        return '';
      }

      return `
        ${user.role !== 'admin' ? '<button type="button" data-role="admin" data-confirm="Promuovere questo utente ad admin?">Promuovi a admin</button>' : ''}
        ${user.role !== 'moderator' ? '<button type="button" data-role="moderator">Promuovi a moderator</button>' : ''}
        ${user.role !== 'user' ? '<button type="button" data-role="user">Riporta a user</button>' : ''}
      `;
    };

    const renderStatusActions = (user) => {
      if (!user.canManageStatus) {
        return '';
      }

      return `
        ${user.status !== 'active' ? '<button type="button" data-status="active">Riattiva</button>' : ''}
        ${user.status !== 'suspended' ? '<button type="button" data-status="suspended" data-confirm="Sospendere questo utente?">Sospendi</button>' : ''}
        ${user.status !== 'banned' ? '<button type="button" data-status="banned" data-confirm="Bannare questo utente?">Banna</button>' : ''}
      `;
    };

    const renderUsernameManagement = (user) => {
      if (viewerRole !== 'admin') {
        return '';
      }

      const currentUsername = normalizeUsername(user.username || '');
      const currentUsernameLabel = currentUsername ? `@${currentUsername}` : 'Non impostato';

      return `
        <section class="admin-user-card__username" aria-label="Username pubblico" data-username-section data-current-username="${escapeHtml(currentUsername)}">
          <div class="admin-user-card__username-header">
            <div>
              <h3>Username pubblico</h3>
              <p>Cambia solo lo username pubblico collegato agli URL del profilo.</p>
            </div>
            <strong data-username-current>${escapeHtml(currentUsernameLabel)}</strong>
          </div>

          <div class="admin-user-card__username-form">
            <label>
              <span>Nuovo username</span>
              <input
                type="text"
                data-username-input
                value="${escapeHtml(currentUsername)}"
                minlength="3"
                maxlength="24"
                pattern="[a-z0-9_-]{3,24}"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />
            </label>

            <button type="button" data-username-action="update">Aggiorna username</button>
          </div>

          <p class="admin-user-card__notice">
            Non modifica password, email, nome visualizzato, contenuti o relazioni dell’account.
          </p>
        </section>
      `;
    };

    const renderBadgeManagement = (user) => {
      const assignedBadges = user.assignedBadges || [];
      const assignedKeys = new Set(assignedBadges.map((badge) => badge.key));
      const assignableBadges = availableBadges.filter((badge) => !assignedKeys.has(badge.key));
      const currentBadgeLabel = user.currentBadge
        ? getBadgeLabel(user.currentBadge)
        : user.currentBadgeKey || 'Non impostato';
      const assignedMarkup = assignedBadges.length > 0
        ? assignedBadges.map((badge) => {
            const isCurrent = badge.key === user.currentBadgeKey;

            return `
              <span class="admin-user-badge${isCurrent ? ' is-current' : ''}">
                ${getBadgeImage(badge) ? `<img src="${escapeHtml(getBadgeImage(badge))}" alt="" loading="lazy" decoding="async" />` : ''}
                <span>${escapeHtml(getBadgeLabel(badge))}${isCurrent ? ' · attivo' : ''}</span>
                ${user.canManageBadges ? `
                  <button
                    type="button"
                    data-badge-action="remove"
                    data-badge-key="${escapeHtml(badge.key)}"
                    data-confirm="Rimuovere questo badge dall’utente?"
                  >
                    Rimuovi
                  </button>
                ` : ''}
              </span>
            `;
          }).join('')
        : '<p class="admin-user-card__notice">Nessun badge assegnato</p>';
      const assignMarkup = user.canManageBadges
        ? `
          <div class="admin-user-card__badge-assign">
            <select data-badge-select ${assignableBadges.length === 0 ? 'disabled' : ''}>
              <option value="">Assegna badge</option>
              ${assignableBadges.map((badge) => `
                <option value="${escapeHtml(badge.key)}">${escapeHtml(getBadgeLabel(badge))}</option>
              `).join('')}
            </select>
            <button
              type="button"
              data-badge-action="assign"
              ${assignableBadges.length === 0 ? 'disabled' : ''}
            >
              Assegna badge
            </button>
          </div>
        `
        : badgeManagementAvailable
          ? '<p class="admin-user-card__notice">Solo gli admin possono modificare i badge.</p>'
          : '<p class="admin-user-card__notice">Gestione badge non disponibile: esegui lo SQL dedicato in Supabase.</p>';

      return `
        <section class="admin-user-card__badges" aria-label="Gestisci badge">
          <div class="admin-user-card__badges-header">
            <div>
              <h3>Gestisci badge</h3>
              <p>Badge attivo: ${escapeHtml(currentBadgeLabel)}</p>
            </div>
          </div>

          <div class="admin-user-card__badge-list" aria-label="Badge assegnati">
            ${assignedMarkup}
          </div>

          ${assignMarkup}
        </section>
      `;
    };

    const renderEditorialAccess = (user) => {
      const editorial = user.editorialAccess || {};

      if (!editorial.canManage) {
        return '';
      }

      if (!editorial.databaseAvailable) {
        const isDatabaseMissing = editorial.error === 'Editorial database not initialized';

        return `
          <section class="admin-user-card__editorial" aria-label="Accesso redazione">
            <div class="admin-user-card__editorial-header">
              <div>
                <h3>Accesso redazione</h3>
                <p>${isDatabaseMissing ? 'Database editoriale non inizializzato.' : 'Accesso redazione temporaneamente non disponibile.'}</p>
              </div>
            </div>
            <p class="admin-user-card__notice">
              ${isDatabaseMissing
                ? 'Applica prima lo SQL editoriale in Supabase. La gestione community resta disponibile.'
                : 'Riprova più tardi. La gestione community resta disponibile.'
              }
            </p>
          </section>
        `;
      }

      const profile = editorial.profile;
      const author = profile?.author || null;
      const authorName = author
        ? author.nickname
          ? `${author.nickname} (${author.name})`
          : author.name
        : '';
      const suggestedName = user.displayName || user.username || '';
      const suggestedSlug = slugifyAuthorName(suggestedName);

      if (!profile) {
        return `
          <section class="admin-user-card__editorial" aria-label="Accesso redazione" data-editorial-section>
            <div class="admin-user-card__editorial-header">
              <div>
                <h3>Accesso redazione</h3>
                <p>Questo account non ha accesso alla redazione.</p>
              </div>
            </div>

            <button type="button" class="admin-user-card__editorial-primary" data-editorial-action="show-enable">
              Abilita accesso redazione
            </button>

            <div class="admin-user-card__editorial-form" data-editorial-enable-form hidden>
              <label>
                <span>Ruolo editoriale</span>
                <select data-editorial-role-select>
                  <option value="contributor">Contributor</option>
                  <option value="editor">Editor</option>
                  <option value="editorial_admin">Editorial admin</option>
                </select>
              </label>

              <fieldset>
                <legend>Identità autore Sanity</legend>
                <label>
                  <input type="radio" name="editorial-author-mode-${escapeHtml(user.userId)}" value="existing" checked data-editorial-author-mode />
                  Associa autore esistente
                </label>
                <label>
                  <input type="radio" name="editorial-author-mode-${escapeHtml(user.userId)}" value="new" data-editorial-author-mode />
                  Crea nuovo autore
                </label>
              </fieldset>

              <div data-editorial-existing-author-panel>
                <label>
                  <span>Cerca autore</span>
                  <input type="search" data-editorial-author-search placeholder="Nome, nickname o slug" autocomplete="off" />
                </label>
                <button type="button" data-editorial-action="search-authors">Cerca autore</button>
                <input type="hidden" data-editorial-selected-author-id value="" />
                <div class="admin-user-card__editorial-results" data-editorial-author-results aria-live="polite"></div>
              </div>

              <div data-editorial-new-author-panel hidden>
                <label>
                  <span>Nome</span>
                  <input type="text" data-editorial-author-name value="${escapeHtml(suggestedName)}" maxlength="120" />
                </label>
                <label>
                  <span>Nickname opzionale</span>
                  <input type="text" data-editorial-author-nickname maxlength="120" />
                </label>
                <label>
                  <span>Firma pubblica</span>
                  <select data-editorial-author-display-name>
                    <option value="real">Nome reale</option>
                    <option value="nickname">Nickname</option>
                  </select>
                </label>
                <label>
                  <span>Slug</span>
                  <input type="text" data-editorial-author-slug value="${escapeHtml(suggestedSlug)}" maxlength="96" />
                </label>
              </div>

              <button type="button" class="admin-user-card__editorial-primary" data-editorial-action="save-access">
                Salva accesso redazione
              </button>
            </div>
          </section>
        `;
      }

      return `
        <section class="admin-user-card__editorial" aria-label="Accesso redazione" data-editorial-section>
          <div class="admin-user-card__editorial-header">
            <div>
              <h3>Accesso redazione</h3>
              <p>Mapping privato tra account community e autore Sanity.</p>
            </div>
          </div>

          <dl class="admin-user-card__editorial-facts">
            <div>
              <dt>Ruolo</dt>
              <dd>${escapeHtml(editorialRoleLabels[profile.editorialRole] || profile.editorialRole)}</dd>
            </div>
            <div>
              <dt>Stato</dt>
              <dd>${escapeHtml(editorialStatusLabels[profile.status] || profile.status)}</dd>
            </div>
            <div>
              <dt>Autore Sanity</dt>
              <dd>
                ${author
                  ? `
                    <strong>${escapeHtml(authorName)}</strong>
                    ${author.slug ? `<span>/${escapeHtml(author.slug)}/</span>` : ''}
                    <span>ID: ${escapeHtml(profile.sanityAuthorId)}</span>
                    ${author.role ? `<span>Ruolo pubblico autore: ${escapeHtml(author.role)}</span>` : ''}
                  `
                  : `
                    <strong>Autore non risolto</strong>
                    <span>ID: ${escapeHtml(profile.sanityAuthorId)}</span>
                  `
                }
              </dd>
            </div>
          </dl>

          <div class="admin-user-card__editorial-update">
            <label>
              <span>Ruolo editoriale</span>
              <select data-editorial-update-role>
                ${Object.entries(editorialRoleLabels).map(([value, label]) => `
                  <option value="${escapeHtml(value)}" ${profile.editorialRole === value ? 'selected' : ''}>${escapeHtml(label)}</option>
                `).join('')}
              </select>
            </label>
            <button type="button" data-editorial-action="update-access">Cambia ruolo</button>
            ${profile.status === 'active'
              ? '<button type="button" data-editorial-action="suspend-access" data-confirm="Sospendere l’accesso redazione per questo account?">Sospendi accesso</button>'
              : '<button type="button" data-editorial-action="activate-access">Riattiva accesso</button>'
            }
          </div>
        </section>
      `;
    };

    const renderUser = (user) => {
      const role = roleLabels[user.role] || user.role || 'User';
      const status = statusLabels[user.status] || user.status || 'Active';
      const actions = [renderRoleActions(user), renderStatusActions(user)]
        .filter(Boolean)
        .join('');
      const displayName = user.displayName || 'Non impostato';
      const username = user.username || 'Non impostato';
      const email = user.email || 'Email non disponibile';
      const comments = user.comments || { total: 0, pending: 0, approved: 0 };
      const ratings = user.ratings || { total: 0 };
      const communityPointsValue = user.communityPoints == null
        ? Number.NaN
        : Number(user.communityPoints);
      const communityPoints = Number.isFinite(communityPointsValue)
        ? communityPointsValue
        : 1;
      const pointsBreakdown = user.communityPointsBreakdown || {
        reviewRatings: ratings.total || 0,
        approvedComments: comments.approved || 0,
        receivedLikes: comments.likesReceived || 0,
        memories: null,
      };
      const avatarInitial = getUserInitial(user);
      const avatarLabel = `Avatar di ${user.displayName || user.username || user.email || 'utente'}`;
      const publicProfileHref = getPublicProfileHref(user.username);
      const avatarImage = user.avatarUrl
        ? `
          <img
            src="${escapeHtml(user.avatarUrl)}"
            alt=""
            loading="lazy"
            decoding="async"
            onerror="this.hidden = true"
          />
        `
        : '';

      return `
        <article class="admin-user-card admin-user-card--detail" data-user-id="${escapeHtml(user.userId)}">
          <header class="admin-user-card__header">
            <div class="admin-user-card__identity">
              <span class="admin-user-card__avatar" role="img" aria-label="${escapeHtml(avatarLabel)}">
                <span class="admin-user-card__avatar-fallback" aria-hidden="true">${escapeHtml(avatarInitial)}</span>
                ${avatarImage}
              </span>

              <div>
                <p class="admin-user-card__email">${escapeHtml(email)}</p>
                <h2>${escapeHtml(displayName)}</h2>

                <p class="admin-user-card__meta">
                  <span>@${escapeHtml(username)}</span>
                  <span class="admin-user-card__role" data-role="${escapeHtml(user.role || '')}">
                    Ruolo: ${escapeHtml(role)}
                  </span>
                  <span class="admin-user-card__status" data-status="${escapeHtml(user.status || '')}">
                    Stato: ${escapeHtml(status)}
                  </span>
                  <span>Registrato: ${escapeHtml(formatDate(user.createdAt))}</span>
                  <span>Ultima attività: ${escapeHtml(formatLastActivity(user.lastActivityAt))}</span>
                </p>
              </div>
            </div>
          </header>

          <div class="admin-user-card__stats" aria-label="Commenti">
            <div>
              <span>Commenti</span>
              <strong>${Number(comments.total || 0)}</strong>
            </div>

            <div>
              <span>Pending</span>
              <strong>${Number(comments.pending || 0)}</strong>
            </div>

            <div>
              <span>Approved</span>
              <strong>${Number(comments.approved || 0)}</strong>
            </div>

            <div>
              <span>Voti</span>
              <strong>${Number(ratings.total || 0)}</strong>
            </div>

            <div>
              <span>Punti community</span>
              <strong>${communityPoints}</strong>
            </div>
          </div>

          <div class="admin-user-card__points-breakdown" aria-label="Dettaglio punti community">
            <span>Voti recensioni: ${Number(pointsBreakdown.reviewRatings || 0)}</span>
            <span>Commenti approvati: ${Number(pointsBreakdown.approvedComments || 0)}</span>
            <span>Like ricevuti: ${Number(pointsBreakdown.receivedLikes || 0)}</span>
          </div>

          ${renderUsernameManagement(user)}

          ${renderBadgeManagement(user)}

          ${renderEditorialAccess(user)}

          <div class="admin-user-card__actions">
            ${publicProfileHref ? `<a class="admin-user-card__profile-link" href="${escapeHtml(publicProfileHref)}">Vedi profilo</a>` : ''}
            ${user.isSelf ? '<span class="admin-user-card__notice">Il tuo account è protetto da modifiche dirette.</span>' : ''}
            ${actions || (!user.isSelf ? '<span class="admin-user-card__notice">Nessuna azione disponibile per il tuo ruolo.</span>' : '')}
          </div>
        </article>
      `;
    };

    const loadUser = async () => {
      if (!detailNode) return;

      try {
        const params = new URLSearchParams({
          detail: '1',
          userId
        });
        const response = await fetch(`/api/admin/users/list?${params.toString()}`);
        const result = await response.json();

        if (!result.ok) {
          detailNode.innerHTML = `<p class="admin-users-empty">${escapeHtml(result.error || 'Errore caricamento utente.')}</p>`;
          if (countNode) countNode.textContent = 'Dettaglio non disponibile';
          return;
        }

        viewerRole = result.viewerRole || 'moderator';
        availableBadges = result.availableBadges || [];
        badgeManagementAvailable = Boolean(result.badgeManagementAvailable);
        const user = result.users?.[0];

        if (!user) {
          detailNode.innerHTML = '<p class="admin-users-empty">Utente non trovato.</p>';
          if (countNode) countNode.textContent = 'Utente non trovato';
          return;
        }

        if (countNode) {
          countNode.textContent = user.email || user.username || 'Utente selezionato';
        }

        detailNode.innerHTML = renderUser(user);
        markAdminUserSeen(user.createdAt);
      } catch {
        detailNode.innerHTML = '<p class="admin-users-empty">Errore di connessione.</p>';
      }
    };

    const editorialErrorLabels = {
      unauthorized: 'Permessi insufficienti.',
      suspended_admin: 'Admin non attivo: accesso redazione non consentito.',
      target_user_missing: 'Utente di destinazione non trovato.',
      target_user_unavailable: 'Utente di destinazione non disponibile.',
      author_missing: 'Autore Sanity non trovato.',
      'author missing': 'Autore Sanity non trovato.',
      author_already_linked: 'Questo autore Sanity è già collegato a un altro account.',
      mapping_already_exists: 'Questo account ha già un autore collegato. Il cambio autore richiede un flusso dedicato.',
      invalid_author: 'Dati autore non validi.',
      invalid_request: 'Richiesta non valida.',
      invalid_status: 'Stato editoriale non valido.',
      'invalid editorial role': 'Ruolo editoriale non valido.',
      slug_already_exists: 'Slug autore già esistente.',
      editorial_database_not_initialized: 'Database editoriale non inizializzato.',
      'Sanity unavailable': 'Sanity non disponibile.',
      mapping_failed: 'Mapping editoriale non completato.',
    };

    const getEditorialErrorMessage = (error) =>
      editorialErrorLabels[error] || error || 'Operazione editoriale non riuscita.';

    const getEditorialSection = (element) =>
      element?.closest?.('[data-editorial-section]');

    const syncEditorialAuthorMode = (section) => {
      const mode = section?.querySelector('[data-editorial-author-mode]:checked')?.value || 'existing';
      const existingPanel = section?.querySelector('[data-editorial-existing-author-panel]');
      const newPanel = section?.querySelector('[data-editorial-new-author-panel]');

      if (existingPanel) existingPanel.hidden = mode !== 'existing';
      if (newPanel) newPanel.hidden = mode !== 'new';
    };

    const renderEditorialAuthorResults = (section, authors) => {
      const resultsNode = section?.querySelector('[data-editorial-author-results]');
      const selectedInput = section?.querySelector('[data-editorial-selected-author-id]');

      if (!resultsNode) return;

      if (selectedInput) selectedInput.value = '';

      if (!authors?.length) {
        resultsNode.innerHTML = '<p class="admin-user-card__notice">Nessun autore trovato.</p>';
        return;
      }

      resultsNode.innerHTML = authors.map((author) => {
        const title = author.nickname
          ? `${author.nickname} (${author.name})`
          : author.name;
        const facts = [
          author.slug ? `/${author.slug}/` : '',
          author.role ? `Ruolo pubblico: ${author.role}` : '',
          `ID: ${author._id}`
        ].filter(Boolean).join(' · ');

        return `
          <button type="button" data-editorial-action="select-author" data-editorial-author-id="${escapeHtml(author._id)}">
            ${author.imagePreviewUrl ? `<img src="${escapeHtml(author.imagePreviewUrl)}" alt="" loading="lazy" decoding="async" />` : ''}
            <span>
              <strong>${escapeHtml(title)}</strong>
              <small>${escapeHtml(facts)}</small>
            </span>
          </button>
        `;
      }).join('');
    };

    const submitEditorialRequest = async (url, options) => {
      const response = await fetch(url, {
        ...options,
        headers: {
          'Content-Type': 'application/json',
          ...(options?.headers || {})
        }
      });
      const result = await response.json();

      if (!result.ok) {
        throw new Error(getEditorialErrorMessage(result.error));
      }

      return result;
    };

    const handleEditorialAction = async (button) => {
      const section = getEditorialSection(button);
      const card = button.closest('[data-user-id]');
      const targetUserId = card?.dataset.userId;
      const action = button.dataset.editorialAction;

      if (!section || !targetUserId || !action) return false;

      if (action === 'show-enable') {
        const form = section.querySelector('[data-editorial-enable-form]');
        if (form) {
          form.hidden = false;
          button.hidden = true;
          syncEditorialAuthorMode(section);
        }
        return true;
      }

      if (action === 'select-author') {
        const selectedInput = section.querySelector('[data-editorial-selected-author-id]');
        const authorId = button.dataset.editorialAuthorId || '';

        if (selectedInput) selectedInput.value = authorId;

        section.querySelectorAll('[data-editorial-action="select-author"]').forEach((node) => {
          node.setAttribute('aria-pressed', node === button ? 'true' : 'false');
        });

        return true;
      }

      const confirmation = button.dataset.confirm;
      if (confirmation && !window.confirm(confirmation)) {
        return true;
      }

      button.disabled = true;
      showMessage('');

      try {
        if (action === 'search-authors') {
          const query = section.querySelector('[data-editorial-author-search]')?.value || '';
          const response = await fetch(`/api/admin/editorial/authors/search?q=${encodeURIComponent(query)}`);
          const result = await response.json();

          if (!result.ok) {
            throw new Error(getEditorialErrorMessage(result.error));
          }

          renderEditorialAuthorResults(section, result.authors || []);
          button.disabled = false;
          return true;
        }

        if (action === 'save-access') {
          const role = section.querySelector('[data-editorial-role-select]')?.value || 'contributor';
          const mode = section.querySelector('[data-editorial-author-mode]:checked')?.value || 'existing';

          if (mode === 'existing') {
            const sanityAuthorId = section.querySelector('[data-editorial-selected-author-id]')?.value || '';

            if (!sanityAuthorId) {
              throw new Error('Seleziona un autore Sanity.');
            }

            await submitEditorialRequest('/api/admin/editorial/profiles/link', {
              method: 'POST',
              body: JSON.stringify({
                targetUserId,
                sanityAuthorId,
                editorialRole: role,
              }),
            });
          } else {
            await submitEditorialRequest('/api/admin/editorial/authors/create', {
              method: 'POST',
              body: JSON.stringify({
                targetUserId,
                name: section.querySelector('[data-editorial-author-name]')?.value || '',
                nickname: section.querySelector('[data-editorial-author-nickname]')?.value || '',
                displayName: section.querySelector('[data-editorial-author-display-name]')?.value || 'real',
                slug: section.querySelector('[data-editorial-author-slug]')?.value || '',
                editorialRole: role,
              }),
            });
          }

          showMessage('Accesso redazione aggiornato.', 'ok');
          await loadUser();
          return true;
        }

        if (action === 'update-access' || action === 'suspend-access' || action === 'activate-access') {
          const body = action === 'update-access'
            ? { editorialRole: section.querySelector('[data-editorial-update-role]')?.value || 'contributor' }
            : { status: action === 'suspend-access' ? 'suspended' : 'active' };

          await submitEditorialRequest(`/api/admin/editorial/profiles/${encodeURIComponent(targetUserId)}`, {
            method: 'PATCH',
            body: JSON.stringify(body),
          });

          showMessage('Accesso redazione aggiornato.', 'ok');
          await loadUser();
          return true;
        }
      } catch (error) {
        showMessage(error instanceof Error ? error.message : 'Operazione editoriale non riuscita.', 'error');
        button.disabled = false;
        return true;
      }

      button.disabled = false;
      return false;
    };

    const handleUsernameUpdate = async (button) => {
      const section = button.closest('[data-username-section]');
      const card = button.closest('[data-user-id]');
      const targetUserId = card?.dataset.userId;
      const input = section?.querySelector('[data-username-input]');

      if (!(input instanceof HTMLInputElement) || !targetUserId || viewerRole !== 'admin') {
        showMessage('Permessi insufficienti.', 'error');
        return;
      }

      const username = normalizeUsername(input.value);
      input.value = username;

      if (!usernamePattern.test(username)) {
        showMessage('Lo username deve contenere 3-24 caratteri: lettere, numeri, trattino o underscore.', 'error');
        return;
      }

      if (username === section?.dataset.currentUsername) {
        showMessage('Questo username è già impostato.', 'error');
        return;
      }

      button.disabled = true;
      showMessage('');

      try {
        const response = await fetch('/api/admin/users/username', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            userId: targetUserId,
            username
          })
        });
        const result = await response.json();

        if (!result.ok) {
          showMessage(result.error || 'Username non aggiornato.', 'error');
          button.disabled = false;
          return;
        }

        showMessage(result.message || 'Username aggiornato.', 'ok');
        await loadUser();
      } catch {
        showMessage('Errore di connessione.', 'error');
        button.disabled = false;
      }
    };

    detailNode?.addEventListener('change', (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      if (target.matches('[data-editorial-author-mode]')) {
        syncEditorialAuthorMode(getEditorialSection(target));
      }
    });

    detailNode?.addEventListener('input', (event) => {
      const target = event.target;

      if (!(target instanceof HTMLInputElement)) return;

      if (target.matches('[data-editorial-author-slug]')) {
        target.dataset.edited = '1';
        return;
      }

      if (!target.matches('[data-editorial-author-name], [data-editorial-author-nickname]')) {
        return;
      }

      const section = getEditorialSection(target);
      const slugInput = section?.querySelector('[data-editorial-author-slug]');

      if (!(slugInput instanceof HTMLInputElement) || slugInput.dataset.edited === '1') {
        return;
      }

      const nickname = section?.querySelector('[data-editorial-author-nickname]')?.value || '';
      const name = section?.querySelector('[data-editorial-author-name]')?.value || '';
      slugInput.value = slugifyAuthorName(nickname || name);
    });

    detailNode?.addEventListener('click', async (event) => {
      const target = event.target;
      const usernameButton = target instanceof Element
        ? target.closest('button[data-username-action]')
        : null;

      if (usernameButton) {
        await handleUsernameUpdate(usernameButton);
        return;
      }

      const editorialButton = target instanceof Element
        ? target.closest('button[data-editorial-action]')
        : null;

      if (editorialButton) {
        const handled = await handleEditorialAction(editorialButton);
        if (handled) return;
      }

      const badgeButton = target instanceof Element
        ? target.closest('button[data-badge-action]')
        : null;

      if (badgeButton) {
        const card = badgeButton.closest('[data-user-id]');
        const targetUserId = card?.dataset.userId;
        const action = badgeButton.dataset.badgeAction;
        const badgeKey = action === 'assign'
          ? card?.querySelector('[data-badge-select]')?.value
          : badgeButton.dataset.badgeKey;

        if (!targetUserId || !badgeKey || (action !== 'assign' && action !== 'remove')) {
          showMessage('Scegli un badge valido.', 'error');
          return;
        }

        const confirmation = badgeButton.dataset.confirm;
        if (confirmation && !window.confirm(confirmation)) {
          return;
        }

        badgeButton.disabled = true;
        showMessage('');

        try {
          const response = await fetch('/api/admin/users/badges/update', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              userId: targetUserId,
              badgeKey,
              action
            })
          });

          const result = await response.json();

          if (!result.ok) {
            showMessage(result.error || 'Gestione badge non riuscita.', 'error');
            badgeButton.disabled = false;
            return;
          }

          showMessage(result.message || 'Badge aggiornato.', 'ok');
          await loadUser();
        } catch {
          showMessage('Errore di connessione.', 'error');
          badgeButton.disabled = false;
        }

        return;
      }

      const button = target instanceof Element
        ? target.closest('button[data-role], button[data-status]')
        : null;
      if (!button) return;

      const card = button.closest('[data-user-id]');
      const targetUserId = card?.dataset.userId;
      const role = button.dataset.role;
      const status = button.dataset.status;

      if (!targetUserId || (!role && !status)) return;

      const confirmation = button.dataset.confirm;
      if (confirmation && !window.confirm(confirmation)) {
        return;
      }

      button.disabled = true;
      showMessage('');

      try {
        const response = await fetch('/api/admin/users/update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            userId: targetUserId,
            ...(role ? { role } : {}),
            ...(status ? { status } : {})
          })
        });

        const result = await response.json();

        if (!result.ok) {
          showMessage(result.error || 'Azione non riuscita.', 'error');
          button.disabled = false;
          return;
        }

        showMessage('Utente aggiornato.', 'ok');
        await loadUser();
      } catch {
        showMessage('Errore di connessione.', 'error');
        button.disabled = false;
      }
    });

    loadUser();
  </script>
</BaseLayout>
