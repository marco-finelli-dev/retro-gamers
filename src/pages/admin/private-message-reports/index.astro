---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommunityHero from '../../../components/community/CommunityHero.astro';
import CommunityLayout from '../../../components/community/CommunityLayout.astro';
import CommunitySidebarSection from '../../../components/community/CommunitySidebarSection.astro';
import { getUserSessionFromCookies } from '../../../lib/supabase/auth';
import '../../../styles/pages/admin-private-message-reports.css';

const title = 'Segnalazioni messaggi | Retro-Gamers.it';
const description = 'Pannello segnalazioni messaggi privati Retro-Gamers.it';
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = session.profile?.role === 'admin' || session.profile?.role === 'moderator';
---

<BaseLayout title={title} description={description}>
  <CommunityLayout class="admin-private-reports-page" sidebar={isStaff}>
    <Fragment slot="sidebar">
      {isStaff && (
        <CommunitySidebarSection title="Strumenti redazione">
          <div class="community-staff-links">
            <a class="community-action-link" href="/admin/comments/">Moderazione commenti</a>
            <a class="community-action-link" href="/admin/comment-reports/">Segnalazioni commenti</a>
            <a class="community-action-link" href="/admin/users/">Gestione utenti</a>
            <a class="community-action-link" href="/admin/private-message-reports/">Segnalazioni messaggi</a>
            <a class="community-action-link" href="/admin/ratings/">Voti lettori</a>
          </div>
        </CommunitySidebarSection>
      )}
    </Fragment>

    <CommunityHero
      kicker="Community"
      title="Segnalazioni messaggi"
      description="Controlla le conversazioni segnalate dai lettori e chiudi le verifiche già risolte."
    >
      <span slot="aside" class="community-soft-badge" data-private-reports-count>Caricamento...</span>
    </CommunityHero>

    <section class="community-card admin-private-reports-panel">
      <form class="admin-private-reports-filters" data-private-reports-filters>
        <label>
          <span>Stato</span>
          <select name="status">
            <option value="open">Aperte</option>
            <option value="resolved">Risolte</option>
            <option value="all">Tutte</option>
          </select>
        </label>

        <button type="submit">Filtra</button>
      </form>

      <div class="admin-private-reports-message" data-private-reports-message hidden></div>
      <div class="admin-private-reports-list" data-private-reports-list>
        <p class="admin-private-reports-empty">Caricamento segnalazioni...</p>
      </div>
    </section>
  </CommunityLayout>

  <script>
    const listNode = document.querySelector('[data-private-reports-list]');
    const countNode = document.querySelector('[data-private-reports-count]');
    const messageNode = document.querySelector('[data-private-reports-message]');
    const filtersForm = document.querySelector('[data-private-reports-filters]');

    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const formatDate = (value) => {
      if (!value) return 'Non disponibile';

      return new Intl.DateTimeFormat('it-IT', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }).format(new Date(value));
    };

    const getProfileName = (profile) =>
      profile?.display_name || profile?.username || 'Utente';

    const getProfileUrl = (profile) => {
      const username = String(profile?.username || '').trim().toLowerCase();

      if (!/^[a-z0-9_-]{3,24}$/.test(username)) {
        return '';
      }

      return `/utenti/${encodeURIComponent(username)}/`;
    };

    const showMessage = (text, type = 'ok') => {
      if (!messageNode) return;

      messageNode.textContent = text;
      messageNode.dataset.type = type;
      messageNode.hidden = !text;
    };

    const renderReport = (report) => {
      const reporter = report.reporter;
      const reportedUser = report.reportedUser;
      const reporterUrl = getProfileUrl(reporter);
      const reportedUrl = getProfileUrl(reportedUser);
      const messageBody = report.message?.body || 'Segnalazione sulla conversazione.';

      return `
        <article class="admin-private-report-card" data-report-id="${escapeHtml(report.id)}">
          <header>
            <div>
              <span>${escapeHtml(report.status === 'resolved' ? 'Risolta' : 'Aperta')}</span>
              <h2>${escapeHtml(getProfileName(reporter))} segnala ${escapeHtml(getProfileName(reportedUser))}</h2>
            </div>

            <time datetime="${escapeHtml(report.created_at)}">${escapeHtml(formatDate(report.created_at))}</time>
          </header>

          <div class="admin-private-report-card__users">
            ${reporterUrl ? `<a href="${escapeHtml(reporterUrl)}">Reporter: @${escapeHtml(reporter?.username || '')}</a>` : '<span>Reporter non disponibile</span>'}
            ${reportedUrl ? `<a href="${escapeHtml(reportedUrl)}">Segnalato: @${escapeHtml(reportedUser?.username || '')}</a>` : '<span>Utente segnalato non disponibile</span>'}
            <a href="/admin/users/">Gestione utenti</a>
          </div>

          <blockquote>${escapeHtml(messageBody)}</blockquote>

          ${report.reason ? `<p class="admin-private-report-card__reason">${escapeHtml(report.reason)}</p>` : ''}

          <footer>
            ${report.status !== 'resolved' ? '<button type="button" data-report-resolve>Segna come risolta</button>' : '<span>Segnalazione già risolta</span>'}
          </footer>
        </article>
      `;
    };

    const loadReports = async () => {
      if (!listNode) return;

      const params = new URLSearchParams(new FormData(filtersForm));

      try {
        const response = await fetch(`/api/admin/private-message-reports/list?${params.toString()}`);
        const result = await response.json();

        if (!response.ok || !result.ok) {
          listNode.innerHTML = `<p class="admin-private-reports-empty">${escapeHtml(result.error || 'Segnalazioni non disponibili.')}</p>`;
          if (countNode) countNode.textContent = 'Accesso non disponibile';
          return;
        }

        const reports = result.reports || [];
        if (countNode) {
          countNode.textContent = reports.length === 1
            ? '1 segnalazione'
            : `${reports.length} segnalazioni`;
        }

        if (reports.length === 0) {
          listNode.innerHTML = '<p class="admin-private-reports-empty">Nessuna segnalazione con questi filtri.</p>';
          return;
        }

        listNode.innerHTML = reports.map(renderReport).join('');
      } catch {
        listNode.innerHTML = '<p class="admin-private-reports-empty">Errore di connessione.</p>';
      }
    };

    filtersForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      showMessage('');
      loadReports();
    });

    listNode?.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-report-resolve]');
      if (!button) return;

      const card = button.closest('[data-report-id]');
      const reportId = card?.dataset.reportId;
      if (!reportId) return;

      button.disabled = true;

      try {
        const response = await fetch('/api/admin/private-message-reports/resolve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reportId }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          showMessage(result.error || 'Segnalazione non aggiornata.', 'error');
          button.disabled = false;
          return;
        }

        showMessage('Segnalazione risolta.', 'ok');
        loadReports();
      } catch {
        showMessage('Errore di connessione.', 'error');
        button.disabled = false;
      }
    });

    loadReports();
  </script>
</BaseLayout>
