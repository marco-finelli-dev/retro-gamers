---
import '../../styles/pages/user-profile.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UserAvatar from '../../components/account/UserAvatar.astro';
import CommunityLayout from '../../components/community/CommunityLayout.astro';
import PublicUserInterests from '../../components/community/PublicUserInterests.astro';
import {
  getCommentArticleHref,
  getCommentExcerpt,
  getPublicReaderProfile,
  getPublicUserUrl,
} from '../../lib/supabase/public-profiles';
import { getReaderBadgeImageSrcForBadge } from '../../lib/badges';
import { getCommunityRank } from '../../lib/community-rank';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';

const username = String(Astro.params.username || '');
const result = await getPublicReaderProfile(username);
const profile = result.profile;
const comments = result.comments;
const isUnavailable = !profile;
const viewerSession = await getUserSessionFromCookies(Astro.cookies);
const isViewerLoggedIn = Boolean(!viewerSession.error && viewerSession.user && viewerSession.profile);

if (isUnavailable) {
  Astro.response.status = 404;
}

const displayName = profile?.display_name || profile?.username || 'Lettore';
const pageTitle = isUnavailable
  ? 'Profilo non disponibile'
  : `${displayName} | Profilo lettore`;
const description = isUnavailable
  ? 'Profilo lettore non disponibile su Retro-Gamers.it.'
  : `Profilo pubblico di ${displayName} su Retro-Gamers.it.`;
const languageSwitch = profile
  ? getPublicUserUrl(profile.username, 'en')
  : '/en/';
const badge = profile?.user_badges;
const badgeLabel = badge?.label_it || badge?.label_en || profile?.badge_key || '';
const badgeImageSrc = getReaderBadgeImageSrcForBadge(badge || { key: profile?.badge_key || '' });
const isStaff = profile?.role === 'admin' || profile?.role === 'moderator';
const bio = profile?.bio?.trim() || '';
const isOwnProfile = Boolean(isViewerLoggedIn && viewerSession.user?.id === profile?.user_id);
const emptyCommentsText = 'Le prime memorie arriveranno quando questo lettore parteciperà alle discussioni.';
const emptyBioText = 'Questo lettore non ha ancora scritto una bio.';
const canSendPrivateMessage = Boolean(profile && isViewerLoggedIn && !isOwnProfile && profile.status === 'active');
const messageRecipientName = String(profile?.display_name || '').trim().split(/\s+/)[0] || '';
const privateMessageLabel = messageRecipientName
  ? `Scrivi a ${messageRecipientName}`
  : 'Scrivi un messaggio';
const privateMessageHref = profile
  ? `/account/messages/private/?to=${encodeURIComponent(profile.username)}`
  : '/account/messages/private/';
const loginPrivateMessageHref = profile
  ? `/account/login/?returnTo=${encodeURIComponent(getPublicUserUrl(profile.username, 'it'))}`
  : '/account/login/';
const dateFormatter = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const memberSinceFormatter = new Intl.DateTimeFormat('it-IT', {
  month: 'short',
  year: 'numeric',
});
const memberSince = profile?.created_at
  ? memberSinceFormatter.format(new Date(profile.created_at))
  : '—';
const visibleComments = comments.slice(0, 3);
const publicStats = [
  { label: 'Commenti', value: result.approvedCount },
  { label: 'Voti', value: result.ratingsCount },
  { label: 'Punti', value: result.communityPoints },
  { label: 'Like', value: result.likesReceived },
];
const pointsBadgeLabel = `Punti community: ${result.communityPoints}`;
const communityRank = getCommunityRank(result.communityPoints);
---

<BaseLayout
  title={pageTitle}
  description={description}
  languageSwitch={languageSwitch}
  noindex={isUnavailable}
>
  <CommunityLayout class="public-user-community-page">
    {isUnavailable ? (
      <section class="community-card public-user-panel public-user-panel--empty">
        <p class="public-user-kicker">Profilo lettore</p>
        <h1>Profilo non disponibile</h1>
        <p>Questo profilo non esiste oppure non è pubblico.</p>
        <a href="/">Torna alla home</a>
      </section>
    ) : (
      <>
        <section class="community-card public-user-profile-card" aria-labelledby="public-profile-title">
          <div class="public-user-profile-card__avatar">
            <span class="public-user-hero__avatar-frame">
              <UserAvatar
                name={displayName}
                src={profile.avatar_url}
                size="lg"
                label={`Avatar di ${displayName}`}
                class="public-user-hero__avatar"
              />

              <span
                class="community-points-badge public-user-hero__points-badge"
                aria-label={pointsBadgeLabel}
                title={pointsBadgeLabel}
              >
                {result.communityPoints}
              </span>
            </span>
          </div>

          <div class="public-user-profile-card__identity">
            <p class="public-user-kicker">Profilo lettore</p>
            <h1 id="public-profile-title">{displayName}</h1>
            <p class="public-user-profile-card__username">@{profile.username}</p>

            {(badgeLabel || isStaff) && (
              <div class="public-user-badges" aria-label="Badge e ruolo">
                {badgeLabel && (
                  <span class="public-user-badge">
                    {badgeImageSrc && <img src={badgeImageSrc} alt="" loading="lazy" decoding="async" />}
                    <span>{badgeLabel}</span>
                  </span>
                )}
                {isStaff && <span class="public-user-role-badge">Staff Retro-Gamers</span>}
              </div>
            )}
          </div>

          <div class="public-user-profile-card__meta" aria-label="Dettagli community">
            <div class="public-user-profile-card__facts">
              <p>
                <span>Membro dal</span>
                <strong>{memberSince}</strong>
              </p>
              <p>
                <span>Livello community</span>
                <strong>{communityRank.label}</strong>
              </p>
            </div>

            {!isOwnProfile && (
              <div class="public-user-actions">
                {canSendPrivateMessage ? (
                  <a href={privateMessageHref}>{privateMessageLabel}</a>
                ) : (
                  <a href={loginPrivateMessageHref}>Accedi per scrivere</a>
                )}
              </div>
            )}
          </div>
        </section>

        <section class="public-user-stat-strip" aria-label="Statistiche pubbliche">
          {publicStats.map((stat) => (
            <div class="public-user-stat">
              <span>{stat.label}</span>
              <strong>{stat.value}</strong>
            </div>
          ))}
        </section>

        <div class="public-user-layout">
          <div class="public-user-main-column">
            <section class="community-card public-user-panel public-user-about" aria-labelledby="public-user-about-title">
              <div class="public-user-section-heading">
                <p class="public-user-kicker">Profilo</p>
                <h2 id="public-user-about-title">Chi sono</h2>
              </div>

              {bio ? (
                <p class="public-user-bio">{bio}</p>
              ) : (
                <p class="public-user-empty">{emptyBioText}</p>
              )}
            </section>

            <section class="community-card public-user-panel public-user-memories" aria-labelledby="latest-comments-title">
              <div class="public-user-section-heading">
                <p class="public-user-kicker">Community</p>
                <h2 id="latest-comments-title">Ultime memorie</h2>
                <p>Commenti e ricordi lasciati accanto agli articoli.</p>
              </div>

              {visibleComments.length > 0 ? (
                <div class="public-user-comments">
                  {visibleComments.map((comment) => {
                    const commentHref = getCommentArticleHref(comment);

                    return (
                      <article class="public-user-comment">
                        <p>
                          <a class="public-user-comment__excerpt-link" href={commentHref}>
                            {getCommentExcerpt(comment.body)}
                          </a>
                        </p>

                        <footer>
                          <time datetime={comment.created_at || undefined}>
                            {comment.created_at
                              ? dateFormatter.format(new Date(comment.created_at))
                              : 'Data non disponibile'}
                          </time>

                          <a class="public-user-comment__article-link" href={commentHref}>
                            {comment.article_title || 'Apri articolo'}
                          </a>

                          <a class="public-user-comment__discussion-link" href={commentHref}>
                            Leggi
                          </a>
                        </footer>
                      </article>
                    );
                  })}
                </div>
              ) : (
                <p class="public-user-empty">
                  {emptyCommentsText}
                </p>
              )}
            </section>
          </div>

          <aside class="public-user-side-column" aria-label="Dati community">
            <PublicUserInterests interests={result.interests} lang="it" />
          </aside>
        </div>
      </>
    )}
  </CommunityLayout>
</BaseLayout>
