---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const posts = grouped.all.filter((post) => post.type === 'guide');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/guide/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/guides/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/guide/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/guide/',
  name: 'Guide al retro gaming',
  description: 'Guide pratiche per emulatori, hardware, supporti e sistemi originali, con procedure chiare per configurare, preservare e tornare a giocare.',
  lang: 'it',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Guide al retro gaming"
  description="Guide pratiche per emulatori, hardware, supporti e sistemi originali, con procedure chiare per configurare, preservare e tornare a giocare."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/guide/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Guide al retro gaming"
    eyebrow="Manuali e percorsi"
    description="Le guide di Retro-Gamers.it raccolgono procedure pratiche per usare emulatori, configurare hardware, gestire supporti e mantenere funzionanti sistemi e giochi del passato. Ogni guida nasce da prove reali e cerca di spiegare con chiarezza passaggi, strumenti e possibili problemi, senza dare per scontate conoscenze tecniche avanzate. Dalle Compact Flash per Amiga alla configurazione dei software moderni, l’obiettivo è aiutare appassionati e nuovi utenti a conservare, comprendere e utilizzare il proprio patrimonio videoludico."
    posts={posts}
    showFilters={false}
  />
</BaseLayout>
