---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/common/Pagination.astro';
import { urlFor } from '../../lib/image';
import { countryCodeToFlag, getAllCreators } from '../../lib/creators';
import { getAllPosts, groupPosts } from '../../lib/posts';
import { getCurrentPage, getPaginationUrl, paginateItems, PAGE_SIZE } from '../../lib/pagination';
import { getCreatorUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';
import '../../styles/pages/creators.css';

const creators = await getAllCreators();
const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const pageTitle = 'Creatori';
const pageDescription =
  'Designer, programmatori, compositori e figure creative che hanno segnato la storia videoludica.';
const {
  currentPage,
  totalPages,
  items: pageCreators,
} = paginateItems(creators, getCurrentPage(Astro.url), PAGE_SIZE);
const getCreatorsPageUrl = (pageNumber) => getPaginationUrl(Astro.url, pageNumber);
const pageUrl = currentPage > 1
  ? `https://www.retro-gamers.it${getCreatorsPageUrl(currentPage)}`
  : 'https://www.retro-gamers.it/creatori/';
const englishPageUrl = currentPage > 1
  ? `https://www.retro-gamers.it/en/creators/?page=${currentPage}`
  : 'https://www.retro-gamers.it/en/creators/';
const alternateLanguages = [
  { lang: 'it', url: pageUrl },
  { lang: 'en', url: englishPageUrl },
  { lang: 'x-default', url: pageUrl }
];

function getInitials(name = '') {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}

function getPortrait(creator, width = 520, height = 390) {
  if (!creator?.portrait?.asset) return '';

  return urlFor(creator.portrait)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(78)
    .auto('format')
    .url();
}

const structuredData = createCollectionPageStructuredData({
  url: pageUrl,
  name: pageTitle,
  description: pageDescription,
  lang: 'it',
  items: createListItems(pageCreators, (creator) => ({
    name: creator.name,
    url: getCreatorUrl(creator, 'it')
  }))
});
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  languageSwitch="/en/creators/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <div class="creators-page">
    <section class="creators-hero">
      <span class="creators-eyebrow">Storia videoludica</span>
      <h1>Creatori</h1>
      <p>
        Designer, programmatori, compositori, producer e figure creative che hanno dato forma
        all'immaginario dei videogiochi.
      </p>
    </section>

    {creators.length > 0 ? (
      <>
        <section class="creators-grid" aria-label="Elenco creatori">
          {pageCreators.map((creator) => {
            const portrait = getPortrait(creator);
            const knownFor = creator.knownFor?.slice(0, 3) || [];
            const flag = countryCodeToFlag(creator.countryCode);

            return (
              <article class="creator-card">
                <a class="creator-card__link" href={`/creatori/${creator.slug}/`}>
                  <span class="creator-card__portrait">
                    {portrait ? (
                      <img
                        src={portrait}
                        alt={creator.portrait?.alt || creator.name}
                        width="520"
                        height="390"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="creator-card__initials">{getInitials(creator.name) || 'RG'}</span>
                    )}
                  </span>

                  <span class="creator-card__body">
                    {creator.role && (
                      <span class="creator-card__role">{creator.role}</span>
                    )}

                    <h2>{creator.name}</h2>

                    {creator.country && (
                      <span class="creator-card__country">
                        {flag && <span aria-hidden="true">{flag}</span>}
                        {creator.country}
                      </span>
                    )}

                    {creator.shortBio && (
                      <p class="creator-card__bio">{creator.shortBio}</p>
                    )}

                    {knownFor.length > 0 && (
                      <ul class="creator-chip-list" aria-label="Opere principali">
                        {knownFor.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}

                    <span class="creator-card__action">Profilo</span>
                  </span>
                </a>
              </article>
            );
          })}
        </section>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          getPageUrl={getCreatorsPageUrl}
          ariaLabel="Paginazione creatori"
        />
      </>
    ) : (
      <p class="creators-empty">Nessun creator disponibile.</p>
    )}
  </div>
</BaseLayout>
