---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveCard from '../../components/archive/ArchiveCard.astro';
import Pagination from '../../components/common/Pagination.astro';
import { PortableText } from 'astro-portabletext';
import { urlFor } from '../../lib/image';
import {
  countryCodeToFlag,
  getArticlesReferencingCreator,
  getCreatorBySlug,
  mergeCreatorRelatedArticles
} from '../../lib/creators';
import { getAllPosts, groupPosts } from '../../lib/posts';
import { getCurrentPage, getPaginationUrl, paginateItems, PAGE_SIZE } from '../../lib/pagination';
import { getPlatformUrl } from '../../lib/routes';
import { getCompanyUrl } from '../../lib/companies';
import '../../styles/pages/creators.css';

const { slug } = Astro.params;

const creator = await getCreatorBySlug(slug);

if (!creator) {
  return Astro.rewrite('/404');
}

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const shortBio = creator.shortBio || '';
const profile = creator.profile || [];
const inverseRelatedArticles = await getArticlesReferencingCreator(creator._id, 'it');
const relatedArticles = mergeCreatorRelatedArticles(
  creator.relatedArticles || [],
  inverseRelatedArticles,
  'it'
);

const portrait = creator.portrait?.asset
  ? urlFor(creator.portrait)
      .width(720)
      .height(900)
      .fit('crop')
      .quality(78)
      .auto('format')
      .url()
  : '';

const pageTitle = creator.seoTitle || creator.name;
const countryFlag = countryCodeToFlag(creator.countryCode);
const pageDescription =
  creator.metaDescription ||
  shortBio ||
  `${creator.name}: profilo, opere e articoli collegati su Retro-Gamers.it.`;
const relatedCompanies = (creator.relatedCompanies || []).filter((company) =>
  company?.name && company?.slug && getCompanyUrl(company)
);
const {
  currentPage: relatedArticlesPage,
  totalPages: relatedArticlesTotalPages,
  items: relatedArticlesPageItems,
} = paginateItems(relatedArticles, getCurrentPage(Astro.url), PAGE_SIZE);
const getRelatedArticlesPageUrl = (pageNumber) => getPaginationUrl(Astro.url, pageNumber);

function getInitials(name = '') {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}

---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={pageTitle}
  description={pageDescription}
  image={portrait || '/og-image.jpg'}
  canonical={`https://www.retro-gamers.it/creatori/${creator.slug}/`}
  languageSwitch={`/en/creators/${creator.slug}/`}
  alternateLanguages={[
    { lang: 'it', url: `https://www.retro-gamers.it/creatori/${creator.slug}/` },
    { lang: 'en', url: `https://www.retro-gamers.it/en/creators/${creator.slug}/` }
  ]}
>
  <div class="creators-page creator-detail-page">
    <section class="creator-detail-hero">
      <figure class="creator-detail-hero__portrait">
        {portrait ? (
          <img
            src={portrait}
            alt={creator.portrait?.alt || creator.name}
            width="720"
            height="900"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <span class="creator-detail-hero__initials">{getInitials(creator.name) || 'RG'}</span>
        )}
      </figure>

      <div class="creator-detail-hero__content">
        <span class="creators-eyebrow">Profilo creator</span>
        <h1>{creator.name}</h1>

        {shortBio && (
          <p class="creator-detail-hero__intro">{shortBio}</p>
        )}

        <div class="creator-detail-hero__meta" aria-label="Dati creator">
          {creator.role && <span class="creator-chip">{creator.role}</span>}
          {creator.country && (
            <span class="creator-chip">
              {countryFlag && <span aria-hidden="true">{countryFlag}</span>}
              {creator.country}
            </span>
          )}
          {creator.activeYears && <span class="creator-chip">{creator.activeYears}</span>}
        </div>
      </div>
    </section>

    <section class="creator-detail-layout">
      <article class="creator-panel creator-profile">
        <span class="creator-section__eyebrow">Biografia</span>
        <h2>Profilo editoriale</h2>

        {profile.length > 0 ? (
          <div class="creator-profile__content">
            <PortableText value={profile} />
          </div>
        ) : shortBio ? (
          <p class="creator-panel__copy">{shortBio}</p>
        ) : (
          <p class="creator-panel__copy">Profilo in preparazione.</p>
        )}
      </article>

      <aside class="creator-facts" aria-label="Informazioni creator">
        {creator.knownFor?.length > 0 && (
          <section class="creator-fact-card">
            <h3>Opere principali</h3>
            <ul class="creator-chip-list">
              {creator.knownFor.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {relatedCompanies.length > 0 ? (
          <section class="creator-fact-card">
            <h3>Aziende</h3>
            <ul class="creator-chip-list">
              {relatedCompanies.map((company) => (
                <li>
                  <a href={getCompanyUrl(company, 'it')}>
                    {company.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : creator.companies?.length > 0 && (
          <section class="creator-fact-card">
            <h3>Aziende</h3>
            <ul class="creator-chip-list">
              {creator.companies.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {creator.relatedPlatforms?.length > 0 && (
          <section class="creator-fact-card">
            <h3>Piattaforme collegate</h3>
            <ul class="creator-platform-list">
              {creator.relatedPlatforms.map((platform) => {
                const logo = platform.logo?.asset
                  ? urlFor(platform.logo).width(360).height(140).fit('max').auto('format').url()
                  : '';
                const logoLight = platform.logoLight?.asset
                  ? urlFor(platform.logoLight).width(360).height(140).fit('max').auto('format').url()
                  : '';
                const primaryLogo = logo || logoLight;
                const themeLightLogo = logoLight || primaryLogo;
                const logoAlt = platform.logo?.alt || platform.logoLight?.alt || platform.name;

                return (
                  <li>
                    <a
                      class="creator-platform-card"
                      href={getPlatformUrl(platform, 'it')}
                      aria-label={platform.name}
                      title={platform.name}
                    >
                      {primaryLogo ? (
                        <span class="creator-platform-card__logo">
                          <img
                            src={primaryLogo}
                            alt={logoAlt}
                            class="creator-platform-logo creator-platform-logo--dark"
                            width="180"
                            height="70"
                            loading="lazy"
                            decoding="async"
                          />

                          <img
                            src={themeLightLogo}
                            alt=""
                            class="creator-platform-logo creator-platform-logo--light"
                            width="180"
                            height="70"
                            loading="lazy"
                            decoding="async"
                            aria-hidden="true"
                          />
                        </span>
                      ) : (
                        <span class="creator-platform-card__fallback">
                          {platform.name}
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}
      </aside>
    </section>

    {relatedArticles.length > 0 && (
      <section class="creator-related" aria-labelledby="creator-related-title">
        <div class="creator-related__header">
          <span class="creator-section__eyebrow">Archivio</span>
          <h2 id="creator-related-title">Articoli collegati</h2>
          <p>Recensioni, speciali, guide e approfondimenti collegati a {creator.name}.</p>
        </div>

        <div class="creator-related__grid">
          {relatedArticlesPageItems.map((post) => (
            <ArchiveCard post={post} lang="it" />
          ))}
        </div>

        <Pagination
          currentPage={relatedArticlesPage}
          totalPages={relatedArticlesTotalPages}
          getPageUrl={getRelatedArticlesPageUrl}
          ariaLabel="Paginazione articoli collegati"
        />
      </section>
    )}
  </div>
</BaseLayout>
