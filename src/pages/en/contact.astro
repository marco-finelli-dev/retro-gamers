---
import BaseLayout from '../../layouts/BaseLayout.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Contact"
  description="Contact Retro-Gamers.it for submissions, requests, collaborations or editorial information."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/contact/"
  lang="en"
>
  <main class="legal-page">
    <div class="container">

      <section class="legal-hero">
        <span>Contact</span>
        <h1>Contact</h1>
        <p>
          For submissions, requests, collaborations or editorial information.
        </p>
      </section>

      <article class="legal-content">

        <h2>Write to us</h2>

        <p>
          To contact Retro-Gamers.it, you can write to:
          <a href="mailto:guybrush@retro-gamers.it">guybrush@retro-gamers.it</a>.
        </p>

        <p>
          You can use this address to report errors, suggest topics, send feedback,
          request information about published content or propose collaborations.
        </p>

        <h2>Social media</h2>

        <p>
          Retro-Gamers.it is also present on social networks. You can follow us for
          updates, new articles, discussions and content related to the world of
          retro gaming.
        </p>

        <ul>
          <li>
            Facebook:
            <a href="https://www.facebook.com/profile.php?id=100063648424822" target="_blank" rel="noopener noreferrer">
              Retro-Gamers.it
            </a>
          </li>
          <li>
            Instagram:
            <a href="https://www.instagram.com/retro_gamers.it/" target="_blank" rel="noopener noreferrer">
              @retro_gamers.it
            </a>
          </li>
          <li>
            X:
            <a href="https://x.com/RetroGamers13" target="_blank" rel="noopener noreferrer">
              @RetroGamers13
            </a>
          </li>
        </ul>

        <h2>Privacy</h2>

        <p>
          Communications sent by email will be used exclusively to reply to the
          request received. For more information, please read the
          <a href="/en/privacy-policy/">Privacy Policy</a>.
        </p>

      </article>

    </div>
  </main>
</BaseLayout>