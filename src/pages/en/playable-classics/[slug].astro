---
import PlayableClassicDetail from '../../../components/playable-classics/PlayableClassicDetail.astro';
import { getPlayableClassicBySlug } from '../../../lib/playable-classics';

const { slug } = Astro.params;
const classic = await getPlayableClassicBySlug(slug || '', 'en');

if (!classic) {
  return Astro.rewrite('/404');
}
---

<PlayableClassicDetail classic={classic} lang="en" />
