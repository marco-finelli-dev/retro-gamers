---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'review');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/recensioni/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/reviews/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/recensioni/' }
];
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Reviews"
  description="Retro game reviews from Retro-Gamers.it in English."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/reviews/"
  lang="en"
  alternateLanguages={alternateLanguages}
>
  <ArchivePage
    title="Reviews"
    eyebrow="English edition"
    description="Reviews of classic games, consoles, arcade titles and home computer releases."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
