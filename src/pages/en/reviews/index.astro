---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const posts = grouped.english.filter((post) => post.type === 'review');
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Reviews"
  description="Retro game reviews from Retro-Gamers.it in English."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/reviews/"
  lang="en"
>
  <ArchivePage
    title="Reviews"
    eyebrow="English edition"
    description="Reviews of classic games, consoles, arcade titles and home computer releases."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>