---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/pagination';
import { getPostUrl } from '../../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'review');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/recensioni/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/reviews/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/recensioni/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/en/reviews/',
  name: 'Retro game reviews',
  description: 'Retro game reviews for consoles, arcades and home computers, combining critical analysis, historical context, scores and personal memories.',
  lang: 'en',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Retro game reviews"
  description="Retro game reviews for consoles, arcades and home computers, combining critical analysis, historical context, scores and personal memories."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/reviews/"
  lang="en"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Retro game reviews"
    eyebrow="English edition"
    description="Retro-Gamers.it reviews revisit the games that shaped consoles, home computers and arcades without relying on nostalgia alone. We examine gameplay, graphics, sound and historical context to understand what still works, what has aged and why each release mattered. From Amiga and Super Nintendo to the arcade and early PlayStation eras, every review combines personal memory, critical analysis and attention to the original versions."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
