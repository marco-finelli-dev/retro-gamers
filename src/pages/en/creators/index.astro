---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/common/Pagination.astro';
import { urlFor } from '../../../lib/image';
import { countryCodeToFlag, getAllCreators } from '../../../lib/creators';
import { getAllPosts, groupPosts } from '../../../lib/posts';
import { getCurrentPage, getPaginationUrl, paginateItems, PAGE_SIZE } from '../../../lib/pagination';
import '../../../styles/pages/creators.css';

const creators = await getAllCreators();
const allPosts = await getAllPosts();
const englishPosts = allPosts.filter((post) => post.language === 'en');
const grouped = groupPosts(englishPosts);

const pageTitle = 'Creators';
const pageDescription =
  'Designers, programmers, composers and creative figures who shaped video game history.';
const {
  currentPage,
  totalPages,
  items: pageCreators,
} = paginateItems(creators, getCurrentPage(Astro.url), PAGE_SIZE);
const getCreatorsPageUrl = (pageNumber) => getPaginationUrl(Astro.url, pageNumber);

function getInitials(name = '') {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}

function getPortrait(creator, width = 520, height = 390) {
  if (!creator?.portrait?.asset) return '';

  return urlFor(creator.portrait)
    .width(width)
    .height(height)
    .fit('crop')
    .quality(78)
    .auto('format')
    .url();
}
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  lang="en"
  title={pageTitle}
  description={pageDescription}
  canonical="https://www.retro-gamers.it/en/creators/"
  languageSwitch="/creatori/"
  alternateLanguages={[
    { lang: 'it', url: 'https://www.retro-gamers.it/creatori/' },
    { lang: 'en', url: 'https://www.retro-gamers.it/en/creators/' }
  ]}
>
  <div class="creators-page">
    <section class="creators-hero">
      <span class="creators-eyebrow">Video game history</span>
      <h1>Creators</h1>
      <p>
        Designers, programmers, composers, producers and creative voices who shaped the
        imagination of video games.
      </p>
    </section>

    {creators.length > 0 ? (
      <>
        <section class="creators-grid" aria-label="Creators list">
          {pageCreators.map((creator) => {
            const portrait = getPortrait(creator);
            const knownFor = creator.knownFor?.slice(0, 3) || [];
            const bio = creator.shortBioEn || creator.shortBio;
            const flag = countryCodeToFlag(creator.countryCode);
            const country = creator.countryEn || creator.country;

            return (
              <article class="creator-card">
                <a class="creator-card__link" href={`/en/creators/${creator.slug}/`}>
                  <span class="creator-card__portrait">
                    {portrait ? (
                      <img
                        src={portrait}
                        alt={creator.portrait?.alt || creator.name}
                        width="520"
                        height="390"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="creator-card__initials">{getInitials(creator.name) || 'RG'}</span>
                    )}
                  </span>

                  <span class="creator-card__body">
                    {creator.role && (
                      <span class="creator-card__role">{creator.role}</span>
                    )}

                    <h2>{creator.name}</h2>

                    {country && (
                      <span class="creator-card__country">
                        {flag && <span aria-hidden="true">{flag}</span>}
                        {country}
                      </span>
                    )}

                    {bio && (
                      <p class="creator-card__bio">{bio}</p>
                    )}

                    {knownFor.length > 0 && (
                      <ul class="creator-chip-list" aria-label="Known for">
                        {knownFor.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}

                    <span class="creator-card__action">Profile</span>
                  </span>
                </a>
              </article>
            );
          })}
        </section>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          lang="en"
          getPageUrl={getCreatorsPageUrl}
          ariaLabel="Creators pagination"
        />
      </>
    ) : (
      <p class="creators-empty">No creators available.</p>
    )}
  </div>
</BaseLayout>
