---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchiveCard from '../../../components/archive/ArchiveCard.astro';
import { PortableText } from 'astro-portabletext';
import { urlFor } from '../../../lib/image';
import { countryCodeToFlag, getCreatorBySlug, type CreatorCompanyRef } from '../../../lib/creators';
import { getAllPosts, groupPosts } from '../../../lib/posts';
import { getPlatformUrl } from '../../../lib/routes';
import '../../../styles/pages/creators.css';

const { slug } = Astro.params;

const creator = await getCreatorBySlug(slug);

if (!creator) {
  return Astro.rewrite('/404');
}

const allPosts = await getAllPosts();
const englishPosts = allPosts.filter((post) => post.language === 'en');
const grouped = groupPosts(englishPosts);

const shortBio = creator.shortBioEn || creator.shortBio || '';
const profile = creator.profileEn?.length > 0 ? creator.profileEn : creator.profile || [];
const relatedArticles = (creator.relatedArticles || [])
  .filter((post) => post.language === 'en')
  .sort((a, b) => {
    const aDate = new Date(a.publishedAt || 0).getTime();
    const bDate = new Date(b.publishedAt || 0).getTime();
    return bDate - aDate;
  });

const portrait = creator.portrait?.asset
  ? urlFor(creator.portrait)
      .width(720)
      .height(900)
      .fit('crop')
      .quality(78)
      .auto('format')
      .url()
  : '';

const pageTitle = creator.seoTitleEn || creator.seoTitle || creator.name;
const countryFlag = countryCodeToFlag(creator.countryCode);
const pageDescription =
  creator.metaDescriptionEn ||
  creator.metaDescription ||
  shortBio ||
  `${creator.name}: profile, works and related articles on Retro-Gamers.it.`;
const activeYears = creator.activeYearsEn || creator.activeYears;
const country = creator.countryEn || creator.country;
const relatedCompanies = (creator.relatedCompanies || []).filter((company) =>
  (company?.nameEn || company?.name) && company?.slug && getCompanyUrl(company)
);

function getInitials(name = '') {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}

function getCompanyTypes(company: CreatorCompanyRef) {
  return Array.isArray(company.type)
    ? company.type
    : company.type
      ? [company.type]
      : [];
}

function getCompanyUrl(company: CreatorCompanyRef) {
  const types = getCompanyTypes(company);

  if (types.includes('developer')) return `/en/developers/${company.slug}/`;
  if (types.includes('publisher')) return `/en/publishers/${company.slug}/`;

  if (types.includes('manufacturer')) {
    const typeMap = {
      console: 'consoles',
      computer: 'computers',
      arcade: 'arcade',
    };
    const platformType = company.platformType ? typeMap[company.platformType] : '';

    return platformType
      ? `/en/platforms/${platformType}/${company.slug}/`
      : '/en/platforms/';
  }

  return '';
}
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  lang="en"
  title={pageTitle}
  description={pageDescription}
  image={portrait || '/og-image.jpg'}
  canonical={`https://www.retro-gamers.it/en/creators/${creator.slug}/`}
  languageSwitch={`/creatori/${creator.slug}/`}
  alternateLanguages={[
    { lang: 'it', url: `https://www.retro-gamers.it/creatori/${creator.slug}/` },
    { lang: 'en', url: `https://www.retro-gamers.it/en/creators/${creator.slug}/` }
  ]}
>
  <main class="creators-page creator-detail-page">
    <section class="creator-detail-hero">
      <figure class="creator-detail-hero__portrait">
        {portrait ? (
          <img
            src={portrait}
            alt={creator.portrait?.alt || creator.name}
            width="720"
            height="900"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <span class="creator-detail-hero__initials">{getInitials(creator.name) || 'RG'}</span>
        )}
      </figure>

      <div class="creator-detail-hero__content">
        <span class="creators-eyebrow">Creator profile</span>
        <h1>{creator.name}</h1>

        {shortBio && (
          <p class="creator-detail-hero__intro">{shortBio}</p>
        )}

        <div class="creator-detail-hero__meta" aria-label="Creator data">
          {creator.role && <span class="creator-chip">{creator.role}</span>}
          {country && (
            <span class="creator-chip">
              {countryFlag && <span aria-hidden="true">{countryFlag}</span>}
              {country}
            </span>
          )}
          {activeYears && <span class="creator-chip">{activeYears}</span>}
        </div>
      </div>
    </section>

    <section class="creator-detail-layout">
      <article class="creator-panel creator-profile">
        <span class="creator-section__eyebrow">Biography</span>
        <h2>Editorial profile</h2>

        {profile.length > 0 ? (
          <div class="creator-profile__content">
            <PortableText value={profile} />
          </div>
        ) : shortBio ? (
          <p class="creator-panel__copy">{shortBio}</p>
        ) : (
          <p class="creator-panel__copy">Profile coming soon.</p>
        )}
      </article>

      <aside class="creator-facts" aria-label="Creator information">
        {creator.knownFor?.length > 0 && (
          <section class="creator-fact-card">
            <h3>Known for</h3>
            <ul class="creator-chip-list">
              {creator.knownFor.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {relatedCompanies.length > 0 ? (
          <section class="creator-fact-card">
            <h3>Companies</h3>
            <ul class="creator-chip-list">
              {relatedCompanies.map((company) => (
                <li>
                  <a href={getCompanyUrl(company)}>
                    {company.nameEn || company.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : creator.companies?.length > 0 && (
          <section class="creator-fact-card">
            <h3>Companies</h3>
            <ul class="creator-chip-list">
              {creator.companies.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {creator.relatedPlatforms?.length > 0 && (
          <section class="creator-fact-card">
            <h3>Related platforms</h3>
            <ul class="creator-platform-list">
              {creator.relatedPlatforms.map((platform) => (
                <li>
                  <a
                    class="creator-platform-card"
                    href={getPlatformUrl(platform, 'en')}
                    aria-label={platform.name}
                    title={platform.name}
                  >
                    {platform.logo?.asset ? (
                      <span class="creator-platform-card__logo">
                        <img
                          src={urlFor(platform.logo).width(360).height(140).fit('max').auto('format').url()}
                          alt={platform.logo?.alt || platform.name}
                          width="180"
                          height="70"
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                    ) : (
                      <span class="creator-platform-card__fallback">
                        {platform.name}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </section>

    {relatedArticles.length > 0 && (
      <section class="creator-related" aria-labelledby="creator-related-title">
        <div class="creator-related__header">
          <span class="creator-section__eyebrow">Archive</span>
          <h2 id="creator-related-title">Related articles</h2>
          <p>Reviews, features, guides and stories connected to {creator.name}.</p>
        </div>

        <div class="creator-related__grid">
          {relatedArticles.map((post) => (
            <ArchiveCard post={post} lang="en" />
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
