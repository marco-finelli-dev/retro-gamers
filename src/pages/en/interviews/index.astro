---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EditorialListing from '../../../components/archive/EditorialListing.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'interview');
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Interviews"
  description="Interviews from Retro-Gamers.it in English."
  image="/og-image.webp"
  canonical="https://www.retro-gamers.it/en/interviews/"
  lang="en"
>
  <EditorialListing
      desktopTitle="Interviews"
      desktopDescription="Conversations with creators, developers and people from the retro gaming scene."
    title="Interviews"
    eyebrow="English edition"
    description="Interviews and conversations with people from the world of retro gaming and classic computing."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>