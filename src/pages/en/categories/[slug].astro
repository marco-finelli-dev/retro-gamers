---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts } from '../../../lib/posts';

const { slug } = Astro.params;

const allPosts = await getAllPosts();

const englishPosts = allPosts.filter((post) =>
  post.language === 'en' &&
  (post.categories || []).some((category) => category.slug === slug)
);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const category = englishPosts
  .flatMap((post) => post.categories || [])
  .find((category) => category.slug === slug);

if (!category) {
  return Astro.rewrite('/404');
}

const title = category.nameEn || category.name || 'Category';

const description =
  `All Retro-Gamers.it articles about ${title.toLowerCase()}: reviews, features, guides, news and stories from the world of retro gaming.`;

const canonicalUrl =
  `https://www.retro-gamers.it/en/categories/${slug}/`;
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title={title}
  description={description}
  canonical={canonicalUrl}
  lang="en"
>
  <ArchivePage
    title={title}
    eyebrow="Category"
    description={description}
    posts={englishPosts}
    lang="en"
  />
</BaseLayout>
