---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/pagination';
import { getPostUrl } from '../../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'hardware');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/hardware/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/hardware/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/hardware/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/en/hardware/',
  name: 'Retro gaming hardware',
  description: 'Reviews, tests and guides to hardware, peripherals and accessories for classic systems, collectors and retro gaming enthusiasts.',
  lang: 'en',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Retro gaming hardware"
  description="Reviews, tests and guides to hardware, peripherals and accessories for classic systems, collectors and retro gaming enthusiasts."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/hardware/"
  lang="en"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Retro gaming hardware"
    eyebrow="English edition"
    description="The Hardware section collects reviews, tests and reports on computers, consoles, peripherals and accessories connected to retro gaming. We cover both original machines and modern solutions designed to preserve them, connect them to current displays or make them easier to use, distinguishing between technical analysis, direct experience and manufacturer information. From new systems inspired by classic hardware to peripherals, storage solutions and products for collectors, the aim is to explain what each device actually offers and who may find it useful."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
