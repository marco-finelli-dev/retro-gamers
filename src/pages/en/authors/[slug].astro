---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchiveCard from '../../../components/archive/ArchiveCard.astro';
import { PortableText } from 'astro-portabletext';
import { client } from '../../../lib/sanity';
import { urlFor } from '../../../lib/image';
import { getAllPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const authors = await client.fetch(`
    *[
      _type == "author" &&
      defined(slug.current) &&
      !(_id in path("drafts.**"))
    ]{
      "slug": slug.current
    }
  `);

  return authors.map((author) => ({
    params: {
      slug: author.slug,
    },
  }));
}

const { slug } = Astro.params;

const author = await client.fetch(`
  *[
    _type == "author" &&
    slug.current == $slug
  ][0]{
    _id,
    name,
    nickname,
    displayName,
    "slug": slug.current,
    bio,
    bioEn,
    role,
    email,
    showEmail,
    website,
    facebook,
    twitter,
    youtube,
    twitch,

    image {
      alt,
      asset->{ url }
    },

    cover {
      alt,
      asset->{ url }
    }
  }
`, { slug });

if (!author) {
  return Astro.rewrite('/404');
}

const displayName =
  author.displayName === 'nickname' && author.nickname
    ? author.nickname
    : author.name;

const roleLabels = {
  editor: 'Editor',
  contributor: 'Contributor',
  guest: 'Guest'
};

const roleLabel = roleLabels[author.role] || 'Author';

const authorCover = author.cover?.asset
  ? urlFor(author.cover)
      .width(1600)
      .height(600)
      .fit('crop')
      .quality(76)
      .auto('format')
      .url()
  : '';

const authorAvatar = author.image?.asset
  ? urlFor(author.image)
      .width(320)
      .height(320)
      .fit('crop')
      .quality(78)
      .auto('format')
      .url()
  : '';

const posts = await client.fetch(`
  *[
    _type == "article" &&
    defined(slug.current) &&
    author._ref == $authorId &&
    language == "en" &&
    !(_id in path("drafts.**"))
  ] | order(coalesce(publishedAt, _createdAt) desc) {
    _id,
    title,
    excerpt,
    subtitle,
    type,
    language,
    publishedAt,
    "slug": slug.current,

    featuredImage {
      alt,
      asset->{ url }
    },

    categories[]->{
      "name": coalesce(nameEn, name, titleEn, title),
      "nameEn": coalesce(nameEn, titleEn),
      "slug": slug.current
    },

    platforms[]->{
      name,
      "slug": slug.current
    },

    gameInfo {
      releaseYear,
      cover {
        alt,
        asset->{ url }
      }
    },

    rating {
      overall
    }
  }
`, { authorId: author._id });

const allPosts = await getAllPosts();
const englishPosts = allPosts.filter((post) => post.language === 'en');

const englishReviews = englishPosts.filter((post) => post.type === 'review');
const englishNews = englishPosts.filter((post) => post.type === 'news');

const pageTitle = `Articles by ${displayName}`;

const pageDescription =
  `${displayName} on Retro-Gamers International: articles, reviews, guides and features from the world of retro gaming.`;

const pageImage =
  authorCover ||
  authorAvatar ||
  '/og-image.jpg';

const bioBlocks =
  author.bioEn?.length > 0
    ? author.bioEn
    : author.bio;

const socials = [
  author.showEmail && author.email && {
    label: 'Email',
    url: `mailto:${author.email}`,
    icon: '/icons/social/mail.svg'
  },
  author.website && {
    label: 'Website',
    url: author.website,
    icon: '/icons/social/link.svg'
  },
  author.facebook && {
    label: 'Facebook',
    url: author.facebook,
    icon: '/icons/social/facebook.svg'
  },
  author.twitter && {
    label: 'X',
    url: author.twitter,
    icon: '/icons/social/x.svg'
  },
  author.youtube && {
    label: 'YouTube',
    url: author.youtube,
    icon: '/icons/social/youtube.svg'
  },
  author.twitch && {
    label: 'Twitch',
    url: author.twitch,
    icon: '/icons/social/twitch.svg'
  }
].filter(Boolean);
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={`https://www.retro-gamers.it/en/authors/${slug}/`}
  lang="en"
>

  <main class="author-page">

    <section class="author-hero">

      {authorCover && (
        <div class="author-hero__cover">
          <img
            src={authorCover}
            alt={author.cover?.alt || displayName}
            width="1600"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <div class="author-hero__profile">

        {authorAvatar && (
          <figure class="author-hero__avatar">
            <img
              src={authorAvatar}
              alt={author.image?.alt || displayName}
              width="320"
              height="320"
              loading="eager"
              decoding="async"
            />
          </figure>
        )}

        <div class="author-hero__content">

          <h1>{displayName}</h1>

          {author.nickname && author.displayName !== 'nickname' && (
            <p class="author-hero__nickname">
              aka {author.nickname}
            </p>
          )}

          <div class="author-hero__actions">

            <div class="author-hero__badges">
              <span>{roleLabel}</span>
            </div>

            {socials.length > 0 && (
              <div class="author-hero__socials" aria-label="Author contacts">
                {socials.map((item) => {
                  const isMail = item.url.startsWith('mailto:');

                  return (
                    <a
                      href={item.url}
                      target={isMail ? undefined : '_blank'}
                      rel={isMail ? undefined : 'noopener noreferrer'}
                      aria-label={item.label}
                      title={item.label}
                    >
                      <span
                        class="author-hero__social-icon"
                        style={`--icon: url('${item.icon}')`}
                        aria-hidden="true"
                      ></span>

                      <span class="sr-only">{item.label}</span>
                    </a>
                  );
                })}
              </div>
            )}

          </div>

        </div>

      </div>

    </section>

    <section class="author-layout">

      <article class="author-bio">
        <span>Bio</span>

        <h2>Author profile</h2>

        {bioBlocks?.length > 0 ? (
          <div class="author-bio__content">
            <PortableText value={bioBlocks} />
          </div>
        ) : (
          <div class="author-bio__content">
            <p>Author on Retro-Gamers International.</p>
          </div>
        )}
      </article>

      <aside class="author-stats">
        <h2>Activity</h2>

        <dl>
          <div>
            <dt>Articles</dt>
            <dd>{posts.length}</dd>
          </div>

          <div>
            <dt>Role</dt>
            <dd>{roleLabel}</dd>
          </div>
        </dl>
      </aside>

    </section>

    <section class="author-posts">

      <div class="author-posts__header">
        <span>Archive</span>
        <h2>Published articles</h2>
      </div>

      {posts.length > 0 ? (
        <>
          <div class="author-posts__grid" data-author-posts-grid>
            {posts.map((post, index) => (
              <div
                class="author-posts__item"
                data-author-post-item
                hidden={index >= 12}
              >
                <ArchiveCard post={post} lang="en" />
              </div>
            ))}
          </div>

          {posts.length > 12 && (
            <div class="author-posts__more">
              <button type="button" data-author-posts-more>
                Show more articles
              </button>
            </div>
          )}
        </>
      ) : (
        <p class="author-posts__empty">
          No articles published yet.
        </p>
      )}

    </section>

  </main>

  <script is:inline>
    (() => {
      const button = document.querySelector('[data-author-posts-more]');
      const items = Array.from(document.querySelectorAll('[data-author-post-item]'));

      if (!button || items.length === 0) return;

      let visible = 12;
      const step = 6;

      button.addEventListener('click', () => {
        visible += step;

        items.forEach((item, index) => {
          item.hidden = index >= visible;
        });

        if (visible >= items.length) {
          button.hidden = true;
        }
      });
    })();
  </script>

</BaseLayout>