---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/common/Pagination.astro';
import { urlFor } from '../../../lib/image';
import {
  companyTypeLabels,
  getAllCompanies,
  getCompanyDescription,
  getCompanyName,
  getCompanyUrl,
} from '../../../lib/companies';
import { getAllPosts, groupPosts } from '../../../lib/posts';
import { getCurrentPage, getPaginationUrl, paginateItems, PAGE_SIZE } from '../../../lib/pagination';
import '../../../styles/pages/companies.css';

const companies = await getAllCompanies();
const allPosts = await getAllPosts();
const englishPosts = allPosts.filter((post) => post.language === 'en');
const grouped = groupPosts(englishPosts);

const pageTitle = 'Companies';
const pageDescription =
  'Software houses, publishers, developers and manufacturers that shaped video game history.';
const {
  currentPage,
  totalPages,
  items: pageCompanies,
} = paginateItems(companies, getCurrentPage(Astro.url), PAGE_SIZE);
const getCompaniesPageUrl = (pageNumber) => getPaginationUrl(Astro.url, pageNumber);

function getLogo(image, width = 420) {
  if (!image?.asset) return '';

  return urlFor(image)
    .width(width)
    .quality(82)
    .auto('format')
    .url();
}

function getTypeLabels(company) {
  return (company.type || [])
    .filter((type) => companyTypeLabels.en[type])
    .map((type) => companyTypeLabels.en[type]);
}
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  lang="en"
  title={pageTitle}
  description={pageDescription}
  canonical="https://www.retro-gamers.it/en/companies/"
  languageSwitch="/aziende/"
  alternateLanguages={[
    { lang: 'it', url: 'https://www.retro-gamers.it/aziende/' },
    { lang: 'en', url: 'https://www.retro-gamers.it/en/companies/' }
  ]}
>
  <div class="companies-page">
    <section class="companies-hero">
      <span class="companies-eyebrow">Company archive</span>
      <h1>Companies</h1>
      <p>
        Software houses, publishers, developers and manufacturers that shaped
        the imagination and technology of video games.
      </p>
    </section>

    {companies.length > 0 ? (
      <>
        <section class="companies-grid" aria-label="Companies list">
          {pageCompanies.map((company) => {
            const name = getCompanyName(company, 'en');
            const description = getCompanyDescription(company, 'en');
            const logo = getLogo(company.logo);
            const logoLight = getLogo(company.logoLight) || logo;
            const primaryLogo = logo || logoLight;
            const typeLabels = getTypeLabels(company);

            return (
              <article class="company-card">
                <a class="company-card__link" href={getCompanyUrl(company, 'en')}>
                  <span class="company-card__visual">
                    {primaryLogo ? (
                      <span class="company-logo-wrap">
                        <img
                          src={primaryLogo}
                          alt={company.logo?.alt || company.logoLight?.alt || name}
                          class="company-logo company-logo--dark"
                          width="420"
                          height="180"
                          loading="lazy"
                          decoding="async"
                        />
                        <img
                          src={logoLight}
                          alt=""
                          class="company-logo company-logo--light"
                          width="420"
                          height="180"
                          loading="lazy"
                          decoding="async"
                          aria-hidden="true"
                        />
                      </span>
                    ) : (
                      <span class="company-card__fallback">{name}</span>
                    )}
                  </span>

                  <span class="company-card__body">
                    {typeLabels.length > 0 && (
                      <span class="company-card__types">{typeLabels.join(' · ')}</span>
                    )}

                    <h2>{name}</h2>

                    {description && (
                      <p>{description}</p>
                    )}

                    <span class="company-card__action">Company profile</span>
                  </span>
                </a>
              </article>
            );
          })}
        </section>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          lang="en"
          getPageUrl={getCompaniesPageUrl}
          ariaLabel="Companies pagination"
        />
      </>
    ) : (
      <p class="companies-empty">No companies available.</p>
    )}
  </div>
</BaseLayout>
