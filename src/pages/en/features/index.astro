---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/pagination';
import { getPostUrl } from '../../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);
const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'feature');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/speciali/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/features/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/speciali/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/en/features/',
  name: 'Video game features and retrospectives',
  description: 'Features and retrospectives on video games, creators, studios and digital culture, exploring the history and evolution of the medium.',
  lang: 'en',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Video game features and retrospectives"
  description="Features and retrospectives on video games, creators, studios and digital culture, exploring the history and evolution of the medium."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/features/"
  lang="en"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Video game features and retrospectives"
    eyebrow="Editorial"
    description="Retro-Gamers.it features explore the people, studios and turning points that shaped video game culture. We reconstruct the development of series, genres and technologies through sources, first-hand accounts and historical context, including stories often overlooked by mainstream histories. From major industry figures to creative scenes built around consoles and home computers, each article examines the medium with attention to memory, cultural relevance and lasting influence."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
