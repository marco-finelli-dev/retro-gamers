---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/pagination';
import { getPostUrl } from '../../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'memories');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/memories/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/memories/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/memories/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/en/memories/',
  name: 'Memories',
  description: 'Personal memories and retro gaming stories from Retro-Gamers.it in English.',
  lang: 'en',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Memories"
  description="Personal memories and retro gaming stories from Retro-Gamers.it in English."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/memories/"
  lang="en"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Memories"
    eyebrow="English edition"
    description="Personal stories, memories and fragments of gaming life from the past."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
