---
import CommunitySurveyPage from '../../../../components/community/CommunitySurveyPage.astro';
import CommunitySurveyRouteError from '../../../../components/community/CommunitySurveyRouteError.astro';
import { loadCommunitySurveyPage } from '../../../../lib/community-survey-page';

const result = await loadCommunitySurveyPage(Astro.params.slug || '', 'en');
Astro.response.status = result.status;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

{result.status === 200
  ? <CommunitySurveyPage survey={result.survey} lang="en" />
  : <CommunitySurveyRouteError status={result.status} lang="en" />}
