---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/pagination';
import { getPostUrl } from '../../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'news');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/news/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/news/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/news/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/en/news/',
  name: 'Retro gaming news',
  description: 'News on retro games, new releases, hardware, restorations, events and preservation projects for consoles, arcades and home computers.',
  lang: 'en',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Retro gaming news"
  description="News on retro games, new releases, hardware, restorations, events and preservation projects for consoles, arcades and home computers."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/news/"
  lang="en"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Retro gaming news"
    eyebrow="English edition"
    description="Retro-Gamers.it news follows what is happening today around the games and systems of the past, including new releases for classic hardware, reissues, restorations, events, preservation projects and independent productions. We select stories with a clear connection to consoles, home computers, arcades and video game culture, adding context rather than simply repeating announcements. From new cartridges and remakes to modern peripherals and archival discoveries, this section shows how retro gaming continues to evolve through communities, research and new creative work."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
