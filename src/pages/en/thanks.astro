---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/thanks.css';

const title = 'Thank you for your support | Retro-Gamers.it';
const description = 'Thank you for supporting Retro-Gamers.it, an independent editorial project dedicated to videogame history and retro culture.';
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.retro-gamers.it/en/thanks/"
  lang="en"
  noindex={true}
>
  <main class="thanks-page">
    <section class="thanks-card">
      <span class="thanks-card__eyebrow">Support received</span>

      <h1>Thank you.</h1>

      <p>
        Your contribution helps Retro-Gamers.it remain an independent editorial project,
        free from invasive advertising and built with care around videogame history,
        classic computers, consoles and retro culture.
      </p>

      <p>
        Every gesture, even a small one, means more time for research, writing,
        site maintenance, images, archives, translations and new stories to publish.
      </p>

      <div class="thanks-card__divider"></div>

      <span class="thanks-card__eyebrow">Grazie</span>

      <p lang="it">
        Grazie per aver sostenuto Retro-Gamers.it. Il tuo contributo aiuta a mantenere vivo
        un progetto editoriale indipendente dedicato alla storia dei videogiochi e alla cultura retro,
        senza pubblicità invasiva o clickbait.
      </p>

      <div class="thanks-card__actions">
        <a href="/en/">Back to home</a>
        <a href="/grazie/">Versione italiana</a>
        <a href="/en/archive/">Explore the archive</a>
      </div>
    </section>
  </main>
</BaseLayout>