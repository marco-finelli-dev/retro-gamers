---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CommunityHero from '../../../../components/community/CommunityHero.astro';
import CommunityLayout from '../../../../components/community/CommunityLayout.astro';
import CommunitySidebarSection from '../../../../components/community/CommunitySidebarSection.astro';
import { getUserSessionFromCookies, isStaffProfile } from '../../../../lib/supabase/auth';
import { isNewsletterUnavailableError } from '../../../../lib/supabase/newsletter';
import { supabaseAdmin } from '../../../../lib/supabase/server';
import '../../../../styles/pages/admin-newsletter.css';

type CountResult = {
  value: number | null;
  error: string;
  unavailable: boolean;
};

type NewsletterAdminSubscriber = {
  email: string;
  status: string | null;
  language: string | null;
  source: string | null;
  created_at: string | null;
  consent_at: string | null;
  confirmed_at: string | null;
  unsubscribed_at: string | null;
};

const title = 'Newsletter | Retro-Gamers.it';
const description = 'Read-only monitoring for Retro-Gamers.it newsletter subscribers.';
const session = await getUserSessionFromCookies(Astro.cookies);
const isStaff = isStaffProfile(session.profile);
const statusParam = Astro.url.searchParams.get('status') || 'all';
const languageParam = Astro.url.searchParams.get('language') || 'all';
const statusOptions = new Set(['all', 'active', 'pending', 'unsubscribed']);
const languageOptions = new Set(['all', 'it', 'en']);
const statusFilter = statusOptions.has(statusParam) ? statusParam : 'all';
const languageFilter = languageOptions.has(languageParam) ? languageParam : 'all';

const staffLinks = [
  { href: '/en/admin/', label: 'Editorial dashboard' },
  { href: '/en/admin/comments/', label: 'Comment moderation' },
  { href: '/en/admin/comment-reports/', label: 'Comment reports' },
  { href: '/en/admin/users/', label: 'Users' },
  { href: '/en/admin/private-message-reports/', label: 'Message reports' },
  { href: '/en/admin/ratings/', label: 'Reader ratings' },
  { href: '/en/admin/newsletter/', label: 'Newsletter' },
];

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const emptyCount = (): CountResult => ({ value: null, error: '', unavailable: false });

const safeCount = async (callback: () => PromiseLike<{ count: number | null; error: any }>): Promise<CountResult> => {
  try {
    const { count, error } = await callback();

    if (error) {
      const unavailable = isNewsletterUnavailableError(error);

      return {
        value: null,
        error: unavailable ? 'Data unavailable' : 'Count unavailable',
        unavailable,
      };
    }

    return { value: count ?? 0, error: '', unavailable: false };
  } catch {
    return { value: null, error: 'Count unavailable', unavailable: false };
  }
};

const formatCount = (count: CountResult) =>
  count.value === null ? '—' : new Intl.NumberFormat('en-US').format(count.value);

const formatDate = (value?: string | null) => {
  if (!value) {
    return '—';
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return '—';
  }

  return dateFormatter.format(date);
};

const getStatusLabel = (status?: string | null) => {
  switch (status) {
    case 'active':
      return 'Active';
    case 'pending':
      return 'Pending';
    case 'unsubscribed':
      return 'Unsubscribed';
    default:
      return status || '—';
  }
};

const getLanguageLabel = (language?: string | null) =>
  language === 'en' ? 'EN' : language === 'it' ? 'IT' : '—';

let activeCount = emptyCount();
let pendingCount = emptyCount();
let unsubscribedCount = emptyCount();
let totalCount = emptyCount();
let italianCount = emptyCount();
let englishCount = emptyCount();
let subscribers: NewsletterAdminSubscriber[] = [];
let newsletterError = '';
let newsletterUnavailable = false;

if (isStaff) {
  [
    activeCount,
    pendingCount,
    unsubscribedCount,
    totalCount,
    italianCount,
    englishCount,
  ] = await Promise.all([
    safeCount(() =>
      supabaseAdmin
        .from('newsletter_subscribers')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'active')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('newsletter_subscribers')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'pending')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('newsletter_subscribers')
        .select('id', { count: 'exact', head: true })
        .eq('status', 'unsubscribed')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('newsletter_subscribers')
        .select('id', { count: 'exact', head: true })
    ),
    safeCount(() =>
      supabaseAdmin
        .from('newsletter_subscribers')
        .select('id', { count: 'exact', head: true })
        .eq('language', 'it')
    ),
    safeCount(() =>
      supabaseAdmin
        .from('newsletter_subscribers')
        .select('id', { count: 'exact', head: true })
        .eq('language', 'en')
    ),
  ]);

  newsletterUnavailable = [
    activeCount,
    pendingCount,
    unsubscribedCount,
    totalCount,
    italianCount,
    englishCount,
  ].some((count) => count.unavailable);

  if (!newsletterUnavailable) {
    let query = supabaseAdmin
      .from('newsletter_subscribers')
      .select('email, status, language, source, created_at, consent_at, confirmed_at, unsubscribed_at')
      .order('created_at', { ascending: false })
      .limit(200);

    if (statusFilter !== 'all') {
      query = query.eq('status', statusFilter);
    }

    if (languageFilter !== 'all') {
      query = query.eq('language', languageFilter);
    }

    const { data, error } = await query;

    if (error) {
      newsletterUnavailable = isNewsletterUnavailableError(error);
      newsletterError = newsletterUnavailable
        ? 'Newsletter data is unavailable. Check that the newsletter-v1.sql schema has been applied.'
        : 'Could not load newsletter subscribers.';
    } else {
      subscribers = (data ?? []) as NewsletterAdminSubscriber[];
    }
  } else {
    newsletterError = 'Newsletter data is unavailable. Check that the newsletter-v1.sql schema has been applied.';
  }
}

const statCards = [
  { label: 'Active', count: activeCount },
  { label: 'Pending', count: pendingCount },
  { label: 'Unsubscribed', count: unsubscribedCount },
  { label: 'Total subscribers', count: totalCount },
  { label: 'IT', count: italianCount },
  { label: 'EN', count: englishCount },
];
---

<BaseLayout title={title} description={description} lang="en">
  <CommunityLayout class="admin-newsletter-page" sidebar={isStaff}>
    <Fragment slot="sidebar">
      {isStaff && (
        <CommunitySidebarSection title="Editorial tools">
          <div class="community-staff-links">
            {staffLinks.map((link) => (
              <a class="community-action-link" href={link.href}>{link.label}</a>
            ))}
          </div>
        </CommunitySidebarSection>
      )}
    </Fragment>

    {isStaff ? (
      <>
        <CommunityHero
          kicker="Retro-Gamers.it"
          title="Newsletter subscribers"
          description="Monitor subscribers, confirmations and unsubscriptions for the newsletter."
        >
          <span slot="aside" class="community-soft-badge">Read-only</span>
        </CommunityHero>

        <section class="admin-newsletter-stats" aria-label="Newsletter statistics">
          {statCards.map((card) => (
            <article class="community-card admin-newsletter-stat">
              <span>{card.label}</span>
              <strong>{formatCount(card.count)}</strong>
              {card.count.error && <small>{card.count.error}</small>}
            </article>
          ))}
        </section>

        <section class="community-card admin-newsletter-panel">
          <form class="admin-newsletter-filters" method="get">
            <label>
              <span>Status</span>
              <select name="status">
                <option value="all" selected={statusFilter === 'all'}>All</option>
                <option value="active" selected={statusFilter === 'active'}>Active</option>
                <option value="pending" selected={statusFilter === 'pending'}>Pending</option>
                <option value="unsubscribed" selected={statusFilter === 'unsubscribed'}>Unsubscribed</option>
              </select>
            </label>

            <label>
              <span>Language</span>
              <select name="language">
                <option value="all" selected={languageFilter === 'all'}>All</option>
                <option value="it" selected={languageFilter === 'it'}>IT</option>
                <option value="en" selected={languageFilter === 'en'}>EN</option>
              </select>
            </label>

            <div class="admin-newsletter-filters__actions">
              <button type="submit">Filter</button>
              <a href="/en/admin/newsletter/">Reset</a>
            </div>
          </form>

          {newsletterError ? (
            <p class="admin-newsletter-empty">{newsletterError}</p>
          ) : subscribers.length > 0 ? (
            <div class="admin-newsletter-table-wrap">
              <table class="admin-newsletter-table">
                <thead>
                  <tr>
                    <th scope="col">Email</th>
                    <th scope="col">Status</th>
                    <th scope="col">Language</th>
                    <th scope="col">Source</th>
                    <th scope="col">Subscribed</th>
                    <th scope="col">Confirmed</th>
                    <th scope="col">Unsubscribed</th>
                  </tr>
                </thead>
                <tbody>
                  {subscribers.map((subscriber) => (
                    <tr>
                      <td data-label="Email">{subscriber.email}</td>
                      <td data-label="Status">
                        <span class="admin-newsletter-status" data-status={subscriber.status || ''}>
                          {getStatusLabel(subscriber.status)}
                        </span>
                      </td>
                      <td data-label="Language">{getLanguageLabel(subscriber.language)}</td>
                      <td data-label="Source">{subscriber.source || '—'}</td>
                      <td data-label="Subscribed">{formatDate(subscriber.consent_at || subscriber.created_at)}</td>
                      <td data-label="Confirmed">{formatDate(subscriber.confirmed_at)}</td>
                      <td data-label="Unsubscribed">{formatDate(subscriber.unsubscribed_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="admin-newsletter-empty">No subscribers found with these filters.</p>
          )}
        </section>
      </>
    ) : (
      <>
        <CommunityHero
          kicker="Retro-Gamers.it"
          title="Editorial access"
          description="This page is reserved for Retro-Gamers.it staff."
        />

        <section class="community-card">
          <div class="community-staff-links">
            <a class="community-action-link" href="/en/account/login/">Sign in</a>
          </div>
        </section>
      </>
    )}
  </CommunityLayout>
</BaseLayout>
