---
import '../../../styles/pages/user-profile.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UserAvatar from '../../../components/account/UserAvatar.astro';
import CommunityHero from '../../../components/community/CommunityHero.astro';
import CommunityLayout from '../../../components/community/CommunityLayout.astro';
import {
  getCommentArticleHref,
  getCommentExcerpt,
  getPublicReaderProfile,
  getPublicUserUrl,
} from '../../../lib/supabase/public-profiles';
import { getReaderBadgeImageSrcForBadge } from '../../../lib/badges';
import { getUserSessionFromCookies } from '../../../lib/supabase/auth';

const username = String(Astro.params.username || '');
const result = await getPublicReaderProfile(username);
const profile = result.profile;
const comments = result.comments;
const isUnavailable = !profile;
const viewerSession = await getUserSessionFromCookies(Astro.cookies);
const isViewerLoggedIn = Boolean(!viewerSession.error && viewerSession.user && viewerSession.profile);

if (isUnavailable) {
  Astro.response.status = 404;
}

const displayName = profile?.display_name || profile?.username || 'Reader';
const pageTitle = isUnavailable
  ? 'Profile unavailable'
  : `${displayName} | Reader profile`;
const description = isUnavailable
  ? 'Reader profile unavailable on Retro-Gamers.it.'
  : `Public reader profile for ${displayName} on Retro-Gamers.it.`;
const languageSwitch = profile
  ? getPublicUserUrl(profile.username, 'it')
  : '/';
const badge = profile?.user_badges;
const badgeLabel = badge?.label_en || badge?.label_it || profile?.badge_key || '';
const badgeImageSrc = getReaderBadgeImageSrcForBadge(badge || { key: profile?.badge_key || '' });
const isStaff = profile?.role === 'admin' || profile?.role === 'moderator';
const bio = profile?.bio?.trim() || '';
const isOwnProfile = Boolean(isViewerLoggedIn && viewerSession.user?.id === profile?.user_id);
const canSendPrivateMessage = Boolean(profile && isViewerLoggedIn && !isOwnProfile && profile.status === 'active');
const privateMessageHref = profile
  ? `/account/messages/private/?to=${encodeURIComponent(profile.username)}`
  : '/account/messages/private/';
const loginPrivateMessageHref = profile
  ? `/account/login/?returnTo=${encodeURIComponent(getPublicUserUrl(profile.username, 'en'))}`
  : '/account/login/';
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={pageTitle}
  description={description}
  lang="en"
  languageSwitch={languageSwitch}
  noindex={isUnavailable}
>
  <CommunityLayout class="public-user-community-page">
    {isUnavailable ? (
      <section class="community-card public-user-panel public-user-panel--empty">
        <p class="public-user-kicker">Reader profile</p>
        <h1>Profile unavailable</h1>
        <p>This profile does not exist or is not public.</p>
        <a href="/en/">Back to home</a>
      </section>
    ) : (
      <>
        <CommunityHero
          class="public-user-hero"
          kicker="Reader profile"
          title={displayName}
          description={`@${profile.username}`}
        >
          <Fragment slot="leading">
            <UserAvatar
              name={displayName}
              src={profile.avatar_url}
              size="lg"
              label={`Avatar for ${displayName}`}
              class="public-user-hero__avatar"
            />
          </Fragment>

          <div class="public-user-badges" aria-label="Badges and role">
            {badgeLabel && (
              <span class="public-user-badge">
                {badgeImageSrc && <img src={badgeImageSrc} alt="" loading="lazy" decoding="async" />}
                <span>{badgeLabel}</span>
              </span>
            )}
            {isStaff && <span>Retro-Gamers staff</span>}
          </div>

          {bio && <p class="public-user-bio">{bio}</p>}

          <Fragment slot="aside">
            <div class="public-user-stat">
              <span>Published comments</span>
              <strong>{result.approvedCount}</strong>
            </div>

            {!isOwnProfile && (
              <div class="public-user-actions">
                {canSendPrivateMessage ? (
                  <a href={privateMessageHref}>Send a message</a>
                ) : (
                  <a href={loginPrivateMessageHref}>Log in to send a message</a>
                )}
              </div>
            )}
          </Fragment>
        </CommunityHero>

        <section class="community-card public-user-panel" aria-labelledby="latest-comments-title">
          <div class="public-user-section-heading">
            <p class="public-user-kicker">Community</p>
            <h2 id="latest-comments-title">Latest comments</h2>
          </div>

          {comments.length > 0 ? (
            <div class="public-user-comments">
              {comments.map((comment) => {
                const commentHref = getCommentArticleHref(comment);

                return (
                  <article class="public-user-comment">
                    <p>
                      <a class="public-user-comment__excerpt-link" href={commentHref}>
                        {getCommentExcerpt(comment.body)}
                      </a>
                    </p>

                    <footer>
                      <time datetime={comment.created_at || undefined}>
                        {comment.created_at
                          ? dateFormatter.format(new Date(comment.created_at))
                          : 'Date unavailable'}
                      </time>

                      <a href={commentHref}>
                        {comment.article_title || 'Open article'}
                      </a>
                    </footer>
                  </article>
                );
              })}
            </div>
          ) : (
            <p class="public-user-empty">
              This reader has not published any comments yet.
            </p>
          )}
        </section>
      </>
    )}
  </CommunityLayout>
</BaseLayout>
