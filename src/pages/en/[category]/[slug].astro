---
import Layout from '../../../layouts/BaseLayout.astro';
import ArticlePage from '../../../components/article/ArticlePage.astro';

import { client } from '../../../lib/sanity';
import { getAllPosts, groupPosts, getRelatedPosts } from '../../../lib/posts';

/* ========================
   PARAMS
======================== */

const { category, slug } = Astro.params;

const categoryToType = {
  reviews: 'review',
  news: 'news',
  features: 'feature',
  guides: 'guide',
  memories: 'memories',
  interviews: 'interview',
  hardware: 'hardware',
  articles: 'article'
};

const typeToItalianCategory = {
  review: 'recensioni',
  news: 'news',
  feature: 'speciali',
  guide: 'guide',
  memories: 'memories',
  interview: 'interviste',
  hardware: 'hardware',
  article: 'articoli'
};

const expectedType = category
  ? categoryToType[category]
  : null;

if (!expectedType) {
  return Astro.rewrite('/404');
}

/* ========================
   READING TIME
======================== */

function getPlainTextFromContent(content = []) {
  return content
    .flatMap((block) => {
      if (block._type === 'block') {
        return block.children?.map((child) => child.text || '') || [];
      }

      if (block._type === 'asideBox') {
        return block.content
          ?.filter((inner) => inner._type === 'block')
          .flatMap((inner) =>
            inner.children?.map((child) => child.text || '') || []
          ) || [];
      }

      return [];
    })
    .join(' ');
}

function getReadingTime(content = []) {
  const text = getPlainTextFromContent(content);
  const words = text.trim().split(/\s+/).filter(Boolean).length;

  return Math.max(1, Math.ceil(words / 220));
}

/* ========================
   POST
======================== */

const post = await client.fetch(`
*[
  _type == "article" &&
  slug.current == $slug &&
  type == $expectedType &&
  language == "en"
][0]{
  _id,
  _type,
  type,
  language,

  title,
  subtitle,
  excerpt,
  seoTitle,

  "slug": slug.current,
  publishedAt,
  seriesOrder,
  seriesLabel,

  translationOf->{
    _id,
    type,
    title,
    "slug": slug.current,
    language
  },

  author->{
    name,
    nickname,
    displayName,
    "slug": slug.current
  },

  featuredImage {
    alt,
    asset->{ url }
  },

  categories[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  platforms[]->{
    name,
    "slug": slug.current,
    platformType,
    badgeLabel,

    manufacturer->{
      name,
      nameEn,
      "slug": slug.current
    }
  },

  genres[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  developers[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  publishers[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  manufacturer[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  modes[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  series[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  editorialSeries[]->{
    _id,
    name,
    nameEn,
    "slug": slug.current
  },

  gameInfo {
    releaseYear,
    mediaFormat,
    cover {
      alt,
      asset->{ url }
    }
  },

  rating,

  monetization {
    isAffiliate,
    productType,
    affiliateUrl,
    affiliateLabel,
    affiliateDescription,
    priceLabel,
    disclaimer,
    priority
  },

  content[]{
    ...,

    markDefs[]{
      ...,

      _type == "internalLink" => {
        ...,
        reference->{
          type,
          language,
          "slug": slug.current
        }
      },

      _type == "taxonomyLink" => {
        ...,
        reference->{
          name,
          nameEn,
          "slug": slug.current
        }
      }
    },

    _type == "image" => {
      ...,
      asset->{ url }
    },

    _type == "imageRow" => {
      ...,
      images[]{
        ...,
        image{
          asset->{ url }
        }
      }
    },

    _type == "asideBox" => {
      ...,
      content[]{
        ...,

        markDefs[]{
          ...,

          _type == "internalLink" => {
            ...,
            reference->{
              type,
              language,
              "slug": slug.current
            }
          },

          _type == "taxonomyLink" => {
            ...,
            reference->{
              name,
              nameEn,
              "slug": slug.current
            }
          }
        },

        _type == "image" => {
          ...,
          asset->{ url }
        },

        _type == "imageRow" => {
          ...,
          images[]{
            ...,
            image{
              asset->{ url }
            }
          }
        }
      }
    },

    _type == "video" => {
      url
    }
  }
}
`, {
  slug,
  expectedType
});

if (!post) {
  return Astro.rewrite('/404');
}

/* ========================
   HYDRATION
======================== */

const readingTime = getReadingTime(post.content);

const hydratedPost = {
  ...post,
  language: post.language || 'en',
  readingTime
};

/* ========================
   SERIES
======================== */

const seriesId = hydratedPost.editorialSeries?.[0]?._id || null;

const seriesPosts = seriesId
  ? await client.fetch(`
    *[
      _type == "article" &&
      defined(slug.current) &&
      !(_id in path("drafts.**")) &&
      language == "en" &&
      references($seriesId)
    ] | order(coalesce(seriesOrder, 999) asc, coalesce(publishedAt, _createdAt) asc) {
      _id,
      type,
      language,
      title,
      subtitle,
      "slug": slug.current,
      publishedAt,
      seriesOrder,
      seriesLabel
    }
  `, { seriesId })
  : [];

/* ========================
   COMMENTS
======================== */

const comments = await client.fetch(`
  *[
    _type == "comment" &&
    article._ref == $postId &&
    status == "approved" &&
    language == "en"
  ] | order(createdAt asc) {
    _id,
    authorName,
    body,
    createdAt,
    isHighlighted,
    editorReply,
    editorReplies[]{
      authorName,
      authorRole,
      body,
      createdAt
    },
    likes,
    dislikes,
    language,
    parentComment->{
      _id,
      authorName
    }
  }
`, {
  postId: post._id
});

/* ========================
   GLOBAL DATA
======================== */

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const relatedPosts = getRelatedPosts(hydratedPost, grouped.allLanguages, 3);

const siteUrl = 'https://www.retro-gamers.it';

const pageTitle =
  post.seoTitle ||
  post.title;

const pageDescription =
  post.excerpt ||
  post.subtitle ||
  'Features, reviews and stories from the world of retro gaming.';

const pageImage =
  post.featuredImage?.asset?.url ||
  post.gameInfo?.cover?.asset?.url ||
  '/og-image.jpg';

const canonicalUrl =
  `${siteUrl}/en/${category}/${slug}/`;

const italianCategory =
  post.translationOf?.type
    ? typeToItalianCategory[post.translationOf.type]
    : null;

const italianUrl =
  post.translationOf?.slug && italianCategory
    ? `${siteUrl}/${italianCategory}/${post.translationOf.slug}/`
    : `${siteUrl}/`;

const alternateLanguages = [
  {
    lang: 'en',
    url: canonicalUrl
  },
  ...(post.translationOf?.slug && italianCategory
    ? [
        {
          lang: 'it',
          url: italianUrl
        },
        {
          lang: 'x-default',
          url: italianUrl
        }
      ]
    : [
        {
          lang: 'x-default',
          url: canonicalUrl
        }
      ])
];
---

<Layout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  type="article"
  publishedAt={post.publishedAt}
  lang="en"
  alternateLanguages={alternateLanguages}
>

  <ArticlePage
    post={hydratedPost}
    relatedPosts={relatedPosts}
    seriesPosts={seriesPosts}
    comments={comments}
    languageSwitch={
      post.translationOf?.slug && italianCategory
        ? { url: `/${italianCategory}/${post.translationOf.slug}/` }
        : null
    }
  />

</Layout>