---
import Layout from '../../../layouts/BaseLayout.astro';
import ArticlePage from '../../../components/article/ArticlePage.astro';

import { client } from '../../../lib/sanity';
import { getArticleRoutePosts, getRelatedPosts } from '../../../lib/posts';
import {
  attachApprovedCommentCounts,
  getApprovedCommentCountMap
} from '../../../lib/supabase/comment-counts';
import { getUserSessionFromCookies } from '../../../lib/supabase/auth';
import { getNewsletterSubscriptionForUser } from '../../../lib/supabase/newsletter';
import {
  getCreatorRefsFromPortableText,
  getCreatorsReferencingArticle,
  mergeCreatorRefs
} from '../../../lib/creators';

/* ========================
   PARAMS
======================== */

const { category, slug } = Astro.params;

const categoryToType = {
  reviews: 'review',
  news: 'news',
  features: 'feature',
  guides: 'guide',
  memories: 'memories',
  interviews: 'interview',
  hardware: 'hardware',
  articles: 'article'
};

const typeToItalianCategory = {
  review: 'recensioni',
  news: 'news',
  feature: 'speciali',
  guide: 'guide',
  memories: 'memories',
  interview: 'interviste',
  hardware: 'hardware',
  article: 'articoli'
};

const expectedType = category
  ? categoryToType[category]
  : null;

if (!expectedType) {
  return Astro.rewrite('/404');
}

/* ========================
   READING TIME
======================== */

function getPlainTextFromContent(content = []) {
  return content
    .flatMap((block) => {
      if (block._type === 'block') {
        return block.children?.map((child) => child.text || '') || [];
      }

      if (block._type === 'asideBox') {
        return block.content
          ?.filter((inner) => inner._type === 'block')
          .flatMap((inner) =>
            inner.children?.map((child) => child.text || '') || []
          ) || [];
      }

      return [];
    })
    .join(' ');
}

function getReadingTime(content = []) {
  const text = getPlainTextFromContent(content);
  const words = text.trim().split(/\s+/).filter(Boolean).length;

  return Math.max(1, Math.ceil(words / 220));
}

function getEditorialPageTitle(post, fallbackSlug = '') {
  const seoTitle = String(post?.seoTitle || '').trim();
  const title = String(post?.title || '').trim();
  const slugValue = String(fallbackSlug || post?.slug || '').trim();
  const looksLikeSlug =
    seoTitle &&
    (seoTitle === slugValue ||
      (/^[a-z0-9]+(?:-[a-z0-9]+)+$/i.test(seoTitle) &&
        !/[\s:,.!?'"’“”]/.test(seoTitle)));

  return looksLikeSlug
    ? title || seoTitle
    : seoTitle || title;
}

/* ========================
   POST
======================== */

const post = await client.fetch(`
*[
  _type == "article" &&
  slug.current == $slug &&
  type == $expectedType &&
  language == "en"
][0]{
  _id,
  _type,
  type,
  language,

  title,
  subtitle,
  excerpt,
  cardExcerpt,
  seoTitle,

  "slug": slug.current,
  publishedAt,
  seriesOrder,
  seriesLabel,

  translationOf->{
    _id,
    type,
    title,
    "slug": slug.current,
    language
  },

  author->{
    name,
    nickname,
    displayName,
    role,
    "slug": slug.current,
    image {
      alt,
      asset->{ url }
    }
  },

  featuredImage {
    alt,
    asset->{ url }
  },

  categories[]->{
    "name": coalesce(name, title),
    "nameEn": coalesce(nameEn, titleEn),
    "slug": slug.current
  },

  platforms[]->{
    name,
    "slug": slug.current,
    platformType,
    badgeLabel,

    manufacturer->{
      name,
      nameEn,
      "slug": slug.current
    }
  },

  genres[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  developers[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  publishers[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  manufacturer[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  modes[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  series[]->{
    name,
    nameEn,
    "slug": slug.current
  },

  editorialSeries[]->{
    _id,
    name,
    nameEn,
    "slug": slug.current
  },

  creators[]->{
    _id,
    name,
    "slug": slug.current,
    role,
    roleEn,
    portrait {
      alt,
      asset->{ url }
    }
  },

  gameInfo {
    releaseYear,
    mediaFormat,
    cover {
      alt,
      asset->{ url }
    }
  },

  rating,
  pros,
  cons,

  monetization {
    isAffiliate,
    productType,
    affiliateUrl,
    affiliateLabel,
    affiliateDescription,
    priceLabel,
    disclaimer,
    priority
  },

  content[]{
    ...,

    markDefs[]{
      ...,

            _type == "internalLink" => {
        ...,
        reference->{
          _type,
          type,
          language,
          "slug": slug.current
        }
      },

      _type == "platformLink" => {
        ...,
        reference->{
          name,
          nameEn,
          "slug": slug.current,
          platformType,
          manufacturer->{
            name,
            nameEn,
            "slug": slug.current
          }
        }
      },

      _type == "taxonomyLink" => {
        ...,
        reference->{
          name,
          nameEn,
          "slug": slug.current
        }
      },

      _type == "creatorLink" => {
        ...,
        reference->{
          _id,
          name,
          "slug": slug.current,
          role,
          roleEn,
          portrait {
            alt,
            asset->{ url }
          }
        }
      },

      _type == "companyLink" => {
        ...,
        reference->{
          name,
          nameEn,
          "slug": slug.current,
          type
        }
      }
    },

_type == "image" => {
  ...,
  alt,
  caption,
  displayMode,
  isWide,
  asset->{ url }
},

_type == "imageRow" => {
  ...,
  layout,
  groupCaption,
  images[]{
    ...,
    alt,
    caption,
    displayMode,
    image{
      asset->{ url }
    }
  }
},

    _type == "asideBox" => {
      ...,
      content[]{
        ...,

        markDefs[]{
          ...,

                   _type == "internalLink" => {
            ...,
            reference->{
              _type,
              type,
              language,
              "slug": slug.current
            }
          },

          _type == "platformLink" => {
            ...,
            reference->{
              name,
              nameEn,
              "slug": slug.current,
              platformType,
              manufacturer->{
                name,
                nameEn,
                "slug": slug.current
              }
            }
          },

          _type == "taxonomyLink" => {
            ...,
            reference->{
              name,
              nameEn,
              "slug": slug.current
            }
          },

          _type == "creatorLink" => {
            ...,
            reference->{
              _id,
              name,
              "slug": slug.current,
              role,
              roleEn,
              portrait {
                alt,
                asset->{ url }
              }
            }
          },

          _type == "companyLink" => {
            ...,
            reference->{
              name,
              nameEn,
              "slug": slug.current,
              type
            }
          }
        },

_type == "image" => {
  ...,
  alt,
  caption,
  displayMode,
  isWide,
  asset->{ url }
},

_type == "imageRow" => {
  ...,
  layout,
  groupCaption,
  images[]{
    ...,
    alt,
    caption,
    displayMode,
    image{
      asset->{ url }
    }
  }
}
      }
    },

    _type == "video" => {
      url
    }
  }
}
`, {
  slug,
  expectedType
});

if (!post) {
  return Astro.rewrite('/404');
}

const publishedPostId = post._id.replace('drafts.', '');
const portableTextCreators = getCreatorRefsFromPortableText(post.content);

/* ========================
   ITALIAN TRANSLATION
======================== */

const directItalianTranslation =
  post.translationOf?.language === 'it'
    ? post.translationOf
    : null;

const reverseItalianTranslationPromise = directItalianTranslation
  ? Promise.resolve(null)
  : client.fetch(`
    *[
      _type == "article" &&
      defined(slug.current) &&
      coalesce(language, "it") == "it" &&
      translationOf._ref == $postId
    ][0]{
      _id,
      type,
      title,
      "slug": slug.current,
      language
    }
	  `, {
    postId: publishedPostId
  });

/* ========================
   HYDRATION
======================== */

const readingTime = getReadingTime(post.content);

/* ========================
   SERIES
======================== */

const seriesId = post.editorialSeries?.[0]?._id || null;

const seriesPostsPromise = seriesId
  ? client.fetch(`
    *[
      _type == "article" &&
      defined(slug.current) &&
      !(_id in path("drafts.**")) &&
      language == "en" &&
      references($seriesId)
    ] | order(coalesce(seriesOrder, 999) asc, coalesce(publishedAt, _createdAt) asc) {
      _id,
      type,
      language,
      title,
      subtitle,
      "slug": slug.current,
      publishedAt,
      seriesOrder,
      seriesLabel
    }
	  `, { seriesId })
  : Promise.resolve([]);

/* ========================
   COMMENTS
======================== */

const commentsPromise = client.fetch(`
  *[
    _type == "comment" &&
    article._ref == $postId &&
    status == "approved" &&
    language == "en"
  ] | order(createdAt asc) {
    _id,
    authorName,
    body,
    createdAt,
    isHighlighted,
    editorReply,
    editorReplies[]{
      authorName,
      authorRole,
      body,
      createdAt
    },
    likes,
    dislikes,
    language,
    parentComment->{
      _id,
      authorName
    }
  }
`, {
  postId: post._id
});

/* ========================
   GLOBAL DATA
======================== */

const [
  inverseCreators,
  reverseItalianTranslation,
  seriesPosts,
  comments,
  articleRoutePosts,
  viewerSession
] = await Promise.all([
  getCreatorsReferencingArticle(publishedPostId),
  reverseItalianTranslationPromise,
  seriesPostsPromise,
  commentsPromise,
  getArticleRoutePosts(),
  getUserSessionFromCookies(Astro.cookies)
]);

const italianTranslation =
  directItalianTranslation ||
  reverseItalianTranslation;

const articleCreators = mergeCreatorRefs(
  post.creators,
  inverseCreators,
  portableTextCreators
);

let hydratedPost = {
  ...post,
  creators: articleCreators,
  language: post.language || 'en',
  readingTime
};

const englishPosts = articleRoutePosts.filter(
  (post) => post.language === 'en'
);

const englishReviews = englishPosts.filter(
  (post) => post.type === 'review'
);

const englishNews = englishPosts.filter(
  (post) => post.type === 'news'
);

const relatedPosts = getRelatedPosts(hydratedPost, articleRoutePosts, 3);
const commentCountMap = await getApprovedCommentCountMap([hydratedPost, ...relatedPosts], 'en');
hydratedPost = attachApprovedCommentCounts([hydratedPost], commentCountMap, 'en')[0];
const relatedPostsWithCommentCounts = attachApprovedCommentCounts(
  relatedPosts,
  commentCountMap,
  'en'
);

let hideNewsletterPromo = false;

if (!viewerSession.error && viewerSession.user) {
  const newsletter = await getNewsletterSubscriptionForUser(
    viewerSession.user.id,
    viewerSession.user.email
  );

  hideNewsletterPromo = newsletter.status === 'active' || newsletter.status === 'pending';
}

const siteUrl = 'https://www.retro-gamers.it';

const pageTitle = getEditorialPageTitle(post, slug);

const pageDescription =
  post.excerpt ||
  post.subtitle ||
  'Features, reviews and stories from the world of retro gaming.';

const pageImage =
  post.featuredImage?.asset?.url ||
  post.gameInfo?.cover?.asset?.url ||
  '/og-image.jpg';

const canonicalUrl =
  `${siteUrl}/en/${category}/${slug}/`;

const italianCategory =
  italianTranslation?.type
    ? typeToItalianCategory[italianTranslation.type]
    : null;

const italianUrl =
  italianTranslation?.slug && italianCategory
    ? `${siteUrl}/${italianCategory}/${italianTranslation.slug}/`
    : `${siteUrl}/`;

const alternateLanguages = [
  {
    lang: 'en',
    url: canonicalUrl
  },
  ...(italianTranslation?.slug && italianCategory
    ? [
        {
          lang: 'it',
          url: italianUrl
        },
        {
          lang: 'x-default',
          url: italianUrl
        }
      ]
    : [
        {
          lang: 'x-default',
          url: canonicalUrl
        }
      ])
];
---

<Layout
  reviews={englishReviews}
  news={englishNews}
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={canonicalUrl}
  type="article"
  publishedAt={post.publishedAt}
  lang="en"
  alternateLanguages={alternateLanguages}
>

  <ArticlePage
    post={hydratedPost}
    relatedPosts={relatedPostsWithCommentCounts}
    seriesPosts={seriesPosts}
    comments={comments}
    hideNewsletterPromo={hideNewsletterPromo}
    languageSwitch={
      italianTranslation?.slug && italianCategory
        ? { url: `/${italianCategory}/${italianTranslation.slug}/` }
        : null
    }
  />

</Layout>
