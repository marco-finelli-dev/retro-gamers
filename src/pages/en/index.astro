---
import BaseLayout from '../../layouts/BaseLayout.astro';

import Hero from '../../components/home/Hero.astro';
import Latest from '../../components/home/Latest.astro';
import Reviews from '../../components/home/Reviews.astro';
import EditorialHub from '../../components/home/EditorialHub.astro';
import ArchiveStrip from '../../components/home/ArchiveStrip.astro';
import Interviews from '../../components/home/Interviews.astro';
import Hardware from '../../components/home/Hardware.astro';
import CommunityStrip from '../../components/home/CommunityStrip.astro';
import PlayToday from '../../components/home/PlayToday.astro';
import NewsletterPromo from '../../components/newsletter/NewsletterPromo.astro';

import '../../styles/pages/home.css';

import { getActiveFeaturedPost, getAllPosts } from '../../lib/posts';
import {
  attachApprovedCommentCounts,
  getApprovedCommentCountMap
} from '../../lib/supabase/comment-counts';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';
import { getNewsletterSubscriptionForUser } from '../../lib/supabase/newsletter';
import { getLatestCommunityComments } from '../../lib/supabase/community-hub';
import { getHomePlayableClassics } from '../../lib/playable-classics';
import { getHomeEmulatorTools } from '../../lib/emulator-tools';

const allPosts = await getAllPosts();

const englishPosts = allPosts
  .filter((post) => post.language === 'en')
  .map((post) => ({
    ...post,
    score: post.rating?.overall ?? 0
  }))
  .sort((a, b) => {
    return (
      new Date(b.publishedAt || 0).getTime() -
      new Date(a.publishedAt || 0).getTime()
    );
  });

const headerReviews = englishPosts.filter((post) => post.type === 'review');
const headerNews = englishPosts.filter((post) => post.type === 'news');
const featuredPost = getActiveFeaturedPost(englishPosts);

const usedIds = new Set();

const hasImage = (post) => Boolean(post.featuredImage?.asset?.url);

const getPostKey = (post) =>
  post?._id?.replace(/^drafts\./, '') || post?.slug || '';

const takeUnused = (source, limit, options = {}) => {
  const requireImage = options.requireImage ?? false;
  const picked = [];

  for (const post of source) {
    const key = getPostKey(post);

    if (!key) continue;
    if (usedIds.has(key)) continue;
    if (requireImage && !hasImage(post)) continue;

    picked.push(post);
    usedIds.add(key);

    if (picked.length >= limit) break;
  }

  return picked;
};

const archiveEvergreenTypes = new Set([
  'review',
  'memories',
  'guide',
  'interview',
  'article',
  'feature',
  'special'
]);

const isArchiveEvergreenCandidate = (post) =>
  archiveEvergreenTypes.has(post.type || '') && post.type !== 'news';

const isOlderThanDays = (post, days) => {
  if (!post.publishedAt) return false;

  const publishedTime = new Date(post.publishedAt).getTime();

  if (!Number.isFinite(publishedTime)) return false;

  const cutoffTime = Date.now() - days * 24 * 60 * 60 * 1000;

  return publishedTime < cutoffTime;
};

const takeArchivePosts = (source, limit) => {
  const evergreen = takeUnused(
    source.filter((post) => isArchiveEvergreenCandidate(post) && isOlderThanDays(post, 14)),
    limit,
    { requireImage: true }
  );

  if (evergreen.length >= limit) return evergreen;

  return [
    ...evergreen,
    ...takeUnused(
      source.filter(isArchiveEvergreenCandidate),
      limit - evergreen.length,
      { requireImage: true }
    )
  ];
};

const hero = [];

if (featuredPost) {
  const featuredKey = getPostKey(featuredPost);

  hero.push(featuredPost);

  if (featuredKey) {
    usedIds.add(featuredKey);
  }
}

const remainingHeroSlots = Math.max(0, 4 - hero.length);

if (remainingHeroSlots > 0) {
  hero.push(...takeUnused(
    englishPosts.filter(hasImage),
    remainingHeroSlots,
    { requireImage: true }
  ));
}

const reviewsSource = englishPosts
  .filter((post) => post.type === 'review')
  .sort((a, b) => {
    const scoreDiff = (b.score || 0) - (a.score || 0);

    if (scoreDiff !== 0) return scoreDiff;

    return (
      new Date(b.publishedAt || 0).getTime() -
      new Date(a.publishedAt || 0).getTime()
    );
  });

const reviews = takeUnused(reviewsSource, 6, {
  requireImage: true
});

const guides = takeUnused(
  englishPosts.filter((post) => post.type === 'guide'),
  3,
  { requireImage: false }
);

const specials = takeUnused(
  englishPosts.filter((post) =>
    ['feature', 'special', 'article'].includes(post.type || '')
  ),
  5,
  { requireImage: true }
);

const memories = takeUnused(
  englishPosts.filter((post) => post.type === 'memories'),
  4,
  { requireImage: true }
);

const interviews = takeUnused(
  englishPosts.filter((post) => post.type === 'interview'),
  3
);

const archive = takeArchivePosts(englishPosts, 4);

const hardware = takeUnused(
  englishPosts.filter((post) => post.type === 'hardware'),
  4,
  { requireImage: true }
);

const news = englishPosts.filter((post) => post.type === 'news');

const latest = takeUnused(englishPosts, 6, {
  requireImage: true
});

const homeCommentCountMap = await getApprovedCommentCountMap(
  [
    ...hero,
    ...reviews,
    ...guides,
    ...specials,
    ...memories,
    ...interviews,
    ...archive,
    ...hardware,
    ...latest
  ],
  'en'
);

const withCommentCounts = (posts) =>
  attachApprovedCommentCounts(posts, homeCommentCountMap, 'en');

const [
  latestCommunityComments,
  playableClassics,
  emulatorTools
] = await Promise.all([
  getLatestCommunityComments('en', 10, allPosts),
  getHomePlayableClassics('en', 4),
  getHomeEmulatorTools('en', 4)
]);
const viewerSession = await getUserSessionFromCookies(Astro.cookies);
let hideNewsletterPromo = false;

if (!viewerSession.error && viewerSession.user) {
  const newsletter = await getNewsletterSubscriptionForUser(
    viewerSession.user.id,
    viewerSession.user.email
  );

  hideNewsletterPromo = newsletter.status === 'active' || newsletter.status === 'pending';
}

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/' }
];
---

<BaseLayout
  reviews={headerReviews}
  news={headerNews}
  title="Retro-Gamers International: retro gaming culture"
  description="Retro-Gamers.it is an international editorial project about retro gaming history, classic consoles, arcade culture, creators and digital preservation."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/"
  lang="en"
  alternateLanguages={alternateLanguages}
>

  <h1 class="sr-only">Retro-Gamers.it, retro gaming, classic consoles and video games</h1>

  <section class="home-hero">
    <div class="container">
      <Hero posts={withCommentCounts(hero)} lang="en" />
    </div>
  </section>

  <section class="home-reviews">
    <div class="container">
      <Reviews posts={withCommentCounts(reviews)} lang="en" />
    </div>
  </section>

  <section class="home-editorial">
    <div class="container">
      <EditorialHub
        specials={withCommentCounts(specials)}
        memories={withCommentCounts(memories)}
        guides={withCommentCounts(guides)}
        lang="en"
      />
    </div>
  </section>

  <section class="home-community">
    <div class="container">
      <CommunityStrip
        lang="en"
        latestComments={latestCommunityComments}
        isLoggedIn={!viewerSession.error && Boolean(viewerSession.user)}
      />
    </div>
  </section>

  <section class="home-play-today-section">
    <div class="container">
      <PlayToday
        lang="en"
        playableClassics={playableClassics}
        emulatorTools={emulatorTools}
      />
    </div>
  </section>

  {!hideNewsletterPromo && (
    <section class="home-newsletter">
      <div class="container">
        <NewsletterPromo lang="en" variant="home" />
      </div>
    </section>
  )}

  {interviews.length > 0 && (
    <section class="home-interviews">
      <div class="container">
        <Interviews posts={withCommentCounts(interviews)} lang="en" />
      </div>
    </section>
  )}

  <section class="home-archive">
    <div class="container">
      <ArchiveStrip posts={withCommentCounts(archive)} lang="en" />
    </div>
  </section>

  <section class="home-hardware">
    <div class="container">
      <Hardware posts={withCommentCounts(hardware)} lang="en" />
    </div>
  </section>

  <section class="home-latest">
    <div class="container">
      <Latest posts={withCommentCounts(latest)} lang="en" />
    </div>
  </section>

</BaseLayout>
