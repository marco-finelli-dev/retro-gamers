---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const posts = grouped.english;
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Retro-Gamers International"
  description="Selected stories, features and retrospectives from Retro-Gamers.it in English."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/"
  lang="en"
>
  <ArchivePage
    title="Retro-Gamers International"
    eyebrow="English edition"
    description="Selected stories, features and retrospectives from the world of retro gaming, arcade, consoles and home computers."
    posts={posts}
    showFilters={false}
  />
</BaseLayout>