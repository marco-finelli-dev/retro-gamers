---
import BaseLayout from '../../layouts/BaseLayout.astro';

import Hero from '../../components/home/Hero.astro';
import Stories from '../../components/home/Stories.astro';
import Latest from '../../components/home/Latest.astro';
import Reviews from '../../components/home/Reviews.astro';
import EditorialHub from '../../components/home/EditorialHub.astro';
import LowerEditorial from '../../components/home/LowerEditorial.astro';
import Interviews from '../../components/home/Interviews.astro';
import NewsletterPrompt from '../../components/newsletter/NewsletterPrompt.astro';

import '../../styles/pages/home.css';

import {
  getActiveFeaturedPost,
  getAllPosts,
  isAffiliateHardwareAndBooksPost,
  sortPostsForHome
} from '../../lib/posts';
import { HOME_LATEST_PAGE_SIZE, getHomeLatestPosts, getHomePostKey } from '../../lib/home-latest';
import {
  attachApprovedCommentCounts,
  getApprovedCommentCountMap
} from '../../lib/supabase/comment-counts';
import { getUserSessionFromCookies } from '../../lib/supabase/auth';
import { getNewsletterSubscriptionForUser } from '../../lib/supabase/newsletter';
import { getHomePlayableClassics } from '../../lib/playable-classics';
import { getHomeEmulatorTools } from '../../lib/emulator-tools';
import { getPublishedQuizSummaries } from '../../lib/quiz';

const allPosts = await getAllPosts();

const englishPosts = allPosts
  .filter((post) => post.language === 'en')
  .map((post) => ({
    ...post,
    score: post.rating?.overall ?? 0
  }))
  .sort((a, b) => {
    return (
      new Date(b.publishedAt || 0).getTime() -
      new Date(a.publishedAt || 0).getTime()
    );
  });

const homeEditorialPosts = sortPostsForHome(englishPosts);

const headerReviews = englishPosts.filter((post) => post.type === 'review');
const headerNews = englishPosts.filter((post) => post.type === 'news');
const featuredPost = getActiveFeaturedPost(englishPosts);

const usedIds = new Set();

const hasImage = (post) => Boolean(post.featuredImage?.asset?.url);

const getPostKey = (post) =>
  post?._id?.replace(/^drafts\./, '') || post?.slug || '';

const takeUnused = (source, limit, options = {}) => {
  const requireImage = options.requireImage ?? false;
  const picked = [];

  for (const post of source) {
    const key = getPostKey(post);

    if (!key) continue;
    if (usedIds.has(key)) continue;
    if (requireImage && !hasImage(post)) continue;

    picked.push(post);
    usedIds.add(key);

    if (picked.length >= limit) break;
  }

  return picked;
};

const hero = [];

if (featuredPost) {
  const featuredKey = getPostKey(featuredPost);

  hero.push(featuredPost);

  if (featuredKey) {
    usedIds.add(featuredKey);
  }
}

const remainingHeroSlots = Math.max(0, 5 - hero.length);

if (remainingHeroSlots > 0) {
    hero.push(...takeUnused(
    homeEditorialPosts.filter(hasImage),
    remainingHeroSlots,
    { requireImage: true }
  ));
}

const reviewsSource = englishPosts
  .filter((post) => post.type === 'review');

const reviews = takeUnused(reviewsSource, 6, {
  requireImage: true
});

const guides = takeUnused(
  englishPosts.filter((post) => post.type === 'guide'),
  3,
  { requireImage: false }
);

const specials = takeUnused(
  englishPosts.filter((post) => post.type === 'feature'),
  5,
  { requireImage: true }
);

const interviews = takeUnused(
  englishPosts.filter((post) => post.type === 'interview'),
  5
);

const storyCandidates = [
  specials[0],
  interviews[0],
  ...specials.slice(1),
  ...interviews.slice(1)
];
const stories = storyCandidates
  .filter((post) => Boolean(post?.featuredImage?.asset?.url))
  .slice(0, 4);

const hardware = takeUnused(
  englishPosts.filter(isAffiliateHardwareAndBooksPost),
  4,
  { requireImage: true }
);

const news = englishPosts.filter((post) => post.type === 'news');

const latestFeedExcludedIds = new Set(
  [
    ...hero,
    ...reviews.slice(0, 5),
    ...news.slice(0, 8),
    ...guides.slice(0, 3),
    ...specials.slice(0, 5),
    ...stories,
    ...interviews.slice(0, 5),
    ...hardware.slice(0, 4)
  ]
    .map(getHomePostKey)
    .filter(Boolean)
);
const latestFeedCandidates = getHomeLatestPosts(
  allPosts,
  'en',
  latestFeedExcludedIds,
  HOME_LATEST_PAGE_SIZE + 1
);
const latestFeed = latestFeedCandidates.slice(0, HOME_LATEST_PAGE_SIZE);
const latestFeedHasMore = latestFeedCandidates.length > HOME_LATEST_PAGE_SIZE;

const homeCommentCountMap = await getApprovedCommentCountMap(
  [
    ...hero,
    ...reviews,
    ...news.slice(0, 8),
    ...guides,
    ...specials,
    ...interviews,
    ...hardware,
    ...latestFeed,
  ],
  'en'
);

const withCommentCounts = (posts) =>
  attachApprovedCommentCounts(posts, homeCommentCountMap, 'en');

const [
  playableClassics,
  emulatorTools,
  quizzes
] = await Promise.all([
  getHomePlayableClassics('en', 4),
  getHomeEmulatorTools('en', 4),
  getPublishedQuizSummaries('en')
]);
const viewerSession = await getUserSessionFromCookies(Astro.cookies);
let hideNewsletterPromo = false;

if (!viewerSession.error && viewerSession.user) {
  const newsletter = await getNewsletterSubscriptionForUser(
    viewerSession.user.id,
    viewerSession.user.email
  );

  hideNewsletterPromo = newsletter.status === 'active' || newsletter.status === 'pending';
}

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/' }
];
---

<BaseLayout
  pageShell="editorial"
  reviews={headerReviews}
  news={headerNews}
  title="Retro-Gamers International: retro gaming culture"
  description="Retro-Gamers.it is an international editorial project about retro gaming history, classic consoles, arcade culture, creators and digital preservation."
  image="/og-image.webp"
  canonical="https://www.retro-gamers.it/en/"
  lang="en"
  alternateLanguages={alternateLanguages}
>

  <h1 class="sr-only">Retro-Gamers.it, retro gaming, classic consoles and video games</h1>

  <section class="home-hero">
    <div class="container">
      <Hero posts={withCommentCounts(hero)} lang="en" />
    </div>
  </section>

  <section class="home-stories">
    <div class="container">
      <Stories posts={stories} lang="en" />
    </div>
  </section>

  <section class="home-reviews">
    <div class="container">
      <Reviews posts={withCommentCounts(reviews)} news={news} guides={guides} quizzes={quizzes} lang="en" />
    </div>
  </section>

  <section class="home-editorial home-editorial--guides">
    <div class="container">
      <EditorialHub guides={withCommentCounts(guides)} lang="en" variant="guides" />
    </div>
  </section>

  <section class="home-editorial">
    <div class="container">
      <LowerEditorial
        specials={withCommentCounts(specials)}
        hardware={withCommentCounts(hardware)}
        playableClassics={playableClassics}
        emulatorTools={emulatorTools}
        lang="en"
      >
        {interviews.length > 0 && (
          <Interviews slot="interviews" posts={withCommentCounts(interviews)} lang="en" />
        )}
      </LowerEditorial>
    </div>
  </section>

  {!hideNewsletterPromo && <NewsletterPrompt lang="en" />}

  <section class="home-latest">
    <div class="container">
      <Latest
        posts={withCommentCounts(latestFeed)}
        excludedPostIds={[...latestFeedExcludedIds, ...latestFeed.map(getHomePostKey)]}
        hasMore={latestFeedHasMore}
        lang="en"
      />
    </div>
  </section>

</BaseLayout>
