---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ManufacturerPage from '../../../../../components/platforms/ManufacturerPage.astro';

import {
  getPlatformsByTypeAndManufacturer
} from '../../../../../lib/platforms';
import {
  getPlatformManufacturerUrl,
  getPlatformTypeFromRouteSegment
} from '../../../../../lib/routes.js';

const { type, manufacturer } = Astro.params;

const platformType = getPlatformTypeFromRouteSegment(type, 'en') || type;

const platforms = await getPlatformsByTypeAndManufacturer(
  platformType,
  manufacturer
);

const resolvedManufacturer =
  platforms[0]?.manufacturer ||
  {
    name: 'Manufacturer',
    slug: manufacturer
  };

---

<BaseLayout
  lang="en"
  title={`${resolvedManufacturer.name} platforms`}
  description={`All ${resolvedManufacturer.name} platforms in the Retro-Gamers archive.`}
  canonical={`https://www.retro-gamers.it${getPlatformManufacturerUrl(platformType, manufacturer, 'en')}`}
>
  <ManufacturerPage
    type={platformType}
    manufacturer={resolvedManufacturer}
    platforms={platforms}
    lang="en"
  />
</BaseLayout>
