---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import PlatformDetail from '../../../../../components/platforms/PlatformDetail.astro';
import ArchiveCard from '../../../../../components/archive/ArchiveCard.astro';
import Pagination from '../../../../../components/common/Pagination.astro';

import { getAllPosts } from '../../../../../lib/posts';
import {
  getPlatformByPath
} from '../../../../../lib/platforms';
import {
  getPlatformIndexUrl,
  getPlatformTypeFromRouteSegment,
  getPlatformUrl
} from '../../../../../lib/routes.js';
import { getCurrentPage, getPaginationUrl, paginateItems, PAGE_SIZE } from '../../../../../lib/pagination';

const { type, manufacturer, platform } = Astro.params;

const platformType = getPlatformTypeFromRouteSegment(type, 'en') || type;

const allPosts = await getAllPosts();

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const platformData = await getPlatformByPath(
  platformType,
  manufacturer,
  platform
);

if (!platformData) {
  return Astro.redirect(getPlatformIndexUrl('en'));
}

const currentPage = getCurrentPage(Astro.url);

const relatedPlatformPosts = allPosts
  .filter((post) =>
    post.language === 'en' &&
    post.platforms?.some((item) => item._id === platformData._id)
  )
  .sort((a, b) =>
    new Date(b.publishedAt || 0).getTime() -
    new Date(a.publishedAt || 0).getTime()
  );

const {
  currentPage: relatedPage,
  total: relatedTotal,
  totalPages: relatedTotalPages,
  items: relatedPagePosts,
} = paginateItems(relatedPlatformPosts, currentPage, PAGE_SIZE);
const getRelatedPageUrl = (pageNumber) => getPaginationUrl(Astro.url, pageNumber);

const pageDescription =
  platformData.history?.slice(0, 155) ||
  `${platformData.name} platform profile on Retro-Gamers.it.`;
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  lang="en"
  title={platformData.name}
  description={pageDescription}
  image={platformData.cover?.asset?.url || platformData.logoLight?.asset?.url || platformData.logo?.asset?.url || '/og-image.jpg'}
  canonical={`https://www.retro-gamers.it${getPlatformUrl(platformData, 'en')}`}
>
  <PlatformDetail platform={platformData} lang="en" />

  {relatedTotal > 0 && (
    <section class="platform-related">
      <div class="container">
        <div class="platform-related__inner">
          <div class="platform-related__header">
            <span>Archive</span>
            <h2>Related articles</h2>
            <p>Reviews, features, guides and stories connected to this platform.</p>
          </div>

          <div class="platform-related__grid">
            {relatedPagePosts.map((post) => (
              <ArchiveCard post={post} lang="en" />
            ))}
          </div>

          <Pagination
            currentPage={relatedPage}
            totalPages={relatedTotalPages}
            lang="en"
            getPageUrl={getRelatedPageUrl}
            ariaLabel="Related articles pagination"
          />
        </div>
      </div>
    </section>
  )}
</BaseLayout>
