---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PlatformTypePage from '../../../../components/platforms/PlatformTypePage.astro';

import { getAllPosts, groupPosts } from '../../../../lib/posts';
import { getPlatformsByType } from '../../../../lib/platforms';


export async function getStaticPaths() {
  return [
    { params: { type: 'arcade' } },
    { params: { type: 'computers' } },
    { params: { type: 'consoles' } }
  ];
}

const { type } = Astro.params;

const typeMap = {
  arcade: 'arcade',
  computers: 'computer',
  consoles: 'console'
};

const internalType = typeMap[type] || type;

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const platforms = await getPlatformsByType(internalType);

const pageTitles = {
  arcade: 'Arcade',
  computers: 'Computers',
  consoles: 'Consoles'
};

const pageDescriptions = {
  arcade: 'Arcade boards, cabinets and systems that shaped coin-op gaming.',
  computers: 'Home computers and personal computers from the history of retro gaming.',
  consoles: 'Home and handheld consoles from the history of video games.'
};
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  lang="en"
  title={pageTitles[type] || 'Platforms'}
  description={pageDescriptions[type] || 'Retro gaming platforms, machines and systems.'}
  canonical={`https://www.retro-gamers.it/en/platforms/${type}/`}
>
  <PlatformTypePage
    type={internalType}
    platforms={platforms}
    lang="en"
  />
</BaseLayout>
