---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PlatformTypePage from '../../../../components/platforms/PlatformTypePage.astro';

import { getPlatformsByType } from '../../../../lib/platforms';
import type { PlatformType } from '../../../../lib/platforms';
import {
  getPlatformIndexUrl,
  getPlatformRouteSegment,
  getPlatformTypeFromRouteSegment,
  getPlatformTypeUrl,
  isPlatformRouteSegment
} from '../../../../lib/routes.js';

const { type } = Astro.params;

if (!isPlatformRouteSegment(type, 'en')) {
  return Astro.redirect(getPlatformIndexUrl('en'));
}

const internalType = getPlatformTypeFromRouteSegment(type, 'en') as PlatformType;
const publicType = getPlatformRouteSegment(internalType, 'en');

const platforms = await getPlatformsByType(internalType);

const pageTitles = {
  arcade: 'Arcade',
  computers: 'Computers',
  consoles: 'Consoles'
};

const pageDescriptions = {
  arcade: 'Arcade boards, cabinets and systems that shaped coin-op gaming.',
  computers: 'Home computers and personal computers from the history of retro gaming.',
  consoles: 'Home and handheld consoles from the history of video games.'
};
---

<BaseLayout
  lang="en"
  title={pageTitles[publicType] || 'Platforms'}
  description={pageDescriptions[publicType] || 'Retro gaming platforms, machines and systems.'}
  canonical={`https://www.retro-gamers.it${getPlatformTypeUrl(internalType, 'en')}`}
>
  <PlatformTypePage
    type={internalType}
    platforms={platforms}
    lang="en"
  />
</BaseLayout>
