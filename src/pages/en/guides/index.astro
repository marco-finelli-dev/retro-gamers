---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'guide');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/guide/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/guides/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/guide/' }
];
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Guides"
  description="Retro gaming guides from Retro-Gamers.it in English."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/guides/"
  lang="en"
  alternateLanguages={alternateLanguages}
>
  <ArchivePage
    title="Guides"
    eyebrow="English edition"
    description="Practical guides and explainers for retro games, hardware, emulation and classic systems."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
