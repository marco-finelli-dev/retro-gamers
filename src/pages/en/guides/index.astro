---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchivePage from '../../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/pagination';
import { getPostUrl } from '../../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const englishReviews = allPosts.filter(
  (post) => post.type === 'review' && post.language === 'en'
);

const englishNews = allPosts.filter(
  (post) => post.type === 'news' && post.language === 'en'
);

const posts = grouped.english.filter((post) => post.type === 'guide');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/guide/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/guides/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/guide/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/en/guides/',
  name: 'Retro gaming guides',
  description: 'Practical guides for emulators, hardware, storage media and original systems, with clear steps for setup, preservation and everyday use.',
  lang: 'en',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={englishReviews}
  news={englishNews}
  title="Retro gaming guides"
  description="Practical guides for emulators, hardware, storage media and original systems, with clear steps for setup, preservation and everyday use."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/en/guides/"
  lang="en"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Retro gaming guides"
    eyebrow="English edition"
    description="Retro-Gamers.it guides provide practical instructions for using emulators, configuring hardware, managing storage media and keeping classic systems and games working. Each guide is based on real testing and explains the required steps, tools and possible problems without assuming advanced technical knowledge. From Amiga Compact Flash setups to modern software configuration, the aim is to help experienced enthusiasts and new users preserve, understand and use their video game heritage."
    posts={posts}
    showFilters={false}
    lang="en"
  />
</BaseLayout>
