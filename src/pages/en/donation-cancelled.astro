---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/thanks.css';

const title = 'Donation cancelled | Retro-Gamers.it';
const description = 'The donation to Retro-Gamers.it was cancelled. You can return to the website, explore the archive or try again later.';
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.retro-gamers.it/en/donation-cancelled/"
  lang="en"
  noindex={true}
>
  <main class="thanks-page">
    <section class="thanks-card">
      <span class="thanks-card__eyebrow">Donation cancelled</span>

      <h1>No worries.</h1>

      <p>
        The donation was not completed. You can safely return to Retro-Gamers.it:
        the website remains free, accessible and without any obligation to contribute.
      </p>

      <p>
        If you decide to support us another time, the button will still be there.
        In the meantime, thank you anyway for considering supporting the project.
      </p>

      <div class="thanks-card__divider"></div>

      <span class="thanks-card__eyebrow">Donazione annullata</span>

      <p lang="it">
        La donazione non è stata completata. Nessun problema: Retro-Gamers.it resta libero,
        accessibile e senza alcun obbligo di contributo.
      </p>

      <p lang="it">
        Se vorrai sostenerci in un altro momento, il pulsante sarà sempre disponibile.
        Nel frattempo, grazie comunque per aver pensato di supportare il progetto.
      </p>

      <div class="thanks-card__actions">
        <a href="/en/">Back to home</a>
        <a href="/en/archive/">Explore the archive</a>
        <a href="/donazione-annullata/">Versione italiana</a>
      </div>
    </section>
  </main>
</BaseLayout>