---
import BaseLayout from '../layouts/BaseLayout.astro';

import { getAllPosts, groupPosts } from '../lib/posts';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Pagina non trovata"
  description="La pagina richiesta non esiste o è stata spostata."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/404/"
  noindex={true}
>
  <div class="error-page">

    <section class="error-card">

      <span class="error-card__code">404</span>

      <h1>Pagina non trovata</h1>

      <p>
        Sembra che questa schermata sia finita fuori mappa. Il contenuto che cercavi
        potrebbe essere stato spostato, rinominato o non essere più disponibile.
      </p>

      <div class="error-card__actions">
        <a href="/">Torna alla home</a>
        <a href="/archivio/">Esplora l’archivio</a>
      </div>

    </section>

  </div>
</BaseLayout>