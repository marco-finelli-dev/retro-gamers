---
import ErrorLayout from '../layouts/ErrorLayout.astro';

Astro.response.status = 404;
---

<ErrorLayout title="Pagina non trovata">
  <div class="error-page">

    <section class="error-content">

      <span class="error-content__code">404</span>

      <h1>Pagina non trovata</h1>

      <p>
        Sembra che questa schermata sia finita fuori mappa. Il contenuto che cercavi
        potrebbe essere stato spostato, rinominato o non essere più disponibile.
      </p>

      <div class="error-content__actions">
        <a href="/">Torna alla home</a>
        <a href="/archivio/">Esplora l’archivio</a>
      </div>

    </section>

  </div>
</ErrorLayout>
