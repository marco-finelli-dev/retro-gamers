---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const { allReviews, news } = groupPosts(allPosts);

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/recensioni/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/reviews/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/recensioni/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/recensioni/',
  name: 'Recensioni di videogiochi retro',
  description: 'Recensioni di videogiochi retro per console, arcade e home computer, con analisi critica, contesto storico, voti e memoria personale.',
  lang: 'it',
  items: createListItems(allReviews.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={allReviews}
  news={news}
  title="Recensioni di videogiochi retro"
  description="Recensioni di videogiochi retro per console, arcade e home computer, con analisi critica, contesto storico, voti e memoria personale."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/recensioni/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>

  <ArchivePage
    title="Recensioni di videogiochi retro"
    eyebrow="Giochi alla prova"
    description="Le recensioni di Retro-Gamers.it tornano ai videogiochi che hanno segnato console, home computer e sale giochi, senza fermarsi alla nostalgia. Rileggiamo gameplay, grafica, sonoro e contesto storico per capire cosa conserva ancora valore, quali aspetti mostrano il peso del tempo e perché ogni titolo è stato importante. Dall’Amiga al Super Nintendo, dall’arcade alla prima PlayStation, ogni prova unisce memoria personale, analisi critica e attenzione alle versioni originali."
    posts={allReviews}
  />
</BaseLayout>
