---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const { allReviews, news } = groupPosts(allPosts);

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/recensioni/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/reviews/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/recensioni/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/recensioni/',
  name: 'Recensioni',
  description: 'Recensioni di giochi retro per console, arcade e home computer: prove, voti, impressioni e memoria storica.',
  lang: 'it',
  items: createListItems(allReviews.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={allReviews}
  news={news}
  title="Recensioni"
  description="Recensioni di giochi retro per console, arcade e home computer: prove, voti, impressioni e memoria storica."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/recensioni/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>

  <ArchivePage
    title="Recensioni"
    eyebrow="Giochi alla prova"
    description="Le nostre prove dal mondo arcade, console e home computer: voti, impressioni, memoria storica e rigiocabilità."
    posts={allReviews}
  />
</BaseLayout>
