---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePage from '../../components/archive/ArchivePage.astro';

import { getAllPosts, groupPosts } from '../../lib/posts';
import { PAGE_SIZE } from '../../lib/pagination';
import { getPostUrl } from '../../lib/routes.js';
import { createCollectionPageStructuredData, createListItems } from '../../lib/structured-data.js';

const allPosts = await getAllPosts();
const grouped = groupPosts(allPosts);

const posts = grouped.all.filter((post) => post.type === 'memories');

const alternateLanguages = [
  { lang: 'it', url: 'https://www.retro-gamers.it/memories/' },
  { lang: 'en', url: 'https://www.retro-gamers.it/en/memories/' },
  { lang: 'x-default', url: 'https://www.retro-gamers.it/memories/' }
];

const structuredData = createCollectionPageStructuredData({
  url: 'https://www.retro-gamers.it/memories/',
  name: 'Memorie videoludiche',
  description: 'Racconti personali e memorie legate a videogiochi, sale giochi, console, home computer, riviste e cultura digitale.',
  lang: 'it',
  items: createListItems(posts.slice(0, PAGE_SIZE), (post) => ({
    name: post.title,
    url: getPostUrl(post)
  }))
});
---

<BaseLayout
  reviews={grouped.allReviews}
  news={grouped.allNews}
  title="Memorie videoludiche"
  description="Racconti personali e memorie legate a videogiochi, sale giochi, console, home computer, riviste e cultura digitale."
  image="/og-image.jpg"
  canonical="https://www.retro-gamers.it/memories/"
  alternateLanguages={alternateLanguages}
  structuredData={structuredData}
>
  <ArchivePage
    title="Memorie videoludiche"
    eyebrow="Ricordi digitali"
    description="Memories raccoglie ricordi personali legati ai videogiochi e alla cultura digitale che li circondava. Sale giochi, negozi, riviste, computer di casa, console ricevute in regalo e titoli scoperti quasi per caso diventano il punto di partenza per raccontare esperienze condivise da intere generazioni. Non è una semplice celebrazione nostalgica, ma uno spazio in cui la memoria individuale incontra la storia dei luoghi, delle abitudini e delle persone che hanno dato forma al nostro rapporto con il videogioco."
    posts={posts}
    showFilters={false}
  />
</BaseLayout>
