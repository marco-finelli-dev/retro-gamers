---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/thanks.css';

const title = 'Grazie per il tuo supporto';
const description = 'Grazie per aver sostenuto Retro-Gamers.it, progetto editoriale indipendente dedicato alla storia dei videogiochi e alla cultura retro.';
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.retro-gamers.it/grazie/"
  lang="it"
  noindex={true}
>
  <div class="thanks-page">
    <section class="thanks-card">
      <span class="thanks-card__eyebrow">Supporto ricevuto</span>

      <h1>Grazie di cuore.</h1>

      <p>
        Il tuo contributo aiuta Retro-Gamers.it a restare un progetto editoriale indipendente,
        libero da pubblicità invasiva e costruito con cura attorno alla storia dei videogiochi,
        dei computer, delle console e della cultura retro.
      </p>

      <p>
        Ogni gesto, anche piccolo, significa tempo, ricerca, manutenzione del sito,
        immagini, archivi, traduzioni e nuovi contenuti da pubblicare.
      </p>

      <div class="thanks-card__divider"></div>

      <span class="thanks-card__eyebrow">Thank you</span>

      <p lang="en">
        Thank you for supporting Retro-Gamers.it. Your contribution helps keep alive
        an independent editorial project dedicated to videogame history and retro culture,
        without invasive advertising or clickbait.
      </p>

      <div class="thanks-card__actions">
        <a href="/">Torna alla home</a>
        <a href="/en/thanks/">English version</a>
        <a href="/archivio/">Esplora l’archivio</a>
      </div>
    </section>
  </div>
</BaseLayout>
